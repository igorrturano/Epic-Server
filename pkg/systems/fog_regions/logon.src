// Hook logon: limpa preview markers residuais e inicia fogRegionWatcher.
use uo;
use os;

include ":fog_regions:include/fogRegionCore";

program logon(who)
    if (!who || !who.connected)
        return 0;
    endif

    CleanupFogPreviewMarkers(who);

    // Dedup por liveness de processo (sobrevive a restart/OOM, ao contrário de uma
    // flag persistida): se o pid guardado ainda resolve para um processo vivo, o
    // watcher já está rodando; senão (inclusive pid orfão de crash) inicia um novo.
    var existing := GetObjProperty(who, "#fogWatcherPid");
    if (existing && GetProcess(CInt(existing)))
        return 1;
    endif

    var scr := start_script(":fog_regions:fogRegionWatcher", who);
    if (scr && !scr.errortext)
        SetObjProperty(who, "#fogWatcherPid", scr.pid);
    endif
    return 1;
endprogram
