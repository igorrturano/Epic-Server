// :faccao:guild_registry.src
//
// Sistema de registro persistente e validador de integridade de guildas/facções.
// Mantém um registro confiável e limpa dados corrompidos ou órfãos.
// Versão 2.0

use uo;
use os;
use guilds;
use datafile;

include ":datafile:datafile";
include ":faccao:include/faccao_constants";
include ":faccao:include/logging";
include ":faccao:include/datafile_helpers";
include ":faccao:include/shared_functions"; // Contém SafeGetGuildName
include ":faccao:include/safe_guild_utils"; // Contém SafeGetGuildName (redundante, mas seguro)

// Constantes para datafile
const GUILD_REGISTRY_DATAFILE := "guild_registry";
const GUILD_REGISTRY_ELEM := "guilds";
const GUILD_REGISTRY_TIMESTAMP := "last_update";

program guild_registry()
    LogInfo("registro_guildas", "Iniciando sistema de registro e validação de guildas...");
    
    // Registrar o script como um serviço contínuo
    SetGlobalProperty("guild_registry_pid", GetPid());
    
    // Inicializar o registro
    InitializeGuildRegistry();
      
    // Loop principal - Atualizar o registro periodicamente E validar dados
    var last_registry_update := ReadGameClock();
    var last_leader_validation := ReadGameClock();
    var last_player_validation := ReadGameClock(); // <<< NOVO

    while(1)
        var current_time := ReadGameClock();
        
        // Atualizar registro de guildas a cada 1 hora
        if ((current_time - last_registry_update) >= 3600)
            UpdateGuildRegistry();
            last_registry_update := current_time;
        endif
        
        // Validar líderes de guildas a cada 2 horas
        if ((current_time - last_leader_validation) >= 7200)
            ValidateAllGuildLeaders();
            last_leader_validation := current_time;
        endif

        // <<< NOVO >>> Validar referências de guildas nos jogadores a cada 4 horas
        if ((current_time - last_player_validation) >= 14400)
            ValidatePlayerGuildReferences();
            last_player_validation := current_time;
        endif
        
        // Verificar eventos e comandos
        var ev := wait_for_event(300); // 5 minutos
        if (ev)
            case (ev.type)
                "update": 
                    LogInfo("registro_guildas", "Atualizando registro de guildas sob demanda");
                    UpdateGuildRegistry();
                    last_registry_update := ReadGameClock();                
                "lookup":
                    if (ev.name)
                        var guild_id := FindGuildByName(ev.name);
                        if (ev.process)
                            var process := GetProcess(ev.process);
                            if (process)
                                process.SendEvent(struct{
                                    "type" := "lookup_result",
                                    "name" := ev.name,
                                    "guild_id" := guild_id
                                });
                            endif
                        endif
                    endif
                "register":
                    if (ev.name && ev.guild_id)
                        RegisterGuild(ev.name, ev.guild_id);
                    endif
            endcase
        endif
        
        sleepms(2);
    endwhile
endprogram

/*
 * InitializeGuildRegistry()
 *
 * Purpose: Inicializar o registro de guildas
 * Parameters: Nenhum
 * Return: 1 se bem-sucedido, 0 se falha
 */
function InitializeGuildRegistry()
    LogInfo("registro_guildas", "Inicializando registro de guildas...");
    
    var df := SafeOpenDataFile(GUILD_REGISTRY_DATAFILE, 1);
    if (!df) return 0; endif
    
    var elem := SafeFindElement(df, GUILD_REGISTRY_ELEM, 1);
    if (!elem) return 0; endif
    
    var last_update := GetElementProp(elem, GUILD_REGISTRY_TIMESTAMP, 0);
    var current_time := polcore().systime;
    
    if (!last_update || (current_time - last_update) > 86400)
        return UpdateGuildRegistry();
    endif
    
    LogInfo("registro_guildas", "Registro de guildas já inicializado. Última atualização: " + FormatRegistryTime(last_update));
    
    return 1;
endfunction

/*
 * UpdateGuildRegistry()
 *
 * Purpose: Atualizar o registro de guildas com informações atuais
 * Parameters: Nenhum
 * Return: 1 se bem-sucedido, 0 se falha
 */
function UpdateGuildRegistry()
    LogInfo("registro_guildas", "Atualizando registro de guildas...");
    
    var df := SafeOpenDataFile(GUILD_REGISTRY_DATAFILE, 1);
    if (!df) return 0; endif
    
    var elem := SafeFindElement(df, GUILD_REGISTRY_ELEM, 1);
    if (!elem) return 0; endif
    
    var registry := GetElementProp(elem, "registry", dictionary{});
    var guild_map := dictionary{};
    
    // Usar a função ListGuilds() como fonte principal, pois é a lista definitiva do POL.
    var all_guilds := ListGuilds();
    if (!all_guilds || all_guilds == error)
        LogWarning("registro_guildas", "ListGuilds() falhou ou retornou vazio. Registro não pode ser atualizado.");
        return 0;
    endif

    LogDebug("registro_guildas", "Encontradas " + all_guilds.size() + " guildas para registrar via ListGuilds()");
    
    foreach guild in all_guilds
        // >>>>> REATORAÇÃO APLICADA AQUI <<<<<
        // Usando a função segura para obter o nome, prevenindo erros e inconsistências.
        var guild_name := SafeGetGuildName(guild);

        if (guild_name && guild_name != "Unknown Guild" && guild_name != "No Guild")
            guild_map[guild_name] := guild.guildid;
            
            var alt_names := guild.GetProp("alt_names");
            if (alt_names && typeof(alt_names) == "Array")
                foreach alt_name in (alt_names)
                    if (alt_name && alt_name != "")
                        guild_map[alt_name] := guild.guildid;
                    endif
                    sleepms(2);
                endforeach
            endif
        endif
        sleepms(2);
    endforeach
    
    SetElementProp(elem, "registry", guild_map);
    SetElementProp(elem, GUILD_REGISTRY_TIMESTAMP, polcore().systime);
    
    LogInfo("registro_guildas", "Registro de guildas atualizado com sucesso. Total: " + guild_map.keys().size() + " entradas");

    return 1;
endfunction

/*
 * RegisterGuild(name, guild_id)
 *
 * Purpose: Registrar manualmente uma guilda no registro
 */
function RegisterGuild(name, guild_id)
    if (!name || !guild_id) return 0; endif
    
    var df := SafeOpenDataFile(GUILD_REGISTRY_DATAFILE, 1);
    if (!df) return 0; endif
    
    var elem := SafeFindElement(df, GUILD_REGISTRY_ELEM, 1);
    if (!elem) return 0; endif
    
    var registry := GetElementProp(elem, "registry", dictionary{});
    
    registry[name] := guild_id;
    return SetElementProp(elem, "registry", registry);
endfunction

/*
 * FormatRegistryTime(timestamp)
 *
 * Purpose: Formatar timestamp para exibição
 */
function FormatRegistryTime(timestamp)
    if (!timestamp || timestamp == error) return "Data desconhecida"; endif
    
    var seconds_per_day := 86400;
    var seconds_per_hour := 3600;
    var seconds_per_minute := 60;
    
    var days := CInt(timestamp / seconds_per_day) % 365;
    var hours := CInt((timestamp % seconds_per_day) / seconds_per_hour);
    var minutes := CInt((timestamp % seconds_per_hour) / seconds_per_minute);
    var seconds := CInt(timestamp % seconds_per_minute);
    
    var formatted := CStr(2024) + "-" + 
                   PadRegistryStr(CStr(1), 2, "0") + "-" + 
                   PadRegistryStr(CStr(days+1), 2, "0") + " " + 
                   PadRegistryStr(CStr(hours), 2, "0") + ":" + 
                   PadRegistryStr(CStr(minutes), 2, "0") + ":" + 
                   PadRegistryStr(CStr(seconds), 2, "0");
    
    return formatted;
endfunction

/*
 * PadRegistryStr(str, length, padchar)
 *
 * Purpose: Adicionar padding a uma string
 */
function PadRegistryStr(str, length, padchar := "0")
    str := CStr(str);
    while (len(str) < length)
        str := padchar + str;
    endwhile
    
    return str;
endfunction

/*
 * ValidateAllGuildLeaders()
 * 
 * Purpose: Verificar e corrigir automaticamente problemas com guild.leader
 * Returns: Número de guildas corrigidas
 */
function ValidateAllGuildLeaders()
    LogInfo("guild_validator", "Iniciando validação automática de guild.leader");
    
    var guilds_corrigidas := 0;
    var all_guilds := ListGuilds();
    if (!all_guilds) return 0; endif;

    foreach guild in all_guilds
        var faction_name := SafeGetGuildName(guild);
        if (!faction_name) continue; endif; // Pular se não for uma facção válida
        
        var current_leader := guild.leader;
        var guildmaster := guild.guildmaster;
        var custom_leader := guild.GetProp("leader");
        
        var needs_fix := 0;
        var fix_reason := "";
        
        if (!current_leader || current_leader == error || CStr(current_leader) == "<uninitialized object>")
            needs_fix := 1;
            fix_reason := "guild.leader está <uninitialized object>";
        elseif (custom_leader && custom_leader != error && custom_leader != current_leader)
            needs_fix := 1;
            fix_reason := "guild.leader (" + CStr(current_leader) + ") != custom leader (" + CStr(custom_leader) + ")";
        elseif (guildmaster && guildmaster != error && current_leader != guildmaster)
            needs_fix := 1;
            fix_reason := "guild.leader (" + CStr(current_leader) + ") != guildmaster (" + CStr(guildmaster) + ")";
        endif
        
        if (needs_fix)
            var correct_leader := guildmaster;
            if (!correct_leader && custom_leader && custom_leader != error)
                correct_leader := custom_leader;
            endif
            
            if (correct_leader)
                if (SetFactionLeaderInternal(guild, correct_leader))
                    guilds_corrigidas += 1;
                    LogInfo("guild_validator", "AUTO-CORREÇÃO: " + faction_name + " - " + fix_reason);
                else
                    LogError("guild_validator", "FALHA na correção: " + faction_name + " - " + fix_reason);
                endif
            else
                RemoveFactionLeaderInternal(guild);
                guilds_corrigidas += 1;
                LogInfo("guild_validator", "AUTO-LIMPEZA: " + faction_name + " - removido líder inválido");
            endif
        endif
        
        sleepms(5);
    endforeach
    
    LogInfo("guild_validator", "Validação de líderes concluída. Corrigidas: " + guilds_corrigidas);
    return guilds_corrigidas;
endfunction

/*
 * <<< NOVA FUNÇÃO - VERSÃO COMPATÍVEL COM ENUMERATEONLINECHARACTERS >>>
 * ValidatePlayerGuildReferences()
 * 
 * Purpose: Varre os jogadores ONLINE e remove referências a guildas que não existem mais.
 *          Isso resolve a causa raiz do erro '<uninitialized object>' para jogadores ativos.
 * Returns: Número de jogadores corrigidos.
 */
function ValidatePlayerGuildReferences()
    LogInfo("guild_validator", "Iniciando validação de referências de guilda nos jogadores ONLINE...");

    var players_corrigidos := 0;
    // Usa EnumerateOnlineCharacters(), que é uma função core padrão e garantida.
    var online_players := EnumerateOnlineCharacters();

    foreach player in online_players
        // Verificar apenas jogadores que pertencem a uma guilda
        if (player && player.guildid)
            var guild_obj := FindGuild(player.guildid);
            if (!guild_obj || guild_obj == error)
                // A guilda não existe mais. Limpar a referência do jogador.
                LogWarning("guild_validator", "Jogador online " + player.name + " (Serial: " + player.serial + ") tinha um guildid inválido (" + player.guildid + "). Limpando referência.");
                player.guildid := 0;
                
                // Opcional: remover CProps de facção do jogador também
                player.EraseObjProperty("dados_convite");
                player.EraseObjProperty("guild_rank");
                
                players_corrigidos += 1;
            endif
        endif
        sleepms(2); // Pequena pausa para não sobrecarregar
    endforeach

    LogInfo("guild_validator", "Validação de referências de guilda nos jogadores ONLINE concluída. Corrigidos: " + players_corrigidos);
    return players_corrigidos;
endfunction

/*
 * SetFactionLeaderInternal(guild, player_serial)
 * 
 * Purpose: Sincronizar corretamente guild.leader com custom properties (versão interna)
 */
function SetFactionLeaderInternal(guild, player_serial)
    if (!guild || !player_serial) return 0; endif
    
    guild.SetProp("leader", player_serial);
    guild.leader := player_serial;
    
    var player := SystemFindObjectBySerial(player_serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
    if (player)
        player.SetProp("guild_rank", "Lider");
    endif
    
    return 1;
endfunction

/*
 * RemoveFactionLeaderInternal(guild)
 * 
 * Purpose: Remover líder de forma sincronizada (versão interna)
 */
function RemoveFactionLeaderInternal(guild)
    if (!guild) return 0; endif
    
    var current_leader_serial := guild.GetProp("leader");
    
    guild.SetProp("leader", 0x0);
    guild.leader := 0x0;
    
    if (current_leader_serial)
        var former_leader := SystemFindObjectBySerial(current_leader_serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
        if (former_leader)
            former_leader.EraseObjProperty("guild_rank");
        endif
    endif
    
    return 1;
endfunction