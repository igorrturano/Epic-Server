// =============================================================================
// gump_contato_preso.src — Notificacao ao lider de que o preso quer falar
// =============================================================================
//
// Script de gump disparado quando o prisioneiro clica em "Falar com o Lider"
// no gump de prisao (prisaotimer.src). Pode ser iniciado de duas formas:
//   a) Ao vivo: prisaotimer chama start_script quando o lider esta online.
//   b) No logon: logon_hook detecta "notif_contato_preso_pendente" na guild
//      e dispara este script assim que o lider conecta.
//
// FLUXO
//   1. Valida que o lider existe e esta conectado; caso contrario, encerra.
//   2. Exibe gump simples com o nome do prisioneiro e botao "Entendido".
//   3. Independente do resultado, apaga "notif_contato_preso_pendente" da guild.
//   4. Se lider clicou "Entendido": toca som e avisa o prisioneiro.
//        Se o preso esta online: SendSysMessageEx imediato.
//        Se offline: salva "notif_lider_recebeu" no mobile do preso;
//                    logon_hook entrega a mensagem no proximo login.
//
// PARAMETROS
//   params[1] = mobile do lider
//   params[2] = nome do prisioneiro (string)
//   params[3] = nome da faccao (string)
//   params[4] = serial do prisioneiro (para notificar de volta)
//   params[5] = guild object (para apagar notif_contato_preso_pendente)
// =============================================================================

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include "include/say";

// Exibe notificacao ao lider da faccao de que um prisioneiro quer falar com ele.
// Entrada: params[1] = mobile lider
//          params[2] = nome do prisioneiro (string)
//          params[3] = nome da faccao (string)
//          params[4] = serial do prisioneiro (integer, para avisar de volta)
//          params[5] = guild object (para apagar notif_contato_preso_pendente)

program gump_contato_preso(params)
	set_script_option(SCRIPTOPT_CAN_ACCESS_OFFLINE_MOBILES, 1);

	var lider        := params[1];
	var preso        := params[2];
	var gname        := params[3];
	var preso_serial := CInt(params[4]);
	var guild        := params[5];

	if (!lider || !lider.isA(POLCLASS_MOBILE) || !lider.connected)
		return;
	endif

	var gump := GFCreateGump(10, 30);
	GFResizePic(gump, 0, 0, 9270, 340, 120);
	GFTextMid(gump, 0, 10, 340, 1153, "Faccao {} - Prisao".format(gname));
	GFHtmlArea(gump, 20, 35, 300, 45,
		"<basefont color=#FFFFFF>O prisioneiro <b>{}</b> quer falar com voce.".format(preso), 0);
	GFAddButton(gump, 100, 88, 4005, 4007, GF_CLOSE_BTN, 1);
	GFTextLine(gump, 135, 90, 2100, "Entendido");

	var input := GFSendGump(lider, gump);

	if (guild && guild != error)
		guild.EraseProp("notif_contato_preso_pendente");
	endif

	if (input && input[0] == 1)
		PlaySoundEffect(lider, 0x038);
		if (preso_serial)
			var mob_preso := SystemFindObjectBySerial(preso_serial);
			if (mob_preso && mob_preso.isA(POLCLASS_MOBILE) && mob_preso.connected)
				SendSysMessageEx(mob_preso, "O lider da faccao recebeu sua mensagem.", SSM_INFO);
			else
				SetObjProperty(mob_preso, "notif_lider_recebeu", gname);
			endif
		endif
	endif
endprogram
