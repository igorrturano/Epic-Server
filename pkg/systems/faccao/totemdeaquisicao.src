use uo;
use os;
use datafile;

include ":faccao:faccao"; 
include ":faccao:faccao_constants";
include ":faccao:include/shared_functions"; 
include ":faccao:include/territory_management"; 

program TotemDeAquisicao(who, totem)
    LogDebug("faccao", "TotemDeAquisicao: Iniciando função com who=" + who.serial + ", totem=" + totem.serial);
    
    if (!who || !totem)
        LogError("faccao", "TotemDeAquisicao: Parâmetros inválidos (who ou totem nulo).");
        return 0;
    endif;
    
    var rect_name := GetObjProperty(totem, TERRITORY_NAME_PROP);
    LogDebug("faccao", "TotemDeAquisicao: Nome do território no totem: " + rect_name);
    
    if (!rect_name)
        LogWarning("faccao", "TotemDeAquisicao: Totem inválido - CProp '" + TERRITORY_NAME_PROP + "' não encontrada.");
        SendSysMessage(who, "Totem inválido (nome do território ausente).");
        return 0;
    endif;
    
    var territory_id := GetObjProperty(totem, TERRITORY_ID_PROP);
    LogDebug("faccao", "TotemDeAquisicao: ID do território no totem: " + territory_id);
    
    if (!territory_id)
        LogWarning("faccao", "TotemDeAquisicao: Totem inválido - CProp '" + TERRITORY_ID_PROP + "' não encontrada.");
        SendSysMessage(who, "Totem inválido (ID do território ausente).");
        return 0;
    endif;
    
    var territory_info_from_datafile := TM_GetTerritoryInfo(territory_id); 
    if (!territory_info_from_datafile)
        territory_info_from_datafile := TM_GetTerritoryInfo(rect_name);
        if (territory_info_from_datafile && territory_info_from_datafile.id != territory_id)
            LogWarning("faccao", "TotemDeAquisicao: Território encontrado pelo NOME ('" + rect_name + "') mas ID no datafile ('" + territory_info_from_datafile.id + "') difere do ID do totem ('" + territory_id + "'). Priorizando ID do datafile.");
            territory_id := territory_info_from_datafile.id; 
        endif;
    endif;

    if (!territory_info_from_datafile)
        LogWarning("faccao", "TotemDeAquisicao: Território (ID: " + territory_id + ", Nome: " + rect_name + ") não encontrado no datafile :architect:areas.");
        SendSysMessage(who, "Território referenciado por este totem não existe mais no sistema.");
        return 0;
    endif;

    if (territory_info_from_datafile.name != rect_name)
        LogInfo("faccao", "TotemDeAquisicao: Nome do território no totem ('" + rect_name + "') corrigido para o nome do datafile ('" + territory_info_from_datafile.name + "').");
        rect_name := territory_info_from_datafile.name;
    endif;
    
    var guild := who.guild;
    LogDebug("faccao", "TotemDeAquisicao: Guild do jogador: " + (guild ? guild.guildid : "NULL"));
    
    if (!guild)
        LogWarning("faccao", "TotemDeAquisicao: Jogador " + who.name + " não pertence a uma facção.");
        SendSysMessage(who, "Você precisa pertencer a uma facção para reivindicar territórios.");
        return 0;
    endif;
    
    var guild_obj_info := GetFaccao(guild); 
    LogDebug("faccao", "TotemDeAquisicao: Informações da facção (GetFaccao): " + (guild_obj_info ? "Obtidas" : "NULL"));
    
    if (!guild_obj_info || guild_obj_info.leader != who.serial)
        LogWarning("faccao", "TotemDeAquisicao: Jogador " + who.name + " (Serial: " + who.serial + ") não é o líder da facção (Líder reg: " + (guild_obj_info ? guild_obj_info.leader : "N/A") + ").");
        SendSysMessage(who, "Apenas o líder da facção pode reivindicar territórios.");
        return 0;
    endif;
    
    var territorio_elem := TM_FindTerritory(territory_id); 
    LogDebug("faccao", "TotemDeAquisicao: Elemento do território no datafile: " + (territorio_elem ? "Encontrado" : "NÃO Encontrado"));
    
    if (!territorio_elem)
        LogError("faccao", "TotemDeAquisicao: Falha crítica - Território (ID: " + territory_id + ") não pôde ser encontrado por TM_FindTerritory.");
        SendSysMessage(who, "Erro interno ao processar o território. Avise um administrador.");
        return 0;
    endif;
    
    var current_faction_in_datafile := territory_info_from_datafile.faction;
    LogDebug("faccao", "TotemDeAquisicao: Facção atual do território no datafile: " + current_faction_in_datafile);

    if (current_faction_in_datafile && current_faction_in_datafile != DEFAULT_FACTION && current_faction_in_datafile != "Selvagem")
        LogWarning("faccao", "TotemDeAquisicao: Território '" + rect_name + "' já está reivindicado por: " + current_faction_in_datafile);
        SendSysMessage(who, "Este território já está reivindicado por: " + current_faction_in_datafile);
        return 0;
    endif;
    
    var player_faction_name := GetPlayerFaction(who); 
    if (!player_faction_name)
        player_faction_name := "Desconhecido"; 
        LogWarning("faccao", "TotemDeAquisicao: Não foi possível obter o nome da facção do jogador " + who.name + ". Usando 'Desconhecido'.");
    endif;
    LogDebug("faccao", "TotemDeAquisicao: Facção do jogador obtida: " + player_faction_name);
    
    LogDebug("faccao", "TotemDeAquisicao: Definindo facção do território '" + rect_name + "' (ID: " + territory_id + ") para '" + player_faction_name + "'");
    var set_faction_result := TM_SetTerritoryFaction(territory_id, player_faction_name); 
    LogDebug("faccao", "TotemDeAquisicao: TM_SetTerritoryFaction concluído, resultado: " + set_faction_result);
    
    LogDebug("faccao", "TotemDeAquisicao: Adicionando território à CProp 'territories' da guilda " + guild.guildid);
    var territories_list := guild.GetProp("territories");
    if (!territories_list || territories_list == error || TypeOf(territories_list) != "Array")
        LogDebug("faccao_totem", "CProp 'territories' não existia ou era inválida para guilda " + guild.guildid + ". Criando novo array.");
        territories_list := array{};
    endif;

    var cleaned_territories_list := array{};
    foreach terr_item_loop_local in territories_list 
        if (TypeOf(terr_item_loop_local) == "String" && terr_item_loop_local != "")
            cleaned_territories_list.append(terr_item_loop_local);
        endif;
    endforeach;
    territories_list := cleaned_territories_list;

    var territory_exists_in_list := 0; 
    foreach terr_check_loop_local in territories_list 
        if (terr_check_loop_local == territory_id) 
            territory_exists_in_list := 1;
            break;
        endif;
    endforeach;

    if (!territory_exists_in_list)
        LogInfo("faccao_totem", "Adicionando território ID '" + territory_id + "' (Nome: '" + rect_name + "') à lista da guilda " + guild.guildid);
        territories_list.append(territory_id); 
        
        var max_retries_setprop := 3;
        var retry_count_setprop := 0;
        var success_setprop := 0;
        while (!success_setprop && retry_count_setprop < max_retries_setprop)
            retry_count_setprop += 1;
            var set_prop_call_result := guild.SetProp("territories", territories_list);
            if (set_prop_call_result != error)
                success_setprop := 1;
                LogDebug("faccao_totem", "CProp 'territories' atualizada com sucesso na guilda " + guild.guildid + ". Novo tamanho: " + territories_list.size() + " na tentativa #" + retry_count_setprop);
            else
                LogWarning("faccao_totem", "Falha ao salvar CProp 'territories' na guilda " + guild.guildid + ", tentativa #" + retry_count_setprop + ": " + set_prop_call_result);
                sleep(1); 
            endif;
        endwhile;
        if (!success_setprop)
            LogError("faccao_totem", "FALHA CRÍTICA: Todas as tentativas de SetProp 'territories' falharam para guilda " + guild.guildid);
        endif;
    else
        LogInfo("faccao_totem", "Território ID '" + territory_id + "' (Nome: '" + rect_name + "') já existe na lista da guilda " + guild.guildid + ". Não foi adicionado novamente.");
    endif;
    
    LogDebug("faccao", "TotemDeAquisicao: Criando monumento no território '" + rect_name + "' (ID: " + territory_id + ")");
    // CORREÇÃO: Removido 'totem' da chamada, pois CreateTerritoryMonument foi ajustada para não recebê-lo.
    var monument := CreateTerritoryMonument(who, territorio_elem, rect_name, territory_id); 
    LogDebug("faccao", "TotemDeAquisicao: Monumento criado: " + (monument ? "Sim, serial=" + monument.serial : "Não"));
    
    LogDebug("faccao", "TotemDeAquisicao: Configurando recursos para o território '" + rect_name + "'");
    var recursos_atuais_prop := GetElementProp(territorio_elem, "Resources", "");
    LogDebug("faccao", "TotemDeAquisicao: Recursos atuais no datafile do território: '" + recursos_atuais_prop + "'");
    
    if (!recursos_atuais_prop) 
        LogDebug("faccao", "TotemDeAquisicao: Nenhum recurso configurado para '" + rect_name + "', usando padrão.");
        var default_resources_list := SplitWords("ironore, couroespesso, cogumelo", ","); 
        
        var update_result := TM_UpdateTerritoryResources(territory_id, default_resources_list, 2, 5); 
        LogDebug("faccao", "TotemDeAquisicao: Resultado de TM_UpdateTerritoryResources (padrão): " + update_result);
    else
        LogDebug("faccao", "TotemDeAquisicao: Recursos existentes para '" + rect_name + "', atualizando apenas próxima geração.");
        var interval_prop := CInt(GetElementProp(territorio_elem, "ResourceInterval", 2)); 
        var next_time_calc := polcore().systime + (interval_prop * 60); 
        LogDebug("faccao", "TotemDeAquisicao: Próxima geração para '" + rect_name + "' em " + interval_prop + " minutos (Timestamp: " + next_time_calc + ")");
        
        var set_next_time_result := SetElementProp(territorio_elem, "NextResourceTime", next_time_calc);
        LogDebug("faccao", "TotemDeAquisicao: Resultado de definir NextResourceTime para '" + rect_name + "': " + set_next_time_result);
    endif;
    
    LogInfo("faccao", "TotemDeAquisicao: Notificando ResourceController sobre novo território.");
    SendSysMessage(who, "Configurando sistema de recursos para o novo território...");
    
    var notify_data := struct;
    notify_data.+name := rect_name;
    notify_data.+faction := player_faction_name;
    notify_data.+resources := GetElementProp(territorio_elem, "Resources", "");
    TM_NotifyTerritoryChange(territory_id, "claimed", notify_data);
    SendSysMessage(who, "Sistema de recursos notificado sobre o novo território!");
    
    LogDebug("faccao", "TotemDeAquisicao: Destruindo totem " + totem.serial + " após uso.");
    var destroy_totem_result := DestroyItem(totem);
    LogDebug("faccao", "TotemDeAquisicao: Resultado de DestroyItem(totem): " + destroy_totem_result);
    
    SendSysMessage(who, "Sua facção reivindicou com sucesso o território: " + rect_name);
    SendSysMessage(who, "O território começará a produzir recursos em breve.");
    PrintTextAbove(who, "*" + who.name + " reivindica este território em nome de " + player_faction_name + "*");

 // Sincronizar lista de territórios
    SyncGuildTerritories(player_faction_name);
    
    LogInfo("faccao", "TotemDeAquisicao: Território '" + rect_name + "' (ID: " + territory_id + ") reivindicado com sucesso por " + player_faction_name);
    
    return 1;
endprogram

// A função RestartResourceController foi removida daqui.
// A notificação via TM_NotifyTerritoryChange é a abordagem preferida.

function CreateTerritoryMonument(who, elem, rect_name, territory_id) // REMOVIDO PARÂMETRO 'totem'
    LogDebug("faccao_monument", "CreateTerritoryMonument: Iniciando para Território '" + rect_name + "' (ID: " + territory_id + ")");

    var rect := GetElementProp(elem, TERRITORY_RECT_PROP, ""); 
    var realm_prop_mon := GetElementProp(elem, TERRITORY_REALM_PROP, ""); 
    if (!realm_prop_mon) realm_prop_mon := "britannia"; endif; 
    
    var coords := SplitWords(rect);
    
    if (!territory_id)
        LogError("faccao_monument", "CreateTerritoryMonument: ID do território não fornecido ou inválido!");
        territory_id := "TER_ORPHAN_" + CStr(polcore().systime); 
        SetElementProp(elem, TERRITORY_ID_PROP, territory_id);
    endif;
    
    if (coords.size() >= 4)
        var center_info := TM_GetTerritoryCenter(territory_id); 
        if (!center_info)
            LogError("faccao_monument", "CreateTerritoryMonument: Falha ao obter centro para território ID: " + territory_id);
            SendSysMessage(who, "Erro crítico ao determinar o centro do território.");
            return 0;
        endif;
        var center_x := center_info.x;
        var center_y := center_info.y;
        var center_z := center_info.z;
        // Usar realm_prop_mon que já foi obtido e verificado
        
        var player_faction_name_mon := GetPlayerFaction(who); 
        if (!player_faction_name_mon) 
            player_faction_name_mon := who.guild.GetProp("name", who.guild.guildname); // Tenta prop "name" ou guildname
            if (!player_faction_name_mon) player_faction_name_mon := "Desconhecida"; endif;
        endif;
        
        var seriais_df := SafeOpenDataFile(":faccao:seriais", 1); 
        if (!seriais_df)
            LogError("faccao_monument", "CreateTerritoryMonument: Falha crítica ao abrir/criar datafile :faccao:seriais");
            SendSysMessage(who, "Erro de sistema ao registrar objetos do território.");
            return 0;
        endif;
        
        var monument_obj := CreateItemAtLocation(center_x - 1, center_y, center_z, 0x46AE, 1, realm_prop_mon); 
        if (monument_obj)
            LogDebug("faccao_monument", "Mural criado: " + monument_obj.serial);
            SetObjProperty(monument_obj, TERRITORY_NAME_PROP, rect_name);
            SetObjProperty(monument_obj, TERRITORY_ID_PROP, territory_id);
            SetObjProperty(monument_obj, OBJ_FACTION_PROP, player_faction_name_mon);
            
            var unique_id_mural := TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MURAL, territory_id);
            SetObjProperty(monument_obj, UNIQUE_ID_PROP, unique_id_mural);
            
            monument_obj.name := "Mural de Recrutamento [" + player_faction_name_mon + "] - " + territory_id;
            SetObjProperty(monument_obj, "CreatedBy", who.serial);
            SetObjProperty(monument_obj, "CreationDate", polcore().systime);
            monument_obj.movable := 0;
            monument_obj.usescript := ":faccao:faccao";
            
            var donation_chest_obj := CreateItemAtLocation(center_x, center_y, center_z, 0xff11, 1, realm_prop_mon); 
            if (donation_chest_obj)
                LogDebug("faccao_monument", "Baú de doações criado: " + donation_chest_obj.serial);
                var unique_id_bau_local := TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_BAU, territory_id); 
                SetObjProperty(donation_chest_obj, UNIQUE_ID_PROP, unique_id_bau_local);
                
                donation_chest_obj.name := "Baú de Doações [" + player_faction_name_mon + "] - " + territory_id;
                SetObjProperty(donation_chest_obj, OBJ_FACTION_PROP, player_faction_name_mon);
                SetObjProperty(donation_chest_obj, TERRITORY_ID_PROP, territory_id);
                SetObjProperty(donation_chest_obj, CHEST_ID_PROP, player_faction_name_mon + "_" + territory_id);
                donation_chest_obj.movable := 0;
                
                donation_chest_obj.usescript := ":faccao:baudoacao/use";
                SetObjProperty(donation_chest_obj, "OnInsertScript", ":faccao:baudoacao/onInsert");
                SetObjProperty(donation_chest_obj, "OnRemoveScript", ":faccao:baudoacao/onRemove");
                SetObjProperty(donation_chest_obj, "CanInsertScript", ":faccao:baudoacao/canInsert");
                SetObjProperty(donation_chest_obj, "CanRemoveScript", ":faccao:baudoacao/canRemoveDonation");
                
                var interface_item_obj := CreateItemAtLocation(center_x + 1, center_y, center_z, 0xFE5C, 1, realm_prop_mon);                if (interface_item_obj)
                    LogDebug("faccao_monument", "Mesa de gestão criada: " + interface_item_obj.serial);
                    var unique_id_mesa_local := TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MESA, territory_id); 
                    SetObjProperty(interface_item_obj, UNIQUE_ID_PROP, unique_id_mesa_local);
                    
                    interface_item_obj.name := "Mesa de Gestão [" + player_faction_name_mon + "] - " + territory_id;
                    SetObjProperty(interface_item_obj, OBJ_FACTION_PROP, player_faction_name_mon);
                    SetObjProperty(interface_item_obj, TERRITORY_ID_PROP, territory_id);
                    interface_item_obj.movable := 0;
                    interface_item_obj.usescript := ":faccao:gestao_use";
                      // Criar Mesa de Inscrição na posição especificada (X vermelho)
                    var inscricao_item_obj := CreateItemAtLocation(center_x + 1, center_y + 1, center_z, 0xF8A8, 1, realm_prop_mon);
                    if (inscricao_item_obj)
                        LogDebug("faccao_monument", "Mesa de inscrição criada: " + inscricao_item_obj.serial);
                        var unique_id_inscricao_local := TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MESA_INSCRICAO, territory_id);
                        SetObjProperty(inscricao_item_obj, UNIQUE_ID_PROP, unique_id_inscricao_local);
                        
                        inscricao_item_obj.name := "Mesa de Inscrição [" + player_faction_name_mon + "] - " + territory_id;
                        SetObjProperty(inscricao_item_obj, OBJ_FACTION_PROP, player_faction_name_mon);
                        SetObjProperty(inscricao_item_obj, TERRITORY_ID_PROP, territory_id);
                        inscricao_item_obj.movable := 0;
                        inscricao_item_obj.usescript := ":faccao:mesainscricao";
                        
                        var object_serials_struct := struct; 
                        object_serials_struct.+bau := donation_chest_obj.serial;
                        object_serials_struct.+mesa := interface_item_obj.serial;
                        object_serials_struct.+mesa_inscricao := inscricao_item_obj.serial;
                        object_serials_struct.+mural := monument_obj.serial;
                        object_serials_struct.+faction := player_faction_name_mon;
                        object_serials_struct.+coords := rect; 
                        object_serials_struct.+realm := realm_prop_mon; // Usar realm_prop_mon
                        
                        TM_RegisterTerritoryObjects(territory_id, object_serials_struct);
                        
                        SendSysMessage(who, "Monumento de território criado com sucesso. Recursos serão entregues no baú de doações.");
                        SendSysMessage(who, "Mesa de inscrição disponível para novos membros da facção.");
                        return monument_obj;
                    else
                        LogWarning("faccao_monument", "Falha ao criar mesa de inscrição, mas território ainda é válido");
                        var object_serials_struct := struct; 
                        object_serials_struct.+bau := donation_chest_obj.serial;
                        object_serials_struct.+mesa := interface_item_obj.serial;
                        object_serials_struct.+mural := monument_obj.serial;
                        object_serials_struct.+faction := player_faction_name_mon;
                        object_serials_struct.+coords := rect; 
                        object_serials_struct.+realm := realm_prop_mon;
                        
                        TM_RegisterTerritoryObjects(territory_id, object_serials_struct);
                        
                        SendSysMessage(who, "Monumento de território criado com sucesso. Recursos serão entregues no baú de doações.");
                        SendSysMessage(who, "Aviso: Mesa de inscrição não pôde ser criada.");
                        return monument_obj;
                    endif;                else
                    SendSysMessage(who, "Falha ao criar a mesa de gestão. Por favor, notifique um GM.");
                    DestroyItem(monument_obj); 
                    DestroyItem(donation_chest_obj); 
                endif;
            else
                SendSysMessage(who, "Falha ao criar o baú de doações. Por favor, notifique um GM.");
                DestroyItem(monument_obj); 
            endif;
        else
            SendSysMessage(who, "Falha ao criar o mural de recrutamento. Por favor, notifique um GM.");
        endif;
    else
        LogError("faccao_monument", "CreateTerritoryMonument: Coordenadas inválidas para território ID: " + territory_id + ", Rect: " + rect);
        SendSysMessage(who, "Erro nas coordenadas do território ao criar monumento.");
    endif;
    
    return 0;
endfunction