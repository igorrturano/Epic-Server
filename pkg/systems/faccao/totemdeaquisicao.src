use uo;
use os;
use datafile;
use math;

include ":faccao:faccao"; 
include ":faccao:include/faccao_constants";
include ":faccao:include/shared_functions"; 
include ":faccao:include/territory_management"; 
include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:epicGumps";
include "include/epicConstants";
include "include/say";
include "include/client";

// Constantes locais específicas deste arquivo
const MOEDAS_COBRE := 0xBA63;

program TotemDeAquisicao(who, totem)
    LogDebug("faccao", "TotemDeAquisicao: Iniciando função com who=" + who.serial + ", totem=" + totem.serial);
    
    if (!who || !totem)
        LogError("faccao", "TotemDeAquisicao: Parâmetros inválidos (who ou totem nulo).");
        return 0;
    endif;
    
    var rect_name := GetObjProperty(totem, TERRITORY_NAME_PROP);
    var territory_id := GetObjProperty(totem, TERRITORY_ID_PROP);
    
    if (!rect_name || !territory_id)
        SendSysMessage(who, "Totem inválido.");
        return 0;
    endif;
    
    var territory_info_from_datafile := TM_GetTerritoryInfo(territory_id);
    if (!territory_info_from_datafile)
        SendSysMessage(who, "Território referenciado por este totem não existe mais no sistema.");
        return 0;
    endif;

    rect_name := territory_info_from_datafile.name; // Garante que estamos usando o nome atualizado
    
    var guild := who.guild;
    if (!guild)
        SendSysMessage(who, "Você precisa pertencer a uma facção para reivindicar territórios.");
        return 0;
    endif;

     var expiration_time := GetObjProperty(totem, "ClaimByTimestamp");
    if (expiration_time && polcore().systime > CInt(expiration_time))
        SendSysMessage(who, "Este totem expirou e não pode mais ser usado para reivindicar o território.");
        // O TotemWatcher irá eventualmente destruir este item, mas podemos destruí-lo agora.
        DestroyItem(totem);
        return 0;
    endif;
    
    var guild_obj_info := GetFaccao(guild); 
    if (!guild_obj_info || guild_obj_info.leader != who.serial)
        SendSysMessage(who, "Apenas o líder da facção pode reivindicar territórios.");
        return 0;
    endif;
    
    var territorio_elem := TM_FindTerritory(territory_id); 
    if (!territorio_elem)
        SendSysMessage(who, "Erro interno ao processar o território. Avise um administrador.");
        return 0;
    endif;
    
    if (territory_info_from_datafile.faction && territory_info_from_datafile.faction != DEFAULT_FACTION)
        SendSysMessage(who, "Este território já está reivindicado por: " + territory_info_from_datafile.faction);
        return 0;
    endif;
    
    var player_faction_name := GetPlayerFaction(who); 
    if (!player_faction_name)
        player_faction_name := "Desconhecido";
    endif;
    
    // --- LÓGICA DE CULTURA E ESTANDARTE CORRIGIDA ---
    
    // 1. CULTURA: Verifica e, se necessário, solicita a escolha.
    var cultura_final_reino := SafeGetGuildProperty(guild, "culture", "");
    if (!cultura_final_reino)
        cultura_final_reino := SelectKingdomCulture(who);
        if (!cultura_final_reino)
            SendSysMessage(who, "Você cancelou a seleção de cultura. Aquisição de território cancelada.");
            return 0;
        endif;
        guild.SetProp("culture", cultura_final_reino);
    endif;

    // 2. ESTANDARTE: Verifica e, se necessário, oferece a compra/seleção.
    var estandarte_escolhido := CInt(SafeGetGuildProperty(guild, "kingdom_banner_graphic", 0));
    if (!estandarte_escolhido)
        var compra_banner := ConfirmBannerPurchase(who);
        if (compra_banner == 1)
            estandarte_escolhido := SelectKingdomBanner(who);
            if (estandarte_escolhido)
                guild.SetProp("kingdom_banner_graphic", estandarte_escolhido);
            else
                SendSysMessage(who, "Seleção de estandarte cancelada. Nenhum estandarte será criado desta vez.");
            endif;
        elseif (compra_banner == -1)
            SendSysMessage(who, "Operação cancelada.");
            return 0;
        endif;
    endif;
    
    // --- FIM DA LÓGICA CORRIGIDA ---
    
    TM_SetTerritoryFaction(territory_id, player_faction_name);
    
    var territories_list := guild.GetProp("territories");
    if (!territories_list || territories_list == error || TypeOf(territories_list) != "Array")
        territories_list := array{};
    endif;

    var cleaned_territories_list := array{};
    foreach terr_item_loop_local in territories_list 
        if (TypeOf(terr_item_loop_local) == "String" && terr_item_loop_local != "")
            cleaned_territories_list.append(terr_item_loop_local);
        endif;
    endforeach;
    territories_list := cleaned_territories_list;

    var territory_exists_in_list := 0; 
    foreach terr_check_loop_local in territories_list 
        if (terr_check_loop_local == territory_id) 
            territory_exists_in_list := 1;
            break;
        endif;
    endforeach;

    if (!territory_exists_in_list)
        territories_list.append(territory_id); 
    endif;

    guild.SetProp("territories", territories_list);
    
    if (territories_list.size() == 1)
        SendSysMessage(who, "Como este é o primeiro território do seu reino, '" + rect_name + "' foi automaticamente designada como sua capital!", 3, 53);
        TM_SetTerritoryAsCapital(territory_id, player_faction_name);
    endif;
    
    CreateTerritoryMonument(who, territorio_elem, rect_name, territory_id, cultura_final_reino, estandarte_escolhido);
    
    var recursos_atuais_prop := GetElementProp(territorio_elem, "Resources", "");
    if (!recursos_atuais_prop) 
        var default_resources_list := SplitWords("ironore, couroespesso, cogumelo", ","); 
        TM_UpdateTerritoryResources(territory_id, default_resources_list, 2, 5); 
    else
        var interval_prop := CInt(GetElementProp(territorio_elem, "ResourceInterval", 2)); 
        var next_time_calc := polcore().systime + (interval_prop * 60); 
        SetElementProp(territorio_elem, "NextResourceTime", next_time_calc);
    endif;
    
    var notify_data := struct;
    notify_data.+name := rect_name;
    notify_data.+faction := player_faction_name;
    notify_data.+resources := GetElementProp(territorio_elem, "Resources", "");
    TM_NotifyTerritoryChange(territory_id, "claimed", notify_data);
    
    var totem_registry_df := SafeOpenDataFile(":faccao:totem_registry");
if (totem_registry_df)
    // A função DeleteDatafileEntry já verifica se o elemento existe antes de apagar.
    if (DeleteDatafileEntry(":faccao:totem_registry", CStr(totem.serial)))
        LogInfo("TotemClaim", "Totem " + totem.serial + " removido do registro após reivindicação bem-sucedida.");
    endif
endif

    DestroyItem(totem);
    
    SendSysMessage(who, "Sua facção reivindicou com sucesso o território: " + rect_name);
    PrintTextAbove(who, "*" + who.name + " reivindica este território em nome de " + player_faction_name + "*");
    
    return 1;
endprogram

function SelectKingdomCulture(who)
    var gump := GFECreateGump("Seleção de Cultura do Reino", 600, 500, array{});
    GFTextLine(gump, 100, 85, 53, "Escolha a cultura que definirá a identidade do seu reino.");
    GFTextLine(gump, 80, 105, 230, "Esta decisão influenciará a arquitetura e tradições do território.");
    
    var culturas := array{
        struct{ nome := "Aiglana",          enum_val := "aiglana",          descricao := "Império organizado com tradições militares" },
        struct{ nome := "Har'oloth",        enum_val := "haroloth",         descricao := "Cultura drow subterrânea e misteriosa" },
        struct{ nome := "Povos do Leste",   enum_val := "povos_do_leste",   descricao := "Tradições orientais e disciplina marcial" },
        struct{ nome := "Björska",          enum_val := "bjorske",          descricao := "Guerreiros nórdicos valorosos e tradicionais" },
        struct{ nome := "Alüriel",          enum_val := "aluriel",          descricao := "Cultura élfica ligada à natureza e magia" },
        struct{ nome := "Badûran",          enum_val := "baduran",          descricao := "Anões mestres da forja e engenharia" },
        struct{ nome := "Gulthrak",         enum_val := "gulthrak",         descricao := "Orcs do deserto adaptados ao clima árido" },
        struct{ nome := "Polkinea",         enum_val := "polkinea",         descricao := "Polski pacíficos e agricultores habilidosos" }
    };
    
    var y_pos := 130;
    var button_id := 100;
    
    foreach cultura in culturas
        GFAddButton(gump, 40, y_pos, 4005, 4007, GF_CLOSE_BTN, button_id);
        GFTextLine(gump, 80, y_pos + 3, 53, cultura.nome);
        GFTextLine(gump, 290, y_pos + 3, 230, cultura.descricao);
        y_pos += 35;
        button_id += 1;
    endforeach
    
    GFAddButton(gump, 250, 450, 2071, 2072, GF_CLOSE_BTN, 0); // Botão Cancelar genérico
    
    var input := GFSendGump(who, gump);

    if (!input || input[0] == 0)
        return 0;
    endif

    var button_pressed := input[0];
    
    if (button_pressed >= 100 && button_pressed < 200)
        var cultura_index := button_pressed - 100 + 1;
        
        if (cultura_index < 1 || cultura_index > culturas.size())
            SendSysMessage(who, "ERRO: Índice da cultura fora dos limites!");
            return 0;
        endif
        
        var cultura_escolhida := culturas[cultura_index];
        
        var confirm_msg := "Você escolheu a cultura " + cultura_escolhida.nome + " para seu reino.\n" +
                          cultura_escolhida.descricao + "\n\n" +
                          "Tem certeza desta escolha? Esta decisão é permanente.";
        
        if (YesNo(who, confirm_msg))
            SendSysMessage(who, "Cultura " + cultura_escolhida.nome + " definida para o reino!");
            
            // ===== MUDANÇA CRÍTICA =====
            // Retorna o valor padronizado para ser salvo na CProp, sem espaços ou acentos.
            return cultura_escolhida.enum_val;
        else
            SendSysMessage(who, "Seleção de cultura cancelada.");
            return 0;
        endif
    endif
    
    return 0;
endfunction

/**
 * Purpose: Exibe um gump para o líder selecionar o estandarte do reino
 * Parameters: who - jogador que está selecionando
 * Return: Hex do graphic escolhido ou 0 se cancelou
 */
function SelectKingdomBanner(who)
    // Graphics de visualização no gump (mapeamento 0xFEB3-0xFECE)
    var graphics_gump := array{
        0xFEB3, 0xFEB4, 0xFEB5, 0xFEB6, 0xFEB7, 0xFEB8, 0xFEB9, 0xFEBA, 0xFEBB,
        0xFEBC, 0xFEBD, 0xFEBE, 0xFEBF, 0xFEC0, 0xFEC1, 0xFEC2, 0xFEC3, 0xFEC4,
        0xFEC5, 0xFEC6, 0xFEC7, 0xFEC8, 0xFEC9, 0xFECA, 0xFECB, 0xFECC, 0xFECD, 0xFECE
    };
    
    // Graphics dos itens reais criados no mundo (mapeamento 1:1)
    var estandartes := array{
        0xF93A, 0xF93B, 0xF93C, 0xF93D, 0xF93E, 0xF93F, 0xF940, 0xF942, 0xF943,
        0xF920, 0xF921, 0xF922, 0xEB24, 0xC413, 0xC40E, 0xC3A5, 0xC3A1, 0xC395,
        0xBD8A, 0xBD88, 0xBD86, 0xBD72, 0x4038, 0x9FAD, 0x9FAF, 0x9FB1, 0x9FB3, 0xB93C
    };
    
    var banners_per_page := 9; // 3x3
    var total_pages := (estandartes.size() + banners_per_page - 1) / banners_per_page;
    var current_page := 1;
    
    while (current_page >= 1 && current_page <= total_pages)
        var gump := GFECreateGump("Seleção de Estandarte do Reino", 700, 600, array{});
        
        // Título e instruções
        GFTextLine(gump, 120, 85, 53, "Escolha o estandarte que representará seu reino.");
        
        // Calcular estandartes para a página atual
        var start_index := (current_page - 1) * banners_per_page + 1;
        var end_index := start_index + banners_per_page - 1;
        if (end_index > estandartes.size())
            end_index := estandartes.size();
        endif
        
        // Layout 3x3: mostrar estandartes da página atual
        var banner_index := 0;
        var i;
        for (i := start_index; i <= end_index; i := i + 1)
            var row := banner_index / 3;
            var col := banner_index % 3;
            
            // Posições para layout 3x3 com espaçamento (subido 30 pixels)
            var x_pos := 150 + (col * 180);
            var y_pos := 120 + (row * 150);
              // Quadrado ao redor do estandarte
            GFResizePic(gump, x_pos - 30, y_pos - 30, 9200, 120, 120);
            // Mostrar o graphic de visualização no gump
            GFGumpPic(gump, x_pos, y_pos, graphics_gump[i]);
            
            // Botão de seleção
            var button_id := 100 + i;
            GFAddButton(gump, x_pos - 20, y_pos + 60, 4005, 4007, GF_CLOSE_BTN, button_id);
            
            banner_index := banner_index + 1;
        endfor
        
        // Informações de página
        if (total_pages > 1)
            GFTextLine(gump, 280, 520, 53, "Página " + current_page + " de " + total_pages);
            
            // Botão página anterior
            if (current_page > 1)
                GFAddButton(gump, 200, 550, 4014, 4016, GF_CLOSE_BTN, 201);
                GFTextLine(gump, 230, 553, 230, "Anterior");
            endif
            
            // Botão próxima página
            if (current_page < total_pages)
                GFAddButton(gump, 420, 550, 4005, 4007, GF_CLOSE_BTN, 202);
                GFTextLine(gump, 450, 553, 230, "Próxima");
            endif
        endif
        
        // Botão cancelar
        GFAddButton(gump, 50, 550, 4017, 4019, GF_CLOSE_BTN, 0);
        GFTextLine(gump, 80, 553, 38, "Cancelar");
        
        var input := GFSendGump(who, gump);
        
        if (!input)
            return 0; // Cancelou
        endif
        
        var button := input[0];
        
        if (button == 0)
            return 0; // Cancelou
        elseif (button == 201) // Página anterior
            current_page := current_page - 1;
        elseif (button == 202) // Próxima página
            current_page := current_page + 1;
        elseif (button >= 101 && button <= 133) // Selecionou um estandarte
            var selected_index := button - 100;
            if (selected_index >= 1 && selected_index <= estandartes.size())
                return estandartes[selected_index];
            endif
        endif
    endwhile
    
    return 0;
endfunction

// Em pkg/systems/faccao/totemdeaquisicao.src

function CreateTerritoryMonument(who, elem, rect_name, territory_id, cultura_escolhida, estandarte_escolhido)
    LogDebug("faccao_monument", "CreateTerritoryMonument: Iniciando para Território '" + rect_name + "' (ID: " + territory_id + ")");

    var rect := GetElementProp(elem, TERRITORY_RECT_PROP, "");
    var realm_prop_mon := GetElementProp(elem, TERRITORY_REALM_PROP, "britannia");
    var coords := SplitWords(rect);
    
    if (!territory_id)
        LogError("faccao_monument", "CreateTerritoryMonument: ID do território não fornecido ou inválido! Abortando.");
        return 0;
    endif
    
    if (coords.size() < 4)
        LogError("faccao_monument", "CreateTerritoryMonument: Coordenadas inválidas para território ID: " + territory_id + ", Rect: " + rect);
        return 0;
    endif

    var center_info := TM_GetTerritoryCenter(territory_id);
    if (!center_info)
        LogError("faccao_monument", "CreateTerritoryMonument: Falha ao obter centro para território ID: " + territory_id);
        return 0;
    endif
    
    var center_x := center_info.x;
    var center_y := center_info.y;
    var center_z := center_info.z;
    
    var player_faction_name_mon := GetPlayerFaction(who);
    var object_serials_struct := struct; // Struct para registrar todos os seriais

    // --- Criação do Mural ---
    var monument_obj := CreateItemAtLocation(center_x - 1, center_y, center_z, 0x46AE, 1, realm_prop_mon);
    if (monument_obj)
        LogDebug("faccao_monument", "-> Mural de Recrutamento criado (Serial: " + monument_obj.serial + ")");
        monument_obj.name := "Mural de Recrutamento [" + player_faction_name_mon + "] - " + territory_id;
        monument_obj.movable := 0;
        monument_obj.usescript := ":faccao:faccao";
        SetObjProperty(monument_obj, OBJ_FACTION_PROP, player_faction_name_mon);
        // CORREÇÃO APLICADA: Garantir que a CProp padrão também use o ID único
        SetObjProperty(monument_obj, "TerritoryID", territory_id);
        SetObjProperty(monument_obj, "guild_id", who.guild.guildid);
        SetObjProperty(monument_obj, UNIQUE_ID_PROP, TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MURAL, territory_id));
        object_serials_struct.+mural := monument_obj.serial;
    else
        LogWarning("faccao_monument", "Falha ao criar o Mural de Recrutamento.");
    endif

    // --- Criação do Baú de Doações ---
    var donation_chest_obj := CreateItemAtLocation(center_x, center_y, center_z, 0xff11, 1, realm_prop_mon);
    if (donation_chest_obj)
        LogDebug("faccao_monument", "-> Baú de Doações criado (Serial: " + donation_chest_obj.serial + ")");
        donation_chest_obj.name := "Baú de Doações [" + player_faction_name_mon + "] - " + territory_id;
        donation_chest_obj.movable := 0;
        donation_chest_obj.usescript := ":faccao:baudoacao/use";
        SetObjProperty(donation_chest_obj, "OnInsertScript", ":faccao:baudoacao/onInsert");
        SetObjProperty(donation_chest_obj, "OnRemoveScript", ":faccao:baudoacao/onRemove");
        SetObjProperty(donation_chest_obj, "CanInsertScript", ":faccao:baudoacao/canInsert");
        SetObjProperty(donation_chest_obj, "CanRemoveScript", ":faccao:baudoacao/canRemoveDonation");
        SetObjProperty(donation_chest_obj, OBJ_FACTION_PROP, player_faction_name_mon);
        // CORREÇÃO APLICADA: Garantir que a CProp padrão também use o ID único
        SetObjProperty(donation_chest_obj, "TerritoryID", territory_id);
        SetObjProperty(donation_chest_obj, "guild_id", who.guild.guildid);
        SetObjProperty(donation_chest_obj, UNIQUE_ID_PROP, TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_BAU, territory_id));
        object_serials_struct.+bau := donation_chest_obj.serial;
    else
        LogWarning("faccao_monument", "Falha ao criar o Baú de Doações.");
    endif

    // --- Criação da Mesa de Gestão ---
    var interface_item_obj := CreateItemAtLocation(center_x + 1, center_y, center_z, 0xFE5C, 1, realm_prop_mon);
    if (interface_item_obj)
        LogDebug("faccao_monument", "-> Mesa de Gestão criada (Serial: " + interface_item_obj.serial + ")");
        interface_item_obj.name := "Mesa de Gestão [" + player_faction_name_mon + "] - " + territory_id;
        interface_item_obj.movable := 0;
        interface_item_obj.usescript := ":faccao:gestao_use";
        SetObjProperty(interface_item_obj, OBJ_FACTION_PROP, player_faction_name_mon);
        // CORREÇÃO APLICADA: Garantir que a CProp padrão também use o ID único
        SetObjProperty(interface_item_obj, "TerritoryID", territory_id);
        SetObjProperty(interface_item_obj, "guild_id", who.guild.guildid);
        SetObjProperty(interface_item_obj, UNIQUE_ID_PROP, TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MESA, territory_id));
        object_serials_struct.+mesa := interface_item_obj.serial;
    else
        LogWarning("faccao_monument", "Falha ao criar a Mesa de Gestão.");
    endif
    
    // --- Criação da Mesa de Inscrição ---
    var inscricao_item_obj := CreateItemAtLocation(center_x + 1, center_y + 1, center_z, 0xF8A8, 1, realm_prop_mon);
    if (inscricao_item_obj)
        LogDebug("faccao_monument", "-> Mesa de Inscrição criada (Serial: " + inscricao_item_obj.serial + ")");
        inscricao_item_obj.name := "Mesa de Inscrição [" + player_faction_name_mon + "]";
        inscricao_item_obj.movable := 0;
        inscricao_item_obj.usescript := ":faccao:mesainscricao";
        SetObjProperty(inscricao_item_obj, OBJ_FACTION_PROP, player_faction_name_mon);
        // CORREÇÃO APLICADA: Garantir que a CProp padrão também use o ID único
        SetObjProperty(inscricao_item_obj, "TerritoryID", territory_id);
        SetObjProperty(inscricao_item_obj, "guild_id", who.guild.guildid);
        SetObjProperty(inscricao_item_obj, UNIQUE_ID_PROP, TM_CreateUniqueItemID(player_faction_name_mon, ITEM_TYPE_MESA_INSCRICAO, territory_id));
        object_serials_struct.+mesa_inscricao := inscricao_item_obj.serial;
    else
        LogWarning("faccao_monument", "Falha ao criar a Mesa de Inscrição.");
    endif

    // --- Criação da Bandeira/Estandarte (se escolhido) ---
    if (estandarte_escolhido && estandarte_escolhido != 0)
        var bandeira_item_obj := CreateItemAtLocation(center_x, center_y - 1, center_z, 0xfddf, 1, realm_prop_mon);
        if (bandeira_item_obj)
            LogDebug("faccao_monument", "-> Estandarte criado (Serial: " + bandeira_item_obj.serial + ")");
            bandeira_item_obj.graphic := estandarte_escolhido;
            bandeira_item_obj.name := "Estandarte de [" + player_faction_name_mon + "] - " + territory_id;
            bandeira_item_obj.movable := 0;
            SetObjProperty(bandeira_item_obj, OBJ_FACTION_PROP, player_faction_name_mon);
            // CORREÇÃO APLICADA: Garantir que a CProp padrão também use o ID único
            SetObjProperty(bandeira_item_obj, "TerritoryID", territory_id);
            SetObjProperty(bandeira_item_obj, "guild_id", who.guild.guildid);
            SetObjProperty(bandeira_item_obj, UNIQUE_ID_PROP, TM_CreateUniqueItemID(player_faction_name_mon, "BANDEIRA", territory_id));
            object_serials_struct.+bandeira := bandeira_item_obj.serial;
            object_serials_struct.+estandarte := estandarte_escolhido;
        else
            LogWarning("faccao_monument", "Falha ao criar o estandarte do reino.");
        endif
    else
        LogDebug("faccao_monument", "Estandarte não foi comprado, nenhuma bandeira criada.");
    endif

    // --- Registro Centralizado dos Seriais ---
    object_serials_struct.+faction := player_faction_name_mon;
    object_serials_struct.+coords := rect;
    object_serials_struct.+realm := realm_prop_mon;
    object_serials_struct.+guild_id := who.guild.guildid;
    
    TM_RegisterTerritoryObjects(territory_id, object_serials_struct);
    
    SendSysMessage(who, "Monumento de território criado com sucesso!");
    return monument_obj;
endfunction

function ConfirmBannerPurchase(who)    var gump := GFECreateGump("Compra de Estandarte do Reino", 400, 300, array{});
    
    // Título
    GFTextLine(gump, 140, 85, 53, "Estandarte do Reino");
    
    // Informações
    GFTextLine(gump, 50, 120, 230, "Deseja adquirir um estandarte para");
    GFTextLine(gump, 70, 140, 230, "representar seu reino?");
    
    // Imagem do estandarte na posição do X vermelho
    GFGumpPic(gump, 350, 120, 0xC2F7);
    
    // Calcular moedas disponíveis (mesmo padrão do gestao_use)
    var moedas_disponiveis := 0;
    foreach moeda in EnumerateItemsInContainer(who.backpack)
        if (moeda.objtype == MOEDAS_COBRE)
            moedas_disponiveis += moeda.amount;
        endif
        sleepms(2);
    endforeach
    
    // Custo e moedas disponíveis
    GFTextLine(gump, 110, 180, 68, "Custo: " + BANNER_CUSTO + " moedas");
    GFTextLine(gump, 80, 200, 230, "Você possui: " + moedas_disponiveis);
    
    // Verificar se tem moedas suficientes
    if (moedas_disponiveis < BANNER_CUSTO)
        GFTextLine(gump, 100, 220, 38, "Moedas insuficientes!");
        GFAddButton(gump, 150, 250, 4017, 4019, GF_CLOSE_BTN, 0);
        GFTextLine(gump, 180, 253, 38, "Fechar");
    else
        // Botões
        GFAddButton(gump, 80, 240, 4005, 4007, GF_CLOSE_BTN, 1); // Sim
        GFTextLine(gump, 110, 243, 68, "Comprar");
        
        GFAddButton(gump, 220, 240, 4017, 4019, GF_CLOSE_BTN, 2); // Não
        GFTextLine(gump, 250, 243, 38, "Cancelar");
    endif
    
    var input := GFSendGump(who, gump);
    
    if (!input)
        return -1; // Cancelou
    endif
    
    var button := input[0];
    
    if (button == 1) // Sim, quer comprar
        // Consumir as moedas (mesmo padrão do gestao_use)
        var moedas_restantes := BANNER_CUSTO;
        var moedas_items := array{};
        
        foreach moeda in EnumerateItemsInContainer(who.backpack)
            if (moeda.objtype == MOEDAS_COBRE)
                moedas_items.append(moeda);
            endif
            sleepms(2);
        endforeach
        
        foreach moeda in moedas_items
            if (moedas_restantes <= 0)
                break;
            endif
            
            if (moeda.amount >= moedas_restantes)
                SubtractAmount(moeda, moedas_restantes);
                moedas_restantes := 0;
            else
                moedas_restantes -= moeda.amount;
                DestroyItem(moeda);
            endif
            sleepms(2);
        endforeach
        
        SendSysMessage(who, "Compra realizada com sucesso! " + BANNER_CUSTO + " moedas de cobre foram debitadas.");
        return 1; // Prosseguir para seleção
        
    elseif (button == 2) // Não quer comprar
        return 0; // Pular estandarte
    endif
    
    return -1; // Cancelou por padrão
endfunction