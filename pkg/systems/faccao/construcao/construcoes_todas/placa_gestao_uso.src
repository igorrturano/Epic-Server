// :faccao:construcao/construcoes_todas/placa_gestao_uso.src
//
// SCRIPT UNIVERSAL PARA TODAS AS PLACAS DE GESTÃO
// Este é o ponto de entrada único que roteia para o controlador central
//
// Versão 1.0 - Agosto 2025

use uo;
use os;

include ":faccao:include/logging";
include ":faccao:construcao/include/placa_controller";

program PlacaGestaoUso(who, placa)
    var LOG_CATEGORY := "PlacaGestaoUso";
    LogCritical(LOG_CATEGORY, "=== SCRIPT UNIVERSAL DE PLACA INICIADO ===");
    LogCritical(LOG_CATEGORY, "Player: " + who.name + " (Serial: " + who.serial + ")");
    LogCritical(LOG_CATEGORY, "Placa: Serial " + placa.serial + ", ObjType: 0x" + Hex(placa.objtype));
    
    // Validação básica
    if (!who || !placa)
        LogCritical(LOG_CATEGORY, "ERRO CRÍTICO: Parâmetros inválidos");
        return 0;
    endif
    
    // Verificar se o jogador está próximo
    if (Distance(who, placa) > 2)
        LogCritical(LOG_CATEGORY, "Player muito distante da placa");
        SendSysMessage(who, "Você precisa estar mais próximo da placa de gestão.");
        return 0;
    endif
    
    LogCritical(LOG_CATEGORY, "Redirecionando para PLACA_ProcessUsage...");
    
    // REDIRECIONAR TUDO PARA O CONTROLADOR CENTRAL
    var result := PLACA_ProcessUsage(who, placa);
    
    LogCritical(LOG_CATEGORY, "PLACA_ProcessUsage retornou: " + result);
    LogCritical(LOG_CATEGORY, "=== SCRIPT UNIVERSAL CONCLUÍDO ===");
    
    return result;
endprogram
