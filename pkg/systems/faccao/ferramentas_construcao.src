use uo;
use os;

program ferramentas_construcao_use(who, item)
    if (!who)
        return 0;
    endif
    
    // Verificar se o item ainda existe e está na mochila
    if (!item || item.container != who.backpack)
        SendSysMessage(who, "As ferramentas de construção devem estar em sua mochila.");
        return 0;
    endif
    
    // Verificação básica: se pode usar, usa; se não pode, o próprio architect vai bloquear
    SendSysMessage(who, "Iniciando ferramentas de construção...");
    start_script(":architect:textcmd/admin/architect", who);
    
    return 1;
endprogram
