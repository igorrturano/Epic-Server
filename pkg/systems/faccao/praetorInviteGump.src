use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";

program praetorInviteGump(params)
	var praetor := params[1];
	var caster := params[2];

	if (!praetor || praetor == error || !praetor.connected || praetor.dead)
		return 0;
	endif
	if (!caster || caster == error)
		return 0;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 400, 190);
	GFResizePic(gump, 15, 15, 9350, 370, 160);
	GFTextMid(gump, 15, 25, 370, 53, "Alerta do Imperium");

	GFTextLine(gump, 30, 65, 1153, "Uso de magia dentro dos limites do");
	GFTextLine(gump, 30, 85, 1153, "Imperium, deseja se teleportar?");

	GFAddButton(gump, 70,  135, 4005, 4006, GF_CLOSE_BTN, 1);
	GFTextLine(gump, 110, 137, 1153, "Sim");
	GFAddButton(gump, 240, 135, 4017, 4018, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 280, 137, 1153, "Nao");

	var input := GFSendGump(praetor, gump);
	if (!input || input[0] != 1)
		return 0;
	endif

	if (!caster || caster == error)
		return 0;
	endif


	PlayStationaryEffect(praetor.x, praetor.y, praetor.z, 0xD11B, 0, 30, 0, praetor.realm);
	PlaySoundEffect(praetor, 0x1f2);

	PlayStationaryEffect(caster.x, caster.y, caster.z, 0xD11B, 0, 30, 0, caster.realm);
	PlaySoundEffect(caster, 0x1f2);
	sleep(2);

	var result := MoveObjectToLocation(praetor, caster.x, caster.y, caster.z,
	                                   caster.realm, MOVEOBJECT_FORCELOCATION);
	if (result.errortext)
		SendSysMessage(praetor, "Nao foi possivel se teleportar agora.");
		return 0;
	endif

	return 1;
endprogram
