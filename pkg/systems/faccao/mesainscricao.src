/*
 * Mesa de Inscrição da Facção - Versão Corrigida POL EScript
 */

use uo;
use os;
use guilds;
use polsys;

include ":gumps:gumps";
include "include/say";
include ":tn:tngumps";
include ":faccao:include/logging";
include ":faccao:include/permissions";

program mesainscricao_use(who, item)
    // === PROTEÇÃO ANTI-CRASH ===
    var lock_prop := "mesa_em_uso_" + who.serial;
    
    // Verificar se já está em uso
    if (GetObjProperty(item, lock_prop))
        SendSysMessage(who, "Aguarde, a mesa ainda esta processando sua solicitacao anterior.");
        return 0;
    endif
      // Marcar como em uso
    SetObjProperty(item, lock_prop, 1);
      // Verificar se o jogador está em uma facção (usando verificação padrão do POL)
    if (!who.guildid)
        SendSysMessage(who, "Voce precisa estar em uma faccao para usar esta mesa.");
        EraseObjProperty(item, lock_prop);
        return 0;
    endif
    
    // === VERIFICAÇÃO DE LIDERANÇA USANDO SISTEMA UNIFICADO ===
    if (!IsGuildLeader(who))
        SendSysMessage(who, "Apenas o lider da faccao pode usar esta mesa.");
        EraseObjProperty(item, lock_prop);
        return 0;
    endif

    // Abrir interface simplificada
    var result := OpenSimpleInviteGump(who, item);
    
    // === SEMPRE LIMPAR O LOCK NO FINAL ===
    EraseObjProperty(item, lock_prop);
    
    return result;
endprogram

function OpenSimpleInviteGump(who, item)
    // === FECHAR GUMPS ANTERIORES ===
    CloseGump(who, 0x12345, 0);
    
    var gump := GFCreateGump();
    GFSetId(gump, 0x12345);
    
    // Background
    GFResizePic(gump, 0, 0, 9200, 350, 200);
    GFResizePic(gump, 15, 15, 9350, 320, 170);
    
    // Título
    GFTextMid(gump, 15, 25, 320, 53, "Mesa de Inscrição da Facção");
    
    // Campo: Nome do Convidado
    GFTextLine(gump, 30, 60, 1153, "Nome do Convidado:");
    GFResizePic(gump, 30, 80, 9350, 200, 25);
    var nome_entry := GFTextEntry(gump, 35, 85, 190, 20, 1153, "", 1);
    
    // Campo: Cargo RP
    GFTextLine(gump, 30, 115, 1153, "Cargo RP:");
    GFResizePic(gump, 30, 135, 9350, 200, 25);
    var cargo_entry := GFTextEntry(gump, 35, 140, 190, 20, 1153, "", 2);
    
    // Botão Convidar
    GFAddButton(gump, 250, 80, 4005, 4006, GF_CLOSE_BTN, 1);
    GFTextLine(gump, 275, 82, 1153, "Convidar");
        
    // Botão Cancelar
    GFAddButton(gump, 250, 120, 4017, 4018, GF_CLOSE_BTN, 0);
    GFTextLine(gump, 275, 122, 1153, "Cancelar");
    
    // === ENVIAR GUMP ===
    var input := GFSendGump(who, gump);
    
    if (!input)
        SendSysMessage(who, "Erro ao processar gump.");
        return 0;
    endif
    
    if (input[0] == 1)
        var nome_convidado := GFExtractData(input, nome_entry);
        var cargo_rp := GFExtractData(input, cargo_entry);
        
        // Validação básica
        if (!nome_convidado || nome_convidado == "" || nome_convidado == " ")
            SendSysMessage(who, "Voce deve informar o nome do convidado.");
            sleep(1);
            return OpenSimpleInviteGump(who, item);
        endif
        
        if (!cargo_rp || cargo_rp == "" || cargo_rp == " ")
            SendSysMessage(who, "Voce deve informar o cargo RP.");
            sleep(1);
            return OpenSimpleInviteGump(who, item);
        endif
        
        return PrepararConvite(who, item, nome_convidado, cargo_rp);
    endif
    
    return 1;
endfunction

function PrepararConvite(who, item, nome, cargo)
    SendSysMessage(who, "Convite preparado para: " + nome + " como " + cargo);
    SendSysMessage(who, "Agora clique no jogador que deseja convidar.");
    
    // Salvar dados temporários no líder para usar no target
    SetObjProperty(who, "convite_nome", nome);
    SetObjProperty(who, "convite_cargo", cargo);
    SetObjProperty(who, "convite_time", ReadGameClock());
    
    // === TARGET COM PROTEÇÃO ===
    var targ := Target(who, TGTOPT_CHECK_LOS);
    
    if (targ)
        if (targ.isa(POLCLASS_MOBILE) && !targ.npctemplate && targ.connected)
            ConvidarJogador(who, targ, nome, cargo);
        else
            SendSysMessage(who, "Voce precisa clicar em um jogador online.");
        endif
    else
        SendSysMessage(who, "Targeting cancelado.");
    endif
    
    // === SEMPRE LIMPAR DADOS TEMPORÁRIOS ===
    EraseObjProperty(who, "convite_nome");
    EraseObjProperty(who, "convite_cargo");
    EraseObjProperty(who, "convite_time");
    
    return 1;
endfunction

function ConvidarJogador(lider, jogador, nome_personalizado, cargo_rp)
    // Verificações básicas
    if (!lider || !jogador)
        return 0;
    endif
    
    var guild := lider.guild;
    
    if (!guild)
        SendSysMessage(lider, "Erro: Voce nao esta em uma faccao.");
        return 0;
    endif
    
    if (jogador.guild)
        SendSysMessage(lider, jogador.name + " ja esta em uma faccao.");
        return 0;
    endif
    
    if (jogador == lider)
        SendSysMessage(lider, "Voce nao pode convidar a si mesmo.");
        return 0;
    endif
    
    var guild_name := guild.GetProp(FACTION_PROP_NAME);
    if (!guild_name) guild_name := guild.guildname; endif
    
    // Obter nome personalizado do líder
    var lider_display_name := lider.name; // Fallback padrão
    var lider_dados := GetObjProperty(lider, "dados_convite");
    if (lider_dados && lider_dados.nome_personalizado)
        lider_display_name := lider_dados.nome_personalizado;
    endif
    
    // Mostrar gump de confirmação para o jogador convidado
    var aceita := MostrarGumpConfirmacao(jogador, guild_name, nome_personalizado, cargo_rp, lider_display_name);
    
    if (aceita)
        // === USAR FUNÇÃO PADRÃO DE GUILDA ===
        var result := guild.AddMember(jogador);
        if (result)
            SendSysMessage(lider, "Jogador " + jogador.name + " aceitou o convite!");
            SendSysMessage(jogador, "Voce foi aceito na faccao " + guild_name + "!");
            
            // Salvar dados personalizados do convite
            var convite_data := struct{};
            convite_data.+nome_personalizado := nome_personalizado;
            convite_data.+cargo_rp := cargo_rp;
            convite_data.+data_convite := POLCore().systime;
            convite_data.+convidado_por := lider.name;
            
            SetObjProperty(jogador, "dados_convite", convite_data);
            
            SendSysMessage(lider, "Nome registrado: " + nome_personalizado);
            SendSysMessage(lider, "Cargo RP registrado: " + cargo_rp);
            
            return 1;
        else
            SendSysMessage(lider, "Erro ao adicionar jogador a faccao.");
            return 0;
        endif
    else
        SendSysMessage(lider, "Jogador " + jogador.name + " recusou o convite.");
        SendSysMessage(jogador, "Voce recusou o convite da faccao.");
    endif
    
    return 1;
endfunction

function MostrarGumpConfirmacao(jogador, guild_name, nome_personalizado, cargo_rp, lider_name)
    // === FECHAR GUMPS ANTERIORES ===
    CloseGump(jogador, 0x12346, 0);
    
    var gump := GFCreateGump();
    GFSetId(gump, 0x12346);
    
    // Background
    GFResizePic(gump, 0, 0, 9200, 400, 250);
    GFResizePic(gump, 15, 15, 9350, 370, 220);
    
    // Título
    GFTextMid(gump, 15, 25, 370, 53, "Convite para Facção");
    
    // Informações do convite
    var y := 60;
    GFTextLine(gump, 30, y, 1153, "Voce foi convidado para a faccao: " + guild_name);
    y += 25;
    GFTextLine(gump, 30, y, 1153, "Por: " + lider_name);
    y += 35;
    
    GFTextLine(gump, 30, y, 63, "Nome que voce tera: " + nome_personalizado);
    y += 25;
    GFTextLine(gump, 30, y, 63, "Cargo RP: " + cargo_rp);
    y += 40;
    
    GFTextLine(gump, 30, y, 1153, "Voce aceita este convite?");
    y += 30;
    
    // Botões
    GFAddButton(gump, 80, y, 4005, 4006, GF_CLOSE_BTN, 1);
    GFTextLine(gump, 120, y+2, 1153, "Aceitar");
    
    GFAddButton(gump, 220, y, 4017, 4018, GF_CLOSE_BTN, 0);
    GFTextLine(gump, 260, y+2, 1153, "Recusar");
    
    // === ENVIAR GUMP ===
    var input := GFSendGump(jogador, gump);
    
    if (!input)
        SendSysMessage(jogador, "Erro ao processar convite.");
        return 0;
    endif
    
    return (input[0] == 1);
endfunction