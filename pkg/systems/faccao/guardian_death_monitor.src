use uo;
use os;
use datafile;

include ":faccao:include/shared_functions";
include ":faccao:include/faccao_constants";

// Script que monitora a morte de um boss guardião
program guardian_death_monitor(npc)
    SysLog("TotemCreation: === GUARDIAN DEATH MONITOR INICIADO ===");
    SysLog("TotemCreation: Monitorando NPC: " + npc.serial + " - " + npc.name);
    
    // Verificar se é realmente um guardião
    var is_guardian := GetObjProperty(npc, "IsGuardian");
    if (!is_guardian)
        SysLog("TotemCreation: NPC não é guardião. Finalizando monitoramento.");
        return;
    endif
    
    var territory_name := GetObjProperty(npc, "TerritoryName");
    SysLog("TotemCreation: Guardião do território: " + territory_name);
    
    // SALVAR POSIÇÃO INICIAL (enquanto NPC ainda está vivo)
    var saved_x := npc.x;
    var saved_y := npc.y;
    var saved_z := npc.z;
    var saved_realm := npc.realm;
    
    SysLog("TotemCreation: Posição inicial salva: " + saved_x + "," + saved_y + "," + saved_z + " - " + saved_realm);
    
    // Loop de monitoramento - verificar se o NPC ainda existe
    while (npc && !npc.dead)
        // Atualizar posição continuamente (caso o NPC se mova)
        if (npc.x && npc.y && npc.z)
            saved_x := npc.x;
            saved_y := npc.y;
            saved_z := npc.z;
            saved_realm := npc.realm;
        endif
        sleep(1); // Verificar a cada segundo
    endwhile
    
    SysLog("TotemCreation: === BOSS MORREU! CRIANDO TOTEM ===");
    SysLog("TotemCreation: Boss que morreu: " + npc.serial + " - " + npc.name);
    
    // Usar coordenadas salvas (não tentar ler do NPC morto)
    SysLog("TotemCreation: Posição da morte (salva): " + saved_x + "," + saved_y + "," + saved_z + " - " + saved_realm);
    
    // Aguardar um pouco para garantir que o NPC foi processado
    sleep(2);
    
    // Chamar função de criação de totem com coordenadas salvas
    CreateTotemOnBossDeath(territory_name, saved_x, saved_y, saved_z, saved_realm);
endprogram

// Função para criar totem quando boss morre
function CreateTotemOnBossDeath(territory_name, x, y, z, realm)
    SysLog("TotemCreation: === INICIANDO CreateTotemOnBossDeath ===");
    SysLog("TotemCreation: Território: " + territory_name);
    SysLog("TotemCreation: Posição: " + x + "," + y + "," + z + " Realm: " + realm);
    
    if (!territory_name)
        SysLog("TotemCreation: ERRO - Territory name é NULL!");
        return;
    endif
    
    // Buscar o território no datafile
    var rect_df := SafeOpenDataFile(":architect:areas", 1);
    if (!rect_df)
        SysLog("TotemCreation: ERRO - Não foi possível abrir o datafile :architect:areas");
        return;
    endif
    
    SysLog("TotemCreation: Datafile aberto. Procurando elemento: " + territory_name);
    var elem := SafeFindElement(rect_df, territory_name);
    if (!elem)
        SysLog("TotemCreation: ERRO - Território '" + territory_name + "' NÃO encontrado no datafile!");
        return;
    endif
    
    SysLog("TotemCreation: Elemento encontrado! Criando totem...");
    
    // Criar totem no chão
    var totem := CreateItemAtLocation(x, y, z, 0xA102, 1, realm);
    if (!totem)
        SysLog("TotemCreation: ERRO CRÍTICO - CreateItemAtLocation falhou!");
        return;
    endif
    
    SysLog("TotemCreation: SUCESSO! Totem criado no chão. Serial: " + totem.serial);
    
    // Obter ID e Nome do elemento
    var territory_id := GetElementProp(elem, TERRITORY_ID_PROP);
    var territory_display_name := GetElementProp(elem, "Name", territory_name);

    SysLog("TotemCreation: Territory ID: " + territory_id);
    SysLog("TotemCreation: Territory Name: " + territory_display_name);

    if (!territory_id)
        SysLog("TotemCreation: AVISO - Territory ID é NULL! Usando território name como fallback.");
        territory_id := territory_name;
    endif
    
    // Configurar propriedades do totem
    SetObjProperty(totem, TERRITORY_ID_PROP, territory_id);
    SetObjProperty(totem, TERRITORY_NAME_PROP, territory_display_name);
    SetObjProperty(totem, TERRITORY_RECT_PROP, GetElementProp(elem, "Rect", ""));
    SetObjProperty(totem, TERRITORY_REALM_PROP, GetElementProp(elem, "Realm", ""));
    SetObjProperty(totem, "CreationDate", polcore().systime);
    SetObjProperty(totem, "FromBossDefeat", 1);
    
    SysLog("TotemCreation: Propriedades configuradas!");
    SysLog("TotemCreation: === TOTEM CRIADO AUTOMATICAMENTE COM SUCESSO! ===");
endfunction
