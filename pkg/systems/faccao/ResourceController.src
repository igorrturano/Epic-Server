use uo;
    use os;
    use datafile;
    use util;
    use guilds;
    use file;
    use math;

    include "include/say";
    include ":faccao:include/shared_functions";
    include ":architect:include/systemclock";
    include ":faccao:include/logging";
    include ":faccao:include/datafile_helpers";
    include ":faccao:include/process_registry";
include ":faccao:include/faccao_constants";
   include ":faccao:include/territory_management"; // Para TM_FindTerritory, TM_GetTerritoryInfo etc.
include "include/client"; // Para SendSysMessageEx
include ":attributes:attributes"; // Se usado por algum include indireto

    // Lista para rastrear o próximo território a ser verificado
    var next_territory_checks := dictionary{};


function RegisterProcessFast()
    var registration_result := RegisterProcess("ResourceController");
    if (registration_result == 1)
        LogInfo("ResourceController", "Processo registrado com sucesso no sistema de registro");
        UpdateProcessHeartbeat("ResourceController");
        LogInfo("ResourceController", "Heartbeat inicial enviado");
        return 1;
    elseif (registration_result == 0)
        LogError("ResourceController", "FALHA no registro: Outra instância do ResourceController já está ativa e registrada.");
        return 0;
    else
        LogError("ResourceController", "FALHA CRÍTICA no registro do processo (erro de datafile): " + registration_result.errortext);
        return error;
    endif
endfunction

program ResourceController()
    LogInfo("ResourceController", "=== INICIANDO RESOURCECONTROLLER (PID: " + GetPid() + ") ===");

    // ========================================================
    // >>>>> INÍCIO DA MUDANÇA <<<<<
    // ========================================================
    // REMOVIDO: ForcedSystemCleanup(); 
    // O sistema de registro com heartbeat já lida com processos zumbis.
    // Esta chamada estava causando uma condição de corrida com o start.src.

    // Tenta se registrar. Se falhar, encerra.
    if (!RegisterProcessFast())
        return 0;
    endif
    // ========================================================
    // >>>>> FIM DA MUDANÇA <<<<<
    // ========================================================

    // O código abaixo permanece o mesmo
    var controller_pid := GetPid();
    var pid_result := SetGlobalProperty("ResourceControllerPID", controller_pid);
    if (pid_result == error)
        LogError("ResourceController_DEBUG", "FALHA ao salvar PID (" + controller_pid + ") como GlobalProperty: " + pid_result.errortext);
    else
        LogInfo("ResourceController_DEBUG", "PID " + controller_pid + " salvo com sucesso como GlobalProperty (mecanismo secundário)");
    endif

    var active_processes := GetGlobalProperty("ActiveProcesses");
    if (!active_processes || active_processes == error)
        active_processes := array{};
    endif
    if (!(controller_pid in active_processes))
        active_processes.append(controller_pid);
        SetGlobalProperty("ActiveProcesses", active_processes);
    endif

    LogInfo("recursos", "Iniciando Controlador de Recursos de Territórios...");
    LoadAllTerritories();
    LogInfo("ResourceController", "Territórios carregados: " + next_territory_checks.size());

    // Constantes do loop principal
    const CHECK_INTERVAL := 30;
    const RELOAD_INTERVAL := 300;
    
    var last_reload_time := polcore().systime;

    while (1)
        var loop_start_time := polcore().systime;
        UpdateProcessHeartbeat("ResourceController");

        // 1. Processar eventos pendentes primeiro
        ProcessPendingEvents();

        // 2. Recarregar lista de territórios periodicamente
        if (loop_start_time - last_reload_time > RELOAD_INTERVAL)
            LogInfo("ResourceController_Loop", "Recarregando lista completa de territórios...");
            LoadAllTerritories();
            last_reload_time := loop_start_time;
        endif

        // 3. Otimização
        if (next_territory_checks.size() == 0)
            LogDebug("ResourceController_Loop", "Nenhum território agendado. Aguardando " + CHECK_INTERVAL + "s.");
            Sleep(CHECK_INTERVAL);
            continue;
        endif
        
        // 4. Obter territórios devidos
        var territories_to_process := GetTerritoriesDueForCheck(loop_start_time);
        
        if (territories_to_process.size() > 0)
            LogInfo("ResourceController_Loop", territories_to_process.size() + " territórios prontos para gerar recursos.");
            
            // 5. Processar cada território
            foreach territory_id in territories_to_process
                ProcessTerritory(territory_id, loop_start_time);
                SleepMS(150);
            endforeach
        endif

        // 6. Calcular tempo de espera
        var wait_time := GetTimeForNextDue(loop_start_time, CHECK_INTERVAL);
        
        LogDebug("ResourceController_Loop", "Próxima verificação em " + wait_time + " segundos. Indo para Sleep.");
        Sleep(wait_time);
    endwhile
endprogram

// Adicionada função para calcular o tempo de espera de forma mais inteligente
function GetTimeForNextDue(current_time, default_wait)
    var next_due_time := current_time + default_wait * 10; // Um valor alto inicial
    var found_due := 0;

    if (next_territory_checks.size() == 0)
        return default_wait; // Se não há territórios, espera o padrão
    endif

    foreach territory_id_key in (next_territory_checks.keys())
        var check_time_val := CInt(next_territory_checks[territory_id_key]);
        if (check_time_val > current_time) // Apenas considerar agendamentos futuros
            if (check_time_val < next_due_time)
                next_due_time := check_time_val;
                found_due := 1;
            endif
        endif
    endforeach

    if (found_due)
        var time_to_wait := next_due_time - current_time;
        return (time_to_wait > 0 ? time_to_wait : 1); // Espera pelo menos 1 segundo
    else
        return default_wait; // Se todos já passaram ou não há futuros, espera o padrão
    endif
endfunction

function ProcessPendingEvents()
    var df := SafeOpenDataFile(":faccao:messages");
    if(!df) return; endif

    var elem := SafeFindElement(df, "controller_events");
    if(!elem) return; endif

    var events := GetElementProp(elem, "pending");
    if (!events || TypeOf(events) != "Array" || events.size() == 0) return; endif

    LogInfo("ResourceController_Event", "Processando " + events.size() + " eventos pendentes...");
    var processed_events_count := 0;
    var remaining_events_list := array{};

    foreach ev_data in events
        var event_handled_successfully := 0;
        if (TypeOf(ev_data) == "Struct" && ev_data.territory_id && ev_data.type)
            LogInfo("ResourceController_EventDetail", "Processando evento: Tipo='" + ev_data.type + "', TerritórioID='" + ev_data.territory_id + "'");
            case (ev_data.type)
                "created":
                "transfer":
                "claimed":
                "resources_updated":
                "rollback":
                    UpdateTerritorySchedule(ev_data.territory_id);
                    event_handled_successfully := 1;
                "deleted":
                "revoked":
                    if (next_territory_checks.exists(ev_data.territory_id))
                        next_territory_checks.erase(ev_data.territory_id);
                        LogInfo("ResourceController_EventDetail", "Território " + ev_data.territory_id + " removido do agendamento (evento " + ev_data.type + ").");
                    endif
                    event_handled_successfully := 1;
                "reload_territories":
                    LogInfo("ResourceController_EventDetail", "Evento de reload recebido. Recarregando territórios...");
                    LoadAllTerritories();
                    event_handled_successfully := 1;
                
                // =======================================================
                // >> INÍCIO DA CORREÇÃO <<
                // =======================================================
                "caravan_activated_from_territory":
                    if (ev_data.data && ev_data.data.faction && ev_data.data.capital_territory_id && ev_data.data.active_until_next_payment)
                        LogInfo("ResourceController_Caravana", "Evento CARAVANA ATIVADA para Facção: " + ev_data.data.faction);
                        var caravan_info_global := GetGlobalProperty("active_caravans");
                        if (!caravan_info_global || caravan_info_global == error)
                            caravan_info_global := dictionary{};
                        endif
                        
                        // Armazena a informação da caravana indexada pela facção
                        caravan_info_global[ev_data.data.faction] := struct{
                            "capital_id"   := CStr(ev_data.data.capital_territory_id),
                            "active_until" := CInt(ev_data.data.active_until_next_payment)
                        };
                        
                        SetGlobalProperty("active_caravans", caravan_info_global);
                        LogInfo("ResourceController_Caravana", "GlobalProperty 'active_caravans' atualizada para facção " + ev_data.data.faction);
                    else
                        LogWarning("ResourceController_Caravana", "Evento caravan_activated_from_territory recebido com dados insuficientes: " + ev_data);
                    endif
                    event_handled_successfully := 1;

                "caravan_deactivated_from_territory":
                    if (ev_data.data && ev_data.data.faction)
                        LogInfo("ResourceController_Caravana", "Evento CARAVANA DESATIVADA para Facção: " + ev_data.data.faction);
                        var caravan_info_global := GetGlobalProperty("active_caravans");
                        if (caravan_info_global && caravan_info_global.exists(ev_data.data.faction))
                            caravan_info_global.erase(ev_data.data.faction);
                            SetGlobalProperty("active_caravans", caravan_info_global);
                            LogInfo("ResourceController_Caravana", "GlobalProperty 'active_caravans' limpa para facção " + ev_data.data.faction);
                        endif
                    else
                        LogWarning("ResourceController_Caravana", "Evento caravan_deactivated_from_territory recebido com dados insuficientes: " + ev_data);
                    endif
                    event_handled_successfully := 1;

                // =======================================================
                // >> FIM DA CORREÇÃO <<
                // =======================================================

                default:
                    LogWarning("ResourceController_EventDetail", "Tipo de evento DESCONHECIDO no datafile: '" + ev_data.type + "' para território '" + ev_data.territory_id + "'. Evento será DESCARTADO.");
                    event_handled_successfully := 1; 
            endcase

            if (event_handled_successfully)
                processed_events_count += 1;
            else
                remaining_events_list.append(ev_data);
            endif
        else
            LogWarning("ResourceController_Event", "Evento inválido (não é struct ou faltam props) encontrado no datafile: " + ev_data + ". Descartando.");
            processed_events_count += 1;
        endif
        SleepMS(5);
    endforeach

    SetElementProp(elem, "pending", remaining_events_list);
    LogInfo("ResourceController_Event", "Processamento de eventos concluído. Total: " + events.size() + ". Processados/Descartados: " + processed_events_count + ". Restantes: " + remaining_events_list.size());
endfunction

function UpdateTerritorySchedule(territory_id_to_update)
    LogInfo("ResourceController_Schedule", "Tentando atualizar agenda para ID: " + territory_id_to_update);
    
    var elem := TM_FindTerritory(territory_id_to_update); 
      if (elem)
        var friendly_name_for_log := GetElementProp(elem, "Name", territory_id_to_update); 
        var faction := GetTerritoryFaction(elem);
        
        var next_time_from_prop := GetElementProp(elem, "NextResourceTime");
        
        if (faction && faction != DEFAULT_FACTION)
            var schedule_time_val := 0;
            if (next_time_from_prop)
                schedule_time_val := CInt(next_time_from_prop);
            endif // Adicionado endif faltante

            if (schedule_time_val) 
                LogInfo("ResourceController_Schedule", "Adicionando/Atualizando ID '" + territory_id_to_update + "' ('" + friendly_name_for_log + "') na agenda. Próximo Check: " + schedule_time_val);
                next_territory_checks[territory_id_to_update] := schedule_time_val;
            else
                var interval_minutes := GetValidatedResourceInterval(elem);
                var calculated_next_time := polcore().systime + (interval_minutes * 60);
                SetElementProp(elem, "NextResourceTime", calculated_next_time); 
                next_territory_checks[territory_id_to_update] := calculated_next_time;
                LogInfo("ResourceController_Schedule", "Configurando agendamento inicial para ID '" + territory_id_to_update + "' ('" + friendly_name_for_log + "') para " + calculated_next_time + " (em " + interval_minutes + " min).");
            endif // Fechando o if (schedule_time_val)
            return 1; 
        else 
            if (next_territory_checks.exists(territory_id_to_update))
                LogInfo("ResourceController_Schedule", "Removendo ID '" + territory_id_to_update + "' ('" + friendly_name_for_log + "') da agenda (Facção: " + (faction ? faction : "N/A") + " - não ativa para recursos).");
                next_territory_checks.erase(territory_id_to_update);
            endif // Adicionado endif faltante
            return 0; 
        endif // Fechando o if (faction && ...)
    else 
        if (next_territory_checks.exists(territory_id_to_update))
            LogWarning("ResourceController_Schedule", "Território ID '" + territory_id_to_update + "' não encontrado via TM_FindTerritory. Removendo da agenda.");
            next_territory_checks.erase(territory_id_to_update);
        endif // Adicionado endif faltante
        return 0; 
    endif // Fechando o if (elem)
endfunction





    // Função GetTerritoriesDueForCheck modificada - Adicionar log mais detalhado
    function GetTerritoriesDueForCheck(current_time)
        var due_territories := array{};
        var window_size := 60; // 1 minuto de janela
        
        // Log DEBUG
        LogDebug("ResourceController_DEBUG", "Verificando territórios com next_territory_checks.size() = " + next_territory_checks.size());
        
        foreach territory_name in (next_territory_checks.keys())
            var check_time := next_territory_checks[territory_name];
            
            // Log detalhado para cada verificação
            LogDebug("ResourceController_DEBUG", "Território: " + territory_name + ", CheckTime: " + check_time + ", CurrentTime: " + current_time);
            
            // Se está no intervalo de verificação
            if (check_time <= current_time + window_size)
                LogDebug("ResourceController_DEBUG", "Adicionando território: " + territory_name + " à lista de verificação");
                due_territories.append(territory_name);
            endif
            
            sleepms(2);
        endforeach
        
        LogDebug("ResourceController_DEBUG", "GetTerritoriesDueForCheck: Encontrados " + due_territories.size() + " territórios para verificar");
        return due_territories;
    endfunction

    // Início da função ProcessTerritory modificada - Adicionar mais logs
function ProcessTerritory(territory_id_param, current_time) 
    LogDebug("ProcessTerritory_DEBUG", "-- Iniciando ProcessTerritory para ID: " + territory_id_param + " (CurrentTime: " + current_time + ") --");
    
    if (!territory_id_param)
        LogError("ProcessTerritory_DEBUG", "territory_id_param é nulo ou inválido");
        return 0;
    endif
    
    if (TypeOf(territory_id_param) != "String")
        LogError("ProcessTerritory_DEBUG", "territory_id_param não é String, é " + TypeOf(territory_id_param));
        return 0;
    endif

    var elem := TM_FindTerritory(territory_id_param); 
    
    if (!elem)
        LogWarning("ProcessTerritory_DEBUG", "Elemento para ID '" + territory_id_param + "' não encontrado via TM_FindTerritory. Removendo da agenda.");
        if (next_territory_checks.exists(territory_id_param))
            next_territory_checks.Erase(territory_id_param);
        endif
        return 1; 
    endif

    var territory_name_for_log := GetElementProp(elem, "Name", territory_id_param);

    var next_time_prop := GetElementProp(elem, "NextResourceTime");
    var next_time_val := 0;
    if (next_time_prop)
        next_time_val := CInt(next_time_prop);
    endif

    if (next_time_val > current_time)
        LogDebug("ProcessTerritory_DEBUG", "Território '" + territory_name_for_log + "' (ID: "+territory_id_param+") ainda não está na hora (Next: " + next_time_val + ", Current: " + current_time + "). Reagendando para " + next_time_val + " se necessário.");
        if (!next_territory_checks.exists(territory_id_param) || next_territory_checks[territory_id_param] != next_time_val)
             next_territory_checks[territory_id_param] := next_time_val; 
        endif
        return 1;    endif

    var faction := GetTerritoryFaction(elem);
    
    var resource_amount := CInt(GetElementProp(elem, "ResourceAmount"));
    var resources_string := GetElementProp(elem, "Resources");
    var resources_array := ProcessResourceString(resources_string);
    
    var validade := VerificarValidadeDosDados(elem, faction, resources_array, resource_amount);
    if (!validade.valido)
        LogError("ProcessTerritory_DEBUG", "Dados inválidos para '" + territory_name_for_log + "' (ID: " + territory_id_param + "): " + validade.mensagem + ". Reagendando com penalidade.");
        RescheduleTerritoryWithPenalty(territory_id_param, elem, current_time);
        RegistrarFalhaDeCriacao(elem, faction, territory_name_for_log, resources_string);
        return 0; 
    endif
    
    LogInfo("recursos", "Gerando recursos para território: '" + territory_name_for_log + "' (ID: " + territory_id_param + ")");
    var success_count := GenerateResourcesForTerritory(elem, faction, resource_amount); 
    
    var validated_interval := GetValidatedResourceInterval(elem);
    var next_generation_schedule := current_time + (validated_interval * 60);
    
    SetElementProp(elem, "NextResourceTime", next_generation_schedule);
    next_territory_checks[territory_id_param] := next_generation_schedule; 
    LogDebug("ProcessTerritory_DEBUG", "Próxima geração para '" + territory_name_for_log + "' (ID: " + territory_id_param + ") agendada para " + next_generation_schedule + " (em " + (validated_interval * 60) + "s).");

    // Bloco if (success_count > 0) foi movido para dentro de GenerateResourcesForTerritory
    // para garantir que NotifyFactionLeadersOfResourceGeneration só seja chamado se a geração ocorreu.
    // Aqui, a responsabilidade de ProcessTerritory é chamar a geração e reagendar.

    return success_count; 
endfunction


// Adicionar função RescheduleTerritoryWithPenalty
function RescheduleTerritoryWithPenalty(territory_id, byref elem, current_time, penalty_minutes := 5)
    var new_time := current_time + (penalty_minutes * 60);
    next_territory_checks[territory_id] := new_time;
    
    if (elem) // elem pode ser nulo se TM_FindTerritory falhou antes
        SetElementProp(elem, "NextResourceTime", new_time);
        LogWarning("ProcessTerritory_DEBUG", "Território ID '" + territory_id + "' reagendado com penalidade para " + new_time + " (em " + (penalty_minutes * 60) + "s).");
    else
        LogWarning("ProcessTerritory_DEBUG", "Território ID '" + territory_id + "' reagendado com penalidade (elemento não fornecido para atualização do datafile).");
    endif
endfunction

function VerificarValidadeDosDados(elem, faction, resources, resource_amount)
    LogDebug("ProcessTerritory_DEBUG", "Iniciando VerificarValidadeDosDados...");
    
    var validade := struct{
        "valido" := 1,
        "mensagem" := ""
    };
    
    if (!elem)
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Elemento inválido");
        validade.valido := 0;
        validade.mensagem := "Elemento inválido";
        return validade;
    endif
    
    if (!faction)
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Facção não encontrada");
        validade.valido := 0;
        validade.mensagem := "Facção não encontrada";
        return validade;
    endif
    
    if (faction == DEFAULT_FACTION)
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Território default (" + faction + ")");
        validade.valido := 0;
        validade.mensagem := "Facção inválida ou território default: " + faction;
        return validade;
    endif
    
    if (!resources)
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Array de recursos é NULL");
        validade.valido := 0;
        validade.mensagem := "Nenhum recurso configurado";
        return validade;
    endif
    
    if (TypeOf(resources) != "Array")
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Resources não é um Array (Tipo: " + TypeOf(resources) + ")");
        validade.valido := 0;
        validade.mensagem := "Formato de recursos inválido";
        return validade;
    endif
    
    if (!resources.size())
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Array de recursos está vazio");
        validade.valido := 0;
        validade.mensagem := "Nenhum recurso válido configurado";
        return validade;
    endif
    
    if (resource_amount <= 0)
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Quantidade de recursos inválida (" + resource_amount + ")");
        validade.valido := 0;
        validade.mensagem := "Quantidade de recursos inválida: " + resource_amount;
        return validade;
    endif
    
    // Verificação adicional: verificar se cada recurso na lista é mapeável
    var recursos_invalidos := array{};
    foreach resource_name_to_check in resources // Renomeado 'resource' para evitar conflito com possível nome de função
        // A CHAMADA DIRETA PARA MapearRecurso É O CORRETO AQUI.
        // O POL irá procurar a função MapearRecurso nos arquivos incluídos.
        // Se shared_functions.inc está corretamente incluído no topo do
        // ResourceController.src (direta ou indiretamente), e contém
        // a definição de MapearRecurso, ela será usada.
        var objtype := MapearRecurso(resource_name_to_check); 
        
        if (!objtype) // Se MapearRecurso retornar 0 (ou seja, não encontrou o recurso)
            recursos_invalidos.append(resource_name_to_check);
        endif
        sleepms(1); // Mantido se você acha necessário para evitar picos de CPU
    endforeach
    
    if (recursos_invalidos.size() > 0)
        var msg_recursos := "";
        foreach r_invalid in recursos_invalidos // Renomeado 'r'
            if (msg_recursos != "") 
                msg_recursos += ", ";
            endif
            msg_recursos += r_invalid;
            sleepms(1); // Mantido
        endforeach
        
        // Este LogError é importante, pois indicará quais recursos nominais
        // não foram encontrados pela função MapearRecurso.
        LogError("ProcessTerritory_DEBUG", "Validação FALHOU: Recursos não mapeáveis encontrados em VerificarValidadeDosDados: " + msg_recursos);
        validade.valido := 0;
        validade.mensagem := "Recursos não reconhecidos: " + msg_recursos;
        return validade;
    endif
    
    LogDebug("ProcessTerritory_DEBUG", "Validação SUCESSO: Todos os dados são válidos");
    return validade;
endfunction

    // Função de tentativa de criação de baú de emergência
    function TentarCriarBauEmergencia(faction_name, territory_name)
        LogWarning("recursos", "Tentando criar baú de emergência para " + faction_name + " (Território: " + territory_name + ")");

        
        var emergency_chest := CreateEmergencyDonationChest(faction_name);
        if (emergency_chest)
            // Registrar associação com o território
            SetObjProperty(emergency_chest, "territory_id", territory_name);
            SetObjProperty(emergency_chest, "emergency_for_territory", territory_name);
            
            // Notificar administradores
            foreach player in EnumerateOnlineCharacters()
                if (player.cmdlevel >= 3)
                    SendSysMessageEx(player, "SISTEMA: Baú de emergência criado para facção " + faction_name + 
                                    " devido a falhas de geração em " + territory_name, SSM_INFO);
                endif
            endforeach
            
            return 1;
        endif
        
        return 0;
    endfunction

    function RescheduleTerritory(territory_name, new_time)
        next_territory_checks[territory_name] := new_time;
        
        var rect_df := SafeOpenDataFile(":architect:areas");
        if (rect_df)
            var elem := SafeFindElement(rect_df, territory_name);
            if (elem)
                SetElementProp(elem, "NextResourceTime", new_time);
            endif
        endif
    endfunction

// FUNÇÃO GenerateResourcesForTerritory (REIMPRESSA E ATUALIZADA)
function GenerateResourcesForTerritory(elem, faction_name_param, resource_amount)
    var log_entries := array{};
    var current_time := polcore().systime;
    var faction_name := faction_name_param; // Usar uma variável local

    if (!elem || !faction_name || resource_amount <= 0)
        LogError("recursos_gen", "Parâmetros inválidos para GenerateResourcesForTerritory.");
        return 0;
    endif

    // CORREÇÃO: Declarar as variáveis do território ANTES de usá-las.
    var territory_name_from_elem := GetElementProp(elem, "Name", "Desconhecido_" + elem.name);
    var territory_id_from_elem := GetElementProp(elem, TERRITORY_ID_PROP, elem.name); 

    LogDebug("recursos_gen", "Iniciando geração para Território: '" + territory_name_from_elem + "' (ID: " + territory_id_from_elem + ")");
    LogDebug("recursos_gen", "Facção Param: '" + faction_name + "', Quantidade: " + resource_amount);

    var donation_chest := 0; 
    var faction_on_elem := GetTerritoryFaction(elem);
    if (!faction_on_elem)
        LogError("recursos_gen", "Informação de facção inválida para o território '" + territory_name_from_elem + "'.");
        return 0;
    endif
    if (faction_on_elem == DEFAULT_FACTION)
        LogDebug("recursos_gen", "Território '" + territory_name_from_elem + "' é default. Pulando geração.");
        return 0;
    endif
    if (faction_name != faction_on_elem)
        LogWarning("recursos_gen", "Facção passada ('" + faction_name + "') não corresponde à facção do território ('" + faction_on_elem + "') para '" + territory_name_from_elem + "'. Usando facção do elemento: '" + faction_on_elem + "'.");
        faction_name := faction_on_elem; // CORRIGE faction_name para o que está no elemento do território
    endif
    LogDebug("recursos_gen", "Facção confirmada para geração: '" + faction_name + "'");

    var resources_string_from_elem := GetElementProp(elem, "Resources");
    if (!resources_string_from_elem)
        LogError("recursos_gen", "Nenhum recurso configurado para o território '" + territory_name_from_elem + "'.");
        return 0;
    endif
    LogDebug("recursos_gen", "String de recursos: '" + resources_string_from_elem + "'");

    var resources_array_parsed := ProcessResourceString(resources_string_from_elem);
    if (!resources_array_parsed || resources_array_parsed.size() < 1)
        LogError("recursos_gen", "Nenhum recurso válido encontrado após processamento para '" + territory_name_from_elem + "'.");
        return 0;
    endif
    LogDebug("recursos_gen", resources_array_parsed.size() + " tipos de recursos válidos identificados para '" + territory_name_from_elem + "'.");

    var target_chest_for_delivery := 0;
    var caravan_redirected_flag := 0;
    var active_caravans_global_prop := GetGlobalProperty("active_caravans");

    if (active_caravans_global_prop && active_caravans_global_prop.exists(faction_name))
        var caravan_details_for_faction := active_caravans_global_prop[faction_name];
        if (caravan_details_for_faction.capital_id && caravan_details_for_faction.active_until && CInt(caravan_details_for_faction.active_until) > current_time)
            if (CStr(territory_id_from_elem) != CStr(caravan_details_for_faction.capital_id)) // Não redirecionar se já é a capital
                LogInfo("recursos_caravana", "CARAVANA ATIVA para facção '" + faction_name + "'. Redirecionando recursos de '" + territory_name_from_elem + "' (ID: " + territory_id_from_elem + ") para capital ID: '" + caravan_details_for_faction.capital_id + "'.");
                target_chest_for_delivery := FindFactionChest(faction_name, caravan_details_for_faction.capital_id); // Busca baú da CAPITAL
                if (target_chest_for_delivery)
                    LogInfo("recursos_caravana", "Baú da CAPITAL (ID: " + caravan_details_for_faction.capital_id + ") encontrado: " + target_chest_for_delivery.serial + ". Recursos serão entregues lá.");
                    caravan_redirected_flag := 1;
                else
                    LogError("recursos_caravana", "FALHA ao encontrar baú da CAPITAL (ID: " + caravan_details_for_faction.capital_id + ") para facção '" + faction_name + "'. Recursos para '" + territory_name_from_elem + "' serão gerados localmente (fallback).");
                endif
            else
                 LogInfo("recursos_caravana", "Território '" + territory_name_from_elem + "' (ID: " + territory_id_from_elem + ") é a CAPITAL com caravana ativa. Recursos gerados localmente na capital.");
            endif
        else
            LogInfo("recursos_caravana", "Caravana registrada para facção '" + faction_name + "', mas contrato expirou (expira em: " + caravan_details_for_faction.active_until + ", agora: " + current_time + "). Recursos para '" + territory_name_from_elem + "' gerados localmente.");
        endif
    endif

    if (!caravan_redirected_flag || !target_chest_for_delivery)
        donation_chest := FindFactionChest(faction_name, territory_id_from_elem); // Baú LOCAL
        if (donation_chest)
             LogInfo("recursos_gen", "Usando baú LOCAL '" + donation_chest.serial + "' para território '" + territory_name_from_elem + "' (ID: " + territory_id_from_elem + ").");
        endif
    else
        donation_chest := target_chest_for_delivery; // Baú da CAPITAL
        LogInfo("recursos_gen", "Usando baú da CAPITAL '" + donation_chest.serial + "' (Capital ID: " + active_caravans_global_prop[faction_name].capital_id + ") para recursos do território '" + territory_name_from_elem + "' (ID: " + territory_id_from_elem + ").");
    endif

    if (!donation_chest)
        LogError("recursos_gen", "Baú de doações (local ou capital) não encontrado ou inacessível para facção: '" + faction_name + "', território: '" + territory_name_from_elem + "'. Geração abortada.");
        // Opcional: Tentar criar baú de emergência aqui, mas pode ser complexo se for para a capital.
        return 0;
    endif

    // ====================================================================
    //              INÍCIO DA IMPLEMENTAÇÃO DO LOCK
    // ====================================================================
    var lock_prop := "operation_lock";
    var lock_timeout := 30; // 30 segundos
    var current_time_lock := polcore().systime;

    // 1. VERIFICAR LOCK
    var existing_lock := GetObjProperty(donation_chest, lock_prop);
    if (existing_lock)
        if (current_time_lock - CInt(existing_lock.timestamp) < lock_timeout)
            LogWarning("recursos_gen", "Baú " + donation_chest.serial + " está bloqueado por outra operação ("+existing_lock.operation+"). Geração de recursos para '" + territory_name_from_elem + "' adiada.");
            return 0; // Adia a geração para o próximo ciclo
        else
            LogWarning("recursos_gen", "Lock expirado encontrado no baú. Limpando e prosseguindo...");
            EraseObjProperty(donation_chest, lock_prop);
        endif
    endif

    // 2. ADQUIRIR LOCK
    var lock_data := struct{
        "operation" := "resource_generation", 
        "pid"       := GetPid(),
        "timestamp" := current_time_lock
    };
    SetObjProperty(donation_chest, lock_prop, lock_data);
    LogDebug("recursos_gen", "Lock adquirido no baú " + donation_chest.serial + " para geração de recursos.");
    // ====================================================================



    if (!IsValidContainer(donation_chest))
        LogError("recursos_gen", "Baú de doações (Serial: " + donation_chest.serial + ") encontrado, mas não é válido ou está inacessível. Geração abortada.");
        EraseObjProperty(donation_chest, lock_prop); // <-- ADICIONAR LIBERAÇÃO AQUI
        return 0;
    endif
    if (!HasContainerSpace(donation_chest, resources_array_parsed.size()))
        LogWarning("recursos_gen", "Baú de doações (Serial: " + donation_chest.serial + ") pode estar cheio. Alguns recursos podem não ser adicionados para '" + territory_name_from_elem + "'.");
    endif

    LogDebug("recursos_gen", "Iniciando loop de criação de " + resources_array_parsed.size() + " tipos de recurso(s) no baú " + donation_chest.serial);
    var items_created_successfully_count := 0;

    foreach resource_name_loop in resources_array_parsed
        var objtype_to_create := MapearRecurso(resource_name_loop);
        if (!objtype_to_create)
            LogError("recursos_gen", "Tipo de objeto não encontrado para recurso: '" + resource_name_loop + "' em território '" + territory_name_from_elem + "'. Pulando este recurso.");
            log_entries.append("Falha ao mapear recurso: " + resource_name_loop);
            continue;
        endif
        LogDebug("recursos_gen", "  Mapeado Recurso: '" + resource_name_loop + "' -> ObjType: 0x" + Hex(CInt(objtype_to_create)));

        var category_for_cprop := ClassificarRecurso(objtype_to_create);
        LogDebug("recursos_gen", "  Categoria para CProp: '" + category_for_cprop + "'");

        var item_properties := dictionary{};
        if (category_for_cprop != "desconhecido" && category_for_cprop)
            item_properties["IsKingdomDonation" + category_for_cprop] := 1;
        endif
        item_properties["GeneratedForTerritory"] := territory_name_from_elem;
        item_properties["GeneratedTime"] := current_time; // Timestamp do início desta geração
        item_properties["GeneratedByFaction"] := faction_name;
        item_properties["CreatedByResourceController"] := 1; // MUITO IMPORTANTE para onInsert.src
        item_properties[OBJ_FACTION_PROP] := faction_name; // Redundante mas pode ser útil
        item_properties["territory_id"] := territory_id_from_elem; // ID do território de ORIGEM

        LogDebug("recursos_gen", "  Propriedades para criação: " + item_properties.keys());
        var created_item_ref := SafeCreateItemInContainer_Refactored(donation_chest, objtype_to_create, resource_amount, item_properties);

        if (created_item_ref && created_item_ref != error)
            items_created_successfully_count += 1;
            log_entries.append("Recurso criado: " + resource_name_loop + " x" + resource_amount + " (Serial: " + created_item_ref.serial + ")");
            LogInfo("recursos_gen", "  SUCESSO: Criado/Empilhado " + resource_name_loop + " (Serial: " + created_item_ref.serial + ", Amount: " + created_item_ref.amount + ")");
        else
            log_entries.append("Falha (SafeCreate) ao criar recurso: " + resource_name_loop);
            LogError("recursos_gen", "  FALHA (SafeCreate) ao criar/empilhar " + resource_name_loop + " em '" + territory_name_from_elem + "'. Resultado: " + created_item_ref);
            // Tentar fallback pode ser perigoso aqui se SafeCreate já tentou e falhou.
        endif
        SleepMS(10);
    endforeach; // Fim do loop foreach resource_name_loop

    LogDebug("recursos_gen", "Final da geração. Itens criados com sucesso: " + items_created_successfully_count + "/" + resources_array_parsed.size());

    if (items_created_successfully_count > 0 && donation_chest)
        SetElementProp(elem, "LastGeneration", current_time);
        // O reagendamento (NextResourceTime e next_territory_checks) é feito em ProcessTerritory

        // IMPORTANTE: Chamar UpdateResourceCache para o baú ONDE OS ITENS FORAM ENTREGUES
        UpdateResourceCache(donation_chest);
        LogInfo("recursos_gen", "Cache de recursos agendado para atualização para o baú: " + donation_chest.serial);

        var history_array := GetElementProp(elem, "ResourceHistory", array{});
        history_array.append(struct{
            "time" := current_time,
            "resources" := resources_array_parsed,
            "amount" := resource_amount,
            "success" := items_created_successfully_count,
            "details" := log_entries,
            "chest_serial" := (donation_chest ? donation_chest.serial : 0),
            "chest_name" := (donation_chest ? donation_chest.name : "N/A"),
            "delivered_to_capital" := caravan_redirected_flag
        });
        while (history_array.size() > 10) history_array.erase(1); endwhile;
        SetElementProp(elem, "ResourceHistory", history_array);

        NotifyFactionLeadersOfResourceGeneration(faction_name, territory_name_from_elem, resources_array_parsed, resource_amount, items_created_successfully_count, caravan_redirected_flag, (donation_chest ? donation_chest.name : ""));
    endif
    // ====================================================================
    //              3. LIBERAR O LOCK (SEMPRE)
    // ====================================================================
    EraseObjProperty(donation_chest, lock_prop);
    LogDebug("recursos_gen", "Lock liberado no baú " + donation_chest.serial + " após geração de recursos.");
    // ====================================================================
    LogInfo("recursos_gen", "=== GERAÇÃO FINALIZADA para '" + territory_name_from_elem + "' ===");
    return items_created_successfully_count;
endfunction

   // Ajuste em NotifyFactionLeadersOfResourceGeneration para incluir info da caravana
function NotifyFactionLeadersOfResourceGeneration(faction_name, territory_name_origin, resources_array, amount_per_type, success_count, was_redirected_to_capital := 0, delivery_chest_name := "")
    var guild := FindGuildByName(faction_name);
    if (!guild || guild == error) return 0; endif

    var leader_serials := array{};
    var guild_leader_serial := guild.GetProp("leader");
    if (guild_leader_serial) leader_serials.append(guild_leader_serial); endif

    foreach player_char in EnumerateOnlineCharacters()
        if (player_char.guildid == guild.guildid)
            var player_rank_str := GetObjProperty(player_char, "guild_rank");
            if (player_rank_str in {"Lider", "Capitao", "Tenente", "Leader", "Captain", "Lieutenant"})
                if (!(player_char.serial in leader_serials)) leader_serials.append(player_char.serial); endif
            endif
            var chardata_player := GetObjProperty(player_char, "chardata");
            if (chardata_player && (chardata_player.current_nobility_title in {"Rei", "Rainha"} || chardata_player.current_professional_position in {"Imperador", "Mão do Rei"}))
                if (!(player_char.serial in leader_serials)) leader_serials.append(player_char.serial); endif
            endif
        endif
    endforeach;

    if (leader_serials.size() == 0) return 0; endif

    var resource_names_str := "";
    for i_res := 1 to resources_array.size()
        if (i_res > 1) resource_names_str += ", "; endif
        if (i_res == resources_array.size() && i_res > 1) resource_names_str += "e "; endif
        resource_names_str += resources_array[i_res];
    endfor;

    var message_str := "Milord, um carregamento de recursos (" + resource_names_str + ", " + amount_per_type + " unidades de cada) ";
    message_str += "produzido em '" + territory_name_origin + "'";

    if (was_redirected_to_capital)
        message_str += ", devido à caravana ativa, foi entregue no baú '" + (delivery_chest_name ? delivery_chest_name : "da capital") + "'.";
    else
        message_str += " chegou aos portões e foi armazenado no baú local '" + (delivery_chest_name ? delivery_chest_name : "do território") + "'.";
    endif

    if (success_count < resources_array.size())
        message_str += " (" + success_count + "/" + resources_array.size() + " tipos armazenados).";
    endif

    foreach serial_val in leader_serials
        var leader_char := SystemFindObjectBySerial(serial_val);
        if (leader_char && leader_char.connected)
            SendSysMessageEx(leader_char, message_str, SSM_INFO);
        endif
    endforeach;
    return leader_serials.size();
endfunction

    // Função para atualizar o cache de recursos do baú
    function UpdateResourceCache(chest)
        if (!chest)
            return 0;
        endif
        
        // Marcar o baú para atualização
        SetObjProperty(chest, "recursos_cache_dirty", 1);
        
        // Agendar atualização
        var result := AgendarAtualizacaoBau(chest);
        if (result == error)
            LogError("recursos", "Falha ao agendar atualização para o baú");
            return 0;
        endif
        return result;
    endfunction

    // Função para notificar líderes de facção
    function NotifyFactionLeaders(faction_name, territory_name, resources_string, amount)
        var guild := FindGuildByName(faction_name);
        if (!guild || guild == error)
            return 0;
        endif
        var leader_serials := array{};
        
        // Adicionar o líder da facção
        var leader_serial := guild.GetProp("leader");
        if (leader_serial)
            leader_serials.append(leader_serial);
        endif
        
        // Buscar todos os jogadores online que possuem os títulos específicos
        foreach player in (EnumerateOnlineCharacters())
            var chardata := GetObjProperty(player, "chardata");
            if (chardata && chardata != error)
                // Verificar se o jogador tem um dos títulos específicos e pertence à mesma facção
                if (player.guildid == guild.guildid && 
                (chardata.current_nobility_title in {"Rei", "Rainha"} || 
                    chardata.current_professional_position in {"Imperador", "Mão do Rei"}))
                    // Adicionar apenas se ainda não estiver na lista
                    if (!(player.serial in leader_serials))
                        leader_serials.append(player.serial);
                    endif
                endif
            endif
        endforeach
        
        // Se não encontramos nenhum líder online, retornar
        if (leader_serials.size() == 0)
            return 0;
        endif
        
        // Separar recursos individuais e enviar uma mensagem para cada
        // Usar a nova função para tratar recursos com vírgulas
        var resources := SplitResourcesString(resources_string);
        
        foreach serial in (leader_serials)
            var leader := SystemFindObjectBySerial(serial);
            if (leader && leader != error && leader.connected)
                foreach resource in (resources)
                    // Validar o recurso
                    resource := Trim(resource);
                    if (resource == "")
                        continue;
                    endif
                    
                    var message := "Milord, um carregamento de " + resource + " (x" + amount + ") produzido em '" + 
                                    territory_name + "' chegou aos portões e já foi colocado nos devidos baús.";
                    SendSysMessageEx(leader, message, SSM_INFO);
                    sleepms(200); // Pequena pausa entre mensagens para o mesmo jogador
                endforeach
            endif        endforeach
        
        return leader_serials.size();
    endfunction

    // Função para atualizar a contagem de recursos diretamente no baú
    function AtualizarContagemRecursos(bau, force_update := 0)
        // Registrar início para depuração
        LogDebug("recursos", "AtualizarContagemRecursos() iniciada para baú: " + bau.serial);
        
        // === IMPLEMENTAÇÃO DE LOCK PARA PREVENIR RACE CONDITIONS ===
        var lock_prop := "recursos_update_lock";
        var lock_timeout := 30; // 30 segundos de timeout
        var current_time := polcore().systime;
        
        // Verificar se há lock ativo
        var existing_lock := GetObjProperty(bau, lock_prop);
        if (existing_lock)
            var lock_age := current_time - existing_lock.timestamp;
            if (lock_age < lock_timeout)
                if (existing_lock.pid == GetPid())
                    LogDebug("recursos", "Lock já pertence a este processo, continuando...");
                else
                    LogWarning("recursos", "Operação bloqueada por lock ativo (PID: " + existing_lock.pid + ", idade: " + lock_age + "s)");
                    return 0; // Retorna 0 em caso de lock ativo
                endif
            else
                LogWarning("recursos", "Lock expirado encontrado, removendo...");
                EraseObjProperty(bau, lock_prop);
            endif
        endif
        
        // Adquirir lock
        var lock_data := struct{
            "pid" := GetPid(),
            "timestamp" := current_time,
            "operation" := "update_recursos"
        };
        SetObjProperty(bau, lock_prop, lock_data);
        LogDebug("recursos", "Lock adquirido para atualização de recursos");
        
        // Obter último timestamp de atualização (dentro do lock)
        var ultimo_update := GetObjProperty(bau, "recursos_ultimo_update");
        
        // Se a última atualização foi recente e não estamos forçando nova contagem, usar o cache
        if (!force_update && ultimo_update && (current_time - ultimo_update < 300))
            LogDebug("recursos", "Usando cache - última atualização há " + (current_time - ultimo_update) + " segundos");
            var recursos_cache := GetObjProperty(bau, "recursos_cache");
            if (recursos_cache)
                // Liberar lock antes de retornar cache
                EraseObjProperty(bau, lock_prop);
                return recursos_cache;
            endif
        endif
        
        // Realizar contagem completa (operação crítica protegida por lock)
        LogDebug("recursos", "Realizando contagem completa dos recursos no baú (protegida por lock)");
        var recursos := ContarRecursosReais(bau);
        
        // Verificar inconsistências se houver cache anterior
        var recursos_cache := GetObjProperty(bau, "recursos_cache");
        if (recursos_cache)
            // Usar a função consolidada com o parâmetro 'nivel' como "local"
            var inconsistencias := VerificarInconsistencias(bau, recursos, "local");
            
            // Registrar o resultado para depuração
            if (inconsistencias.size() > 0)
                LogDebug("recursos", "Encontradas " + inconsistencias.size() + " inconsistências no baú");
            endif
        endif
        
        // Atualizar o cache no baú (operação atômica)
        SetObjProperty(bau, "recursos_cache", recursos);
        SetObjProperty(bau, "recursos_ultimo_update", current_time);
        LogDebug("recursos", "Cache atualizado no baú (protegido por lock)");
        
        // Verificar se devemos atualizar o datafile global também
        var ultima_sync := GetObjProperty(bau, "recursos_ultima_sync");
        if (!ultima_sync || (current_time - ultima_sync > 1800) || force_update)
            // Se passou mais de 30 minutos da última sincronização ou estamos forçando
            LogDebug("recursos", "Sincronizando com datafile global (protegido por lock)");
            SincronizarComDataFile(bau, recursos);
            SetObjProperty(bau, "recursos_ultima_sync", current_time);
            LogDebug("recursos", "Datafile global atualizado");
        else
            LogDebug("recursos", "Datafile global não atualizado - última sync há " + (current_time - ultima_sync) + " segundos");
            // Agendar atualização futura se necessário
            AgendarAtualizacaoDataFileLocal(bau);
        endif
        
        // === SEMPRE LIBERAR O LOCK ===
        EraseObjProperty(bau, lock_prop);
        LogDebug("recursos", "Lock liberado após atualização de recursos");
        
        return recursos;
    endfunction

 


    // Registrar falha de criação
    function RegistrarFalhaDeCriacao(elem, faction_name, territory_name, recursos_falhos)
    // Registrar no log
    LogError("recursos", "Falha ao criar recursos para " + territory_name + " (Facção: " + faction_name + ")");
    LogError("recursos", "Recursos falhos: " + recursos_falhos);
    
    // CORRIGIDO: Adicionar ao histórico de falhas do território
    var history := GetElementProp(elem, "ResourceFailHistory");
    if (!history)
        history := array{};
    endif
      history.append(struct{
        "time" := polcore().systime,
        "failed_resources" := recursos_falhos,
        OBJ_FACTION_PROP := faction_name
    });
    
    // Limitar o histórico a 10 entradas
    while (history.size() > 10)
        history.erase(1);
    endwhile
    
    SetElementProp(elem, "ResourceFailHistory", history);
    
    // Tentar notificar os administradores
    NotificarAdministradoresFalhaRecursos(faction_name, territory_name, recursos_falhos);
    
    return 1;
endfunction

    // Notificar administradores sobre falhas de recursos
    function NotificarAdministradoresFalhaRecursos(faction_name, territory_name, recursos_falhos)
        var mensagem := "SISTEMA: Falha ao gerar recursos em " + territory_name + 
                        " (Facção: " + faction_name + "). Recursos falhos: " + recursos_falhos;
        
        // Enviar para todos os GMs online
        foreach player in EnumerateOnlineCharacters()
            if (player.cmdlevel >= 3)
                SendSysMessageEx(player, mensagem, SSM_FAIL);
            endif
        endforeach
        
        // Registrar em um datafile específico para consulta posterior
        var df := SafeOpenDataFile(":faccao:resource_failures", 1);
        if (df)
            var elem := SafeFindElement(df, "log", 1);
            var logs := GetElementProp(elem, "entries", array{});
              logs.append(struct{
                "time" := polcore().systime,
                OBJ_FACTION_PROP := faction_name,
                "territory" := territory_name,
                "failed_resources" := recursos_falhos
            });
            
            // Limitar o tamanho do log
            while (logs.size() > 100)
                logs.erase(1);
            endwhile
            
            SetElementProp(elem, "entries", logs);
        endif
        
        return 1;
    endfunction

    // Processar revogações de territórios
    function ProcessRevocations()
        // Verifica se há notificações de revogação
        var df := SafeOpenDataFile(":faccao:messages");
        if (df)
            var elem := SafeFindElement(df, "resource_controller");
            if (elem)
                var revocations := GetElementProp(elem, "revocations");
                if (revocations)
                    foreach territorio in revocations
                        if (territorio && territorio != error)
                            LogDebug("recursos", "Processando revogação de território: " + territorio);
                            
                            // Remover do registro de recursos
                            var territorio_elem := FindElement(territorio);  // Renomeado para evitar conflito
                            if (territorio_elem && territorio_elem != error)
                                territorio_elem.EraseProp("NextResourceTime");
                                LogDebug("recursos", "Propriedade NextResourceTime removida para: " + territorio);
                            endif
                            
                            /*// Procurar o objeto existente que corresponde a este território
                            var item := FindExistingStackableItem(territorio);
                            if (item && item != error)
                                LogDebug("recursos", "Item existente encontrado para: " + territorio);
                                // Processar o item...
                            endif*/
                            
                            // Quaisquer outras ações necessárias
                        endif
                        sleepms(2); // Prevenir congelamento do servidor
                    endforeach
                    
                    // Limpar a lista após processar
                    SetElementProp(elem, "revocations", array{});
                endif
            endif
        endif
        
        // Também verificar diretamente o status de territórios agendados
        foreach territorio in (next_territory_checks.keys())
            var rect_df := SafeOpenDataFile(":architect:areas");
            if (rect_df)
                var elem := SafeFindElement(rect_df, territorio);
                if (elem)
                    var faction := GetElementProp(elem, TERRITORY_FACTION_PROP);
                    // Se o território agora é default, remover do agendamento
                    if (!faction || faction == DEFAULT_FACTION)
                        next_territory_checks.Erase(territorio);
                        LogInfo("recursos", "Território " + territorio + " agora é default, removido do agendamento");
                    endif
                endif
            endif
            sleepms(2);
        endforeach
        
        return 1;
    endfunction


    function ParseResourceList(resources_string)
        if (!resources_string)
            return array{};
        endif
        
        // Remover espaços extras
        resources_string := Trim(resources_string);
        
        // Se contém vírgulas, dividir por vírgulas
        if (resources_string.find(",") != error)
            var resources := array{};
            var parts := SplitWords(resources_string, ",");
            
            foreach part in parts
                part := Trim(part);
                if (part != "")
                    resources.append(part);
                endif
                sleepms(1);
            endforeach
            
            return resources;
        endif
        
        // Se não contém vírgulas, talvez seja apenas um recurso ou separado por espaços
        var space_parts := SplitWords(resources_string);
        
        if (space_parts.size() > 1)
            return space_parts;
        endif
        
        // Se chegou aqui, é apenas um recurso
        return array{resources_string};
    endfunction

    // Adicionar também a função auxiliar SplitResourcesString
    function SplitResourcesString(resources_string)
        return ParseResourceList(resources_string);
    endfunction

function ForcedSystemCleanup()
    LogInfo("ResourceController", "Iniciando limpeza forçada...");
        
        // Limpar todas as propriedades globais relacionadas
        var properties_to_clean := array{
            "ResourceControllerPID",
            "ActiveProcesses",
            "ResourceController_Status",
            "ResourceController_LastUpdate",
            "ResourceController_Lock"
        };
        
        foreach prop in properties_to_clean
            EraseGlobalProperty(prop);
            LogDebug("ResourceController", "Propriedade removida: " + prop);
            sleepms(10);
        endforeach
        
        // Tentar finalizar processos órfãos conhecidos via PID armazenado
        LogInfo("ResourceController", "Verificando processos órfãos conhecidos...");
        var killed_count := 0;
        
        // Verificar PIDs armazenados em propriedades globais ou outras localizações conhecidas
        var known_pids := array{};
        
        // Verificar se existem PIDs armazenados em outras propriedades
        var old_pid_props := array{
            "ResourceController_PID",
            "ResourceControllerPID_backup",
            "ResourceController_Process",
            "RC_PID"
        };
        
   foreach pid_prop in old_pid_props
        var stored_pid := GetGlobalProperty(pid_prop);
        if (stored_pid && stored_pid != error && stored_pid != GetPid()) // CORRIGIDO: GetPid() maiúsculo
            known_pids.append(stored_pid);
            EraseGlobalProperty(pid_prop);
            LogDebug("ResourceController", "PID órfão encontrado em " + pid_prop + ": " + stored_pid);
        endif
        sleepms(2);
    endforeach
        
        // Tentar finalizar PIDs conhecidos
        foreach pid in known_pids
            var process := GetProcess(CInt(pid));
            if (process && process != error)
                LogInfo("ResourceController", "Finalizando processo órfão conhecido: PID " + pid);
                var kill_result := process.kill();
                if (kill_result)
                    killed_count := killed_count + 1;
                    LogDebug("ResourceController", "Processo " + pid + " finalizado com sucesso");
                else
                    LogWarning("ResourceController", "Falha ao finalizar processo " + pid);
                endif
            else
                LogDebug("ResourceController", "Processo " + pid + " já não existe");
            endif
            sleepms(2);
        endforeach
        
        LogInfo("ResourceController", "Limpeza concluída. Processos finalizados: " + killed_count);
        
        if (killed_count > 0)
            LogInfo("ResourceController", "Aguardando estabilização do sistema...");
            sleep(5);
        endif
        
        // Limpar o dictionary de próximas verificações
        next_territory_checks := dictionary{};
        LogInfo("ResourceController", "Dictionary de territórios limpo.");
        
        // Limpar quaisquer locks ou semáforos que possam existir
        EraseGlobalProperty("ResourceController_Running");
        EraseGlobalProperty("ResourceController_Lock_Time");
        EraseGlobalProperty("ResourceController_Instance");
        
        LogInfo("ResourceController", "Limpeza forçada concluída com sucesso.");
        return 1;
    endfunction


function LoadAllTerritories()
    LogInfo("ResourceController", "Carregando lista completa de territórios...");
    next_territory_checks := dictionary{}; 
    
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        LogError("ResourceController", "Não foi possível abrir :architect:areas para carregar territórios.");
        return 0;
    endif
    
    var all_elements_names := rect_df.keys();
    LogDebug("ResourceController", "Total de elementos no datafile ':architect:areas': " + all_elements_names.size());
    
    var current_time := polcore().systime;
    var territories_loaded_count := 0;
    
    foreach element_name_key in all_elements_names
        var elem := SafeFindElement(rect_df, element_name_key);
        if (!elem)
            LogWarning("ResourceController", "Elemento '" + element_name_key + "' não pôde ser encontrado via SafeFindElement durante o LoadAllTerritories, pulando.");
            continue;
        endif
        
        var territory_id_for_schedule := GetElementProp(elem, TERRITORY_ID_PROP, element_name_key);
        var friendly_name_for_log := GetElementProp(elem, "Name", element_name_key);        var faction := GetTerritoryFaction(elem);
        
        var resources_str := GetElementProp(elem, "Resources");
        
        LogDebug("ResourceController_Load", "Verificando Elemento: '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + "), Facção: " + (faction ? faction : "N/A") + ", Recursos: " + (resources_str ? resources_str : "N/A"));
        
        if (faction && faction != "" && faction != DEFAULT_FACTION && resources_str && resources_str != "")
            LogInfo("ResourceController_Load", "Território VÁLIDO para agendamento: '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + "), Facção: " + faction);
            territories_loaded_count +=1;

            var next_time_from_prop := GetElementProp(elem, "NextResourceTime");
            var schedule_this_check_at := 0;

            if (next_time_from_prop)
                schedule_this_check_at := CInt(next_time_from_prop);
            endif // Adicionado endif faltante
            
            var interval_minutes := GetValidatedResourceInterval(elem); 
            var calculated_next_ideal_check := current_time + (interval_minutes * 60);

            if (!schedule_this_check_at || schedule_this_check_at <= current_time)
                // Se não há agendamento ou já passou da hora, verificar "agora" (ou o mais breve possível, current_time)
                // E definir o NextResourceTime no datafile para o próximo ciclo real.
                LogDebug("ResourceController_Load", "Território '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + ") será verificado AGORA. Próximo ciclo real em " + interval_minutes + " min.");
                next_territory_checks[territory_id_for_schedule] := current_time; // Agendar para o ciclo atual
            elseif (schedule_this_check_at > (current_time + (1440 * 60 * 2))) // Se agendado para mais de 2 dias no futuro (erro provável)
                LogWarning("ResourceController_Load", "NextResourceTime para '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + ") está muito distante ("+schedule_this_check_at+"). Recalculando e corrigindo para " + interval_minutes + " min a partir de agora.");
                next_territory_checks[territory_id_for_schedule] := calculated_next_ideal_check;
                SetElementProp(elem, "NextResourceTime", calculated_next_ideal_check); // Corrigir no datafile
            else
                // Agendamento futuro válido, usar o valor do datafile.
                LogDebug("ResourceController_Load", "Território '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + ") corretamente agendado para " + schedule_this_check_at + " (em " + (schedule_this_check_at - current_time) + "s)");
                next_territory_checks[territory_id_for_schedule] := schedule_this_check_at;
            endif // Fechando o if/elseif/else
        else
            LogDebug("ResourceController_Load", "Território '" + friendly_name_for_log + "' (ID Agendamento: " + territory_id_for_schedule + ") IGNORADO (sem facção válida ou recursos).");
        endif
        
        sleepms(2);
    endforeach
    
    LogInfo("ResourceController", "Carregamento de territórios concluído. Total de territórios ativos agendados: " + next_territory_checks.size() + " (de " + territories_loaded_count + " válidos encontrados).");
    return next_territory_checks.size();
endfunction

function GetValidatedResourceInterval(elem, default_interval := 1) // MUDADO: padrão agora é 1 minuto
    var resource_interval := CInt(GetElementProp(elem, "ResourceInterval"));
    
    // MUDADO: Limites ajustados para permitir 1 minuto
    if (resource_interval < 1) // MUDADO: mínimo agora é 1 minuto
        LogWarning("ResourceController", "ResourceInterval muito baixo (" + resource_interval + "), ajustando para 1 minuto");
        resource_interval := 1; // MUDADO: mínimo é 1 minuto
        SetElementProp(elem, "ResourceInterval", resource_interval);
    elseif (resource_interval > 1440) // Máximo 24 horas (mantido)
        LogWarning("ResourceController", "ResourceInterval muito alto (" + resource_interval + "), ajustando para 1440 minutos");
        resource_interval := 1440;
        SetElementProp(elem, "ResourceInterval", resource_interval);
    elseif (resource_interval == 0)
        LogInfo("ResourceController", "ResourceInterval não configurado, usando padrão: " + default_interval + " minuto");
        resource_interval := default_interval; // Agora será 1 minuto
        SetElementProp(elem, "ResourceInterval", resource_interval);
    endif
    
    return resource_interval;
endfunction

function FormatTimeA(timestamp)
    if (!timestamp)
        return "NUNCA";
    endif
    
    var current := polcore().systime;
    var diff := timestamp - current;
    
    if (diff <= 0)
        return "AGORA";
    endif
    
    var hours := diff / 3600;
    var minutes := (diff % 3600) / 60;
    
    if (hours > 0)
        return hours + "h" + minutes + "m";
    else
        return minutes + "m";
    endif
endfunction