// :faccao:baudoacao/canInsert.src (VERSÃO 2.4 - FINAL SILENCIOSA)

use uo;
use guilds;

include ":faccao:include/shared_functions";
include ":faccao:include/faccao_constants";
include ":faccao:include/permissions";

program CanInsert(mobile, container, movetype, insert_type, adding_item, existing_stack, amt_to_add)
    // Silenciar avisos
    movetype := movetype; insert_type := insert_type; existing_stack := existing_stack; amt_to_add := amt_to_add;

    // Permitir inserções do sistema
    if (!mobile || GetObjProperty(adding_item, "CreatedByResourceController") || GetObjProperty(adding_item, "IsSystemDeposit"))
        return 1;
    endif

    // Validar permissão do jogador
    if (!CanInsertItems(mobile, container))
        SendSysMessage(mobile, "Você não tem permissão para inserir itens neste baú.");
        return 0;
    endif

    // Validar tipo de doação
    var donation_types := array{ "IsKingdomDonationComida", "IsKingdomDonationMoedas", "IsKingdomDonationCouro", "IsKingdomDonationMetal", "IsKingdomDonationMadeira", "IsKingdomDonationPano", "IsKingdomDonationPedra", "IsKingdomDonationJoias" };
    foreach donation_type in donation_types
        if (GetObjProperty(adding_item, donation_type))
            if (donation_type == "IsKingdomDonationMoedas" && (adding_item.objtype == 0xBA64 || adding_item.objtype == 0xBA65))
                SendSysMessage(mobile, "Por favor, troque suas moedas por cobre em um cambista antes de doar.");
                return 0;
            endif
            return 1; // Item válido
        endif
    endforeach

    // Se chegou aqui, não é um item de doação válido
    SendSysMessage(mobile, "Isso não é uma doação válida para o baú.");
    return 0;
endprogram