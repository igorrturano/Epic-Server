use uo;
use guilds;
use datafile;

include "include/say"; // Se usado para PrintText/SendSysMessage, mas parece não ser o caso aqui diretamente
include ":faccao:include/shared_functions"; // Para GetFactionOfChest, GetPlayerFaction, LogPermissionCheck, CanRemoveItems
include ":faccao:include/faccao_constants";       // Para KINGDOM_FACTION
include ":faccao:include/permissions";    // CanRemoveItems pode estar aqui ou em shared_functions
include ":faccao:include/logging";       // Para LogInfo, LogWarning

program CanRemove(mobile, container, item, move_type)
    // Parâmetros que precisamos preservar mesmo que não usemos
    move_type := move_type;
    // item é usado abaixo

    // CASO 1: Sistema tentando remover (ex: pagamento de caravana)
    // 'mobile' será 0 ou um objeto não-personagem.
    // Para simplificar, se mobile não é um player válido, é o sistema.
    if (!mobile || !mobile.isA(POLCLASS_MOBILE) || !mobile.serial)
        LogInfo("canRemoveDonation_SYS", "Remoção pelo sistema detectada. Item: " + item.objtype + ", Container: " + container.serial);
        // Permitir remoção de moedas pelo sistema
        if (item.objtype == 0xBA63) // Moedas de Cobre
            LogInfo("canRemoveDonation_SYS", "Sistema autorizado a remover moedas (0xBA63).");
            return 1;
        else
            LogWarning("canRemoveDonation_SYS", "Sistema tentou remover item não autorizado: " + item.objtype + ". Negado.");
            // Não envie SendSysMessage aqui, pois não há 'mobile' para receber.
            return 0;
        endif
    endif // Fim do if (!mobile ...)

    // CASO 2: Jogador tentando remover
    var can_remove := CanRemoveItems(mobile, container); // Usa a lógica de permissão centralizada
    
    // LogPermissionCheck já é chamado dentro de CanRemoveItems ou nas funções que ele chama.
    // Se você quiser um log específico para este hook, pode adicionar:
    // LogInfo("canRemoveDonation_PLAYER", "Jogador " + mobile.name + " tentando remover. Permissão: " + can_remove);
    
    if (!can_remove)
        var chest_faction := GetFactionOfChest(container);
        var player_faction := GetPlayerFaction(mobile);
        
        if (chest_faction == player_faction)
            SendSysMessage(mobile, "Apenas líderes e oficiais podem remover itens do baú da facção.");
        elseif (chest_faction == KINGDOM_FACTION)
            SendSysMessage(mobile, "Apenas o monarca e a Mão do Rei podem remover itens do tesouro do Reino.");
        else
            SendSysMessage(mobile, "Você não tem permissão para remover itens deste baú.");
        endif
        
        return 0;
    endif // Fim do if (!can_remove)

    return 1;
endprogram