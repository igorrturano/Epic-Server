function playerHandler(who, input)
	input := input - BUTTON_CHANGE_PLAYER;
	var player := SystemFindObjectBySerial(input, SYSFIND_SEARCH_OFFLINE_MOBILES);
	var is_honorary := IsHonoraryMember(guild, player);
	var options := array{};
	if (!is_honorary && (is_gm_or_leader || privilegies.giveprivs))
		options.append("Alterar Privilegios");
	endif

	if (!is_honorary && (is_gm_or_leader || aboveguild))
		options.append("Tornar Lider");
	endif

	if (who.cmdlevel || aboveguild)
		if (guild_obj.leader == input)
			options.append("Remover Lider");
		endif
	endif

	if (is_gm_or_leader || privilegies.above_members || aboveguild)
		options.append("Remover da Faccao");
	endif

	// Mudar tipo só disponível se não for o líder atual
	if ((is_gm_or_leader || aboveguild) && guild_obj.leader != input)
		options.append("Mudar Tipo de Membro");
	endif

	options.append("Cancelar");

	if (options.size() < 1)
		return;
	endif

	var output := RadioGump(who, 300, 0, "Escolha uma opcao", options, 0, 1);
	if (output["Alterar"])
		var privs := guild.GetProp(cstr(input));
		var checked := array{};
		var priv_opts := array{};
		foreach opt in (privs.keys())
			checked[_opt_iter] := privs[opt];
			priv_opts[_opt_iter] := priv_list[opt];
		endforeach

		var output := CheckBoxGump(who, 300, 0, "Escolha os privilegios que deseja alterar", priv_opts,
									checked);
		foreach opt in (privs.keys())
			var name := priv_opts[_opt_iter];
			privs[opt] := (name in output) >= 1;
		endforeach

		guild.SetProp(cstr(input), privs);
	elseif (output["Remover Lider"])
		guild.SetProp("leader", 0x0);
		ResetAllNpcs();
	elseif (output["Tornar Lider"])
		guild.SetProp("leader", input);
		SendSysMessageEx(who, "{} agora e o lider da faccao".format(player.name), SSM_INFO);
		ResetAllNpcs();
	elseif (output["Remover"])
		if (YesNo(who, "Deseja mesmo remover este personagem da faccao?"))
			RemMember(guild, player);
			SendSysMessageEx(who, "{} removido da faccao".format(player.name), SSM_INFO);
		endif
	elseif (output["Mudar Tipo"])
		_MudarTipoMembroHandler(who, player);
	endif

endfunction

// -------------------------------------------------------
// Permite ao líder mudar o tipo de um membro (full ↔ honorário).
// Regras: sem conflito de tipo em outra facção; cooldown de 7 dias.
// -------------------------------------------------------
function _MudarTipoMembroHandler(who, player)
	const COOLDOWN := 604800; // 7 dias em segundos

	var is_honorary    := IsHonoraryMember(guild, player);
	var tipo_atual_str := is_honorary ? "Membro Honorário" : "Membro Full";
	var tipo_novo      := is_honorary ? 0 : 1; // 0=full, 1=honorary
	var tipo_novo_str  := is_honorary ? "Membro Full" : "Membro Honorário";

	// Cooldown por facção (não bloqueia mudança de tipo em outras facções)
	var _cd_key := "tipo_change_time_" + cstr(guild.guildid);
	var last_change := GetObjProperty(player, _cd_key);
	var agora := POLCore().systime;
	if (last_change)
		var restante := COOLDOWN - (agora - last_change);
		if (restante > 0)
			var dias  := cint(restante / 86400);
			var horas := cint((restante - dias * 86400) / 3600);
			return SendSysMessageEx(who,
				"{} precisa esperar mais {} dia(s) e {} hora(s) para mudar de tipo nesta facção.".format(
					player.name, dias, horas), SSM_FAIL);
		endif
	endif

	// Conflito de tipo na outra facção
	if (tipo_novo == 1) // quer virar honorário
		var hon_id := GetObjProperty(player, "honorary_guild_id");
		if (hon_id)
			var hon_g := FindGuild(hon_id);
			if (hon_g && hon_g.guildid != guild.guildid)
				return SendSysMessageEx(who,
					"{} já é membro honorário em outra facção.".format(player.name), SSM_FAIL);
			endif
		endif
	else // quer virar full
		if (player.guild && player.guild.guildid != guild.guildid)
			return SendSysMessageEx(who,
				"{} já é membro full em outra facção.".format(player.name), SSM_FAIL);
		endif
	endif

	// Gump de confirmação
	var gump := GFCreateGump();
	GFSetId(gump, 0x12355);
	GFResizePic(gump, 0, 0, 9200, 380, 295);
	GFResizePic(gump, 15, 15, 9350, 350, 265);
	GFHtmlShadowed(gump, 20, 25, 340, 20, "#FFC33C", "<center>Mudar Tipo de Membro", 8);
	GFHtmlShadowed(gump, 20, 50, 340, 18, "#AAAAAA", "<center>" + player.name, 6);

	GFTextLine(gump, 30,  88, 0,  "Tipo atual:");
	GFTextLine(gump, 140, 88, 33, tipo_atual_str);

	GFTextLine(gump, 30,  118, 0,  "Novo tipo:");
	GFTextLine(gump, 140, 118, 63, tipo_novo_str);

	GFHTMLArea(gump, 30, 158, 320, 50,
		"<basefont color=#888888>Obs: ao mudar o tipo, o membro ficará 7 dias sem poder alterar o tipo nesta facção novamente.", 0);

	GFAddButton(gump, 65,  220, 4005, 4006, GF_CLOSE_BTN, 1);
	GFTextLine(gump,  100, 220, 1153, "Confirmar");
	GFAddButton(gump, 230, 220, 4017, 4018, GF_CLOSE_BTN, 0);
	GFTextLine(gump,  265, 220, 1153, "Cancelar");

	var input := GFSendGump(who, gump);
	if (!input || input[0] != 1)
		return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
	endif

	// Executa mudança
	var guild_name := guild.GetProp("name");
	RemMember(guild, player);
	AddMember(guild, player, tipo_novo);
	SetObjProperty(player, _cd_key, agora);

	SendSysMessageEx(who,
		"{} teve o tipo alterado de {} para {} na facção {}.".format(
			player.name, tipo_atual_str, tipo_novo_str, guild_name), SSM_INFO);
	SendSysMessage(player,
		"Seu tipo de membro na facção " + guild_name +
		" foi alterado: " + tipo_atual_str + " → " + tipo_novo_str +
		". Você não pode alterar o tipo nesta facção novamente por 7 dias.");
endfunction

function gmHandler(who)
	var opts := array{ "Alterar Nome", "Alterar Area", "Alterar Prisoes", "Pegar GuildID",
				   	"Alterar Sub-Guilds", "Tipo de Faccao", "Criar Bau", "Setar Bau", "Setar Soldo", "Setar Porta", "Remover Guilda", "Cancelar" };
	var output := RadioGump(who, 300, 0, "Escolha uma opcao", opts, 0, opts.size());

	if (output["Nome"])
		var gname := GetInput(who, who.backpack, "Qual o novo nome da faccao? (aperte esc para cancelar)");
		if (!gname)
			return SendSysMessageEx(who, "Cancelado");
		endif

		guild.SetProp("name", gname);
		SendSysMessageEx(who, "Nome alterado pra {}".format(gname));
	elseif (output["GuildID"])
		SendSysMessageEx(who, "Guild ID: {}".format(guild.guildid));
	elseif (output["Sub-Guilds"])
		var guild_opts := struct{};
		var guilds := ListGuilds();
		foreach guild_ref in guilds
			if (guild_ref.guildid != guild.guildid)
				guild_opts[guild_ref.GetProp("name")] := guild_ref.guildid;
			endif
			sleepms(2);
		endforeach
		guild_opts["[ Remover Todas ]"] := 0;

		var outputguilds := CheckBoxGump(who, 400, 0, "Escolha as facoes subalternas (marque [ Remover Todas ] para limpar)",
								   guild_opts.keys());

		var selected_guilds := array{};
		if (outputguilds)
			if ("[ Remover Todas ]" in outputguilds)
				selected_guilds := array{};
			else
				foreach guild_name in outputguilds
					if (guild_opts[guild_name])
						selected_guilds.append(guild_opts[guild_name]);
					endif
					sleepms(2);
				endforeach
			endif
		endif

		guild.SetProp("subguilds", selected_guilds);
		if (selected_guilds.size() == 0)
			SendSysMessageEx(who, "Sub-guilds removidas.", SSM_INFO);
		else
			SendSysMessageEx(who, "{} sub-guild(s) configurada(s).".format(selected_guilds.size()), SSM_INFO);
		endif
	elseif (output["Area"])
		var arearray := array{};
		while (1)
			var area := GetInput(who, who.backpack, "Escreva a area em x1 y1 x2 y2 (aperte esc para cancelar)");
			if (!area)
				break;
			endif
			area := SplitWords(area);

			if (area.size() < 4)
				SendSysMessageEx(who, "Area inv�lida");
			else
				arearray.append(area);
				SendSysMessageEx(who, "Area adicionada: {}".format(area));
			endif
		endwhile

		if (arearray.size() < 1)
			return SendSysMessageEx(who, "Cancelado");
		endif

		guild.SetProp("area", arearray);
		SendSysMessageEx(who, "Area alterada");
	elseif (output["Prisoes"])
		var prisoes := array{};
		while (who.connected)
			SendSysMessageEx(who, "Selecione um novo ponto de prisao. (Esc para parar)", SSM_INFO);
			var targ := TargetCoordinates(who);
			if (!targ)
				break;
			elseif (targ.isDoor())
				targ.doToggle();
				continue;
			endif
			prisoes.append(targ);
		endwhile

		if (prisoes.size() < 1)
			return SendSysMessageEx(who, "Cancelado");
		endif
		guild.SetProp("prisions", prisoes);

		var soltar := array{};
		while (who.connected)
			SendSysMessageEx(who, "Selecione um novo ponto de soltura. (Esc para parar)", SSM_INFO);
			var targ := TargetCoordinates(who);
			if (!targ)
				break;
			elseif (targ.isDoor())
				targ.doToggle();
				continue;
			endif
			soltar.append(targ);
		endwhile

		if (soltar.size() < 1)
			return SendSysMessageEx(who, "Cancelado");
		endif
		guild.SetProp("prision_leave", soltar);

		SendSysMessageEx(who, "Prisoes alteradas");
	elseif (output["Tipo de Faccao"])
		_TipoFaccaoHandler(who);
	elseif (output["Criar Bau"])
		_CriarBauHandler(who);
	elseif (output["Setar Bau"])
		_SetarBauHandler(who);
	elseif (output["Setar Soldo"])
		_SetarSoldoHandler(who);
	elseif (output["Setar Porta"])
		_SetarPortaHandler(who);
	elseif (output["Remover Guilda"])
		RemFaccao(guild.guildid);
		SendSysMessageEx(who, "Guilda removida");
		return 99;
	endif
endfunction

// -------------------------------------------------------
// Propaga (nome_idx > 0) ou apaga (nome_idx == 0) nomefaccao em todos os
// membros full, membros honorários, NPCs ativos e baú da facção.
// Também atualiza tipo_faccao no baú.
// -------------------------------------------------------
function _SyncNomeFaccaoMembers(guild, nome_idx)
	var _tipo_faccao := GetFaccaoTipo(guild);

	// Membros full
	foreach member in (guild.members)
		if (nome_idx)
			SetObjProperty(member, "nomefaccao", nome_idx);
		else
			EraseObjProperty(member, "nomefaccao");
		endif
		sleepms(2);
	endforeach

	// Membros honorários
	var hon_serials := guild.GetProp("honorary_members");
	if (hon_serials)
		foreach hon_serial in hon_serials
			var mob := SystemFindObjectBySerial(hon_serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
			if (!mob) sleepms(2); continue; endif
			if (nome_idx)
				SetObjProperty(mob, "nomefaccao", nome_idx);
			else
				EraseObjProperty(mob, "nomefaccao");
			endif
			sleepms(2);
		endforeach
	endif

	// NPCs ativos
	var npcs_active := guild.GetProp("npcs_active");
	if (npcs_active)
		foreach npc_data in npcs_active
			var npc := SystemFindObjectBySerial(npc_data.serial);
			if (!npc) sleepms(2); continue; endif
			if (nome_idx)
				SetObjProperty(npc, "nomefaccao", nome_idx);
			else
				EraseObjProperty(npc, "nomefaccao");
			endif
			sleepms(2);
		endforeach
	endif

	// Baú da facção
	var bau_serial := guild.GetProp("bau_serial");
	if (bau_serial)
		var bau := SystemFindObjectBySerial(bau_serial);
		if (bau)
			SetObjProperty(bau, "tipo_faccao", _tipo_faccao);
			if (nome_idx)
				SetObjProperty(bau, "nomefaccao", nome_idx);
			else
				EraseObjProperty(bau, "nomefaccao");
			endif
		endif
	endif

	// Itens registrados (mural, mesa, convite, totem, etc.)
	var itens := guild.GetProp("itens_faccao");
	var itens_validos := array{};
	var _has_stale := 0;
	if (itens)
		foreach item_serial in itens
			var item := SystemFindObjectBySerial(item_serial);
			if (!item)
				_has_stale := 1;
				sleepms(2);
				continue;
			endif
			SetObjProperty(item, "tipo_faccao", _tipo_faccao);
			if (nome_idx)
				SetObjProperty(item, "nomefaccao", nome_idx);
			else
				EraseObjProperty(item, "nomefaccao");
			endif
			itens_validos.append(item_serial);
			sleepms(2);
		endforeach
		if (_has_stale)
			guild.SetProp("itens_faccao", itens_validos);
		endif
	endif
endfunction

// -------------------------------------------------------
// Gump de seleção de tipo de facção (Staff / Player)
// -------------------------------------------------------
function _TipoFaccaoHandler(who)
	var tipo_atual      := guild.GetProp("tipo_faccao");
	var nomefaccao_atual := guild.GetProp("nomefaccao");

	var cor_staff  := (tipo_atual == "staff")  ? 63 : 0;
	var cor_player := (tipo_atual == "player") ? 63 : 0;

	var gump := GFCreateGump();
	GFSetId(gump, 0x12350);
	GFResizePic(gump, 0, 0, 9200, 300, 190);
	GFResizePic(gump, 15, 15, 9350, 270, 160);

	GFHtmlShadowed(gump, 20, 25, 200, 20, "#FFC33C", "<center>Tipo de Facção", 8);
	GFHtmlShadowed(gump, 20, 52, 260, 18, "#AAAAAA", "<center>Tipo atual: " + tipo_atual, 6);

	GFAddButton(gump, 40, 90, 4005, 4006, GF_CLOSE_BTN, 1);
	GFTextLine(gump, 70, 88, cor_staff, "Staff");

	GFAddButton(gump, 160, 90, 4005, 4006, GF_CLOSE_BTN, 2);
	GFTextLine(gump, 190, 88, cor_player, "Player");

	GFAddButton(gump, 95, 130, 4017, 4018, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 125, 128, 0, "Cancelar");

	var input := GFSendGump(who, gump);

	if (input[0] == 1) // Staff: pede qual das 5 facções de lore
		var nome_idx := _EscolherNomeFaccao(who, nomefaccao_atual);
		if (!nome_idx) return; endif
		var nome_lore := FACCAO_NOMES[nome_idx];
		// FACCAO_NOMES: 1=Regentes, 2=Sinodo, 3=Rufioes, 4=Conselho, 5=Liga
		var staff_tipo_map := array{ "regentes", "sinodo", "rufioes", "conselho", "liga" };
		var novo_staff_tipo := staff_tipo_map[nome_idx];
		guild.SetProp("tipo_faccao", "staff");
		guild.SetProp("nomefaccao", nome_idx);
		guild.SetProp("staff_tipo", novo_staff_tipo);
		guild.SetProp("name", nome_lore);
		guild_obj.tipo_faccao := "staff";
		guild_obj.name := nome_lore;
		_SyncNomeFaccaoMembers(guild, nome_idx);
		SendSysMessageEx(who, "Tipo: staff | Facção: {} ({}) | staff_tipo: {}".format(nome_lore, nome_idx, novo_staff_tipo));
	elseif (input[0] == 2) // Player: limpa nomefaccao e staff_tipo, preserva nome atual
		guild.SetProp("tipo_faccao", "player");
		guild.EraseProp("nomefaccao");
		guild.EraseProp("staff_tipo");
		guild_obj.tipo_faccao := "player";
		_SyncNomeFaccaoMembers(guild, 0);
		SendSysMessageEx(who, "Tipo alterado para: player");
	endif
endfunction

// -------------------------------------------------------
// Gump para o GM escolher qual das 5 facções staff
// -------------------------------------------------------
function _EscolherNomeFaccao(who, atual := 0)
	var gump := GFCreateGump();
	GFSetId(gump, 0x12351);
	GFResizePic(gump, 0, 0, 9200, 300, 240);
	GFResizePic(gump, 15, 15, 9350, 270, 210);

	GFHtmlShadowed(gump, 20, 25, 260, 20, "#FFC33C", "<center>Qual facção staff?", 8);

	var y := 60;
	foreach nome in FACCAO_NOMES
		var cor := (atual == _nome_iter) ? 63 : 0;
		GFAddButton(gump, 30, y, 4005, 4006, GF_CLOSE_BTN, _nome_iter);
		GFTextLine(gump, 60, y - 2, cor, nome);
		y += 28;
		sleepms(2);
	endforeach

	GFAddButton(gump, 95, y + 8, 4017, 4018, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 125, y + 6, 0, "Cancelar");

	var input := GFSendGump(who, gump);
	if (!input[0]) return 0; endif
	return input[0];
endfunction

// -------------------------------------------------------
// Cria um bau de faccao no local indicado pelo GM.
// Marca o bau com guild e tipo_faccao para que sistemas
// externos saibam a qual faccao e categoria ele pertence.
// -------------------------------------------------------
function _LimparCofreidMerchants()
	var npcs_active := guild.GetProp("npcs_active");
	if (!npcs_active) return; endif
	foreach entry in npcs_active
		var npc := SystemFindObjectBySerial(entry.serial);
		if (npc) EraseObjProperty(npc, "cofreid"); endif
		sleepms(2);
	endforeach
endfunction

function _CriarBauHandler(who)
	if (guild.GetProp("tipo_faccao") != "staff")
		return SendSysMessageEx(who, "O bau so pode ser criado para faccoes do tipo staff.", SSM_FAIL);
	endif

	var bau_serial := guild.GetProp("bau_serial");
	if (bau_serial)
		var bau_existente := SystemFindObjectBySerial(bau_serial);
		if (bau_existente)
			return SendSysMessageEx(who, "Esta faccao ja possui um bau (serial={}).".format(bau_serial), SSM_FAIL);
		endif
		// Bau anterior foi destruido — permite criar outro
		guild.EraseProp("bau_serial");
	endif

	SendSysMessageEx(who, "Clique no local onde deseja criar o bau.", SSM_INFO);
	var loc := TargetCoordinates(who);
	if (!loc)
		return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
	endif

	var bau := CreateItemAtLocation(loc.x, loc.y, loc.z, 0xE42, 1, who.realm);
	if (!bau)
		return SendSysMessageEx(who, "Erro ao criar o bau.", SSM_FAIL);
	endif

	var lockid := AllocLockId();
	bau.movable := 0;
	SetObjProperty(bau, "LockId", lockid);

	var chave := CreateItemInContainer(bau, "ironkey", 1);
	if (chave)
		SetObjProperty(chave, "LockId", lockid);
		chave.name := "Chave do Bau da Faccao";
	endif

	var tipo := guild.GetProp("tipo_faccao");
	if (!tipo) tipo := "player"; endif

	SetObjProperty(bau, "guild",       guild.guildid);
	SetObjProperty(bau, "tipo_faccao", tipo);
	PropagateNomeFaccao(guild, bau);
	bau.name := "Bau da Faccao";

	guild.SetProp("bau_serial", bau.serial);
	_LimparCofreidMerchants();

	SendSysMessageEx(who, "Bau criado | guild={} tipo={} lockid={}".format(guild.guildid, tipo, lockid), SSM_INFO);

	Print("[Bau-DEBUG] Bau criado com sucesso:");
	Print("[Bau-DEBUG]   guild      = " + guild.GetProp("name") + " (id=" + guild.guildid + ")");
	Print("[Bau-DEBUG]   serial     = " + bau.serial);
	Print("[Bau-DEBUG]   posicao    = " + bau.x + "," + bau.y + "," + bau.z + " realm=" + bau.realm);
	Print("[Bau-DEBUG]   lockid     = " + lockid);
	Print("[Bau-DEBUG]   chave      = " + (chave ? "serial=" + chave.serial : "FALHOU - chave nao criada"));
	Print("[Bau-DEBUG]   tipo_faccao= " + tipo);
endfunction

// -------------------------------------------------------
// Aponta o bau_serial da faccao para um container ja existente no mundo.
// Util para trocar o bau ativo sem destruir o anterior.
// -------------------------------------------------------
function _SetarBauHandler(who)
	if (guild.GetProp("tipo_faccao") != "staff")
		return SendSysMessageEx(who, "O bau so pode ser setado para faccoes do tipo staff.", SSM_FAIL);
	endif

	var bau_serial_antigo := guild.GetProp("bau_serial");
	if (bau_serial_antigo)
		var bau_antigo := SystemFindObjectBySerial(bau_serial_antigo);
		if (bau_antigo)
			SendSysMessageEx(who, "Bau atual: serial={} — ele NAO sera destruido.".format(bau_serial_antigo), SSM_INFO);
		endif
	endif

	SendSysMessageEx(who, "Clique no container que deseja setar como novo bau desta faccao.", SSM_INFO);
	var targ := Target(who);
	if (!targ)
		return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
	endif

	if (!targ.isA(POLCLASS_CONTAINER))
		return SendSysMessageEx(who, "O alvo precisa ser um container.", SSM_FAIL);
	endif

	var outro_guild := GetObjProperty(targ, "guild");
	if (outro_guild != error && outro_guild != guild.guildid)
		return SendSysMessageEx(who, "Este container ja pertence a outra faccao (guild={}).".format(outro_guild), SSM_FAIL);
	endif

	var tipo := guild.GetProp("tipo_faccao");
	if (!tipo) tipo := "staff"; endif

	targ.movable := 0;
	targ.locked  := 1;
	SetObjProperty(targ, "guild",       guild.guildid);
	SetObjProperty(targ, "tipo_faccao", tipo);
	PropagateNomeFaccao(guild, targ);
	targ.name := "Bau da Faccao";

	guild.SetProp("bau_serial", targ.serial);
	_LimparCofreidMerchants();

	SendSysMessageEx(who, "Bau setado | serial={} guild={} tipo={}".format(targ.serial, guild.guildid, tipo), SSM_INFO);
endfunction

// -------------------------------------------------------
// Registra uma porta como pertencente a esta faccao de lore (staff).
// Apenas GMs podem registrar. Membros com unlockdoors podem trocar a tranca depois.
// Seriais das portas ficam em guild prop "portas_serials".
// -------------------------------------------------------
function _SetarPortaHandler(who)
	if (GetFaccaoTipo(guild) != "staff")
		return SendSysMessageEx(who, "Setar porta so pode ser feito para faccoes do tipo staff.", SSM_FAIL);
	endif

	SendSysMessageEx(who, "Clique na porta que deseja configurar para esta faccao.", SSM_INFO);
	var targ := Target(who);
	if (!targ)
		return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
	endif
	if (!targ.IsDoor())
		return SendSysMessageEx(who, "Isso nao e uma porta.", SSM_FAIL);
	endif

	var door_guild_id := GetObjProperty(targ, "guild");
	if (door_guild_id != error && door_guild_id != guild.guildid)
		return SendSysMessageEx(who, "Esta porta ja pertence a outra faccao.", SSM_FAIL);
	endif

	var portas := guild.GetProp("portas_serials");
	if (!portas) portas := array{}; endif

	if (targ.serial in portas)
		return SendSysMessageEx(who, "Esta porta ja esta registrada nesta faccao.", SSM_FAIL);
	endif

	portas.append(targ.serial);
	guild.SetProp("portas_serials", portas);
	SetObjProperty(targ, "guild", guild.guildid);

	SendSysMessageEx(who, "Porta registrada | serial={} guild={}".format(targ.serial, guild.guildid), SSM_INFO);
endfunction

// -------------------------------------------------------
// Configura o soldo periodico da faccao (apenas staff).
// Salva na guild: soldo_lider, soldo_membro, soldo_intervalo, soldo_proximo.
// O soldocontrol.src le essas props e deposita no bau periodicamente.
// -------------------------------------------------------
function _SetarSoldoHandler(who)
	if (guild.GetProp("tipo_faccao") != "staff")
		return SendSysMessageEx(who, "Soldo so pode ser configurado para faccoes do tipo staff.", SSM_FAIL);
	endif
	if (!guild.GetProp("bau_serial"))
		return SendSysMessageEx(who, "Crie o bau da faccao antes de configurar o soldo.", SSM_FAIL);
	endif

	// Valores atuais para pre-preencher o gump
	var cur_lider   := cstr(guild.GetProp("soldo_lider")  || "0");
	var cur_membro  := cstr(guild.GetProp("soldo_membro") || "0");
	var cur_int     := cint(guild.GetProp("soldo_intervalo")); // 60, 604800 ou 1296000

	var gump := GFCreateGump(150, 150);
	GFResizePic(gump, 0,   0,   9200, 310, 230);
	GFResizePic(gump, 10,  10,  9350, 290, 210);

	GFHtmlShadowed(gump, 15, 18, 280, 20, "#FFC33C", "<center>Configurar Soldo", 7);

	// ── Soldo do Lider ────────────────────────────────────
	GFTextLine(gump,  20,  50, 0, "Soldo do Lider (moedas de cobre):");
	var id_lider := GFTextEntry(gump, 20, 68, 260, 20, 0, cur_lider, 1, 10);

	// ── Soldo dos Membros ─────────────────────────────────
	GFTextLine(gump,  20,  95, 0, "Soldo dos Membros (moedas de cobre):");
	var id_membro := GFTextEntry(gump, 20, 113, 260, 20, 0, cur_membro, 2, 10);

	// ── Intervalo ─────────────────────────────────────────
	GFTextLine(gump, 20, 142, 0, "Intervalo de pagamento:");

	GFSetRadioGroup(gump, 1);
	GFRadioButton(gump, 20,  160, 9727, 9730, (cur_int == 60      || !cur_int), 10);
	GFTextLine(gump,    40,  160, 0, "1 minuto (teste)");
	GFRadioButton(gump, 20,  178, 9727, 9730, (cur_int == 604800), 11);
	GFTextLine(gump,    40,  178, 0, "7 dias");
	GFRadioButton(gump, 130, 178, 9727, 9730, (cur_int == 1296000), 12);
	GFTextLine(gump,    150, 178, 0, "15 dias");

	// ── Botoes ────────────────────────────────────────────
	GFAddButton(gump, 60,  202, 4005, 4006, GF_CLOSE_BTN, 1);
	GFTextLine(gump,  90,  202, 0, "Confirmar");
	GFAddButton(gump, 185, 202, 4017, 4018, GF_CLOSE_BTN, 0);
	GFTextLine(gump,  215, 202, 0, "Cancelar");

	var res := GFSendGump(who, gump);
	if (!res || res[0] != 1)
		return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
	endif

	var v_lider  := cint(GFExtractData(res, id_lider));
	var v_membro := cint(GFExtractData(res, id_membro));

	var intervalo := 60; // default: 1 min
	if    (res[11]) intervalo := 604800;
	elseif(res[12]) intervalo := 1296000;
	endif

	guild.SetProp("soldo_lider",     v_lider);
	guild.SetProp("soldo_membro",    v_membro);
	guild.SetProp("soldo_intervalo", intervalo);

	// Para 7 ou 15 dias: primeiro pagamento dispara no proximo ciclo do soldocontrol (< 60s).
	// Para modo teste (1 min): comportamento normal, aguarda o intervalo.
	if (intervalo == 604800 || intervalo == 1296000)
		guild.SetProp("soldo_proximo", polcore().systime - 1);
	else
		guild.SetProp("soldo_proximo", polcore().systime + intervalo);
	endif

	SendSysMessageEx(who, "Soldo configurado | lider={} membro={} intervalo={}s".format(
		v_lider, v_membro, intervalo), SSM_INFO);

endfunction

function npcHandler(who, input)
	if (input == BUTTON_REPORT_NPC)
		var historico := guild.GetProp("reports");
		if (!historico)
			historico := array{};
		endif
		historico := "<br> - {}".format("<br> -".join(historico));
		SendHTMLGump(who, "Historico dos Guardas", historico);
	elseif (input == BUTTON_CONTRACT_NPC)
		var _tipo_faccao := GetFaccaoTipo(guild);

		var npcs_array := listNPC(guild);

		if (!npcs_array || npcs_array.size() == 0)
			if (_tipo_faccao == "staff")
				return SendSysMessageEx(who, "Esta facção não possui agentes disponíveis para contratar.", SSM_FAIL);
			endif
			npcs_array := array{
				struct{ "template" := ":epicai:guardafaccaofraco",   "price" := 25,  "name" := "Guarda Recruta (Fraco)",      "equipment" := array{} },
				struct{ "template" := ":epicai:guardafaccaomedio",   "price" := 70,  "name" := "Guarda Veterano (Medio)",     "equipment" := array{} },
				struct{ "template" := ":epicai:guardafaccaoforte",   "price" := 100, "name" := "Guarda Elite (Forte)",         "equipment" := array{} },
				struct{ "template" := ":merchants:merchantfaccao",   "price" := 10,  "name" := "Vendedor da Faccao",           "equipment" := array{} },
				struct{ "template" := ":merchants:bardofaccao",      "price" := 10,  "name" := "Bardo",                        "equipment" := array{} }
			};
			// Persiste os defaults para que ContractNPC (que usa listNPC) possa ler o template correto.
			// Sem isso, listNPC retorna array vazio, o NPC não é criado mas o dinheiro já foi consumido.
			guild.SetProp("npcs", npcs_array);
		endif
		guild_obj.npcs := npcs_array;

		var opts := array{};
		foreach agent in (guild_obj.npcs)
			opts[_agent_iter] := "{} [{} mc]".format(agent.name, agent.price);
			sleepms(2);
		endforeach
		opts.append("Cancelar");

		var npc_choice := RadioGump(who, 400, 0, " deseja contratar?", opts, 1, 1);
		if (opts.size() == npc_choice)
			return SendSysMessageEx(who, "Cancelado");
		endif

		var agent := guild_obj.npcs[npc_choice];

		if (who.cmdlevel)
			var opt_out := RadioGump(who, 300, 0, "Escolha uma opcao", array{ "Alterar Configuracoes", "Equipamentos",
																  			"Contratar", "Cancelar" },
						 			0, 1);
			if (opt_out["Cancelar"])
				return;
			endif
			var npc_list := guild.getProp("npcs");
			if (opt_out["Configuracoes"])
				var questions := array{};
				questions.append(struct{ "title" := "Template do agente?",
						 				"marked" := npc_list[npc_choice].template });
				questions.append(struct{ "title" := "Nome (representativo) do agente?",
						 				"marked" := npc_list[npc_choice].name });
				questions.append(struct{ "title" := "Preco do Soldo (em moedas)?",
						 				"marked" := cstr(npc_list[npc_choice].price) });
				var output := QuestionsGump(who, questions);
				if (!output)
					return;
				endif

				npc_list[npc_choice].template := output[1];
				npc_list[npc_choice].price := cint(output[3]);
				npc_list[npc_choice].name := output[2];
				guild.SetProp("npcs", npc_list);
			// elseif (opt_out["Boss"])
			//    CreatebossStructGump(who, npc_list[npc_choice].bossStruct);
			//    guild.SetProp("npcs", npc_list);
			elseif (opt_out["Equip"])
				npc_list[npc_choice].equipment := array{};
				while (who.connected)
					SendSysMessageEx(who, "Escolha o equipamento. (esc para cancelar)", SSM_REQUEST);
					var targ := Target(who);
					if (!targ)
						break;
					elseif (!targ.isA(POLCLASS_ITEM))
						SendSysMessageEx(who, "Item Invalido");
					else
						npc_list[npc_choice].equipment.append(CreateItemTemplate(targ));
					endif
				endwhile
				guild.SetProp("npcs", npc_list);
			endif

			if (!opt_out["Contratar"])
				return;
			endif
		endif
		/* if (!InGuildRect(guild, who) && !who.cmdlevel)
         return SendSysMessageEx(who, "Voce nao pode contratar agentes estando fora da sua area de influencia.", SSM_FAIL);
      endif */
		var cost := cint(agent.price);
		if (ConsumeSubstance(who.backpack, 0xba63, cost))
			SendSysMessageEx(who, "Voce pagou {} moedas de cobre pelo contrato.".format(cost), SSM_INFO);
		else
			var g_money := cint(guild.getProp("money"));
			if (g_money < cost)
				return SendSysMessageEx(who, "Moedas de cobre insuficientes na bolsa e no cofre da faccao.", SSM_FAIL);
			endif
			guild.setProp("money", g_money - cost);
			SendSysMessageEx(who, "{} moedas de cobre cobradas do cofre da faccao.".format(cost), SSM_INFO);
		endif

		ContractNPC(guild, npc_choice, who, who, 0);
	elseif (input == BUTTON_ADD_NPC)
		var questions := array{};
		questions.append(struct{ "title" := "Template do agente?", "marked" := ":brainai:" });
		questions.append(struct{ "title" := "Nome (representativo) do agente?", "marked" := "" });
		questions.append(struct{ "title" := "Preco do Soldo (em moedas)?", "marked" := "20" });
		// questions.append(struct{ "title" := "Adicionar modificadores de boss?", "marked" := 1, "radio" := array{"N�o", "Sim"}} );
		var output := QuestionsGump(who, questions);
		if (!output)
			return SendSysMessageEx(who, "Cancelado");
		endif

		var npc_struct := struct{ "template" := output[1],
						  		"price" := cint(output[3]),
						  		"name" := output[2], "equipment" := array{} };

		// if (output[4] == "Sim")
		//   npc_struct.bossStruct := struct{};
		//   CreatebossStructGump(who, npc_struct.bossStruct);
		// endif

		while (who.connected)
			SendSysMessageEx(who, "Escolha o equipamento. (esc para cancelar)", SSM_REQUEST);
			var targ := Target(who);
			if (!targ)
				break;
			elseif (!targ.isA(POLCLASS_ITEM))
				SendSysMessageEx(who, "Item Invalido");
			else
				npc_struct.equipment.append(CreateItemTemplate(targ));
			endif
		endwhile

		if (AddNpc(guild, npc_struct))
			SendSysMessageEx(who, "Agente adicionado");
		else
			SendSysMessageEx(who, "Agente deu errado");
		endif
	else
		input -= BUTTON_DISMISS_NPC;
		var npcs := guild.getProp("npcs_active");
		var npc_obj := npcs[input];
		var mob := SystemFindObjectBySerial(npc_obj.serial);
		if (YesNo(who, "Deseja encerrar o contrato com este agente ({})?".format(mob.name)))
			DismissNPC(guild, input, mob, who);
		endif
	endif
endfunction

function lawHandler(who, input)
	if (input == BUTTON_ADD_LAW)
		var law_opts := array{};
		foreach opt in (law_list.keys())
			law_opts[_opt_iter] := law_list[opt];
		endforeach
		law_opts.append("Cancelar");

		var output := RadioGump(who, 400, 0, "Escolha qual lei quer adicionar", law_opts, 1,
								 law_opts.size());
		if (output == law_opts.size())
			return;
		endif

		var new_law := struct{ "type" := law_list.keys()[output] };

		if (new_law.type["item"])
			SendSysMessageEx(who, "Escolha o item que sera proibido (esc para cancelar)", SSM_REQUEST);
			var targ := Target(who);
			if (!targ)
				return SendSysMessageEx(who, "Cancelado");
			elseif (!targ.isA(POLCLASS_ITEM))
				return SendSysMessageEx(who, "Cancelado");
			endif
			new_law.opt := struct{ "objtype" := targ.objtype, "name" := targ.name };
		elseif (new_law.type["norace"])
			var raceopts := array{ "humano", "elfo", "anao", "orc", "hobbit", "drow", "Cancelar" };
			var racenemy := RadioGump(who, 400, 0, "Escolha qual raca sera considerada inimiga", raceopts,
									   0, raceopts.size());
			if (racenemy["Cancelar"])
				return SendSysMessageEx(who, "Cancelado");
			endif
			new_law.opt := racenemy;

		/* elseif (new_law.type["noguild"])
         var guild_opts := struct{};
         var guilds := ListGuilds();
         foreach guild_ref in guilds
            if (guild_ref.guildid != guild.guildid)
               guild_opts[guild_ref.GetProp("name")] := guild_ref.guildid;
            endif
            sleepms(2);
         endforeach
         guild_opts["Cancelar"] := 0;
         var guildenemy := RadioGump(who, 400, 0, "Escolha qual faccao sera considerada inimiga", guild_opts.keys(), 0, guild_opts.keys().size());
         if (guildenemy["Cancelar"]) return SendSysMessageEx(who, "Cancelado");  endif

         new_law.opt := guild_opts[guildenemy]; */
		elseif (new_law.type["nolawon"] || new_law.type["userban"])
			SendSysMessageEx(who, "Escolha o alvo para aplicar esta lei", SSM_FAIL);
			var targ := Target(who);
			if (!targ)
				return;
			elseif (!targ.isA(POLCLASS_MOBILE) || targ.npctemplate)
				return SendSysMessageEx(who, "Esta lei so pode ser aplicada em jogadores", SSM_FAIL);
			endif
			// ALTEREI AQUI ///
			new_law.opt := targ.name;
		// new_law.opt := struct{ "serial" := targ.serial, "name" := targ.name};
		elseif (new_law.type["nocolor"])
			var color_presets := array{ "Cores Neon/Evento", "Purpura Imperial (1645)", "Inserir manualmente", "Cancelar" };
			var color_choice := RadioGump(who, 300, 0, "Qual grupo de cores sera proibido?", color_presets, 0, color_presets.size());
			if (color_choice["Cancelar"] || !color_choice) return; endif

			var hues := array{};
			var nome_display := "";

			if (color_choice["Inserir manualmente"])
				var raw := GetInput(who, who.backpack, "Insira os hue IDs separados por virgula (ex: 1645,1100,32):");
				if (!raw) return SendSysMessageEx(who, "Cancelado"); endif
				foreach part in SplitWords(raw)
					var h := CInt(part);
					if (h > 0) hues.append(h); endif
				endforeach
				nome_display := GetInput(who, who.backpack, "Nome de exibicao (ex: Cores Neon):");
				if (!nome_display) nome_display := "Cores Proibidas"; endif
			elseif (color_choice["Purpura Imperial"])
				hues := array{ 1645 };
				nome_display := "Purpura Imperial";
			else // Neon
				hues := array{ 32, 33, 34, 35, 36, 37, 38, 39, 40, 1153, 1154, 1161, 1162, 1163, 1164 };
				nome_display := "Cores Neon";
			endif

			if (!hues.size())
				return SendSysMessageEx(who, "Nenhum hue valido informado", SSM_FAIL);
			endif
			new_law.opt := struct{ "hues" := hues, "nome_display" := nome_display };
		elseif (new_law.type["nospellschool"])
			var school_opts := array{ "evocation", "necromancy", "illusion", "swordmage",
									  "priest", "shaman", "druid", "paladin", "demonhunter",
									  "trickster", "shinobi", "bard", "cantrip", "Cancelar" };
			var school_choice := RadioGump(who, 350, 0, "Qual escola de magia sera proibida?", school_opts, 0, school_opts.size());
			if (!school_choice || school_choice == "Cancelar") return SendSysMessageEx(who, "Cancelado"); endif
			new_law.opt := school_choice;
		elseif (new_law.type["nospelllist"])
			var raw_ids := GetInput(who, who.backpack, "Insira os IDs das magias separados por virgula:");
			if (!raw_ids) return SendSysMessageEx(who, "Cancelado"); endif
			var spell_ids := array{};
			foreach part in SplitWords(raw_ids)
				var sid := CInt(part);
				if (sid > 0) spell_ids.append(sid); endif
			endforeach
			if (!spell_ids.size()) return SendSysMessageEx(who, "Nenhum ID valido informado", SSM_FAIL); endif
			new_law.opt := spell_ids;
		elseif (new_law.type["nooutsideron"])
			SendSysMessageEx(who, "Clique no canto superior do retangulo", SSM_FAIL);
			var targ1 := TargetCoordinates(who);

			if (!targ1)
				return;
			endif

			SendSysMessageEx(who, "Clique no canto inferior do retangulo", SSM_FAIL);
			var targ2 := TargetCoordinates(who);

			if (!targ2)
				return;
			endif

			var gname := GetInput(who, who.backpack, "Qual o nome da Area? (aperte esc para cancelar)");
			if (!gname)
				return SendSysMessageEx(who, "Cancelado");
			endif

			new_law.opt.ret := array{ targ1.x, targ1.y, targ2.x, targ2.y, targ1.z };
			new_law.opt.name := gname;
		elseif (new_law.type["merchanttax"])
			var raw_pct := GetInput(who, who.backpack, "Percentual da taxa (ex: 20 = +20% nos precos):");
			if (!raw_pct) return SendSysMessageEx(who, "Cancelado"); endif
			var pct := CInt(raw_pct);
			if (pct <= 0 || pct > 500) return SendSysMessageEx(who, "Valor invalido (1-500)", SSM_FAIL); endif
			new_law.opt := pct;
		elseif (new_law.type["notax_exempt"])
			var raw_toll := GetInput(who, who.backpack, "Valor do pedagio em moedas de cobre:");
			if (!raw_toll) return SendSysMessageEx(who, "Cancelado"); endif
			var toll_val := CInt(raw_toll);
			if (toll_val <= 0) return SendSysMessageEx(who, "Valor invalido", SSM_FAIL); endif
			new_law.opt := toll_val;
		elseif (new_law.type["guildtax"])
			var raw_gpct := GetInput(who, who.backpack, "Percentual extra para rivais (ex: 30 = +30%):");
			if (!raw_gpct) return SendSysMessageEx(who, "Cancelado"); endif
			var gpct := CInt(raw_gpct);
			if (gpct <= 0) return SendSysMessageEx(who, "Valor invalido", SSM_FAIL); endif
			SendSysMessageEx(who, "Insira os IDs de guild das faccoes rivais separados por virgula:", SSM_REQUEST);
			var raw_rivals := GetInput(who, who.backpack, "IDs de guild rivais (separados por virgula):");
			if (!raw_rivals) return SendSysMessageEx(who, "Cancelado"); endif
			var rival_ids := array{};
			foreach part in SplitWords(raw_rivals)
				var rid := CInt(part);
				if (rid > 0) rival_ids.append(rid); endif
			endforeach
			if (!rival_ids.size()) return SendSysMessageEx(who, "Nenhum ID valido", SSM_FAIL); endif
			new_law.opt := struct{ "rivais" := rival_ids, "pct" := gpct };
		elseif (new_law.type["nomusic"])
			var music_horario := YesNo(who, "Restringir a um horario especifico?");
			if (music_horario)
				var raw_hi := GetInput(who, who.backpack, "Hora de inicio (0-23):");
				var raw_hf := GetInput(who, who.backpack, "Hora de fim (0-23):");
				new_law.opt := struct{
					"hora_inicio" := CInt(raw_hi),
					"hora_fim"    := CInt(raw_hf)
				};
			endif
		elseif (new_law.type["toquerecolher"])
			var raw_tr_hi := GetInput(who, who.backpack, "Hora de inicio do recolher (0-23, ex: 22):");
			if (!raw_tr_hi) return SendSysMessageEx(who, "Cancelado"); endif
			var raw_tr_hf := GetInput(who, who.backpack, "Hora de fim do recolher (0-23, ex: 6):");
			if (!raw_tr_hf) return SendSysMessageEx(who, "Cancelado"); endif
			new_law.opt := struct{
				"hora_inicio" := CInt(raw_tr_hi),
				"hora_fim"    := CInt(raw_tr_hf)
			};
		elseif (new_law.type["leimarcia"])
			SendSysMessageEx(who, "Lei marcial ativa: jogadores sem carteira serao detidos.", SSM_INFO);
		endif

		// Selecionar quem esta lei vai afetar
		var _target_opts := array{
			"Fora da faccao (padrao)",
			"Todos (incluindo membros e lider)",
			"Todos exceto o lider",
			"Apenas membros full",
			"Apenas membros honorarios",
			"Exceto membro especifico",
			"Todos menos membros de outra faccao"
		};
		var _target_choice := RadioGump(who, 400, 0, "Quem esta lei vai afetar?", _target_opts, 0,
		  _target_opts.size());
		if (!_target_choice) return SendSysMessageEx(who, "Cancelado"); endif

		case (_target_choice)
			"Todos (incluindo membros e lider)": new_law.target := "todos";            break;
			"Todos exceto o lider":              new_law.target := "nao_lider";         break;
			"Apenas membros full":               new_law.target := "apenas_full";       break;
			"Apenas membros honorarios":         new_law.target := "apenas_honorarios"; break;
			"Exceto membro especifico":
				SendSysMessageEx(who, "Mire no membro que sera isento desta lei", SSM_REQUEST);
				var _exceto_targ := Target(who);
				if (!_exceto_targ || !_exceto_targ.isA(POLCLASS_MOBILE))
					return SendSysMessageEx(who, "Cancelado");
				endif
				new_law.exceto_serials := array{ _exceto_targ.serial };
				new_law.target := "nao_membro_x";
				break;
			"Todos menos membros de outra faccao":
				// Listar todas as faccoes (exceto a propria)
				var _efac_guilds := array{};  // guildids
				var _efac_names  := array{};  // nomes para exibir
				foreach _g in ListGuilds()
					sleepms(2);
					if (_g.guildid == guild.guildid) continue; endif
					var _gn := _g.getProp("name");
					if (!_gn || _gn == error) _gn := "Faccao #{}".format(_g.guildid); endif
					_efac_guilds.append(_g.guildid);
					_efac_names.append(cstr(_gn));
				endforeach

				if (!_efac_guilds.size())
					SendSysMessageEx(who, "Nenhuma outra faccao encontrada.", SSM_FAIL);
					return;
				endif

				var _sel := SelectionGump(who,
					"Selecione as faccoes isentas (pode marcar multiplas)",
					_efac_names, BTN_TYPE_CHECKBOX);

				if (_sel == error || !_sel || !_sel.size())
					return SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
				endif

				// Mapear nomes selecionados → guild IDs
				var _exceto_guilds := array{};
				foreach _sname in _sel
					sleepms(2);
					var _idx := 1;
					foreach _n in _efac_names
						sleepms(2);
						if (cstr(_n) == cstr(_sname))
							_exceto_guilds.append(_efac_guilds[_idx]);
							break;
						endif
						_idx := _idx + 1;
					endforeach
				endforeach

				if (!_exceto_guilds.size())
					return SendSysMessageEx(who, "Nenhuma faccao selecionada.", SSM_FAIL);
				endif

				new_law.exceto_guilds := _exceto_guilds;
				new_law.target := "exceto_faccoes";

				// Debug: mostrar o que foi configurado
				syslog("[LEI-TARGET] exceto_faccoes configurado: lei={} exceto_guilds={}".format(
					new_law.type, _exceto_guilds));
				var _names_str := "";
				foreach _eid in _exceto_guilds
					sleepms(2);
					var _eg := FindGuild(CInt(_eid));
					var _en := _eg ? cstr(_eg.getProp("name")) : "?";
					_names_str := _names_str + "[{}:{}] ".format(_eid, _en);
				endforeach
				SendSysMessageEx(who, "Faccoes isentas: {}".format(_names_str), SSM_INFO);
				break;
			// "Fora da faccao" = padrao — nao precisa setar target
		endcase

		if (AddLaw(guild, new_law))
			SendSysMessageEx(who, "Lei adicionada", SSM_INFO);
			ResetAllNpcs();
		else
			SendSysMessageEx(who, "Voce nao pode adicionar esta lei de novo", SSM_FAIL);
		endif
	else
		input -= BUTTON_CHANGE_LAW;
		var law_opts := array{ "Remover", "Cancelar" };
		var output := RadioGump(who, 250, 0, "O que deseja fazer?", law_opts, 0, law_opts.size());
		if (output["Remover"])
			var laws := guild.getProp("laws");
			laws.Erase(input);
			guild.SetProp("laws", laws);
			ResetAllNpcs();
		endif
	endif
endfunction

function ResetAllNpcs()
	var npcs := guild.getProp("npcs_active");
	foreach npc in npcs
		npc := SystemFindObjectBySerial(npc.serial);
		SendEvent(npc, struct{ "type" := 0x78457 });
		sleepms(2);
	endforeach
endfunction

function territoryHandler(who, input)
	input := input - BUTTON_TERRITORY;
	var territories := guild.GetProp("territories");

	// Check if the index is valid
	if (input < 0 || input >= territories.size())
		return SendSysMessageEx(who, "Índice de território inválido.", SSM_FAIL);
	endif

	var territory := territories[input];

	var rect_df := OpenDataFile(":architect:areas");
	if (!rect_df)
		return SendSysMessageEx(who, "O sistema de territórios está indisponível no momento.",
								 SSM_FAIL);
	endif

	var elem := rect_df.FindElement(territory);

	if (!elem)
		// If the territory doesn't exist, remove it from the faction's list
		territories.Erase(input);
		guild.SetProp("territories", territories);
		return SendSysMessageEx(who, "Este território não existe mais e foi removido da lista.",
								 SSM_FAIL);
	endif

	// Verifying that the territory still belongs to this faction
	if (elem.GetProp("Faction") != guild_obj.name)
		territories.Erase(input);
		guild.SetProp("territories", territories);
		return SendSysMessageEx(who, "Este território não pertence mais à sua facção e foi removido da lista.",
								 SSM_FAIL);
	endif

	var options := array{ "Ver Detalhes", "Ir para Território", "Abandonar Território", "Cancelar" };
	var output := RadioGump(who, 300, 0, "Escolha uma opção", options, 0, 1);

	if (output["Ver"])
		// Show territory details
		var detail_gump := GFCreateGump(0, 0, 350, 300);
		GFResizePic(detail_gump, 0, 0, 9200, 350, 300);
		GFResizePic(detail_gump, 15, 15, 9350, 320, 270);

		var y := 30;
		GFTextMid(detail_gump, 175, y, 320, 2100, "Território: " + territory);
		y += 30;

		var rect := elem.GetProp("Rect");
		var realm := elem.GetProp("Realm");

		GFTextLine(detail_gump, 30, y, 2100, "Coordenadas:");
		GFTextLine(detail_gump, 130, y, 1153, rect);
		y += 20;

		GFTextLine(detail_gump, 30, y, 2100, "Realm:");
		GFTextLine(detail_gump, 130, y, 1153, realm);
		y += 20;

		GFTextLine(detail_gump, 30, y, 2100, "Facção:");
		GFTextLine(detail_gump, 130, y, 1153, elem.GetProp("Faction"));

		GFAddButton(detail_gump, 150, 250, 2128, 2129, GF_CLOSE_BTN, 0);

		GFSendGump(who, detail_gump);

	elseif (output["Ir"])
		// Teleport to center of territory
		var realm := elem.GetProp("Realm");
		var rect := ParseRect(elem.GetProp("Rect"));
		if (rect)
			var center_x := CInt((rect.x1 + rect.x2) / 2);
			var center_y := CInt((rect.y1 + rect.y2) / 2);
			var center_z := GetWorldHeight(center_x, center_y, realm);
			MoveObjectToLocation(who, center_x, center_y, center_z, realm, MOVEOBJECT_FORCELOCATION);
			SendSysMessageEx(who, "Teleportado para o centro do território!", SSM_INFO);
		else
			SendSysMessageEx(who, "Erro ao analisar as coordenadas do território!", SSM_FAIL);
		endif

	elseif (output["Abandonar"])
		if (is_gm_or_leader)
			if (YesNo(who, "Tem certeza que deseja abandonar o território '" + territory + "'?"))
				elem.SetProp("Faction", "Selvagem");
				territories.Erase(input);
				guild.SetProp("territories", territories);
				SendSysMessageEx(who, "Território abandonado com sucesso!", SSM_INFO);

				// Remove monument if exists
				var rect := ParseRect(elem.GetProp("Rect"));
				if (rect)
					var center_x := CInt((rect.x1 + rect.x2) / 2);
					var center_y := CInt((rect.y1 + rect.y2) / 2);
					var center_z := GetWorldHeight(center_x, center_y, elem.GetProp("Realm"));

					foreach item in ListItemsNearLocation(center_x, center_y, center_z, 3, elem.GetProp("Realm"))
						if (item.objtype == 0x46AE && GetObjProperty(item, "RectName") == territory)
							DestroyItem(item);
							break;
						endif
					endforeach
				endif
			endif
		else
			SendSysMessageEx(who, "Apenas o líder pode abandonar territórios.", SSM_FAIL);
		endif
	endif
endfunction

// Adicionar esta função no arquivo faccao.src após as outras funções

function ShowTerritoriesGump(who, guild)
	// Criar um gump dedicado para listar os territórios controlados pela facção
	var territories_gump_width := 350;
	var territories_gump_height := 450;
	var gump := GFCreateGump();

	GFResizePic(gump, 0, 0, 39925, territories_gump_width, territories_gump_height);
	GFResizePic(gump, 15, 15, 9350, territories_gump_width - 30, 30);
	GFTextMid(gump, territories_gump_width / 2, 20, territories_gump_width - 30, 1153,
		   "Territórios Controlados");

	var y := 55;
	var i := 0;
	var valid_territories := array{};

	// Buscar territórios da facção
	var territories := guild.GetProp("territories");
	if (!territories)
		territories := array{};
		guild.SetProp("territories", territories);
	endif

	var rect_df := OpenDataFile(":architect:areas");
	if (rect_df)
		foreach territory in territories
			var rect_elem := rect_df.FindElement(territory);

			if (rect_elem && rect_elem.GetProp("Faction") == guild_obj.name)
				valid_territories.append(territory);
			endif
			sleepms(2);
		endforeach

		// Update the faction's territory list if inconsistencies were found
		if (valid_territories.size() != territories.size())
			guild.SetProp("territories", valid_territories);
			territories := valid_territories;
		endif
	endif

	if (territories.size() == 0)
		GFTextMid(gump, territories_gump_width / 2, 100, territories_gump_width - 40, 38,
				   "Esta facção não controla nenhum território.");
	else
		GFResizePic(gump, 15, y, 9350, territories_gump_width - 30, territories_gump_height - 70);
		y += 10;

		foreach territory in territories
			GFTextLine(gump, 30, y, 1153, territory);
			GFAddButton(gump, 20, y + 2, 2117, 2118, GF_CLOSE_BTN, BUTTON_TERRITORY + i);
			y += 25;
			i += 1;
			sleepms(2);
		endforeach
	endif

	// Botão para fechar
	GFAddButton(gump, territories_gump_width / 2 - 15, territories_gump_height - 40, 2130, 2131,
				 GF_CLOSE_BTN, 0);

	var input := GFSendGump(who, gump);

	if (input[0] >= BUTTON_TERRITORY && input[0] <= BUTTON_TERRITORY + 50)
		territoryHandler(who, input[0]);
	endif

	// Retornar ao gump principal da facção
	start_script(":faccao:faccao", array{ who, guild.guildid, "guild" });
endfunction

// Retorna o nome personalizado do membro (definido na inscrição) ou o nome real como fallback.
// use_alias := 1 para mostrar o nome da inscrição (mural), 0 para mostrar mob.name normal.
// use_alias := 2 (GM): mesmo nome de inscrição + [conta] para identificação.
function GetMemberDisplayName(mob, use_alias := 0)
	if (!mob) return ""; endif
	if (use_alias == 2)
		// GM: nome de inscrição [conta]
		var dados := GetObjProperty(mob, "dados_convite");
		var nome;
		if (!dados || dados.errortext)
			nome := mob.name;
		else
			nome := dados.nome_personalizado;
			if (!nome || nome.errortext) nome := mob.name; endif
		endif
		var acct := mob.acctname;
		if (acct && !acct.errortext) return nome + " [" + acct + "]"; endif
		return nome;
	elseif (use_alias == 1)
		// Player: nome da Mesa de Inscrição ou fallback para raça
		var dados := GetObjProperty(mob, "dados_convite");
		if (!dados || dados.errortext) return mob.name; endif
		var nome_rp := dados.nome_personalizado;
		if (!nome_rp || nome_rp.errortext) return mob.name; endif
		return nome_rp;
	endif
	return mob.name;
endfunction
