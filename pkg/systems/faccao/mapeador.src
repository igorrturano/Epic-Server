include ":faccao:include/permissions"; // <-- ADICIONADO para IsGuildLeader

// Configurar nível de logging para debug detalhado do mapeador
function InitMapeadorLogging()
    SetCategoryLogLevel("mapeador", LOG_DEBUG);
    LogInfo("mapeador", "Sistema de logging do Mapeador inicializado com nível DEBUG");
endfunction

program mapeador_use(who, item)
    item := item; // Suprime o warning de variável não usada
    
    if (typeof(who) == "Array" && who.size() >= 3 && who[1] == "remove_borders")
        return RemoveBordersTimer(who[2], who[3]);
    endif
    
    InitMapeadorLogging();
    
    LogInfo("mapeador", "Jogador " + who.name + " (" + who.serial + ") tentando usar Mapeador");
    
    // ==========================================================
    // >>>>> MUDANÇA APLICADA AQUI <<<<<
    // ==========================================================
    // Verificar se tem permissão (GM, Líder ou Arquiteto)
    if (!CanUseMapeador(who))
        SendSysMessage(who, "Apenas GMs, Líderes ou Arquitetos de facção podem usar o Mapeador.", 3, 38);
        LogWarning("mapeador", "Acesso negado para " + who.name + " - sem permissão.");
        return 0;
    endif

    SendSysMessage(who, "Ativando o Mapeador de Território...", 3, 66);
    LogInfo("mapeador", "Usuário autorizado '" + who.name + "' ativando Mapeador.");
    
    // Criar bordas visuais nos territórios da facção
    if (CreateTerritoryBorders(who))
        LogInfo("mapeador", "Bordas territoriais ativadas com sucesso para " + who.name);
    else
        SendSysMessage(who, "Nenhum território encontrado para sua facção.", 3, 38);
        LogWarning("mapeador", "Nenhum território encontrado para " + who.name);
    endif
    
    return 1;
endprogram

// ==========================================================
// >>>>> FUNÇÃO DE PERMISSÃO MODIFICADA E RENOMEADA <<<<<
// ==========================================================
function CanUseMapeador(who)
    // 1. GMs sempre podem usar.
    if (who.cmdlevel >= 1)
        LogDebug("mapeador", "Permissão concedida a " + who.name + " (Motivo: GM)");
        return 1;
    endif

    // O jogador precisa estar em uma guilda para as próximas verificações
    if (!who.guild)
        return 0;
    endif

    // 2. Líderes de facção podem usar.
    if (IsGuildLeader(who))
        LogDebug("mapeador", "Permissão concedida a " + who.name + " (Motivo: Líder da Facção)");
        return 1;
    endif

    // 3. Arquitetos podem usar (usando a função do sistema de arquitetura).
    if (VerifyArchitect(who))
        LogDebug("mapeador", "Permissão concedida a " + who.name + " (Motivo: Arquiteto)");
        return 1;
    endif
    
    // Se nenhuma das condições acima for atendida, nega o acesso.
    return 0;
endfunction
// ==========================================================


// O resto das funções permanece o mesmo

function CreateTerritoryBorders(who)
    var player_faction := GetPlayerFaction(who);
    LogDebug("mapeador", "Facção do jogador " + who.name + ": " + player_faction);
    if (!player_faction)
        LogError("mapeador", "Facção não encontrada para jogador " + who.name);
        return 0;
    endif

    var guild := who.guild;
    if (!guild)
        LogError("mapeador", "Objeto de guilda não encontrado para " + who.name);
        return 0;
    endif
    var xp_info := GetGuildXPInfo(guild);
    var current_level := xp_info.current_level;
    if (current_level < 1) current_level := 1; endif

    SendSysMessage(who, "Exibindo bordas para o Nível " + current_level + " do seu reino.", 3, 53);
    LogInfo("mapeador", "Exibindo bordas para o Nível " + current_level + " da facção '" + player_faction + "'");

    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        LogError("mapeador", "Erro ao acessar datafile :architect:areas");
        return 0;
    endif
    
    var territories_found := 0;
    var total_border_items := 0;
    
    foreach territory_name in (rect_df.keys())
        var elem := SafeFindElement(rect_df, territory_name);
        if (!elem) continue; endif
        
        var territory_faction := GetTerritoryFaction(elem);
        if (territory_faction != player_faction) continue; endif
        
        var rect_str := "";
        var realm := GetElementProp(elem, "Realm", who.realm);
        
        var is_expandable := GetElementProp(elem, "IsExpandable", 0);
        
        if (is_expandable)
            LogDebug("mapeador", "Território '" + territory_name + "' é EXPANSÍVEL. Recalculando bordas para Nível " + current_level);
            var max_rect_str := GetElementProp(elem, "MaxRect");
            if (max_rect_str)
                var max_coords := SplitWords(max_rect_str);
                var center_x := CInt((CInt(max_coords[1]) + CInt(max_coords[3])) / 2);
                var center_y := CInt((CInt(max_coords[2]) + CInt(max_coords[4])) / 2);

                var current_dims := GetDimensionsForLevel(current_level);
                if (current_dims)
                    var current_width := current_dims[1];
                    var current_height := current_dims[2];

                    var new_x1 := center_x - CInt(current_width / 2);
                    var new_y1 := center_y - CInt(current_height / 2);
                    var new_x2 := new_x1 + current_width;
                    var new_y2 := new_y1 + current_height;
                    
                    rect_str := new_x1 + " " + new_y1 + " " + new_x2 + " " + new_y2;
                    LogDebug("mapeador", "--> Novas coordenadas: " + rect_str);
                endif
            endif
        else
            LogDebug("mapeador", "Território '" + territory_name + "' é CUSTOMIZADO. Usando bordas salvas.");
            rect_str := GetElementProp(elem, "Rect", "");
        endif
        
        if (!rect_str)
            LogWarning("mapeador", "Coordenadas não puderam ser determinadas para o território: " + territory_name);
            continue;
        endif
        
        var coords := SplitWords(rect_str);
        if (coords.size() < 4) continue; endif
        
        var x1 := CInt(coords[1]);
        var y1 := CInt(coords[2]);
        var x2 := CInt(coords[3]);
        var y2 := CInt(coords[4]);
        
        LogInfo("mapeador", "Criando bordas para " + territory_name + ": (" + x1 + "," + y1 + ") até (" + x2 + "," + y2 + ")");
        
        var border_count := CreateBorderForRectangle(who, x1, y1, x2, y2, realm);
        total_border_items += border_count;
        territories_found++;
    endforeach
    
    if (territories_found > 0)
        SendSysMessage(who, "Territórios mapeados: " + territories_found + " (" + total_border_items + " marcadores)", 3, 1153);
    endif
    
    return territories_found;
endfunction

function CreateBorderForRectangle(who, x1, y1, x2, y2, realm)
    var border_items := array{};
    var items_created := 0;
    var failed_items := 0;
    var x, y, border_item;
      LogDebug("mapeador", "Iniciando criação de bordas para retângulo (" + x1 + "," + y1 + ") até (" + x2 + "," + y2 + ") realm " + realm);
    
    var tile_step := 1;
    for (x := x1; x <= x2; x := x + tile_step)
        border_item := CreateBorderItem(x, y1, realm, who, BORDER_ITEM_TRANSVERSAL);
        if (border_item)
            border_items.append(border_item);
            items_created++;
        else
            failed_items++;
        endif
    endfor
    for (x := x1; x <= x2; x := x + tile_step)
        border_item := CreateBorderItem(x, y2, realm, who, BORDER_ITEM_TRANSVERSAL);
        if (border_item)
            border_items.append(border_item);
            items_created++;
        else
            failed_items++;
        endif
    endfor
    
    for (y := y1 + tile_step; y < y2; y := y + tile_step)
        border_item := CreateBorderItem(x1, y, realm, who, BORDER_ITEM_LATERAL);
        if (border_item)
            border_items.append(border_item);
            items_created++;
        else
            failed_items++;
        endif
    endfor
    
    for (y := y1 + tile_step; y < y2; y := y + tile_step)
        border_item := CreateBorderItem(x2, y, realm, who, BORDER_ITEM_LATERAL);
        if (border_item)
            border_items.append(border_item);
            items_created++;
        else
            failed_items++;
        endif
    endfor
    
    LogInfo("mapeador", "Bordas criadas: " + items_created + " sucessos, " + failed_items + " falhas");
    if (border_items.size() > 0)
        start_script(":faccao:mapeador", {"remove_borders", border_items, BORDER_DURATION});
        LogDebug("mapeador", "Remoção automática agendada para " + border_items.size() + " itens em " + BORDER_DURATION + " segundos");
    endif
    
    return items_created;
endfunction

function CreateBorderItem(x, y, realm, who, item_type)
    var player_z := who.z;
    var terrain_z := GetWorldHeight(x, y, realm);
    
    var z_values := array{ terrain_z, player_z, terrain_z + 1, player_z + 1, terrain_z - 1, 0 };
    
    foreach z_val in z_values
        var border_item := CreateItemAtLocation(x, y, z_val, item_type, 1, realm);
        if (border_item)
            border_item.movable := 0;
            border_item.name := "Marcador Territorial";
            border_item.SetProp("MapeadorBorder", 1);
            border_item.SetProp("CreatedBy", who.serial);
            border_item.SetProp("CreatedTime", polcore().systime);
            
            return border_item;
        endif
    endforeach
    
    return 0;
endfunction

function RemoveBordersTimer(border_items, duration)
    sleep(duration);
    
    var removed_count := 0;
    var failed_count := 0;
    
    foreach item in border_items
        if (item && item.serial && item.GetProp("MapeadorBorder"))
            if (DestroyItem(item))
                removed_count++;
            else
                failed_count++;
            endif
        endif
    endforeach
    
    if (removed_count > 0)
        LogInfo("mapeador", "Remoção automática: " + removed_count + " marcadores removidos, " + failed_count + " falhas");
    endif
    
    return 1;
endfunction