use uo;
use os;
use guilds;
use datafile;
use polsys;
use util;

// Includes essenciais
include ":faccao:include/process_registry";
include ":faccao:include/shared_functions";
include ":faccao:include/logging";
include ":faccao:include/guild_xp";
include ":faccao:include/safe_guild_utils";
include ":faccao:include/datafile_helpers";
include ":faccao:include/faccao_constants";

// Constantes locais
const MOEDAS_COBRE := 0xBA63;

program ReinoUpkeepControl()

    LogInfo("upkeep_ctrl", "=== Controlador de Upkeep tentando iniciar (PID: " + GetPid() + ") ===");

    // Garante que apenas uma instância deste script rode por vez.
    if (!RegisterProcess("ReinoUpkeepControl"))
        LogWarning("upkeep_ctrl", "Outra instância de ReinoUpkeepControl já está ativa. Este processo (PID: " + GetPid() + ") será encerrado.");
        return 0;
    endif

    LogInfo("upkeep_ctrl", "Registro bem-sucedido. Este processo é agora o controlador oficial de upkeep.");
    
    while(1)
        UpdateProcessHeartbeat("ReinoUpkeepControl");
        
        LogDebug("upkeep_ctrl", "Iniciando ciclo de verificação de upkeep...");
        ProcessarUpkeepSimples();
        
        LogDebug("upkeep_ctrl", "Ciclo de upkeep concluído, aguardando " + UPKEEP_CYCLE_WAIT + " segundos...");
        sleep(UPKEEP_CYCLE_WAIT);
    endwhile
endprogram

function ProcessarUpkeepSimples()

    LogDebug("upkeep", "UPKEEP: *** CICLO INICIADO *** " + FormatTime(POLCore().systime, "%m/%d %H:%M:%S"));
    syslog("UPKEEP: *** CICLO INICIADO *** " + FormatTime(POLCore().systime, "%m/%d %H:%M:%S"));
    
    // Coletar nomes de facções ativas a partir dos territórios.
    var active_guilds := struct{};
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (rect_df)
        foreach elem_name in (rect_df.keys())
            var elem := SafeFindElement(rect_df, elem_name);
            if (elem)
                var territory_faction := GetTerritoryFaction(elem);
                if (territory_faction && territory_faction != "" && territory_faction != DEFAULT_FACTION)
                    active_guilds[territory_faction] := 1;
                endif
            endif
            sleepms(1);
        endforeach
    endif
    
    // CORREÇÃO FINAL: Obter a lista de nomes de guildas UMA ÚNICA VEZ.
    var guild_names := active_guilds.keys();
    
    Print("UPKEEP: Total de guildas com territórios encontradas: " + guild_names.size());
    syslog("UPKEEP: Total de guildas com territórios encontradas: " + guild_names.size());
    
    var processed_count := 0;
    var payment_attempts := 0;
    var successful_payments := 0;
    
    foreach guild_name in guild_names
        Print("UPKEEP: === Processando facção: " + guild_name + " ===");
        
        if (!guild_name || guild_name == KINGDOM_FACTION || guild_name == "Unknown Guild")
            Print("UPKEEP: Facção " + guild_name + " pulada (nome inválido ou Reino)");
            continue;
        endif
        
        processed_count += 1;
        
        var guild_id := FindGuildByName(guild_name);
        if (!guild_id)
            Print("UPKEEP: Guilda '" + guild_name + "' não encontrada. Pulando.");
            continue;
        endif

        var guild := FindGuild(guild_id);
        if (!guild)
             Print("UPKEEP: Objeto da guilda '" + guild_name + "' não encontrado. Pulando.");
             continue;
        endif

        var territories := GetGuildTerritories(guild_name);
        var cost := CalcularCustoUpkeep(guild, territories);
        Print("UPKEEP: " + guild_name + " - Territórios: " + territories.size() + ", Nível: " + GetSimpleGuildLevel(guild) + ", Custo: " + cost);
        
        if (cost <= 0)
            Print("UPKEEP: " + guild_name + " não possui territórios ou custo é zero");
            continue;
        endif
        
        payment_attempts += 1;
        Print("UPKEEP: " + guild_name + " deve pagar " + cost + " moedas");
        
        if (CobrarUpkeepRobusto(guild_name, cost))
            Print("UPKEEP: " + guild_name + " pagou com sucesso");
            successful_payments += 1;
        else
            Print("UPKEEP: " + guild_name + " falhou no pagamento - recursos insuficientes ou baú não encontrado");
        endif
        
        sleepms(100);
    endforeach
    
    Print("UPKEEP: Ciclo concluído - Guildas processadas: " + processed_count + ", Tentativas de pagamento: " + payment_attempts + ", Pagamentos bem-sucedidos: " + successful_payments);
endfunction


function GetGuildTerritories(faction_name)
    var territories := array{};
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        return territories;
    endif
    
    foreach rect_name in (rect_df.keys())
        var elem := SafeFindElement(rect_df, rect_name);
        if (elem)
            var territory_faction := GetTerritoryFaction(elem);
            if (territory_faction == faction_name)
                var territory_info := struct{};
                territory_info.+name := rect_name;
                territory_info.+rect := GetElementProp(elem, "Rect", "");
                territory_info.+realm := GetElementProp(elem, "Realm", "britannia");
                territories.append(territory_info);
            endif
        endif
        sleepms(2);
    endforeach
    
    return territories;
endfunction


function CobrarUpkeepRobusto(guild_name, cost_amount)
    LogCritical("UpkeepPayment_START_v2", "Iniciando cobrança (v2) de " + cost_amount + " moedas para facção " + guild_name);

    var faction_chest := 0;
    var capital_territory_id := "";
    var capital_territory_name := "";
    var territories_found := GetGuildTerritories(guild_name);

    LogInfo("UpkeepPayment_SEARCH_v2", "Encontrados " + territories_found.size() + " territórios para " + guild_name + ". Procurando a capital...");

    // ====================================================================
    // == INÍCIO DA MODIFICAÇÃO: LÓGICA PARA ENCONTRAR A CAPITAL ==
    // ====================================================================

    // 1. Iterar pelos territórios para encontrar a capital designada.
    foreach territory_info in territories_found
        var current_territory_id := territory_info.id ?: territory_info.name;
        if (TM_IsTerritoryCapital(current_territory_id))
            capital_territory_id := current_territory_id;
            capital_territory_name := territory_info.name;
            LogInfo("UpkeepPayment_CAPITAL_FOUND_v2", "✓ Capital da facção '" + guild_name + "' encontrada: '" + capital_territory_name + "' (ID: " + capital_territory_id + ")");
            break; // Encontrou a capital, pode parar de procurar.
        endif
        SleepMS(1);
    endforeach

    // 2. Se nenhuma capital foi encontrada, o pagamento não pode prosseguir de forma previsível.
    if (!capital_territory_id)
        LogError("UpkeepPayment_ERROR_v2", "NENHUMA CAPITAL designada para a facção '" + guild_name + "'. Cobrança de upkeep abortada.");
        // Opcional: Notificar o líder da facção sobre a necessidade de designar uma capital.
        return 0; // Falha no pagamento.
    endif

    // 3. Buscar o baú EXCLUSIVAMENTE no território da capital.
    LogInfo("UpkeepPayment_CHEST_SEARCH_v2", "Buscando baú na capital '" + capital_territory_name + "' (ID: " + capital_territory_id + ")");
    faction_chest := FindFactionChest(guild_name, capital_territory_id);

    // ====================================================================
    // == FIM DA MODIFICAÇÃO ==
    // ====================================================================

    if (!faction_chest)
        LogError("UpkeepPayment_ERROR_v2", "Baú da capital '" + capital_territory_name + "' não encontrado. Pagamento falhou para a facção " + guild_name);
        // Opcional: Notificar o líder sobre o baú ausente na capital.
        return 0;
    endif
    
    LogInfo("UpkeepPayment_CHEST_v2", "Baú alvo para cobrança (Capital): Serial " + faction_chest.serial);

    // O resto da função (lógica de lock, contagem e débito) permanece EXATAMENTE O MESMO.
    // Ela agora operará sobre o 'faction_chest' que garantimos ser o da capital.

    var lock_prop := "operation_lock"; 
    var lock_timeout := 30;
    var current_time_lock := POLCore().systime;

    var existing_lock := GetObjProperty(faction_chest, lock_prop);
    if (existing_lock)
        var lock_age := current_time_lock - CInt(existing_lock.timestamp);
        if (lock_age < lock_timeout)
            LogWarning("upkeep", "Baú da capital " + faction_chest.serial + " está bloqueado por outra operação. Cobrança adiada.");
            return 0;
        else
            LogWarning("upkeep", "Lock expirado encontrado no baú da capital. Limpando e prosseguindo...");
            EraseObjProperty(faction_chest, lock_prop);
        endif
    endif

    var lock_data := struct{};
    lock_data.+operation := "upkeep_payment";
    lock_data.+pid := GetPid();
    lock_data.+timestamp := current_time_lock;
    SetObjProperty(faction_chest, lock_prop, lock_data);
    LogDebug("upkeep", "Lock adquirido no baú da capital " + faction_chest.serial + " para cobrança de upkeep.");

    var payment_success := 0;
    var error_occurred := 0;

    if (!faction_chest.isA(POLCLASS_CONTAINER) || !faction_chest.serial || faction_chest.serial <= 0)
        LogError("UpkeepPayment_ERROR", "Baú inválido para facção " + guild_name);
        error_occurred := 1;
    else
        var items_in_chest := EnumerateItemsInContainer(faction_chest);
        if (items_in_chest == error)
             LogError("UpkeepPayment_ERROR", "Falha ao enumerar itens no baú " + faction_chest.serial);
             error_occurred := 1;
        else
            var coins_available := 0;
            var coin_items_list := array{};
            foreach item in items_in_chest
                if (item && item.objtype == MOEDAS_COBRE)
                    coins_available += CInt(item.amount);
                    coin_items_list.append(item);
                endif
                sleepms(1);
            endforeach
            
            LogCritical("UpkeepPayment_TOTAL", "Total de moedas disponíveis: " + coins_available + ", Necessário: " + cost_amount);

            if (coins_available < cost_amount)
                LogWarning("UpkeepPayment_INSUFFICIENT", "Fundos insuficientes. Disponível: " + coins_available + ", Necessário: " + cost_amount);
            else
                var coins_debited := 0;
                var coins_remaining := cost_amount;
                
                foreach coin_item in coin_items_list
                    if (coins_remaining <= 0) break; endif
                    
                    var amount_to_take := (CInt(coin_item.amount) > coins_remaining) ? coins_remaining : CInt(coin_item.amount);
                    
                    if (SubtractAmount(coin_item, amount_to_take))
                        coins_debited += amount_to_take;
                        coins_remaining -= amount_to_take;
                        LogInfo("UpkeepPayment_DEBIT", amount_to_take + " moedas debitadas do stack " + (coin_item.serial ? coin_item.serial : "novo"));
                    else
                        LogError("UpkeepPayment_ERROR", "Falha ao debitar " + amount_to_take + " moedas do stack " + (coin_item.serial ? coin_item.serial : "inválido"));
                        error_occurred := 1;
                        break;
                    endif
                    sleepms(5);
                endforeach

                if (!error_occurred && coins_debited >= cost_amount)
                    payment_success := 1;
                    SetObjProperty(faction_chest, "recursos_cache_dirty", 1);
                    LogInfo("UpkeepPayment_SUCCESS", "Pagamento de upkeep bem-sucedido para " + guild_name);
                elseif (!error_occurred)
                    LogError("UpkeepPayment_FAILED", "Pagamento incompleto. Debitado: " + coins_debited + ", Necessário: " + cost_amount);
                endif
            endif
        endif
    endif
    
 EraseObjProperty(faction_chest, lock_prop);
    LogDebug("upkeep", "Lock liberado no baú da capital " + faction_chest.serial + ". Sucesso: " + payment_success);
    
    return payment_success;
endfunction