// CONTROLADOR.SRC - Versão final com a ordem das funções e sintaxe if/endif corretas.
use uo;
use os;
use polsys;

include ":faccao:spawndecampeao/include/altar";
include ":faccao:spawndecampeao/include/waves";
include ":faccao:spawndecampeao/include/arena";
include ":faccao:include/logging";

program ChampionController(altar)
    // Lógica de trava com PID (Mutex) para impedir duplicação
    var lock_name := "ChampSpawn.Lock." + altar.serial;
    var existing_pid := GetGlobalProperty(lock_name);
    if (existing_pid)
        var process := GetProcess(CInt(existing_pid));
        if (process)
            LogCritical("ChampSpawn", "DUPLICAÇÃO ABORTADA: O processo " + existing_pid + " já está controlando o altar " + altar.serial);
            return;
        else
            EraseGlobalProperty(lock_name);
            LogWarning("ChampSpawn", "Trava global 'stale' removida para o altar " + altar.serial);
        endif
    endif
    var my_pid := GetPid();
    SetGlobalProperty(lock_name, my_pid);
    LogCritical("ChampSpawn", "TRAVA ADQUIRIDA: Processo " + my_pid + " assumiu o controle do altar " + altar.serial);

    // Validação da configuração do altar
    var spawn_cfg := GetObjProperty(altar, "ChampionConfig");
    if (!spawn_cfg)
        LogError("ChampSpawn", "Altar " + altar.serial + " não tem CProp 'ChampionConfig'.");
        return;
    endif
    
    LogCritical("ChampSpawn", "*** CONTROLADOR VALIDADO PARA O EVENTO: '" + spawn_cfg.name + "' ***");
    
    // Limpeza de estado órfão em caso de reinicialização do servidor
    if (CInt(GetObjProperty(altar, "#active")))
        LogWarning("ChampSpawn", "Altar " + altar.serial + " estava ativo antes da reinicialização. Limpando estado órfão.");
        CleanupOrphanedItems(altar);
        EraseObjProperty(altar, "#active");
        EraseObjProperty(altar, "#completed");
    endif
    
    // Raio para detecção de jogadores
    var player_radius := spawn_cfg.player_radius ? spawn_cfg.player_radius : 60;
    if (player_radius < 50)
        player_radius := 60;
    endif
    
    // Loop principal MODIFICADO
    while (altar)
        // Lógica para iniciar um novo evento (continua a mesma)
        if (!CInt(GetObjProperty(altar, "#active")))
            var next_activation := GetObjProperty(altar, "#NextActivation");
            if (!next_activation || ReadGameClock() >= CInt(next_activation))
                if (CountPlayers(altar, player_radius) > 0)
                    StartEvent(altar, spawn_cfg);
                endif
            endif
        endif
        
        // ==========================================================
        // >>>>> INÍCIO DA CORREÇÃO FINAL <<<<<
        // ==========================================================

        // Em vez de esperar por um evento, verificamos a propriedade "bandeira".
        if (GetObjProperty(altar, "BossHasDied"))
            LogCritical("Controller", "Bandeira 'BossHasDied' detectada no altar. Iniciando limpeza final.");
            EraseObjProperty(altar, "BossHasDied"); // Limpa a bandeira
            FinalCleanup(altar, spawn_cfg, "completed");
            return; // Encerra o script do controlador
        endif

        // ==========================================================
        // >>>>> FIM DA CORREÇÃO FINAL <<<<<
        // ==========================================================
        
        sleep(5); // Verifica a bandeira a cada 5 segundos
    endwhile
endprogram




function StartEvent(altar, spawn_cfg)
    LogCritical("StartEvent", "==========================================================");
    LogCritical("StartEvent", "FUNÇÃO START EVENT INICIADA PARA O ALTAR " + altar.serial);
    
    // PARTE 1: RESTAURAÇÃO DE ESTADO (se o servidor reiniciou no meio do evento)
    var boss_serial_on_restart := GetObjProperty(altar, "champ_serial");
    if (boss_serial_on_restart)
        var boss_on_restart := SystemFindObjectBySerial(CInt(boss_serial_on_restart));
        if (boss_on_restart && !boss_on_restart.dead)
            LogCritical("StartEvent", "RECONEXÃO: Boss " + boss_serial_on_restart + " já existe. O sistema de DeathScript irá lidar com a morte dele.");
            // Não precisamos mais do MonitorBoss, então apenas deixamos o evento continuar
        else
            EraseObjProperty(altar, "champ_serial");
        endif
    endif

    ActivateAltar(altar);
    
    var total_waves := spawn_cfg.waves.size();
    if (total_waves < 1)
        LogError("StartEvent", "Configuração de ondas inválida (tamanho < 1).");
        FinalCleanup(altar, spawn_cfg, "failed_config");
        return;
    endif
    
    var last_completed_wave := RestoreChampionState(altar);
    var starting_wave := last_completed_wave + 1; 

    if (last_completed_wave > 0)
        LogInfo("ChampSpawn", "Progresso restaurado. " + last_completed_wave + " ondas completas. Iniciando na Onda " + starting_wave);
    else
        LogInfo("ChampSpawn", "Iniciando evento do zero na Onda " + starting_wave);
    endif
    
    // PARTE 2: EXECUÇÃO DAS ONDAS
    if (starting_wave <= total_waves)
        for wave_level := starting_wave to total_waves
            LogCritical("ChampSpawn", "=== INICIANDO ONDA " + wave_level + " ===");
            SetObjProperty(altar, "#current_level", wave_level);
            var wave_info := spawn_cfg.waves[wave_level];
            var mobs_to_kill := wave_info.amount;
            
            LogInfo("ChampSpawn", "Altar " + altar.serial + " - Onda " + wave_level + "/" + total_waves + " (" + mobs_to_kill + " monstros)");

            if (mobs_to_kill > 0)
                var spawned_serials := SpawnWaveWithTracking(altar, wave_info.mobs, mobs_to_kill);
                var wave_start_time := ReadGameClock();
                var wave_timeout := 600;
                var killed_count := 0;
                var last_progress := 0;
                
                while (killed_count < mobs_to_kill)
                    var alive_mobs := CountAliveMobs(spawned_serials);
                    killed_count := mobs_to_kill - alive_mobs;
                    var progress_percent := CInt((killed_count * 100.0) / mobs_to_kill);
                    var progress_level := CInt(progress_percent / 25);
                    
                    if (progress_level > last_progress)
                        CreateWhiteCandle(altar, progress_level);
                        last_progress := progress_level;
                    endif
                    
                    if ((ReadGameClock() - wave_start_time) > wave_timeout)
                        LogWarning("ChampSpawn", "TIMEOUT! Onda " + wave_level + " falhou.");
                        if (progress_percent < 30)
                            if (wave_level > 1)
                                RemoveLastRedSkull(altar);
                                wave_level := wave_level - 2;
                            else
                                wave_level := 0;
                            endif
                        else
                            wave_level := wave_level - 1;
                        endif
                        ClearWhiteCandles(altar);
                        foreach serial in spawned_serials
                            var mob_to_kill := SystemFindObjectBySerial(serial);
                            if (mob_to_kill && !mob_to_kill.dead)
                                mob_to_kill.Kill();
                            endif
                        endforeach
                        break;
                    endif
                    
                    sleep(10);
                    
                    if (CountPlayers(altar, spawn_cfg.player_radius) == 0)
                        if (!WaitForPlayersWithTolerance(altar, "Evento Champion Spawn", 600))
                            LogWarning("ChampSpawn", "Altar " + altar.serial + " pausado após 10 min sem jogadores. Cancelando evento.");
                            FinalCleanup(altar, spawn_cfg, "abandoned"); // Usa a nova lógica de limpeza
                            return;
                        endif
                    endif
                endwhile
                
                if (killed_count >= mobs_to_kill)
                    LogInfo("ChampSpawn", "Onda " + wave_level + " concluída com sucesso!");
                    ClearWhiteCandles(altar);
                    CreateRedSkull(altar);
                endif
            endif
        endfor
    endif
    
    LogCritical("StartEvent", "=== FASE DAS ONDAS CONCLUÍDA. ===");
    
    // PARTE 3: INVOCAÇÃO DO BOSS
    SetObjProperty(altar, "#completed", 1);
    
    var timer_result := ShowBossTimer(altar);
    if (!timer_result)
        LogWarning("StartEvent", "Timer do boss cancelado por falta de jogadores.");
        FinalCleanup(altar, spawn_cfg, "timer_cancelled");
        return;
    endif
    
    var boss := SpawnChampion(altar, spawn_cfg.boss_template);
    
     if (boss)
        LogCritical("StartEvent", "Boss " + boss.serial + " criado. Iniciando script de monitoramento dedicado...");
        
        // Inicia o script vigia em segundo plano
        var params := struct;
        params.+altar := altar;
        params.+boss := boss;
        params.+spawn_cfg := spawn_cfg;
        start_script(":faccao:spawndecampeao/scripts/monitor_boss", params);

        // O trabalho desta função acaba aqui. O vigia assume.
    else
        LogError("StartEvent", "FALHA CRÍTICA ao criar o Boss.");
        FinalCleanup(altar, spawn_cfg, "failed");
    endif
endfunction

