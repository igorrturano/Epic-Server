// ARQUIVO: scripts/deathcontrol.src (VERSÃO FINAL)
use uo;
use polsys;
use os;

// Evento customizado para a morte de uma criatura do champion
const EVID_CHAMPION_KILL := 0xE001;

program OnChampionMobDeath(mobile)
    // Pega o serial do altar que criou este monstro
    var altar_serial := GetObjProperty(mobile, "#AltarSerial");
    if (!altar_serial)
        return; // Não é um monstro de champion, não faz nada.
    endif

    var altar := SystemFindObjectBySerial(CInt(altar_serial));
    
    if (altar)
        var ev := struct;
        ev.+type := EVID_CHAMPION_KILL;
        SysLog("[DEATH_HANDLER] Enviando kill event do mob " + mobile.serial + " ("+mobile.name+") para o altar " + altar.serial);
        SendEvent(altar, ev);
    endif
endprogram