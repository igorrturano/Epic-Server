// CONTINUAR_CRIACAO.SRC - Script finalizador para criação de Champion Spawn
use uo;
use util;
use os;

// Incluir os arquivos necessários para as funções
include ":spawndecampeao:include/config";
include ":spawndecampeao:include/arena";

program continuar_criacao_campeao(who)
    SendSysMessage(who, "DEBUG: Script continuar_criacao INICIADO");
    
    // Lê os dados temporários que foram salvos no personagem
    var temp_info := GetObjProperty(who, "#temp_champion_creation");
    
    if (temp_info.errortext)
        SendSysMessage(who, "ERRO: Não foi possível encontrar dados temporários para a criação do Champion. Operação abortada.");
        LogError("ChampSpawn", "continuar_criacao.src falhou: Nao encontrou CProp #temp_champion_creation em " + who.name);
        return;
    endif

    // Apaga a propriedade temporária IMEDIATAMENTE para evitar execuções duplas
    EraseObjProperty(who, "#temp_champion_creation");
    
    // Extrai as informações salvas
    var champion_type := temp_info.champion_type;
    var territory_name := temp_info.territory_name;
    var center_point := temp_info.target_location;
    
    if (!champion_type || !territory_name || !center_point)
        SendSysMessage(who, "ERRO: Dados temporários de criação estão incompletos.");
        LogError("ChampSpawn", "continuar_criacao.src falhou: Dados incompletos na CProp para " + who.name);
        return;
    endif

    SendSysMessage(who, "Continuando criação... Invocando o sistema de Champion Spawn para '" + territory_name + "'.");

    // Usa a função centralizada LoadSpawnConfig (do seu config.inc, que é seguro)
    var altar_config := LoadSpawnConfig(champion_type);
    if (altar_config.errortext)
        SendSysMessage(who, "ERRO CRÍTICO: Configuração de spawn não encontrada para: " + champion_type);
        return;
    endif
    
    SendSysMessage(who, "Construindo ambiente do champion spawn...");
    
    // Usa a função centralizada do arena.inc
    var build_result := BuildChampionEnvironment(center_point.x, center_point.y, center_point.z, center_point.realm);
    if (!build_result)
        SendSysMessage(who, "ERRO: Falha ao construir ambiente do champion!");
        return;
    endif
    
    SendSysMessage(who, "Ambiente construído com " + build_result + " itens. Criando altar...");
    
    // Criar altar no Z+5 (em cima da plataforma)
    var altar := CreateItemAtLocation(center_point.x, center_point.y, center_point.z + 5, 0x1822, 1, center_point.realm);
    if (!altar)
        SendSysMessage(who, "ERRO CRÍTICO: Falha ao criar o item do altar!");
        return;
    endif
    
    // Configurar o altar com a configuração carregada (que agora contém as ondas!)
    SetObjProperty(altar, "ChampionConfig", altar_config);
    SetObjProperty(altar, "TerritoryName", territory_name);
    SetObjProperty(altar, "IsTerritorChampion", 1);
    
    SendSysMessage(who, "Champion Spawn Territorial criado com sucesso!");
    SendSysMessage(who, "Altar '" + altar_config.name + "' criado para o território '" + territory_name + "'.");
endprogram