use uo;
use util;
use os;

include ":spawndecampeao:include/altarutils";

program spawn_champion_boss(who, text)
    if (!text)
        SendSysMessage(who, "Uso: .spawnchampionboss <tipo> [territory:<nome>]");
        SendSysMessage(who, "Tipos disponíveis: orcbrute, dreadspider");
        SendSysMessage(who, "Exemplo: .spawnchampionboss orcbrute");
        SendSysMessage(who, "Exemplo territorial: .spawnchampionboss orcbrute territory:MeuTerritorio");
        return;
    endif
    
    // Detectar parâmetro territorial
    var territory_name := "";
    var boss_type := text;
    
    // Verificar se tem parâmetro territory:
    if (find(text, "territory:", 1) > 0)
        var parts := SplitWords(text);
        boss_type := parts[1]; // Primeiro parâmetro é o tipo
        
        // Procurar pelo parâmetro territory:
        foreach part in parts
            if (find(part, "territory:", 1) > 0)
                // Extrair nome após "territory:" (posição 10 em diante)
                var start_pos := find(part, ":", 1) + 1;
                territory_name := part[start_pos, len(part)];
                break;
            endif
        endforeach
        
        if (territory_name)
            SendSysMessage(who, "MODO TERRITORIAL: Criando boss para território '" + territory_name + "'");
        endif
    endif
    
    // Validar tipo de boss
    if (Lower(boss_type) != "orcbrute" && Lower(boss_type) != "dreadspider")
        SendSysMessage(who, "Erro: Tipo de boss inválido. Use: orcbrute ou dreadspider");
        return;
    endif
    
    SendSysMessage(who, "Selecione onde spawnar o Champion Boss " + boss_type);
    var targ := TargetCoordinates(who);
    if (!targ)
        SendSysMessage(who, "Cancelado.");
        return;
    endif
    
    // Criar um altar temporário para usar as funções existentes
    var temp_altar := CreateItemAtLocation(targ.x, targ.y, targ.z + 10, 0x1822, 1, who.realm);
    if (!temp_altar)
        SendSysMessage(who, "Erro: Não foi possível criar altar temporário.");
        return;
    endif
    
    // Fazer o altar invisível e inacessível
    temp_altar.color := 1; // Cor especial para identificar
    temp_altar.movable := 0;
    SetObjProperty(temp_altar, "IsTemporary", 1);
    
    // Configurar altar como territorial se especificado
    if (territory_name)
        SetObjProperty(temp_altar, "TerritoryName", territory_name);
        SetObjProperty(temp_altar, "IsTerritorChampion", 1);
        SendSysMessage(who, "Altar configurado como TERRITORIAL para: " + territory_name);
    endif
    
    // Spawnar o boss usando a função existente
    SendSysMessage(who, "Spawnando Champion Boss...");
    var boss := SpawnChampion(temp_altar, Lower(boss_type));
    
    if (boss && !boss.errortext)
        // Mover o boss para a posição correta (no chão, não no altar)
        MoveObjectToLocation(boss, targ.x, targ.y, targ.z, who.realm, MOVEOBJECT_FORCELOCATION);
        
        SendSysMessage(who, "✓ Champion Boss '" + boss.name + "' criado com sucesso!");
        SendSysMessage(who, "Serial: " + boss.serial);
        SendSysMessage(who, "Posição: " + boss.x + ", " + boss.y + ", " + boss.z);
        
        if (territory_name)
            SendSysMessage(who, "*** BOSS TERRITORIAL ***");
            SendSysMessage(who, "Território: " + territory_name);
            SendSysMessage(who, "Quando morrer, criará totem territorial!");
        endif
        
        // Remover o altar temporário após alguns segundos
        start_script(":faccao:spawndecampeao:scripts/cleanup_temp_altar", temp_altar);
        
    else
        SendSysMessage(who, "✗ Falha ao criar Champion Boss");
        if (boss && boss.errortext)
            SendSysMessage(who, "Erro: " + boss.errortext);
        endif
        
        // Limpar altar temporário em caso de erro
        DestroyItem(temp_altar);
    endif
endprogram
