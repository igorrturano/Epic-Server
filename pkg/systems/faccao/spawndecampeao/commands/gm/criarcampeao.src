use uo;
use util;
use os;

include ":faccao:spawndecampeao/include/config";
include ":faccao:spawndecampeao/include/arena";
include ":faccao:spawndecampeao/include/altar";
include "include/say";

program create_champion_spawn(who, text)
    if (!text)
        SendSysMessage(who, "Uso: .criarcampeao <NomeDoSpawn> [territory:<NomeDoTerritorio>]");
        SendSysMessage(who, "Opções: CavernaDosGoblins, CovilDasAranhas");
        SendSysMessage(who, "Exemplo territorial: .criarcampeao CavernaDosGoblins territory:MeuTerritorio");
        return;
    endif
    
    // NOVO: Detectar parâmetro territorial
    var territory_name := "";
    var spawn_type := text;
    
    // Verificar se tem parâmetro territory:
    if (find(text, "territory:", 1) > 0)
        var parts := SplitWords(text);
        spawn_type := parts[1]; // Primeiro parâmetro é o tipo
        
        // Procurar pelo parâmetro territory:
        foreach part in parts
            if (find(part, "territory:", 1) > 0)
                // Extrair nome após "territory:" (posição 10 em diante)
                var start_pos := find(part, ":", 1) + 1;
                territory_name := part[start_pos, len(part)];
                break;
            endif
        endforeach
        
        if (territory_name)
            SendSysMessage(who, "MODO TERRITORIAL: Criando champion para território '" + territory_name + "'");
        endif
    endif
    
    // CENTRALIZADO: Carregar configurações do settings.cfg
    var altar_config := LoadSpawnConfig(spawn_type);
    if (altar_config.errortext)
        SendSysMessage(who, "Erro: Não foi possível carregar configuração para '" + spawn_type + "'");
        SendSysMessage(who, "Tipos válidos: cavernadosgoblins, covildasaranhas");
        return;
    endif
    
    // Override para player_radius se necessário (mantém compatibilidade)
    if (!altar_config.player_radius || altar_config.player_radius < 60)
        altar_config.player_radius := 60;
    endif
    
    SendSysMessage(who, "Selecione o local para o CENTRO do altar e da construção.");
    var targ := TargetCoordinates(who);
    if (!targ)
        SendSysMessage(who, "Cancelado.");
        return;
    endif

    SendSysMessage(who, "Construindo o ambiente do champion spawn...");
    var build_result := BuildChampionEnvironment(targ.x, targ.y, targ.z, who.realm);
    if (!build_result)
        SendSysMessage(who, "FALHA CRÍTICA: Não foi possível construir o ambiente. Abortando.");
        return;
    endif

    SendSysMessage(who, "Ambiente construído. Criando o altar na posição elevada...");
    // MUDANÇA IMPORTANTE: Criar o altar em Z+5 para ficar em cima da plataforma.
    var altar := CreateItemAtLocation(targ.x, targ.y, targ.z + 5, 0x1822, 1, who.realm);
    if (!altar)
        SendSysMessage(who, "Falha ao criar o item do altar. O ambiente foi criado, mas o altar falhou.");
        return;
    endif

    SetObjProperty(altar, "ChampionConfig", altar_config);
    
    // NOVO: Configurar altar como territorial se especificado
    if (territory_name)
        SetObjProperty(altar, "TerritoryName", territory_name);
        SetObjProperty(altar, "IsTerritorChampion", 1);
        SendSysMessage(who, "Altar configurado como TERRITORIAL para: " + territory_name);
        SendSysMessage(who, "Boss final criará totem territorial no altar!");
    endif
    
    SendSysMessage(who, "Altar de Campeão '" + altar_config.name + "' criado com sucesso!");
    SendSysMessage(who, "Ambiente construído com " + build_result + " itens!");
endprogram