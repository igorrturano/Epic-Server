function AdicionarTextosTiposConstrucoes(byref gump)
    var tipos := array{
        // Primeira linha (4 itens) - ajuste final -5px para esquerda, alinhados com quadrados
        struct{ "x" := 65, "y" := 110, "texto" := "Habitacionais" },
        struct{ "x" := 255, "y" := 110, "texto" := "Coleta" },
        struct{ "x" := 445, "y" := 110, "texto" := "Defesa" },
        struct{ "x" := 625, "y" := 110, "texto" := "Produção" },
        // Segunda linha (4 itens) - espaçamento de 30px entre linhas
        struct{ "x" := 75, "y" := 330, "texto" := "Economia" },
        struct{ "x" := 245, "y" := 330, "texto" := "Gestão da Cidade" },
        struct{ "x" := 415, "y" := 330, "texto" := "Conhecimento e Magia" },
        struct{ "x" := 605, "y" := 330, "texto" := "Legado Cultural" }
    };

    foreach tipo in (tipos)
        GFTextLine(gump, tipo.x, tipo.y, 53, tipo.texto);
    endforeach
endfunction



// Em pkg/systems/faccao/gestao_use.src

function MostrarInformacoesTerritorio(who, index, item) // 'index' aqui é o índice base-0 do botão
    if (DEBUG_GESTAO)
        LogDebug("territorio", "MostrarInformacoesTerritorio: Recebido índice base-0: " + index);
    endif
    
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df) 
        SendSysMessage(who, "Sistema de territórios indisponível.");
        return 0;
    endif
    
    var mesa_faction := GetObjProperty(item, OBJ_FACTION_PROP);
    
    // Recriar a lista EXATAMENTE como foi criada no Gump
    var territorios := array{};
    foreach elem_name in (rect_df.keys())
        var territory_info := TM_GetTerritoryInfo(elem_name);
        if (!territory_info) continue; endif
        
        var territory_id := territory_info.id ? territory_info.id : "";
        var faction := territory_info.faction;
        
        if (faction && faction != DEFAULT_FACTION && 
            (!mesa_faction || mesa_faction == KINGDOM_FACTION || faction == mesa_faction))
            territorios.append(struct{
                "name" := elem_name,
                "id" := territory_id,
                "elem" := TM_FindTerritory(elem_name) // Armazenar o elemento para uso posterior
            });
        endif
        sleepms(2);
    endforeach
    
    // =======================================================
    // == INÍCIO DA CORREÇÃO DE INDEXAÇÃO ==
    // =======================================================

    // A verificação de limites deve usar o índice base-0
    if (index < 0 || index >= territorios.size())
        SendSysMessage(who, "Território não encontrado (índice inválido).");
        LogWarning("gestao_use", "Tentativa de acesso com índice inválido: " + index + ". Tamanho do array: " + territorios.size());
        return 0;
    endif
    
    // O acesso ao array POL deve usar o índice base-1
    var pol_index := index + 1;
    var territorio := territorios[pol_index]; 
    LogInfo("gestao_use", "Acessando território no índice POL " + pol_index + ": " + territorio.name);

    // =======================================================
    // === FIM DA CORREÇÃO DE INDEXAÇÃO ===
    // =======================================================

    if (!territorio)
        SendSysMessage(who, "Nome do território inválido.");
        return 0;
    endif
    
    var elem := territorio.elem;
    if (!elem)
        SendSysMessage(who, "Elemento do território não encontrado.");
        return 0;
    endif

    var faction := GetTerritoryFaction(elem);
    if (!faction) faction := "Desconhecida"; endif
    
    var rect := GetElementProp(elem, "Rect", "Desconhecidas");
    var realm := GetElementProp(elem, "Realm", "Desconhecido");
    
    // A chamada para o GUMP final está correta.
    MostrarGumpInformacoesTerritorio(who, territorio, faction, rect, realm, item);
    
    return 1;
endfunction

function MostrarGumpInformacoesTerritorio(who, territorio, faction, rect, realm, item)
    // Criar gump
    var gump := GFCreateGump();
    GFResizePic(gump, 0, 0, 9200, 400, 350);
    GFResizePic(gump, 15, 15, 9350, 370, 320);
    
    GFTextLine(gump, 30, 25, 2100, "Informações do Território:");
    
    var y := 60;
    
    GFTextLine(gump, 30, y, 2100, "Nome: ");
    GFTextLine(gump, 85, y, 53, territorio.name);
    y += 20;
    
    GFTextLine(gump, 30, y, 2100, "ID: ");
    GFTextLine(gump, 85, y, 53, territorio.id);
    y += 20;
    
    GFTextLine(gump, 30, y, 2100, "Facção: ");
    GFTextLine(gump, 85, y, 53, faction);
    y += 20;
    
    GFTextLine(gump, 30, y, 2100, "Coordenadas: ");
    GFTextLine(gump, 140, y, 53, rect);
    y += 20;
    
    GFTextLine(gump, 30, y, 2100, "Realm: ");
    GFTextLine(gump, 85, y, 53, realm);
    y += 30;
    
    // Opções administrativas (apenas para GM ou Rei)
    var chardata := GetObjProperty(who, "chardata");
    if (who.cmdlevel >= 3 || (chardata && (chardata.current_nobility_title in {"Rei", "Rainha"})))
        GFTextLine(gump, 30, y, 2100, "Ações Administrativas:");
        y += 20;
        
        GFAddButton(gump, 30, y, 2117, 2118, GF_CLOSE_BTN, 1);
        GFTextLine(gump, 50, y, 53, "Revogar controle da facção");
        y += 25;
        
        GFAddButton(gump, 30, y, 2117, 2118, GF_CLOSE_BTN, 2);
        GFTextLine(gump, 50, y, 53, "Transferir para outra facção");
        y += 25;
        
        // Nova opção para definir como capital
        var is_capital := TM_IsTerritoryCapital(territorio.id);
        var capital_text := is_capital ? "Remover status de Capital" : "Definir como Capital";
        GFAddButton(gump, 30, y, 2117, 2118, GF_CLOSE_BTN, 3);
        GFTextLine(gump, 50, y, 53, capital_text);
    endif
    
    GFAddButton(gump, 150, 300, 2128, 2129, GF_CLOSE_BTN, 0);
    
    var input := GFSendGump(who, gump);
    
    // Processar escolha
    ProcessarAcaoTerritorioGump(who, input[0], territorio, faction, item);
endfunction

function ProcessarAcaoTerritorioGump(who, choice, territorio, faction, item)
    if (choice == 0)
        return 0;
    endif
    
    if (choice == 1)
        // A chamada está correta: passamos o struct de informações do território.
        RevogarTerritorioFaccao(who, territorio, faction);
    elseif (choice == 2)
        // Transferir para outra facção
        TransferirTerritorioFaccao(who, territorio.elem, territorio, faction);
    elseif (choice == 3)
        // Toggle status de capital
        ToggleStatusCapital(who, territorio, item);
    endif
    
    return 1;
endfunction

function ToggleStatusCapital(who, territorio, item)
    var is_capital := TM_IsTerritoryCapital(territorio.id);
    
    // Notificar início da operação
    SendSysMessage(who, "Processando alteração do status de capital...");
    Sleep(1);
    
    if (is_capital)
        // Remover status
        var territory_elem := TM_FindTerritory(territorio.id);
        if (territory_elem)
            PrintTextAbove(item, "*Removendo status de capital*");
            Sleep(1);
            
            territory_elem.EraseProp(TERRITORY_IS_CAPITAL_PROP);
            Sleep(1); // Dar tempo para o sistema processar
            
            SendSysMessage(who, "Status de Capital removido do território.");
            PrintTextAbove(item, "*Status de capital removido*");
        endif
    else
        // Verificar se a mesa está associada a uma facção específica
        var mesa_faction := GetObjProperty(item, OBJ_FACTION_PROP);
        if (!mesa_faction)
            var territorio_faction := "";            if (territorio.elem)
                territorio_faction := GetTerritoryFaction(territorio.elem);
            endif
            
            mesa_faction := territorio_faction ? territorio_faction : "Desconhecida";
        endif
        
        PrintTextAbove(item, "*Definindo como capital*");
        Sleep(1);
        
        // Usar a função TM_SetTerritoryAsCapital
        if (TM_SetTerritoryAsCapital(territorio.id, mesa_faction))
            SendSysMessage(who, "Território definido como Capital de " + mesa_faction + "!");
            PrintTextAbove(item, "*Agora é a capital de " + mesa_faction + "*");
            Sleep(1);
        else
            SendSysMessage(who, "Falha ao definir território como Capital.");
            PrintTextAbove(item, "*Falha ao definir como capital*");
        endif
    endif
    
    Sleep(1); // Pausa final para garantir que todas as mudanças foram processadas
endfunction

/*
 * TransferirTerritorioFaccao(who, elem, territorio_info, old_faction)
 *
 * Purpose: Função "Front-End" que lida com a interface de usuário para
 *          transferir um território. Após obter a confirmação do usuário,
 *          ela DELEGA a ação para a função centralizada TM_TransferTerritoryFaction.
 *          VERSÃO FINAL COM LOGS DETALHADOS.
 */
function TransferirTerritorioFaccao(who, elem, territorio_info, old_faction)
    // Silenciar aviso de variável não utilizada, pois 'elem' é passado por consistência
    elem := elem;
    
    LogInfo("gestao_use_transfer", "==========================================================");
    LogInfo("gestao_use_transfer", "Interface de transferência iniciada por " + who.name + " para o território: " + territorio_info.name);
    
    // Etapa 1: Obter informações necessárias para o Gump.
    var territorio_id := territorio_info.id;
    var territorio_nome := territorio_info.name;
    
    // Etapa 2: Montar a lista de facções para o Gump de seleção.
    var gump := GFCreateGump();
    GFResizePic(gump, 0, 0, 9200, 400, 300);
    GFResizePic(gump, 15, 15, 9350, 370, 270);
    GFTextMid(gump, 15, 25, 380, 53, "Escolha a facção para transferir " + territorio_nome);
    
    var y := 60;
    var all_factions := GetAllFactions_KISS();
    var guild_names_options := array{};
    var button_id := 1;
    
    LogDebug("gestao_use_transfer", "  -> Encontradas " + all_factions.size() + " facções totais. Filtrando para o Gump...");
    foreach faction_info in all_factions
        var name := faction_info.name;
        if (name && name != old_faction)
            guild_names_options.append(name);
            GFAddButton(gump, 30, y, 2117, 2118, GF_CLOSE_BTN, button_id);
            GFTextLine(gump, 60, y, 1153, name);
            y += 25;
            button_id += 1;
        endif
        sleepms(2);
    endforeach
    
    GFAddButton(gump, 30, y + 20, 2117, 2118, GF_CLOSE_BTN, 0); // Botão Cancelar
    GFTextLine(gump, 60, y + 20, 2100, "Cancelar");
    
    // Etapa 3: Exibir o Gump e obter a escolha do usuário.
    var input := GFSendGump(who, gump);
    var choice := input[0];
    
    if (choice == 0)
        LogInfo("gestao_use_transfer", "  -> Operação cancelada pelo usuário na tela de seleção de facção.");
        SendSysMessage(who, "Transferência cancelada.");
        return 0;
    endif
    
    var new_faction := guild_names_options[choice];
    LogInfo("gestao_use_transfer", "  -> Usuário selecionou a facção '" + new_faction + "' como novo dono.");
    
    // Etapa 4: Pedir confirmação final com aviso explícito.
    var confirm_message := "Transferir " + territorio_nome + " para " + new_faction + "?\n\n" +
                           "ATENÇÃO: Todas as construções de feudo existentes neste território serão PERMANENTEMENTE DEMOLIDAS.\n\n" +
                           "Esta ação não pode ser desfeita. Continuar?";

    if (YesNo(who, confirm_message))
        LogWarning("gestao_use_transfer", "  -> CONFIRMAÇÃO FINAL ACEITA. Delegando para a função de back-end TM_TransferTerritoryFaction.");
        
        // ====================================================================
        // ETAPA 5: DELEGAR PARA A FUNÇÃO BACK-END CENTRALIZADA
        // ====================================================================
        var transfer_result := TM_TransferTerritoryFaction(territorio_id, new_faction, who);

        if (transfer_result.success)
            LogInfo("gestao_use_transfer", "  -> Delegação concluída com SUCESSO.");
        else
            LogError("gestao_use_transfer", "  -> Delegação concluída com FALHA. Erro: " + transfer_result.errortext);
            SendSysMessage(who, "Ocorreu um erro durante a transferência. Verifique os logs do servidor.");
        endif
        
    else
        LogInfo("gestao_use_transfer", "  -> Operação cancelada pelo usuário na confirmação final.");
        SendSysMessage(who, "Transferência cancelada.");
    endif
    
    LogInfo("gestao_use_transfer", "==========================================================");
    return 1;
endfunction

// Nova função para atualizar os objetos físicos do território
function AtualizarObjetosDoTerritorio(territorio_id, old_faction, new_faction)
    LogDebug("territorio", "Iniciando atualização de objetos para território: " + territorio_id);
    LogDebug("territorio", "Alterando propriedade de facção de '" + old_faction + "' para '" + new_faction + "'");
    var seriais_df := SafeOpenDataFile(":faccao:seriais");
    // Tipos de objetos do território a serem atualizados
    var tipos_objetos := array{
        0xFF11, // Baú da facção
        0xFE5C, // Mesa de gestão
        0x46AE  // Mural de recrutamento
    };
    
    var objetos_encontrados := 0;
    var objetos_atualizados := 0;
    
    // MÉTODO 1: Verificar registros de seriais
    var rect_df := SafeOpenDataFile(":architect:areas");    var seriais_encontrados := 0;
    var seriais_dict := dictionary{};
    
    if (seriais_df != error)
        seriais_dict := seriais_df.GetProp("territorios");
        if (!seriais_dict || seriais_dict == error)
            seriais_dict := dictionary{};
        endif
        
        if (seriais_dict && seriais_dict[territorio_id])
    LogDebug("territorio", "Encontrados seriais registrados para este território: " + territorio_id);
    var info := seriais_dict[territorio_id];
    
    // Atualizar baú
    if (info.bau)
        var bau := SystemFindObjectBySerial(CInt(info.bau));
        if (bau)
            LogDebug("territorio", "Atualizando baú (Serial: " + bau.serial + ")");
            // Atualizar propriedades
            PrintTextAbove(bau, "*Atualizando propriedades*");
            Sleep(1);
            SetObjProperty(bau, OBJ_FACTION_PROP, new_faction);
            SetObjectFaction(bau, new_faction);
            
            // ATUALIZAÇÃO IMPORTANTE: Atualizar faction_chest_id
            var chest_id := new_faction + "_" + territorio_id;
            SetObjProperty(bau, CHEST_ID_PROP, chest_id);
            LogDebug("territorio", "Atualizado faction_chest_id para: " + chest_id);
            
            // Atualizar nome
            var nome_base := "Baú de Doações de " + new_faction;
            if (territorio_id)
                nome_base += " - " + territorio_id;
            endif
            LogDebug("territorio", "Renomeando para: " + nome_base);
            SetName(bau, nome_base);
            objetos_atualizados += 1;
            seriais_encontrados += 1;
            PrintTextAbove(bau, "*Atualizado para " + new_faction + "*");
        else
            LogError("territorio", "ERRO - Baú não encontrado pelo serial: " + info.bau);
        endif
    endif
            
          // Atualizar mesa
if (info.mesa)
    var mesa := SystemFindObjectBySerial(CInt(info.mesa));
    if (mesa)
        LogDebug("territorio", "Atualizando mesa (Serial: " + mesa.serial + ")");
        // Atualizar propriedades
        PrintTextAbove(mesa, "*Atualizando propriedades*");
        Sleep(1);
        SetObjProperty(mesa, OBJ_FACTION_PROP, new_faction);
        SetObjectFaction(mesa, new_faction);
        // Atualizar nome
        var nome_mesa := "Mesa de Gestão de " + new_faction;
        if (territorio_id)
            nome_mesa += " - " + territorio_id;
        endif
        LogDebug("territorio", "Renomeando para: " + nome_mesa);
        SetName(mesa, nome_mesa);
        objetos_atualizados += 1;
        seriais_encontrados += 1;
        PrintTextAbove(mesa, "*Atualizado para " + new_faction + "*");
    else
        LogError("territorio", "ERRO - Mesa não encontrada pelo serial: " + info.mesa);
    endif
endif

// Atualizar mural
if (info.mural)
    var mural := SystemFindObjectBySerial(CInt(info.mural));
    if (mural)
        LogDebug("territorio", "Atualizando mural (Serial: " + mural.serial + ")");
        // Atualizar propriedades
        PrintTextAbove(mural, "*Atualizando propriedades*");
        Sleep(1);
        SetObjProperty(mural, OBJ_FACTION_PROP, new_faction);
        SetObjectFaction(mural, new_faction);
        // Atualizar nome
        var nome_mural := "Mural de Recrutamento de " + new_faction;
        if (territorio_id)
            nome_mural += " - " + territorio_id;
        endif
        LogDebug("territorio", "Renomeando para: " + nome_mural);
        SetName(mural, nome_mural);
        objetos_atualizados += 1;
        seriais_encontrados += 1;
        PrintTextAbove(mural, "*Atualizado para " + new_faction + "*");
    else
        LogError("territorio", "ERRO - Mural não encontrado pelo serial: " + info.mural);
    endif
endif

// Atualizar informações de serial
seriais_dict[territorio_id].faction := new_faction;
seriais_df.SetProp("territorios", seriais_dict);
LogDebug("territorio", "Atualizadas informações no datafile de seriais");
else
    LogWarning("territorio", "Não foram encontrados registros de seriais para este território");
endif
else
    LogError("territorio", "AVISO - Não foi possível acessar o datafile de seriais");
endif

// MÉTODO 2: Busca por propriedades nos objetos do mundo
LogDebug("territorio", "Buscando objetos no mundo...");
      // Força a busca no mundo mesmo se encontrou pelos seriais
    var busca_x_objetos := 0;
    var objetos_por_mundo := 0;
    
    foreach item in EnumerateItemsInContainer(0) // 0 = root container
        // Tipos de objetos do território
        if (item.objtype == 0xff11 || item.objtype == 0xFE5C || item.objtype == 0x46AE)
            // Verificar nome explicitamente
            var nome_item := item.name;
            if (nome_item.find(territorio_id) != error || nome_item.find(faction) != error)
                LogDebug("territorio", "Correspondência encontrada por nome: " + nome_item);
                // Tornar móvel e destruir em duas etapas separadas
                PrintTextAbove(item, "*Este objeto será removido*");
                item.movable := 1;
                Sleep(1);
                var destroy_result := DestroyItem(item);
                if (destroy_result)
                    objetos_destruidos += 1;
                    LogDebug("territorio", "Objeto destruído com sucesso");
                else
                    LogWarning("territorio", "Falha ao destruir objeto: " + destroy_result);
                    // Tentativa alternativa - mover para o void
                    MoveObjectToLocation(item, 6000, 6000, 0, "britannia_alt", MOVEOBJECT_FORCELOCATION);
                    objetos_destruidos += 1;
                    LogDebug("territorio", "Objeto movido para o void como alternativa");
                endif
                SleepMS(5);
            else
                // Verificar propriedades
                var item_territory := GetObjProperty(item, TERRITORY_ID_PROP);
                var item_faction := GetObjProperty(item, OBJ_FACTION_PROP);
                
                if (item_territory == territorio_id || item_faction == faction)
                    LogDebug("territorio", "Correspondência encontrada por propriedade");
                    PrintTextAbove(item, "*Este objeto será removido*");
                    item.movable := 1;
                    Sleep(1);
                    var destroy_result := DestroyItem(item);
                    if (destroy_result)
                        objetos_destruidos += 1;
                        LogDebug("territorio", "Objeto destruído com sucesso");
                    else
                        LogWarning("territorio", "Falha ao destruir objeto: " + destroy_result);
                        // Tentativa alternativa - mover para o void
                        MoveObjectToLocation(item, 6000, 6000, 0, "britannia_alt", MOVEOBJECT_FORCELOCATION);
                        objetos_destruidos += 1;
                        LogDebug("territorio", "Objeto movido para o void como alternativa");
                    endif
                    Sleep(2);
                endif
            endif
        endif
    endforeach
    
    return objetos_destruidos;
endfunction



// Função auxiliar para verificar se uma constante está definida
function IsDefined(constant_name)
    if (!constant_name)
        return 0;
    endif
    
    case (constant_name)
        "UNIQUE_ID_PROP": return (TypeOf(UNIQUE_ID_PROP) != "error");
        "ITEM_TYPE_BAU": return (TypeOf(ITEM_TYPE_BAU) != "error");
        "ITEM_TYPE_MESA": return (TypeOf(ITEM_TYPE_MESA) != "error");
        "ITEM_TYPE_MURAL": return (TypeOf(ITEM_TYPE_MURAL) != "error");
        default: return 0;
    endcase
endfunction

function ShowPermissionsManagementGump(who, faction_name)
    // Verificação inicial de permissões
    if (!who.cmdlevel && !IsGuildLeader(who))
        SendSysMessage(who, "Apenas líderes de facção podem gerenciar permissões.");
        return 0;
    endif
    
    // Criar gump
    var gump := GFCreateGump();
    GFResizePic(gump, 0, 0, GFCfgConst("Defaults", "BackGround"), 500, 400);
    GFResizePic(gump, 15, 15, GFCfgConst("Defaults", "ForeGround"), 470, 370);
    
    // Título
    GFTextMid(gump, 10, 25, 480, 2100, "Gerenciamento de Permissões - " + faction_name);
    
    // Cabeçalho da lista
    var y := 60;
    GFTextLine(gump, 25, y, 2100, "Membros com Permissão Especial:");
    y += 25;
    
    // Buscar membros com permissão
    var guild := FindGuildByName(faction_name);
    if (!guild)
        return 0;
    endif
    
    var guild_obj := FindGuild(guild);
    if (!guild_obj)
        return 0;
    endif
    
    // Lista de permissões
    var special_permissions := guild_obj.GetProp("chest_permissions");
    if (!special_permissions)
        special_permissions := dictionary{};
    endif
    
    // Mostrar membros
    if (special_permissions.keys().size() > 0)
        foreach serial in (special_permissions.keys())
            var member := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
            if (!member)
                continue;
            endif
            
            var permission := special_permissions[serial];
            GFTextLine(gump, 30, y, 2100, member.name + " - " + permission);
            GFAddButton(gump, 390, y, 2117, 2118, GF_CLOSE_BTN, 100 + _serial_iter);
            y += 25;
            sleepms(2);
        endforeach
    else
        GFTextLine(gump, 30, y, 2100, "Nenhum membro com permissão especial configurada.");
        y += 25;
    endif
    
    // Botão para adicionar novo
    y += 20;
    GFAddButton(gump, 25, y, 2117, 2118, GF_CLOSE_BTN, 1);
    GFTextLine(gump, 50, y, 2103, "Adicionar Permissão Especial para Membro");
    
    // Processar resposta
    var input := GFSendGump(who, gump);
    
    if (input[0] == 0)
        return 0;
    endif
    
    if (input[0] == 1)
        AddSpecialPermission(who, faction_name);
        return 1;
    endif
    
    if (input[0] >= 100)
        var index := input[0] - 100;
        var keys := special_permissions.keys();
        if (index >= 0 && index < keys.size())
            var serial := keys[index+1]; // POL usa arrays com base 1
            special_permissions.erase(serial);
            guild_obj.SetProp("chest_permissions", special_permissions);
            SendSysMessage(who, "Permissão especial removida.");
            ShowPermissionsManagementGump(who, faction_name);
        endif
    endif
    
    return 1;
endfunction

function RevogarTerritorioFaccao(who, territorio_info, old_faction)
    // Lógica robusta para extrair ID e Nome do território.
    var territorio_id := "";
    var territorio_nome := "";
    
    if (TypeOf(territorio_info) == "Struct")
        territorio_id := territorio_info.id;
        territorio_nome := territorio_info.name;
    elseif (TypeOf(territorio_info) == "String")
        var temp_info := TM_GetTerritoryInfo(territorio_info);
        if (temp_info)
            territorio_id := temp_info.id;
            territorio_nome := temp_info.name;
        else
            SendSysMessage(who, "Erro: O território '" + territorio_info + "' não foi encontrado.");
            return 0;
        endif
    endif

    if (!territorio_id)
        SendSysMessage(who, "Erro: Não foi possível identificar o território para revogação.");
        return 0;
    endif

    if (YesNo(who, "Tem certeza que deseja revogar o controle de '" + old_faction + "' sobre o território '" + territorio_nome + "'?"))
        SendSysMessage(who, "Processando revogação de " + territorio_nome + "...");
        
        // A função TM_RevokeTerritory agora centraliza toda a lógica necessária.
        // Ela vai destruir os objetos, mudar a facção para "Selvagem" no datafile,
        // E, o mais importante, chamar TM_RemoveTerritoryFromGuilds, que por sua vez
        // verificará se é o último território e chamará ResetKingdomLevelAndXP.
        var resultado := TM_RevokeTerritory(territorio_id, who);
        
        if (resultado)
             SendSysMessage(who, "Território revogado com sucesso!");
        else
             SendSysMessage(who, "Falha ao revogar o território. Verifique os logs.");
        endif
        
        return resultado;
    endif
    
    SendSysMessage(who, "Operação cancelada.");
    return 0;
endfunction

function ContratarCaravanaTerritorioIndividual(who, origin_territory_id, capital_id, faction_name)
    LogInfo("ContratarCaravana", "INÍCIO: " + who.name + " tentando contratar caravana de " + origin_territory_id + " para capital " + capital_id + " (Facção: " + faction_name + ")");

    var guild_obj := FindGuild(FindGuildByName(faction_name));
    if (!guild_obj)
        SendSysMessage(who, "Erro: Guilda da facção '" + faction_name + "' não encontrada.");
        LogError("ContratarCaravana", "Guilda não encontrada para facção: " + faction_name);
        return 0;
    endif

    var custo_caravana := CInt(GetGlobalProperty("caravan_weekly_cost_setting"));
    if (!custo_caravana || custo_caravana <= 0) custo_caravana := 50; endif
    LogDebug("ContratarCaravana", "Custo da caravana definido em: " + custo_caravana);

    var contratos_atuais := guild_obj.GetProp("caravan_contracts");
    if (!contratos_atuais || TypeOf(contratos_atuais) != "Array")
        contratos_atuais := array{};
    endif

    foreach c_existente in contratos_atuais
        if (c_existente && c_existente.origin_territory_id && c_existente.next_payment_due)
            if (CStr(c_existente.origin_territory_id) == CStr(origin_territory_id) && CInt(c_existente.next_payment_due) > polcore().systime)
                SendSysMessage(who, "Já existe uma caravana ativa partindo deste território.");
                LogInfo("ContratarCaravana", "Tentativa de contratar caravana duplicada de " + origin_territory_id + " para facção " + faction_name + ". Contrato ativo já existe.");
                return 0;
            endif
        else
            LogWarning("ContratarCaravana", "Contrato de caravana malformado encontrado no array para facção " + faction_name + ". Contrato: " + c_existente);
        endif
    endforeach;
   LogDebug("ContratarCaravana", "Verificação de contrato duplicado para " + origin_territory_id + " passou.");

    LogInfo("ContratarCaravana", "Tentando debitar " + custo_caravana + " moedas FÍSICAS do baú da capital " + capital_id + " para facção " + faction_name);
    var capital_donation_chest := FindFactionChest(faction_name, capital_id, 0); 

    if (!capital_donation_chest)
        SendSysMessage(who, "Erro crítico: Baú da capital (" + capital_id + ") não encontrado para debitar o custo da caravana.");
        LogError("ContratarCaravana", "Baú da capital " + capital_id + " não encontrado para debitar custo para facção " + faction_name);
        return 0;
    endif
    LogDebug("ContratarCaravana", "Baú da capital encontrado: Serial " + capital_donation_chest.serial);

    var moedas_removidas_fisicamente := 0;
    var moedas_a_remover_do_bau := custo_caravana;

    var items_no_bau_capital_array := EnumerateItemsInContainer(capital_donation_chest);
    if (items_no_bau_capital_array == error) items_no_bau_capital_array := array{}; endif

    LogDebug("ContratarCaravana", "Total de itens no baú da capital: " + items_no_bau_capital_array.size());

    foreach item_no_bau_capital in items_no_bau_capital_array
        if (moedas_a_remover_do_bau <= 0) break; endif

        if (item_no_bau_capital.objtype == 0xBA63) 
            LogDebug("ContratarCaravana", "Stack de moedas (0xBA63) encontrado: Serial " + item_no_bau_capital.serial + ", Amount: " + item_no_bau_capital.amount);
            var amount_in_stack := CInt(item_no_bau_capital.amount);
            var amount_to_take_from_this_stack := (amount_in_stack >= moedas_a_remover_do_bau) ? moedas_a_remover_do_bau : amount_in_stack;

            if (amount_to_take_from_this_stack > 0)
                LogDebug("ContratarCaravana", "Tentando subtrair " + amount_to_take_from_this_stack + " do stack " + item_no_bau_capital.serial);
                if (HelpSubtractAmount(item_no_bau_capital, amount_to_take_from_this_stack)) 
                    moedas_removidas_fisicamente += amount_to_take_from_this_stack;
                    moedas_a_remover_do_bau -= amount_to_take_from_this_stack;
                    LogInfo("ContratarCaravana", amount_to_take_from_this_stack + " moedas FÍSICAS removidas do stack (novo serial pode ter sido criado) no baú da capital " + capital_donation_chest.serial + ". Resta remover: " + moedas_a_remover_do_bau);
                else
                    SendSysMessage(who, "Erro ao tentar remover moedas do baú da capital. A operação foi cancelada.");
                    LogError("ContratarCaravana", "Falha em HelpSubtractAmount (" + amount_to_take_from_this_stack + ") no stack original " + item_no_bau_capital.serial + " do baú da capital.");
                    if (moedas_removidas_fisicamente > 0)
                        var item_estorno := CreateItemInBackpack(who, MOEDAS_COBRE, moedas_removidas_fisicamente);
                        if (item_estorno) MarcarRecursosModificados(item_estorno); endif
                        LogError("ContratarCaravana", "ESTORNO FÍSICO TENTADO: " + moedas_removidas_fisicamente + " moedas para o baú " + capital_donation_chest.serial);
                    endif
                    return 0;
                endif
            endif
        endif
        SleepMS(5); 
    endforeach;

    if (moedas_removidas_fisicamente < custo_caravana)
        SendSysMessage(who, "Não há moedas suficientes (" + moedas_removidas_fisicamente + "/" + custo_caravana + ") no baú da capital para cobrir o custo da caravana.");
        LogError("ContratarCaravana", "Moedas físicas insuficientes (" + moedas_removidas_fisicamente + "/" + custo_caravana + ") no baú da capital " + capital_donation_chest.serial);
        if (moedas_removidas_fisicamente > 0)
            var item_estorno_parcial := CreateItemInBackpack(who, MOEDAS_COBRE, moedas_removidas_fisicamente);
            if (item_estorno_parcial) MarcarRecursosModificados(item_estorno_parcial); endif
            LogError("ContratarCaravana", "ESTORNO FÍSICO PARCIAL TENTADO: " + moedas_removidas_fisicamente + " moedas para o baú " + capital_donation_chest.serial);
        endif
        return 0;
    endif
    LogInfo("ContratarCaravana", "Total de " + moedas_removidas_fisicamente + " moedas FÍSICAS removidas com sucesso do baú da capital " + capital_donation_chest.serial + " para facção " + faction_name + ".");

    var current_time_system := polcore().systime;
    var novo_contrato := struct;
    novo_contrato.+origin_territory_id := origin_territory_id;
    novo_contrato.+capital_territory_id := capital_id;
    novo_contrato.+contract_start_time := current_time_system;
    novo_contrato.+next_payment_due    := current_time_system + CARAVAN_TEST_DURATION_SECONDS; // <--- USA A CONSTANTE
    novo_contrato.+weekly_cost         := custo_caravana;

    var cleaned_contratos_atuais := array{};
    foreach contract_item_clean in contratos_atuais
        if (contract_item_clean && TypeOf(contract_item_clean) == "Struct")
            cleaned_contratos_atuais.append(contract_item_clean);
        endif
    endforeach
    cleaned_contratos_atuais.append(novo_contrato);

    LogDebug("ContratarCaravana", "Preparando para salvar " + cleaned_contratos_atuais.size() + " contratos na CProp da guilda " + faction_name);
    var set_prop_guild_result := guild_obj.SetProp("caravan_contracts", cleaned_contratos_atuais);

    if (set_prop_guild_result == error)
        LogError("ContratarCaravana", "FALHA CRÍTICA ao salvar 'caravan_contracts' na CProp da guilda " + faction_name + ". Erro: " + set_prop_guild_result.errortext);
        LogCritical("ContratarCaravana_REVERT_FISICO", "REVERTENDO CUSTO FÍSICO para " + faction_name + " devido a falha em SetProp CProp da guilda.");
        var item_estorno_critico := CreateItemInBackpack(who, MOEDAS_COBRE, custo_caravana);
        if (item_estorno_critico) MarcarRecursosModificados(item_estorno_critico); endif
        LogError("ContratarCaravana_REVERT_FISICO", "ESTORNO FÍSICO TENTADO: " + custo_caravana + " moedas para o baú " + capital_donation_chest.serial + ". A próxima execução do process_recursos_updates deve sincronizar o datafile.");
        SendSysMessage(who, "Ocorreu um erro crítico ao registrar o contrato. O custo foi estornado fisicamente. Tente novamente ou contate um GM.");
        return 0;
    endif
    LogInfo("ContratarCaravana", "CProp 'caravan_contracts' atualizada com sucesso para guilda " + faction_name);

    var origin_info := TM_GetTerritoryInfo(origin_territory_id);
    SendSysMessage(who, "Caravana do território " + (origin_info.name ? origin_info.name : origin_territory_id) + " contratada com sucesso!");
    LogInfo("caravana_contrato", "Facção " + faction_name + " contratou caravana de " + origin_territory_id + " para " + capital_id + ". Custo: " + custo_caravana + ". Próximo pagamento em " + CARAVAN_TEST_DURATION_SECONDS + "s.");

    var event_data_caravana := struct;
    event_data_caravana.+faction := faction_name;
    event_data_caravana.+origin_territory_id := origin_territory_id;
    event_data_caravana.+capital_territory_id := capital_id;
    event_data_caravana.+active_until_next_payment := novo_contrato.next_payment_due;
    TM_NotifyTerritoryChange(origin_territory_id, "caravan_activated_from_territory", event_data_caravana);
    LogInfo("ContratarCaravana", "Notificação 'caravan_activated_from_territory' enviada para " + origin_territory_id);

    return 1;
endfunction

function CancelarCaravanaTerritorioIndividual(who, origin_territory_id, faction_name)
    SendSysMessage(who, "Tentando cancelar caravana de " + origin_territory_id);
    var guild_obj := FindGuild(FindGuildByName(faction_name));
    if (!guild_obj)
        SendSysMessage(who, "Erro: Guilda não encontrada.");
        return 0;
    endif

    var contratos_atuais := guild_obj.GetProp("caravan_contracts");
    if (!contratos_atuais || TypeOf(contratos_atuais) != "Array")
        SendSysMessage(who, "Nenhum contrato de caravana encontrado para este território.");
        return 0;
    endif    var novos_contratos_apos_remocao := array{};
    var contrato_removido := 0;
    var capital_id_do_contrato_removido := ""; // Para notificação
      foreach c_existente in contratos_atuais
        if (c_existente.origin_territory_id == origin_territory_id)
            // Verificar se está realmente ativo (embora o gump já deva ter filtrado isso)
            if (CInt(c_existente.next_payment_due) > polcore().systime)
                contrato_removido := 1;
                capital_id_do_contrato_removido := c_existente.capital_territory_id;
                LogInfo("caravana_cancela", "Facção " + faction_name + " cancelou caravana de " + origin_territory_id);
                // Não adiciona à nova lista, efetivamente removendo-o
            else
                novos_contratos_apos_remocao.append(c_existente); // Mantém contratos expirados ou de outros territórios
            endif
        else
            novos_contratos_apos_remocao.append(c_existente);
        endif
    endforeach

    if (contrato_removido)
        guild_obj.SetProp("caravan_contracts", novos_contratos_apos_remocao);
        SendSysMessage(who, "Caravana do território cancelada com sucesso.");

        // NOTIFICAR O RESOURCECONTROLLER
        var event_data_caravana_cancel := struct;
        event_data_caravana_cancel.+faction := faction_name;
        event_data_caravana_cancel.+origin_territory_id := origin_territory_id;
        event_data_caravana_cancel.+capital_territory_id := capital_id_do_contrato_removido;        
        TM_NotifyTerritoryChange(origin_territory_id, "caravan_deactivated_from_territory", event_data_caravana_cancel);
    else
        SendSysMessage(who, "Nenhuma caravana ativa encontrada partindo deste território para cancelar.");
    endif

    return 1;
endfunction

function ProcessarCompraMapeador(who, item)
    // [LOG] Inicia o processo de log detalhado para a compra.
    LogInfo("CompraMapeador", "==================================================");
    LogInfo("CompraMapeador", "INÍCIO da tentativa de compra do Mapeador por: " + who.name + " (Serial: " + who.serial + ")");

    // Etapa 1: Verificar se o jogador tem privilégios de arquiteto
    var tem_permissao := IsArchitectOfGuild(who);
    // [LOG] Loga o resultado da verificação de permissão.
    LogInfo("CompraMapeador", "ETAPA 1: Verificação de Permissão (IsArchitectOfGuild) -> Resultado: " + (tem_permissao ? "SUCESSO" : "FALHA"));
    if (!tem_permissao)
        SendSysMessage(who, "Apenas arquitetos de guilda podem comprar o Mapeador.", 3, 38);
        LogWarning("CompraMapeador", "FALHA na compra: " + who.name + " não tem permissão de arquiteto. Processo encerrado.");
        LogInfo("CompraMapeador", "==================================================");
        return 0;
    endif

    // Etapa 2: Calcular moedas disponíveis
    // [LOG] Inicia a contagem de moedas.
    LogInfo("CompraMapeador", "ETAPA 2: Contando moedas na mochila de " + who.name);
    var moedas_disponiveis := 0;
    var moedas_items := array{};
    
    foreach moeda in EnumerateItemsInContainer(who.backpack)
        if (moeda.objtype == MOEDAS_COBRE)
            moedas_disponiveis += moeda.amount;
            moedas_items.append(moeda);
            // [LOG] Loga cada pilha de moedas encontrada.
            LogDebug("CompraMapeador", "  -> Pilha de moedas encontrada: Serial=" + moeda.serial + ", Quantidade=" + moeda.amount);
        endif
        sleepms(2);
    endforeach
    
    // [LOG] Loga o total de moedas e o custo necessário.
    LogInfo("CompraMapeador", "ETAPA 3: Verificação de Custo -> Moedas disponíveis: " + moedas_disponiveis + " / Custo necessário: " + MAPEADOR_CUSTO);
    // Verificar se tem moedas suficientes
    if (moedas_disponiveis < MAPEADOR_CUSTO)
        SendSysMessage(who, "Você precisa de " + MAPEADOR_CUSTO + " moedas de cobre para comprar um Mapeador. Você tem apenas " + moedas_disponiveis + ".");
        LogWarning("CompraMapeador", "FALHA na compra: Fundos insuficientes. Processo encerrado.");
        LogInfo("CompraMapeador", "==================================================");
        return 0;
    endif
    
    // Etapa 4: Consumir as moedas
    // [LOG] Inicia o débito das moedas.
    LogInfo("CompraMapeador", "ETAPA 4: Debitando " + MAPEADOR_CUSTO + " moedas da mochila de " + who.name);
    var moedas_restantes := MAPEADOR_CUSTO;
    foreach moeda in moedas_items
        if (moedas_restantes <= 0)
            break;
        endif
        
        if (moeda.amount >= moedas_restantes)
            // Esta pilha tem moedas suficientes
            // [LOG] Loga a subtração parcial de uma pilha.
            LogDebug("CompraMapeador", "  -> Subtraindo " + moedas_restantes + " da pilha " + moeda.serial);
            SubtractAmount(moeda, moedas_restantes);
            moedas_restantes := 0;
        else
            // Consumir toda esta pilha
            // [LOG] Loga a destruição de uma pilha inteira.
            LogDebug("CompraMapeador", "  -> Consumindo pilha inteira " + moeda.serial + " (" + moeda.amount + " moedas)");
            moedas_restantes -= moeda.amount;
            DestroyItem(moeda);
        endif
        sleepms(2);
    endforeach
    // [LOG] Confirma que o débito foi concluído.
    LogInfo("CompraMapeador", "Débito de moedas concluído com sucesso.");

    // Etapa 5: Criar o Mapeador na mochila do jogador
    // [LOG] Inicia a criação do item.
    LogInfo("CompraMapeador", "ETAPA 5: Tentando criar o Mapeador (Objtype: 0x" + Hex(MAPEADOR_OBJTYPE) + ") na mochila.");
    var mapeador := CreateItemInBackpack(who, MAPEADOR_OBJTYPE, 1);
    
    if (!mapeador)
        // [LOG] Loga a falha na criação na mochila e a tentativa de fallback.
        LogWarning("CompraMapeador", "Falha ao criar na mochila. Tentando criar no chão como fallback.");
        mapeador := CreateItemAtLocation(who.x, who.y, who.z, MAPEADOR_OBJTYPE, 1, who.realm);
        if (mapeador)
            // Configurar o script de uso do Mapeador
            mapeador.usescript := ":faccao:mapeador";
            SendSysMessage(who, "Mapeador comprado com sucesso! O item foi colocado no chão pois sua mochila está cheia.");
            // [LOG] Loga o sucesso do fallback.
            LogInfo("CompraMapeador", "SUCESSO (Fallback): Mapeador criado no chão. Serial: " + mapeador.serial);
            LogInfo("CompraMapeador", "==================================================");
        else
            SendSysMessage(who, "Erro ao criar o Mapeador. Contacte a administração.");
            // [LOG] Loga a falha crítica e a devolução das moedas.
            LogError("CompraMapeador", "FALHA CRÍTICA: Falha ao criar Mapeador na mochila E no chão. Devolvendo moedas.");
            CreateItemInBackpack(who, MOEDAS_COBRE, MAPEADOR_CUSTO);
            LogInfo("CompraMapeador", "==================================================");
            return 0;
        endif
    else
        // Configurar o script de uso do Mapeador
        mapeador.usescript := ":faccao:mapeador";
        SendSysMessage(who, "Mapeador comprado com sucesso por " + MAPEADOR_CUSTO + " moedas de cobre!");
        // [LOG] Loga o sucesso da criação na mochila.
        LogInfo("CompraMapeador", "SUCESSO: Mapeador criado na mochila. Serial: " + mapeador.serial);
        LogInfo("CompraMapeador", "==================================================");
    endif
    
    return 1;
endfunction

function ProcessarCompraFerramentas(who, item)
    // Verificar se o jogador tem privilégios de arquiteto (igual ao mapeador)
    if (!IsArchitectOfGuild(who))
        SendSysMessage(who, "Apenas arquitetos de guilda podem comprar Ferramentas de Construção.", 3, 38);
        return 0;
    endif

    // Calcular moedas disponíveis
    var moedas_disponiveis := 0;
    var moedas_items := array{};
    
    foreach moeda in EnumerateItemsInContainer(who.backpack)
        if (moeda.objtype == MOEDAS_COBRE)
            moedas_disponiveis += moeda.amount;
            moedas_items.append(moeda);
        endif
        sleepms(2);
    endforeach
    
    // Verificar se tem moedas suficientes
    if (moedas_disponiveis < FERRAMENTAS_CUSTO)
        SendSysMessage(who, "Você precisa de " + FERRAMENTAS_CUSTO + " moedas de cobre para comprar Ferramentas de Construção. Você tem apenas " + moedas_disponiveis + ".");
        return 0;
    endif
    
    // Consumir as moedas
    var moedas_restantes := FERRAMENTAS_CUSTO;
    foreach moeda in moedas_items
        if (moedas_restantes <= 0)
            break;
        endif
        
        if (moeda.amount >= moedas_restantes)
            // Esta pilha tem moedas suficientes
            SubtractAmount(moeda, moedas_restantes);
            moedas_restantes := 0;
        else
            // Consumir toda esta pilha
            moedas_restantes -= moeda.amount;
            DestroyItem(moeda);
        endif
        sleepms(2);
    endforeach
    
    // Criar as Ferramentas de Construção na mochila do jogador
    var ferramentas := CreateItemInBackpack(who, FERRAMENTAS_OBJTYPE, 1);
    if (!ferramentas)
        // Tentar criar no chão se não couber na mochila
        ferramentas := CreateItemAtLocation(who.x, who.y, who.z, FERRAMENTAS_OBJTYPE, 1, who.realm);
        if (ferramentas)
            // Configurar o nome do item
            ferramentas.name := "Ferramentas de Construção";
            SendSysMessage(who, "Ferramentas de Construção compradas com sucesso! O item foi colocado no chão pois sua mochila está cheia.");
        else
            SendSysMessage(who, "Erro ao criar as Ferramentas de Construção. Contacte a administração.");
            // Devolver as moedas em caso de erro
            CreateItemInBackpack(who, MOEDAS_COBRE, FERRAMENTAS_CUSTO);
            return 0;
        endif
    else
        // Configurar o nome do item
        ferramentas.name := "Ferramentas de Construção";
        SendSysMessage(who, "Ferramentas de Construção compradas com sucesso por " + FERRAMENTAS_CUSTO + " moedas de cobre!");
    endif
    
    return 1;
endfunction

function ProcessarCompraInstaladorFechadura(who, item)
    // [LOG] Inicia o processo de log detalhado para a compra.
    LogInfo("CompraInstaladorFechadura", "==================================================");
    LogInfo("CompraInstaladorFechadura", "INÍCIO da tentativa de compra do Instalador de Fechadura por: " + who.name + " (Serial: " + who.serial + ")");

    // Etapa 1: Calcular moedas disponíveis (sem necessidade de permissão especial para fechaduras)
    LogInfo("CompraInstaladorFechadura", "ETAPA 1: Contando moedas na mochila de " + who.name);
    var moedas_disponiveis := 0;
    var moedas_items := array{};
    
    foreach moeda in EnumerateItemsInContainer(who.backpack)
        if (moeda.objtype == MOEDAS_COBRE)
            moedas_disponiveis += moeda.amount;
            moedas_items.append(moeda);
            LogDebug("CompraInstaladorFechadura", "  -> Pilha de moedas encontrada: Serial=" + moeda.serial + ", Quantidade=" + moeda.amount);
        endif
        sleepms(2);
    endforeach
    
    // [LOG] Loga o total de moedas e o custo necessário.
    LogInfo("CompraInstaladorFechadura", "ETAPA 2: Verificação de Custo -> Moedas disponíveis: " + moedas_disponiveis + " / Custo necessário: " + INSTALADOR_FECHADURA_CUSTO);
    // Verificar se tem moedas suficientes
    if (moedas_disponiveis < INSTALADOR_FECHADURA_CUSTO)
        SendSysMessage(who, "Você precisa de " + INSTALADOR_FECHADURA_CUSTO + " moedas de cobre para comprar um Instalador de Fechadura. Você tem apenas " + moedas_disponiveis + ".");
        LogWarning("CompraInstaladorFechadura", "FALHA na compra: Fundos insuficientes. Processo encerrado.");
        LogInfo("CompraInstaladorFechadura", "==================================================");
        return 0;
    endif
    
    // Etapa 3: Consumir as moedas
    LogInfo("CompraInstaladorFechadura", "ETAPA 3: Debitando " + INSTALADOR_FECHADURA_CUSTO + " moedas da mochila de " + who.name);
    var moedas_restantes := INSTALADOR_FECHADURA_CUSTO;
    foreach moeda in moedas_items
        if (moedas_restantes <= 0)
            break;
        endif
        
        if (moeda.amount >= moedas_restantes)
            LogDebug("CompraInstaladorFechadura", "  -> Subtraindo " + moedas_restantes + " da pilha " + moeda.serial);
            SubtractAmount(moeda, moedas_restantes);
            moedas_restantes := 0;
        else
            LogDebug("CompraInstaladorFechadura", "  -> Consumindo pilha inteira " + moeda.serial + " (" + moeda.amount + " moedas)");
            moedas_restantes -= moeda.amount;
            DestroyItem(moeda);
        endif
        sleepms(2);
    endforeach
    LogInfo("CompraInstaladorFechadura", "Débito de moedas concluído com sucesso.");

    // Etapa 4: Criar o Instalador de Fechadura na mochila do jogador
    LogInfo("CompraInstaladorFechadura", "ETAPA 4: Tentando criar o Instalador de Fechadura (Objtype: 0x" + Hex(INSTALADOR_FECHADURA_OBJTYPE) + ") na mochila.");
    var instalador := CreateItemInBackpack(who, INSTALADOR_FECHADURA_OBJTYPE, 1);
    
    if (!instalador)
        LogWarning("CompraInstaladorFechadura", "Falha ao criar na mochila. Tentando criar no chão como fallback.");
        instalador := CreateItemAtLocation(who.x, who.y, who.z, INSTALADOR_FECHADURA_OBJTYPE, 1, who.realm);
        if (instalador)
            instalador.usescript := ":faccao:construcao/construcoes_todas/instalador_fechadura";
            SendSysMessage(who, "Instalador de Fechadura comprado com sucesso! O item foi colocado no chão pois sua mochila está cheia.");
            LogInfo("CompraInstaladorFechadura", "SUCESSO (Fallback): Instalador de Fechadura criado no chão. Serial: " + instalador.serial);
            LogInfo("CompraInstaladorFechadura", "==================================================");
        else
            SendSysMessage(who, "Erro ao criar o Instalador de Fechadura. Contacte a administração.");
            LogError("CompraInstaladorFechadura", "FALHA CRÍTICA: Não foi possível criar o item nem na mochila nem no chão. Devolvendo moedas.");
            
            // Devolver as moedas
            var moedas_devolvidas := CreateItemInBackpack(who, MOEDAS_COBRE, INSTALADOR_FECHADURA_CUSTO);
            if (!moedas_devolvidas)
                CreateItemAtLocation(who.x, who.y, who.z, MOEDAS_COBRE, INSTALADOR_FECHADURA_CUSTO, who.realm);
            endif
            LogInfo("CompraInstaladorFechadura", "==================================================");
            return 0;
        endif
    else
        instalador.usescript := ":faccao:construcao/construcoes_todas/instalador_fechadura";
        SendSysMessage(who, "Instalador de Fechadura comprado com sucesso por " + INSTALADOR_FECHADURA_CUSTO + " moedas de cobre!");
        LogInfo("CompraInstaladorFechadura", "SUCESSO: Instalador de Fechadura criado na mochila. Serial: " + instalador.serial);
        LogInfo("CompraInstaladorFechadura", "==================================================");
    endif
    
    return 1;
endfunction

function IsArchitectOfGuild(who)
    // Usar a função VerifyArchitect do sistema de arquitetos
    // que já faz todas as verificações necessárias
    // Se não existir, fazer verificação básica
    if (who.cmdlevel >= 1)
        return 1;
    endif
    
    // Verificação básica de guilda
    var guild := who.guild;
    if (!guild)
        return 0;
    endif
    
    // Se é líder da guilda, pode usar
    if (guild.IsLeader(who))
        return 1;
    endif
    
    return 0;
endfunction

/**
 * Purpose: Obter a cultura associada ao reino/facção
 * Parameters: item - mesa de gestão, faction_name - nome da facção
 * Return: String da cultura ou 0 se não encontrada
 */
function GetKingdomCulture(item, faction_name)
    if (!item)
        LogDebug("cultura", "GetKingdomCulture: item é NULL, retornando 0");
        return 0;
    endif
    
    // DEBUG: Informações básicas
    var debug_msg := "DEBUG GetKingdomCulture: Iniciando para facção: " + faction_name;
    syslog(debug_msg);
    LogDebug("cultura", debug_msg);
    
    // PRIMEIRA PRIORIDADE: Verificar a cultura salva na guild (escolha do jogador no totem)
    var guild_id := GetObjProperty(item, "guild_id");
    debug_msg := "DEBUG GetKingdomCulture: guild_id encontrado = " + guild_id;
    syslog(debug_msg);
    LogDebug("cultura", debug_msg);
    
    if (guild_id)
        var guild_obj := FindGuild(guild_id);
        debug_msg := "DEBUG GetKingdomCulture: guild_obj = " + guild_obj;
        syslog(debug_msg);
        LogDebug("cultura", debug_msg);
        
        if (guild_obj)
            // PRIORIDADE MÁXIMA: Cultura escolhida pelo jogador no totem
            var cultura_escolhida := SafeGetGuildProperty(guild_obj, "culture", "");
            debug_msg := "DEBUG GetKingdomCulture: cultura escolhida pelo jogador = '" + cultura_escolhida + "'";
            syslog(debug_msg);
            LogDebug("cultura", debug_msg);
            
            // Também testar acesso direto sem SafeGetGuildProperty
            var cultura_direta := guild_obj.GetProp("culture");
            debug_msg := "DEBUG GetKingdomCulture: cultura via GetProp direto = '" + cultura_direta + "'";
            syslog(debug_msg);
            LogDebug("cultura", debug_msg);
            
            if (cultura_escolhida && cultura_escolhida != "" && cultura_escolhida != DEFAULT_FACTION)
                debug_msg := "DEBUG GetKingdomCulture: USANDO cultura escolhida = " + cultura_escolhida;
                syslog(debug_msg);
                LogDebug("cultura", debug_msg);
                return cultura_escolhida;
            endif
            
            if (cultura_direta && cultura_direta != "" && cultura_direta != DEFAULT_FACTION)
                debug_msg := "DEBUG GetKingdomCulture: USANDO cultura direta = " + cultura_direta;
                syslog(debug_msg);
                LogDebug("cultura", debug_msg);
                return cultura_direta;
            endif
        endif
    endif
    
    // SEGUNDA PRIORIDADE: Se não há cultura escolhida, usar mapeamento por nome da facção
    if (faction_name)
        var cultura_por_nome := GetCultureFromFactionName(faction_name);
        debug_msg := "DEBUG GetKingdomCulture: Cultura por nome da facção '" + faction_name + "' = " + cultura_por_nome;
        syslog(debug_msg);
        LogDebug("cultura", debug_msg);        
        if (cultura_por_nome && cultura_por_nome != "")
            return cultura_por_nome;
        endif
    endif
    
    // TERCEIRA PRIORIDADE: Obter cultura através da referência da guild
    var cultura := GetObjectCulture(item);
    if (cultura)
        LogDebug("cultura", "GetKingdomCulture: Cultura obtida da guild: " + cultura);
        return cultura;
    endif
    
    // FALLBACK: Para objetos antigos que ainda não foram migrados
    var cultura_mesa := GetObjProperty(item, "cultura");
    if (cultura_mesa)
        LogWarning("cultura", "GetKingdomCulture: Usando cultura hardcoded (objeto não migrado): " + cultura_mesa);
        return cultura_mesa;
    endif
      // FALLBACK: Buscar em outros objetos do território
    var territory_id := GetObjProperty(item, TERRITORY_ID_PROP);
    if (territory_id)
        // Busca objetos do território para encontrar a cultura
        var seriais_df := SafeOpenDataFile(":faccao:seriais");
        if (seriais_df)
            var territory_elem := seriais_df.FindElement(territorio_id);
            if (territory_elem)
                var mural_serial := GetElementProp(territory_elem, "mural");
                if (mural_serial)
                    var mural_obj := SystemFindObjectBySerial(mural_serial);
                    if (mural_obj)
                        // Tentar nova abordagem primeiro
                        var cultura_mural := GetObjectCulture(mural_obj);
                        if (cultura_mural)
                            return cultura_mural;
                        endif
                        
                        // Fallback para cultura hardcoded
                        cultura_mural := GetObjProperty(mural_obj, "cultura");
                        if (cultura_mural)
                            LogWarning("cultura", "GetKingdomCulture: Usando cultura hardcoded do mural (não migrado): " + cultura_mural);
                            return cultura_mural;
                        endif
                    endif
                endif
            endif
        endif
    endif
    
    return 0;
endfunction




function CalcularTamanhoTerritorio(territory_info)
	if (!territory_info.rect || territory_info.rect == "")
		return 1; // Tamanho padrão para territórios sem coordenadas
	endif
	
	var coords := SplitWords(territory_info.rect);
	if (coords.size() < 4)
		return 1;
	endif
	
	var x1 := CInt(coords[1]);
	var y1 := CInt(coords[2]);
	var x2 := CInt(coords[3]);
	var y2 := CInt(coords[4]);
	
	var width := Abs(x2 - x1);
	var height := Abs(y2 - y1);
	var area := width * height;
	
	// Classificar por tamanho:
	// Pequeno (até 2500): multiplicador 1
	// Médio (2501-10000): multiplicador 2
	// Grande (10001+): multiplicador 3
	if (area <= 2500)
		return 1;
	elseif (area <= 10000)
		return 2;
	else
		return 3;
	endif
endfunction

function CalcularCustoTerritorio(guild_level, territory_size)
	// Custo base por território: 100 moedas
	var base_cost := 100;
	
	// Multiplicador por tamanho
	var size_multiplier := territory_size;
	
	// Multiplicador por nível (guilds de nível alto pagam mais)
	var level_multiplier := 1.0;
	if (guild_level >= 5)
		level_multiplier := 1.5;
	elseif (guild_level >= 10)
		level_multiplier := 2.0;
	endif
	
	var final_cost := CInt(base_cost * size_multiplier * level_multiplier);
	return final_cost;
endfunction

function CalculaRecursosDisponiveis(faction_chest)
	var total := 0;
	
	if (!faction_chest)
		return 0;
	endif
	
	foreach item in EnumerateItemsInContainer(faction_chest)
		case (item.objtype)
			0xba63: total += item.amount; // cobre
			0xba64: total += item.amount * 10; // prata
			0xba65: total += item.amount * 100; // ouro
			0xeed: total += item.amount * 100; // gold coin
		endcase
		sleepms(2);
	endforeach
		return total;
endfunction

// Função GetSimpleGuildLevel movida para shared_functions.inc para evitar duplicação

// ===== MELHORIAS E CORREÇÕES ADICIONAIS =====

// 1. Função para formatar tempo restante de forma mais legível
function FormatTimeRemaining(seconds)
	if (seconds <= 0)
		return "Vencido";
	endif
	
	var days := CInt(seconds / 86400);
	var hours := CInt((seconds % 86400) / 3600);
	var minutes := CInt((seconds % 3600) / 60);
	
	var result := "";
	
	if (days > 0)
		result += days + " dia" + (days == 1 ? "" : "s");
		if (hours > 0)
			result += ", " + hours + " hora" + (hours == 1 ? "" : "s");
		endif
	elseif (hours > 0)
		result += hours + " hora" + (hours == 1 ? "" : "s");
		if (minutes > 0)
			result += ", " + minutes + " min";
		endif
	else
		result += minutes + " minuto" + (minutes == 1 ? "" : "s");
	endif
	
	return result;
endfunction

// 2. Função para verificar se o reino está em risco de perder territórios
function CheckUpkeepStatus(guild, faction_name)
	var last_payment := SafeGetGuildProperty(guild, "last_upkeep_payment", 0);
	var current_time := polcore().systime;
	
	var result := struct;
	
	if (last_payment == 0)
		result.+status := "first_payment";
		result.+message := "Primeiro pagamento ainda não foi cobrado";
		result.+color := 1890; // Azul
		return result;
	endif
	
	var next_payment := last_payment + 604800; // 7 dias
	var time_until := next_payment - current_time;
	
	if (time_until > 86400) // Mais de 1 dia
		result.+status := "ok";
		result.+message := "Em dia - próximo pagamento em " + FormatTimeRemaining(time_until);
		result.+color := 68; // Verde
		return result;
	elseif (time_until > 0) // Menos de 1 dia mas ainda não venceu
		result.+status := "warning";
		result.+message := "ATENÇÃO - Vence em " + FormatTimeRemaining(time_until);
		result.+color := 53; // Amarelo
		return result;
	else // Vencido
		var days_overdue := CInt(Abs(time_until) / 86400);
		result.+status := "overdue";
		result.+message := "PAGAMENTO VENCIDO há " + days_overdue + " dia" + (days_overdue == 1 ? "" : "s");
		result.+color := 37; // Vermelho
		return result;
	endif
endfunction

// 3. Versão melhorada da seção de upkeep no ReinoGump
function AddUpkeepSectionToGump(byref gump, guild, mesa_faction)
	if (!guild || !mesa_faction || mesa_faction == KINGDOM_FACTION)
		return; // Não mostrar upkeep para o Reino principal
	endif
	
	// Background para seção de upkeep
	GFResizePic(gump, 50, 440, 9350, 380, 120);
	
	// Título da seção
	GFTextMid(gump, 50, 445, 380, 2100, "Upkeep Semanal do Reino");
	
	// Calcular custo de upkeep
	var territories := GetGuildTerritories(mesa_faction);
	var total_cost := CalcularCustoUpkeep(guild, territories);
	
	// Obter recursos disponíveis
	var faction_chest := FindFactionChest(mesa_faction);
	var recursos_disponiveis := CalculaRecursosDisponiveis(faction_chest);
	
	// Verificar status do pagamento
	var upkeep_status := CheckUpkeepStatus(guild, mesa_faction);
	
	// Informações de custo
	GFTextLine(gump, 60, 470, 2100, "Custo semanal:");
	var cost_color := (recursos_disponiveis >= total_cost) ? 68 : 37;
	GFTextLine(gump, 200, 470, cost_color, FormatNumber(total_cost) + " moedas");
	
	// Recursos disponíveis
	GFTextLine(gump, 60, 485, 2100, "Recursos disponíveis:");
	GFTextLine(gump, 200, 485, 1890, FormatNumber(recursos_disponiveis) + " moedas");
	
	// Status do pagamento
	GFTextLine(gump, 60, 500, 2100, "Status:");
	GFTextLine(gump, 120, 500, upkeep_status.color, upkeep_status.message);
	
	// Aviso se recursos insuficientes
	if (recursos_disponiveis < total_cost)
		GFTextLine(gump, 60, 515, 37, "ATENÇÃO: Recursos insuficientes!");
		GFTextLine(gump, 60, 528, 37, "Deposite moedas no baú da facção!");
	endif
	
	// Mostrar breakdown apenas se houver poucos territórios
	if (territories.size() > 0 && territories.size() <= 2)
		var detail_y := 540;
		var guild_level := GetSimpleGuildLevel(guild);
		
		GFTextLine(gump, 60, detail_y, 1890, "Detalhes (Nível " + guild_level + "):");
		detail_y += 12;
		
		foreach territory_info in territories
			var territory_size := CalcularTamanhoTerritorio(territory_info);
			var territory_cost := CalcularCustoTerritorio(guild_level, territory_size);
			
			var territory_name := territory_info.name;
			if (territory_name.size() > 12)
				territory_name := territory_name[1, 12] + "...";
			endif
			
			var size_text := "";
			case (territory_size)
				1: size_text := "P";
				2: size_text := "M";
				3: size_text := "G";
			endcase
			
			GFTextLine(gump, 70, detail_y, 1890, territory_name + " (" + size_text + "): " + territory_cost);
			detail_y += 10;
			
			if (detail_y > 555)
				break;
			endif
		endforeach
	endif
endfunction

// SUBSTITUA COMPLETAMENTE a função GetUpkeepSummary por esta versão corrigida:

function GetUpkeepSummary(faction_name)
	var guild_id := FindGuildByName(faction_name);
	if (!guild_id)
		var error_result := struct;
		error_result.+error := "Guild não encontrada";
		error_result.+total_cost := 0;
		error_result.+available_resources := 0;
		error_result.+status := "error";
		return error_result;
	endif
	
	var guild := FindGuild(guild_id);
	if (!guild)
		var error_result := struct;
		error_result.+error := "Objeto da guild não encontrado";
		error_result.+total_cost := 0;
		error_result.+available_resources := 0;
		error_result.+status := "error";
		return error_result;
	endif
	
	var territories := GetGuildTerritories(faction_name);
	var total_cost := CalcularCustoUpkeep(guild, territories);
	var faction_chest := FindFactionChest(faction_name);
	var recursos_disponiveis := CalculaRecursosDisponiveis(faction_chest);
	var upkeep_status := CheckUpkeepStatus(guild, faction_name);
	
	var result := struct;
	result.+total_cost := total_cost;
	result.+available_resources := recursos_disponiveis;
	result.+status := upkeep_status.status;
	result.+status_message := upkeep_status.message;
	result.+status_color := upkeep_status.color;
	result.+territory_count := territories.size();
	result.+guild_level := GetSimpleGuildLevel(guild);
	result.+sufficient_resources := (recursos_disponiveis >= total_cost);
	
	return result;
endfunction

function CalculateUpkeepSustainability(faction_name)
	var summary := GetUpkeepSummary(faction_name);	if (summary.exists("error"))
		var error_result := struct;
		error_result.+error_msg := summary["error"];
		error_result.+weeks_sustainable := 0;
		return error_result;
	endif
	
	if (summary.total_cost <= 0)
		var infinite_result := struct;
		infinite_result.+weeks_sustainable := -1;
		infinite_result.+message := "Sem custos de upkeep";
		return infinite_result;
	endif
	
	var weeks := CInt(summary.available_resources / summary.total_cost);
	
	var result := struct;
	result.+weeks_sustainable := weeks;
	if (weeks == 0)
		result.+message := "Recursos insuficientes";
	elseif (weeks == 1)
		result.+message := "1 semana sustentável";
	else
		result.+message := weeks + " semanas sustentáveis";
	endif
	
	return result;
endfunction

function PagarDividaManualmente(who, guild)
    var guild_name := SafeGetGuildName(guild);
    var divida_acumulada := CInt(SafeGetGuildProperty(guild, "divida_upkeep", 0));

    if (divida_acumulada <= 0)
        SendSysMessage(who, "Seu reino não possui débitos pendentes.");
        return 0;
    endif

    if (!YesNo(who, "Você deseja tentar quitar a dívida de " + divida_acumulada + " moedas agora? As moedas serão debitadas do baú da sua capital."))
        SendSysMessage(who, "Operação cancelada.");
        return 0;
    endif

    // Implementar cobrança básica ou incluir a função do arquivo reino_upkeep_control.src
    var guild_territories := GetGuildTerritories(guild_name);
    if (!guild_territories || guild_territories.size() == 0)
        SendSysMessage(who, "Erro: Nenhum território encontrado para sua facção.");
        return 0;
    endif

    // Encontrar a capital
    var capital_territory_id := "";
    foreach territory_info in guild_territories
        var current_territory_id := territory_info.id ?: territory_info.name;
        if (TM_IsTerritoryCapital(current_territory_id))
            capital_territory_id := current_territory_id;
            break;
        endif
    endforeach

    if (!capital_territory_id)
        SendSysMessage(who, "Erro: Sua facção não possui uma capital designada.");
        return 0;
    endif

    // Buscar o baú da capital
    var faction_chest := FindFactionChest(guild_name, capital_territory_id);
    if (!faction_chest)
        SendSysMessage(who, "Erro: Baú da capital não encontrado.");
        return 0;
    endif

    // Verificar e debitar moedas
    var moedas_disponiveis := 0;
    var moedas_items := array{};
    
    foreach item in EnumerateItemsInContainer(faction_chest)
        if (item.objtype == MOEDAS_COBRE)
            moedas_disponiveis += item.amount;
            moedas_items.append(item);
        endif
        sleepms(2);
    endforeach

    if (moedas_disponiveis < divida_acumulada)
        SendSysMessage(who, "Fundos insuficientes no baú da capital. Disponível: " + moedas_disponiveis + ", Necessário: " + divida_acumulada);
        return 0;
    endif

    // Debitar as moedas
    var moedas_restantes := divida_acumulada;
    foreach moeda in moedas_items
        if (moedas_restantes <= 0)
            break;
        endif
        
        if (moeda.amount >= moedas_restantes)
            SubtractAmount(moeda, moedas_restantes);
            moedas_restantes := 0;
        else
            moedas_restantes -= moeda.amount;
            DestroyItem(moeda);
        endif
        sleepms(2);
    endforeach

    if (moedas_restantes == 0)
        SafeSetGuildProperty(guild, "divida_upkeep", 0);
        SafeSetGuildProperty(guild, "pontos_inadimplencia", 0);
        
        SendSysMessage(who, "Dívida quitada com sucesso! Os benefícios do seu reino foram restaurados.");
        NotificarLider(guild, "A dívida do seu reino foi quitada manualmente. Os benefícios foram restaurados!");
        LogInfo("upkeep", "Facção '" + guild_name + "' quitou dívida manualmente.");
        return 1;
    else
        SendSysMessage(who, "Falha ao quitar a dívida completamente.");
        return 0;
    endif
endfunction


function FormatCultureForDisplay(culture_enum)
    // Tratar tanto formatos com espaços quanto com underscore
    var culture_lower := Lower(culture_enum);
    
    case (culture_lower)
        "aiglana":
        "aigla":
        "aiglanos":
            return "Aiglana";
            
        "haroloth":
        "har'oloth":
            return "Har'oloth";
            
        "povos do leste":       // <- CORREÇÃO: Tratar formato com espaços
        "povos_do_leste":       // <- E formato com underscore
        "leste":
            return "Povos do Leste";
            
        "bjorske":
        "björska":
        "bjornske":
            return "Björska";
            
        "aluriel":
        "alüriel":
            return "Alüriel";
            
        "baduran":
        "badûran":
            return "Badûran";
            
        "gulthrak":
            return "Gulthrak";
            
        "polkinea":
        "polski":
            return "Polkinea";
            
        default:
            // Fallback melhorado - capitalizar primeira letra
            if (culture_enum && culture_enum != "")
                return CapitalizeFirst(culture_enum);
            else
                return "Cultura Indefinida";
            endif
    endcase
endfunction

// Adicione esta nova função ao final de :faccao:gestao_use.src

function PagarDividaCaravana(who, origin_territory_id, faction_name)
    var guild := FindGuild(FindGuildByName(faction_name));
    if (!guild)
        return 0;
    endif
    
    var contratos := guild.GetProp("caravan_contracts");
    if (!contratos || TypeOf(contratos) != "Array")
        return 0;
    endif

    var contrato_encontrado := 0;
    var contrato_index := 0;
    var custo_divida := 0;

    foreach contrato in contratos
        contrato_index += 1;
        if (CStr(contrato.origin_territory_id) == CStr(origin_territory_id) && contrato.payment_status == "due")
            contrato_encontrado := contrato;
            custo_divida := CInt(contrato.weekly_cost);
            break;
        endif
    endforeach;

    if (!contrato_encontrado)
        SendSysMessage(who, "Não foi encontrada uma dívida para esta caravana.");
        return 0;
    endif
    
    var capital_id := contrato_encontrado.capital_territory_id;
    var capital_chest := FindFactionChest(faction_name, capital_id, 0);
    if (!capital_chest)
        SendSysMessage(who, "Erro: Baú da capital não encontrado para debitar a dívida.");
        return 0;
    endif
    
    var moedas_disponiveis := 0;
    foreach item in EnumerateItemsInContainer(capital_chest)
        if (item.objtype == MOEDAS_COBRE)
            moedas_disponiveis += item.amount;
        endif
    endforeach;

    if (moedas_disponiveis < custo_divida)
        SendSysMessage(who, "Fundos insuficientes no baú da capital para pagar a dívida de " + custo_divida + ".");
        return 0;
    endif
    
    var coins_successfully_debited := 0;
    var coins_remaining_to_debit := custo_divida;
    foreach coin_item in EnumerateItemsInContainer(capital_chest)
        if (coins_remaining_to_debit <= 0)
            break;
        endif
        if (coin_item && coin_item.objtype == MOEDAS_COBRE)
            var amount_in_stack := CInt(coin_item.amount);
            var amount_to_take := (coins_remaining_to_debit > amount_in_stack) ? amount_in_stack : coins_remaining_to_debit;
            if (HelpSubtractAmount(coin_item, amount_to_take))
                coins_successfully_debited += amount_to_take;
                coins_remaining_to_debit -= amount_to_take;
            endif
        endif
    endforeach;
    
    if (coins_successfully_debited >= custo_divida)
        // Pagamento OK. Atualizar o contrato.
        contrato_encontrado.payment_status := "active";
        contrato_encontrado.next_payment_due := polcore().systime + CARAVAN_TEST_DURATION_SECONDS;
        
        contratos[contrato_index] := contrato_encontrado;
        guild.SetProp("caravan_contracts", contratos);
        
        SendSysMessage(who, "Dívida da caravana paga! A rota comercial foi reativada.");
        
        var event_data_reactivate := struct;
        event_data_reactivate.+faction := faction_name;
        event_data_reactivate.+origin_territory_id := origin_territory_id;
        event_data_reactivate.+capital_territory_id := capital_id; 
        event_data_reactivate.+active_until_next_payment := contrato_encontrado.next_payment_due;
        // ===== INÍCIO DA CORREÇÃO =====
        TM_NotifyTerritoryChange(origin_territory_id, "caravan_activated_from_territory", event_data_reactivate);
        // ===== FIM DA CORREÇÃO =====
        return 1;
    else
        SendSysMessage(who, "Ocorreu um erro ao tentar debitar as moedas do baú da capital.");
        if(coins_successfully_debited > 0)
            CreateItemInContainer(capital_chest, 0xBA63, coins_successfully_debited);
            MarcarRecursosModificados(capital_chest);
        endif
        return 0;
    endif
endfunction
