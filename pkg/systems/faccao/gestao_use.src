    GFResizePic(gump, 38, 60, 40264, 400, 502);
    GFTextMid(gump, 490, 60, 263, 2100, "Gerenciamento de Facções");
    // TODO: Adicionar conteúdo relacionado às facções
endfunction

function DoacoesGump(byref gump, item_mesa_gestao)
    GFResizePic(gump, 38, 60, 40260, 400, 502);

    var faction_name_da_mesa := GetObjProperty(item_mesa_gestao, OBJ_FACTION_PROP);
    var titulo_gump := "";
    var recursos_a_exibir := CreateEmptyResourceStruct();
    var log_message := ""; // Variável para construir a mensagem de log

    if (faction_name_da_mesa && faction_name_da_mesa != KINGDOM_FACTION && faction_name_da_mesa != "Reino")
        titulo_gump := "Recursos de " + faction_name_da_mesa;
        var nome_elemento_debug := NormalizarNomeElementoFaccao(faction_name_da_mesa);
        log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Nome do Elemento Normalizado: '" + nome_elemento_debug + "'";
        LogCritical("gestao_use_GUMP_DEBUG", log_message);

        var df_main := SafeOpenDataFile(KINGDOM_RESOURCE_DATAFILE);
        if (df_main)
            if (nome_elemento_debug != error && nome_elemento_debug != "")
                var elem_faccao := SafeFindElement(df_main, nome_elemento_debug);
                if (elem_faccao)
                    log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Elemento '" + nome_elemento_debug + "' ENCONTRADO no datafile.";
                    LogCritical("gestao_use_GUMP_DEBUG", log_message);
                    var temp_recursos := GetElementProp(elem_faccao, "recursos");
                    if (temp_recursos && TypeOf(temp_recursos) == "Struct")
                        log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): temp_recursos É um struct. Moedas em temp_recursos: " + temp_recursos.moedas;
                        LogCritical("gestao_use_GUMP_DEBUG", log_message);
                        recursos_a_exibir := temp_recursos;

                        foreach key_padrao in (CreateEmptyResourceStruct().keys())
                            if (!recursos_a_exibir.exists(key_padrao))
                                recursos_a_exibir[key_padrao] := 0;
                                log_message := "DoacoesGump: Chave '" + key_padrao + "' não existia em temp_recursos para '" + faction_name_da_mesa + "', adicionada com 0.";
                                LogWarning("gestao_use", log_message);
                            endif
                        endforeach
                        log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Moedas em recursos_a_exibir (APÓS PREENCHIMENTO): " + recursos_a_exibir.moedas;
                        LogCritical("gestao_use_GUMP_DEBUG", log_message);
                    else
                        log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Propriedade 'recursos' não é um struct ou não encontrada no elemento '" + nome_elemento_debug + "'. Tipo: " + TypeOf(temp_recursos) + ". Usando struct vazio.";
                        LogWarning("gestao_use", log_message);
                    endif
                else
                     log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Elemento '" + nome_elemento_debug + "' NÃO encontrado no datafile '" + KINGDOM_RESOURCE_DATAFILE + "'.";
                     LogWarning("gestao_use", log_message);
                endif
            else
                log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Falha ao normalizar nome de elemento ou nome resultou inválido: '" + nome_elemento_debug + "'.";
                LogError("gestao_use", log_message);
            endif
        else
             log_message := "DoacoesGump (FACÇÃO '" + faction_name_da_mesa + "'): Não foi possível abrir o datafile '" + KINGDOM_RESOURCE_DATAFILE + "'.";
             LogWarning("gestao_use", log_message);
        endif
    else // Lógica para o REINO
        titulo_gump := "Recursos do Reino";
        LogCritical("gestao_use_GUMP_DEBUG", "DoacoesGump (REINO): Carregando recursos do REINO.");
        var df_main := SafeOpenDataFile(KINGDOM_RESOURCE_DATAFILE);
        if (df_main)
            var elem_reino := SafeFindElement(df_main, KINGDOM_RESOURCE_ELEM);
            if (elem_reino)
                log_message := "DoacoesGump (REINO): Elemento '" + KINGDOM_RESOURCE_ELEM + "' ENCONTRADO.";
                LogCritical("gestao_use_GUMP_DEBUG", log_message);
                var temp_recursos := GetElementProp(elem_reino, "recursos");
                if (temp_recursos && TypeOf(temp_recursos) == "Struct")
                    log_message := "DoacoesGump (REINO): temp_recursos É um struct. Moedas em temp_recursos: " + temp_recursos.moedas;
                    LogCritical("gestao_use_GUMP_DEBUG", log_message);
                    recursos_a_exibir := temp_recursos;
                    foreach key_padrao in (CreateEmptyResourceStruct().keys())
                        if (!recursos_a_exibir.exists(key_padrao))
                            recursos_a_exibir[key_padrao] := 0;
                            log_message := "DoacoesGump (REINO): Chave '" + key_padrao + "' não existia em temp_recursos, adicionada com 0.";
                            LogWarning("gestao_use", log_message);
                        endif
                    endforeach
                    log_message := "DoacoesGump (REINO): Moedas em recursos_a_exibir (APÓS PREENCHIMENTO): " + recursos_a_exibir.moedas;
                    LogCritical("gestao_use_GUMP_DEBUG", log_message);
                else
                    log_message := "DoacoesGump (REINO): Propriedade 'recursos' não é um struct ou não encontrada no elemento '" + KINGDOM_RESOURCE_ELEM + "'. Tipo: " + TypeOf(temp_recursos) + ". Usando struct vazio.";
                    LogWarning("gestao_use", log_message);
                endif
            else
                log_message := "DoacoesGump (REINO): Elemento '" + KINGDOM_RESOURCE_ELEM + "' NÃO encontrado.";
                LogWarning("gestao_use", log_message);
            endif
        else
            log_message := "DoacoesGump (REINO): Não foi possível abrir o datafile '" + KINGDOM_RESOURCE_DATAFILE + "'.";
            LogWarning("gestao_use", log_message);
        endif
    endif

    GFGumpPicTiled(gump, 466, 60, 263, 21, 9354);
    GFTextMid(gump, 466, 60, 263, 53, titulo_gump);

    AdicionarQuadradosRecursos(gump);
    AdicionarIconesItens(gump);
    AdicionarTextosTiposDoacao(gump);

    log_message := "DoacoesGump: VALOR DE MOEDAS EM recursos_a_exibir (ANTES DE AdicionarValoresRecursos): " + recursos_a_exibir.moedas + " (Facção: " + faction_name_da_mesa + ")";
    LogCritical("gestao_use_GUMP_DEBUG", log_message);
    AdicionarValoresRecursos(gump, recursos_a_exibir);
endfunction


