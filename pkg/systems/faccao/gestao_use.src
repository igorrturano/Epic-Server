    AdicionarIconesItens(gump);
    GFTextLine(gump, 541, 60, 53, "Recursos do Reino");
    AdicionarTextosTiposDoacao(gump);
    AdicionarValoresRecursos(gump, recursos);

    return 1;
endfunction

