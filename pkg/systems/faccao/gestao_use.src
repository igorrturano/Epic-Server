use uo;
use os;
use cfgfile;
use util;
use guilds;
use guilds;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:htmlGump";
include ":faccao:faccao";
include ":datafile:datafile";
include "include/say";
include "include/arrays";
include ":tn:tngumps";
include ":faccao:include/shared_functions";
include ":faccao:include/safe_guild_utils";
include ":faccao:include/faccao_constants";
include ":faccao:include/permissions";
include ":faccao:include/logging";
include ":faccao:include/territory_management";
include ":faccao:include/datafile_helpers";
include ":faccao:include/guild_xp";
include ":architect:architect";

// Constantes locais não movidas para faccao_constants.inc (específicas deste arquivo)
const MOEDAS_COBRE := 0xBA63;            // Moedas de cobre (local para este package)
const BKGND_STONESLAB := 9200;           // Background de pedra (local para este arquivo)
const BTN_CONTRATAR_GFX_NORMAL := 0x93A; // Exemplo de Gump ID para botão verde/azul
const BTN_CONTRATAR_GFX_OVER := 0x93A;   // Gump ID para mouse over (pode ser o mesmo ou diferente)
const BTN_CANCELAR_GFX_NORMAL := 0x938;  // Exemplo de Gump ID para botão vermelho
const BTN_CANCELAR_GFX_OVER := 0x938;    // Gump ID para mouse over

const MENU_INTRO := 0;
const MENU_REINO := 1;
const MENU_LEIS := 2;
const MENU_FACCOES := 3;
const MENU_DOACOES := 4;
const MENU_CONSTRUCOES := 5;
const MENU_GUERRA := 6;
var button_states := array{0, 0, 0, 0, 0, 0};


// Controle de depuração global - 0 = desligado, 1 = ligado
var DEBUG_GESTAO := 0;

program gestao_use(who, item)
    if (!who || !item)
        SendSysMessage(who, "Erro: who ou item é nulo");
        return 0;
    endif

      if (!CanAccessGestao(who, item))
        SendSysMessage(who, "Você não tem permissão para acessar a interface de gestão");
        return 0;
    endif
    
    SendSysMessage(who, "Acessando interface de gestão do Reino");
    ShowKingdomManagementGump(who, item);
    
    return 1;
endprogram

function CanAccessGestao(who, item)
    // Usar sistema de permissões centralizado
    return CheckPermission(who, item, "access");
endfunction

function ShowKingdomManagementGump(who, item)
    var cur_menu := MENU_DOACOES;
    var continuar := 1;    while(continuar)
        var gump := CreateKingdomManagementGump(who, cur_menu, item);
        var input := GFSendGump(who, gump);
        
        if (input[0] >= 700 && input[0] < 900)
            // Ações de território sempre finalizam o loop
            ProcessarAcaoTerritorio(who, input[0], item);
            return; // Saída imediata e definitiva        elseif (input[0] == 100)
            // Botão de compra do Mapeador
            if (ProcessarCompraMapeador(who, item))
                continuar := 0; // Sair após compra bem-sucedida
            endif
            // Se a compra falhar, continua no loop para mostrar novamente o gump
        elseif (input[0] == 101)
            // Botão de compra das Ferramentas de Construção
            if (ProcessarCompraFerramentas(who, item))
                continuar := 0; // Sair após compra bem-sucedida
            endif
            // Se a compra falhar, continua no loop para mostrar novamente o gump
        elseif (input[0] != 0)
            cur_menu := AtualizarEstadoMenu(input[0]);
        else
            continuar := 0; // Sair do loop se o usuário fechar o gump
        endif
    endwhile
endfunction

function CreateKingdomManagementGump(who, cur_menu, item)
    var gump := CriarLayoutBase();
      case (cur_menu)
        MENU_REINO:
            ReinoGump(gump, item, who);  // Passar o item (mesa de gestão) e who para ReinoGump
        MENU_LEIS:
            LeisGump(gump);
        MENU_FACCOES:
            FaccoesGump(gump);
        MENU_DOACOES:
            DoacoesGump(gump, item);
        MENU_CONSTRUCOES:
            ConstrucoesGump(gump);
        MENU_GUERRA:
            GuerraGump(gump);
        default:
            DoacoesGump(gump, item);
    endcase

    return gump;
endfunction

function CriarLayoutBase()
    var gump := GFCreateGump();
    
    GFGumpPicTiled(gump, 19, 19, 759, 550, 39929);
    AdicionarMoldura(gump);
    GFGumpPicTiled(gump, 32, 24, 733, 29, 9354);
    AdicionarBotoesNavegacao(gump);
    
    return gump;
endfunction

function AdicionarMoldura(byref gump)
    var molduras := array{
        struct{ x := 0, y := 5, width := 35, height := 36, gump := 39925 },
        struct{ x := 33, y := 5, width := 729, height := 21, gump := 39926 },
        struct{ x := 0, y := 41, width := 21, height := 539, gump := 39928 },
        struct{ x := 759, y := 5, width := 35, height := 36, gump := 39927 },
        struct{ x := 759, y := 36, width := 37, height := 534, gump := 39930 },
        struct{ x := 0, y := 561, width := 37, height := 33, gump := 39931 },
        struct{ x := 33, y := 561, width := 730, height := 33, gump := 39932 },
        struct{ x := 759, y := 561, width := 36, height := 33, gump := 39933 },
        struct{ x := 444, y := 60, width := 8, height := 502, gump := 39928 }
    };

foreach moldura in (molduras)
    GFGumpPicTiled(gump, moldura.x, moldura.y, moldura.width, moldura.height, moldura.gump);
endforeach
endfunction

function AdicionarBotoesNavegacao(byref gump)
    var textos := array{"Reino", "Leis", "Facções", "Doações", "Construções", "Guerra"};
    var x_positions := array{85, 185, 285, 395, 505, 635};
    var botoes := array{BOTAO_REINO, BOTAO_LEIS, BOTAO_FACCOES, BOTAO_DOACOES, BOTAO_CONSTRUCOES, BOTAO_GUERRA};
    
    for i := 1 to 6
        var gump_button := 2151;
        var text_color := 53;
        
        if (button_states[i])
            gump_button := 2153;
            text_color := 230;
        endif
        
        GFTextLine(gump, x_positions[i], 27, text_color, textos[i]);
        GFAddButton(gump, x_positions[i] - 35, 23, gump_button, gump_button, GF_CLOSE_BTN, botoes[i]);
    endfor
endfunction

function AtualizarEstadoMenu(input)
    case (input)
        BOTAO_REINO:
            button_states := array{1, 0, 0, 0, 0, 0};
            return MENU_REINO;
        BOTAO_LEIS:
            button_states := array{0, 1, 0, 0, 0, 0};
            return MENU_LEIS;
        BOTAO_FACCOES:
            button_states := array{0, 0, 1, 0, 0, 0};
            return MENU_FACCOES;
        BOTAO_DOACOES:
            button_states := array{0, 0, 0, 1, 0, 0};
            return MENU_DOACOES;
        BOTAO_CONSTRUCOES:
            button_states := array{0, 0, 0, 0, 1, 0};
            return MENU_CONSTRUCOES;
        BOTAO_GUERRA:
            button_states := array{0, 0, 0, 0, 0, 1};
            return MENU_GUERRA;
        default:
            return MENU_DOACOES;
    endcase
endfunction

function ReinoGump(byref gump, item, who := 0)
    LogDebug("territorio", "Iniciando ReinoGump");

    GFResizePic(gump, 38, 60, 40267, 400, 502);
    
    // Obter a facção da mesa de gestão
    var mesa_faction := GetObjProperty(item, OBJ_FACTION_PROP);
    
    // Título personalizado com o nome da facção
    var titulo := mesa_faction ? "Gestão do Reino " + mesa_faction : "Gestão do Reino";
    GFTextMid(gump, 490, 60, 263, 2100, titulo);
    
    // ===== SEÇÃO DE XP DO REINO =====
    // Obter e exibir informação sobre a cultura do reino
    // ===== SEÇÃO DE XP DO REINO =====
    // Obter informações da guild para mostrar progresso do reino
    var guild := FindGuild(FindGuildByName(mesa_faction));
    var cultura_reino := "";
      if (guild)
        // PRIMEIRA PRIORIDADE: Verificar cultura salva na guild (escolha do totem)
        var guild_culture_debug := SafeGetGuildProperty(guild, "culture", "");
        
        // LÓGICA SIMPLIFICADA: 
        // 1. Se a guild tem cultura definida (escolha do totem), usar ela
        // 2. Se não tem, obter a cultura correta e definir na guild
        cultura_reino := guild_culture_debug;
        
        if (!cultura_reino || cultura_reino == "" || cultura_reino == "0")
            // Obter a cultura através do mapeamento por nome da facção
            cultura_reino := GetCultureFromFactionName(mesa_faction);
            
            // Definir na guild para futuras consultas
            if (cultura_reino && cultura_reino != "")
                SafeSetGuildProperty(guild, "culture", cultura_reino);
                guild_culture_debug := cultura_reino;
            endif
        endif          cultura_reino := guild_culture_debug;
    endif    // Exibir a cultura do reino (com primeira letra maiúscula)
    if (cultura_reino)
        var cultura_display := cultura_reino;
        // Converter primeira letra para maiúscula usando mapeamento direto
        case (cultura_reino[1])
            "a": cultura_display := "A" + cultura_reino[2, cultura_reino.size()];
            "b": cultura_display := "B" + cultura_reino[2, cultura_reino.size()];
            "g": cultura_display := "G" + cultura_reino[2, cultura_reino.size()];
            "h": cultura_display := "H" + cultura_reino[2, cultura_reino.size()];
            "l": cultura_display := "L" + cultura_reino[2, cultura_reino.size()];
            "p": cultura_display := "P" + cultura_reino[2, cultura_reino.size()];
        endcase
             
    endif
    
    if (guild)
        // Agora que a cultura está definida, obtém as informações de XP
        var xp_info := GetGuildXPInfo(guild);          // Background para seção de XP do reino (ajustado para incluir a barra de XP)
        GFResizePic(gump, 460, 110, 9350, 320, 150);
        
        // Título da seção
        GFTextMid(gump, 460, 115, 320, 2100, "Progresso do Reino");
        
        // Nome do reino atual - usar o level_name atualizado
        var reino_atual := xp_info.level_name;
        if (!reino_atual || reino_atual == "")
            reino_atual := "Reino Nível " + xp_info.current_level;
        endif        GFTextLine(gump, 470, 135, 2100, "Reino Atual:");
        GFTextLine(gump, 570, 135, 53, reino_atual);        // Cultura do reino
        if (cultura_reino)
            var cultura_display := cultura_reino;
            // Converter culturas conhecidas para exibição com primeira letra maiúscula
            case (cultura_reino)
                "polkinea": cultura_display := "Polkinea";
                "aiglanos": cultura_display := "Aiglanos";
                "baduran": cultura_display := "Baduran";
                "gulthrak": cultura_display := "Gulthrak";
                "haroloth": cultura_display := "Haroloth";
                "leste": cultura_display := "Leste";
                "bjorske": cultura_display := "Bjorske";
                "aluriel": cultura_display := "Aluriel";
                default: cultura_display := cultura_reino; // Usar como está se não reconhecer
            endcase
            GFTextLine(gump, 470, 155, 2100, "Cultura:");
            GFTextLine(gump, 570, 155, 1153, cultura_display);
        endif
        
        if (!xp_info.is_max_level)
            var proximo_reino := GetGuildLevelName(xp_info.current_level + 1, cultura_reino);
            if (proximo_reino == "" || proximo_reino == "Sem Reino")
                proximo_reino := "Reino Nível " + (xp_info.current_level + 1);
            endif              GFTextLine(gump, 470, 175, 2100, "Próximo:");
            GFTextLine(gump, 570, 175, 1153, proximo_reino);
            
            // Calcular e mostrar custo semanal de upkeep
            var territories_count := GetGuildTerritoryCount(mesa_faction);
            var weekly_cost := (territories_count * 100) + (xp_info.current_level * 10);
            GFTextLine(gump, 470, 195, 2100, "Custo Semanal:");
            GFTextLine(gump, 570, 195, 1153, CStr(weekly_cost) + " cobre");
            
            // Barra de progresso ajustada - posição Y movida para baixo
            GFResizePic(gump, 470, 220, 9200, 280, 20);            var progress_width := CInt((xp_info.progress_percentage * 280) / 100);
            if (progress_width > 0)
                // Barra de progresso com arte azul específica da imagem
                GFResizePic(gump, 470, 220, 48, progress_width, 20);
            endif
            
            // Porcentagem ajustada para nova posição da barra
            var percentage_text := CStr(CInt(xp_info.progress_percentage)) + "%";
            GFTextMid(gump, 470, 222, 280, 1153, percentage_text);        else
            // Mostrar custo mesmo no reino máximo
            var territories_count := GetGuildTerritoryCount(mesa_faction);
            var weekly_cost := (territories_count * 100) + (xp_info.current_level * 10);
            GFTextLine(gump, 470, 195, 2100, "Custo Semanal:");
            GFTextLine(gump, 570, 195, 1153, CStr(weekly_cost) + " cobre");
            
            GFTextMid(gump, 470, 220, 280, 53, "REINO MÁXIMO ATINGIDO");
        endif
    endif
    // ===== FIM DA SEÇÃO DE XP =====
      var rect_df := SafeOpenDataFile(":architect:areas");
    if (rect_df)
        // Criar lista de territórios visíveis baseados na mesa_faction
        var territorios_visiveis := array{};
        
        foreach elem_name in (rect_df.keys())
            // Usar TM_GetTerritoryInfo para obter informações de território
            var territory_info := TM_GetTerritoryInfo(elem_name);
            
            // Verificar se o território existe
            if (!territory_info)
                continue;
            endif
            
            // Obter o ID e facção do território
           var territory_id := territory_info.id ? territory_info.id : "";
            var faction := territory_info.faction;
            
            // Filtrar por facção
            if (faction && faction != DEFAULT_FACTION && 
                (!mesa_faction || mesa_faction == KINGDOM_FACTION || faction == mesa_faction))                territorios_visiveis.append(struct{
                    "name" := elem_name,
                    "id" := territory_id,
                    TERRITORY_FACTION_PROP := faction
                });
            endif
            sleepms(2);
        endforeach        // Criar um único background para a área de territórios (ajustado para nova altura)
        GFResizePic(gump, 460, 280, 9350, 320, 230);
          // Adicionar cabeçalhos (alinhados na mesma altura Y)
        GFTextLine(gump, 485, 285, 53, "Nome do Terreno");
        GFTextLine(gump, 690, 285, 53, "Info");
        GFTextLine(gump, 730, 285, 53, "Aliados");
        
        var y := 310; // Começar após os cabeçalhos
        var territorios_mostrados := 0;
        
foreach territorio in (territorios_visiveis)
    // Usar diretamente a informação do TM_GetTerritoryInfo
    var territory_info := TM_GetTerritoryInfo(territorio.id);
    var is_capital := territory_info.is_capital;
    
    // Número do território
    GFTextLine(gump, 470, y+5, 2100, territorios_mostrados+1 + ".");
    
    // Se for capital, adicionar coroa ou marcador especial
    if (is_capital)
        GFTextLine(gump, 485, y+5, 230, territorio.name + " [CAPITAL]");
    else
        GFTextLine(gump, 485, y+5, 53, territorio.name);
    endif
            
            // Botões de informação e aliados
            GFAddButton(gump, 693, y+5, 0x4B9, 0x4BA, GF_CLOSE_BTN, 700 + territorios_mostrados);
            GFAddButton(gump, 740, y+5, 0x4B9, 0x4BA, GF_CLOSE_BTN, 800 + territorios_mostrados);
            
            y += 35; // Espaçamento entre territórios
            territorios_mostrados += 1;
            
            // Limite para não sobrecarregar a interface
            if (territorios_mostrados >= 10)
                break;
            endif
            
            sleepms(2);
        endforeach
          if (territorios_mostrados == 0)
            var msg := mesa_faction ? 
                       "Não há territórios controlados por " + mesa_faction + "." :
                       "Não há territórios controlados por facções.";
            GFTextMid(gump, 540, 300, 150, 38, msg);
        endif
    else
        GFTextMid(gump, 620, 300, 150, 38, "Sistema de territórios indisponível.");
    endif
    
    return gump;
endfunction

function ProcessarAcaoTerritorio(who, input, item)
    if (input >= 700 && input < 800)
        // Botão de visualizar mapa do território
        var territorio_idx := input - 700;
        MostrarMapaTerritorio(who, territorio_idx, item);
        return 0; // Retornar 0 para continuar no gump
    elseif (input >= 800 && input < 900)
        // Botão de informações do território
        var territorio_idx := input - 800;
        var resultado := MostrarInformacoesTerritorio(who, territorio_idx, item);
        return resultado; // Retornar o resultado da operação
    endif
    
    return 0; // Padrão: continuar no gump
endfunction

function MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao)
    LogDebug("gestao_use_mapa_v3", "MostrarMapaTerritorio v3: Index Clicado=" + index_territorio_clicado_no_gump_anterior);

    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        SendSysMessage(who, "Sistema de territórios indisponível.");
        return 0;
    endif

    var mesa_faction_name := GetObjProperty(item_mesa_gestao, OBJ_FACTION_PROP);
    if (!mesa_faction_name)
        SendSysMessage(who, "Erro: Não foi possível determinar a facção da mesa de gestão.");
        return 0;
    endif
    LogDebug("gestao_use_mapa_v3", "Facção da Mesa: " + mesa_faction_name);

    var guild_obj_mapa := FindGuild(FindGuildByName(mesa_faction_name));
    if (!guild_obj_mapa)
        SendSysMessage(who, "Erro crítico: Objeto da guilda não encontrado para " + mesa_faction_name);
        return 0;
    endif

    // 1. Obter todos os territórios DA FACÇÃO da mesa e identificar a capital
    var territorios_nao_capital_da_faccao := array{};
    var capital_da_faccao_info := 0;

    var todos_os_territorios_keys := rect_df.keys(); // Pega todas as chaves uma vez
    foreach elem_key in todos_os_territorios_keys
        var terr_info_loop := TM_GetTerritoryInfo(elem_key); // TM_GetTerritoryInfo já usa SafeFindElement
        if (terr_info_loop && terr_info_loop.faction == mesa_faction_name)
            if (terr_info_loop.id && TM_IsTerritoryCapital(terr_info_loop.id))
                capital_da_faccao_info := terr_info_loop;
            else
                territorios_nao_capital_da_faccao.append(terr_info_loop);
            endif
        endif
        SleepMS(1); // Pequena pausa para evitar sobrecarga se houver muitos territórios
    endforeach

    // Montar a lista final ordenada: capital primeiro
    var todos_territorios_da_faccao_ordenados := array{};
    if (capital_da_faccao_info)
        todos_territorios_da_faccao_ordenados.append(capital_da_faccao_info);
        LogDebug("gestao_use_mapa_v3", "Capital da facção '" + mesa_faction_name + "': " + capital_da_faccao_info.name + " (ID: " + capital_da_faccao_info.id + ")");
    else
        SendSysMessage(who, "Aviso: Sua facção não possui uma capital designada. As caravanas não podem ser gerenciadas efetivamente.");
    endif

    foreach terr_nao_capital_loop in territorios_nao_capital_da_faccao
        todos_territorios_da_faccao_ordenados.append(terr_nao_capital_loop);
    endforeach

    // Criação do Gump
    var gump_mapa := GFCreateGump();
    var gump_width := 550;
    var num_territorios_listados := todos_territorios_da_faccao_ordenados.size();
    var gump_height := 150 + (num_territorios_listados * 30); // Altura base + espaço por território
    if (gump_height < 400) 
        gump_height := 400; 
    endif
    if (gump_height > 650) 
        gump_height := 650; // Limite máximo de altura
    endif

    GFResizePic(gump_mapa, 0, 0, BKGND_BLUESLAB_FACCAO, gump_width, gump_height);
    GFResizePic(gump_mapa, 15, 15, BKGND_STONESLAB, gump_width - 30, gump_height - 30);
    GFTextMid(gump_mapa, 20, 25, gump_width - 40, 2100, "Gerenciar Caravanas para Facção: " + mesa_faction_name);

    var y_gump := 65;

    if (!capital_da_faccao_info)
        GFTextLine(gump_mapa, 30, y_gump, 38, "Nenhuma capital designada. Contratos de caravana não disponíveis.");
        y_gump += 20;
    else
        GFTextLine(gump_mapa, 30, y_gump, 1153, "Capital da Facção (Destino das Caravanas): " + capital_da_faccao_info.name);
        y_gump += 25;
    endif

    GFResizePic(gump_mapa, 20, y_gump, BKGND_STONESLAB - 100, gump_width - 40, 2); // Linha divisória
    y_gump += 15;

    GFTextLine(gump_mapa, 30, y_gump, 1153, "Territórios de Origem da Facção (" + mesa_faction_name + "):");
    y_gump += 25;

    // IDs dos botões
    var btn_id_contratar_base := 10;     // Ex: 11, 12, 13...
    var btn_id_cancelar_base  := 1000;   // Ex: 1001, 1002, 1003...
    var territorio_gump_list_index := 0; // Índice na lista do GUMP (1-based)

    // Carregar contratos de caravana existentes para esta facção
    var contratos_ativos_da_faccao := guild_obj_mapa.GetProp("caravan_contracts");
    if (!contratos_ativos_da_faccao || TypeOf(contratos_ativos_da_faccao) != "Array")
        contratos_ativos_da_faccao := array{};
    endif
    var contratos_dict_lookup := dictionary{}; // Para busca rápida por origin_territory_id
    foreach contrato_existente_loop in contratos_ativos_da_faccao
        if (contrato_existente_loop && contrato_existente_loop.origin_territory_id)
            contratos_dict_lookup[CStr(contrato_existente_loop.origin_territory_id)] := contrato_existente_loop;
        endif
    endforeach

    if (num_territorios_listados == 0)
        GFTextLine(gump_mapa, 30, y_gump, 38, "Nenhum território encontrado para esta facção.");
        y_gump += 20;
    else
        foreach terr_info_iter in todos_territorios_da_faccao_ordenados
            territorio_gump_list_index += 1; // Este é o índice 1-based para os IDs dos botões
            var nome_exib_iter := terr_info_iter.name;
            var id_exib_origem_iter := CStr(terr_info_iter.id);
            var cor_texto_nome_iter := 1153; // Cor padrão (azul claro)

            // Posicionamento dos elementos na linha
            var x_nome_iter := 30;
            var x_status_iter := x_nome_iter + 220; // Espaço para o nome do território
            var x_botao_iter  := x_status_iter + 140; // Espaço para o status

            GFTextLine(gump_mapa, x_nome_iter, y_gump, cor_texto_nome_iter, territorio_gump_list_index + ". " + nome_exib_iter);

            // Lógica para capital e territórios não-capital
            if (capital_da_faccao_info && id_exib_origem_iter == CStr(capital_da_faccao_info.id))
                GFTextLine(gump_mapa, x_status_iter, y_gump, 230, "[CAPITAL - Destino]"); // Cor amarela para capital
            elseif (capital_da_faccao_info) // Só mostrar opções se houver capital e não for a própria capital
                var contrato_deste_territorio := contratos_dict_lookup[id_exib_origem_iter];

                if (contrato_deste_territorio && CInt(contrato_deste_territorio.next_payment_due) > polcore().systime)
                    // Caravana ATIVA deste território
                    GFTextLine(gump_mapa, x_status_iter, y_gump, 63, "Caravana ATIVA"); // Verde
                    GFAddButton(gump_mapa, x_botao_iter, y_gump - 2, BTN_CANCELAR_GFX_NORMAL, BTN_CANCELAR_GFX_OVER, GF_CLOSE_BTN, btn_id_cancelar_base + territorio_gump_list_index);
                    GFTextLine(gump_mapa, x_botao_iter + 25, y_gump, 63, "Cancelar");
                else
                    // Nenhuma caravana ativa DESTE território (ou contrato expirado)
                    GFTextLine(gump_mapa, x_status_iter, y_gump, 38, "Caravana INATIVA"); // Vermelho
                    GFAddButton(gump_mapa, x_botao_iter, y_gump - 2, BTN_CONTRATAR_GFX_NORMAL, BTN_CONTRATAR_GFX_OVER, GF_CLOSE_BTN, btn_id_contratar_base + territorio_gump_list_index);
                    GFTextLine(gump_mapa, x_botao_iter + 25, y_gump, 53, "Contratar");
                endif
            endif
            y_gump += 30; // Próxima linha
        endforeach
    endif

    GFAddButton(gump_mapa, CInt(gump_width / 2) - 20, gump_height - 45, 2128, 2129, GF_CLOSE_BTN, 0); // Botão "OKAY"

    var input_mapa := GFSendGump(who, gump_mapa);
    var btn_clicado_gump := input_mapa[0];

    // Processar clique no botão Contratar
    if (btn_clicado_gump >= btn_id_contratar_base && btn_clicado_gump < btn_id_cancelar_base)
        var idx_na_lista_ordenada := btn_clicado_gump - btn_id_contratar_base;
        // Validar índice (arrays em eScript são 1-based)
        if (idx_na_lista_ordenada > 0 && idx_na_lista_ordenada <= todos_territorios_da_faccao_ordenados.size())
            var terr_para_contratar_info_clicado := todos_territorios_da_faccao_ordenados[idx_na_lista_ordenada];
            if (capital_da_faccao_info && CStr(terr_para_contratar_info_clicado.id) != CStr(capital_da_faccao_info.id))
                LogInfo("gestao_use_mapa_acao_v3", who.name + " tentando contratar caravana DO território: " + terr_para_contratar_info_clicado.name + " (ID: " + terr_para_contratar_info_clicado.id + ") PARA a capital " + capital_da_faccao_info.name);
                ContratarCaravanaTerritorioIndividual(who, terr_para_contratar_info_clicado.id, capital_da_faccao_info.id, mesa_faction_name);
            else
                SendSysMessage(who, "Não é possível contratar uma caravana da própria capital.");
            endif
        else
            LogWarning("gestao_use_mapa_v3", "Índice de botão de contratar inválido: " + idx_na_lista_ordenada);
        endif
        // Reabrir este mesmo Gump para refletir mudanças ou se o usuário quiser fazer outra ação
        MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao);

    // Processar clique no botão Cancelar
    elseif (btn_clicado_gump >= btn_id_cancelar_base)
        var idx_na_lista_ordenada_cancel := btn_clicado_gump - btn_id_cancelar_base;
        // Validar índice
        if (idx_na_lista_ordenada_cancel > 0 && idx_na_lista_ordenada_cancel <= todos_territorios_da_faccao_ordenados.size())
            var terr_para_cancelar_info_clicado := todos_territorios_da_faccao_ordenados[idx_na_lista_ordenada_cancel];
            LogInfo("gestao_use_mapa_acao_v3", who.name + " tentando cancelar caravana DO território: " + terr_para_cancelar_info_clicado.name + " (ID: " + terr_para_cancelar_info_clicado.id + ")");
            CancelarCaravanaTerritorioIndividual(who, terr_para_cancelar_info_clicado.id, mesa_faction_name);
        else
            LogWarning("gestao_use_mapa_v3", "Índice de botão de cancelar inválido: " + idx_na_lista_ordenada_cancel);
        endif
        // Reabrir este mesmo Gump
        MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao);
    endif
    // Se o botão clicado foi 0 (OKAY) ou o gump foi fechado, a execução simplesmente termina aqui,
    // e o controle volta para a função ShowKingdomManagementGump, que decidirá o que fazer (provavelmente reabrir o MENU_REINO).
endfunction



function CancelarContratoCaravana(who, capital_territory_id, faction_name)
    var guild_id := FindGuildByName(faction_name);
    if (!guild_id)
        SendSysMessage(who, "Erro: Guilda da facção '" + faction_name + "' não encontrada.");
        LogError("caravana_cancela", "Guilda '" + faction_name + "' não encontrada ao tentar cancelar caravana para capital " + capital_territory_id);
        return 0;
    endif; 

    var guild_obj := FindGuild(guild_id);

    if (guild_obj)
        var active_caravan_capital_id := CStr(guild_obj.GetProp("active_caravan_to_capital"));
        var caravan_until := CInt(guild_obj.GetProp("caravan_next_payment_due")); 

        if (active_caravan_capital_id == CStr(capital_territory_id) && caravan_until > polcore().systime)
            if (YesNo(who, "Tem certeza que deseja cancelar o contrato da caravana para esta capital? Não haverá reembolso da semana/período atual."))
                guild_obj.EraseProp("active_caravan_to_capital");
                guild_obj.EraseProp("caravan_contract_start_time");
                guild_obj.EraseProp("caravan_next_payment_due");
                guild_obj.EraseProp("caravan_weekly_cost");

                SendSysMessage(who, "Contrato da caravana cancelado com sucesso.");
                LogInfo("caravana_cancela", "Facção " + faction_name + " cancelou contrato da caravana para capital " + capital_territory_id);
                
                var event_data_cancel := struct;
                event_data_cancel.+faction := faction_name;
                // A LINHA PROBLEMÁTICA FOI REMOVIDA DAQUI

                TM_NotifyTerritoryChange(capital_territory_id, "caravan_deactivated", event_data_cancel);
                return 1; 
            else
                SendSysMessage(who, "Cancelamento abortado.");
                return 0; 
            endif; 
        else
            SendSysMessage(who, "Nenhuma caravana ativa encontrada para esta capital ou o contrato já expirou.");
            LogInfo("caravana_cancela", "Tentativa de cancelar caravana para " + capital_territory_id + " (facção " + faction_name + ") falhou: Nenhuma caravana ativa/válida. ID na prop: " + active_caravan_capital_id + ", Expira em: " + caravan_until);
            return 0; 
        endif; 
    else
        SendSysMessage(who, "Erro ao acessar dados da guilda.");
        LogError("caravana_cancela", "Falha ao obter objeto da guilda para ID " + guild_id + " (facção " + faction_name + ") ao tentar cancelar caravana.");
        return 0; 
    endif; 
endfunction

