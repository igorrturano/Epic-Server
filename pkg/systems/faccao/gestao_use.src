function DoacoesGump(byref gump, item_mesa_gestao)
    GFResizePic(gump, 38, 60, 40260, 400, 502);

    var faction_name_da_mesa := GetObjProperty(item_mesa_gestao, OBJ_FACTION_PROP);
    var titulo_gump := "";
    var recursos_a_exibir := CreateEmptyResourceStruct();

    // DEBUG: Verificar qual facção está sendo detectada
    LogCritical("gestao_use_UNIFIED", "=== DOACOES GUMP DEBUG ===");
    LogCritical("gestao_use_UNIFIED", "Facção detectada da mesa: '" + faction_name_da_mesa + "'");
    LogCritical("gestao_use_UNIFIED", "KINGDOM_FACTION é: '" + KINGDOM_FACTION + "'");
    LogCritical("gestao_use_UNIFIED", "Comparação: faction_name_da_mesa == KINGDOM_FACTION ? " + (faction_name_da_mesa == KINGDOM_FACTION));
    LogCritical("gestao_use_UNIFIED", "==========================");

    // ===================================================================
    // SISTEMA UNIFICADO HÍBRIDO: Prioriza baú físico, mas usa datafile como fallback
    // ===================================================================

    if (faction_name_da_mesa && faction_name_da_mesa != KINGDOM_FACTION)
        titulo_gump := "Recursos de " + faction_name_da_mesa;
        
        // Tentar buscar o baú da facção primeiro
        var territory_id := GetObjProperty(item_mesa_gestao, TERRITORY_ID_PROP);
        var chest := FindFactionChest(faction_name_da_mesa, territory_id, 1); // 1 = create_if_missing
        
        if (chest)
            LogInfo("gestao_use_UNIFIED", "Sistema Híbrido: Usando baú físico " + chest.serial + " para facção " + faction_name_da_mesa);
            recursos_a_exibir := ContarItensDoadosNoBau(chest, 1); // Força recontagem
            LogInfo("gestao_use_UNIFIED", "Recursos do baú físico: " + recursos_a_exibir.moedas + " moedas");
        else
            // FALLBACK: Usar dados do datafile se baú não existir
            LogWarning("gestao_use_UNIFIED", "Baú físico não encontrado. Usando dados do datafile como fallback para " + faction_name_da_mesa);
            var df_main := SafeOpenDataFile(KINGDOM_RESOURCE_DATAFILE);
            if (df_main)
                var elem_faccao := SafeFindElement(df_main, "faction_" + faction_name_da_mesa);
                if (elem_faccao)
                    var temp_recursos := GetElementProp(elem_faccao, "recursos");
                    if (temp_recursos && TypeOf(temp_recursos) == "Struct")
                        recursos_a_exibir := temp_recursos;
                        LogInfo("gestao_use_UNIFIED", "Fallback datafile: " + recursos_a_exibir.moedas + " moedas para " + faction_name_da_mesa);
                    endif
                endif
            endif
        endif
        
    else // Lógica para o REINO
        titulo_gump := "Recursos do Reino";
        
        // Para o Reino, tentar baú físico primeiro, datafile como fallback
        var chest := FindFactionChest(KINGDOM_FACTION, "", 1);
        
        if (chest)
            LogInfo("gestao_use_UNIFIED", "Sistema Híbrido: Usando baú físico " + chest.serial + " para o Reino");
            recursos_a_exibir := ContarItensDoadosNoBau(chest, 1); // Força recontagem
            LogInfo("gestao_use_UNIFIED", "Recursos do baú físico do Reino: " + recursos_a_exibir.moedas + " moedas");
        else
            // FALLBACK: Usar dados do datafile do reino
            LogWarning("gestao_use_UNIFIED", "Baú físico do Reino não encontrado. Usando dados do datafile como fallback");
            var df_main := SafeOpenDataFile(KINGDOM_RESOURCE_DATAFILE);
            if (df_main)
                var elem_reino := SafeFindElement(df_main, KINGDOM_RESOURCE_ELEM);
                if (elem_reino)
                    var temp_recursos := GetElementProp(elem_reino, "recursos");
                    if (temp_recursos && TypeOf(temp_recursos) == "Struct")
                        recursos_a_exibir := temp_recursos;
                        LogInfo("gestao_use_UNIFIED", "Fallback datafile Reino: " + recursos_a_exibir.moedas + " moedas");
                    endif
                endif
            endif
        endif
    endif

    GFGumpPicTiled(gump, 466, 60, 263, 21, 9354);
    GFTextMid(gump, 466, 60, 263, 53, titulo_gump);

    AdicionarQuadradosRecursos(gump);
    AdicionarIconesItens(gump);
    AdicionarTextosTiposDoacao(gump);

    LogInfo("gestao_use_UNIFIED", "Sistema Unificado: Exibindo " + recursos_a_exibir.moedas + " moedas para " + faction_name_da_mesa);
    AdicionarValoresRecursos(gump, recursos_a_exibir);
endfunction


function ConstrucoesGump(byref gump, item_mesa_gestao)
    // Determina qual sub-menu está ativo
    if (sub_button_states[1]) // Construções ativo
        SubConstrucoesGump(gump, item_mesa_gestao);
    elseif (sub_button_states[2]) // Ferramentas ativo
        SubFerramentasGump(gump, item_mesa_gestao);
    else
        // Por padrão, mostra Construções
        sub_button_states := array{1, 0};
        SubConstrucoesGump(gump, item_mesa_gestao);
    endif
endfunction

function SubConstrucoesGump(byref gump, item_mesa_gestao)
    // Adiciona grid de construções (igual ao grid de recursos)
    AdicionarQuadradosConstrucoes(gump);
    AdicionarIconesConstrucoes(gump);
    AdicionarTextosTiposConstrucoes(gump);
endfunction

