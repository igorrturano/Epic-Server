use uo;
use os;
use cfgfile;
use util;
use guilds;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:htmlGump";
include ":faccao:faccao";
include ":datafile:datafile";
include "include/say";
include "include/arrays";
include ":tn:tngumps";
include ":faccao:include/shared_functions";
include ":faccao:include/safe_guild_utils";
include ":faccao:include/faccao_constants";
include ":faccao:include/permissions";
include ":faccao:include/logging";
include ":faccao:include/territory_management";
include ":faccao:construcao/include/feudo_buildings";




// Constantes locais não movidas para faccao_constants.inc (específicas deste arquivo)
const MOEDAS_COBRE := 0xBA63;
const BKGND_STONESLAB := 9200;
const BTN_CONTRATAR_GFX_NORMAL := 0x93A;
const BTN_CONTRATAR_GFX_OVER := 0x938;
const BTN_CANCELAR_GFX_NORMAL := 0x939;
const MENU_REINO := 1;
const MENU_LEIS := 2;
const MENU_FACCOES := 3;
const MENU_DOACOES := 4;
const MENU_CONSTRUCOES := 5;
const MENU_GUERRA := 6;

// Sub-menus para Construções
const MENU_SUB_CONSTRUCOES := 7;
const MENU_SUB_FERRAMENTAS := 8;
var button_states := array{0, 0, 0, 0, 0, 0};
var sub_button_states := array{0, 0}; // Para sub-botões Construções e Ferramentas
var current_main_menu := MENU_REINO; // Controla qual menu principal está ativo
var DEBUG_GESTAO := 0;



program gestao_use(who, item)
    if (!who || !item)
        SendSysMessage(who, "Erro: who ou item é nulo");
        return 0;
    endif

    if (!CanAccessGestao(who, item))
        SendSysMessage(who, "Você não tem permissão para acessar a interface de gestão");
        return 0;
    endif
    
    SendSysMessage(who, "Acessando interface de gestão do Reino");
    ShowKingdomManagementGump(who, item);
    
    return 1;
endprogram

function CanAccessGestao(who, item)
    return CheckPermission(who, item, "access");
endfunction

function ShowKingdomManagementGump(who, item)
    var cur_menu := MENU_REINO;
    current_main_menu := MENU_REINO;
    var continuar := 1;
    while(continuar)
        var gump := CreateKingdomManagementGump(who, cur_menu, item);
        var input := GFSendGump(who, gump);
        
        if (!input || input[0] == 0)
            continuar := 0;
            break;
        endif
        
        var button_id := input[0];

        if (button_id == 100)
            ProcessarCompraMapeador(who, item);
            cur_menu := MENU_CONSTRUCOES;
        elseif (button_id == 101)
            ProcessarCompraFerramentas(who, item);
            cur_menu := MENU_CONSTRUCOES;
        elseif (button_id == 102)
            ProcessarCompraInstaladorFechadura(who, item);
            cur_menu := MENU_CONSTRUCOES;
        elseif (button_id == 999)
            var guild := FindGuild(FindGuildByName(GetObjProperty(item, OBJ_FACTION_PROP)));
            if (guild)
                PagarDividaManualmente(who, guild);
            endif
            cur_menu := MENU_REINO;
        elseif (button_id >= 700 && button_id < 900)
            ProcessarAcaoTerritorio(who, button_id, item);
            cur_menu := MENU_REINO;
        else
            cur_menu := AtualizarEstadoMenu(button_id);
        endif
    endwhile
endfunction

function CreateKingdomManagementGump(who, cur_menu, item)
    var gump := CriarLayoutBase();
      case (cur_menu)
        MENU_REINO:
            ReinoGump(gump, item.serial, who); // Passando serial e who
        MENU_LEIS:
            LeisGump(gump);
        MENU_FACCOES:
            FaccoesGump(gump);
        MENU_DOACOES:
            DoacoesGump(gump, item); // Passando item completo
        MENU_CONSTRUCOES:
        MENU_SUB_CONSTRUCOES:
        MENU_SUB_FERRAMENTAS:
            ConstrucoesGump(gump, item); // Passando item completo - agora dispatcher interno
        MENU_GUERRA:
            GuerraGump(gump);
        default:
            DoacoesGump(gump, item); // Passando item completo
    endcase
    return gump;
endfunction

function CriarLayoutBase()
    var gump := GFCreateGump();
    GFGumpPicTiled(gump, 19, 19, 759, 550, 39929);
    AdicionarMoldura(gump);
    GFGumpPicTiled(gump, 32, 24, 733, 29, 9354);
    
    // Adiciona moldura secundária ANTES dos botões para ficar atrás
    if (current_main_menu == MENU_CONSTRUCOES)
        AdicionarMolduraSecundaria(gump);
    endif
    
    AdicionarBotoesNavegacao(gump);
    
    return gump;
endfunction

function AdicionarMoldura(byref gump)
    var molduras := array{
        struct{ x := 0, y := 5, width := 35, height := 36, gump := 39925 },
        struct{ x := 33, y := 5, width := 729, height := 21, gump := 39926 },
        struct{ x := 0, y := 41, width := 21, height := 539, gump := 39928 },
        struct{ x := 759, y := 5, width := 35, height := 36, gump := 39927 },
        struct{ x := 759, y := 36, width := 37, height := 534, gump := 39930 },
        struct{ x := 0, y := 561, width := 37, height := 33, gump := 39931 },
        struct{ x := 33, y := 561, width := 730, height := 33, gump := 39932 },
        struct{ x := 759, y := 561, width := 36, height := 33, gump := 39933 }
    };
    foreach moldura in (molduras)
        GFGumpPicTiled(gump, moldura.x, moldura.y, moldura.width, moldura.height, moldura.gump);
    endforeach
endfunction

function AdicionarMolduraSecundaria(byref gump)
    // Moldura para a segunda linha de navegação (Projetos/Ferramentas)
    // Reduzida 30 pixels de cada lado: X=62 (32+30), largura=673 (733-60)
    GFGumpPicTiled(gump, 92, 55, 643, 32, 9354);
endfunction

function AdicionarBotoesNavegacao(byref gump)
    var textos := array{"Reino", "Leis", "Facções", "Doações", "Construções", "Guerra"};
    var x_positions := array{85, 185, 285, 395, 505, 635};
    var botoes := array{BOTAO_REINO, BOTAO_LEIS, BOTAO_FACCOES, BOTAO_DOACOES, BOTAO_CONSTRUCOES, BOTAO_GUERRA};
    
    // Adiciona botões principais
    for i := 1 to 6
        var gump_button := 2151;
        var text_color := 53;
        if (button_states[i])
            gump_button := 2153;
            text_color := 230;
        endif
        GFTextLine(gump, x_positions[i], 27, text_color, textos[i]);
        GFAddButton(gump, x_positions[i] - 35, 23, gump_button, gump_button, GF_CLOSE_BTN, botoes[i]);
    endfor
    
    // Adiciona sub-botões apenas se Construções estiver ativo
    if (current_main_menu == MENU_CONSTRUCOES)
        var sub_textos := array{"Projetos", "Ferramentas"};
        var sub_x_positions := array{200, 550}; // Posicionamento das sub-abas
        var sub_botoes := array{BOTAO_SUB_CONSTRUCOES, BOTAO_SUB_FERRAMENTAS};
        
        for i := 1 to 2
            var gump_button := 2151;
            var text_color := 53;
            if (sub_button_states[i])
                gump_button := 2153;
                text_color := 230;
            endif
            GFTextLine(gump, sub_x_positions[i], 60, text_color, sub_textos[i]); // Segunda linha
            GFAddButton(gump, sub_x_positions[i] - 35, 56, gump_button, gump_button, GF_CLOSE_BTN, sub_botoes[i]);
        endfor
    endif
endfunction

function AtualizarEstadoMenu(input)
    case (input)
        BOTAO_REINO: 
            button_states := array{1, 0, 0, 0, 0, 0}; 
            current_main_menu := MENU_REINO;
            sub_button_states := array{0, 0};
            return MENU_REINO;
        BOTAO_LEIS: 
            button_states := array{0, 1, 0, 0, 0, 0}; 
            current_main_menu := MENU_LEIS;
            sub_button_states := array{0, 0};
            return MENU_LEIS;
        BOTAO_FACCOES: 
            button_states := array{0, 0, 1, 0, 0, 0}; 
            current_main_menu := MENU_FACCOES;
            sub_button_states := array{0, 0};
            return MENU_FACCOES;
        BOTAO_DOACOES: 
            button_states := array{0, 0, 0, 1, 0, 0}; 
            current_main_menu := MENU_DOACOES;
            sub_button_states := array{0, 0};
            return MENU_DOACOES;
        BOTAO_CONSTRUCOES: 
            button_states := array{0, 0, 0, 0, 1, 0}; 
            current_main_menu := MENU_CONSTRUCOES;
            sub_button_states := array{1, 0}; // Ativa primeiro sub-botão por padrão
            return MENU_SUB_CONSTRUCOES; // Retorna o sub-menu por padrão
        BOTAO_GUERRA: 
            button_states := array{0, 0, 0, 0, 0, 1}; 
            current_main_menu := MENU_GUERRA;
            sub_button_states := array{0, 0};
            return MENU_GUERRA;
        BOTAO_SUB_CONSTRUCOES:
            sub_button_states := array{1, 0};
            return MENU_SUB_CONSTRUCOES;
        BOTAO_SUB_FERRAMENTAS:
            sub_button_states := array{0, 1};
            return MENU_SUB_FERRAMENTAS;
        default: 
            return MENU_DOACOES;
    endcase
endfunction

function ReinoGump(byref gump, item_serial, who := 0)
    var item := SystemFindObjectBySerial(CInt(item_serial));
    if (!item)
        LogError("ReinoGump", "Objeto da mesa (Serial: " + item_serial + ") não foi encontrado. Gump não pode ser renderizado.");
        GFTextMid(gump, 460, 150, 320, 38, "Erro: A mesa de gestão foi movida ou destruída.");
        return; // Retorna para evitar mais erros
    endif
    
    var mesa_faction := GetObjProperty(item, OBJ_FACTION_PROP);
    LogCritical("ReinoGump_DEBUG", "----------------- INICIANDO ReinoGump -----------------");
    LogCritical("ReinoGump_DEBUG", "1. Lendo CProp da MESA (item): GetObjProperty(item, 'faction') -> '" + mesa_faction + "'");

    var guild := FindGuild(FindGuildByName(mesa_faction));
    if (guild)
        var guild_true_name := guild.GetProp(FACTION_PROP_NAME);
        var guild_culture := guild.GetProp("culture");
        LogCritical("ReinoGump_DEBUG", "2. Encontrada GUILD ID: " + guild.guildid);
        LogCritical("ReinoGump_DEBUG", "3. Lendo CProp da GUILDA: guild.GetProp('name') -> '" + guild_true_name + "'");
        LogCritical("ReinoGump_DEBUG", "4. Lendo CProp da GUILDA: guild.GetProp('culture') -> '" + guild_culture + "'");
    else
        LogCritical("ReinoGump_DEBUG", "2. AVISO: Nenhuma GUILD encontrada para o nome '" + mesa_faction + "' lido da mesa.");
    endif
    LogCritical("ReinoGump_DEBUG", "---------------------------------------------------------");
    // ====================================================================
    
 GFResizePic(gump, 38, 60, 40267, 400, 502);
    
    var titulo := mesa_faction ? "Gestão do Reino " + mesa_faction : "Gestão do Reino";
    
    if (guild)
        var xp_info := GetGuildXPInfo(guild);
        
        // ======== DEBUG ADICIONAL PARA CULTURA ========
        LogCritical("CULTURA_DEBUG", "=== DEBUG CULTURA COMPLETO ===");
        LogCritical("CULTURA_DEBUG", "xp_info.culture (bruto): '" + xp_info.culture + "'");
        LogCritical("CULTURA_DEBUG", "Tipo da cultura: " + TypeOf(xp_info.culture));
        
        if (xp_info.culture)
            var cultura_formatada := FormatCultureForDisplay(xp_info.culture);
            LogCritical("CULTURA_DEBUG", "Cultura formatada: '" + cultura_formatada + "'");
            
            // Teste das funções individuais
            var levels_test := GetKingdomLevels(xp_info.culture);
            LogCritical("CULTURA_DEBUG", "GetKingdomLevels retornou: " + levels_test.size() + " níveis");
            if (levels_test.size() > 0)
                LogCritical("CULTURA_DEBUG", "Primeiro nível: '" + levels_test[1].name + "'");
            endif
        else
            LogCritical("CULTURA_DEBUG", "CULTURA É NULA/VAZIA!");
        endif
        LogCritical("CULTURA_DEBUG", "================================");
        // ======== FIM DEBUG CULTURA ========
        
         // ==========================================================
        // >>>>> ÁREA DO LAYOUT AJUSTADA <<<<<
        // ==========================================================
        
        // Posição inicial do quadrado principal
        GFResizePic(gump, 460, 70, 9350, 320, 200); 
        GFTextMid(gump, 460, 75, 320, 2100, titulo);

        var y_reino := 95;
        var x_label := 470;
        var x_value := 580;

        GFTextLine(gump, x_label, y_reino, 2100, "Reino Atual:");
        GFTextLine(gump, x_value, y_reino, 53, (xp_info.level_name ?: "Nível " + xp_info.current_level));
        y_reino += 20;

        if (xp_info.culture)
            var cultura_display := FormatCultureForDisplay(xp_info.culture);
            GFTextLine(gump, x_label, y_reino, 2100, "Cultura:");
            GFTextLine(gump, x_value, y_reino, 1153, cultura_display);
            y_reino += 20;
        endif

        if (!xp_info.is_max_level)
            var proximo_reino := GetGuildLevelName(xp_info.current_level + 1, xp_info.culture);
            GFTextLine(gump, x_label, y_reino, 2100, "Próximo:");
            GFTextLine(gump, x_value, y_reino, 1153, proximo_reino);
            y_reino += 20;
        endif
        
        var territories := GetGuildTerritories(mesa_faction);
        var weekly_cost := CalcularCustoUpkeep(guild, territories);
        GFTextLine(gump, x_label, y_reino, 2100, "Custo Semanal:");
        GFTextLine(gump, x_value, y_reino, 1153, CStr(weekly_cost) + " cobre");
        y_reino += 20;

        var df := SafeOpenDataFile(KINGDOM_RESOURCE_DATAFILE);
        var elem_name := NormalizarNomeElementoFaccao(mesa_faction);
        var populacao := "N/A";
        var moral := "N/A";

        if(df && elem_name != error)
            var elem := SafeFindElement(df, elem_name);
            if (elem)
                var recursos := GetElementProp(elem, "recursos", 0);
                if (recursos)
                    populacao := CStr(CInt(recursos.populacao));
                    moral := CStr(CInt(recursos.moral)) + "%";
                endif
            endif
        endif

        GFTextLine(gump, x_label, y_reino, 2100, "População:");
        GFTextLine(gump, x_label + 70, y_reino, 1153, populacao);
        GFTextLine(gump, x_label + 150, y_reino, 2100, "Moral:");
        GFTextLine(gump, x_label + 200, y_reino, 1153, moral);
        y_reino += 25;

        if (!xp_info.is_max_level)
            GFResizePic(gump, x_label, y_reino, 9200, 280, 20);         
            var progress_width := CInt((xp_info.progress_percentage * 280) / 100);
            if (progress_width > 0)
                GFResizePic(gump, x_label, y_reino, 48, progress_width, 20);
            endif
            var percentage_text := CStr(CInt(xp_info.progress_percentage)) + "%";
            GFTextMid(gump, x_label, y_reino + 2, 280, 1153, percentage_text);
        else
            GFTextMid(gump, x_label, y_reino, 280, 53, "REINO MÁXIMO ATINGIDO");
        endif
        
        var divida_acumulada := CInt(SafeGetGuildProperty(guild, "divida_upkeep", 0));
        if (divida_acumulada > 0)
            var y_divida := y_reino + 30; // Posição abaixo da barra de progresso
            GFTextLine(gump, x_label, y_divida, 38, "Dívida de UpKeep: " + divida_acumulada);
            GFAddButton(gump, x_label + 200, y_divida - 5, 2074, 2075, GF_CLOSE_BTN, 999);
        endif
    endif

    var rect_df := SafeOpenDataFile(":architect:areas");
    if (rect_df)
        var territorios_visiveis := array{};
        
        // Usar a variável 'item' que foi buscada com segurança no início
        var mesa_faction_local := GetObjProperty(item, OBJ_FACTION_PROP);
        
        foreach elem_name in (rect_df.keys())
            var territory_info := TM_GetTerritoryInfo(elem_name);
            if (!territory_info) continue; endif
            
            var territory_id := territory_info.id ?: "";
            var faction := territory_info.faction;
            
            if (faction && faction != DEFAULT_FACTION && (!mesa_faction_local || mesa_faction_local == KINGDOM_FACTION || faction == mesa_faction_local))
                territorios_visiveis.append(struct{ "name" := elem_name, "id" := territory_id, TERRITORY_FACTION_PROP := faction });
            endif
            sleepms(2);
        endforeach
        
        GFResizePic(gump, 460, 300, 9350, 320, 212);
        GFTextLine(gump, 485, 310, 53, "Nome do Terreno");
        GFTextLine(gump, 690, 310, 53, "Info");
        GFTextLine(gump, 730, 310, 53, "Carav.");
        
        var y_terr := 330;
        var territorios_mostrados := 0;
        
        var guild_lookup := FindGuild(FindGuildByName(mesa_faction_local));
        var contratos_ativos_lookup := dictionary{};
        if (guild_lookup)
            var contratos_prop := guild_lookup.GetProp("caravan_contracts");
            if (contratos_prop && TypeOf(contratos_prop) == "Array")
                foreach contrato in (contratos_prop)
                    if (contrato && CInt(contrato.next_payment_due) > polcore().systime)
                        contratos_ativos_lookup[CStr(contrato.origin_territory_id)] := 1;
                    endif
                endforeach
            endif
        endif

        foreach territorio in (territorios_visiveis)
            var territory_info_loop := TM_GetTerritoryInfo(territorio.id);
            var is_capital := territory_info_loop.is_capital;
            
            GFTextLine(gump, 470, y_terr+5, 2100, territorios_mostrados+1 + ".");
            
            if (is_capital)
                GFTextLine(gump, 485, y_terr+5, 230, territorio.name + " [CAPITAL]");
            else
                GFTextLine(gump, 485, y_terr+5, 53, territorio.name);
            endif
            
            GFAddButton(gump, 693, y_terr+5, 0x4B9, 0x4BA, GF_CLOSE_BTN, 800 + territorios_mostrados);
            
            var caravana_ativa := contratos_ativos_lookup.exists(CStr(territorio.id));
            var caravana_gump_id := caravana_ativa ? 2361 : 2360;

            if (!is_capital)
                 GFAddButton(gump, 740, y_terr+5, caravana_gump_id, caravana_gump_id, GF_CLOSE_BTN, 700 + territorios_mostrados);
            endif

            y_terr += 35;
            territorios_mostrados += 1;
            if (territorios_mostrados >= 5) break; endif
            sleepms(2);
        endforeach

        if (territorios_mostrados == 0)
            var msg := mesa_faction_local ? "Não há territórios controlados por " + mesa_faction_local + "." : "Não há territórios controlados por facções.";
            GFTextMid(gump, 540, 350, 150, 38, msg);
        endif
    else
        GFTextMid(gump, 620, 350, 150, 38, "Sistema de territórios indisponível.");
    endif
    
    return gump;
endfunction

function ProcessarAcaoTerritorio(who, input, item)
    if (input >= 700 && input < 800)
        // Botão de visualizar mapa do território
        var territorio_idx := input - 700;
        MostrarMapaTerritorio(who, territorio_idx, item);
        return 0; // Retornar 0 para continuar no gump
    elseif (input >= 800 && input < 900)
        // Botão de informações do território
        var territorio_idx := input - 800;
        var resultado := MostrarInformacoesTerritorio(who, territorio_idx, item);
        return resultado; // Retornar o resultado da operação
    endif
    
    return 0; // Padrão: continuar no gump
endfunction

// Em :faccao:gestao_use.src
// SUBSTITUA A FUNÇÃO ANTIGA POR ESTA

function MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao)
    LogDebug("gestao_use_mapa_v3", "MostrarMapaTerritorio v3: Index Clicado=" + index_territorio_clicado_no_gump_anterior);

    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        SendSysMessage(who, "Sistema de territórios indisponível.");
        return 0;
    endif

    var mesa_faction_name := GetObjProperty(item_mesa_gestao, OBJ_FACTION_PROP);
    if (!mesa_faction_name)
        SendSysMessage(who, "Erro: Não foi possível determinar a facção da mesa de gestão.");
        return 0;
    endif
    LogDebug("gestao_use_mapa_v3", "Facção da Mesa: " + mesa_faction_name);

    var guild_obj_mapa := FindGuild(FindGuildByName(mesa_faction_name));
    if (!guild_obj_mapa)
        SendSysMessage(who, "Erro crítico: Objeto da guilda não encontrado para " + mesa_faction_name);
        return 0;
    endif

    // 1. Obter todos os territórios DA FACÇÃO da mesa e identificar a capital
    var territorios_nao_capital_da_faccao := array{};
    var capital_da_faccao_info := 0;
    var todos_os_territorios_keys := rect_df.keys();

    foreach elem_key in todos_os_territorios_keys
        var terr_info_loop := TM_GetTerritoryInfo(elem_key);
        if (terr_info_loop && terr_info_loop.faction == mesa_faction_name)
            if (terr_info_loop.id && TM_IsTerritoryCapital(terr_info_loop.id))
                capital_da_faccao_info := terr_info_loop;
            else
                territorios_nao_capital_da_faccao.append(terr_info_loop);
            endif
        endif
        SleepMS(1);
    endforeach;

    // Montar a lista final ordenada: capital primeiro
    var todos_territorios_da_faccao_ordenados := array{};
    if (capital_da_faccao_info)
        todos_territorios_da_faccao_ordenados.append(capital_da_faccao_info);
        LogDebug("gestao_use_mapa_v3", "Capital da facção '" + mesa_faction_name + "': " + capital_da_faccao_info.name + " (ID: " + capital_da_faccao_info.id + ")");
    else
        SendSysMessage(who, "Aviso: Sua facção não possui uma capital designada. As caravanas não podem ser gerenciadas efetivamente.");
    endif

    foreach terr_nao_capital_loop in territorios_nao_capital_da_faccao
        todos_territorios_da_faccao_ordenados.append(terr_nao_capital_loop);
    endforeach;

    // Criação do Gump
    var gump_mapa := GFCreateGump();
    var gump_width := 550;
    var num_territorios_listados := todos_territorios_da_faccao_ordenados.size();
    var gump_height := 150 + (num_territorios_listados * 30);
    if (gump_height < 400) gump_height := 400; endif
    if (gump_height > 650) gump_height := 650; endif

    GFResizePic(gump_mapa, 0, 0, BKGND_BLUESLAB_FACCAO, gump_width, gump_height);
    GFResizePic(gump_mapa, 15, 15, BKGND_STONESLAB, gump_width - 30, gump_height - 30);
    GFTextMid(gump_mapa, 20, 25, gump_width - 40, 2100, "Gerenciar Caravanas para Facção: " + mesa_faction_name);

    var y_gump := 65;

    if (!capital_da_faccao_info)
        GFTextLine(gump_mapa, 30, y_gump, 38, "Nenhuma capital designada. Contratos de caravana não disponíveis.");
        y_gump += 20;
    else
        GFTextLine(gump_mapa, 30, y_gump, 1153, "Capital da Facção (Destino das Caravanas): " + capital_da_faccao_info.name);
        
        // ========================================================
        // >>>>> INÍCIO DA MELHORIA: EXIBIR SALDO <<<<<
        // ========================================================
        var capital_chest := FindFactionChest(mesa_faction_name, capital_da_faccao_info.id);
        var saldo_capital := 0;
        if (capital_chest)
            // Usar a função que você já tem para contar moedas
            saldo_capital := CalculaRecursosDisponiveis(capital_chest);
        endif

        GFTextLine(gump_mapa, 350, y_gump, 1153, "Saldo da Capital: " + saldo_capital + " moedas");
        // ========================================================
        // >>>>> FIM DA MELHORIA <<<<<
        // ========================================================
        
        y_gump += 25;
    endif

    GFResizePic(gump_mapa, 20, y_gump, BKGND_STONESLAB - 100, gump_width - 40, 2);
    y_gump += 15;
    GFTextLine(gump_mapa, 30, y_gump, 1153, "Territórios de Origem da Facção (" + mesa_faction_name + "):");
    y_gump += 25;


    GFResizePic(gump_mapa, 20, y_gump, BKGND_STONESLAB - 100, gump_width - 40, 2);
    y_gump += 15;
    GFTextLine(gump_mapa, 30, y_gump, 1153, "Territórios de Origem da Facção (" + mesa_faction_name + "):");
    y_gump += 25;

    // IDs dos botões
    var btn_id_contratar_base := 10;
    var btn_id_cancelar_base  := 1000;
    var btn_id_pagar_divida_base := 2000; 
    var territorio_gump_list_index := 0;

    // Carregar contratos de caravana
    var contratos_ativos_da_faccao := guild_obj_mapa.GetProp("caravan_contracts");
    if (!contratos_ativos_da_faccao || TypeOf(contratos_ativos_da_faccao) != "Array")
        contratos_ativos_da_faccao := array{};
    endif
    var contratos_dict_lookup := dictionary{};
    foreach contrato_existente_loop in contratos_ativos_da_faccao
        if (contrato_existente_loop && contrato_existente_loop.origin_territory_id)
            contratos_dict_lookup[CStr(contrato_existente_loop.origin_territory_id)] := contrato_existente_loop;
        endif
    endforeach;

    if (num_territorios_listados == 0)
        GFTextLine(gump_mapa, 30, y_gump, 38, "Nenhum território encontrado para esta facção.");
        y_gump += 20;
    else
        foreach terr_info_iter in todos_territorios_da_faccao_ordenados
            territorio_gump_list_index += 1;
            var nome_exib_iter := terr_info_iter.name;
            var id_exib_origem_iter := CStr(terr_info_iter.id);
            var x_nome_iter := 30;
            var x_status_iter := x_nome_iter + 220;
            var x_botao_iter  := x_status_iter + 140;

            GFTextLine(gump_mapa, x_nome_iter, y_gump, 1153, territorio_gump_list_index + ". " + nome_exib_iter);

            if (capital_da_faccao_info && id_exib_origem_iter == CStr(capital_da_faccao_info.id))
                GFTextLine(gump_mapa, x_status_iter, y_gump, 230, "[CAPITAL - Destino]");
            elseif (capital_da_faccao_info)
                var contrato_deste_territorio := contratos_dict_lookup[id_exib_origem_iter];
                
                if (contrato_deste_territorio)
                    if (contrato_deste_territorio.payment_status == "due")
                        // DÍVIDA PENDENTE
                        GFTextLine(gump_mapa, x_status_iter, y_gump, 38, "Dívida de Caravana");
                        GFAddButton(gump_mapa, x_botao_iter, y_gump - 2, BTN_CONTRATAR_GFX_NORMAL, BTN_CONTRATAR_GFX_OVER, GF_CLOSE_BTN, btn_id_pagar_divida_base + territorio_gump_list_index);
                        GFTextLine(gump_mapa, x_botao_iter + 25, y_gump, 38, "Pagar (" + contrato_deste_territorio.weekly_cost + ")");
                    else // Status é "active" ou indefinido (considera ativo)
                        // CARAVANA ATIVA
                        GFTextLine(gump_mapa, x_status_iter, y_gump, 63, "Caravana ATIVA");
                        GFAddButton(gump_mapa, x_botao_iter, y_gump - 2, BTN_CANCELAR_GFX_NORMAL, BTN_CANCELAR_GFX_NORMAL, GF_CLOSE_BTN, btn_id_cancelar_base + territorio_gump_list_index);
                        GFTextLine(gump_mapa, x_botao_iter + 25, y_gump, 63, "Cancelar");
                    endif
                else
                    // NENHUM CONTRATO (INATIVA)
                    GFTextLine(gump_mapa, x_status_iter, y_gump, 38, "Caravana INATIVA");
                    GFAddButton(gump_mapa, x_botao_iter, y_gump - 2, BTN_CONTRATAR_GFX_NORMAL, BTN_CONTRATAR_GFX_OVER, GF_CLOSE_BTN, btn_id_contratar_base + territorio_gump_list_index);
                    GFTextLine(gump_mapa, x_botao_iter + 25, y_gump, 53, "Contratar");
                endif
            endif
            y_gump += 30;
        endforeach;
    endif

    GFAddButton(gump_mapa, CInt(gump_width / 2) - 20, gump_height - 45, 2128, 2129, GF_CLOSE_BTN, 0);

    var input_mapa := GFSendGump(who, gump_mapa);
    var btn_clicado_gump := input_mapa[0];

    // Processar clique no botão Contratar
    if (btn_clicado_gump >= btn_id_contratar_base && btn_clicado_gump < btn_id_cancelar_base)
        var idx_na_lista_ordenada := btn_clicado_gump - btn_id_contratar_base;
        if (idx_na_lista_ordenada > 0 && idx_na_lista_ordenada <= todos_territorios_da_faccao_ordenados.size())
            var terr_para_contratar_info_clicado := todos_territorios_da_faccao_ordenados[idx_na_lista_ordenada];
            ContratarCaravanaTerritorioIndividual(who, terr_para_contratar_info_clicado.id, capital_da_faccao_info.id, mesa_faction_name);
        endif
        MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao);
    
    // Processar clique no botão Pagar Dívida
    elseif (btn_clicado_gump >= btn_id_pagar_divida_base)
        var idx_na_lista_ordenada_divida := btn_clicado_gump - btn_id_pagar_divida_base;
        if (idx_na_lista_ordenada_divida > 0 && idx_na_lista_ordenada_divida <= todos_territorios_da_faccao_ordenados.size())
            var terr_para_pagar_info_clicado := todos_territorios_da_faccao_ordenados[idx_na_lista_ordenada_divida];
            PagarDividaCaravana(who, terr_para_pagar_info_clicado.id, mesa_faction_name);
        endif
        MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao);

    // Processar clique no botão Cancelar
    elseif (btn_clicado_gump >= btn_id_cancelar_base && btn_clicado_gump < btn_id_pagar_divida_base)
        var idx_na_lista_ordenada_cancel := btn_clicado_gump - btn_id_cancelar_base;
        if (idx_na_lista_ordenada_cancel > 0 && idx_na_lista_ordenada_cancel <= todos_territorios_da_faccao_ordenados.size())
            var terr_para_cancelar_info_clicado := todos_territorios_da_faccao_ordenados[idx_na_lista_ordenada_cancel];
            CancelarCaravanaTerritorioIndividual(who, terr_para_cancelar_info_clicado.id, mesa_faction_name);
        endif
        MostrarMapaTerritorio(who, index_territorio_clicado_no_gump_anterior, item_mesa_gestao);
    endif
endfunction


