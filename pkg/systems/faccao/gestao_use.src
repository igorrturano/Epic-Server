const BKGND_BLUESLAB := 9200;
const BKGND_STONESLAB := 3500;

const BOTAO_REINO := 1;
const BOTAO_LEIS := 2;
const BOTAO_FACCOES := 3;
const BOTAO_DOACOES := 4;
const BOTAO_CONSTRUCOES := 5;
const BOTAO_GUERRA := 6;

const MENU_INTRO := 0;
const MENU_REINO := 1;
const MENU_LEIS := 2;
const MENU_FACCOES := 3;
const MENU_DOACOES := 4;
const MENU_CONSTRUCOES := 5;
const MENU_GUERRA := 6;
var button_states := array{0, 0, 0, 0, 0, 0};

program gestao_use(who, item)
    if (!who || !item)
        SendSysMessage(who, "Erro: who ou item é nulo");
        return 0;
    endif

    if (!CanAccessGestao(who))
        SendSysMessage(who, "Você não tem permissão para acessar a interface de gestão");
        return 0;
    endif
    
    SendSysMessage(who, "Acessando interface de gestão do Reino");
    ShowKingdomManagementGump(who, item);
    
    return 1;
endprogram

function CanAccessGestao(who, item)
    // Check if player is faction leader or has GM access
    if (who.cmdlevel >= 3)
        return 1; // GM access
    endif
    
    return IsGuildLeader(who);
endfunction

function ShowKingdomManagementGump(who, item)
    var cur_menu := MENU_DOACOES;
    var input;

    repeat
        var gump := CreateKingdomManagementGump(who, cur_menu, item);
        input := GFSendGump(who, gump);
        
        if (input[0] >= 700 && input[0] < 900)
            ProcessarAcaoTerritorio(who, input[0], item);
            continue; // Continuar no loop do gump
        elseif (input[0] != 0)
            cur_menu := AtualizarEstadoMenu(input[0]);
        endif
    until (input[0] == 0);
endfunction

function CreateKingdomManagementGump(who, cur_menu, item)
    var gump := CriarLayoutBase();
    
    case (cur_menu)
        MENU_REINO:
            ReinoGump(gump);
        MENU_LEIS:
            LeisGump(gump);
        MENU_FACCOES:
            FaccoesGump(gump);
        MENU_DOACOES:
            DoacoesGump(gump, item);
        MENU_CONSTRUCOES:
            ConstrucoesGump(gump);
        MENU_GUERRA:
            GuerraGump(gump);
        default:
            DoacoesGump(gump, item);
    endcase

    return gump;
endfunction

function CriarLayoutBase()
    var gump := GFCreateGump();
    
    GFGumpPicTiled(gump, 19, 19, 759, 550, 39929);
    AdicionarMoldura(gump);
    GFGumpPicTiled(gump, 32, 24, 733, 29, 9354);
    AdicionarBotoesNavegacao(gump);
    
    return gump;
endfunction

function AdicionarMoldura(byref gump)
    var molduras := array{
        struct{ x := 0, y := 5, width := 35, height := 36, gump := 39925 },
        struct{ x := 33, y := 5, width := 729, height := 21, gump := 39926 },
        struct{ x := 0, y := 41, width := 21, height := 539, gump := 39928 },
        struct{ x := 759, y := 5, width := 35, height := 36, gump := 39927 },
        struct{ x := 759, y := 36, width := 37, height := 534, gump := 39930 },
        struct{ x := 0, y := 561, width := 37, height := 33, gump := 39931 },
        struct{ x := 33, y := 561, width := 730, height := 33, gump := 39932 },
        struct{ x := 759, y := 561, width := 36, height := 33, gump := 39933 },
        struct{ x := 444, y := 60, width := 8, height := 502, gump := 39928 }
    };

    foreach moldura in molduras
        GFGumpPicTiled(gump, moldura.x, moldura.y, moldura.width, moldura.height, moldura.gump);
    endforeach
endfunction

function AdicionarBotoesNavegacao(byref gump)
    var textos := array{"Reino", "Leis", "Facções", "Doações", "Construções", "Guerra"};
    var x_positions := array{85, 185, 285, 395, 505, 635};
    var botoes := array{BOTAO_REINO, BOTAO_LEIS, BOTAO_FACCOES, BOTAO_DOACOES, BOTAO_CONSTRUCOES, BOTAO_GUERRA};
    
    for i := 1 to 6
        var gump_button := 2151;
        var text_color := 53;
        
        if (button_states[i])
            gump_button := 2153;
            text_color := 230;
        endif
        
        GFTextLine(gump, x_positions[i], 27, text_color, textos[i]);
        GFAddButton(gump, x_positions[i] - 35, 23, gump_button, gump_button, GF_CLOSE_BTN, botoes[i]);
    endfor
endfunction

function AtualizarEstadoMenu(input)
    case (input)
        BOTAO_REINO:
            button_states := array{1, 0, 0, 0, 0, 0};
            return MENU_REINO;
        BOTAO_LEIS:
            button_states := array{0, 1, 0, 0, 0, 0};
            return MENU_LEIS;
        BOTAO_FACCOES:
            button_states := array{0, 0, 1, 0, 0, 0};
            return MENU_FACCOES;
        BOTAO_DOACOES:
            button_states := array{0, 0, 0, 1, 0, 0};
            return MENU_DOACOES;
        BOTAO_CONSTRUCOES:
            button_states := array{0, 0, 0, 0, 1, 0};
            return MENU_CONSTRUCOES;
        BOTAO_GUERRA:
            button_states := array{0, 0, 0, 0, 0, 1};
            return MENU_GUERRA;
        default:
            return MENU_DOACOES;
    endcase
endfunction

function ReinoGump(byref gump)
    // Manter a parte visual existente
    GFResizePic(gump, 38, 60, 40267, 400, 502);
    GFTextMid(gump, 490, 60, 263, 2100, "Gestão do Reino");
    
    // Adicionar a visualização de territórios
    var rect_df := OpenDataFile(":architect:areas");
    if (rect_df)
        // Criar um único background para a área de territórios
        GFResizePic(gump, 460, 100, 9350, 320, 300);
        
        // Adicionar cabeçalhos
        GFTextLine(gump, 485, 105, 53, "Nome do Terreno");
        GFTextLine(gump, 690, 105, 53, "Info");
        GFTextLine(gump, 730, 105, 53, "Aliados");
        
        var y := 140; // Começar após os cabeçalhos
        var territorios_mostrados := 0;
        
        foreach elem_name in (rect_df.keys())
            var elem := rect_df.FindElement(elem_name);
            var faction := elem.GetProp("Faction");
            
            // Se tiver uma facção controlando, mostrar na lista
            if (faction && faction != "Selvagem")
                // Número e nome do território (sem background adicional)
                GFTextLine(gump, 470, y+5, 2100, territorios_mostrados+1 + ".");
                GFTextLine(gump, 485, y+5, 53, elem_name);
                
                // Botões de informação e aliados
                GFAddButton(gump, 693, y+5, 0x4B9, 0x4BA, GF_CLOSE_BTN, 700 + territorios_mostrados);
                GFAddButton(gump, 740, y+5, 0x4B9, 0x4BA, GF_CLOSE_BTN, 800 + territorios_mostrados);
                
                y += 35; // Espaçamento entre territórios
                territorios_mostrados += 1;
                
                // Limite para não sobrecarregar a interface
                if (territorios_mostrados >= 10)
                    break;
                endif
            endif
            sleepms(2);
        endforeach
        
        if (territorios_mostrados == 0)
            GFTextMid(gump, 460, 200, 150, 38, "Não há territórios controlados por facções.");
        endif
    else
        GFTextMid(gump, 620, 200, 150, 38, "Sistema de territórios indisponível.");
    endif
    
    return gump;
endfunction

function ProcessarAcaoTerritorio(who, input, item)
    if (input >= 700 && input < 800)
        // Botão de visualizar mapa do território
        var territorio_idx := input - 700;
        MostrarMapaTerritorio(who, territorio_idx);
    elseif (input >= 800 && input < 900)
        // Botão de informações do território
        var territorio_idx := input - 800;
        MostrarInformacoesTerritorio(who, territorio_idx, item);
    endif
endfunction

function MostrarMapaTerritorio(who, index)
    var rect_df := OpenDataFile(":architect:areas");
    if (!rect_df) 
        return SendSysMessage(who, "Sistema de territórios indisponível.");
    endif
    
    var territorios := array{};
    foreach elem_name in (rect_df.keys())
        var elem := rect_df.FindElement(elem_name);
        if (elem.GetProp("Faction") && elem.GetProp("Faction") != "Selvagem")
            territorios.append(elem_name);
        endif
        sleepms(2);
    endforeach
    
    // Verificar se o índice é válido
    if (index < 0 || index >= territorios.size())
        return SendSysMessage(who, "Território não encontrado. Índice: " + index + ", Total: " + territorios.size());
    endif
    
    var territorio := territorios[index+1]; // Ajustando para indexação baseada em 1
    var elem := rect_df.FindElement(territorio);
    
    // Mostrar as coordenadas no mapa e oferecer teleporte
    var rect := elem.GetProp("Rect");
    var coords := SplitWords(rect);
    
    var gump := GFCreateGump();
    GFResizePic(gump, 0, 0, 9200, 400, 300);
    GFResizePic(gump, 15, 15, 9350, 370, 270);
    
    GFTextMid(gump, 20, 25, 370, 2100, "Mapa do Território: " + territorio);
    var y := 60;
    if (coords.size() >= 4)
        var x1 := CInt(coords[1]);
        var y1 := CInt(coords[2]);
        var x2 := CInt(coords[3]);
        var y2 := CInt(coords[4]);
        GFTextLine(gump, 30, y, 2100, "Coordenadas: ");
        GFTextLine(gump, 110, y, 53, rect);
        GFTextLine(gump, 30, y+20, 2100, "Facção: ");
        GFTextLine(gump, 110, y+20, 53, elem.GetProp("Faction"));
        
        // Adicionar botão de teleporte para GMs
        if (who.cmdlevel >= 3) 
            GFAddButton(gump, 30, y+50, 2117, 2118, GF_CLOSE_BTN, 1);
            GFTextLine(gump, 60, y+50, 53, "Teleportar para o território");
        endif
    endif
    
    GFAddButton(gump, 150, 250, 2128, 2129, GF_CLOSE_BTN, 0);
    
    var input := GFSendGump(who, gump);
    
    if (input[0] == 1 && who.cmdlevel >= 3)
        // Teleportar GM para o território
        var center_x := CInt((CInt(coords[1]) + CInt(coords[3])) / 2);
        var center_y := CInt((CInt(coords[2]) + CInt(coords[4])) / 2);
        var center_z := GetWorldHeight(center_x, center_y, elem.GetProp("Realm"));
        
        GFTextLine(gump_mapa, 30, y_gump, 2100, "Realm: ");
        GFTextLine(gump_mapa, 130, y_gump, 53, territory_info_selecionado.realm);
        y_gump += 35; 
    else
        GFTextLine(gump_mapa, 30, y_gump, 38, "Coordenadas do território não disponíveis.");
        y_gump += 35;
    endif; 

    // =======================================================================
    // ===== INÍCIO DO BLOCO DE CÓDIGO QUE VOCÊ FORNECEU (BOTÕES CARAVANA) =====
    // =======================================================================
    var pode_contratar_caravana := 0; // Condição geral para mostrar *qualquer* opção de caravana
    if (mesa_faction && mesa_faction != KINGDOM_FACTION) 
        if (TM_IsTerritoryCapital(territory_info_selecionado.id) && territory_info_selecionado.faction == mesa_faction)
            pode_contratar_caravana := 1;
        endif; 
    endif; 

    // --- BOTÕES DE CARAVANA ---
    var caravana_ativa_para_esta_capital := 0;
    var guild_obj_mapa := 0; 
    if (pode_contratar_caravana) // Só verifica status da caravana se as condições básicas para contratar são atendidas
        var guild_id_mapa := FindGuildByName(mesa_faction);
        if (guild_id_mapa)
            guild_obj_mapa := FindGuild(guild_id_mapa);
            if (guild_obj_mapa)
                var active_caravan_capital_id := CStr(guild_obj_mapa.GetProp("active_caravan_to_capital"));
                var caravan_until := CInt(guild_obj_mapa.GetProp("caravan_next_payment_due")); // Usar next_payment_due
                if (active_caravan_capital_id == CStr(territory_info_selecionado.id) && caravan_until > polcore().systime)
                    caravana_ativa_para_esta_capital := 1;
                endif; // Fim if (active_caravan_capital_id == ... && caravan_until > ...)
            endif; // Fim if (guild_obj_mapa)
        endif; // Fim if (guild_id_mapa)
    endif; // Fim if (pode_contratar_caravana) - Verificação do status da caravana

    if (pode_contratar_caravana) 
        if (caravana_ativa_para_esta_capital)
            // Opção de Cancelar Contrato
            GFAddButton(gump_mapa, 30, y_gump, 2117, 2118, GF_CLOSE_BTN, 2); // ID 2 para Cancelar
            GFTextLine(gump_mapa, 60, y_gump, 38, "Cancelar Contrato da Caravana"); 
            GFToolTipText(gump_mapa, "Cancela o contrato atual da caravana. Não haverá reembolso.");
            y_gump += 30;
        else
            // Opção de Contratar
            GFAddButton(gump_mapa, 30, y_gump, 2117, 2118, GF_CLOSE_BTN, 1); // ID 1 para Contratar
            GFTextLine(gump_mapa, 60, y_gump, 63, "Contratar Caravana (50 Cobre a cada 3.5h)");
            GFToolTipText(gump_mapa, "Contratando a caravana, os recursos de todos os territórios da sua facção virão diretamente para o baú desta capital. Custo: 50 moedas de cobre, renovável semanalmente do tesouro da facção.");
            y_gump += 30;
        endif; // Fim if (caravana_ativa_para_esta_capital)
    endif; // Fim if (pode_contratar_caravana) - Adição dos botões
    // --- FIM DOS BOTÕES DE CARAVANA ---
    // =====================================================================
    // ===== FIM DO BLOCO DE CÓDIGO QUE VOCÊ FORNECEU =====
    // =====================================================================
    
    GFAddButton(gump_mapa, gump_width/2 - 20, gump_height - 45, 2128, 2129, GF_CLOSE_BTN, 0); 
    
    var input_mapa := GFSendGump(who, gump_mapa); 
    
    if (input_mapa[0] == 1 && pode_contratar_caravana && !caravana_ativa_para_esta_capital) 
        SendSysMessage(who, "Iniciando processo de contratação de caravana para " + territorio_selecionado_nome + "...");
        ContratarCaravanaParaCapital(who, territory_info_selecionado.id, mesa_faction);
    elseif (input_mapa[0] == 2 && pode_contratar_caravana && caravana_ativa_para_esta_capital)
        SendSysMessage(who, "Iniciando processo de cancelamento de contrato da caravana...");
        CancelarContratoCaravana(who, territory_info_selecionado.id, mesa_faction); // Você precisará criar esta função
    endif; 

    return 1; 
endfunction 



function CancelarContratoCaravana(who, capital_territory_id, faction_name)
    var guild_id := FindGuildByName(faction_name);
    if (!guild_id)
        SendSysMessage(who, "Erro: Guilda da facção '" + faction_name + "' não encontrada.");
        LogError("caravana_cancela", "Guilda '" + faction_name + "' não encontrada ao tentar cancelar caravana para capital " + capital_territory_id);
        return 0;
    endif; 

    var guild_obj := FindGuild(guild_id);

    if (guild_obj)
        var active_caravan_capital_id := CStr(guild_obj.GetProp("active_caravan_to_capital"));
        var caravan_until := CInt(guild_obj.GetProp("caravan_next_payment_due")); 

        if (active_caravan_capital_id == CStr(capital_territory_id) && caravan_until > polcore().systime)
            if (YesNo(who, "Tem certeza que deseja cancelar o contrato da caravana para esta capital? Não haverá reembolso da semana/período atual."))
                guild_obj.EraseProp("active_caravan_to_capital");
                guild_obj.EraseProp("caravan_contract_start_time");
                guild_obj.EraseProp("caravan_next_payment_due");
                guild_obj.EraseProp("caravan_weekly_cost");

                SendSysMessage(who, "Contrato da caravana cancelado com sucesso.");
                LogInfo("caravana_cancela", "Facção " + faction_name + " cancelou contrato da caravana para capital " + capital_territory_id);
                
                var event_data_cancel := struct;
                event_data_cancel.+faction := faction_name;
                // A LINHA PROBLEMÁTICA FOI REMOVIDA DAQUI

                TM_NotifyTerritoryChange(capital_territory_id, "caravan_deactivated", event_data_cancel);
                return 1; 
            else
                SendSysMessage(who, "Cancelamento abortado.");
                return 0; 
            endif; 
        else
            SendSysMessage(who, "Nenhuma caravana ativa encontrada para esta capital ou o contrato já expirou.");
            LogInfo("caravana_cancela", "Tentativa de cancelar caravana para " + capital_territory_id + " (facção " + faction_name + ") falhou: Nenhuma caravana ativa/válida. ID na prop: " + active_caravan_capital_id + ", Expira em: " + caravan_until);
            return 0; 
        endif; 
    else
        SendSysMessage(who, "Erro ao acessar dados da guilda.");
        LogError("caravana_cancela", "Falha ao obter objeto da guilda para ID " + guild_id + " (facção " + faction_name + ") ao tentar cancelar caravana.");
        return 0; 
    endif; 
endfunction

