    GFTextLine(gump, 510, y_ferramentas + 25, 1153, "Custo: 500 moedas de cobre");
    GFTextLine(gump, 510, y_ferramentas + 40, 1153, "Apenas para arquitetos de guilda");
    GFAddButton(gump, 720, y_ferramentas + 20, 4005, 4007, GF_CLOSE_BTN, 100); // Botão Comprar Mapeador
    y_ferramentas += 90;
    
    // Instalador de Fechadura - Item para instalar fechaduras em portas
    GFResizePic(gump, 450, y_ferramentas, 9350, 310, 80);
    GFTilePic(gump, 460, y_ferramentas + 10, 0xD5D1); // Graphic do Instalador de Fechadura
    GFTextLine(gump, 510, y_ferramentas + 10, 53, "Instalador de Fechadura");
    GFTextLine(gump, 510, y_ferramentas + 25, 1153, "Custo: 300 moedas de cobre");
    GFTextLine(gump, 510, y_ferramentas + 40, 1153, "Para instalar fechaduras em portas");
    GFAddButton(gump, 720, y_ferramentas + 20, 4005, 4007, GF_CLOSE_BTN, 102); // Botão Comprar Instalador
