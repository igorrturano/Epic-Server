// Funções auxiliares (sem alterações)
function GetMinimumTerritoryInterval()
    // ... código sem alterações ...
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        return 3600; 
    endif
    
    var min_interval := 3600; 
    var log_msg := ""; 

    foreach rect_name in (rect_df.keys())
        var elem := SafeFindElement(rect_df, rect_name);
        if (!elem)
            continue;
        endif
        var faction := GetTerritoryFaction(elem);
        
        if (faction && faction != DEFAULT_FACTION && faction != "")
            var territory_interval := CInt(GetElementProp(elem, "ResourceInterval", 60));
            var interval_seconds := territory_interval * 60;
            
            if (interval_seconds < min_interval)
                min_interval := interval_seconds;
            endif
        endif
        sleepms(2);
    endforeach
    
    log_msg := "Menor intervalo encontrado nos territórios: " + min_interval + " segundos (" + (min_interval/60) + " minutos)";
    LogDebug("start_DEBUG", log_msg);
    
    if (min_interval < 60)
        min_interval := 60;
    endif
    
    return CInt(min_interval / 2);
endfunction

function start_resource_controller()
    // ... código sem alterações ...
    var log_msg := ""; 
    var last_time := CInt(GetGlobalProperty("last_execution"));
    if (last_time == error)
        last_time := 0;
    endif
    
    var current_time := polcore().systime;
    var time_since_last := current_time - last_time;
    
    var dynamic_interval := GetMinimumTerritoryInterval();
    var effective_interval := (dynamic_interval < CYCLE_WAIT) ? dynamic_interval : CYCLE_WAIT;
    var should_execute_based_on_time := (last_time == 0 || time_since_last >= effective_interval);

    var controller_is_already_running := IsProcessRunning("ResourceController");

    LogDebug("start_DEBUG", "Verificando ResourceController:");
    LogDebug("start_DEBUG", "  - CurrentTime: " + current_time);
    LogDebug("start_DEBUG", "  - LastTime: " + last_time);
    LogDebug("start_DEBUG", "  - TimeSinceLast: " + time_since_last + " segundos");
    LogDebug("start_DEBUG", "  - StaticInterval: " + CYCLE_WAIT + " segundos");
    LogDebug("start_DEBUG", "  - DynamicInterval: " + dynamic_interval + " segundos");
    LogDebug("start_DEBUG", "  - EffectiveInterval: " + effective_interval + " segundos");
    LogDebug("start_DEBUG", "  - ShouldExecuteBasedOnTime: " + should_execute_based_on_time);
    LogDebug("start_DEBUG", "  - ControllerIsAlreadyRunning (ProcessRegistry): " + controller_is_already_running);

    if (controller_is_already_running == 1)
        LogInfo("start_DEBUG", "- DECISÃO: NÃO INICIAR ResourceController. Já está rodando (detectado pelo process_registry).");
        if (should_execute_based_on_time)
            SetGlobalProperty("last_execution", current_time);
            LogInfo("start_DEBUG", "  - 'last_execution' atualizado para o ciclo atual pois o tempo de execução passou, mas o processo já estava ativo.");
        endif
        return; 
    elseif (controller_is_already_running == error)
        LogError("start_DEBUG", "- ERRO: Falha ao verificar IsProcessRunning para ResourceController. Tentando iniciar de qualquer forma se o tempo permitir.");
    endif

    if (should_execute_based_on_time)
        log_msg := "- DECISÃO: INICIAR ResourceController agora (PID do start.src: " + GetPid() + ")";
        LogInfo("start_DEBUG", log_msg);
        log_msg := "  Motivo: " + (last_time == 0 ? "Primeira execução" : "Intervalo de " + effective_interval + "s atingido") + " e processo não detectado como ativo.";
        LogInfo("start_DEBUG", log_msg);
        
        var resource_script := start_script(":faccao:ResourceController");
        if (resource_script.errortext)
            LogError("recursos", "Erro ao iniciar o sistema de recursos: " + resource_script.errortext);
        else
            log_msg := "- ResourceController.src INVOCADO com sucesso. PID do novo processo (se iniciado): " + (resource_script.pid ? resource_script.pid : "N/A - pode ter saído se duplicado");
            LogInfo("start_DEBUG", log_msg);
            LogDebug("sistema", "Starting territory resource controller... ok.");
            SetGlobalProperty("last_execution", current_time);
        endif
    else
        var wait_time := effective_interval - time_since_last;
        log_msg := "- DECISÃO: AGUARDAR. Próxima tentativa de execução do ResourceController em " + wait_time + " segundos (" + CInt(wait_time/60) + " minutos).";
        LogInfo("start_DEBUG", log_msg);
    endif
endfunction