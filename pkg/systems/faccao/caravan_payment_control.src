use uo;
use os;
use util;
use guilds;
use datafile;

include "include/logging";
include "include/territory_management";
include "include/shared_functions";
include "include/faccao_constants";
include ":containers:storageAreas";
use storage;

const CARAVAN_CYCLE_WAIT := 600; // 10 minutos em segundos
const CARAVAN_PAYMENT_INTERVAL_DAYS := 7; // 7 dias (valor de produção)
const CARAVAN_PAYMENT_INTERVAL_SECONDS := 604800; // 7 dias = 604800 segundos
const MOEDAS_COBRE := 0xba63;

program CaravanPaymentControl()
    print("Iniciando Controlador de Pagamento de Caravanas...");
    
    SetGlobalProperty("#CaravanPaymentControlPid", GetPid());
    var cycle_count := 0;
    
    while(1)
        cycle_count := cycle_count + 1;
        print("Ciclo #" + cycle_count + " - verificando pagamentos de caravanas");
        
        Set_Critical(1);
        CheckCaravanPayments();
        Set_Critical(0);
        
        print("Ciclo #" + cycle_count + " completo. Aguardando " + CARAVAN_CYCLE_WAIT + " segundos...");
        Sleep(CARAVAN_CYCLE_WAIT);
    endwhile;
endprogram

function CheckCaravanPayments()
    var guild_list := ListGuilds();
    var current_time := polcore().systime;
    var processed_count := 0;
    
    print("=== DEBUG: Iniciando CheckCaravanPayments ===");
    print("DEBUG: Tempo atual do sistema: " + current_time);
    print("DEBUG: Total de guildas para verificar: " + guild_list.size());

    foreach guild in guild_list
        sleepms(50);
          var active_caravan := guild.GetProp("active_caravan_to_capital");
        var contract_start_time := CInt(guild.GetProp("caravan_contract_start_time"));
        var cost := CInt(guild.GetProp("caravan_weekly_cost"));
        var faction_name := guild.GetProp("name");

        if (!faction_name)
            faction_name := guild.guildname;
        endif;

        // DEBUG: Log para todas as guildas com caravana ativa
        if (active_caravan)
            print("DEBUG: Guilda " + faction_name + " tem caravana ativa para capital: " + active_caravan);
            print("DEBUG: Contrato iniciado em: " + contract_start_time + " (atual: " + current_time + ")");
            print("DEBUG: Custo: " + cost);
              if (contract_start_time)
                var tempo_decorrido_dias := CalcularDias(contract_start_time);
                var tempo_decorrido_segundos := CalcularSegundos(contract_start_time);
                print("DEBUG: Tempo decorrido desde contrato: " + tempo_decorrido_dias + " dias (" + tempo_decorrido_segundos + " segundos)");
                print("DEBUG: Intervalo de pagamento: " + CARAVAN_PAYMENT_INTERVAL_DAYS + " dias (" + CARAVAN_PAYMENT_INTERVAL_SECONDS + " segundos)");
            endif;
        endif;

        if (!active_caravan || !contract_start_time || !cost)
            continue;
        endif;
          var tempo_decorrido_dias := CalcularDias(contract_start_time);
        var tempo_decorrido_segundos := CalcularSegundos(contract_start_time);
        
        // Para debug rápido, usamos segundos; em produção, usar dias
        var payment_due := (tempo_decorrido_segundos >= CARAVAN_PAYMENT_INTERVAL_SECONDS);
        // var payment_due := (tempo_decorrido_dias >= CARAVAN_PAYMENT_INTERVAL_DAYS); // Para produção
        
        if (payment_due)
            print("=== PAGAMENTO DEVIDO ===");
            print("Pagamento devido para facção " + faction_name);
            print("DEBUG: Tempo decorrido: " + tempo_decorrido_dias + " dias (" + tempo_decorrido_segundos + " segundos)");
            print("DEBUG: Usando critério de segundos para debug: " + tempo_decorrido_segundos + " >= " + CARAVAN_PAYMENT_INTERVAL_SECONDS);

            Set_Critical(1);
            var result := ProcessPayment(guild, cost, faction_name, current_time);
            Set_Critical(0);
            
            print("DEBUG: Resultado do pagamento: " + result);
            processed_count := processed_count + 1;
        endif;
        
        sleepms(20);
    endforeach;
    
    print("DEBUG: Processadas " + processed_count + " facções.");
    print("=== DEBUG: Fim CheckCaravanPayments ===");
endfunction

function ProcessPayment(guild, cost, faction_name, current_time)
    print("=== DEBUG ProcessPayment para " + faction_name + " ===");
    
    var leader_serial := guild.GetProp("leader");
    print("DEBUG: Leader serial: " + leader_serial);
    
    if (!leader_serial)
        print("DEBUG: ERRO - Facção " + faction_name + " sem líder - caravana desativada");
        DeactivateCaravan(guild);
        return 0;
    endif;

    var leader := SystemFindObjectBySerial(leader_serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
    print("DEBUG: Leader object: " + (leader ? "ENCONTRADO" : "NÃO ENCONTRADO"));
    
    if (!leader)
        print("DEBUG: ERRO - Líder da facção " + faction_name + " não encontrado - caravana desativada");
        DeactivateCaravan(guild);
        return 0;
    endif;

    // Verificar banco do líder
    var bank := CP_GetStorageContainerForMobile(leader, CP_DEFAULT_AREA, CP_NOCREATE);
    print("DEBUG: Bank container: " + (bank ? "ENCONTRADO" : "NÃO ENCONTRADO"));
    
    if (!bank)
        print("DEBUG: ERRO - Banco do líder não encontrado - caravana desativada");
        DeactivateCaravan(guild);
        return 0;
    endif;

    print("DEBUG: Tentando debitar " + cost + " moedas do banco...");
    Set_Critical(1);
    var payment_success := DebitFromBank(bank, cost);
    Set_Critical(0);
    
    print("DEBUG: Resultado do débito: " + (payment_success ? "SUCESSO" : "FALHA"));
    
    if (payment_success)
        // MUDANÇA CRÍTICA: Atualizar o tempo de início do contrato em vez de próximo pagamento
        guild.SetProp("caravan_contract_start_time", current_time);
        print("DEBUG: SUCESSO - Contrato renovado. Novo tempo de início: " + current_time);
        
        // CRÍTICO: Notificar o ResourceController sobre a renovação da caravana
        var capital_id := guild.GetProp("active_caravan_to_capital");
        if (capital_id)
            var event_data := struct;
            event_data.+faction := faction_name;
            event_data.+active_until_next_payment := current_time + CARAVAN_PAYMENT_INTERVAL_SECONDS;
              TM_NotifyTerritoryChange(CStr(capital_id), "caravan_activated", event_data);
            print("DEBUG: Evento caravan_activated enviado para ResourceController");
        endif;
        
        print("Pagamento realizado para " + faction_name + " - próximo em " + CARAVAN_PAYMENT_INTERVAL_SECONDS + "s (DEBUG)");
        return 1;
    else
        print("FALHA: Pagamento não pode ser processado para " + faction_name + " - desativando caravana");
        DeactivateCaravan(guild);
        return 0;
    endif
endfunction

function DebitFromBank(bank, amount)
    var items := EnumerateItemsInContainer(bank);
    if (items == error) 
        return 0; 
    endif;
    
    var total_found := 0;
    var coin_items := array{};
    
    // Contar moedas disponíveis
    foreach item in items
        if (item.objtype == MOEDAS_COBRE)
            total_found += item.amount;
            coin_items.append(item);
        endif
    endforeach;
    
    if (total_found < amount)
        return 0; // Fundos insuficientes
    endif
    
    // Fazer o débito
    var amount_to_pay := amount;
    foreach item in coin_items
        if (amount_to_pay <= 0)
            break;
        endif
        
        if (item.amount >= amount_to_pay)
            SubtractAmount(item, amount_to_pay);
            amount_to_pay := 0;
        else
            amount_to_pay -= item.amount;
            DestroyItem(item);
        endif
    endforeach;
    
    return (amount_to_pay == 0);
endfunction

function DeactivateCaravan(guild)
    guild.EraseProp("active_caravan_to_capital");
    guild.EraseProp("caravan_contract_start_time");
    guild.EraseProp("caravan_next_payment_due");
    guild.EraseProp("caravan_weekly_cost");
endfunction

function CalcularSegundos(data)
    var criadoEm := Cint(data);
    var tempoAgora := polcore().systime;
    var tempoDecorrido := tempoAgora - criadoEm;
    return tempoDecorrido;
endfunction

function CalcularDias(data)
    var criadoEm := Cint(data);
    var tempoAgora := polcore().systime;
    var tempoDecorrido := tempoAgora - criadoEm;
    var dias := Cint(tempoDecorrido / 86400); // 24*60*60 = 86400 segundos por dia
    return dias;
endfunction

