/////////////////
// Bibliotheken
/////////////////

use uo;
use os;
use cfgfile;

/////////////
// Includes
/////////////

include ":worldforge:errormsg_wf";

///////////////
// Konstanten
///////////////

const ERRORMSGS_GERMAN := "{}StaticsImport: ImportArea aktiviert..." + "{}StaticsImport: ImportArea beendet." + "{}StaticsImport: Item %% an %% %% %% konnte nicht erzeugt werden!"
																	 + "{}Die Items wurden importiert." + "{}Probleme beim Lesen der Configdateien!";
const ERRORMSGS_ENGLISH := "{}StaticsImport: ImportArea started..." + "{}StaticsImport: ImportArea done." + "{}StaticsImport: Was impossible to create Item %% at %% %% %%!"
																	+ "{}Items have been imported." + "{}Problems on Reading Config File!";

/////////////////
// Hauptprogram
/////////////////

program TextCMD_StaticsImport(who)
	Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

	PrintErrorMessage(1);
	ImportArea(who);
	PrintErrorMessage(2);
endprogram

//////////////////////////////////////
// ImportArea - Importiert die Items
//////////////////////////////////////

function ImportArea(who)
	var datafile := ReadConfigFile(":worldforge:config/staticscheckstackslarge");

	if (datafile)
		var item;
		var object;

		foreach name in GetConfigStringKeys(datafile)
			item := datafile[name];
			if (item)
				object := CreateItemAtLocation(item.x, item.y, item.z, item.objtype, item.amount);
				if (object)
					object.color := item.color;
					object.movable := item.movable;

					var cprops := UnPack(item.cprops);
					foreach cpropname in (cprops.keys())
						SetObjProperty(object, cpropname, cprops[cpropname]);
					endforeach
				else
					PrintErrorMessage(3, { item.objtype, item.x, item.y, item.z });
				endif
			endif
		endforeach

		UnloadConfigFile(":worldforge:config/staticscheckstackslarge");

		PrintErrorMessage(4, {}, who);
	else
		PrintErrorMessage(5, {}, who);
	endif
endfunction
