use os;

/////////////////
// Hauptprogram
/////////////////

program TextCMD_StaticsCheckExport(who, params)
	Run_Script_to_Completion("textcmd/test/staticscheck", { who, params });
	Run_Script_to_Completion("textcmd/test/staticsexport", { who, params });
endprogram
