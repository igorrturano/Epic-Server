////////////////////////////

/////////////////
// Bibliotheken
/////////////////

use uo;
use os;
use cfgfile;

/////////////
// Includes
/////////////

include ":worldforge:errormsg_wf";

///////////////
// Konstanten
///////////////

const ERRORMSGS_GERMAN := "{}StaticsImport: ImportArea aktiviert..." + "{}StaticsImport: ImportArea beendet." + "{}StaticsImport: Item %% an %% %% %% konnte nicht erzeugt werden!"
																	 + "{}Die Items wurden importiert." + "{}Probleme beim Lesen der Configdateien!";
const ERRORMSGS_ENGLISH := "{}StaticsImport: ImportArea started..." + "{}StaticsImport: ImportArea done." + "{}StaticsImport: Was impossible to create Item %% at %% %% %%!"
																	+ "{}Items have been imported." + "{}Problems on Reading Config File!";

/////////////////
// Hauptprogram
/////////////////

program TextCMD_StaticsImport(who)
	Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

	PrintErrorMessage(1);
	ImportArea(who);
	PrintErrorMessage(2);
endprogram

//////////////////////////////////////
// ImportArea - Importiert die Items
//////////////////////////////////////

function ImportArea(who)
	var datafile1 := ReadConfigFile(":worldforge:config/statics");
	var datafile2 := ReadConfigFile(":worldforge:config/staticsno");

	if (datafile1 And datafile2)
		var item;
		var object;
		foreach name in GetConfigStringKeys(datafile1)
			item := datafile1[name];
			if (item)
				object := CreateItemAtLocation(item.x, item.y, item.z, item.id, 1);
				if (object)
					object.color := item.color;
					object.decayat := 0;
					object.movable := 0;
				else
					PrintErrorMessage(3, array{ item.id, item.x, item.y, item.z });
				endif
			endif
		endforeach

		foreach name in GetConfigStringKeys(datafile2)
			item := datafile2[name];
			if (item)
				object := CreateItemAtLocation(item.x, item.y, item.z, item.objtype, 1);
				if (object)
					if (item.name)
						SetName(object, item.name);
					endif
					object.color := item.color;
					object.decayat := 0;
					object.movable := 0;
				else
					PrintErrorMessage(3, array{ item.objtype, item.x, item.y, item.z });
				endif
			endif
		endforeach

		UnloadConfigFile(":worldforge:config/staticsno");
		UnloadConfigFile(":worldforge:config/statics");

		PrintErrorMessage(4, array{}, who);
	else
		PrintErrorMessage(5, array{}, who);
	endif
endfunction
