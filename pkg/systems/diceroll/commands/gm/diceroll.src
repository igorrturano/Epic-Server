include ":message:model/Message";
include ":diceroll:model/DiceRoll";

program diceroll(who, params)
	if (!params || params == "")
		Message("Uso correto: .diceroll <rolagem de dados>", SSM_FAIL).SendSys(who);
		Message("Exemplo: .diceroll 1d6, 1d20, 2d8+3, etc. [múltiplos dados são aceitos]", SSM_FAIL).SendSys(who);
		return 0;
	endif

	Message("Quem vai ver a rolagem de dados?").SendSys(who);
	var targ := Target(who);

	if (!targ)
		Message("Cancelado.", SSM_FAIL).SendSys(who);
		return 0;
	endif

	var diceStr := SplitWords(params, " ");
	var diceRoll := DiceRoll(diceStr).Roll().GetResult(DICE_RESULT::ALL);
	print("diceRoll: " + diceRoll);

	var i := 0;
	foreach roll in (diceRoll)
		i++;
		PlaySoundEffect(targ, 738);
		PlaySoundEffect(targ, 739);
		Sleep(1);
		
		if (roll == error)
			Message($"Erro ao rolar dado {i}: {roll.errortext}", SSM_FAIL).SendAbove(targ);
			continue;
		else
			Message($"*Rolou dado: {roll}*").SendAbove(targ);
		endif
	endforeach
endprogram

function RollDice(params)

	return diceRoll;
endfunction
