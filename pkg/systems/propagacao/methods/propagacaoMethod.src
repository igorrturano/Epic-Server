
use uo;
use os;
use cfgfile;

include "/include/epicPropNames";
include ":propagacao:include/propagacao";

program install()
    return 1;
endprogram

exported function Estimular(marcadorPropagacao, valorEstimulo, isPrioritario := false) 
    
    var processoMarcador := PegaProcessoMarcador(marcadorPropagacao);

    if(processoMarcador)
        if(isPrioritario)
            processoMarcador.clear_event_queue();
        endif
        
        return processoMarcador.sendevent(struct{id := PROPAGACAO_EV_ESTIMULO, valor := valorEstimulo, isAcumulando := true});

    endif
    return error { error_text := "Processo do marcador não foi encontrado."};
endfunction

exported function IsMarcadorTipo(marcadorPropagacao, tipo) 
    var propPropagacao := GetObjProperty(marcadorPropagacao, PROPNAME_PROP_PROPAGACAO);
    
    return propPropagacao.tipoPropagacao == tipo;
endfunction

exported function Reacender(marcadorPropagacao, valorEstimulo := 0) 
    var processoMarcador := PegaProcessoMarcador(marcadorPropagacao);

    if(processoMarcador)
        processoMarcador.clear_event_queue();
        Print("Cheguei???");
        Set_Critical( true);
        processoMarcador.sendevent(struct{id := PROPAGACAO_EV_COMBUSTIVEL});
        if(valorEstimulo)
            processoMarcador.sendevent(struct{id := PROPAGACAO_EV_ESTIMULO, valor := valorEstimulo, isAcumulando := true});
        endif
        Set_Critical( false);
    endif

    return error { error_text := "Processo do marcador não foi encontrado."};
    
    
endfunction