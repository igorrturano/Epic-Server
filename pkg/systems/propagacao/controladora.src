use uo;
use os;
use polsys;

include "include/client";
include "/include/epicPropNames";
include ":propagacao:include/marcadorPropagacaoFabrica";

program controladoraPropagacao(esteItemMarcador)

	var propPropagacao := GetObjProperty(esteItemMarcador, PROPNAME_PROP_PROPAGACAO) ;
	var momentoInicial := ReadGameClock();
	Set_Event_Queue_Size(12);

	var marcadorOrigem := propPropagacao.marcadorOrigem;
	if(propPropagacao.?esteMarcadorPid)
		propPropagacao.esteMarcadorPid := GetPid();
	else
		propPropagacao.+esteMarcadorPid := GetPid();
	endif

	SetObjProperty(esteItemMarcador, PROPNAME_PROP_PROPAGACAO,propPropagacao);

	var params := FabricaPropagacaoParametros();
	params.marcador := esteItemMarcador;

	var esteObjetoMarcador := MarcadorPropagacaoFabrica().Montar(params);

	esteObjetoMarcador.AtualizaComportamentoMarcador();
	esteObjetoMarcador.MarcarAdjacentes();

	while(esteItemMarcador)
		Sleepms(300);
		var event := Wait_For_Event(0);

		if(ReadGameClock() - momentoInicial >= 2)
			esteObjetoMarcador.TocaSFXCaracteristico();
		endif
		
		if(event.id == PROPAGACAO_EV_ESTIMULO)
			esteObjetoMarcador.RecebeEstimulo(event.valor, event.isAcumulando);
		elseif(event.id == PROPAGACAO_EV_COMBUSTIVEL)
			esteObjetoMarcador.InjetaCombustivel();
		endif

		if(!esteObjetoMarcador.isMarcadorMorto)
			esteObjetoMarcador.EfetuarCiclo();
		else
			DestroyItem(esteItemMarcador);
		endif
	endwhile

endprogram