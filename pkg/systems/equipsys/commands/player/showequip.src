include ":equipsys:EquipWrapper/ViewModel/EquipWrapperWeapon";
include ":equipsys:EquipWrapper/ViewModel/EquipWrapperArmor";

program cmd_showequip( who, args )
  var item, type;

  if ( !args )
	item := target( who );
  else
	args := SplitWords( args );
	type := args[1];
	item := args[2];
  endif

  if ( !type )
	if ( item.isA( POLCLASS_WEAPON ) )
	  item := EquipWrapperWeapon( item );
	elseif ( item.isA( POLCLASS_ARMOR ) )
	  item := EquipWrapperArmor( item );
	else
	  SendSysMessage( who, "O item não é uma arma ou armadura." );
	  return;
	endif
  else
	if ( type == "weapon" )
	  item := EquipWrapperWeapon( item );
	elseif ( type == "armor" )
	  item := EquipWrapperArmor( item );
	else
	  SendSysMessage( who, "Tipo inválido. Use 'weapon' ou 'armor'." );
	  return;
	endif
  endif

  SendSysMessage( who, item.ToString() );
endprogram

