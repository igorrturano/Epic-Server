include ":objWrapper:Model/MobileWrapper";
include ":objWrapper:Model/WeaponWrapper";
// include ":message:Model/Message";
include ":gumpDesigner:Gump/Gump";
include ":gumpDesigner:Control/Container/ContainerGridLayout";
include ":gumpDesigner:Control/Button";
include ":gumpDesigner:Control/ImageGump";

program cmd_golpe(who)
	var newPosture;
	who := MobileWrapper(who);
	newPosture := ChoosePosture(who);
endprogram

function ChoosePosture(who)
	var eventHandled;
	
	var gump := Gump(who.GetObjRef(), "Postura de Combate", 300, 175);
	var container := ContainerGridLayout("Container", 25, 70, 260, 90, 1, 3);
	var imgSelector := ImageGump("Selector", 0, 0, 30062);
	var selectedOption := ImageGump("SelectedButton", 12, 23, 1009).SetColor(COLOR_RED);
	var buttonSlash := Button("SlashDamage", 12, 23, 1004, 1004);
	var buttonPiercing := Button("PiercingDamage", 12, 23, 1008, 1008);
	var buttonBlunt := Button("BluntDamage", 12, 23, 1009, 1009);

	while (true)
		var button1 := buttonSlash;
		var button2 := buttonPiercing;
		var button3 := buttonBlunt;

		if (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::SLASH)
			container.AddControl(imgSelector, 1, 1);
			button1 := selectedOption.SetImage(buttonSlash.GetPressedImage());
		elseif (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::PIERCING)
			container.AddControl(imgSelector, 1, 2);
			button2 := selectedOption.SetImage(buttonPiercing.GetPressedImage());
		elseif (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::BLUNT)
			container.AddControl(imgSelector, 1, 3);
			button3 := selectedOption.SetImage(buttonBlunt.GetPressedImage());
		endif

		container.AddControl(button1, 1, 1);
		container.AddControl(button2, 1, 2);
		container.AddControl(button3, 1, 3);
		gump.AddControl(container);

		eventHandled := gump.Show();

		if (eventHandled.GetControl() == EVENT_ACTION::CLOSED)
			return gump.Dispose();
		elseif (eventHandled.GetControl().Equals(buttonSlash))
			SetNewPosture(who, DAMAGE_TYPE::SLASH);
		elseif (eventHandled.GetControl().Equals(buttonPiercing))
			SetNewPosture(who, DAMAGE_TYPE::PIERCING);
		elseif (eventHandled.GetControl().Equals(buttonBlunt))
			SetNewPosture(who, DAMAGE_TYPE::BLUNT);
		endif

		gump.Dispose();
	endwhile
endfunction

function SetNewPosture(who, newPosture)
	if (newPosture == DAMAGE_TYPE::SLASH ||
		newPosture == DAMAGE_TYPE::PIERCING ||
		newPosture == DAMAGE_TYPE::BLUNT)
		if (!who.GetEquipBySlot(WEAPON))
			who.SetCombatTraits(who.GetCombatTraits().SetPosture(DAMAGE_TYPE::BLUNT));
			Message("Você deve estar empunhando uma arma para mudar sua postura de combate.", FONTCOLOR_ERROR).SendSys(who.GetObjRef());
		elseif (who.GetEquipBySlot(WEAPON).GetCategory == BOW)
			who.SetCombatTraits(who.GetCombatTraits().SetPosture(DAMAGE_TYPE::PIERCING));
			Message("Arcos não podem mudar postura de combate.", FONTCOLOR_ERROR).SendSys(who.GetObjRef());
		else
			who.SetCombatTraits(who.GetCombatTraits().SetPosture(newPosture));
			Message($"adota postura {newPosture}").SendEmote(who.GetObjRef());
		endif
	endif
endfunction
