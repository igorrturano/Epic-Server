include ":objWrapper:Model/MobileWrapper";
include ":objWrapper:Model/WeaponWrapper";
include ":message:Model/Message";
include ":gumpDesigner:Gump/Gump";
include ":gumpDesigner:Control/Container/ContainerGridLayout";
include ":gumpDesigner:Control/Button";
include ":gumpDesigner:Control/ImageGump";

program cmd_golpe(who)
	var newPosture;
	who := MobileWrapper(who);
	newPosture := ChoosePosture(who);
	SetNewPosture(who, newPosture);
endprogram

function ChoosePosture(who)
	var eventHandled, buttonSlash, buttonPiercing, buttonBlunt, selectedOption;
	
	var gump := Gump(who.GetObjRef(), "Postura de Combate", 225, 115);
	var container := ContainerGridLayout("Container", 15, 40, 195, 35, 1, 3);
	var imgSelector := ImageGump("Selector", 0, 0, 30062);
	selectedOption := ImageGump("SelectedButton", 13, 23, 1004).SetColor(COLOR_RED);
	buttonSlash := Button("SlashDamage", 13, 23, 1004, 1004);
	buttonPiercing := Button("PiercingDamage", 13, 23, 1008, 1008);
	buttonBlunt := Button("BluntDamage", 13, 23, 1009, 1009);

	while (true)
		if (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::SLASH)
			container.AddControl(imgSelector, 1, 1);
			selectedOption.SetUnpressedImage(buttonSlash.GetUnpressedImage())
						  .SetPressedImage(buttonSlash.GetPressedImage());
			buttonSlash := selectedOption;
		elseif (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::PIERCING)
			container.AddControl(imgSelector, 1, 2);
			selectedOption.SetUnpressedImage(buttonPiercing.GetUnpressedImage())
						  .SetPressedImage(buttonPiercing.GetPressedImage());
			buttonPiercing := selectedOption;
		elseif (who.GetCombatTraits().GetPosture() == DAMAGE_TYPE::BLUNT)
			container.AddControl(imgSelector, 1, 3);
			selectedOption.SetUnpressedImage(buttonBlunt.GetUnpressedImage())
						  .SetPressedImage(buttonBlunt.GetPressedImage());
			buttonBlunt := selectedOption;
		endif

		container.AddControl(buttonSlash, 1, 1);
		container.AddControl(buttonPiercing, 1, 2);
		container.AddControl(buttonBlunt, 1, 3);
		gump.AddControl(container);

		eventHandled := gump.Show();

		if (eventHandled.GetControl() == EVENT_ACTION::CLOSED)
			return gump.Dispose();
		elseif (eventHandled.GetControl() == buttonSlash)
			return DAMAGE_TYPE::SLASH;
		elseif (eventHandled.GetControl() == buttonPiercing)
			return DAMAGE_TYPE::PIERCING;
		elseif (eventHandled.GetControl() == buttonBlunt)
			return DAMAGE_TYPE::BLUNT;
		endif

		gump.Dispose();
	endwhile
endfunction

function SetNewPosture(who, newPosture)
	if (newPosture == DAMAGE_TYPE::SLASH ||
		newPosture == DAMAGE_TYPE::PIERCING ||
		newPosture == DAMAGE_TYPE::BLUNT
		)
		who.SetCombatTraits(who.GetCombatTraits().SetPosture(newPosture));
		Message($"*muda postura de combate para {newPosture}*").SendAbove(who.GetObjRef());
	endif
endfunction
