include ":message:model/Message";
include ":wrappers:Objects/Model/ArmorWrapper";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":wrappers:Objects/Model/MobileWrapper";
include ":debug:Controller/DebugController";

program equipitem(params)
	var who := params[1];
	var item := params[2];

	var equip;
	if (item.IsA(POLCLASS_ARMOR))
		equip := ArmorWrapper(item);
		debugArmor(who, equip);
	elseif (item.IsA(POLCLASS_WEAPON))
		equip := WeaponWrapper(item);
		debugWeapon(who, equip);
	endif

	equip.Update();
	MobileWrapper(who).ApplyItemModifiers(equip);
endprogram

function debugWeapon(who, equip)
	DebugMsg(who, DEBUG_EQUIP, $"====================
		Arma: {equip.GetName()}
		====================");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] {SLASHDAMAGE}: {equip.GetMainDamage().GetSlashDamage()}");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] {PIERCINGDAMAGE}: {equip.GetMainDamage().GetPiercingDamage()}");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] {BLUNTDAMAGE}: {equip.GetMainDamage().GetBluntDamage()}");

	if (equip.IsDualWield())
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] {SLASHDAMAGE}: {equip.GetOffDamage().GetSlashDamage()}");
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] {PIERCINGDAMAGE}: {equip.GetOffDamage().GetPiercingDamage()}");
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] {BLUNTDAMAGE}: {equip.GetOffDamage().GetBluntDamage()}");
	endif

	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] Fogo: {equip.GetMainDamage().GetFireDamage()}");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] Gelo: {equip.GetMainDamage().GetColdDamage()}");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] Veneno: {equip.GetMainDamage().GetPoisonDamage()}");
	DebugMsg(who, DEBUG_EQUIP, $"[DANO PRINCIPAL] Energia: {equip.GetMainDamage().GetEnergyDamage()}");

	if (equip.IsDualWield())
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] Fogo: {equip.GetOffDamage().GetFireDamage()}");
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] Gelo: {equip.GetOffDamage().GetColdDamage()}");
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] Veneno: {equip.GetOffDamage().GetPoisonDamage()}");
		DebugMsg(who, DEBUG_EQUIP, $"[DANO SECUNDÁRIO] Energia: {equip.GetOffDamage().GetEnergyDamage()}");
	endif

	// DebugMsg(who, DEBUG_EQUIP, $"Material: {materialName}");
	DebugMsg(who, DEBUG_EQUIP, $"Principal Postura de Ataque: {equip.GetAttackType()}");
	DebugMsg(who, DEBUG_EQUIP, $"Velocidade: {equip.GetSpeed()}");
	DebugMsg(who, DEBUG_EQUIP, $"Chance de Crítico: {equip.GetCriticalChance()}%");
endfunction

function debugArmor(who, equip)
	var slot := equip.GetCoverage();
	var type := equip.GetTipoProtecao();

	DebugMsg(who, DEBUG_EQUIP, $"====================
		Equipamento: {equip.GetName()}
		====================");

	DebugMsg(who, DEBUG_EQUIP, $"Slot: {slot}");
	DebugMsg(who, DEBUG_EQUIP, $"Durabilidade: {equip.GetMaxHP()}");

	DebugMsg(who, DEBUG_EQUIP, $"[RESISTÊNCIA FÍSICA]");
	DebugMsg(who, DEBUG_EQUIP,
		  $"{SLASHDAMAGE}: {equip.GetResists().GetSlashResist()} (+{equip.GetResistsMod().GetSlashResist()})");
	DebugMsg(who, DEBUG_EQUIP,
		  $"{PIERCINGDAMAGE}: {equip.GetResists().GetPiercingResist()} (+{equip.GetResistsMod().GetPiercingResist()})");
	DebugMsg(who, DEBUG_EQUIP,
		  $"{BLUNTDAMAGE}: {equip.GetResists().GetBluntResist()} (+{equip.GetResistsMod().GetBluntResist()})");
	// DebugMsg(who, DEBUG_EQUIP, $"Material ({materialName}): {resistByMaterial["SlashResist"]}/{resistByMaterial["PiercingResist"]}/{resistByMaterial["BluntResist"]}");
	// DebugMsg(who, DEBUG_EQUIP, $"Slot ({slot}): {resistBySlot["SlashResist"]}/{resistBySlot["PiercingResist"]}/{resistBySlot["BluntResist"]}");
	// DebugMsg(who, DEBUG_EQUIP, $"Tipo de Proteção ({type}): {resistByProtection["SlashResist"]}/{resistByProtection["PiercingResist"]}/{resistByProtection["BluntResist"]}
	// ");

	DebugMsg(who, DEBUG_EQUIP, $"[RESISTÊNCIA ELEMENTAL]");
	DebugMsg(who, DEBUG_EQUIP, $"Fogo: {equip.FireResist}");
	DebugMsg(who, DEBUG_EQUIP, $"Gelo: {equip.ColdResist}");
	DebugMsg(who, DEBUG_EQUIP, $"Veneno: {equip.PoisonResist}");
	DebugMsg(who, DEBUG_EQUIP, $"Energia: {equip.EnergyResist}");

	DebugMsg(who, DEBUG_EQUIP, $"[PENALIDADES]");
	DebugMsg(who, DEBUG_EQUIP, $"Dexterity: {equip.GetPenalties()[DEXTERITY]}");
	DebugMsg(who, DEBUG_EQUIP, $"Sneak: {equip.GetPenalties()[SNEAK]}");
	DebugMsg(who, DEBUG_EQUIP, $"Mechanics: {equip.GetPenalties()[MECHANICS]}");
	DebugMsg(who, DEBUG_EQUIP, $"Magery: {equip.GetPenalties()[MAGERY]}");
	DebugMsg(who, DEBUG_EQUIP, $"Awareness: {equip.GetPenalties()[AWARENESS]}");

	DebugMsg(who, DEBUG_EQUIP, $"[MODIFICADORES]");
// DebugMsg(who, DEBUG_EQUIP, $"Material: {materialName}");
// DebugMsg(who, DEBUG_EQUIP, $"Durabilidade: {itemAttr.MaxHP} ({getDurabilityByType(item)} + {CInt((getDurabilityByType(item)*getDurabilityModByMaterial(item))-getDurabilityByType(item))}) (Mod: {getDurabilityModByMaterial(item)})");
// DebugMsg(who, DEBUG_EQUIP, $"Peso: {itemAttr.Weight} ({getWeightByType(item)} + {CInt((getWeightByType(item)*getWeightModByMaterial(item))-getWeightByType(item))}) (Mod: {getWeightModByMaterial(item)})");
endfunction
