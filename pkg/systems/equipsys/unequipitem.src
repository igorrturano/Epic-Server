include ":message:model/Message";
include ":equipsys:ViewModel/EquipWrapperArmor";
include ":equipsys:ViewModel/EquipWrapperWeapon";
include ":charsys:ViewModel/MobileWrapper";

program unequipitem(params)
	var who := params[1];
	var item := params[2];

	var equip;
	if (item.IsA(POLCLASS_ARMOR))
		equip := EquipWrapperArmor(item);
	elseif (item.IsA(POLCLASS_WEAPON))
		equip := EquipWrapperWeapon(item);
	endif

	MobileWrapper(who).RemoveItemModifiers(equip);
endprogram