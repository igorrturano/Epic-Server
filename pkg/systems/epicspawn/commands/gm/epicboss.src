				 form_data.skills_mod.gathering : "0", 37, 4);

	// Handle Animal
	GFTextLine(gump, skill_x_start[2], skill_y_start + skill_y_spacing, 1153, "Handle Animal:");
	GFTextEntry(gump, skill_entry_x_start[2], skill_y_start + skill_y_spacing, 30, 20, 1150,
				 form_data.skills_mod.handle_animal ? form_data.skills_mod.handle_animal : "0", 38, 4);

	// Magic Lore
