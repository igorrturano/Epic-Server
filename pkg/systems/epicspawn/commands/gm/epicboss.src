	GFTextEntry(gump, skill_entry_x_start[1], skill_y_start + skill_y_spacing * 4, 30, 20, 1150,
				 form_data.skills_mod.dual_wield ? form_data.skills_mod.dual_wield : "0", 39, 4);

	// Column 2
