use uo;
use os;

program cor(params)
    var dm   := params[1];
    var item := params[2];
    var pv   := params[3];
    var hue  := CInt(pv[1]);

    if (!item || !item.serial)
        SendSysMessage(dm, "[EpicDungeon] Alvo invalido.");
        return 0;
    endif

    item.color := hue;
    return 1;
endprogram
