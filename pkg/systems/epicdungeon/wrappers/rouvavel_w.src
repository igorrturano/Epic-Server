use uo;
use os;

program rouvavel_w(params)
    var dm := params[1];
    var pid := Start_Script(":stealables:commands/gm/rouvavel", dm);
    if (!pid || pid == error)
        SendSysMessage(dm, "[EpicDungeon] Falha ao iniciar sistema de artefatos.");
        return 0;
    endif
    return 1;
endprogram
