use uo;
use os;

program sayabovepvt(params)
    var mobs := params[2];
    var pv   := params[3];
    var msg  := pv[1];

    if (!msg || msg == "")
        return 0;
    endif

    foreach mob in mobs
        PrintTextAbovePrivate(mob, msg, mob);
        sleepms(2);
    endforeach
    return 1;
endprogram
