use uo;
use os;

include ":medicine:disease";

program infectar_wrapper(params)
    var mobs    := params[2];
    var pv      := params[3];
    var duracao := CInt(pv[1]);

    if (duracao <= 0) duracao := 120; endif

    foreach mob in mobs
        InfectMobile(mob, duracao, 1, 3, "random", DISEASE_GRADES::MODERATE);
        sleepms(2);
    endforeach
    return 1;
endprogram
