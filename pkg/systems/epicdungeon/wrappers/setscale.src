use uo;
use os;

program setscale(params)
    var mobs := params[2];
    var pv   := params[3];
    var idx  := CInt(pv[1]);

    // dropdown: 10%|30%|50%|60%|70%|80%|100%|120%|150%|200%
    var escalas := array{ 10, 30, 50, 60, 70, 80, 100, 120, 150, 200 };
    var pct     := escalas[idx + 1];
    if (!pct) pct := 100; endif

    foreach mob in mobs
        var ox := mob.x;
        var oy := mob.y;
        var oz := mob.z;
        if (pct == 100)
            EraseObjProperty(mob, "entityScale");
        else
            var val := pct * 10;
            var s   := struct{};
            s.+height := val;
            s.+width  := val;
            SetObjProperty(mob, "entityScale", s);
        endif
        MoveObjectToLocation(mob, ox + 30, oy + 30, oz, mob.realm, MOVEOBJECT_FORCELOCATION);
        sleepms(100);
        MoveObjectToLocation(mob, ox, oy, oz, mob.realm, MOVEOBJECT_FORCELOCATION);
        sleepms(2);
    endforeach
    return 1;
endprogram
