use uo;
use os;
use vitals;

program massacre(params)
    var dm   := params[1];
    var pos  := params[2];
    var pv   := params[3];
    var raio := CInt(pv[1]);

    if (!raio || raio <= 0)
        raio := 5;
    endif

    if (!pos)
        return 0;
    endif

    foreach mobile in ListMobilesNearLocationEX(pos.x, pos.y, pos.z, raio,
                                                LISTEX_FLAG_NORMAL + LISTEX_FLAG_HIDDEN, pos.realm)
        if (mobile.npctemplate)
            ApplyRawDamage(mobile, 6000);
        endif
        sleepms(2);
    endforeach

    return 1;
endprogram
