use uo;
use os;

program gmbcast(params)
    var pv  := params[3];
    var msg := pv[1];

    if (!msg || msg == "")
        return 0;
    endif

    foreach mob in EnumerateOnlineCharacters()
        if (!mob.npctemplate)
            SendSysMessage(mob, msg, 3, 1359);
        endif
        sleepms(2);
    endforeach
    return 1;
endprogram
