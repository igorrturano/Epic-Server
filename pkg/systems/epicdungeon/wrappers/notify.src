use uo;
use os;

program notify(params)
    var mobs := params[2];
    var pv   := params[3];
    var msg  := pv[1];

    if (!msg || msg == "")
        return 0;
    endif

    foreach mob in mobs
        PrintTextAbove(mob, msg);
        SendSysMessage(mob, msg, 3, 53);
        sleepms(2);
    endforeach
    return 1;
endprogram
