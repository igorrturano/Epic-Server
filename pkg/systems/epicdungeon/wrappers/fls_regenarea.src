use uo;
use os;

program fls_regenarea(params)
    var dm  := params[1];
    var pos := params[2];

    var item := CreateItemAtLocation(pos.x, pos.y, pos.z, 0xeefee, 1, pos.realm);
    if (!item || item == error)
        SendSysMessage(dm, "[EpicDungeon] Falha ao criar area de regeneracao.");
        return 0;
    endif

    PlayStationaryEffect(pos.x, pos.y, pos.z, 14281, 30, 0, 0, pos.realm);
    SendSysMessage(dm, "[EpicDungeon] Area de regeneracao criada. Clique duas vezes para configurar.");
    return 1;
endprogram
