use uo;
use os;

program fls_soundplay(params)
    var dm  := params[1];
    var pos := params[2];

    var item := CreateItemAtLocation(pos.x, pos.y, pos.z, 0xeefef, 1, pos.realm);
    if (!item || item == error)
        SendSysMessage(dm, "[EpicDungeon] Falha ao criar tocador de som.");
        return 0;
    endif

    SendSysMessage(dm, "[EpicDungeon] Tocador de som criado. Clique duas vezes para configurar.");
    return 1;
endprogram
