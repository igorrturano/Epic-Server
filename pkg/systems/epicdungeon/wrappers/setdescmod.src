use uo;
use os;

program setdescmod(params)
    var dm    := params[1];
    var item  := params[2];
    var pv    := params[3];
    var texto := pv[1];

    if (!item || !item.serial)
        SendSysMessage(dm, "[EpicDungeon] Alvo invalido.");
        return 0;
    endif
    if (!texto || texto == "")
        SendSysMessage(dm, "[EpicDungeon] Texto vazio.");
        return 0;
    endif

    SetObjProperty(item, "descmod", texto);
    return 1;
endprogram
