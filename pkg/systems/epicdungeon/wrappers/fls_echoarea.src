use uo;
use os;

program fls_echoarea(params)
    var dm  := params[1];
    var pos := params[2];

    var item := CreateItemAtLocation(pos.x, pos.y, pos.z, 0xFE77, 1, pos.realm);
    if (!item || item == error)
        SendSysMessage(dm, "[EpicDungeon] Falha ao criar area de eco.");
        return 0;
    endif

    SendSysMessage(dm, "[EpicDungeon] Area de eco criada. Clique duas vezes para configurar.");
    return 1;
endprogram
