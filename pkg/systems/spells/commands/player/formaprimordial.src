		0x6af->"forest", 0x6b0->"forest", 0x6b1->"forest", 0x6b2->"forest", 0x6b3->"forest", 0x6b4->"forest", 0x6bb->"forest", 0x6bc->"forest", 0x6bd->"forest", 0x6be->"forest",
		0x709->"forest", 0x70a->"forest", 0x70b->"forest", 0x70c->"forest", 0x715->"forest", 0x716->"forest", 0x717->"forest", 0x718->"forest", 0x719->"forest", 0x71a->"forest", 0x71b->"forest", 0x71c->"forest",
		0x2728->"forest", 0x2729->"forest", 0x272a->"forest", 0x272b->"forest", 0x272c->"forest", 0x272d->"forest", 0x272e->"forest", 0x272f->"forest", 0x2730->"forest", 0x2731->"forest", 0x2732->"forest", 0x2733->"forest", 0x2734->"forest", 0x2735->"forest", 0x2736->"forest",
		
		0xac->"jungle", 0xad->"jungle", 0xae->"jungle", 0xaf->"jungle", 0xb0->"jungle", 0xb3->"jungle", 0xb6->"jungle", 0xb9->"jungle", 0xbc->"jungle", 0xbd->"jungle", 0xbe->"jungle", 0xbf->"jungle",
		0xec->"jungle", 0xfc->"jungle", 0xfd->"jungle", 0xfe->"jungle", 0xff->"jungle", 0x100->"jungle", 0x101->"jungle", 0x102->"jungle", 0x103->"jungle", 0x108->"jungle", 0x109->"jungle", 0x10a->"jungle", 0x10b->"jungle",
		0x1f0->"jungle", 0x1f1->"jungle", 0x1f2->"jungle", 0x1f3->"jungle",
		0x26e->"jungle", 0x26f->"jungle", 0x270->"jungle", 0x271->"jungle", 0x276->"jungle", 0x277->"jungle", 0x278->"jungle", 0x279->"jungle", 0x27a->"jungle", 0x27b->"jungle", 0x27c->"jungle", 0x27d->"jungle",
		0x286->"jungle", 0x287->"jungle", 0x288->"jungle", 0x289->"jungle", 0x292->"jungle", 0x293->"jungle", 0x294->"jungle", 0x295->"jungle",
		0x581->"jungle", 0x582->"jungle", 0x583->"jungle", 0x584->"jungle", 0x585->"jungle", 0x586->"jungle", 0x587->"jungle", 0x588->"jungle", 0x589->"jungle", 0x58a->"jungle", 0x58d->"jungle", 0x58e->"jungle", 0x58f->"jungle", 0x590->"jungle",
		0x59f->"jungle", 0x5a0->"jungle", 0x5a1->"jungle", 0x5a2->"jungle", 0x5a3->"jungle", 0x5a4->"jungle", 0x5a5->"jungle", 0x5a6->"jungle",
		0x5b3->"jungle", 0x5b4->"jungle", 0x5b5->"jungle", 0x5b6->"jungle", 0x5b7->"jungle", 0x5b8->"jungle", 0x5b9->"jungle", 0x5ba->"jungle",
		0x5f5->"jungle", 0x5f6->"jungle", 0x5f7->"jungle", 0x5f8->"jungle",
		0x605->"jungle", 0x606->"jungle", 0x607->"jungle", 0x608->"jungle", 0x609->"jungle", 0x60a->"jungle", 0x60b->"jungle", 0x60c->"jungle", 0x60d->"jungle", 0x60e->"jungle", 0x60f->"jungle", 0x610->"jungle",
		0x615->"jungle", 0x616->"jungle", 0x617->"jungle", 0x618->"jungle",
		0x727->"jungle", 0x728->"jungle", 0x729->"jungle", 0x72a->"jungle", 0x733->"jungle", 0x734->"jungle", 0x735->"jungle", 0x736->"jungle", 0x737->"jungle", 0x738->"jungle", 0x739->"jungle", 0x73a->"jungle"
	};

	// Create array of tiles to check: 5x5 grid with player at center (25 tiles total)
	var tiles_to_check := array{
		// Row 1 (y-2)
		{x-2, y-2}, {x-1, y-2}, {x, y-2}, {x+1, y-2}, {x+2, y-2},
		// Row 2 (y-1)
		{x-2, y-1}, {x-1, y-1}, {x, y-1}, {x+1, y-1}, {x+2, y-1},
		// Row 3 (y) - CENTER ROW with player at center position
		{x-2, y}, {x-1, y}, {x, y}, {x+1, y}, {x+2, y},
		// Row 4 (y+1)
		{x-2, y+1}, {x-1, y+1}, {x, y+1}, {x+1, y+1}, {x+2, y+1},
		// Row 5 (y+2)
		{x-2, y+2}, {x-1, y+2}, {x, y+2}, {x+1, y+2}, {x+2, y+2}
	};

	// Count terrain types found in the grid
	var terrain_counts := dictionary;
	
	foreach tile in tiles_to_check
		var check_x := tile[1];
		var check_y := tile[2];
		
		var statics := ListStaticsAtLocation(check_x, check_y, LIST_IGNORE_Z, 0, realm);
		
		foreach static in statics
			var static_id := static.objtype;
			var static_terrain := terrain_map[static_id];
			
			if (static_id != 0x244 && static_terrain)
				if (!terrain_counts.exists(static_terrain))
					terrain_counts[static_terrain] := 0;
				endif
				terrain_counts[static_terrain] := terrain_counts[static_terrain] + 1;
			endif
		endforeach
		
		var mapinfo := GetMapInfo(check_x, check_y, realm);
		if (mapinfo)
			var landtile_id := mapinfo.landtile;
			var terrain_name := terrain_map[landtile_id];
			
			if (terrain_name)
				if (!terrain_counts.exists(terrain_name))
					terrain_counts[terrain_name] := 0;
				endif
				terrain_counts[terrain_name] := terrain_counts[terrain_name] + 1;
			else
				// Check if undefined terrain is water via config
				var water_check := struct;
				water_check.+x := check_x;
				water_check.+y := check_y;
				if (IsWater(water_check, mapinfo))
					if (!terrain_counts.exists("water"))
						terrain_counts["water"] := 0;
					endif
					terrain_counts["water"] := terrain_counts["water"] + 1;
				endif
			endif
		endif
	endforeach

	// Find the dominant terrain type
	var dominant_terrain := error;
	var max_count := 0;
	
	foreach terrain_type in (terrain_counts.keys())
		var count := terrain_counts[terrain_type];
		if (count > max_count)
			max_count := count;
			dominant_terrain := terrain_type;
		endif
	endforeach

	return dominant_terrain;
endfunction

function CanTransform(who, form)
	var skill := AP_GetSkill(who, MAGERY);
	var difficulty := 35; // Hardcoded difficulty for all primordial forms
	if (SkillCheck(who, MAGERY, difficulty * 1.2 + 15) <= 0)
		return 0;
	endif

	var manaCost := difficulty / 2;
	if (!AP_ConsumeVital(who, MANA, manaCost))
		return 0;
	endif

	return 1;
endfunction

function ApplyTransformationElementalDamage(who, form_key, duration)
	// Mapeia forma para primordial flag (100% conversão elemental de dano)
	case (form_key)
		"fogo":         SetObjProperty(who, "primordial_fire", 1);
		"gelo":         SetObjProperty(who, "primordial_cold", 1);
		"agua":         SetObjProperty(who, "primordial_cold", 1);
		"ar":           SetObjProperty(who, "primordial_energy", 1);
		"areia":        SetObjProperty(who, "primordial_energy", 1);
		"energia":      SetObjProperty(who, "primordial_energy", 1);
		"ent_medio":    SetObjProperty(who, "primordial_poison", 1);
		"ent_grande":   SetObjProperty(who, "primordial_poison", 1);
		"ent_alto":     SetObjProperty(who, "primordial_poison", 1);
		"totem":        SetObjProperty(who, "primordial_poison", 1);
		"terra":        SetObjProperty(who, "primordial_physical", 1);
		"pedra":        SetObjProperty(who, "primordial_physical", 1);
		"obsidiana":    SetObjProperty(who, "primordial_energy", 1);
		default:        return 0;
	endcase

	return 1;
endfunction

function GetPrimordialHitScript(form_key)
	case (form_key)
		"fogo":         return ":combat:weaponHitScripts/FireHit";       // fire damage + explosion
		"gelo":         return ":combat:weaponHitScripts/IceHit";        // cold damage + frost
		"agua":         return ":combat:weaponHitScripts/IceHit";        // cold damage + frost
		"ent_medio":    return ":combat:weaponHitScripts/spitacid";      // acid/poison damage
		"ent_grande":   return ":combat:weaponHitScripts/spitacid";      // acid/poison damage
		"ent_alto":     return ":combat:weaponHitScripts/spitacid";      // acid/poison damage
		"totem":        return ":combat:weaponHitScripts/spitacid";      // acid/poison damage
		"ar":           return ":combat:weaponHitScripts/LightningHit";  // energy damage + lightning
		"areia":        return ":combat:weaponHitScripts/LightningHit";  // energy damage + lightning
		"energia":      return ":combat:weaponHitScripts/LightningHit";  // energy damage + lightning
		"obsidiana":    return ":combat:weaponHitScripts/LightningHit";  // energy damage + lightning
		default:        return 0; // terra/pedra = no special effect
	endcase
endfunction