/****************************************************************************************************
# Description:
This script handles player transformation into a primordial Fire Elemental form using the command:
`.formaprimordial`. This uses the same transformation system as wildshape but with a single fixed
high-tier form.

# Transformation Process:
- Validates the transformation request (fixed Fire Elemental form).
- Changes the player's appearance and applies attribute boosts.
- Uses the SAME properties and timers as wildshape.
- Starts the standard metamorfose timer.

# Interaction with `.voltar` and `endmetamorfose.src`:
- Uses the exact same cleanup process as wildshape transformations
- The `.voltar` command works identically
- All properties and timers are the same


TODO: Add entropia para alterar transformacoes de mesmo bioma
TODO: Add criteria for z-index, itens, minerios for certain transformations

****************************************************************************************************/
use uo;
use os;
use util;
use cfgfile;
use vitals;

include "include/client";
include "include/sounds";
include "include/say";
include ":spells:tnmagery";
include ":timedScripts:timedScripts";
include ":attributes:attributes";
include ":tn:npcutil";
include ":brainAI:npcUtil";
include ":spells:summon";
include ":survival:fishingFunctions";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program transformprimordial(who, text)
	// Check if player has the ability
	if (!MobileWrapper(who).HasAbility(ABILITY_ID::CHAMADO_DA_FORMA_PRIMORDIAL))
		SendSysMessageEx(who, "Você não conhece esta técnica.", SSM_FAIL);
		return;
	endif

	// Get form database and terrain mapping
	var form_db := InitFormDatabase();
	var terrain_mapping := GetTerrainToFormsMapping();

	// Parse requested form name
	text := Lower(Trim(text));
	if (!text || text == "")
		// Get current terrain to show available forms
		var current_terrain := GetTerrainAtLocation(who, who.x, who.y, who.realm);
		if (current_terrain)
			var allowed_forms := terrain_mapping[current_terrain];
			if (allowed_forms && allowed_forms.size() > 0)
				var available_list := "";
				foreach form_key in allowed_forms
					if (available_list != "")
						available_list := available_list + "|";
					endif
					available_list := available_list + form_key;
				endforeach
				SendSysMessageEx(who, "Use: .formaprimordial <" + available_list + ">", SSM_FAIL);
			else
				SendSysMessageEx(who, "Nenhuma forma primordial pode ser invocada neste terreno.", SSM_FAIL);
			endif
		else
			SendSysMessageEx(who, "Use: .formaprimordial <forma> - Este terreno não permite transformação primordial.", SSM_FAIL);
		endif
		return;
	endif

	// Get current terrain
	var current_terrain := GetTerrainAtLocation(who, who.x, who.y, who.realm);
	if (!current_terrain)
		SendSysMessageEx(who, "Este terreno não permite transformação primordial.", SSM_FAIL);
		return;
	endif

	// Get allowed forms for this terrain
	var allowed_forms := terrain_mapping[current_terrain];
	if (!allowed_forms)
		SendSysMessageEx(who, "Nenhuma forma primordial pode ser invocada neste terreno.", SSM_FAIL);
		return;
	endif

	// Check if requested form is allowed on this terrain
	var form_allowed := 0;
	foreach form_key in allowed_forms
		if (form_key == text)
			form_allowed := 1;
			break;
		endif
	endforeach

	if (!form_allowed)
		var available_list := "";
		foreach form_key in allowed_forms
			if (available_list != "")
				available_list := available_list + ", ";
			endif
			available_list := available_list + form_key;
		endforeach
		SendSysMessageEx(who, "Esta forma não está disponível neste terreno. Formas disponíveis: " + available_list, SSM_FAIL);
		return;
	endif

	// Get the form from database
	var primordial_form := form_db[text];
	if (!primordial_form)
		SendSysMessageEx(who, "Forma desconhecida.", SSM_FAIL);
		return;
	endif

	var selected_form := ValidateTransformation(who, primordial_form);
	if (!selected_form)
		return;
	endif

	HandleWildShapeUnequip(who);

	PlayTransformationEffects(who);

	PerformTransformation(who, selected_form);

	var transformation_duration := CalculateTransformationDuration(who);
	TS_StartTimer(who, "metamorfosedruida", transformation_duration);

	ApplyAttributeBoosts(who, selected_form, transformation_duration);
	ApplyAttributeModifiers(who, selected_form, transformation_duration, transformation_duration);

	// Aplica dano elemental baseado na forma
	ApplyTransformationElementalDamage(who, selected_form.key, transformation_duration);

	// Apply elemental hitscripts to character body
	var hitscript := GetPrimordialHitScript(selected_form.key);
	if (hitscript)
		SetObjProperty(who, "HitScripts", array{hitscript});
		SendSysMessageEx(who, "[HITSCRIPT] Forma primordial: " + selected_form.key + " -> " + hitscript, SSM_INFO);
	elseif (selected_form.key)
		SendSysMessageEx(who, "[HITSCRIPT] Forma sem efeito elemental: " + selected_form.key, SSM_INFO);
	endif

	SendSysMessageEx(who, "Você se transforma em " + selected_form.name + ".", SSM_INFO);
endprogram

