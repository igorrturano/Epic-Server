function GetTerrainToFormsMapping()
	var mapping := dictionary;

	mapping["lava"] := {"fogo"};
	mapping["snow"] := {"gelo"};
	mapping["forest"] := {"ent_medio", "ent_grande", "ent_alto", "totem"};
	mapping["forrest"] := {"ent_medio", "ent_grande", "ent_alto", "totem"};
	mapping["tree"] := {"ent_medio", "ent_grande", "ent_alto", "totem"};
	mapping["leaves"] := {"ent_medio", "ent_grande", "ent_alto", "totem"};
	mapping["jungle"] := {"ent_medio", "ent_grande", "ent_alto", "totem"};
	mapping["water"] := {"agua"};
	mapping["sand"] := {"areia", "ar"};
	mapping["cave"] := {"gelo", "fogo", "terra", "pedra", "obsidiana", "totem"};
	mapping["Cave"] := {"gelo", "fogo", "terra", "pedra", "obsidiana", "totem"};
	mapping["rock"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["stone"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["marble"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["cobblestones"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["brick"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["embank"] := {"terra", "pedra", "obsidiana", "totem"};
	mapping["grass"] := {"ent_medio", "ent_grande", "ent_alto", "fogo"};
	mapping["dirt"] := {"terra", "pedra", "obsidiana", "fogo"};
	mapping["void"] := {"energia"};

	return mapping;
endfunction

function PlayTransformationEffects(who)
	PlaySoundEffect(who, SFX_SPELL_HEAL);
	PerformAction(who, HUMAN_ANIM::CAST_AREA);
endfunction

function GetElementalEffects(form_name)
	var effects := struct;
	
	case (form_name)
		"fogo":
			effects.buildup_sound := 0x0226;  // Flame
			effects.buildup_effect := 0xD040; // Small flames
			effects.engulf_effect := 0xD06F;  // Fire engulf
			effects.reveal_sound := 0x0112;   // Fire elemental
			effects.reveal_effect := 0xD05E;  // Emergence
			
		"gelo":
			effects.buildup_sound := 0x0041;  // Ice shatter
			effects.engulf_effect := 0x6D82;  // Ice spikes
			effects.reveal_sound := 0x0041;   // Ice shatter
			
		"agua":
			effects.buildup_sound := 0x0013;  // Wave
			effects.buildup_effect := 0x352D; // Splash
			effects.engulf_effect := 0x6DC3;  // Water explosion
			effects.reveal_sound := 0x0117;   // Water elemental
			effects.reveal_effect := 0x352D;  // Splash
			
		"areia":
			effects.buildup_sound := 0x0015;  // Wind
			effects.engulf_effect := 0xCADD;  // Tornado/dust
			effects.reveal_sound := 0x0015;   // Wind
			
		"ar":
			effects.buildup_sound := 0x0108;  // Air elemental
			effects.engulf_effect := 0xCADD;  // Tornado
			effects.reveal_sound := 0x0108;   // Air elemental
			
		"energia":
			effects.buildup_sound := 0x002A;  // Thunder
			effects.use_lightning := 1;       // Flag to use PlayLightningBoltEffect
			effects.reveal_sound := 0x002A;   // Thunder
			effects.reveal_effect := 0x6CEC;  // Energy waves
			
		"ent_medio":
		"ent_grande":
		"ent_alto":
		"totem":
			effects.buildup_sound := 0x0053;  // Quiet wood/earth sound
			effects.buildup_effect := 0x38C8; // Vines at ground level
			effects.engulf_effect := 0x38C8;  // Vines at ground level
			effects.reveal_sound := 0x0053;   // Quiet wood/earth sound
			effects.reveal_effect := 0x38C8;  // Vines emerging from ground
			
		"terra":
		"pedra":
		"obsidiana":
			effects.buildup_sound := 0x0116;  // Stone/rock
			effects.buildup_effect := 0x3728; // Smoke/dust
			effects.engulf_effect := 0x6D67;  // Earthquake
			effects.reveal_sound := 0x010D;   // Earth elemental
			effects.reveal_effect := 0x3728;  // Dust settling
			
		default:
			// Fallback to wood effects
			effects.buildup_sound := 0x010D;  // Earth elemental
			effects.buildup_effect := 0x6D01; // Roots
			effects.engulf_effect := 0x6D01;  // Roots
			effects.reveal_sound := 0x010D;   // Earth elemental
			effects.reveal_effect := 0x6D01;  // Root emergence
	endcase
	
	return effects;
endfunction

function PerformTransformation(who, form)
	// Save the player's original appearance before transformation. Graphic is
	// not snapshotted — trueobjtype is the canonical race body and what
	// endmetamorfose / candie restore from.
	var metamorfose := struct;
	metamorfose.+originalcolor := who.color;
	metamorfose.+originalname := who.name;
	metamorfose.+newgraphic := form.graphic;
	SetObjProperty(who, "metamorfose", metamorfose);

	// Get element-specific effects
	var effects := GetElementalEffects(form.key);

	// Pre-transformation: casting animation and elemental buildup
	PlaySoundEffect(who, effects.buildup_sound);
	PerformAction(who, HUMAN_ANIM::CAST_AREA);
	PrintTextAbove(who, "*transformando-se em forma primordial*");
	
	// Freeze and hide player during transformation
	who.frozen := 1;
	sleepms(500);
	
	// Elemental buildup effect
	if (effects.buildup_effect)
		PlayObjectCenteredEffect(who, effects.buildup_effect, 10, 15);
		sleepms(600);
	endif
	
	// Engulf/transformation effect
	if (effects.use_lightning)
		PlayLightningBoltEffect(who);
	elseif (effects.engulf_effect)
		PlayObjectCenteredEffect(who, effects.engulf_effect, 10, 30);
	endif
	who.hidden := 1;
	sleepms(1200);
	
	// Transform
	who.graphic := form.graphic;
	who.color := form.color;
	
	// Adjust player's name using SetName function
	if (GetObjProperty(who, "charname") == error)
		SetObjProperty(who, "charname", who.name);
	endif

	// Handle squelch based on abilities
	if (MobileWrapper(who).HasAbility(ABILITY_ID::ELO_NATURAL))
		who.squelch(0);
	else
		who.squelch(-1);
	endif

	// Reveal in elemental form with emergence effect
	who.hidden := 0;
	if (effects.reveal_sound)
		PlaySoundEffect(who, effects.reveal_sound);
	endif
	if (effects.use_lightning)
		PlayLightningBoltEffect(who);
	elseif (effects.reveal_effect)
		PlayObjectCenteredEffect(who, effects.reveal_effect, 10, 25);
	endif
	sleepms(500);
	who.frozen := 0;
endfunction

function HandleWildShapeUnequip(who)
	UnequipAllWild(who);
	if (MobileWrapper(who).HasAbility(ABILITY_ID::ELO_NATURAL))
		UnequipArmorWild(who);
		UnequipWeaponsWild(who);
	else
		UnequipAllWild(who);
	endif
endfunction

function UnequipAllWild(who)
	var equips := EnumeratePhysicalItems(who);

	foreach equip in equips
		MoveItemToContainer(equip, who.backpack);
	endforeach
endfunction

function UnequipArmorWild(who)
	var equips := EnumeratePhysicalItems(who);

	foreach equip in equips
		if ((equip.isa(POLCLASS_ARMOR)) && equip.resist_physical > 0)
			MoveItemToContainer(equip, who.backpack);
		endif
	endforeach
endfunction

function UnequipWeaponsWild(who)
	var equips := EnumeratePhysicalItems(who);

	foreach equip in equips
		if (equip.isa(POLCLASS_WEAPON))
			MoveItemToContainer(equip, who.backpack);
		endif
	endforeach
endfunction

function ApplyAttributeModifiers(who, form, duration, transformation_duration)
	var skill_a_calc := CINT(0.1318 * form.strength + 0.5316 * form.dexterity + 0.5974 * 40); 
	var resistmod_calc := CINT(-0.0015 * form.strength + 0.0375 * form.intelligence + 0.1125 * form.dexterity); 
	var hitsmod_calc := CINT(form.strength / 3);
	var manamod_calc := CINT(form.dexterity / 3);
	var stammod_calc := CINT(form.intelligence / 3);
	var dicedmg_calc := CalculateDiceDamage();

	var bonusMagery := 0;
	bonusMagery:= 1 + (AP_GetSkill(who, MAGERY) / 300); 
	if (MobileWrapper(who).HasAbility(ABILITY_ID::CORACAO_DA_MATILHA))
		skill_a_calc := CINT(skill_a_calc * bonusMagery);
		hitsmod_calc := CINT(hitsmod_calc * bonusMagery);
		resistmod_calc := CINT(resistmod_calc * bonusMagery);
	endif

	var bonusMagicLore := 0;
	bonusMagicLore := CINT(AP_GetSkill(who, THEOLOGY) / 6);
	var bonusInstintoHP := CINT(AP_GetSkill(who, THEOLOGY) / 3);
	if (MobileWrapper(who).HasAbility(ABILITY_ID::INSTINTO_DE_SOBREVIVENCIA))
		skill_a_calc := CINT(skill_a_calc + bonusMagicLore);
		hitsmod_calc := CINT(hitsmod_calc + bonusInstintoHP);
		resistmod_calc := CINT(resistmod_calc + bonusMagicLore);
	endif

	var current_hitsmod := GetObjProperty(who, "hitsmod");
	var current_manamod := GetObjProperty(who, "manamod");
	var current_stammod := GetObjProperty(who, "stammod");
	var current_resistmod := GetObjProperty(who, "resistmod");

	// Handle cases where property doesn't exist
	if (current_hitsmod == error)
		current_hitsmod := 0;
	endif
	if (current_manamod == error)
		current_manamod := 0;
	endif
	if (current_stammod == error)
		current_stammod := 0;
	endif
	if (current_resistmod == error)
		current_resistmod := 0;
	endif

	SetObjProperty(who, "skill_a", skill_a_calc);
	SetObjProperty(who, "dicedmg", dicedmg_calc);
	SetObjProperty(who, "polymorph_hitsmod", hitsmod_calc);
	SetObjProperty(who, "polymorph_manamod", manamod_calc);
	SetObjProperty(who, "polymorph_stammod", stammod_calc);
	SetObjProperty(who, "polymorph_resistmod", resistmod_calc);
	SetObjProperty(who, "hitsmod", current_hitsmod + hitsmod_calc);
	SetObjProperty(who, "manamod", current_manamod + manamod_calc);
	SetObjProperty(who, "stammod", current_stammod + stammod_calc);
	SetObjProperty(who, "resistmod", current_resistmod + resistmod_calc);
	recalcvitals(who);
	ApplyEpicHealing(who, hitsmod_calc);
	applyResistMod(who, resistmod_calc, form, transformation_duration);
endfunction

function applyResistMod(who, resistmod_calc, form, transformation_duration)
	// Reset all resist mods
	who.resist_physical_mod := 0;
	who.resist_fire_mod := 0;
	who.resist_cold_mod := 0;
	who.resist_poison_mod := 0;
	who.resist_energy_mod := 0;
	
	// Apply base resistance to all elements
	who.resist_physical_mod := who.resist_physical_mod + resistmod_calc;
	who.resist_fire_mod := who.resist_fire_mod + resistmod_calc;
	who.resist_cold_mod := who.resist_cold_mod + resistmod_calc;
	who.resist_poison_mod := who.resist_poison_mod + resistmod_calc;
	who.resist_energy_mod := who.resist_energy_mod + resistmod_calc;

endfunction

function ApplyAttributeBoosts(who, form, duration)
	var strength_boost := CINT(form.strength / 3);
	var agility_boost := CINT(form.dexterity / 3);
	var intelligence_boost := CINT(form.intelligence / 3);

	TS_StartTimer(who, "agility", CINT(duration), agility_boost);
	TS_StartTimer(who, "strength", CINT(duration), strength_boost);
	TS_StartTimer(who, "intelligence", CINT(duration), intelligence_boost);
endfunction

function CalculateDiceDamage()
	var primary_dice := "12d2"; 
	return array{primary_dice, primary_dice, primary_dice};
endfunction

function CalculateTransformationDuration(who)
	var duration := 60 + 540 * AP_GetSkill(who, THEOLOGY) / 100;
	return duration;
endfunction

function FailTransformation(who)
	who.frozen := 0;
	PlayObjectCenteredEffect(who, FX_FIZZLE, 5, 50);
	PlaySoundEffect(who, SFX_SPELL_FAIL);
	return 1;
endfunction

function ValidateTransformation(who, form)
	if (who.npctemplate)
		return form;
	endif

	if (IsPlayerInTransformation(who))
		SendSysMessageEx(who, "Você já está sob a forma de outra criatura. Primeiro, volte à sua forma normal.", SSM_FAIL);
		return 0;
	endif

	if (!CanTransform(who, form))
		SendSysMessageEx(who, "Você falhou em assumir a forma primordial.", SSM_FAIL);
		FailTransformation(who);
		return 0;
	endif

	return form;
endfunction

function IsPlayerInTransformation(who)
	return GetObjProperty(who, "metamorfose") != error;
endfunction

function GetTerrainAtLocation(player, x, y, realm)
	var terrain_map := dictionary{
		// Dirt terrains (200+ tiles)
		0x71->"dirt", 0x72->"dirt", 0x73->"dirt", 0x74->"dirt", 0x75->"dirt", 0x76->"dirt", 0x77->"dirt", 0x78->"dirt", 0x79->"dirt", 0x7a->"dirt", 0x7b->"dirt", 0x7c->"dirt",
		0x82->"dirt", 0x83->"dirt", 0x85->"dirt", 0x86->"dirt", 0x87->"dirt", 0x88->"dirt", 0x89->"dirt", 0x8a->"dirt", 0x8b->"dirt", 0x8c->"dirt", 0x8d->"dirt", 0x8e->"dirt", 0x8f->"dirt",
		0x90->"dirt", 0x91->"dirt", 0x92->"dirt", 0x93->"dirt", 0x94->"dirt", 0x95->"dirt", 0x96->"dirt", 0x97->"dirt", 0x98->"dirt", 0x99->"dirt", 0x9a->"dirt", 0x9b->"dirt", 0x9c->"dirt", 0x9d->"dirt", 0x9e->"dirt", 0x9f->"dirt",
