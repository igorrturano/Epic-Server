include "include/say";
include ":tn:cooldown";
include ":wrappers:Objects/Model/WeaponWrapper";
use os;

program meditar(who, text)
	var chardata := GetObjProperty(who, "chardata");
	if (chardata.magia != "arcane_archer")
		SendSysMessageEx(who, "Apenas arqueiros arcanos podem usar este comando.", SSM_FAIL);
		return;
	endif

	if (WeaponWrapper(who.weapon).GetCategory() != WEAPON_CATEGORY::MAGICBOW)
		SendSysMessageEx(who, "Você precisa estar com seu arco elemental conjurado!", SSM_FAIL);
		return;
	endif

	if (!text)
		var result := Run_Script(":combat:arcane_arrows", { who });
		if (result.errortext)
			SendSysMessageEX(who, "Error: " + result.errortext);
		endif
		return;
	endif

	if (Lower(text) == "fogo")
		SetObjProperty(who.weapon, "fire_arrow", 1);

		EraseObjPRoperty(who.weapon, "cold_arrow");
		EraseObjProperty(who.weapon, "energy_arrow");
	elseif (Lower(text) == "gelo")
		SetObjProperty(who.weapon, "cold_arrow", 1);

		EraseObjProperty(who.weapon, "energy_arrow");
		EraseObjProperty(who.weapon, "fire_arrow");
	elseif (Lower(text) == "raio")
		SetObjProperty(who.weapon, "energy_arrow", 1);

		EraseObjProperty(who.weapon, "fire_arrow");
		EraseObjPRoperty(who.weapon, "cold_arrow");
	endif

	who.frozen := 1;
	var sound := 0x666; // Energy
	if (GetObjProperty(who.weapon, "fire_arrow"))
		sound := 0x5cb;
	elseif (GetObjProperty(who.weapon, "cold_arrow"))
		sound := 0x5c8;
	endif
	PrintTextAbove(who, "*Canalizando Elemento*");
	PlaySoundEffect(who, sound);
	sleep(2);
	PlaySoundEffect(who, 0x656);

	who.frozen := 0;

endprogram
