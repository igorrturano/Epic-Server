use uo;
use os;
use math;
use vitals;
use cfgfile;

include ":timedscripts:timedScripts";
include "include/say";
include ":mounts:mounts";
include ":attributes:attributes";
// include "include/shapes";
include "include/client";
include "include/sounds";
include "include/facings";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":charactercreation:resists";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":tn:cooldown";
include "include/noiseAlert";

enum arrremesso
	ARREMESSO_TIPO_ITEM,
	ARREMESSO_TIPO_MOBILE,
	ARREMESSO_TIPO_TERRENO
endenum

program arremesso(params)
	var who := params[1];
	params := 0; // No longer needed

	var cd := GetCooldown(who, "arremesso_cd");
	if (cd)
		SendSysMessageEx(who, "Voce precisa esperar " + cd + " segundos para arremessar novamente.", SSM_FAIL);
		return 0;
	endif

	var _chardata := GetObjProperty(who, "chardata");
	if (who.hidden && _chardata && (CInt(_chardata.Skills["Stealth"]) == 3 || CInt(_chardata.Skills["Sneak"]) == 3))
		return DoStealthDistraction(who);
	endif

	if (who.hidden && !MobileWrapper(who).HasAbility(ABILITY_ID::NINJA_PATH))
		SendSysMessageEx(who, "Voce nao pode fazer isso escondido.", SSM_FAIL);
		return 0;
	elseif (GetEquipmentByLayer(who, 0x19) && GetObjProperty(who, "chardata").trait != "Cavalaria de Escaramuça")
		SendSysMessageEx(who, "Voce nao consegue fazer isso montado.", SSM_FAIL);
		return 0;
	elseif (GetObjProperty(who, "pilotando") || GetObjProperty(who, "metamorfose") != error)
		SendSysMessageEx(who, "Voce nao pode arremessar enquanto pilota um golem ou esta metamorfoseado.",
				   SSM_FAIL);
		return 0;
	endif

	var _left_hand := GetEquipmentByLayer(who, 0x02);
	if (who.weapon)
		var _weapon_attr := Upper(who.weapon.getCfgElem().Attribute);
		if (_weapon_attr == "TWO_HANDED" || _weapon_attr == "DUAL_WIELD" || _left_hand)
			SendSysMessageEx(who, "Voce precisa ter pelo menos uma mao livre para arremessar.", SSM_FAIL);
			return 0;
		endif
	endif

	if (AP_GetVital(who, "Stamina") < 20)
		SendSysMessageEx(who, "Voce esta cansado demais para arremessar algo.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(who, "Escolha o que deseja arremessar", SSM_REQUEST);
	var targ := Target(who);
	var arcane_bows := array{ 0xFA6D, 0XF997 };

	if (!targ)
		SendSysMessageEx(who, "Cancelled.", SSM_FAIL);
		return 0;
	elseif (targ.IsA(POLCLASS_MOBILE))
		if (!MobileWrapper(who).HasAbility(ABILITY_ID::TAVERN_BRAWLER))
			SendSysMessageEx(who, "Voce nao consegue arremessar essa pessoa.", SSM_FAIL);
			return 0;
		elseif (AP_GetStat(who, STRENGTH) <= AP_GetStat(targ, STRENGTH))
			SendSysMessageEx(who, "Voce nao e forte o suficiente para arremessar essa pessoa.", SSM_FAIL);
			return 0;
		endif
	elseif (targ.npctemplate && !MobileWrapper(who).HasAbility(ABILITY_ID::TAVERN_BRAWLER))
		SendSysMessageEx(who, "Voce nao consegue arremessar essa pessoa.", SSM_FAIL);
		return 0;
	elseif (Distance(who, targ) > 1)
		SendSysMessageEx(who, "Muito longe.", SSM_FAIL);
		return 0;
	elseif (targ.isa(POLCLASS_CORPSE))
		SendSysMessageEx(who, "Voce nao pode arremessar corpos.", SSM_FAIL);
		return 0;
	elseif (targ.serial == who.serial)
		SendSysMessageEx(who, "Voce nao pode se arremessar.", SSM_FAIL);
		return 0;
	elseif (targ == who.backpack)
		SendSysMessageEx(who, "Voce nao pode arremessar sua própria bolsa.", SSM_FAIL);
		return 0;
	elseif (!targ.movable)
		SendSysMessageEx(who, "Voce nao pode arremessar isso.", SSM_FAIL);
		return 0;
	elseif (targ.objtype in arcane_bows)
		SendSysMessageEx(who, "Voce nao pode arremessar isso.", SSM_FAIL);
		return 0;
	elseif (targ.amount > 1)
		SendSysMessageEx(who, "Voce so pode arremessar um item por vez.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(who, "Aonde vai arremessar?", SSM_REQUEST);
	var alvo := TargetCoordinates(who);
	var tipoAlvo := 0;

	if (alvo.item)
		tipoAlvo := ARREMESSO_TIPO_ITEM;
		alvo := alvo.item;
	elseif (alvo.mobile)
		tipoAlvo := ARREMESSO_TIPO_MOBILE;
		alvo := alvo.mobile;
	else
		tipoAlvo := ARREMESSO_TIPO_TERRENO;
		alvo := struct{ x := alvo.x, y := alvo.y, z := alvo.z, realm := alvo.realm };
	endif

	if (alvo == who)
		SendSysMessageEx(who, "Seu instinto de sobrevivencia nao permite.", SSM_FAIL);
		return 0;
	endif

	if (targ == alvo)
		SendSysMessageEx(who, "Essa é uma tarefa impossível.", SSM_FAIL);
		return 0;
	endif

	if (alvo in EnumerateItemsInContainer(who.backpack))
		SendSysMessageEx(who, "Voce nao pode arremessar neste alvo.", SSM_FAIL);
		return 0;
	endif

	if (tipoAlvo == ARREMESSO_TIPO_TERRENO && !CheckLosAt(who, alvo.x, alvo.y, alvo.z))
		SendSysMessageEx(who, "Voce nao consegue ver o alvo.", SSM_FAIL);
		return 0;
	endif

	var dist := Distance(targ, alvo);
	var throw_max_range := AP_GetStat(who, STRENGTH) / 10;
	if (targ.IsA(POLCLASS_MOBILE))
		throw_max_range := AP_GetStat(who, STRENGTH) / 20;
	endif

	if (dist > throw_max_range)
		SendSysMessageEx(who, "Sua forca so permite voce arremesar ate " + Cint(throw_max_range) + " tiles.",
				   SSM_FAIL);
		return 0;
	endif

	// Ninja Path: daggers don't cost stamina
	if (MobileWrapper(who).HasAbility(ABILITY_ID::NINJA_PATH) && targ.isA(POLCLASS_ITEM))
		var _ww := WeaponWrapper(targ);
		if (!_ww.GetObjRef().errortext && _ww.GetCategory() == WEAPON_CATEGORY::DAGGER || _ww.GetObjRef().objtype == 0x27AC) // Shuriken
			AP_ConsumeVital(who, "Stamina", 5);
		else
			if (who.weapon.IsThrowingWeapon())
				AP_ConsumeVital(who, "Stamina", 10);
			else
				AP_ConsumeVital(who, "Stamina", 20);
			endif
		endif
	//Sapador jogar poção
	elseif(MobileWrapper(who).HasAbility(ABILITY_ID::ENGENHARIA_DE_GATILHOS) && getobjProperty(targ, "science") == BUFF)
		AP_ConsumeVital(who, "Stamina", 5);
	elseif (who.weapon.IsThrowingWeapon())
		AP_ConsumeVital(who, "Stamina", 10);
	else
		AP_ConsumeVital(who, "Stamina", 20);
	endif

	SetCooldown(who, "arremesso_cd", 10);

	var to_miss_chance := 50;
	if (alvo.isA(POLCLASS_MOBILE))
		to_miss_chance := GetResist(alvo, REFLEXES);
	endif

	var dmg;
	if (targ.isA(POLCLASS_MOBILE) && !targ.npctemplate)
		dmg := RandomDiceRoll("1d6") + Cint(AP_GetStat(targ, STRENGTH) / 10);
	elseif (targ.isA(POLCLASS_WEAPON))
		dmg := RandomDiceRoll("1d6") + RandomDiceRoll(targ.getMainDamageDice());
	elseif (targ.weight < 3)
		dmg := RandomDiceRoll("1d2");
	else
		dmg := RandomDiceRoll("1d4");
	endif

	var ranged_bonus := Cint(AP_GetSkill(who, RANGED));
	var str_bonus := AP_GetStat(who, STRENGTH);
	var dex_bonus := AP_GetStat(who, DEXTERITY);
	var dmg_bonus := 0;
	if (MobileWrapper(who).HasAbility(ABILITY_ID::TAVERN_BRAWLER))
		dmg_bonus := Cint((str_bonus + dex_bonus) / 20);
	endif
	dmg += dmg_bonus;
	var random := Cint(RandomInt(80));
	var to_hit_chance := random + ((str_bonus + dex_bonus + ranged_bonus) / 10);

	if (targ.isA(POLCLASS_WEAPON))
		var parry_chance := Cint(AP_GetSkill(alvo, PARRY) / 3);
		if (alvo)
			MoveObjectToLocation(targ, alvo.x, alvo.y, alvo.z, alvo.realm, MOVEOBJECT_FORCELOCATION);
			PrintTextAbove(who, "*Arremessa " + targ.name + " em " + alvo.name + "*");
			PlaySoundEffect(who, 0x51C);
		endif

		if (to_hit_chance < (to_miss_chance + parry_chance)) // Erra ou defende
			if (to_hit_chance > to_miss_chance)
				// PlayHitSounds(who, alvo);
				PrintTextAbove(alvo, "*Defendeu!*");
			endif
			PrintTextAbove(who, "*Errou!*");
			return 0;
		else
			var poisonInfo := GetObjProperty(targ, "poisonInfo");
			if (poisonInfo)
				poisonInfo.dosage--;
				if (!CheckResist(alvo, FORTITUDE, poisoninfo.difficulty, -poisoninfo.difficulty_mod))
					if (TS_GetTimerInfo(alvo, "defaultPoison"))
						var defaultpoison := cint(TS_GetTimerLevel(alvo, "defaultPoison"));
						setobjproperty(alvo, "#poisontier", defaultpoison);
					endif
					if (getobjProperty(alvo, "#poisontier"))
						var poison := ts_gettimernames(alvo, type := "P");
						var teste := cint(getobjProperty(alvo, "#poisontier"));
						if (teste <= poisoninfo.tier)
							TS_LowerDuration(alvo, poison, -1);
							TS_StartTimer(alvo, poisonInfo.Name, poisonInfo.time, poisonInfo.level, who);
						endif
					else
						setobjproperty(alvo, "#poisontier", poisoninfo.tier);
						setobjproperty(alvo, "#poisonbonus", poisoninfo.difficulty_mod);
						TS_StartTimer(alvo, poisonInfo.name, poisonInfo.time, poisonInfo.level, who);
					endif
				else
					SendSysMessage(alvo, "Voce resistiu ao veneno", SSM_INFO);
					SendSysMessage(who, "O alvo resistiu ao veneno", SSM_INFO);
				endif
			endif
			PlayMovingEffect(who, alvo, 0x22C6, 10);
			DealDamage(alvo, dmg, DAMAGE_TYPE::BLUNT, who);
			PlaySoundEffect(alvo, 0x521);
			PrintTextAbove(alvo, "*Foi acertado por " + targ.name + "*");
			MakeBleed(alvo);
			// PlayHitSounds(who, alvo);
			return 1;
		endif
	else
		if (alvo)
			MoveObjectToLocation(targ, alvo.x, alvo.y, alvo.z, alvo.realm, MOVEOBJECT_FORCELOCATION);
			PrintTextAbove(who, "*Arremessa " + targ.name + " em " + (tipoAlvo != ARREMESSO_TIPO_TERRENO ? alvo.name :
																  "direção a um ponto") + "*");
			PlaySoundEffect(who, 0x51C);
		endif
		if (tipoAlvo != ARREMESSO_TIPO_TERRENO)
			if (to_hit_chance < to_miss_chance) // Errou!
				PrintTextAbove(who, "*Errou!*");
				return 0;
			else
				PrintTextAbove(alvo, "*Foi acertado por " + targ.name + "*");
				PlaySoundEffect(alvo, 0x136);
				if(MobileWrapper(who).HasAbility(ABILITY_ID::ENGENHARIA_DE_GATILHOS) && getobjProperty(targ, "science") == "Buff")
					var pot := CStr(targ.getCfgElem().efeito);
					pot := ":alchemy:"+pot ;
					var pid := Start_Script(pot, array{ alvo, targ });
				else
					DealDamage(alvo, dmg, DAMAGE_TYPE::BLUNT, who);
					PlaySoundEffect(alvo, 0x521);
					if (alvo.isSpiderEggSac())
						var pid := Start_Script(":lighting:onArremessado", array{ who, targ });
					endif
				endif
				return 1;
			endif
		else
			if (targ.objtype == 0x0a12 || targ.objtype == 0x0f64)
				var pid := Start_Script(":lighting:onArremessado", array{ who, targ });
			endif

		endif
	endif

	if (who.hidden && !MobileWrapper(who).HasAbility(ABILITY_ID::NINJA_PATH))
		who.hidden := 0;
	else
		if (AP_GetVital(who, "Stamina") < 50)
			who.hidden := 0;
			SendSysMessageEx(who, "Voce esta cansado demais para se manter escondido.", SSM_FAIL);
		else
			AP_ConsumeVital(who, "Stamina", 50);
		endif
	endif
endprogram

// Stealth-primary distraction throw. Picks an item from inventory, throws it
// at a coordinate (mobiles refused), emits noise from the landing tile so
// nearby NPCs investigate the wrong spot. 120s cooldown. Player stays hidden.
function DoStealthDistraction(who)
	if (AP_GetVital(who, "Stamina") < 10)
		SendSysMessageEx(who, "Voce esta cansado demais para arremessar algo.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(who, "Escolha o item para distrair", SSM_REQUEST);
	var targ := Target(who);
	if (!targ)
		SendSysMessageEx(who, "Cancelled.", SSM_FAIL);
		return 0;
	elseif (!targ.isA(POLCLASS_ITEM))
		SendSysMessageEx(who, "Escolha um item.", SSM_FAIL);
		return 0;
	elseif (!targ.movable)
		SendSysMessageEx(who, "Voce nao pode arremessar isso.", SSM_FAIL);
		return 0;
	elseif (targ.amount > 1)
		SendSysMessageEx(who, "Voce so pode arremessar um item por vez.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(who, "Aonde vai arremessar?", SSM_REQUEST);
	var alvo := TargetCoordinates(who);
	if (!alvo)
		SendSysMessageEx(who, "Cancelled.", SSM_FAIL);
		return 0;
	elseif (alvo.mobile)
		SendSysMessageEx(who, "Voce nao pode arremessar nisso!", SSM_FAIL);
		return 0;
	endif

	var ax := alvo.item ? alvo.item.x : alvo.x;
	var ay := alvo.item ? alvo.item.y : alvo.y;
	var az := alvo.item ? alvo.item.z : alvo.z;
	var ar := alvo.item ? alvo.item.realm : alvo.realm;

	var throw_max_range := AP_GetStat(who, STRENGTH) / 5;
	if (CoordinateDistance(who.x, who.y, ax, ay) > throw_max_range)
		SendSysMessageEx(who, "Sua forca so permite voce arremesar ate " + Cint(throw_max_range) + " tiles.", SSM_FAIL);
		return 0;
	endif

	if (!CheckLosAt(who, ax, ay, az))
		SendSysMessageEx(who, "Voce nao consegue ver o alvo.", SSM_FAIL);
		return 0;
	endif

	AP_ConsumeVital(who, "Stamina", 10);
	MoveObjectToLocation(targ, ax, ay, az, ar, MOVEOBJECT_FORCELOCATION);
	PlaySoundEffect(who, 0x51C);
	SendSysMessageEx(who, "Voce arremessa com intuito de distrair.", SSM_INFO);
	EmitNoise(targ, 12);
	SetCooldown(who, "arremesso_cd", 120);
	return 1;
endfunction
