	detach();
	var who := parms[1];

	// DEPRECATED: This script should not be running anymore
	SendSysMessageEx(who, "AVISO: Sistema de powerWords obsoleto detectado. Use o comando .r para rituais.", SSM_FAIL);

	// Clean up old PID properties if they exist
	EraseObjProperty(who, "#clericpid");
	EraseObjProperty(who, "#priestpid");

	return 0;

	// OLD CODE BELOW - KEPT FOR REFERENCE ONLY
