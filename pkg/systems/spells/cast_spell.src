program SpellStarter(params)
	var mobile := params[1]; // Caster
	var spellinfo := params[2]; // spellinfo
	var scroll := params[3]; // item que usou pra castar o spell (scroll, book, varinha ou nada)
	var targ := params[4];
	Set_Priority(50);
	var mw := MobileWrapper(mobile);

	if (!initializeSpellCasting(mobile, mw, spellinfo, scroll))
		return 0;
	endif

	if (!performPreCastingChecks(mobile, mw, spellinfo))
		return 0;
	endif

	if (!consumeResourcesForSpell(mobile, mw, spellinfo, scroll))
		return 0;
	endif

	if (!performCastingProcess(mobile, mw, spellinfo))
		return 0;
	endif

	targ := selectSpellTarget(mobile, spellinfo, targ);
	if (!targ)
		return 0;
	endif

	if (!checkCastingSuccess(mobile, mw, spellinfo, scroll))
		return 0;
	endif

	return finalizeCasting(mobile, spellinfo, targ, scroll);
endprogram

function initializeSpellCasting(mobile, mw, byref spellinfo, scroll)
	if (spellinfo.id != error)
		if (IsCantrip(spellinfo.id))
			WriteCantripSpellInfo(mobile, spellinfo);
		else
			writeSpellInfo(mobile, spellinfo);
		endif
	endif

	if (spellinfo.School == "Evocatium")
		EraseObjProperty(mobile, "#magiasilenciosa");
	endif

	if (GetObjProperty(mobile, "metamorfose") != error && !mw.HasAbility(ABILITY_ID::ELO_NATURAL))
		SendSysMessageEx(mobile, "Voce nao pode usar magias metamorfoseado.");
		return 0;
	endif

	if (GetCooldown(mobile, "silence") > 0)
		SendSysMessageEx(mobile, "Voce esta silenciado e nao pode usar magias.");
		return 0;
	endif

	if (!Attach(mobile))
		SendSysMessageEx(mobile, "Voce ja esta fazendo alguma coisa.", SSM_FAIL);
		return 0;
	endif

	if (GetObjProperty(mobile, "#Casting"))
		SendSysMessageEx(mobile, "Voce nao pode invocar um encanto agora.", SSM_FAIL);
		return 0;
	endif

	if (mobile.frozen && spellinfo.Type != "Ninjutsu")
		SendSysMessageEx(mobile, "Voce nao pode invocar um encanto paralisado.", SSM_FAIL);
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	if (!mw.HasAbility(ABILITY_ID::VINCULO_ELEMENTAL) && spellinfo.Type != "Ninjutsu"
		&& !isMobileCastActive(mobile, spellinfo.School))
		mobile.frozen := 1;
	endif

	return 1;
endfunction

function performPreCastingChecks(mobile, mw, byref spellinfo)
	spellinfo.mana += CInt(spellinfo.mana * GetObjProperty(mobile, "#manapenalty") / 100);
	
	// Entropia negativa da bonus para reduzir mana de magias necromanticas
	var entropy := mw.GetEntropy();
	if (entropy <= -4000 && spellinfo.Type == KAIJIN)
		spellinfo.mana -= Cint(abs(entropy) / 4000);
	elseif (entropy >= 4000 && spellinfo.Type == "Divine")
		spellinfo.mana += Cint(entropy / 4000);
	endif

	// Spiritual weapon prerequisite for Ahtaleloreth spells (except Absorver Arma 422, Encantar Objeto 421 and elemental blade spells 400-402)
	var spellId := CInt(spellinfo.id);
	if (spellinfo.School == "Ahtaleloreth" && spellId != 422 && spellId != 421 && spellId != 400 && spellId != 401 && spellId != 402)
		if (!GetCooldown(mobile, "spiritual_weapon"))
			SendSysMessageEx(mobile, "Voce precisa invocar sua lamina espiritual primeiro.", SSM_FAIL);
			mobile.frozen := 0;
			EraseObjProperty(mobile, "#Casting");
			return 0;
		endif
	endif

	var weapon := mw.GetEquipBySlot(WEAPON);
	var has_magic_focus := (weapon && (
		weapon.GetCategory() == WEAPON_CATEGORY::STAFF ||
		weapon.GetCategory() == WEAPON_CATEGORY::WAND ||
		weapon.GetCategory() == WEAPON_CATEGORY::SPELLBOOK
	));
	var can_cast_with_weapon := (spellinfo.School == "Ahtaleloreth") || spellinfo.Circle[1] == "0" || has_magic_focus;
	var tem_hab := mw.HasAbility(ABILITY_ID::CONSAGRACAO_DIVINA)
		|| mw.HasAbility(ABILITY_ID::SIGILO_DE_PROTECAO) 
		|| mw.HasAbility(ABILITY_ID::NINJA_PATH)
		|| mw.HasAbility(ABILITY_ID::VINCULO_ELEMENTAL) 
		|| mw.HasAbility(ABILITY_ID::SOUL_HARVEST) 
		|| mw.HasAbility(ABILITY_ID::CONEXAO_DIVINA) 
		|| mw.HasAbility(ABILITY_ID::SENSIBILIDADE_ARCANA);

	if (mobile.squelched && !mobile.npctemplate)
		SendSysMessageEx(mobile, "Voce precisa falar devido os componentes verbais da magia.", SSM_FAIL);
		FailSpell(mobile);
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	if (!EquipmentCheck(mobile) && !mobile.npctemplate && !tem_hab && !can_cast_with_weapon)
		SendSysMessageEx(mobile, "Suas maos precisam estar livres para gesticular os componentes gestuais necessarios para a magia.",
				   SSM_FAIL);
		mobile.frozen := 0;
		EraseObjProperty(mobile, "#medding");
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	var cast_time := CInt(GetObjProperty(mobile, "#cast_time"));
	var free_cast := GetObjProperty(mobile, "#free_cast");

	if (cast_time != error)
		if (ReadGameClock() > cast_time + 15)
			if (free_cast != error)
				SendSysMessageEx(mobile, "Você demorou demais para usar seu feitiço.", SSM_FAIL);
				EraseObjProperty(mobile, "#free_cast");
				EraseObjProperty(mobile, "#cast_time");
				mobile.frozen := 0;
				return 0;
			endif

			// Always clean up expired cast_time even for normal casts
			EraseObjProperty(mobile, "#cast_time");
		endif
	endif

	return 1;
endfunction

function consumeResourcesForSpell(mobile, mw, spellinfo, scroll)
	var mana_cost := _ApplyFocoArcanoManaDiscount(mw, spellinfo.mana);
	var current_mana := AP_GetVital(mobile, MANA);
	var current_stamina := AP_GetVital(mobile, STAMINA);
	if (GetObjProperty(mobile, "#free_cast"))
		return 1;
	endif

	if (GetCooldown(mobile, "divine_manifestation") > 0)
		return 1;
	endif

	// TODO: Decidir se vou consumir mana dos humanoids
	if (!mobile.npctemplate)
		if (mw.HasAbility(ABILITY_ID::DETERMINACAO_ARCANA))
			if (current_mana >= mana_cost)
				if (!AP_ConsumeVital(mobile, MANA, mana_cost))
					SendSysMessageEx(mobile, "Voce nao possui energia arcana suficiente em seu corpo para invocar esta magia!",
									  SSM_FAIL);
					FailSpell(mobile);
					EraseObjProperty(mobile, "#Casting");
					return 0;
				endif
			else
				var remaining_cost := mana_cost - current_mana;
				var refundProp := array{ current_mana, remaining_cost };
				SetObjProperty(mobile, "#CustoDeterminacaoArcana", refundProp); // prop para retornar os recursos caso cancele a magia.

				if (current_mana > 0)
					AP_ConsumeVital(mobile, MANA, current_mana);
				endif
				if (!AP_ConsumeVital(mobile, STAMINA, remaining_cost))
					SendSysMessageEx(mobile, "Voce nao possui energia suficiente em seu corpo para invocar esta magia!",
									  SSM_FAIL);
					FailSpell(mobile);
					EraseObjProperty(mobile, "#Casting");
					return 0;
				endif
			endif
		else
			if (!AP_ConsumeVital(mobile, MANA, mana_cost))
				SendSysMessageEx(mobile, "Voce nao possui energia arcana suficiente em seu corpo para invocar esta magia!",
								  SSM_FAIL);
				FailSpell(mobile);
				EraseObjProperty(mobile, "#Casting");
				return 0;
			endif
		endif
	endif

	if (!TNCheckReagents(mobile, spellinfo, scroll))
		if (!mw.HasAbility(ABILITY_ID::DETERMINACAO_ARCANA) && !isBloodied(mobile))
			SendSysMessageEx(mobile, "Voce nao possui os componentes materiais necessarios para invocacao desta magia arcana.",
							  SSM_FAIL);
			if (mw.HasAbility(ABILITY_ID::SUPPORT_CASTER))
				HealMana(mobile, CInt(spellinfo.mana * 0.5));
			endif
			FailSpell(mobile);
			EraseObjProperty(mobile, "#Casting");
			return 0;
		endif
	endif

	return 1;
endfunction

function _ApplyFocoArcanoManaDiscount(mw, manaCost)
	if (manaCost <= 0)
		return manaCost;
	endif

	if (!_HasFocoArcanoManaDiscount(mw))
		return manaCost;
	endif

	return manaCost - CInt(manaCost / 5);
endfunction

function _HasFocoArcanoManaDiscount(mw)
	if (!mw.HasAbility(ABILITY_ID::FOCO_ARCANO))
		return false;
	endif

	var weapon := mw.GetEquipBySlot(WEAPON);
	if (!weapon || weapon is @Exception)
		return false;
	endif

	var weaponCategory := weapon.GetCategory();
	return weaponCategory == WEAPON_CATEGORY::STAFF ||
	       weaponCategory == WEAPON_CATEGORY::WAND ||
	       weaponCategory == WEAPON_CATEGORY::SPELLBOOK ||
	       weaponCategory == WEAPON_CATEGORY::SPIRITUALBLADE ||
	       weaponCategory == WEAPON_CATEGORY::MAGICBOW;
endfunction

function performCastingProcess(mobile, mw, spellinfo)
	mobile.hidden := 0;
	SetObjProperty(mobile, "#Casting", 1);
	DistribuiEvento(mobile, EV_SPELLCAST);

	// if (!mobile.npctemplate)
	performSpellVocalization(mobile, spellinfo);
	// endif

	var orig_hp := AP_GetVital(mobile, "Hits");
	var delay := spellinfo.delay;
	var moveCheck_script;
	if (!mw.HasAbility(ABILITY_ID::VINCULO_ELEMENTAL))
		moveCheck_script := Start_Script(":spells:moveCheck/moveCheck", array{ mobile, GetPid() });
	endif

	if (!performSpellCycles(mobile, mw, spellinfo, orig_hp))
		return 0;
	endif

	if (!performSpellDelay(mobile, mw, delay, orig_hp))
		return 0;
	endif

	if (moveCheck_script)
		moveCheck_script.kill();
	endif

	mobile.frozen := 0;

	return 1;
endfunction

function performSpellVocalization(mobile, spellinfo)
	if (spellinfo.powerwords && GetObjProperty(mobile, "#magiasilenciosa") == error)
		PrintTextAbove(mobile, spellinfo.powerwords);
	endif
endfunction

function performSpellCycles(mobile, mw, spellinfo, byref orig_hp)
	var cycles := CInt(spellinfo.Cycles);

	if (GetObjProperty(mobile, "#free_cast"))
		cycles := 1;
		EraseObjProperty(mobile, "#free_cast");
	elseif (GetCooldown(mobile, "divine_manifestation") > 0)
		cycles := 1;
	else
		cycles += _applyConsecutiveCastPenalty(mobile, spellinfo);
	endif

	cycles += CInt(GetObjProperty(mobile, "#delaycycles"));

	while (cycles)
		if (!checkSpellInterruption(mobile, mw, orig_hp))
			return 0;
		endif

		if (GetObjProperty(mobile, "#magiasilenciosa") == error && spellinfo.spelltype != "Swordmage")
			performCastingAnimation(mobile, spellinfo.range);
		endif

		cycles -= 1;
		SleepMS(750);
	endwhile

	return 1;
endfunction

function _applyConsecutiveCastPenalty(mobile, spellinfo)
	if (mobile.npctemplate)
		return 0;
	endif

	var spellId := CInt(spellinfo.id);
	var bonus := 0;

	if (GetCooldown(mobile, "recent_cast") > 0)
		var lastId := GetObjProperty(mobile, "#lastCastSpellId");
		if (lastId != error && CInt(lastId) == spellId)
			var prev := GetObjProperty(mobile, "#consecutiveCastBonus");
			if (prev != error)
				bonus := Min(CInt(prev) + 1, 2);
			endif
		endif
	endif

	SetCooldown(mobile, "recent_cast", 15);
	SetObjProperty(mobile, "#lastCastSpellId", spellId);
	SetObjProperty(mobile, "#consecutiveCastBonus", bonus);

	return bonus;
endfunction

function performSpellDelay(mobile, mw, delay, byref orig_hp)
	while (delay > 0)
		if (!checkSpellInterruption(mobile, mw, orig_hp))
			return 0;
		endif

		var sleep_time := Min(delay, 50);
		SleepMS(sleep_time);
		delay -= sleep_time;
	endwhile

	return 1;
endfunction

function checkSpellInterruption(mobile, mw, byref orig_hp)
	if (GetCooldown(mobile, "silence") > 0)
		SendSysMessageEx(mobile, "Voce foi silenciado durante a invocacao.", SSM_FAIL);
		FailSpell(mobile);
		return 0;
	endif

	if (mobile.squelched && !mobile.npctemplate)
		SendSysMessageEx(mobile, "Voce nao consegue mais falar os componentes verbais da magia.", SSM_FAIL);
		FailSpell(mobile);
		return 0;
	endif

	if (GetObjProperty(mobile, "metamorfose") != error && !mw.HasAbility(ABILITY_ID::ELO_NATURAL))
		SendSysMessageEx(mobile, "A metamorfose interrompeu sua invocacao.", SSM_FAIL);
		FailSpell(mobile);
		return 0;
	endif

	var current_hp := AP_GetVital(mobile, "Hits");
	if (orig_hp > current_hp && !mw.HasAbility(ABILITY_ID::VINCULO_ELEMENTAL))
		var damage_taken := orig_hp - current_hp;
		var concentration_dif := RESIST_MEDIUM + Cint(damage_taken / 5);

		if (CheckResist(mobile, WILL, concentration_dif) > 0)
			// Concentration held — reset the damage baseline so only NEW damage can break it.
			orig_hp := current_hp;
			PrintTextAbove(mobile, "*concentrado*");
		else
			SendSysMessageEx(mobile, "Voce nao conseguiu se concentrar o suficiente para invocar esta magia.",
					   SSM_FAIL);
			FailSpell(mobile);
			if (mw.HasAbility(ABILITY_ID::SUPPORT_CASTER))
				HealMana(mobile, CInt(GetObjProperty(mobile, "#Casting").mana * 0.5));
			endif
			return 0;
		endif
	endif

	if (Events_Waiting())
		SendSysMessageEx(mobile, "Voce nao conseguiu se concentrar o suficiente para invocar esta magia.",
				   SSM_FAIL);
		FailSpell(mobile);
		if (!GetObjProperty(mobile, "#magiasilenciosa"))
			FailSpell(mobile);
		endif

		if (mw.HasAbility(ABILITY_ID::SUPPORT_CASTER))
			HealMana(mobile, CInt(GetObjProperty(mobile, "#Casting").mana * 0.5));
		endif
		return 0;
	endif

	return 1;
endfunction

function performCastingAnimation(mobile, range)
	case (range)
		"Distancia": PerformAction(mobile, HUMAN_ANIM::CAST_DIR); break;
		"Area":      PerformAction(mobile, HUMAN_ANIM::CAST_AREA); break;
		default:     PerformAction(mobile, HUMAN_ANIM::CAST_DIR);
	endcase
endfunction

function selectSpellTarget(mobile, spellinfo, targ)
	if (!targ)
		case (spellinfo.alvo)
			"Self": targ := mobile;
			"Unico":
				SendSysMessageEx(mobile, "Escolha o alvo da magia.", SSM_REQUEST);
				var noto := TGTOPT_NEUTRAL;
				if (spellinfo.align == "Harmful")
					noto := TGTOPT_HARMFUL;
				elseif (spellinfo.align == "HELPFUL")
					noto := TGTOPT_HELPFUL;
				endif
				targ := Target(mobile, noto);
			"Area":
				SendSysMessageEx(mobile, "Escolha o ponto onde a magia sera castada.", SSM_REQUEST);
				targ := TargetCoordinates(mobile);
		endcase

		if (!targ)
			SendSysMessageEx(mobile, "Voce cancelou a magia.", SSM_FAIL);
			FailSpell(mobile, spellinfo);
			return 0;
		endif

		if (!targ.opponent && spellinfo.alvo == "Unico" && targ.npctemplate)
			var event := {"type" := SYSEVENT_DAMAGED, "source" := mobile};
			SendEvent(mobile, event);
		endif

		if (spellinfo.alvo != "Self" && targ.serial != mobile.serial)
			TurnObjectToward(mobile, targ.x, targ.y);
		endif
	endif

	if (!checkTargetValidity(mobile, targ, spellinfo))
		return 0;
	endif

	return targ;
endfunction

function checkTargetValidity(mobile, targ, spellinfo)
	if (GetCooldown(targ, "repeal") > 0)
		EraseObjProperty(mobile, "#Casting");
		SendSysMessageEx(mobile, "O alvo esta invulneravel a magias.", SSM_FAIL);
		return 0;
	endif

	if (GetCooldown(targ, "corpofechado") > 0 && spellinfo.Type != "Divine" && spellinfo.Type != "Priest")
		SendSysMessageEx(mobile, "A magia nao funcionou no alvo, alem disso voce sente suas energias sendo esgotadas.",
				   SSM_FAIL);
		var vont := GetResist(targ, WILL);
		DamageMANA(mobile, vont / 3);
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	if (spellinfo.alvo != "Area")
		if (!CheckLineOfSight(mobile, targ))
			SendSysMessageEx(mobile, "Voce nao ve o alvo.", SSM_FAIL);
			FailSpell(mobile, spellinfo);
			return 0;
		endif
	else
		if (!CheckLOSAt(mobile, targ.x, targ.y, targ.z))
			SendSysMessageEx(mobile, "O ponto que voce selecionou esta fora da sua linha de visao.",
							  SSM_FAIL);
			FailSpell(mobile, spellinfo);
			return 0;
		endif
	endif

	if (Cint(GetObjProperty(mobile, "charmed_by")) == targ.serial)
		PrintTextAbove(mobile, "*hipnotizado*");
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	return 1;
endfunction

function checkCastingSuccess(mobile, mw, spellinfo, scroll)
	if (spellinfo.Type == "Ninjutsu")
		return 1;
	endif

	var attribute := MAGERY;
	if (mw.HasAbility(ABILITY_ID::SENSIBILIDADE_ARCANA) || mw.HasAbility(ABILITY_ID::VOX_ARCANA))
		attribute := ARCANA;
	elseif (spellinfo.Type == "Divine")
		attribute := THEOLOGY;
	endif

	var entropy := mw.GetEntropy();
	if (entropy <= -12000 && spellinfo.Type == "Divine")
		Message("Você está muito corrompido para lançar magias divinas.").SetColor(SSM_FAIL).SendSys(mobile);
		EraseObjProperty(mobile, "#Casting");
		return 0;
	endif

	var difficulty := CInt(spellinfo.Difficulty);

	// Caminho: School Specialization (-10 difficulty)
	var schoolSpecId := _GetSchoolSpecForSpell(spellinfo);
	if (schoolSpecId && mw.HasAbility(schoolSpecId))
		difficulty := difficulty - 10;
	endif

	// Sacred wood focus (Teixo staff) reduces casting difficulty.
	difficulty := difficulty - GetMagicItemSacredWoodBonus(mobile);

	var skill_check := SkillCheck(mobile, attribute, difficulty);

	// Chance to also up magic lore on cast

	var magic_lore_check := SkillCheck(mobile, getSupportingSkill(mobile, mw), difficulty);
	if (skill_check > 0)
		if (scroll.isA(POLCLASS_ITEM))
			consumeScroll(mobile, mw, scroll);
		endif

		return 1;
	endif

	CancelTarget(mobile);
	handleFailedSpell(mobile, mw, spellinfo);

	return 0;
endfunction

function getSupportingSkill(mobile, mw)
	var chardata := getobjProperty(mobile, "chardata");
	var attribute := ARCANA;
	// "Mago" wisdom_path (legacy) and "spellcaster" magia (path-rework Magus/
	// Necromante/Lamina_Arcana) both keep Arcana as the supporting skill.
	// Everyone else falls back to Theology unless they have SENSIBILIDADE_ARCANA.
	if (chardata != error
		&& chardata.wisdom_path != "Mago"
		&& chardata.magia != "spellcaster"
		&& !(mw.HasAbility(ABILITY_ID::SENSIBILIDADE_ARCANA)))
		attribute := THEOLOGY;
	endif
	return attribute;
endfunction

function finalizeCasting(mobile, spellinfo, targ, scroll)
	CastSpell(mobile, spellinfo, targ);

	if (spellinfo.Type != "Divine" && spellinfo.Type != "Priest" && spellinfo.Circle[1] != "0")
		NotifyCitizenWitnesses(mobile, "cast", struct{ "school" := spellinfo.School });
		if (InValtheris(mobile) && HasPraetors())
			Start_Script(":faccao:praetorAlert", array{ mobile, spellinfo.School });
		endif
	endif

	var entropy_delta := 0;
	var circle_amt := Cint(spellinfo.Circle[1]);
	if (spellinfo.School == "Kaijin")
		entropy_delta := -circle_amt;
	elseif (spellinfo.Type == "Divine")
		entropy_delta := circle_amt;
	endif

	if (entropy_delta != 0)
		UpdateMobileEntropy(mobile, entropy_delta);
	endif

	EraseObjProperty(mobile, "#Casting");
	EraseObjProperty(mobile, "#CustoDeterminacaoArcana");
	return 1;
endfunction

function consumeScroll(mobile, mw, scroll)
	if (!mw.HasAbility(ABILITY_ID::REAPROVEITAR_PERGAMINHO))
		SubtractAmount(scroll, 1);
	else
		var attrib_value := MAGERY;
		if (mw.HasAbility(ABILITY_ID::SENSIBILIDADE_ARCANA))
			attrib_value := ARCANA;
		endif
		var chance := RandomIntMinMax(0, 100);
		if (chance > attrib_value)
			SubtractAmount(scroll, 1);
		endif
	endif
endfunction

function handleFailedSpell(mobile, mw, spellinfo)
	if (mw.HasAbility(ABILITY_ID::SUPPORT_CASTER))
		HealMana(mobile, CInt(spellinfo.mana * 0.5));
	endif

	if (!GetObjProperty(mobile, "#magiasilenciosa"))
		FailSpell(mobile);
	else
		// Silent casting skips the fizzle FX in FailSpell, but we still must
		// release the casting lock or the caster gets stuck until relog.
		mobile.frozen := 0;
		EraseObjProperty(mobile, "#medding");
		EraseObjProperty(mobile, "#Casting");
	endif

	SendSysMessageEx(mobile, "Voce falhou em invocar a magia.", SSM_FAIL);
endfunction

function _GetSchoolSpecForSpell(spellinfo)
	var school := spellinfo.School;
	case (school)
		"Evocatium":     return ABILITY_ID::SCHOOL_SPEC_EVOCATIUM;
		"Velkyn":        return ABILITY_ID::SCHOOL_SPEC_VELKYN;
		"Ahtaleloreth":  return ABILITY_ID::SCHOOL_SPEC_AHTALELORETH;
		"Kaijin":        return ABILITY_ID::SCHOOL_SPEC_KAIJIN;
		default:         return 0;
	endcase
endfunction
