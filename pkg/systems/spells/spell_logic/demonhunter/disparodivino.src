use uo;
use os;
use cfgfile;

include ":attributes:attributes";
include "include/client";
include "include/sounds";
include ":spells:Controller/SC_Damage";
include "include/epicConstants";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";
include ":charactercreation:resists";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spellinfo := params[3];
	params := 0;

	if (!targ.IsA(POLCLASS_MOBILE))
		SendSysMessage(who, "Alvo invalido.");
		return 0;
	endif

	var theology := AP_GetSkill(who, THEOLOGY);
	var damage := RandomDiceRoll("2d6") + CInt(theology / 10);

	var demon_hit := IsDemon(targ);
	if (demon_hit)
		damage := damage + RandomDiceRoll("1d10") + CInt(theology / 6);
	endif

	PlayMovingEffectEx(who, targ, 0x5426, 13, 20, 0x0845, 2);
	PlaySoundEffect(who, 0x235);

	// REFLEX save halves the damage (the hitchance debuff still applies —
	// dodging the projectile, not the divine mark).
	var diff := handleSpellResistDiffForSpecialists(who, spellinfo.School);
	var bonus := epicWisdomPathBonus(who);
	if (CheckResist(targ, REFLEXES, diff, -bonus))
		damage := Cint(damage / 2);
		SendSysMessageEx(targ, "Voce desvia parcialmente da flecha divina.", SSM_INFO);
	endif

	SC_DealDamage(who, targ, CInt(spellinfo.id), damage, DAMAGE_TYPE::FORCED);

	SC_RemoveEffect(targ, CInt(spellinfo.id));

	var duration := CInt(theology / 2);

	var opts := struct{};
	opts.+color := 2516;
	opts.+hitchance_mod := -15;
	opts.+desc := "Disparo Divino";

	SC_ApplyEffect(who, targ, opts, duration, CInt(spellinfo.id));

	if (demon_hit)
		SendSysMessageEx(who, "A flecha divina queima a carne profana!", SSM_INFO);
	else
		SendSysMessageEx(who, "Uma flecha divina atinge o alvo!", SSM_INFO);
	endif

	return 1;
endprogram

function IsDemon(mobile)
	if (!mobile.npctemplate)
		return 0;
	endif

	var npctemplate := NPC_ParseTemplateName(mobile.npctemplate);
	var cfg := ReadConfigFile(":*:npcdesc");

	if (cfg[npctemplate.template].Environment == "Demons")
		return 1;
	endif

	return 0;
endfunction
