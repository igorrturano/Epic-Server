use uo;
use os;
use vitals;
use cfgfile;

include ":attributes:attributes";
include ":spells:Controller/SpellController";

program SpellScript_AprisionarDemonio(params)
	var caster := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessage(caster, "Voce precisa selecionar uma criatura!");
		return 0;
	endif

	if (!IsDemon(targ))
		SendSysMessage(caster, "Esta magia so funciona em demonios!");
		return 0;
	endif

	PlaySoundEffect(targ, 0x202);
	PlayStationaryEffectEx(targ.x, targ.y, targ.z, targ.realm, FX_MAZE, 10, 10);

	var duration := 5 + CInt(AP_GetSkill(caster, THEOLOGY) / 10);

	SC_RemoveEffect(targ, CInt(spell.id));

	var opts := struct{};
	opts.+frozen := 1;
	opts.+desc := "Aprisionar Demonio";

	SC_ApplyEffect(caster, targ, opts, duration, CInt(spell.id));

	var effects := array{ { targ.x - 1, targ.y - 1 },
					  	{ targ.x, targ.y - 1 },
					  	{ targ.x + 1, targ.y - 1 },
					  	{ targ.x - 1, targ.y },
					  	{ targ.x + 1, targ.y },
					  	{ targ.x - 1, targ.y + 1 },
					  	{ targ.x, targ.y + 1 },
					  	{ targ.x + 1, targ.y + 1 } };

	foreach position in effects
		PlayStationaryEffect(position[1], position[2], targ.z, 0x375A, 10, duration * 1000);
	endforeach

	return 1;
endprogram

function IsDemon(mobile)
	if (!mobile.npctemplate)
		return 0;
	endif

	var npctemplate := NPC_ParseTemplateName(mobile.npctemplate);
	var cfg := ReadConfigFile(":*:npcdesc");

	if (cfg[npctemplate.template].Category == "Demons")
		return 1;
	endif

	return 0;
endfunction
