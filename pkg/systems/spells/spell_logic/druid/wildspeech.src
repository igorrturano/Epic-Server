use uo;
use os;
include "include/say";
include ":attributes:attributes";
include ":timedScripts:timedScripts";

program SpellScript(params)
	var who := params[1];

	// Validate player is NOT already in metamorfose
	if (GetObjProperty(who, "metamorfose") != error)
		SendSysMessageEx(who, "Você deve conjurar antes de se transformar.", SSM_FAIL);
		return 0;
	endif

	// Check if effect is already active
	var wildspeech_duration := TS_GetTimerDuration(who, "wildspeech");
	if (wildspeech_duration != error && wildspeech_duration > 0)
		SendSysMessageEx(who, "Você já está sob o dom da fala selvagem.", SSM_FAIL);
		return 0;
	endif

	var duration_minutes := CInt(AP_GetSkill(who, THEOLOGY));
	if (duration_minutes < 1)
		duration_minutes := 1;
	endif

	TS_StartTimer(who, "wildspeech", duration_minutes * 60);
	SendSysMessageEx(who, $"Sua fala selvagem foi despertada por {duration_minutes} minutos.", SSM_INFO);
	
	return 1;
endprogram
