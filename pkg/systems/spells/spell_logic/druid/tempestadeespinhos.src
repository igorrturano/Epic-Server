use uo;
use os;
use util;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":combat:Controller/DamageController_legacy";

program cast_thornstorm(params)
	var caster := params[1];
	var info := params[2];
	params := 0; // No longer needed

	LaunchProjectile(caster, info);
endprogram

function LaunchProjectile(caster, info)
	// Efeito sonoro de tempestade/natureza
	PlaySoundEffect(caster, 0x231); // Som de galhos/vento

	// Efeito visual de espinhos girando
	// PlayMovingEffect(caster, info, 0x5433, 10, 1, 0); // Projétil verde
	PlayObjectCenteredEffect(info, 0xCADD, 10, 15); // Explosão de espinhos no alvo

	// Som de impacto
	sleepms(500);
	PlaySoundEffect(info, 0x22F);

	// Dano baseado em THEOLOGY + dado
	var dmg := cint(AP_GetSkill(caster, THEOLOGY)/10) + RandomDiceRoll("1d4");

	// Dano físico (espinhos são perfurantes/cortantes)
	DamageFLS(info, cint(dmg), DMG_PHYSICAL, caster);
endfunction
