use uo;
use os;
use util;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include "include/facings";
include ":charactercreation:habilidades";
include ":spells:Controller/SpellController";

const SOUND_EFFECT_FIRE := 0x1de;
const UOBJ_FIREFIELD_NS := 0x398c;
const UOBJ_FIREFIELD_EW := 0x3996;
const EFFECT_FIRE := 0x3709;

program SpellScript(params)
	var caster := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	var theology := AP_GetSkill(caster, THEOLOGY);
	var range := CInt(theology / 20) + 2;
	var duration := CInt(theology / 10);

	if (duration < 4)
		duration := 4;
	endif

	TurnObjectToward(caster, targ.x, targ.y);
	sleepms(300);

	SendSysMessageEx(caster, "Uma pira purificadora emerge de sua vontade!", SSM_INFO);
	PrintTextAbove(caster, "*Chamas sagradas brotam*");

	PlaySoundEffect(caster, SOUND_EFFECT_FIRE);
	PlaySoundEffect(caster, 0x208);

	var facing := caster.facing;
	var start_x := caster.x;
	var start_y := caster.y;
	var fire_serials := array{};

	for line := 1 to range
		for i := -line to line
			var pos_x, pos_y;

			case (facing)
				0: pos_x := start_x + i;    pos_y := start_y - line;
				1: pos_x := start_x + line; pos_y := start_y - line + i;
				2: pos_x := start_x + line; pos_y := start_y + i;
				3: pos_x := start_x + line; pos_y := start_y + line - i;
				4: pos_x := start_x + i;    pos_y := start_y + line;
				5: pos_x := start_x - line; pos_y := start_y + line - i;
				6: pos_x := start_x - line; pos_y := start_y + i;
				7: pos_x := start_x - line; pos_y := start_y - line + i;
			endcase

			if (pos_x == start_x && pos_y == start_y)
				continue;
			endif

			var z := GetWorldHeight(pos_x, pos_y, caster.realm);

			var fire_type := UOBJ_FIREFIELD_NS;
			if (facing == 2 || facing == 6)
				fire_type := UOBJ_FIREFIELD_EW;
			endif

			var fire := CreateItemAtLocation(pos_x, pos_y, z, fire_type, 1, caster.realm);

			if (fire)
				// Grace duration past the buff lifetime so pirapurificadoraExpire
				// normally wins the destroy race; if it fails to run, the field
				// still self-cleans instead of becoming a permanent world item.
				fire.SetDuration(duration + 5);
				fire_serials.append(fire.serial);
				SetObjProperty(fire, "summoner", caster.serial);
				PlayStationaryEffect(pos_x, pos_y, z, EFFECT_FIRE, 7, 10, 0, caster.realm);
			endif

			sleepms(5);
		endfor

		PlaySoundEffect(caster, SOUND_EFFECT_FIRE);
	endfor

	// SC timer runs on the caster (icon + duration). Tick fires area damage.
	// on_expire tears down the fire items — also fires if dispelled.
	var tick_interval := 2;

	var opts := struct{};
	opts.+buff_category := "pira_purificadora";
	opts.+displayname := "Pira Purificadora";
	opts.+desc := "Chamas queimam em area";
	opts.+tick_script := ":spells:spell_logic/druid/pirapurificadoraTick";
	opts.+tick_interval := tick_interval;
	opts.+tick_params := struct{
		fire_serials := fire_serials,
		theology := CInt(theology)
	};
	opts.+on_expire_script := ":spells:spell_logic/druid/pirapurificadoraExpire";
	opts.+on_expire_params := struct{
		fire_serials := fire_serials
	};

	SC_ApplyEffect(caster, caster, opts, duration, CInt(spell.id));

	return 1;
endprogram
