use uo;
use os;
use vitals;

include "include/client";
include "include/say";
include "include/tileEffects";
include ":combat:Controller/DamageController_legacy";

// Per-tick heal for druid Cura Leve HoT. Driven by SC tick-callback.
// Args: { caster, targ, spellId, tick_number, tick_params }
// tick_params: struct{ base_tick, remainder, total_ticks }
program DruidHealTick(args)
	var caster := args[1];
	var targ := args[2];
	var tick_number := CInt(args[4]);
	var tp := args[5];
	args := 0;

	if (!targ || targ is @Exception || targ.dead)
		return;
	endif

	var heal := CInt(tp.base_tick);
	if (tick_number <= CInt(tp.remainder))
		heal += 1;
	endif

	var hp_before := GetVital(targ, HITS);
	applyEpicHealing(targ, heal);
	var hp_after := GetVital(targ, HITS);
	var real_heal := hp_after - hp_before;

	PlayStationaryEffect(targ.x, targ.y, targ.z, FX_YELLOW_SPARKLE, 2, 2);

	if (caster && caster.connected)
		SendSysMessageEx(caster, $"Druid Heal: +{real_heal} HP ({tick_number}/{CInt(tp.total_ticks)})", SSM_INFO);
	endif
endprogram
