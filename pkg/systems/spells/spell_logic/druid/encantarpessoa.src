include "include/say";
include ":attributes:attributes";
include "include/epicMageryUtils";
include "include/epicNPCUtils";
include ":charactercreation:resists";
include ":tn:boss";
include "include/sysEvent";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;

	params := 0; // No longer needed

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Voce so pode encantar criaturas vivas.", SSM_FAIL);
		return;
	endif

	if (targ == who)
		SendSysMessageEx(who, "Voce nao pode encantar a si mesmo.", SSM_FAIL);
		return;
	endif

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);

	if (CheckResist(targ, VONTADE, diff, -bonus) || isTrueBoss(targ))
		SendSysMessageEx(who, "Você nota que o alvo não foi afetado.", SSM_FAIL);
		SendSysMessageEx(targ, "Você resistiu a magia.", SSM_INFO);
		return;
	endif

	var duration := cint(AP_GetSkill(who, ARCANA) / 5);
	if (TemHabilidade(who, "Treinamento Druídico"))
		duration := Cint(duration * 1.5);
	endif

	handleSilentMagic(who, targ, SFX_SPELL_TELEKINESIS);
	PlayObjectCenteredEffect(targ, EPIC_FX_HIPNOSYS, 10, 10);

	SetObjProperty(targ, "charmed_by", who.serial);
	SetObjProperty(targ, "charmed_cannot_attack", who.serial); // Cannot attack the druid
	SetCooldown(targ, "charmed", duration);

	SendSysMessageEx(targ, "Você foi encantado por " + who.name + " e não consegue atacá-lo.", SSM_INFO);
	SendSysMessageEx(who, "Você encantou " + targ.name + ".", SSM_INFO);

	sleep(duration);
	EraseObjProperty(targ, "charmed_by");
	EraseObjProperty(targ, "charmed_cannot_attack");

	SendSysMessageEx(targ, "O encantamento se desfez.", SSM_INFO);

	return 1;
endprogram