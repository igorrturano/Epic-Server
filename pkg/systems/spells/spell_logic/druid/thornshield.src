use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:regen";
include ":attributes:vitals";
include ":attributes:attributes";
include ":timedScripts:timedScripts";
include ":charactercreation:habilidades";

program SpellScript(params)
	var who := params[1];

	// NPCs podem usar a magia
	if (who.npctemplate)
		var time := cint(AP_GetSkill(who, THEOLOGY)) * 2;
		var lvl := cdbl(AP_GetSkill(who, THEOLOGY) * 0.6 / 100);

		TS_StartTimer(who, "dmgreturn", time, lvl, who, 1);
		return 1;
	endif

	// Calcula a potência baseada em THEOLOGY
	var lvl := cdbl(AP_GetSkill(who, THEOLOGY) * 0.6 / 100);

	// Duração baseada em THEOLOGY
	var time := cint(AP_GetSkill(who, THEOLOGY)) * 2;

	// Efeitos visuais e sonoros de espinhos/natureza
	PlayObjectCenteredEffect(who, 0x373A, 10, 15); // Efeito de espinhos
	PlaySoundEffect(who, 0x231); // Som de galhos/natureza

	SendSysMessageEx(who, "Espinhos brotam de sua pele como armadura!", SSM_INFO);
	PrintTextAbove(who, "*Coberto por espinhos*");

	return 1;
endprogram
