use uo;
use os;
use vitals;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include "include/tileEffects";
include ":charactercreation:habilidades";
include ":combat:Controller/DamageController_legacy";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];

	if (who.npctemplate)
		targ := who;
	endif
	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	if (GetVital(targ, HITS) == GetVitalMaximumValue(targ, HITS))
		SendSysMessageEx(who, "O alvo nao parece ferido.", SSM_FAIL);
		return;
	endif

	var healed := cint(AP_GetSkill(who, THEOLOGY) / 2);
	if (healed < 20)
		healed := 20;
	endif

	// Split healing: half instant, half over time
	var instant_heal := cint(healed / 2);
	var hot_total := healed - instant_heal;
	var hot_ticks := 5; // 5 ticks over time
	var hot_per_tick := cint(hot_total / hot_ticks);

	// Apply instant heal
	SendSysMessageEx(targ, "Voce sente seus ferimentos se curarem magicamente.", SSM_INFO);
	var hp_before := GetVital(targ, HITS);
	applyEpicHealing(targ, instant_heal);
	var hp_after := GetVital(targ, HITS);
	var instant_real_heal := hp_after - hp_before;
	ShowHealFeedback(who, targ, instant_real_heal, 0, 0, 0);

	PlayStationaryEffect(targ.x, targ.y, targ.z, FX_SPARK_EFFECT, 2, 2);
	PlaySoundEffect(targ, SFX_SPELL_HEAL);

	// Apply heal over time
	var hot_params := struct{
		"caster" := who,
		"target" := targ,
		"heal_amount" := hot_per_tick,
		"remaining_ticks" := hot_ticks,
		"total_ticks" := hot_ticks
	};

	HealOverTime(hot_params);

	return 1;
endprogram

function HealOverTime(params)
	var caster := params.caster;
	var targ := params.target;
	var heal_amount := params.heal_amount;
	var remaining_ticks := params.remaining_ticks;
	var total_ticks := params.total_ticks;
	var current_tick := 1;

	if (!targ || !targ.connected)
		return;
	endif

	// Apply heal over time every 5 seconds
	while (remaining_ticks > 0)
		sleep(5);

		// Check if target is still valid
		if (!targ || targ.dead || !targ.connected)
			return;
		endif

		// Apply the heal tick
		var hp_before := GetVital(targ, HITS);
		applyEpicHealing(targ, heal_amount);
		var hp_after := GetVital(targ, HITS);
		var tick_real_heal := hp_after - hp_before;
		ShowHealFeedback(caster, targ, tick_real_heal, 1, current_tick, total_ticks);

		// Visual and sound feedback
		PlayStationaryEffect(targ.x, targ.y, targ.z, FX_SPARK_EFFECT, 2, 2);

		current_tick := current_tick + 1;
		remaining_ticks := remaining_ticks - 1;
	endwhile

	return 1;
endfunction

function ShowHealFeedback(caster, targ, amount, is_hot, tick, total_ticks)
	if (amount < 0)
		amount := 0;
	endif

	if (amount > 0)
		PrintTextAbove(targ, $"+{amount}");
	endif

	if (!caster || !caster.connected)
		return;
	endif

	if (is_hot)
		SendSysMessageEx(caster, $"Druid Heal: +{amount} HP ({tick}/{total_ticks})", SSM_INFO);
	else
		SendSysMessageEx(caster, $"Druid Heal: +{amount} HP (instantaneo)", SSM_INFO);
	endif
endfunction
