use uo;
use os;

include "include/client";
include "include/say";
include "include/sounds";
include "include/tileEffects";
include ":spells:Controller/SC_Damage";

// Per-tick damage for druid Enxame DoT. Driven by SC tick-callback.
// Args: { caster, targ, spellId, tick_number, tick_params }
// tick_params: struct{ damage_per_tick, total_ticks }
program EnxameTick(args)
	var caster := args[1];
	var targ := args[2];
	var spellId := CInt(args[3]);
	var tick_number := CInt(args[4]);
	var tp := args[5];
	args := 0;

	if (!targ || targ is @Exception || targ.dead)
		return;
	endif

	var dmg_caster := caster;
	if (!dmg_caster || dmg_caster is @Exception || dmg_caster.dead)
		// Swarm persists if caster dies; attribute the damage to the target so the call doesn't crash.
		dmg_caster := targ;
	endif

	SC_DealDamage(dmg_caster, targ, spellId, CInt(tp.damage_per_tick), DMG_PHYSICAL);

	PlayObjectCenteredEffect(targ, FX_SWARM_3_MAGIC, 70, 50);
	PlaySoundEffect(targ, 0x5CD);

	if (tick_number % 3 == 0)
		SendSysMessageEx(targ, "Os insetos continuam a te morder!", SSM_FAIL);
	endif

	if (tick_number >= CInt(tp.total_ticks))
		PrintTextAbove(targ, "*Os insetos se dispersam*");
		SendSysMessageEx(targ, "O enxame finalmente se dispersa.", SSM_INFO);
	endif
endprogram
