// Partially bypasses SpellController: the trailing `bleed` timer is a
// damage-ticking poison-typed cfg script (Type=P, AllOrNothingCure) that
// belongs to the poison subsystem, not to SC's caster-buff model. The rest
// of this spell is already SC-native.
use uo;
use os;

include "include/epicCombatUtils";
include ":attributes:attributes";
include "include/client";
include "include/sounds";
include "include/say";
include ":taming:taming";
include "include/epicMageryUtils";
include ":timedScripts:timedScripts";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0;

	var duration := CInt(AP_GetSkill(who, THEOLOGY) / 10);
	var range := CInt(AP_GetSkill(who, THEOLOGY) / 5);

	var allMobiles := listAllMobilesNearbyButPetsAndParty(who, range);

	PerformAction(who, HUMAN_ANIM::CAST_AREA);
	foreach mobile in allMobiles
		PlayStationaryEffect(mobile.x, mobile.y, mobile.z, 0x38C8, 10, 100, 0, mobile.realm);
		SendSysMessageEx(mobile, "As vinhas enraizam voce", SSM_FAIL);

		SC_RemoveEffect(mobile, CInt(spell.id));

		var opts := struct{};
		opts.+frozen := 1;
		opts.+buff_category := "movement_root";
		opts.+displayname := "Crescimento Selvagem";
		opts.+desc := "Enraizado por vinhas";

		SC_ApplyEffect(who, mobile, opts, duration, CInt(spell.id));
		sleepms(20);
	endforeach

	// Bleed after vines release — keep as TS (active damage loop, already has PersistOnLogoff)
	sleep(duration);
	foreach mobile in allMobiles
		SendSysMessageEx(mobile, "As vinhas rasgam sua pele ao te soltar");
		TS_StartTimer(mobile, "bleed", CInt(AP_GetSkill(who, THEOLOGY) / 4));
		sleepms(20);
	endforeach

	return 1;
endprogram
