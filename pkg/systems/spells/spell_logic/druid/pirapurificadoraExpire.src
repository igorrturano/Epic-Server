use uo;
use os;

include "system/exception/Exception";

// Fires when Pira Purificadora expires or is dispelled. Destroys the
// fire-field items spawned at cast time.
// Args: { _unused, targ (caster), spellId, on_expire_params }
// on_expire_params: struct{ fire_serials }
program PirapurificadoraExpire(args)
	var ep := args[4];
	args := 0;

	if (!ep || !ep.fire_serials)
		return;
	endif

	foreach ser in (ep.fire_serials)
		var fire := SystemFindObjectBySerial(CInt(ser));
		if (fire && !(fire is @Exception))
			DestroyItem(fire);
		endif
	endforeach
endprogram
