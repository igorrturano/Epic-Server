use uo;
use os;

include ":combat:damage";
include "include/client";
include "include/sounds";

program SwarmDamageOverTime(params)
	var targ := params.target;
	var caster := params.caster;
	var damage_per_tick := params.damage_per_tick;
	var remaining_ticks := params.remaining_ticks;
	var theology := params.theology;

	if (!targ)
		return;
	endif

	// Marca o alvo como tendo enxame ativo (previne stack)
	if (GetObjProperty(targ, "#swarm_active"))
		SendSysMessageEx(caster, "O alvo já está sendo atacado por um enxame!", SSM_FAIL);
		return;
	endif

	SetObjProperty(targ, "#swarm_active", 1);

	// Array de efeitos visuais de insetos variados
	var insect_effects := array{
		0x91B,  // Nuvem/enxame
		0x3728, // Poison field (visual de nuvem)
		0x374A  // Outro efeito de partículas
	};

	// Array de sons de insetos
	var insect_sounds := array{
		0x1E1,  // Zumbido
		0x1E0,  // Insetos
		0x1E2   // Variação de zumbido
	};

	var tick_count := 0;

	// Aplica dano ao longo do tempo
	while (remaining_ticks > 0)
		sleep(2);

		// Verifica se o alvo ainda é válido
		if (!targ || targ.dead)
			EraseObjProperty(targ, "#swarm_active");
			return;
		endif

		// Verifica se o caster ainda está vivo (se morrer, enxame continua)
		if (!caster || caster.dead)
			// Enxame continua mesmo se o caster morrer
			caster := targ; // Troca referência para evitar erros
		endif

		tick_count := tick_count + 1;

		// Aplica dano
		var actual_damage := damage_per_tick + RandomInt(3) - 1; // Variação de ±1
		DamageFLS(targ, actual_damage, DMG_PHYSICAL, caster);

		// Efeitos visuais variados de insetos
		var effect_idx := (tick_count % insect_effects.size()) + 1;
		var sound_idx := (tick_count % insect_sounds.size()) + 1;

		PlayObjectCenteredEffect(targ, insect_effects[effect_idx], 7, 10);
		PlaySoundEffect(targ, insect_sounds[sound_idx]);

		// Mensagens periódicas
		if (tick_count % 3 == 0)
			SendSysMessageEx(targ, "Os insetos continuam a te morder!", SSM_FAIL);
		endif

		// A cada 5 ticks (10 segundos), mostra texto acima
		if (tick_count % 5 == 0)
			PrintTextAbove(targ, "*Zzzzzz*");
		endif

		remaining_ticks := remaining_ticks - 1;
	endwhile

	// Remove a marca de enxame ativo
	EraseObjProperty(targ, "#swarm_active");

	// Efeito final - enxame se dispersa
	PlayObjectCenteredEffect(targ, 0x3728, 10, 20);
	PlaySoundEffect(targ, 0x1E0);
	SendSysMessageEx(targ, "O enxame finalmente se dispersa.", SSM_INFO);
	PrintTextAbove(targ, "*Os insetos se dispersam*");

	return 1;
endprogram
