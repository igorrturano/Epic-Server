use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include ":charactercreation:habilidades";
include ":spells:Controller/SpellController";
include ":wrappers:Objects/Model/MobileWrapper";

program SpellScript(params)
	var caster := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(caster, "Isto não pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Block recast while swarm is still active on the target.
	var existing := MobileWrapper(targ).GetProperty($"SpellOpts_{CInt(spell.id)}");
	if (existing && !existing.errortext)
		SendSysMessageEx(caster, "O alvo já está sendo atacado por um enxame!", SSM_FAIL);
		return;
	endif

	var theology := AP_GetSkill(caster, THEOLOGY);

	var total_ticks := CInt(theology / 10);
	if (total_ticks < 4)
		total_ticks := 4;
	elseif (total_ticks > 10)
		total_ticks := 10;
	endif

	var damage_per_tick := CInt(theology / 20) + RandomDiceRoll("1d4");
	var tick_interval := 2;
	var duration := total_ticks * tick_interval;

	SendSysMessageEx(caster, "Um enxame de insetos ataca " + targ.name + "!", SSM_INFO);
	SendSysMessageEx(targ, "Você está sendo atacado por um enxame de insetos!", SSM_FAIL);
	PrintTextAbove(targ, "*Coberto por insetos*");
	PlayMovingEffect(caster, targ, 0x91B, 20);

	var opts := struct{};
	opts.+buff_category := "insect_swarm";
	opts.+displayname := "Enxame";
	opts.+desc := $"{damage_per_tick} dano / tick";
	opts.+tick_script := ":spells:spell_logic/druid/enxameTick";
	opts.+tick_interval := tick_interval;
	opts.+tick_params := struct{
		damage_per_tick := damage_per_tick,
		total_ticks := total_ticks
	};

	SC_ApplyEffect(caster, targ, opts, duration, CInt(spell.id));

	return 1;
endprogram
