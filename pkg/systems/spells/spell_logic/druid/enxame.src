use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include ":charactercreation:habilidades";

program SpellScript(params)
	var caster := params[1];

	var targ := Target(caster);
	if (caster.npctemplate)
		targ := caster;
	endif

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(caster, "Isto não pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Calcula parâmetros baseados em THEOLOGY
	var theology := AP_GetSkill(caster, THEOLOGY);

	// Duração: theology/5 segundos (ticks a cada 2 segundos)
	var duration_seconds := CInt(theology / 5);
	if (duration_seconds < 10)
		duration_seconds := 10;
	elseif (duration_seconds > 30)
		duration_seconds := 30;
	endif

	var total_ticks := CInt(duration_seconds / 2);

	// Dano por tick baseado em THEOLOGY
	var damage_per_tick := CInt(theology / 10) + RandomDiceRoll("1d6");

	// Efeito visual inicial - enxame de insetos
	PlayObjectCenteredEffect(targ, 0x91B, 10, 20); // Efeito de nuvem/enxame
	PlaySoundEffect(targ, 0x1E1); // Som de insetos/zumbido

	SendSysMessageEx(caster, "Um enxame de insetos ataca " + targ.name + "!", SSM_INFO);
	SendSysMessageEx(targ, "Você está sendo atacado por um enxame de insetos!", SSM_FAIL);
	PrintTextAbove(targ, "*Coberto por insetos*");

	// Inicia o script de damage over time
	var dot_params := struct{
		"target" := targ,
		"caster" := caster,
		"damage_per_tick" := damage_per_tick,
		"remaining_ticks" := total_ticks,
		"theology" := theology
	};

	start_script(":spells:spell_logic/druid/enxame_dot", dot_params);

	return 1;
endprogram
