
use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":tn:cooldown";
include ":message:model/Message";
include "include/epicMageryUtils";

program SpellScript(params)
	var who := params[1];
	var info := params[2];

	var targ := who.weapon;

	if (!targ || targ.objtype == FIST)
		targ := SummonSpiritualBlade(who);
		if (!targ)
			return 0;
		endif
	elseif (WeaponWrapper(targ).Category != WEAPON_CATEGORY::SPIRITUALBLADE)
		Message("Voce nao pode encantar uma arma nao espiritual!", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return 0;
	endif

	var time := AP_GetSkill(who, ARCANA) * 10 + 180;

	if (targ.isA(POLCLASS_WEAPON))

		if (checkForElementalWeapons(who, targ))
			return 0;
		endif
		ApplyElementalWeaponProperties(who, "Cold");
		PlaySoundEffect(targ, SFX_BLESS);
		Message("Uma fina camada de gelo cobre a arma.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

		return 1;
	endif

	Message("Alvo invalido.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

endprogram