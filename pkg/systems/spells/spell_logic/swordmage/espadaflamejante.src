
use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":tn:cooldown";
include ":message:model/Message";
include "include/epicMageryUtils";

program SpellScript(params)
	var who := params[1];
	var info := params[2];

	var targ := who.weapon;
	var summoned := 0;

	// No weapon equipped (fist) — summon spiritual blade from pool
	if (!targ || targ.objtype == FIST)
		targ := SummonSpiritualBlade(who);
		if (!targ)
			return 0;
		endif
		summoned := 1;
	endif

	var time := AP_GetSkill(who, ARCANA) * 10 + 180;

	if (targ.isA(POLCLASS_WEAPON))

		if (checkForElementalWeapons(who, targ))
			return 0;
		endif
		ApplyElementalWeaponProperties(who, "Fire");
		PlaySoundEffect(targ, SFX_BLESS);
		Message("Sua arma ficou coberta de chamas.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

		return 1;
	endif

	Message("Alvo invalido.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

endprogram