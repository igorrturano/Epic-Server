use uo;

include "include/say";
include ":tn:cooldown";
include ":spells:tnmagery";
include "include/encantarObjeto";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program SpellScript(params)
	var who := MobileWrapper(params[1]);
	var use_on := params[2];
	params := 0; // No longer needed

	Message("Qual item deseja encantar?", Color(SYSTEM_COLOR::INFO)).SendSys(who.GetObjRef());

	if (!use_on)
		return;
	endif

	if (use_on.amount > 10 && IsAmmunition(use_on))
		Message("Você não pode encantar pilhas de munição com mais de 10 unidades.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return;
	endif

	// Bonus
	var bonus := CInt(who.GetSkill(ARCANA));

	if (who.HasAbility(ABILITY_ID::DOMINIO_VITAL))
		bonus := CInt(bonus * 0.07); // TODO: Rever se esse valor vai ser coerente com a hab. Max = 7
	else
		bonus := CInt(bonus * 0.05); // Max = 5
	endif

	setBonus(who, use_on, bonus);

	return 1;
endprogram
