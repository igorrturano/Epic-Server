
use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":tn:cooldown";
include ":message:model/Message";
include "include/epicMageryUtils";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	// SendSysMessageEx(who, "Escolha sua arma.", SSM_REQUEST);
	var targ := who.weapon;
	if (!targ)
		Message("Cancelado", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return;
	endif

	var time := GetSpellDuration(AP_GetSkill(who, ARCANA));

	if (targ.isA(POLCLASS_WEAPON))

		var elemental := GetObjProperty(targ, "#elementalweapon");
		if (elemental.type != "Fire")
			Message("Esta arma precisa estar encantada com Lamina Flamejante.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
			return 1;
		endif

		if (checkForElementalWeapons(who, targ))
			return 0;
		endif

		var duration := Cint(AP_GetSkill(who, ARCANA)) / 2 + 10;
		SetCooldown(targ, "circulodevas", duration);

		PlaySoundEffect(targ, SFX_BLESS);
		Message("Os espiritos do fogo estao inquietos na sua arma.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

		return 1;
	endif

	Message("Alvo invalido.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

endprogram
