use uo;
use os;
use util;

include "include/client";
include "include/say";
include "include/sounds";
include "include/tileEffects";
include ":spells:Controller/SC_Damage";

// Per-tick damage for mage Incinerar DoT. Driven by SC tick-callback.
// Each tick rolls 1d4+1 fixed (matches the Magic Missile chip pattern).
// tick_params: struct{ total_ticks }
program IncinerarTick(args)
	var caster := args[1];
	var targ := args[2];
	var spellId := CInt(args[3]);
	var tick_number := CInt(args[4]);
	var tp := args[5];
	args := 0;

	if (!targ || targ is @Exception || targ.dead)
		return;
	endif

	var dmg_caster := caster;
	if (!dmg_caster || dmg_caster is @Exception || dmg_caster.dead)
		dmg_caster := targ;
	endif

	var chip := RandomDiceRoll("1d4") + 1;
	SC_DealDamage(dmg_caster, targ, spellId, chip, DMG_FIRE);

	PlayObjectCenteredEffect(targ, FX_SMALL_FIRE_MAGIC, 10, 15);
	PlaySoundEffect(targ, 0x357);

	if (tick_number % 3 == 0)
		SendSysMessageEx(targ, "As chamas continuam a te consumir!", SSM_FAIL);
	endif

	if (tick_number >= CInt(tp.total_ticks))
		PrintTextAbove(targ, "*as chamas se extinguem*");
		SendSysMessageEx(targ, "As chamas finalmente se apagam.", SSM_INFO);
	endif
endprogram
