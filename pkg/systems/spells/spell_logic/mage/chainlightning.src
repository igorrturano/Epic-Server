use uo;
use os;
use util;
use cfgfile;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":spells:Controller/SC_Damage";
include "include/tileEffects";
include ":taming:taming";
include "include/epicMageryUtils";

program chainLightning(params)
	var caster := params[1];
	var targ := params[2];
	var spellinfo := params[3];
	var spell_circle := spellinfo.Circle;
	var spell_school := spellinfo.School;
	SendSysMessage(caster, "Selecione o alvo.");

	if (!targ)
		SendSysMessageEx(caster, "Voce cancelou.", SSM_FAIL);
		return 0;
	endif
	if (!CheckLosAt(caster, caster.x, caster.y, caster.z))
		SendSysMessageEx(caster, "Voce nao enxerga o alvo.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(caster, "Voce ve raio saindo de sua mao e passando por seus inimigos.", SSM_INFO);

	PlayObjectCenteredEffect(caster, 0xE088, 10, 15);

	var range := cint(HandleSpellSkill(caster) / 20);
	var allMobiles := listAllMobilesNearbyButPetsAndParty(caster, range, targ);

	var casterThenNextMobile := caster;
	var jump := 0;
	foreach mobile in allMobiles
		PlayMovingEffect(casterThenNextMobile, mobile, 0xE088, 0, 20);
		casterThenNextMobile := mobile;
		PlaySoundEffect(mobile, 0x457);
		var dmg := epicSpellDamageRoll(caster, spell_circle, spell_school);

		// 20% falloff per additional jump after the first target.
		if (jump > 0)
			var falloff := 1.0 - (jump * 0.2);
			if (falloff < 0.2)
				falloff := 0.2;
			endif
			dmg := Cint(dmg * falloff);
		endif

		SC_DealDamage(caster, mobile, CInt(spellinfo.id), cint(dmg), DMG_ENERGY);
		jump := jump + 1;
		sleepms(600);
	endforeach
endprogram
