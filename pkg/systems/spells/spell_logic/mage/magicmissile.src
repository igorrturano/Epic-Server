use uo;
use os;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":spells:Controller/SC_Damage";
include "include/epicConstants";
include "include/epicMageryUtils";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spellinfo := params[3];
	var spell_circle := spellinfo.Circle;
	var spell_school := spellinfo.School;

	SendSysMessage(who, "Selecione o alvo.");
	if (!targ.IsA(POLCLASS_MOBILE))
		SendSysMessage(who, "Alvo inválido.");
		return 0;
	endif

	if (!targ)
		SendSysMessageEx(who, "Cancelado", SSM_FAIL);
		return 0;
	endif
	var mlore := cint(AP_GetSkill(who, ARCANA) / 25);
	mlore := mlore < 1 ? 1 : mlore; // garante ao menos 1.

	if (MobileWrapper(who).HasAbility(ABILITY_ID::EVOCATOR))
		mlore := mlore + 1;
	endif
	SendSysMessageEx(who, "Mísseis mágicos saem de sua mão", SSM_INFO);
	var i := 1;
	for (i := 1; i <= mlore; i += 1)
		PlayMovingEffectEx(who, targ, 0x5426, 19, 20, 2290, 2);
		PlaySoundEffect(who, SFX_AGILITY2);

		var dmg;
		if (i == mlore)
			// Carro-chefe: ultimo dardo rola o dado completo do circulo (com bump do Evocator).
			dmg := epicSpellDamageRoll(who, spell_circle, 0);
		else
			// Dardos regulares: dano pequeno e confiavel, sem escalar.
			dmg := RandomDiceRoll("1d4") + 1;
		endif

		// Misseis Magicos is auto-hit flavor — no save by design.
		SC_DealDamage(who, targ, CInt(spellinfo.id), cint(dmg), DAMAGE_TYPE::FORCED);
		SleepMS(500);
	endfor
	return 1;
endprogram
