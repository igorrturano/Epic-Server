use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include ":wrappers:Objects/Model/MobileWrapper";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	SendSysMessageEx(who, "Escolha o alvo.", SSM_REQUEST);
	var targ := Spell_Target(who, TGTOPT_CHECK_LOS);
	if (!targ)
		return;
	endif
	var skill := Cint(AP_GetSkill(who, "Magery"));

	if (GetObjProperty(targ, "FarolEspiritos"))
		if (skill >= 60)
			var items := ListItemsAtLocation(targ.x, targ.y, LIST_IGNORE_Z, targ.realm);
			foreach item in items
				if (item.objtype == 41985)
					Destroyitem(item);
				endif
				if (item.objtype == 14154)
					Destroyitem(item);
				endif
				if (item.objtype == 7401)
					EraseObjProperty(item, "FarolEspiritos");
					item.movable := 1;
				endif
			endforeach
			SendSysMessageEx(who, "Voce removeu a maldicao do Farol de Espiritos", SSM_INFO);
			MoveObjectToLocation(targ, targ.x, targ.y, targ.z - 2, targ.realm, MOVEOBJECT_FORCELOCATION);
			sleepms(300);
			MoveObjectToLocation(targ, targ.x, targ.y, targ.z - 2, targ.realm, MOVEOBJECT_FORCELOCATION);
			sleepms(300);
			MoveObjectToLocation(targ, targ.x, targ.y, targ.z - 2, targ.realm, MOVEOBJECT_FORCELOCATION);
			sleepms(300);
			MoveObjectToLocation(targ, targ.x, targ.y, targ.z - 2, targ.realm, MOVEOBJECT_FORCELOCATION);
			sleepms(300);
			return 0;
		else
			SendSysMessageEx(who, "Voce nao tem capacidade para remover esta maldicao", SSM_INFO);
		endif
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	var timer_list := TS_GetTimerList(targ);
	var names := array;
	PlaySoundEffect(targ, SFX_SPELL_STRENGTH);

	foreach timer in (timer_list.keys())
		var tname := lower(timer);
		if (tname == "paralysis" || tname == "weaken" || tname == "lentidao" || tname == "curse" ||
	  tname == "desarmar" || tname == "desmontar" || tname == "polymorph" || tname == "apodrecer" ||
	  tname == "clumsy" || tname == "atrasarmagias" || tname == "feebleMind" || tname == "dmgreduction" ||
	  tname == "sleep")
			TS_LowerDuration(targ, timer, -1);
		endif

	endforeach

	// Cleanse SC-tracked debuffs (spelleffect_{spellId} timers with opts.is_debuff).
	var mw := MobileWrapper(targ);
	foreach timer_name in (timer_list.keys())
		if (timer_name[1, 12] != "spelleffect_")
			continue;
		endif
		var spellId := CInt(timer_list[timer_name].level);
		if (!spellId)
			continue;
		endif
		var opts := mw.GetProperty($"SpellOpts_{spellId}");
		if (opts && !opts.errortext && CInt(opts.is_debuff))
			SC_RemoveEffect(targ, spellId);
		endif
	endforeach

	SendSysMessageEx(targ, "Sua maldicao foi removida.", SSM_INFO);

	return 1;
endprogram
