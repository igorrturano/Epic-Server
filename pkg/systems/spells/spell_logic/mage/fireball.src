use uo;
include "include/tileEffects";
include ":attributes:attributes";
include ":combat:Controller/DamageController_legacy";
include "include/shapes";
include ":timedScripts:timedScripts";
include "include/sysEvent";
include "include/client";
include "include/say";
include ":taming:taming";
include "include/epicConstants";
include "include/epicMageryUtils";
include ":destroyable:include/destroyItem";
include ":charactercreation:resists";

program spell_fireball(params)
	var caster := params[1];
	var cast_on := params[2];
	var spell := params[3];
	var spell_circle := spell.Circle;
	var spell_school := spell.School;

	params := 0;

	SendSysMessage(caster, "Selecione o alvo.");
	if (!cast_on)
		SendSysMessage(caster, "cancelado.", color := 33);
		return 0;
	endif

	var mlore := cint(AP_GetSkill(caster, ARCANA) / 20);
	var dist := Distance(caster, cast_on);
	var dist_allowed := distanceAllowedForSpells(caster, mlore, spell_school);

	if (dist > dist_allowed)
		SendSysMessage(caster, "O alvo esta muito distante");
		return 0;
	endif

	PlayMovingEffect(caster, cast_on, FX_LARGE_FIREBALL, 10, 10, 1);
	sleepms(150);

	PlayStationaryEffect(cast_on.x, cast_on.y, cast_on.z, FX_EXPLODE_1, 10, 20, 0, cast_on.realm);
	PlaySoundEffect(cast_on, 0x208);

	var radius := Cint(AP_GetSkill(caster, ARCANA) / 25);
	if (radius < 2)
		radius := 2;
	elseif (radius > 4)
		radius := 4;
	endif

	var dmg := epicSpellDamageRoll(caster, spell_circle, spell_school);
	DanificaObjetosProximos(caster, cast_on.x, cast_on.y, cast_on.z, cast_on.realm,
							struct{ dano := dmg, desc := "Bola de Fogo.", tipo := DMG_FIRE },
							radius, FX_EXPLODE_1);

	var diff := handleSpellResistDiffForSpecialists(caster, spell_school);
	var bonus := epicWisdomPathBonus(caster);

	var allMobiles := listAllMobilesNearbyButPetsAndParty(caster, radius, cast_on);
	foreach mobile in allMobiles
		var target_dmg := epicSpellDamageRoll(caster, spell_circle, spell_school);

		if (CheckResist(mobile, REFLEXES, diff, -bonus))
			target_dmg := Cint(target_dmg / 2);
			SendSysMessageEx(mobile, "Voce desvia parcialmente da explosao.", SSM_INFO);
		endif

		if (Getcooldown(mobile, "spellthief"))
			DamageFLS(caster, cint(target_dmg), DMG_FIRE, caster, "fireball");
		else
			DamageFLS(mobile, cint(target_dmg), DMG_FIRE, caster, "fireball");
		endif

		sleepms(20);
	endforeach
endprogram
