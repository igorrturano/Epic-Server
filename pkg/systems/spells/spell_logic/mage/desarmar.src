use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	SendSysMessageEx(who, "Escolha o alvo.", SSM_REQUEST + TGTOPT_HARMFUL);
	var targ := Spell_Target(who, TGTOPT_CHECK_LOS);
	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		return;
	endif

	if (MobileWrapper(targ).HasAbility(ABILITY_ID::VINCULO_ELEMENTAL))
		if (GetObjProperty(targ.weapon, "#elementalweapon"))
			SendSysMessageEx(who, "O alvo tem uma ligacao magica com a arma.", SSM_FAIL);
			return 1;
		endif
	endif

	var time := Cint(AP_GetSkill(who, ARCANA) / 10);
	if (time < 5)
		time := 5;
	endif

	var spellId := CInt(spell.id);
	SC_RemoveEffect(targ, spellId);

	var duration := CInt(AP_GetSkill(who, ARCANA) / 4);
	var opts := struct{};
	opts.+properties := dictionary{ "desarmar" -> 1 };
	opts.+displayname := "Desarmar";
	opts.+is_debuff := 1;

	SC_ApplyEffect(who, targ, opts, duration, spellId);

	var defweapon := targ.weapon;
	if (defweapon.objtype != 0x1F020)
		var x := targ.x;
		var y := targ.y;
		var move := MoveObjectToLocation(defweapon, x, y, GetWorldHeight(x, y), targ.realm,
								   MOVEOBJECT_FORCELOCATION);
		if (move == error)
			MoveItemToContainer(defweapon, targ.backpack);
		endif
	else
		SendSysMessage(targ, "desarmado");
	endif

	PrintTextAbove(targ, "*desarmado*", SSM_FAIL);

	return 1;
endprogram
