use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include "include/epicMageryUtils";
include ":nature:Controller/LightController";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	handleSilentMagic(who, who, SFX_BLESS);
	PlayObjectCenteredEffect(who, FX_BLUE_SPARKLES, 10, 10);

	SendSysMessageEx(who, "Voce passa a enxergar melhor de dia", SSM_INFO);

	var magiclore_skill := AP_GetSkill(who, ARCANA);
	var duration := CInt(magiclore_skill * 5);

	// Bonus de especialização
	if (MobileWrapper(who).HasAbility(ABILITY_ID::VALDRUK))
		duration := Cint(duration * 1.2);
	endif

	ApplyMagicalVision(who, duration);

	return 1;
endprogram
