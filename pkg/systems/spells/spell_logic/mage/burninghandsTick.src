use uo;
use os;
use util;

include "include/client";
include "include/say";
include "include/sounds";
include "include/tileEffects";
include ":spells:Controller/SC_Damage";

// Per-tick burn damage for Maos Flamejantes DoT. Chip fixo de 1d4+1 por tick.
// tick_params: struct{ total_ticks }
program BurningHandsTick(args)
	var caster := args[1];
	var targ := args[2];
	var spellId := CInt(args[3]);
	var tick_number := CInt(args[4]);
	var tp := args[5];
	args := 0;

	if (!targ || targ is @Exception || targ.dead)
		return;
	endif

	var dmg_caster := caster;
	if (!dmg_caster || dmg_caster is @Exception || dmg_caster.dead)
		dmg_caster := targ;
	endif

	var chip := RandomDiceRoll("1d4") + 1;
	// Tick = chip; NAO carrega bonus do foco. O impacto inicial de Maos
	// Flamejantes (burninghands.src) ja aplicou o elemental do foco UMA vez.
	// Padrao magicmissile: so o golpe principal escala (ver 63% incinerar).
	SC_DealDamage(dmg_caster, targ, spellId, chip, DMG_FIRE, 0);
	PlayObjectCenteredEffect(targ, FX_FIRE_COLUMN, 5, 10);

	if (tick_number >= CInt(tp.total_ticks))
		PrintTextAbove(targ, "*chamas se apagam*");
	endif
endprogram
