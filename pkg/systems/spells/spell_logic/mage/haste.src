use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include "include/epicMageryUtils";
include ":timedScripts:timedScripts";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	var tempo := cint(HandleSpellSkill(who) / 5);

	// Bonus de especialização
	if (MobileWrapper(who).HasAbility(ABILITY_ID::EVOCATOR))
		tempo := Cint(tempo * 1.2);
	endif

	TS_StartTimer(who, "velocidade", tempo);

	PlaySoundEffect(who, SFX_SPELL_AGILITY);
	SendSysMessageEx(who, "Voce esta muito veloz.", SSM_INFO);

	return 1;
endprogram
