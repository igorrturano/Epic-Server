use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	var amt := cint(AP_GetSkill(who, THEOLOGY) * 0.4);
	var duration := GetSpellDuration(AP_GetSkill(who, THEOLOGY));
	TS_StartTimer(info, "strength", duration, amt, who, 1);
	SendSpellBuff(who, info, CInt(spell.id), duration);

	PlaySoundEffect(info, SFX_SPELL_STRENGTH);
	SendSysMessageEx(who, "Voce deixou o alvo mais forte.", SSM_INFO);

	return 1;
endprogram
