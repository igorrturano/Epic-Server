use uo;
use os;
use util;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":spells:Controller/SC_Damage";
include ":charactercreation:resists";
include "include/epicConstants";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";
include ":wrappers:Objects/Model/MobileWrapper";

program cast_incinerar(params)
	var caster := params[1];
	var targ := params[2];
	var spellinfo := params[3];
	var spell_circle := CInt(spellinfo.Circle[1]);
	var spell_school := spellinfo.School;
	params := 0;

	SendSysMessage(caster, "Selecione o alvo.");
	if (!targ || !targ.IsA(POLCLASS_MOBILE))
		SendSysMessage(caster, "Alvo invalido.");
		return 0;
	endif

	// Block recast while Incinerar is still active on the target.
	var existing := MobileWrapper(targ).GetProperty($"SpellOpts_{CInt(spellinfo.id)}");
	if (existing && !existing.errortext)
		SendSysMessageEx(caster, "O alvo ja esta incinerando!", SSM_FAIL);
		return 0;
	endif

	PlayObjectCenteredEffect(targ, 0xDC06, 15, 10);
	PlaySoundEffect(targ, 0x357);
	var impact := epicSpellDamageRoll(caster, spell_circle, spell_school);
	SC_DealDamage(caster, targ, CInt(spellinfo.id), cint(impact), DAMAGE_TYPE::FIRE);

	var diff := handleSpellResistDiffForSpecialists(caster, spell_school);
	var bonus := epicWisdomPathBonus(caster);

	var arcana := AP_GetSkill(caster, ARCANA);
	var total_ticks := CInt(arcana / 10);
	if (total_ticks < 6)
		total_ticks := 6;
	elseif (total_ticks > 14)
		total_ticks := 14;
	endif

	// Will save: success halves the burn duration, fail takes the full DoT.
	if (CheckResist(targ, WILL, diff, -bonus) > 0)
		total_ticks := Cint(total_ticks / 2);
		SendSysMessageEx(targ, "Voce resiste parte das chamas.", SSM_INFO);
	endif

	// Cada tick rola 1d4+1 fixo. Dano por tick nao escala com skill; a escala
	// vem do impact (carro-chefe) + numero de ticks (duracao).
	// Sem double-dip do Evocator: o bump de dado ja foi aplicado no impact.
	var tick_interval := 2;
	var duration := total_ticks * tick_interval;

	PrintTextAbove(targ, "*incinerando*");
	SendSysMessageEx(targ, "Voce esta pegando fogo!", SSM_FAIL);

	var opts := struct{};
	opts.+buff_category := "fire_dot";
	opts.+displayname := "Incinerar";
	opts.+desc := "1d4+1 dano / tick";
	opts.+tick_script := ":spells:spell_logic/mage/incinerarTick";
	opts.+tick_interval := tick_interval;
	opts.+tick_params := struct{
		total_ticks := total_ticks
	};

	SC_ApplyEffect(caster, targ, opts, duration, CInt(spellinfo.id));

	return 1;
endprogram
