use uo;
use os;

include "include/client";
include "include/say";
include "include/facings";
include ":attributes:attributes";
include "include/epicMageryUtils";

program SpellScript(params)

	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	// Normalized to the central spell range formula
	// (5 + skill/10 + spec/NPC + SpellRange ability). Self-cast ground-target,
	// so the central gate in cast_spell.src does not cover this — we resolve
	// the same reach locally, and re-prompt on bad clicks so a misclick
	// doesn't fizzle the whole cast.
	var max_range := distanceAllowedForSpells(who, HandleSpellSkill(who), info.School);
	var loc;
	while (1)
		SendSysMessageEx(who, "Escolha para onde quer mover.", SSM_REQUEST);
		loc := TargetCoordinates(who);
		if (!loc)
			SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
			return 0;
		endif
		if (!CheckLosAt(who, loc.x, loc.y, loc.z))
			SendSysMessageEx(who, "Voce nao ve o destino. Escolha outro local.", SSM_FAIL);
			continue;
		endif
		if (Distance(who, loc) > max_range)
			SendSysMessageEx(who, $"O destino esta muito distante. Alcance maximo: {max_range} tiles. Escolha outro local.", SSM_FAIL);
			continue;
		endif
		break;
	endwhile

	TurnObjectToward(who, loc.x, loc.y);

	PlaySoundEffect(who, SFX_SPELL_TELEKINESIS);
	PlayStationaryEffectEx(who.x, who.y, who.z, who.realm, FX_ELETRICIDADE, 8, 8, 0, 10);
	sleepms(400);
	if (CanWalk("L", who.x, who.y, who.z, loc.x, loc.y, who.realm) == error)
		SendSysMessage(who, "Local Inacessível");
		return 0;
	else
		MoveObjectToLocation(who, loc.x, loc.y, loc.z, who.realm);
		PlayStationaryEffectEx(loc.x, loc.y, loc.z, who.realm, FX_ELETRICIDADE, 8, 8, 0, 10);
		sleepms(400);
	endif


	return 1;

endprogram
