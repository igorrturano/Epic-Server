use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Voce so pode alvejar seres vivos com esta magia.", SSM_FAIL);
		return;
	endif

	PlaySoundEffect(targ, SFX_108);
	PlayObjectCenteredEffect(targ, FX_BLUE_SPARKLE_GROUND, 7, 16);
	PlaySoundEffect(targ, SFX_109);

	// var time := (AP_GetSkill(who, MAGERY) + AP_GetSkill(who, THEOLOGY))*2;
	var duration := GetSpellDuration(AP_GetSkill(who, THEOLOGY));
	TS_StartTimer(targ, "clumsy", duration, 0, who);
	TS_StartTimer(targ, "lentidao", CInt(AP_GetSkill(who, THEOLOGY) / 4), 0, who);
	SendSpellBuff(who, targ, CInt(spell.id), duration);

	pushback(targ, 5, 100);

	SendSysMessageEx(targ, "Uma rajada de vento frio atinge voce.", SSM_FAIL);

	return 1;
endprogram
