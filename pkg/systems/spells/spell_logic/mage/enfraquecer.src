use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	SendSysMessageEx(who, "Escolha o alvo.", SSM_REQUEST);
	if (who.npctemplate)
		targ := GetRandomNearbyHostile(who);
	endif
	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	var spellId := CInt(spell.id);
	SC_RemoveEffect(targ, spellId);

	var amt := Cint(AP_GetSkill(who, THEOLOGY) * 0.75);
	var duration := GetSpellDuration(AP_GetSkill(who, THEOLOGY));

	var opts := struct{};
	opts.+str_mod := -amt;
	opts.+displayname := "Enfraquecer";
	opts.+maintainable := 1;

	SC_ApplyEffect(who, targ, opts, duration, spellId);

	PlayObjectCenteredEffect(targ, FX_CURSE_SPELL, 9, 30);
	SC_HandleSound(who, targ, SFX_SPELL_WEAKEN);
	SendSysMessageEx(who, "Voce deixou o alvo mais fraco.", SSM_INFO);
	return 1;
endprogram
