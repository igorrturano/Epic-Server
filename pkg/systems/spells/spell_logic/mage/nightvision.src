use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include ":attributes:attributes";
include "include/epicMageryUtils";
include "include/dungeons";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	var race := GetObjProperty(who, "chardata").raca;
	var in_darkness := InDarkness(who);

	// Non-drows casting during daylight (not in darkness)
	if (!in_darkness && race != DROW)
		SendSysMessageEx(who, "A magia não tem efeito sob a luz do dia.", SSM_FAIL);
		return 0;
	endif

	// Drows casting during darkness
	if (in_darkness && race == DROW)
		SendSysMessageEx(who, "A magia não tem efeito na escuridão.", SSM_FAIL);
		return 0;
	endif

	PlayObjectCenteredEffect(who, FX_BLUE_SPARKLES, 10, 10);
	handleSilentMagic(who, who, SFX_BLESS);

	SendSysMessageEx(who, "Voce passa a enxergar melhor", SSM_INFO);

	var magiclore_skill := HandleSpellSkill(who);
	var duration := CInt(120 + (magiclore_skill * 5));

	// Bonus de especialização
	if (Temhabilidade(who, "Coração da Matilha"))
		duration := Cint(duration * 1.2);
	endif

	who.setlightlevel(15, duration);
	if (race != DROW)
		SetCooldown(who, "nightvision", duration);
	else
		SetCooldown(who, "lightvision", duration);
	endif

	return 1;
endprogram
