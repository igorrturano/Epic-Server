use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	SC_RemoveEffect(who, CInt(spell.id));

	var duration := CInt(AP_GetSkill(who, ARCANA)) / 2;
	var delay_amount := CInt(AP_GetSkill(who, ARCANA) * 20);

	var opts := struct{};
	opts.+properties := dictionary{ "#delayspell" -> delay_amount };
	opts.+desc := "Atrasar Magias";

	SC_ApplyEffect(who, who, opts, duration, CInt(spell.id));
	SC_HandleSound(who, who, 385);

	SendSysMessageEx(targ, "Voce se sente mais fraco.", SSM_INFO);
	Corromper(who, 17, targ);

	return 1;
endprogram
