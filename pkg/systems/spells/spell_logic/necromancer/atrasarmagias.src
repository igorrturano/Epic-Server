use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include ":attributes:attributes";
include "include/epicMageryUtils";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	var duration := cint(AP_GetSkill(who, ARCANA)) / 2;
	TS_StartTimer(who, "atrasarmagias", duration, AP_GetSkill(who, ARCANA) * 20, who, 0); // 20 min
	SendSpellBuff(who, who, CInt(spell.id), duration);
	handleSilentMagic(who, who, 385);

	SendSysMessageEx(targ, "Voce se sente mais fraco.", SSM_INFO);
	Corromper(who, 17, targ);

	return 1;
endprogram
