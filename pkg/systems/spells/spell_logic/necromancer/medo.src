use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":charactercreation:resists";
include "include/epicMageryUtils";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;
	params := 0; // No longer needed

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Voce so pode usar esta magia em coisas vivas.", SSM_FAIL);
		return 0;
	endif

	if (temhabilidade(targ, "Aura Divina"))
		SendSysMessageEx(who, "O alvo resistiu a magia.", SSM_FAIL);
		SendSysMessageEx(targ, "Você não conhece o medo.", SSM_INFO);
		return 1;
	endif
	var entropy := MobileWrapper(targ).GetEntropy();
	if (entropy <= -8000)
		Message("Você não conhece o medo.").SendSys(targ);
		Message("O alvo resistiu a magia.").SendSys(who);
		return 1;
	endif
	var mlore := Cint(AP_GetSkill(who, ARCANA));
	var duration := 10 + cint(mlore / 10);
	if (MobileWrapper(who).HasAbility(ABILITY_ID::VALDRUK))
		duration := duration + 10;
	endif

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);

	if (!CheckResist(targ, WILL, diff, -bonus))
		TS_StartTimer(targ, "dmgreduction", duration, mlore, who, 1);
		handleSilentMagic(who, targ, SFX_SPELL_PROTECTION);

		PrintTextAbove(targ, "*apavorado*");
		Corromper(who, 32, targ);
	else
		SendSysMessageEx(who, "O alvo  resistiu a magia.", SSM_FAIL);
		SendSysMessageEx(targ, "Voce resistiu a magia.", SSM_INFO);
		handleSilentMagic(who);
		return 1;
	endif
	return 0;
endprogram
