use uo;
use os;

include ":spells:tnmagery";
include ":spells:Controller/SpellController";
include ":spells:Controller/SC_Damage";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include "include/epicMageryUtils";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;
	params := 0; // No longer needed

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	SC_HandleSound(who, targ, SFX_SPELL_WEAKEN);
	var time := 0;
	var oldx := who.x;
	var oldy := who.y;

	// who.frozen := 1;

	var amt := 10;
	if (MobileWrapper(who).HasAbility(ABILITY_ID::SACRIFICIO_DA_CARNE))
		if (isBloodied(who))
			amt := CInt(amt * 1.5);
		endif
	endif

	Corromper(who, 9, targ);

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);
	if (CheckResist(targ, WILL, diff, -bonus))
		SendSysMessageEx(who, "Voce nota que o alvo nao foi afetado.", SSM_FAIL);
		SendSysMessageEx(targ, "Voce resistiu a magia.", SSM_INFO);

		EraseObjProperty(who, "#Casting");
		return;
	endif

	SetObjProperty(who, "#Casting", 1);
	SendSpellBuff(who, targ, CInt(spell.id), 10);

	while (time < 10)
		if ((who.x != oldx) || (who.y != oldy))
			time := 10;
			SendSysMessageEx(who, "Voce se moveu e cancelou a magia.", SSM_FAIL);
		elseif (who.frozen)
			time := 10;
			SendSysMessageEx(who, "Voce esta incapaz de se mover.", SSM_FAIL);
		elseif (Distance(who, targ) >= 16)
			time := 10;
			SendSysMessageEx(who, "O alvo se distanciou muito.", SSM_FAIL);
		elseif (AP_GetVital(targ, HITS) <= 0)
			time := 10;
		else
			PlayMovingEffectEx(targ, who, 3982, 255, 1, 2117);
			PerformAction(who, HUMAN_ANIM::CAST_AREA);
			SC_DealDamage(who, targ, CInt(spell.id), amt, DMG_FORCED);
			targ.setAggro(who.serial, 150);
			if (GetObjProperty(targ, "#sleep"))
				EraseObjProperty(targ, "#sleep");
			endif
			PrintTextPrivate(targ, "-" + amt + " Vida", who, 3, 38); // vermelho
			ApplyEpicHealing(who, amt);
			PrintTextPrivate(who, "+" + amt + " Vida", who, 3, 568); // verde
			time := time + 1;
			sleep(1);

			SetObjProperty(targ, "affected_by_spell", who.serial);
		endif
	endwhile

	EraseObjProperty(who, "#Casting");
	return 1;
endprogram
