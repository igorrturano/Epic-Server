use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0;

	SC_RemoveEffect(who, CInt(spell.id));

	var duration := CInt(GetSpellDuration(AP_GetSkill(who, ARCANA)) / 2);

	var opts := struct{};
	opts.+properties := dictionary{ "aparenciacadaverica" -> 1 };
	opts.+desc := "Aparencia Cadaverica";

	SC_ApplyEffect(who, who, opts, duration, CInt(spell.id));
	PlaySoundEffect(who, 385);
	SendSysMessageEx(who, "A sua aparencia se torna cadaverica", SSM_INFO);

	return 1;
endprogram
