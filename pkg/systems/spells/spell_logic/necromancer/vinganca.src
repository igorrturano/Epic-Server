use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":charactercreation:resists";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	SC_RemoveEffect(targ, CInt(spell.id));

	var time := CInt(AP_GetSkill(who, ARCANA)) / 4;
	if (time < 10)
		time := 10;
	endif

	var opts := struct{};
	opts.+properties := dictionary{ "#vinganca" -> 1 };
	opts.+desc := "Vinganca Recorrente";

	SC_ApplyEffect(who, targ, opts, time, CInt(spell.id));
	SC_HandleSound(who, targ, SFX_SPELL_WEAKEN);

	SendSysMessageEx(who, "A vinganca aguarda o alvo.", SSM_INFO);
	Corromper(who, 89, targ);

	return 1;
endprogram
