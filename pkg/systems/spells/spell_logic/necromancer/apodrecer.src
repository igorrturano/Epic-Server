use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0;

	SendSysMessageEx(who, "Escolha o alvo.", SSM_REQUEST);
	var targ := Spell_Target(who, TGTOPT_CHECK_LOS);
	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	SC_RemoveEffect(targ, 0); // No spell ID for standalone apodrecer

	var duration := CInt(GetSpellDuration(AP_GetSkill(who, ARCANA)) / 2);

	var opts := struct{};
	opts.+color := 986;
	opts.+hitchance_mod := -15;
	opts.+desc := "Apodrecer";

	// Use a fixed internal ID since this spell has no config entry
	SC_ApplyEffect(who, targ, opts, duration, 2000);
	PlaySoundEffect(targ, SFX_SPELL_WEAKEN);
	SendSysMessageEx(who, "O corpo do alvo se torna podre e menos resistente", SSM_INFO);

	return 1;
endprogram
