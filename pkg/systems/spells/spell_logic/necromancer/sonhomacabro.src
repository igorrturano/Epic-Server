use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include ":charactercreation:resists";
include "include/epicMageryUtils";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;
	params := 0;

	Corromper(who, 30, targ);

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);
	if (CheckResist(targ, WILL, diff, -bonus))
		SendSysMessageEx(who, "Voce nota que o alvo nao foi afetado.", SSM_FAIL);
		SendSysMessageEx(targ, "Voce resistiu a magia.", SSM_INFO);
		SC_HandleSound(who, who);
		return;
	endif

	SC_RemoveEffect(targ, CInt(spell.id));

	var duration := CInt(AP_GetSkill(who, ARCANA) / 2);

	var opts := struct{};
	opts.+properties := dictionary{ "#sleep" -> 1 };
	opts.+frozen := 1;
	opts.+desc := "Sonho Macabro";

	SC_ApplyEffect(who, targ, opts, duration, CInt(spell.id));
	SC_HandleSound(who, targ, 0x658);
	SendSysMessageEx(who, "O alvo adormeceu.", SSM_INFO);

	// Visual effects while sleeping
	Detach();
	Attach(targ);
	PlayObjectCenteredEffect(targ, 0xB8FB, 3, 56);
	sleep(3);

	while (GetObjProperty(targ, "#sleep"))
		PlayObjectCenteredEffect(targ, 0xB8FB, 3, 56);
		sleep(3);
	endwhile
	PrintTextAbove(targ, "*desperta*");
	targ.frozen := 0;

	return 1;
endprogram
