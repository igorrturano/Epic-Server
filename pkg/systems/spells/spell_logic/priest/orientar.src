use uo;
use os;

include ":attributes:attributes";
include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include "include/tileEffects";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	params := 0; // No longer needed

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Calculate bonus based on Theology skill / 10
	var bonus := cint(AP_GetSkill(who, THEOLOGY) / 20);
	if (bonus < 1)
		bonus := 1;
	endif

	// Set the attack bonus property on the target
	SetObjProperty(targ, "#attackbonus", bonus);

	// Visual and audio feedback
	PlayStationaryEffect(targ.x, targ.y, targ.z, FX_BLESS_EFFECT, 2, 2);
	PlaySoundEffect(targ, SFX_BLESS);

	SendSysMessageEx(who, "Voce guia " + targ.name + " com uma bencao divina.", SSM_INFO);
	if (targ != who)
		SendSysMessageEx(targ, "Voce sente uma orientacao divina guiando seus golpes. (+" + bonus + " no proximo ataque)", SSM_INFO);
	else
		SendSysMessageEx(targ, "Voce sente uma orientacao divina guiando seus golpes. (+" + bonus + " no proximo ataque)", SSM_INFO);
	endif

	return 1;
endprogram
