use uo;
use os;

// Fires when Santuario expires, is cancelled by the tick, or dispelled.
// Revokes the invul privilege granted at cast time.
// Args: { _unused, targ (caster), spellId, on_expire_params }
program SanctuaryExpire(args)
	var targ := args[2];
	args := 0;

	if (!targ)
		return;
	endif

	RevokePrivilege(targ, "invul");
	targ.disable("invul");
endprogram
