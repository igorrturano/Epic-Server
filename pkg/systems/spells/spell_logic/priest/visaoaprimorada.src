use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include "include/epicMageryUtils";
include ":nature:Controller/LightController";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	PlayObjectCenteredEffect(targ, FX_BLUE_SPARKLES, 10, 10);
	handleSilentMagic(who, targ, SFX_BLESS);

	SendSysMessageEx(targ, "Voce passa a enxergar melhor", SSM_INFO);

	var magiclore_skill := AP_GetSkill(who, THEOLOGY);
	var duration := CInt(magiclore_skill * 5);

	ApplyMagicalVision(targ, duration);
	SendSpellBuff(who, targ, CInt(spell.id), duration);

	return 1;
endprogram
