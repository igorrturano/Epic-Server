use uo;
use os;

include ":attributes:attributes";
include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedScripts:timedScripts";
include "include/tileEffects";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	params := 0; // No longer needed

	if (!targ)
		SendSysMessageEx(who, "Escolha um alvo para o Escudo de Fe.", SSM_REQUEST);
		targ := Target(who, TGTOPT_CHECK_LOS);
	endif

	if (!targ)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Calculate damage reduction bonus based on Theology skill / 25
	var theology := AP_GetSkill(who, THEOLOGY);
	var bonus := cint(theology / 25);
	if (bonus < 1)
		bonus := 1;
	endif

	// Calculate duration in seconds based on Theology / 2
	var duration := cint(theology / 2);
	if (duration < 5)
		duration := 5;
	endif

	// Set the damage reduction bonus property on the target
	SetObjProperty(targ, "#damagereduction", bonus);

	// Set a cooldown for ShieldOfFaith
	SetCooldown(targ, "ShieldOfFaith", duration);

	// Visual and audio feedback
	PlayStationaryEffect(targ.x, targ.y, targ.z, FX_BLESS_EFFECT, 2, 2);
	PlaySoundEffect(targ, SFX_BLESS);

	SendSysMessageEx(who, "Voce concede um Escudo de Fe a " + targ.name + ".", SSM_INFO);
	if (targ != who)
		SendSysMessageEx(targ, "Voce recebe um Escudo de Fe. (-" + bonus + " de dano recebido por " + duration + " segundos)", SSM_INFO);
	else
		SendSysMessageEx(targ, "Voce recebe um Escudo de Fe. (-" + bonus + " de dano recebido por " + duration + " segundos)", SSM_INFO);
	endif

	return 1;
endprogram
