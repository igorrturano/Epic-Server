use uo;

include ":attributes:attributes";
include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include "include/tileEffects";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	if (!targ)
		SendSysMessageEx(who, "Escolha um alvo para o Escudo de Fe.", SSM_REQUEST);
		targ := Target(who, TGTOPT_CHECK_LOS);
	endif

	if (!targ)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Remove efeito anterior se existir
	SC_RemoveEffect(targ, CInt(spell.id));

	// Bonus de spell resist em % multiplicativa (escala % do redesign).
	// theology/3 = max 33% no GM Theology. Ver design_magia.md.
	var theology := AP_GetSkill(who, THEOLOGY);
	var bonus := CInt(theology / 3);
	if (bonus < 1)
		bonus := 1;
	endif

	// +10% quando o alvo nao usa armadura — clerigos de robe ganham mais valor.
	// Mesmo padrao de barkskin.src (HasArmorProtection). Paladino com plate nunca
	// dispara este bonus.
	if (!HasArmorProtection(targ))
		bonus += 10;
	endif

	// Calculate duration in seconds based on Theology / 2
	var duration := CInt(theology / 2);
	if (duration < 5)
		duration := 5;
	endif

	var opts := struct{};
	opts.+slash_resist := bonus;
	opts.+piercing_resist := bonus;
	opts.+blunt_resist := bonus;
	opts.+buff_category := "armor_protection";
	opts.+displayname := "Escudo de Fé";
	opts.+maintainable := 1;
	opts.+on_apply_script := ":spells:shared/playApplyFX";
	opts.+on_apply_params := struct{
		fx := FX_BLESS_EFFECT,
		fx_speed := 2,
		fx_duration := 2,
		sound := SFX_BLESS
	};

	SC_ApplyEffect(who, targ, opts, duration, CInt(spell.id));

	SendSysMessageEx(who, "Voce concede um Escudo de Fe a " + targ.name + ".", SSM_INFO);
	SendSysMessageEx(targ, "Voce recebe um Escudo de Fe. (+" + bonus + "% resistencia por " + duration + " segundos)", SSM_INFO);

	return 1;
endprogram

function HasArmorProtection(targ)
	var itemdesc := ReadConfigFile(":*:itemdesc");
	foreach item in (ListEquippedItems(targ))
		if (!item.isa(POLCLASS_ARMOR))
			continue;
		endif
		var tipoProtecao := CStr(itemdesc[item.objtype].TipoProtecao);
		if (tipoProtecao["Armadura"])
			return 1;
		endif
	endforeach
	return 0;
endfunction
