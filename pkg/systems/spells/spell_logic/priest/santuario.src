use uo;
use os;

include ":attributes:attributes";
include ":tn:cooldown";
include "include/client";
include "include/say";
include "include/sounds";
include ":spells:Controller/SpellController";

program sanctuary(params)
	var who := params[1];
	var spell := params[3];
	params := 0;

	// Guard conditions — same list enforced per-tick.
	if (GetEquipmentByLayer(who, 1) || GetEquipmentByLayer(who, 2))
		SendSysMessageEx(who, "Voce precisa estar desequipado para o santuario.", SSM_FAIL);
		return 0;
	endif
	if (who.warmode)
		SendSysMessageEx(who, "Voce nao pode entrar em santuario em modo de combate.", SSM_FAIL);
		return 0;
	endif
	if (GetCooldown(who, "martir") > 0)
		SendSysMessageEx(who, "Voce optou pelo sacrificio pessoal.", SSM_FAIL);
		return 0;
	endif

	var duration := CInt(AP_GetSkill(who, THEOLOGY) / 2);

	// Grant invul immediately so there's no gap before the first tick check.
	GrantPrivilege(who, "invul");
	who.enable("invul");
	PlaySoundEffect(who, 0x216);

	var opts := struct{};
	opts.+buff_category := "sanctum";
	opts.+displayname := "Santuario";
	opts.+desc := "Invulneravel";
	opts.+tick_script := ":spells:spell_logic/priest/santuarioTick";
	opts.+tick_interval := 1;
	opts.+tick_params := struct{};
	opts.+on_expire_script := ":spells:spell_logic/priest/santuarioExpire";
	opts.+on_expire_params := struct{};

	SC_ApplyEffect(who, who, opts, duration, CInt(spell.id));

	return 1;
endprogram
