use uo;
use os;
use cfgfile;
include ":spells:tnmagery";
include ":attributes:attributes";
include ":brainai:npcUtil";
include ":combat:Controller/DamageController_legacy";
include ":tn:cooldown";
include "include/say";
include "include/client";
include "include/sounds";
include ":spells:summon";
include "include/tileEffects";
include "include/sysEvent";
include "include/eventID";

program SpellScript(params)

	var who := params[1];
	var targ := params[2];
	var spellid := params[3];

	var hostiles := ListHostiles(who, range := 20, flags := 0);

	if (Len(hostiles) == 0)
		SendSysMessageEx(who, "Voce nao esta sendo atacado.", SSM_FAIL);
		return 0;
	endif

	var globodeluz := summon(":epicai:globodeluz", who, who);
	if (!globodeluz)
		SendSysMessageEx(who, "A invocacao falhou.", SSM_FAIL);
		return 0;
	endif

	var theology_skill := CInt(AP_GetSkill(who, THEOLOGY));
	var level := (theology_skill / 5) + 5;
	SetObjProperty(globodeluz, "hitsmod", level * 50);
	SetObjProperty(globodeluz, "NoCorpse", 1);

	var duracao := CInt(theology_skill / 5) + 5;

	foreach hostile in hostiles
		if (GetObjProperty(hostile, "raca") == error)
			SetObjProperty(hostile, "#ForcedTarget", globodeluz.serial);
			var event := struct{ "type" := EVID_TAUNT, "source" := globodeluz };
			SendEvent(hostile, event);
		endif
	endforeach

	PlaySoundEffect(who, SFX_SPELL_STRENGTH);
	PlayStationaryEffect(who.x, who.y, who.z, FX_SPARK_EFFECT, 2, 2);
	SendSysMessageEx(targ, "A luz ofuscou a visao dos seus inimigos.", SSM_INFO);

	sleep(duracao);

	// Limpa #ForcedTarget dos hostiles
	foreach hostile in hostiles
		if (GetObjProperty(hostile, "#ForcedTarget") == globodeluz.serial)
			EraseObjProperty(hostile, "#ForcedTarget");
		endif
	endforeach

	// Mata o globo de luz
	if (globodeluz)
		SetObjProperty(globodeluz, "guardkill", 1);
		ApplyDamage(globodeluz, 9999);
	endif

	return 1;
endprogram
