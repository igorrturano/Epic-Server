
use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include "include/tileEffects";
include ":timedScripts:timedScripts";

include ":spells:Controller/SC_Damage";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	PlaySoundEffect(targ, SFX_SPELL_STRENGTH);
	var amt := Cint(AP_GetSkill(who, THEOLOGY) / 10);
	foreach mobile in (ListMobilesNearLocation(targ.x, targ.y, targ.z, 6, targ.realm))
		var i := 1;
		if (mobile.npctemplate && i <= amt)
			var elem := NPC_GetNPCConfig(mobile.npctemplate);
			var category := lower(GetConfigString(elem, "Environment"));

			if (category == "undead" || category == "demons")
				PlayMovingEffectXYZEx(mobile.x, mobile.y, mobile.z, mobile.x, mobile.y, mobile.z + 60,
									   mobile.realm, FX_LARGE_FIREBALL, 1, 10, 2320);

				MoveObjectToLocation(mobile, 10, 10, 10, mobile.realm, MOVEOBJECT_FORCELOCATION);

				// 5 × ApplyRawDamage(200) consolidated into a single 1000 SC_DealDamage call
				// to avoid firing AFTER_DAMAGE / ON_KILL hooks 5× per target.
				SC_DealDamage(who, mobile, CInt(spell.id), 1000, DAMAGE_TYPE::FORCED);
				i++;
			endif

		endif

	endforeach

	return 1;
endprogram
