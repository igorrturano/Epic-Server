use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":attributes:attributes";
include ":spells:Controller/SpellController";
include ":wrappers:Objects/Model/MobileWrapper";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0;

	if (!targ)
		return;
	endif

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Isto nao pode ser alvejado por essa magia.", SSM_FAIL);
		return;
	endif

	// Block recast while aura is still active on the target.
	var existing := MobileWrapper(targ).GetProperty($"SpellOpts_{CInt(spell.id)}");
	if (existing && !existing.errortext)
		SendSysMessageEx(who, "Voce so pode orar uma magia ao mesmo tempo.", SSM_FAIL);
		return;
	endif

	PlaySoundEffect(targ, SFX_SPELL_STRENGTH);

	var theology := CInt(AP_GetSkill(who, THEOLOGY));
	var duration := theology;
	var heal := CInt(theology / 20);
	if (heal < 1)
		heal := 1;
	endif

	var opts := struct{};
	opts.+buff_category := "regen_aura";
	opts.+displayname := "Prece Curativa";
	opts.+desc := $"+{heal} HP / 2s na area";
	opts.+tick_script := ":spells:spell_logic/priest/descansotranquiloTick";
	opts.+tick_interval := 2;
	opts.+tick_params := struct{
		origin_x := targ.x,
		origin_y := targ.y,
		heal := heal,
		caster_serial := who.serial
	};

	SC_ApplyEffect(who, targ, opts, duration, CInt(spell.id));

	return 1;
endprogram
