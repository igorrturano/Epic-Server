use uo;
use os;

include ":tn:cooldown";
include "include/client";
include "include/say";
include ":spells:Controller/SpellController";

// Per-tick protection check for Santuario. Cancels the spell (which fires
// on_expire to revoke invul) if the caster equips armor, enters warmode,
// or takes the martir path.
// Args: { caster, targ, spellId, tick_number, tick_params }
program SanctuaryTick(args)
	var targ := args[2];
	var spellId := CInt(args[3]);
	args := 0;

	if (!targ)
		return;
	endif

	var broken_reason := "";
	if (GetEquipmentByLayer(targ, 1) || GetEquipmentByLayer(targ, 2))
		broken_reason := "Voce se equipou e cancelou o santuario.";
	elseif (targ.warmode)
		broken_reason := "Voce entrou em modo de combate e cancelou o santuario.";
	elseif (GetCooldown(targ, "martir") > 0)
		broken_reason := "Voce optou pelo sacrificio pessoal.";
	endif

	if (broken_reason != "")
		SendSysMessageEx(targ, broken_reason, SSM_FAIL);
		SC_RemoveEffect(targ, spellId);
		return;
	endif

	PlayObjectCenteredEffect(targ, 0x375a, 10, 80);
endprogram
