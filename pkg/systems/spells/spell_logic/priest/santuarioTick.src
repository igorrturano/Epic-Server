use uo;
use os;
use vitals;

include ":tn:cooldown";
include "include/client";
include "include/say";
include ":spells:Controller/SpellController";

// Per-tick guard for Santuario. Cancels the spell if the caster equips armor,
// enters warmode, takes the martir path, or takes damage from any source
// (area, trap, DoT, etc.). Damage-break uses an HP snapshot refreshed each
// tick — 1-second worst-case latency.
// Args: { caster, targ, spellId, tick_number, tick_params }
program SanctuaryTick(args)
	var targ := args[2];
	var spellId := CInt(args[3]);
	var tp := args[5];
	args := 0;

	if (!targ)
		return;
	endif

	var broken_reason := "";
	if (GetEquipmentByLayer(targ, 1) || GetEquipmentByLayer(targ, 2))
		broken_reason := "Voce se equipou e cancelou o santuario.";
	elseif (targ.warmode)
		broken_reason := "Voce entrou em modo de combate e cancelou o santuario.";
	elseif (GetCooldown(targ, "martir") > 0)
		broken_reason := "Voce optou pelo sacrificio pessoal.";
	else
		var current_hp := GetVital(targ, HITS);
		var snapshot := CInt(GetObjProperty(targ, "#sanctuary_hp_snapshot"));
		if (snapshot && current_hp < snapshot)
			broken_reason := "Voce foi ferido e perdeu o santuario.";
		else
			SetObjProperty(targ, "#sanctuary_hp_snapshot", current_hp);
		endif
	endif

	if (broken_reason != "")
		SendSysMessageEx(targ, broken_reason, SSM_FAIL);
		SC_RemoveEffect(targ, spellId);
		return;
	endif

	var fx_id := CInt(tp.fx);
	if (!fx_id)
		fx_id := FX_EXPLOSAO_DE_ENERGIA;
	endif
	PlayObjectCenteredEffect(targ, fx_id, 10, 80);
endprogram
