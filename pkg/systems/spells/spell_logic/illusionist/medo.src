use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":charactercreation:resists";
include "include/epicMageryUtils";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;
	params := 0;

	if (!targ.isa(POLCLASS_MOBILE))
		SendSysMessageEx(who, "Voce so pode usar esta magia em coisas vivas.", SSM_FAIL);
		return 0;
	endif

	if (MobileWrapper(targ).HasAbility(ABILITY_ID::AURA_DIVINA))
		SendSysMessageEx(who, "O alvo resistiu a magia.", SSM_FAIL);
		SendSysMessageEx(targ, "Voce nao conhece o medo.", SSM_INFO);
		return 1;
	endif
	var entropy := MobileWrapper(targ).GetEntropy();
	if (entropy <= -8000)
		Message("Voce nao conhece o medo.").SendSys(targ);
		Message("O alvo resistiu a magia.").SendSys(who);
		return 1;
	endif

	var mlore := CInt(AP_GetSkill(who, ARCANA));
	var duration := 10 + CInt(mlore / 10);
	if (MobileWrapper(who).HasAbility(ABILITY_ID::VALDRUK))
		duration := duration + 10;
	endif

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);

	if (!CheckResist(targ, WILL, diff, -bonus))
		SC_RemoveEffect(targ, CInt(spell.id));

		var penalty := -CInt(mlore / 5);
		if (MobileWrapper(targ).HasAbility(ABILITY_ID::VALDRUK))
			penalty := CInt(penalty * 0.8);
		endif

		var opts := struct{};
		opts.+hitchance_mod := penalty;
		opts.+desc := "Medo";

		SC_ApplyEffect(who, targ, opts, duration, CInt(spell.id));
		SC_HandleSound(who, targ, SFX_SPELL_PROTECTION);

		PrintTextAbove(targ, "*apavorado*");
		Corromper(who, 32, targ);
	else
		SendSysMessageEx(who, "O alvo  resistiu a magia.", SSM_FAIL);
		SendSysMessageEx(targ, "Voce resistiu a magia.", SSM_INFO);
		SC_HandleSound(who, who);
		return 1;
	endif
	return 0;
endprogram
