use uo;
use util;

include "include/client";
include "include/sounds";
include ":charactercreation:resists";
include ":survival:fishingFunctions";
include "include/dungeons";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program HitScript(params)
	var who := params[1];
	var targ := params[2];

	if (!InDarkness(who))
		SendSysMessage(who, "Voce precisa estar na escuridao para usar essa habilidade.");
		return 0;
	endif

	PerformAction(who, HUMAN_ANIM::CAST_AREA);
	sleep(2);

	if (targ.serial == who.serial)
		SendSysMessage(who, "Voce nao pode usar isso em si mesmo. Para se teleportar, use a magia Teleportar.");
		return 0;
	endif

	who.frozen := 1;

	if (!CheckLosAt(who, targ.x, targ.y, targ.z))
		SendSysMessage(who, "Voce nao consegue ver o alvo.");
		who.hidden := 0;
		who.frozen := 0;
		return 0;
	endif

	var locinfo := GetMapInfo(targ.x, targ.y, who.realm);
	if (IsWater(targ, locinfo))
		SendSysMessage(who, "Voce nao pode clicar na agua");
		who.hidden := 0;
		who.frozen := 0;
		return 0;
	endif

	if (!targ)
		SendSysMessage(who, "Cancelled.");
		who.hidden := 0;
		who.frozen := 0;
		return 0;
	endif

	if (!CheckLosAt(who, targ.x, targ.y, targ.z))
		SendSysMessageEx(who, "Voce nao ve o alvo.", SSM_FAIL);
		return 0;
	endif
	PlayObjectCenteredEffectHuefx(targ, 0x54CE, 10, 20, 1420, 1);

	targ.hidden := 1;

	// Re-prompt on bad clicks (LoS / unwalkable) so a misclick doesn't waste
	// the whole spell. Explicit cancel (no coord) is the only abort path.
	var moveTo;
	while (1)
		moveTo := TargetCoordinates(who);
		if (!moveTo)
			SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
			targ.hidden := 0;
			who.frozen := 0;
			return 0;
		endif
		if (!CheckLosAt(who, moveTo.x, moveTo.y, moveTo.z))
			SendSysMessageEx(who, "Voce nao ve o local de destino. Escolha outro local.", SSM_FAIL);
			continue;
		endif
		if (CanWalk("L", who.x, who.y, who.z, moveTo.x, moveTo.y, who.realm) == error)
			SendSysMessage(who, "Local inacessivel. Escolha outro local.");
			continue;
		endif
		break;
	endwhile

	MoveObjectToLocation(targ, moveTo.x, moveTo.y, moveTo.z, who.realm);

	sleep(1);
	targ.hidden := 0;
	who.frozen := 0;
	PlayObjectCenteredEffectHuefx(targ, 0x54CE, 10, 20, 1420, 1);

	return 1;
endprogram
