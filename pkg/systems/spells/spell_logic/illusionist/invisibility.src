use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	var MagicLore := CInt(AP_GetSkill(who, ARCANA) / 5);
	params := 0;

	PlaySoundEffect(who, SFX_SPELL_HEAL);

	var x := who.x;
	var y := who.y;
	var delay := 2;
	if (MobileWrapper(who).HasAbility(ABILITY_ID::VALDRUK))
		MagicLore := MagicLore * 2;
		delay := 1;
	endif
	sleep(delay);
	if ((x != who.x) || (y != who.y))
		SendSysMessageEx(who, "Voce se movimentou e a magia falhou.", SSM_FAIL);
		return;
	endif

	if (!who.dead)
		SC_RemoveEffect(who, CInt(spell.id));

		var opts := struct{};
		opts.+hidden := 1;
		opts.+desc := "Invisibilidade";

		SC_ApplyEffect(who, who, opts, MagicLore, CInt(spell.id));
		SendSysMessageEx(who, "Voce esta escondido.", SSM_INFO);
	endif

	return 1;
endprogram
