use uo;
use os;

include "include/say";
include "include/dungeons";
include "include/client";
include ":attributes:attributes";
include "include/epicMageryUtils";
include ":awareness:awareness";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":charactercreation:resists";
include ":spells:Controller/SpellController";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	var spell_school := spell.School;
	params := 0;

	var diff := handleSpellResistDiffForSpecialists(who, spell_school);
	var bonus := epicWisdomPathBonus(who);
	if (CheckResist(targ, WILL, diff, -bonus))
		SendSysMessageEx(who, "Voce nota que o alvo nao foi afetado.", SSM_FAIL);
		SC_HandleSound(who, who);
		return;
	endif

	SC_RemoveEffect(targ, CInt(spell.id));

	var duration := CInt(AP_GetSkill(who, ARCANA) / 8);
	if (MobileWrapper(who).HasAbility(ABILITY_ID::VALDRUK))
		duration := CInt(duration * 2);
	endif

	var opts := struct{};
	opts.+hitchance_mod := -20;
	opts.+properties := dictionary{ "#blinded" -> -20 };
	opts.+desc := "Cegueira";

	SC_ApplyEffect(who, targ, opts, duration, CInt(spell.id));

	// Visual effects
	PlayStationaryEffectEx(targ.x, targ.y, targ.z + 10, targ.realm,
						  0x6e0d, 5, 3, 2, 2740);
	PrintTextAbove(targ, "*cegueira*");

	// Hide nearby mobiles from blinded target's view
	foreach mobile in (ListMobilesNearLocation(targ.x, targ.y, targ.z, 16, targ.realm))
		DeleteObject(targ, mobile);
		sleepms(20);
	endforeach
endprogram
