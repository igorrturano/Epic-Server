use uo;
use os;

include "include/client";

// on_apply for Protecao Arcana. Runs on the initial SC_ApplyEffect AND on every
// maintain re-apply. Stamps the "#manashield" property with a fresh endtime so
// the damage pipeline sees the shield as active, then plays the cast FX/sound.
// on_apply_params: struct{ duration, fx, sound, mana_ratio, vontade_bonus }
program ProtecaoArcanaApply(args)
	var targ := args[2];
	var p := args[4];
	args := 0;

	if (!targ || targ.errortext)
		return;
	endif

	var duration := CInt(p.duration);
	if (duration < 1)
		duration := 1;
	endif

	var ratio := CInt(p.mana_ratio);
	if (ratio < 1)
		ratio := 2;
	endif

	SetObjProperty(targ, "#manashield", struct{
		endtime := ReadGameClock() + duration,
		ratio := ratio
	});

	// Idempotent Vontade bonus: revert any prior amount before re-applying so
	// maintain re-applies don't compound.
	var prior_bonus := CInt(GetObjProperty(targ, "#manashield_vontade_bonus"));
	if (prior_bonus != 0)
		SetObjProperty(targ, "#VontadeMod", CInt(GetObjProperty(targ, "#VontadeMod")) - prior_bonus);
		EraseObjProperty(targ, "#manashield_vontade_bonus");
	endif

	var vontade_bonus := CInt(p.vontade_bonus);
	if (vontade_bonus > 0)
		SetObjProperty(targ, "#VontadeMod", CInt(GetObjProperty(targ, "#VontadeMod")) + vontade_bonus);
		SetObjProperty(targ, "#manashield_vontade_bonus", vontade_bonus);
	endif

	if (p.fx)
		PlayObjectCenteredEffect(targ, CInt(p.fx), 0, 30);
	endif

	if (p.sound)
		PlaySoundEffect(targ, CInt(p.sound));
	endif
endprogram
