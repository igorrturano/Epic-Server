
use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	params := 0; // No longer needed

	PlaySoundEffect(info, SFX_SPELL_TELEKINESIS);
	SendSysMessageEx(who, "O alvo tem forca:" + CInt(AP_GetStat(info, STRENGTH) / 5)
				  + " destreza: " + CInt(AP_GetStat(info, DEXTERITY) / 5)
				  + " e inteligencia: " + CInt(AP_GetStat(info, INTELLIGENCE) / 5), SSM_INFO);

	SendViewContainer(who, info.backpack);

	return 1;
endprogram
