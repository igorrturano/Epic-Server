use uo;
use os;

include ":spells:tnmagery";
include "include/client";
include "include/sounds";
include "include/say";
include ":timedscripts:timedScripts";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var targ := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	// SendSysMessageEx(who, "Escolha o alvo.", SSM_REQUEST);
	// var targ := Spell_Target(who, TGTOPT_CHECK_LOS);
	if (!targ)
		return;
	endif

	if (!targ.connected)
		SendSysMessageEx(who, "Voce so pode usar esta magia em outros personagens dos jogadores.",
				   SSM_FAIL);
		return 0;
	endif
	var time := 90 + Cint(AP_GetSkill(who, NATURE) * 1.5); // até 3min
	SetCooldown(targ, "protecaomorte", time);
	SendSpellBuff(who, targ, CInt(spell.id), time);
	PlaySoundEffect(targ, SFX_SPELL_HEAL);
	SendSysMessageEx(who, "O alvo foi encantado com sucesso por " + time + " segundos.", SSM_INFO);
	SendSysMessageEx(targ, "Voce sente uma protecao contra a morte te envolvendo por " + time + " segundos.", SSM_INFO);

	return 1;
endprogram
