// Intentionally bypasses SpellController: fraturaexposta uses NoEnd=1 +
// ContinueOnDeath=1 via the legacy cfg timer + Script tick loop. SC has no
// self-renewing / survives-death opts, and adding them for one spell isn't
// worth it.
use uo;
use os;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":hotbar:include/custombuff";

program SpellScript(params)
	var who := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	var duration := (CInt(AP_GetSkill(who, NATURE)) / 10);

	PlayStationaryEffect(info.x, info.y, info.z, 0x6cb7, 10, 20, 0, who.realm);
	foreach mob in ListMobilesNearLocation(info.x, info.y, info.z, 3, info.realm)
		var lama := CreateItemAtLocation(mob.x, mob.y, mob.z, 4653, 1, mob.realm);
		lama.color := 1008;
		lama.name := "lama";
		lama.movable := false;
		TS_StartTimer(mob, "fraturaexposta", duration);
		SendSpellBuff(who, mob, CInt(spell.id), duration);
	endforeach

	return 1;
endprogram
