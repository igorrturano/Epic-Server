use uo;
use os;
use util;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":magery:spells";
include "include/client";
include "include/sounds";
include ":spells:Controller/SC_Damage";
include "include/epicMageryUtils";
include ":charactercreation:resists";

program cast_lightningbolt(params)
	var caster := params[1];
	var info := params[2];
	var spell := params[3];
	params := 0; // No longer needed

	LaunchProjectile(caster, info, CInt(spell.id), spell.School);
endprogram

function LaunchProjectile(caster, info, spellId, spell_school)
	PlaySoundEffect(caster, SFX_SPELL_ENERGY_BOLT);
	PlayLightningBoltEffect(info);
	var dmg := cint(AP_GetSkill(caster, THEOLOGY)) + RandomDiceRoll("4d8");

	// REFLEX save halves the trovao's damage.
	var diff := handleSpellResistDiffForSpecialists(caster, spell_school);
	var bonus := epicWisdomPathBonus(caster);
	if (CheckResist(info, REFLEXES, diff, -bonus))
		dmg := Cint(dmg / 2);
		SendSysMessageEx(info, "Voce desvia parcialmente do trovao.", SSM_INFO);
	endif

	SC_DealDamage(caster, info, spellId, cint(dmg), DMG_ENERGY);
endfunction
