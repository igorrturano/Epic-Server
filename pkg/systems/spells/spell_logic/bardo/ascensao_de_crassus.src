use uo;
use os;

include ":attributes:attributes";
include "include/tileEffects";
include "include/sounds";

// A Ascensao de Crassus (1210) - C3
// +STR+DEX+INT party (Arc/5 cada) por Arc/3 segundos
program SpellScript(params)
	var who := params[1];

	var arcana   := CInt(AP_GetSkill(who, ARCANA));
	var bonus    := CInt(arcana / 5);
	if (bonus < 1)  bonus    := 1;  endif
	if (bonus > 20) bonus    := 20; endif
	var duration := CInt(arcana / 3);
	if (duration < 5)  duration := 5;  endif
	if (duration > 33) duration := 33; endif

	var range := 8;
	var buffed_list := array;
	var buffed := 0;

	PrintTextAbove(who, "*Crassus ergueu-se. E com ele, todos que acreditavam na historia.*", 3, 43);
	PlaySoundEffect(who, 0x1ED);

	foreach mobile in (ListMobilesNearLocation(who.x, who.y, who.z, range, who.realm))
		if (mobile.isa(POLCLASS_MOBILE) && !mobile.IsHostile(who))
			AP_ModifyStatMod(mobile, STRENGTH,     bonus);
			AP_ModifyStatMod(mobile, DEXTERITY,    bonus);
			AP_ModifyStatMod(mobile, INTELLIGENCE, bonus);
			SetObjProperty(mobile, "#cantico_crassus", bonus);
			PlayStationaryEffect(mobile.x, mobile.y, mobile.z, FX_BLESS_EFFECT, 3, 3);
			SendSysMessageEx(mobile, $"Ascensao de Crassus: +{bonus} STR/DEX/INT por {duration}s.", SSM_INFO);
			buffed_list[buffed + 1] := mobile;
			buffed += 1;
		endif
	endforeach

	if (buffed == 0)
		SendSysMessageEx(who, "Nenhum aliado por perto.", SSM_FAIL);
		return 0;
	endif

	SendSysMessageEx(who, $"Ascensao de Crassus: {buffed} aliado(s) elevado(s) por {duration}s.", SSM_INFO);

	sleep(duration);

	foreach mobile in buffed_list
		if (mobile && !mobile.dead && GetObjProperty(mobile, "#cantico_crassus") == bonus)
			AP_ModifyStatMod(mobile, STRENGTH,     -bonus);
			AP_ModifyStatMod(mobile, DEXTERITY,    -bonus);
			AP_ModifyStatMod(mobile, INTELLIGENCE, -bonus);
			EraseObjProperty(mobile, "#cantico_crassus");
		endif
	endforeach

	return 1;
endprogram
