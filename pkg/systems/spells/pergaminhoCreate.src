use uo;
use cfgfile;
use util;
use os;

include ":spells:SpellRegistry";

program cria(item)

	if (GetObjProperty(item, "spellinfo") != error)
		return 1;
	endif

	var spellinfo := struct;

	// pega o level do scroll
	var scrollcfg := ReadConfigFile(":spells:itemdesc");
	var lvl := scrollcfg[item.objtype].Circle;
	var spelltype_item := scrollcfg[item.objtype].SpellType;
	if (!lvl)
		lvl := 1;
	endif

	var randomspells := array;
	foreach cfg_path in (GetMageSchoolConfigPaths())
		var spellcfg := ReadConfigFile(cfg_path);
		if (!spellcfg)
			continue;
		endif
		var keys := GetConfigIntKeys(spellcfg);
		foreach key in keys
			var elem := FindconfigElem(spellcfg, key);
			var spelllvl := GetConfigInt(elem, "Circle");
			var spelltype := GetConfigString(elem, "Type");

			if (spelltype == "spellcaster")
				if (spelllvl == lvl)
					randomspells.append(key);
				endif
			endif
		endforeach
	endforeach

	var random_spell_idx := RandomInt(randomspells.size()) + 1;
	spellinfo.+id := randomspells[random_spell_idx];
	spellinfo.+magic_path := spelltype_item;
	if (spellinfo.magic_path == "spellcaster")
		var elem := ResolveSpell(spellinfo.id);
		if (elem)
			spellinfo.+School := GetConfigString(elem, "School");
		endif
		if (spellinfo.School == "Kaijin")
			item.graphic := 0x0E39;
		elseif (spellinfo.School == "Evocatium")
			item.graphic := 0x0E35;
		elseif (spellinfo.School == "Velkyn")
			item.graphic := 0x0E3A;
		elseif (spellinfo.School == "Ahtaleloreth")
			item.graphic := 0x0E38;
		elseif (spellinfo.School == "Aradalore")
			item.graphic := 0x0E37;
		endif
	endif
	SetObjProperty(item, "spellinfo", spellinfo);

	return 1;
endprogram
