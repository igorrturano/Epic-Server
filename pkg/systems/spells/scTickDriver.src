use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include ":spells:Controller/SC_Damage";

// Periodic driver for SC tick-callback effects.
// Sleeps `tick_interval` seconds, verifies the effect is still active by
// looking up SpellOpts_{spellId} on the target, fires the tick script, repeats.
// Self-terminates when the opts go missing (expiration, dispel, or replacement).
// A fresh driver is launched by SC_ApplyEffect and re-launched by SC_ResyncOnLogin
// after a server restart.
//
// If opts.tick_damage is set (struct{ amount, type }), the driver applies damage
// via SC_DealDamage each tick — this lets DoT spells describe their per-tick
// damage declaratively instead of hand-rolling ApplyRawDamage in each tick script.
// tick_script and tick_damage are independent: set either, both, or neither.
program SCTickDriver(args)
	var caster := args[1];
	var targ := args[2];
	var spellId := CInt(args[3]);
	var tick_script := args[4];
	var tick_interval := CInt(args[5]);
	var tick_params := args[6];
	var my_instance := CInt(args[7]);
	args := 0;

	if (!targ || tick_interval < 1)
		return;
	endif

	set_critical(0);
	detach();

	var tick_number := 1;

	while (1)
		sleep(tick_interval);

		if (!targ || targ is @Exception)
			return;
		endif

		var opts := MobileWrapper(targ).GetProperty($"SpellOpts_{spellId}");
		if (!opts || opts.errortext)
			return;
		endif

		// Opts were replaced by a newer apply (e.g. via maintain re-cast) —
		// that apply launched its own driver, so this one must exit to avoid
		// duplicate ticks. Legacy opts without instance_id keep working.
		if (my_instance && CInt(opts.instance_id) != my_instance)
			return;
		endif

		if (opts.tick_damage)
			SC_DealDamage(caster, targ, spellId,
				CInt(opts.tick_damage.amount),
				opts.tick_damage.type);
		endif

		if (tick_script)
			start_script(tick_script, array{ caster, targ, spellId, tick_number, tick_params });
		endif

		tick_number += 1;
	endwhile
endprogram
