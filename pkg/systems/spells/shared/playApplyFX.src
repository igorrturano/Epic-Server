use uo;

include ":spells:Controller/SpellController";

// Generic on_apply_script for spells that want their visual/sound to replay
// on every SC_ApplyEffect call (initial cast + maintain re-apply).
// Expects on_apply_params as:
//   struct{ fx := <graphic_id>, sound := <sfx_id>,
//           fx_speed := <int, default 10>, fx_duration := <int, default 10> }
// All fields optional.
program playApplyFX(args)
	var caster := args[1];
	var targ := args[2];
	var p := args[4];
	args := 0;

	if (!targ || targ is @Exception)
		return;
	endif

	if (!p || p is @Exception)
		return;
	endif

	if (p.fx)
		var speed := CInt(p.fx_speed);
		if (speed < 1)
			speed := 10;
		endif
		var dur := CInt(p.fx_duration);
		if (dur < 1)
			dur := 10;
		endif
		PlayObjectCenteredEffect(targ, CInt(p.fx), speed, dur);
	endif

	if (p.sound)
		SC_HandleSound(caster, targ, CInt(p.sound));
	endif
endprogram
