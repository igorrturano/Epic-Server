use uo;
use os;

include ":message:model/Message";
include ":abilities:controllers/AbilityMonitor";

program AbilityMonitor(params)
	var who := params[1]; // MobileWrapper class
	var monitor := params[2]; // AbilityMonitor class
	monitor.SetPid(GetPid());
	print($"AbilityMonitor started -> {monitor.ToString()}");

	if (who.IsDead())
		Message("Você não pode usar esta habilidade enquanto estiver morto.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return;
	endif

	var ability := monitor.GetAbility();
	SetScriptController(who.GetObjRef());
	
	who.ActivateAbility(ability, monitor);
	Message($"Habilidade {ability.GetName()} ativada por {ability.GetDuration()}s.", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who.GetObjRef());
	
	while (true)
		var event := Wait_For_Event(ability.GetDuration());
		
		if (event == ABILITY_EVENT_ID::USED)
			Message($"Habilidade {ability.GetName()} teve seu efeito usado.", Color(SYSTEM_COLOR::INFO)).SendSys(who.GetObjRef());
			monitor.ConsumeCharge(1);
		else
			if (event == ABILITY_EVENT_ID::ABORT)
				Message($"Habilidade {ability.GetName()} foi cancelada.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
				break;
			elseif (event == ABILITY_EVENT_ID::REFRESH)
				Message($"Habilidade {ability.GetName()} renovada.", Color(SYSTEM_COLOR::INFO)).SendSys(who.GetObjRef());
			else
				Message($"Habilidade {ability.GetName()} terminou.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
			endif
			
			break;
		endif
	endwhile

	who.DeactivateAbility(ability);
endprogram
