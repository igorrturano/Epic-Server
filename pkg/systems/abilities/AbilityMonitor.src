use uo;
use os;

include ":message:model/Message";
include ":abilities:controllers/AbilityMonitor";
include ":abilities:AbilityRegistry";
include ":abilities:models/Ability";
include ":attributes:attributes";
include ":hotbar:include/cooldown_packet";

program AbilityMonitor(params)
	var who := params[1]; // MobileWrapper
	var monitor := params[2]; // AbilityMonitor

	if (who.IsDead())
		Message("Você não pode usar esta habilidade enquanto estiver morto.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return;
	endif

	monitor.SetPid(GetPid());
	var abilityId := monitor.GetAbilityId();
	var archetype := GetAbilityArchetype(abilityId);
	var executorScript := $"{ABILITY_PKG}AbilityExecutor{archetype}";

	SetScriptController(who.GetObjRef());

	// Query executor metadata only (does not run ability activation).
	var shouldRunAsyncOnUse := run_script_to_completion(executorScript,
		array{"query_is_on_use", abilityId});

	if (shouldRunAsyncOnUse)
		// ON_USE with targeting must run asynchronously to preserve client interaction.
		run_script(executorScript, array{"activate_async", abilityId, who, monitor});
		return;
	endif

	// Phase 1: Activate (delegates to executor)
	var result := run_script_to_completion(executorScript,
		array{"activate", abilityId, who, monitor});
	if (result.hasError)
		Message(result.errorMsg, Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		var ability := Ability(abilityId);
		var mobileRef := who.GetObjRef();
		EraseObjProperty(mobileRef, $"AbilityCooldown_{abilityId}");
		SendCooldownPacket(mobileRef, ability.GetName(), 0, ability.GetIcon(), COOLDOWN_TYPE_ABILITY);
		if (ability.GetCostSTAM() > 0)
			who.RestoreStamina(ability.GetCostSTAM());
		endif
		if (ability.GetCostMANA() > 0)
			who.RestoreMana(ability.GetCostMANA());
		endif
		if (ability.GetCostHP() > 0)
			who.RestoreHP(ability.GetCostHP());
		endif
		return;
	endif

	// Phase 2: Event loop (no ability instance needed)
	var duration := result.duration;
	var abilityName := result.name;
	Message($"Habilidade {abilityName} ativada por {duration}s.", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who.GetObjRef());

	var endTime := POLCore().systime + duration;
	var remainingTime := duration;

	while (remainingTime > 0)
		var event := Wait_For_Event(remainingTime);

		if (event == ABILITY_EVENT_ID::ABORT)
			Message($"Habilidade {abilityName} foi cancelada.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
			break;
		elseif (event == ABILITY_EVENT_ID::COMPLETE)
			break;
		elseif (event == ABILITY_EVENT_ID::REFRESH)
			Message($"Habilidade {abilityName} renovada.", Color(SYSTEM_COLOR::INFO)).SendSys(who.GetObjRef());
			endTime := POLCore().systime + duration;
		elseif (!event)
			break;
		endif

		remainingTime := endTime - POLCore().systime;
	endwhile

	// Phase 3: Deactivate (delegates to executor)
	run_script_to_completion(executorScript,
		array{"deactivate", abilityId, who});
endprogram
