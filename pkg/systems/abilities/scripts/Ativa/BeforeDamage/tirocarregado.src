use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":message:model/Message";
include ":debug:Controller/DebugController";
include ":attributes:attributes";

program tirocarregado(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var ability := Ability(ABILITY_ID::TIRO_CARREGADO);

	// Check if using ranged weapon
	var weapon := attacker.GetEquipBySlot(WEAPON);
	if (weapon.GetAttribute() != RANGED)
		Message("Você precisa estar usando uma arma de longo alcance!", Color(SYSTEM_COLOR::FAIL))
			.SendSys(attacker.GetObjRef());
		return 0;
	endif

	// For Tempo abilities (duration = 0), calculate and send SET_DURATION event
	if (ability.GetDuration() == 0)
		var tactics := attacker.GetSkill(TACTICS);
		var duration := CInt(tactics / 5);
		if (duration < 1)
			duration := 1;
		endif

		var monitor := attacker.GetAbilityMonitor(ability);
		if (monitor is @AbilityMonitor)
			monitor._GetProcess().SendEvent(struct{
				type := ABILITY_EVENT_ID::SET_DURATION,
				value := duration
			});
		endif
	endif

	// Apply effect: add DEX bonus to piercing damage
	var dexBonus := attacker.GetMainDamageModifierBy(DEXTERITY);
	if (dexBonus > 0)
		attackInfo.GetDamage().IncreasePiercingRawDamage(dexBonus);

		DebugMsg(
			attacker.GetObjRef(),
			DEBUG_HAB,
			Message($"[TIRO_CARREGADO] Bônus de dano por DEX: +{dexBonus}", Color(SYSTEM_COLOR::SUCCESS))
		);
	endif
endprogram
