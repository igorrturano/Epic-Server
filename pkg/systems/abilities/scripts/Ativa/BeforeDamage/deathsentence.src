use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":attributes:attributes";

/**
 * Sentença de Morte (Death Sentence) - ABILITY_ID::SENTENCA_DE_MORTE (204)
 *
 * Active Effect (BeforeDamage):
 * - All successful hits are guaranteed criticals for TT/5 seconds
 *
 * Note: The guaranteed critical is handled directly in DamageController's
 * CalculateCriticalChance function for efficiency. This script is mainly
 * for logging and any additional effects.
 */
program deathsentence(attackInfo)
	var attacker := attackInfo.GetAttacker();

	// Set guaranteed critical via modifier - DamageController will check this
	attackInfo.SetCriticalHitChanceMod(100);

	// Calculate duration based on Tactics skill
	var tactics := attacker.GetSkill(TACTICS);
	var ability := Ability(ABILITY_ID::SENTENCA_DE_MORTE);
	ability.SetDuration(CInt(tactics / 5));

	DebugMsg(
		attacker.GetObjRef(),
		DEBUG_HAB,
		Message("[SENTENCA_DE_MORTE] Ativo - críticos garantidos!", Color(SYSTEM_COLOR::SUCCESS))
	);

	return true;
endprogram
