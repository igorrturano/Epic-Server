use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:Controller/DebugController";
include ":attributes:attributes";

/**
 * Sentença de Morte (Death Sentence) - ABILITY_ID::SENTENCA_DE_MORTE (204)
 *
 * BeforeDamage Effect:
 * - All successful hits are guaranteed criticals for TT/5 seconds
 *
 * Script receives: AttackInfo
 */
program deathsentence(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var ability := Ability(ABILITY_ID::SENTENCA_DE_MORTE);

	// For Tempo abilities, calculate and send SET_DURATION event
	// Note: GetDuration() returns uninit for "Tempo" abilities, not 0
	if (!ability.GetDuration())
		var tactics := attacker.GetSkill(TACTICS);
		var duration := CInt(tactics / 5);
		if (duration < 1)
			duration := 1;
		endif

		var monitor := attacker.GetAbilityMonitor(ability);
		if (monitor is @AbilityMonitor)
			monitor._GetProcess().SendEvent(struct{
				type := ABILITY_EVENT_ID::SET_DURATION,
				value := duration
			});
		endif
	endif

	// Force critical hit directly
	attackInfo.GetDamage().SetCritical(true);

	DebugMsg(
		attacker.GetObjRef(),
		DEBUG_HAB,
		Message("[SENTENCA_DE_MORTE] Ativo - críticos garantidos!", Color(SYSTEM_COLOR::SUCCESS))
	);

	return true;
endprogram
