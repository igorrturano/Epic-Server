use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":attributes:attributes";

/**
 * Manobra da Invencibilidade (Invincibility Maneuver) - ABILITY_ID::MANOBRA_DA_INVENCIBILIDADE (304)
 *
 * BeforeHit Effect (as DEFENDER):
 * - Offensive posture: Counter-attack every hit during duration (like CROSSCUT)
 * - Defensive posture: Start defense mode (+25 evasion, position lock)
 *
 * This script is called on each incoming attack while the ability is active.
 * On first hit, it sets the duration and applies initial effects.
 *
 * Script receives: AttackInfo
 */
program manobrainvencibilidade(attackInfo)
	var defender := attackInfo.GetDefender();
	var who := defender.GetObjRef();
	var postura := who.GetProp("Postura");
	var ability := Ability(ABILITY_ID::MANOBRA_DA_INVENCIBILIDADE);
	var monitor := defender.GetAbilityMonitor(ability);

	if (!(monitor is @AbilityMonitor))
		return false;
	endif

	var currentActivation := monitor.ActivationTime;
	var usedActivation := who.GetProp("#invencibilidade_activation");
	var isFirstHit := (usedActivation != currentActivation);

	// First hit: set duration and apply initial effects
	if (isFirstHit)
		who.SetProp("#invencibilidade_activation", currentActivation);

		var parrySkill := CInt(defender.GetSkill(PARRY));
		var duration := CInt(parrySkill / 3);
		if (duration < 1)
			duration := 1;
		endif

		// Send SET_DURATION event for Tempo abilities
		monitor._GetProcess().SendEvent(struct{
			type := ABILITY_EVENT_ID::SET_DURATION,
			value := duration
		});

		if (postura == "Defensiva")
			// Start defense mode (runs in background)
			Start_Script(":abilities:scripts/Ativa/BeforeHit/manobrainvencibilidade_defense", {defender, duration});

			Message("Voce se concentra em uma defesa total.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
			return true;  // Don't counter-attack in defensive
		else
			Message("Voce se prepara para contra-atacar.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
		endif
	endif

	// Offensive posture: counter-attack every hit during duration
	if (postura == "Ofensiva")
		attackInfo.SetCounterAttack(true);

		DebugMsg(
			who,
			DEBUG_HAB,
			Message("[INVENCIBILIDADE] Contra-ataque!", Color(SYSTEM_COLOR::SUCCESS))
		);
	endif

	return true;
endprogram
