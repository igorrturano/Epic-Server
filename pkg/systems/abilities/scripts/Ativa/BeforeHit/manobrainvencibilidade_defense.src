use uo;
use os;

include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";

/**
 * Manobra da Invencibilidade - Defense Mode Helper
 * ABILITY_ID::MANOBRA_DA_INVENCIBILIDADE (304)
 *
 * This script handles the defensive posture effect:
 * - Adds +25 evasion chance modifier
 * - Monitors position - effect ends if player moves
 * - Runs for the specified duration
 *
 * Script receives: array{ MobileWrapper defender, int duration }
 */
program manobrainvencibilidade_defense(params)
	var defender := params[1];
	var duration := params[2];
	var who := defender.GetObjRef();
	var startX := who.x;
	var startY := who.y;

	// Apply evasion bonus
	who.evasionchance_mod := who.evasionchance_mod + 25;
	Message("*defesa total*").SendAbove(who);
	Message("Voce nao pode se movimentar para manter essa habilidade.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

	// Monitor position for duration
	var endTime := ReadGameClock() + duration;
	while (who.connected && ReadGameClock() < endTime)
		// Check if player moved (using OR instead of AND - any movement breaks it)
		if (who.x != startX || who.y != startY)
			Message("Voce se moveu! Defesa total cancelada.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
			break;
		endif
		sleep(1);
	endwhile

	// Remove evasion bonus
	who.evasionchance_mod := who.evasionchance_mod - 25;

	// Only show end message if duration expired (not if moved)
	if (who.x == startX && who.y == startY)
		Message("Sua postura defensiva terminou.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	endif

	return 1;
endprogram
