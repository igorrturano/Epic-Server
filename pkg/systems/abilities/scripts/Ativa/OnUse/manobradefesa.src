use uo;

include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":tn:cooldown";

/**
 * Manobra de Defesa (Defense Maneuver) - ABILITY_ID::MANOBRA_DE_DEFESA (301)
 *
 * OnUse Effect (posture-based):
 * - Offensive posture: Guarantees the next parry (#tempparrybonus = 100)
 * - Defensive posture: Parry bonus for 20 seconds (defesapersistente cooldown)
 *
 * Combat integration:
 * - ParryController reads #tempparrybonus for guaranteed parry
 * - HitController checks "defesapersistente" cooldown for hit_chance reduction
 *
 * Script receives: MobileWrapper (the user)
 */
program manobradefesa(mobile)
	var who := mobile.GetObjRef();
	var postura := who.GetProp("Postura");

	if (postura == "Ofensiva")
		// Guarantee next parry
		who.SetProp("#tempparrybonus", 100);
		SetCooldown(who, "parrydelay", 0);
		Message("Voce defendera o proximo golpe.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	elseif (postura == "Defensiva")
		// Persistent defense bonus
		SetCooldown(who, "defesapersistente", 20);
		Message("Firme, escudeiro! Sua defesa persistira.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	else
		// No posture set - default message
		Message("Defina sua postura primeiro (.postura ofensiva ou .postura defensiva).", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return 0;
	endif

	return 1;
endprogram
