use uo;
use os;

/**
 * Campeao Divino - Cleanup Helper
 *
 * Handles wing removal and back item restoration after duration expires.
 * Called by campeaodivino.src.
 *
 * Script receives: array{ who, wings_serial, stored_item_serial, duration }
 */
program campeaodivino_cleanup(params)
	var who := params[1];
	var wings_serial := params[2];
	var stored_item_serial := params[3];
	var duration := params[4];

	sleep(duration);

	// Find the wings by serial
	var wings := SystemFindObjectBySerial(wings_serial);

	// Clean up wings
	if (wings)
		MoveItemToContainer(wings, who.backpack);
		DestroyItem(wings);
	endif

	// Re-equip original back item if it existed
	if (stored_item_serial)
		var stored_item := SystemFindObjectBySerial(stored_item_serial);
		if (stored_item)
			EquipItem(who, stored_item);
		endif
	endif

	return 1;
endprogram
