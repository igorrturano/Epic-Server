use uo;

include ":attributes:attributes";
include ":message:model/Message";
include ":wrappers:Objects/Model/MobileWrapper";

program disparomultiplo(mobile)
	// V2: Accept MobileWrapper, get raw object for legacy functions
	var who := mobile.GetObjRef();
	var shot_rounds := CInt(AP_GetTrueSkill(who, TACTICS) / 40);

	// Validate ranged weapon using wrapper
	var weapon := mobile.GetEquipBySlot(WEAPON);
	if (weapon && weapon.GetAttribute() == "Ranged")
		Message("Seus dedos deslizam pelo arco", Color(SYSTEM_COLOR::INFO)).SendSys(who);
		for i := 0 to shot_rounds
			who.attack_once();
		endfor
	else
		Message("Você não pode usar essa habilidade com essa arma", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
	endif
endprogram
