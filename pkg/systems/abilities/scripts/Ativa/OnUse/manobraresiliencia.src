use uo;

include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":tn:cooldown";
include ":timedScripts:timedScripts";

/**
 * Manobra da Resiliencia (Resilience Maneuver) - ABILITY_ID::MANOBRA_DA_RESILIENCIA (303)
 *
 * OnUse Effect (posture-based):
 * - Offensive posture: Immune to crits/stuns for PARRY/3 seconds
 *   (Sets cooldown "vitalidadeinabalavel" - checked in DamageController)
 * - Defensive posture: HP regeneration over time
 *   (Starts timer "recuperacaoaligera" for 60 seconds)
 *
 * Combat integration:
 * - DamageController checks "vitalidadeinabalavel" to prevent critical hits
 *
 * Script receives: MobileWrapper (the user)
 */
program manobraresiliencia(mobile)
	var who := mobile.GetObjRef();
	var postura := who.GetProp("Postura");
	var parrySkill := CInt(mobile.GetSkill(PARRY));

	if (postura == "Ofensiva")
		// Immune to crits/stuns
		var duration := CInt(parrySkill / 3);
		if (duration < 1)
			duration := 1;
		endif

		SetCooldown(who, "vitalidadeinabalavel", duration);
		Message("Seu jogo de defesas eh impecavel.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

	elseif (postura == "Defensiva")
		// HP regeneration over time
		TS_StartTimer(who, "recuperacaoaligera", 60);
		Message("Voce se motiva a continuar o combate.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

	else
		Message("Defina sua postura primeiro (.postura ofensiva ou .postura defensiva).", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return 0;
	endif

	return 1;
endprogram
