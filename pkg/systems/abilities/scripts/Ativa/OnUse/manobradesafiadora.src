use uo;

include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":tn:cooldown";

/**
 * Manobra Desafiadora (Challenging Maneuver) - ABILITY_ID::MANOBRA_DESAFIADORA (302)
 *
 * OnUse Effect:
 * - Activates the ability via AbilityMonitor
 * - Shows activation message based on posture
 * - The actual shield bash (offensive) or disarm (defensive) happens
 *   in the OnParry passive script when the defender parries
 *
 * Posture effects (triggered in manobradesafiadora_parry.src):
 * - Offensive: Shield bash + paralysis for PARRY/10 seconds
 * - Defensive: Disarm attacker (like halfsword_disarm)
 *
 * Script receives: MobileWrapper (the user)
 */
program manobradesafiadora(mobile)
	var who := mobile.GetObjRef();
	var postura := who.GetProp("Postura");

	if (postura == "Ofensiva")
		Message("Sua proxima defesa sera gloriosa.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	elseif (postura == "Defensiva")
		Message("Sua proxima defesa sera surpreendente.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	else
		Message("Defina sua postura primeiro (.postura ofensiva ou .postura defensiva).", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return 0;
	endif

	return 1;
endprogram
