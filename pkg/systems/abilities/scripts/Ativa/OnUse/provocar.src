use uo;

include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":tn:cooldown";
include "include/eventID";
/**
 * Provocar (Taunt) - ABILITY_ID::PROVOCAR (300)
 *
 * OnUse Effect:
 * - Taunts nearby NPCs within 8 tiles to attack the player
 * - Duration based on PARRY skill (skill/2 seconds)
 * - Sets cooldown "resistenciaheroica" which gives evasion bonus vs multiple hostiles
 *
 * Combat integration: HitController checks "resistenciaheroica" cooldown
 * to reduce hit_chance when multiple hostiles are nearby.
 *
 * Script receives: MobileWrapper (the user)
 */
program provocar(mobile)
	var who := mobile.GetObjRef();

	// Visual/audio feedback
	PrintTextAbove(who, "*urra*");
	case (who.graphic)
		401:  PlaySoundEffect(who, 0x339);
		400:  PlaySoundEffect(who, 0x44B);
		1828: PlaySoundEffect(who, 0x44B);
		1829: PlaySoundEffect(who, 0x339);
		1830: PlaySoundEffect(who, 0x44B);
		1831: PlaySoundEffect(who, 0x339);
		1832: PlaySoundEffect(who, 0x44B);
		1833: PlaySoundEffect(who, 0x339);
		1834: PlaySoundEffect(who, 0x44B);
		1835: PlaySoundEffect(who, 0x339);
	endcase
	PerformAction(who, HUMAN_ANIM::HIT);

	// Find nearby mobiles
	var nearby := ListMobilesNearLocation(who.x, who.y, who.z, 8, who.realm);
	var taunt_duration := CInt(mobile.GetSkill(PARRY) / 2);
	if (taunt_duration < 1)
		taunt_duration := 1;
	endif

	var i := 0;
	var taunted := array{};

	foreach char in nearby
		// Skip the caster themselves
		if (char == who)
			continue;
		endif

		// Skip players
		if (char.acctname)
			continue;
		endif

		// Skip if dead, hidden, or concealed
		if (char.dead || char.hidden || char.concealed)
			continue;
		endif

		// Skip if has noattack property
		if (GetObjProperty(char, "noattack"))
			continue;
		endif

		// Skip if no line of sight
		if (!CheckLineOfSight(who, char))
			continue;
		endif

		// Skip if already taunted
		if (GetCooldown(char, "taunted"))
			continue;
		endif

		taunted.append(char);
		i += 1;
	endforeach

	// Apply taunt to all valid targets
	foreach char in taunted
		var event := struct{ "type" := EVID_TAUNT, "source" := who };
		SendEvent(char, event);

		SetCooldown(char, "taunted", taunt_duration);
		SetObjProperty(char, "#taunter", who.serial);
	endforeach

	Message($"Voce provocou {i} adversarios, por {taunt_duration} segundos.", Color(SYSTEM_COLOR::INFO)).SendSys(who);

	sleep(2);
	SetCooldown(who, "resistenciaheroica", CInt(mobile.GetSkill(PARRY) / 5));

	return 1;
endprogram
