use uo;
use util;

include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include "include/client";
include "include/sounds";

/**
 * Prisão Dimensional (Dimensional Prison) - ABILITY_ID::PRISAO_DIMENSIONAL (2203)
 *
 * OnUse Effect:
 * - Teleport a target to a dimensional prison for arcana/5 seconds
 * - Then return them to their original position
 *
 * Script receives: MobileWrapper (the user)
 */
program aprisionar(who)
	var mobile := who.GetObjRef();

	Message("Escolha quem você deseja aprisionar.", Color(SYSTEM_COLOR::INFO)).SendSys(mobile);

	var targ := Target(mobile);

	// NPC behavior - target random nearby hostile
	if (who.IsNPC())
		targ := GetRandomNearbyHostile(mobile);
	endif

	if (!targ)
		Message("Alvo Cancelado.", Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif

	if (!targ.isA(POLCLASS_MOBILE))
		Message("Alvo Inválido.", Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif

	var dist := Distance(mobile, targ);
	var mlore := CInt(who.GetSkill(ARCANA));
	var maxRange := CInt(mlore / 5);

	if (dist > maxRange)
		Message($"O alvo está muito distante. Range máximo: {maxRange} tiles.", Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif

	PerformAction(mobile, HUMAN_ANIM::CAST_DIR);
	sleep(2);

	var globe := 0x6E19;
	var hell_gate := 0x6D1D;

	// Store original position
	var origX := targ.x;
	var origY := targ.y;
	var origZ := targ.z;
	var origRealm := targ.realm;

	// Freeze and show effect
	targ.frozen := 1;
	PlayStationaryEffect(targ.x, targ.y, targ.z, globe, 0, 40, 0, mobile.realm);
	sleep(2);

	// Calculate prison duration
	var duration := CInt(mlore / 5);
	if (duration < 2)
		duration := 2;
	endif
	if (duration > 30)
		duration := 30;
	endif

	// Teleport to prison dimension
	MoveObjectToLocation(targ, 5934, 2411, 40, "britannia", MOVEOBJECT_FORCELOCATION);

	Message($"*aprisiona {targ.name} na dimensão por {duration}s*").SendAbove(mobile);
	Message("*você foi aprisionado em outra dimensão!*", Color(SYSTEM_COLOR::FAIL)).SendAbove(targ);

	sleep(duration);

	// Return from prison
	targ.concealed := 1;
	PlayStationaryEffect(origX, origY, origZ, hell_gate, 200, 25, 0, origRealm);
	MoveObjectToLocation(targ, origX, origY, origZ, origRealm, MOVEOBJECT_FORCELOCATION);
	sleep(2);

	targ.concealed := 0;
	targ.frozen := 0;
	PlaySoundEffect(targ, 0x1f2);

	Message("*você foi libertado da prisão dimensional*", Color(SYSTEM_COLOR::SUCCESS)).SendAbove(targ);

	return 1;
endprogram