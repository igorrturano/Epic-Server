use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:Controller/DebugController";
include ":attributes:attributes";

/**
 * Contra-Empunhadura (Halfsword) - ABILITY_ID::HALFSWORD (200)
 *
 * OnHit Effect (as ATTACKER):
 * - Add double STR bonus to damage for TT/5 seconds
 *
 * Passive Effect (as DEFENDER with HasAbility check):
 * - On successful parry, disarm attacker for TT/5 seconds
 *
 * Script receives: AttackInfo
 */
program halfsword(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var ability := Ability(ABILITY_ID::HALFSWORD);

	// For Tempo abilities (duration = 0), calculate and send SET_DURATION event
	if (ability.GetDuration() == 0)
		var tactics := attacker.GetSkill(TACTICS);
		var duration := CInt(tactics / 5);
		if (duration < 1)
			duration := 1;
		endif

		var monitor := attacker.GetAbilityMonitor(ability);
		if (monitor is @AbilityMonitor)
			monitor._GetProcess().SendEvent(struct{
				type := ABILITY_EVENT_ID::SET_DURATION,
				value := duration
			});
		endif
	endif

	// Add STR bonus to damage (double STR per description)
	var strBonus := attacker.GetMainDamageModifierBy(STRENGTH) * 2;
	if (strBonus > 0)
		attackInfo.GetDamage()
			.IncreaseSlashRawDamage(strBonus)
			.IncreasePiercingRawDamage(strBonus)
			.IncreaseBluntRawDamage(strBonus);

		DebugMsg(
			attacker.GetObjRef(),
			DEBUG_HAB,
			Message($"[HALFSWORD] Bônus de dano por STR x2: +{strBonus}", Color(SYSTEM_COLOR::SUCCESS))
		);
	endif

	// Passive disarm effect: if defender has ability and parried
	if (attackInfo.Parried() && attackInfo.GetDefender().HasAbility(ABILITY_ID::HALFSWORD))
		DisarmAttackerWeapon(attackInfo);
	endif

	return 1;
endprogram

/**
 * DisarmAttackerWeapon
 *
 * When the defender successfully parries using halfsword technique,
 * they can disarm the attacker's weapon by leveraging the blade grip
 */
function DisarmAttackerWeapon(byref attackInfo)
	var attackerWeapon := attackInfo.GetAttacker().GetEquipBySlot(WEAPON);
	var tactics_bonus := CInt(AP_GetSkill(attackInfo.GetDefender().GetObjRef(), TACTICS) / 5);

	if (!attackerWeapon || !attackerWeapon.GetObjRef())
		return false;
	endif

	// Don't disarm unarmed combat (fists)
	if (attackerWeapon.GetCategory() == WEAPON_CATEGORY::UNARMED)
		return false;
	endif

	// Determine where to drop the weapon
	var attackerPos := attackInfo.GetAttacker().GetPosition();
	var dropX := attackerPos.GetX() + RandomIntMinMax(-1, 1);
	var dropY := attackerPos.GetY() + RandomIntMinMax(-1, 1);
	var dropZ := GetWorldHeight(dropX, dropY);

	// Move weapon to ground
	if (MoveObjectToLocation(
		attackerWeapon.GetObjRef(),
		dropX,
		dropY,
		dropZ,
		attackerPos.GetRealm(),
		MOVEOBJECT_FORCELOCATION
	))
        TS_StartTimer(attackInfo.GetAttacker().GetObjRef(), "desarmar", tactics_bonus, 0, attackInfo.GetDefender().GetObjRef());
		Message("*sua arma foi desarmada pela técnica de contra-empunhadura!*")
			.SendAbove(attackInfo.GetAttacker().GetObjRef());

		Message("*desarma a arma do oponente com técnica de contra-empunhadura!*")
			.SendAbove(attackInfo.GetDefender().GetObjRef());

		DebugMsg(
			attackInfo.GetDefender().GetObjRef(),
			DEBUG_HAB,
			Message($"Possui Habilidade[{ABILITY_ID::HALFSWORD}]: Desarme bem-sucedido!", Color(SYSTEM_COLOR::SUCCESS))
		);

		return true;
	endif

	return false;
endfunction
