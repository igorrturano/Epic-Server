use uo;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";

/**
 * Carnificina - Chain Activation Ultimate
 * ABILITY_ID::CARNIFICINA (504)
 *
 * OnKill: Each kill activates/refreshes abilities 500, 501, 502 for 20 seconds.
 * Keeps the chain going as long as you keep killing.
 */
program carnificina(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var who := attacker.GetObjRef();

	// Activate/refresh the three combat abilities for 20 seconds
	var abilitiesToActivate := array{
		ABILITY_ID::FURIA_DO_DESERTO,
		ABILITY_ID::SANGUE_POR_SANGUE,
		ABILITY_ID::MARCA_DA_PRESA
	};

	foreach abilityId in (abilitiesToActivate)
		var ability := Ability(abilityId);
		ability.SetDuration(20);
		AbilityMonitor(ability).ActivateOn(attacker);
	endforeach

	Message("*CARNIFICINA!*").SendAbove(who);
	PlaySoundEffect(who, 0x1F7);
	PlayObjectCenteredEffect(who, 0x3728, 1, 13);

	return true;
endprogram
