use uo;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":attributes:vitals";

/**
 * Sangue por Sangue - Lifesteal Effect
 * ABILITY_ID::SANGUE_POR_SANGUE (501)
 *
 * AfterDamage: Heal 50% of damage dealt.
 * Duration: Survival/2 seconds (set on first trigger)
 */
program sangueporsangue(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var who := attacker.GetObjRef();
	var ability := Ability(ABILITY_ID::SANGUE_POR_SANGUE);

	// Set duration on first trigger
	var monitor := attacker.GetAbilityMonitor(ability);
	if (monitor is @AbilityMonitor)
		if (!ability.GetDuration())
			var survival := attacker.GetSkill(SURVIVAL);
			var duration := CInt(survival / 2);
			if (duration < 5)
				duration := 5;
			endif
			monitor._GetProcess().SendEvent(struct{
				type := ABILITY_EVENT_ID::SET_DURATION,
				value := duration
			});
			Message("*SANGUE POR SANGUE!*").SendAbove(who);
		endif
	endif

	// Calculate heal amount (50% of damage dealt)
	var totalDamage := attackInfo.GetDamage();
	var healAmount := CInt(totalDamage / 2);

	if (healAmount <= 0)
		return false;
	endif

	// Heal the attacker
	HealHits(who, healAmount);

	return true;
endprogram
