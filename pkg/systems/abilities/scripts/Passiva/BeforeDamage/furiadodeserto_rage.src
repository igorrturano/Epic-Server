use uo;

include ":combat:Model/AttackInfo";
include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":attributes:attributes";
include ":charactercreation:include/habilidades";

/**
 * Fúria do Deserto - Passive Rage Bonus
 * ABILITY_ID::FURIA_DO_DESERTO (500)
 *
 * Passive BeforeDamage: When IsRaging (low HP), add +Survival/20 damage.
 * No activation needed - triggers automatically when player has ability.
 */
program furiadodeserto_rage(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var who := attacker.GetObjRef();

	// Check if raging (low HP)
	if (!IsRaging(who))
		return false;
	endif

	// Calculate bonus damage
	var survival := attacker.GetSkill(SURVIVAL);
	var bonus := CInt(survival / 20);

	if (bonus <= 0)
		return false;
	endif

	// Add bonus to all damage types
	attackInfo.GetDamage()
		.IncreaseSlashRawDamage(bonus)
		.IncreasePiercingRawDamage(bonus)
		.IncreaseBluntRawDamage(bonus);

	Message("*enfurecido*").SendAbove(who);

	return true;
endprogram
