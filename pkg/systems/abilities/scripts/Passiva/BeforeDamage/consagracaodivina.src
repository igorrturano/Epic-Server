use uo;

include ":combat:Model/AttackInfo";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":attributes:attributes";

/**
 * Consagracao Divina - Passive BeforeDamage Effect
 * ABILITY_ID::CONSAGRACAO_DIVINA (400)
 *
 * Triggers when a paladin with this ability attacks an Undead NPC.
 * Adds bonus divine damage equal to Theology/20.
 *
 * Script receives: AttackInfo
 */
program consagracaodivina(attackInfo)
	var attacker := attackInfo.GetAttacker();
	var defender := attackInfo.GetDefender();

	// Check if defender is an NPC
	if (!defender.IsNPC())
		return false;
	endif

	// Check if defender is Undead category
	if (Lower(defender.Category) != "undead")
		return false;
	endif

	// Apply Theology/20 bonus damage
	var theology := attacker.GetSkill(THEOLOGY);
	var bonusDamage := CInt(theology / 20);

	if (bonusDamage > 0)
		attackInfo.GetDamage()
		.IncreaseBluntRawDamage(bonusDamage)
		.IncreasePiercingRawDamage(bonusDamage)
		.IncreaseSlashRawDamage(bonusDamage);

		DebugMsg(
			attacker.GetObjRef(),
			DEBUG_HAB,
			Message($"[CONSAGRACAO] Dano vs Undead: +{bonusDamage}", Color(SYSTEM_COLOR::SUCCESS))
		);
	endif

	return true;
endprogram
