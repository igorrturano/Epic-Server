use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":abilities:controllers/AbilityMonitor";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":wrappers:include/Objects/Model/WeaponWrapper";
include ":message:model/Message";
include ":timedScripts:timedScripts";
include ":tn:cooldown";
include ":attributes:attributes";

/**
 * Manobra Desafiadora (Challenging Maneuver) - Passive OnParry Effect
 * ABILITY_ID::MANOBRA_DESAFIADORA (302)
 *
 * Triggers when defender with this ability successfully parries.
 * IMPORTANT: Only triggers when ability is ACTIVATED, not just when player has it.
 *
 * Posture-based effects:
 * - Offensive: Shield bash + paralysis for PARRY/10 seconds
 * - Defensive: Disarm attacker (like halfsword_disarm)
 */
program manobradesafiadora_parry(attackInfo)
	var defender := attackInfo.GetDefender();
	var ability := Ability(ABILITY_ID::MANOBRA_DESAFIADORA);

	// IMPORTANT: Only trigger when ability is ACTIVATED, not just when player has it
	var monitor := defender.GetAbilityMonitor(ability);
	if (!(monitor is @AbilityMonitor))
		return false;  // Ability not active - skip effect
	endif

	var who := defender.GetObjRef();
	var postura := who.GetProp("Postura");
	var parrySkill := CInt(defender.GetSkill(PARRY));

	if (postura == "Ofensiva")
		// Shield bash + stun
		var stunDuration := CInt(parrySkill / 10);
		if (stunDuration < 1)
			stunDuration := 1;
		endif

		TS_StartTimer(attackInfo.GetAttacker().GetObjRef(), "paralysis", stunDuration);

		Message("*golpeia com o escudo!*").SendAbove(who);
		Message("*é atordoado pelo golpe de escudo!*", Color(SYSTEM_COLOR::FAIL))
			.SendAbove(attackInfo.GetAttacker().GetObjRef());

	elseif (postura == "Defensiva")
		// Disarm attacker (similar to halfsword_disarm)
		var attackerWeapon := attackInfo.GetAttacker().GetEquipBySlot(WEAPON);

		if (!attackerWeapon || !attackerWeapon.GetObjRef())
			return false;
		endif

		// Don't disarm unarmed combat (fists)
		if (attackerWeapon.GetCategory() == WEAPON_CATEGORY::UNARMED)
			return false;
		endif

		// Calculate disarm timer based on defender's parry
		var disarmDuration := CInt(parrySkill / 10);
		if (disarmDuration < 1)
			disarmDuration := 1;
		endif

		// Determine where to drop the weapon (near attacker)
		var attackerPos := attackInfo.GetAttacker().GetPosition();
		var dropX := attackerPos.GetX() + RandomIntMinMax(-1, 1);
		var dropY := attackerPos.GetY() + RandomIntMinMax(-1, 1);
		var dropZ := GetWorldHeight(dropX, dropY);

		// Move attacker's weapon to ground
		if (MoveObjectToLocation(
			attackerWeapon.GetObjRef(),
			dropX,
			dropY,
			dropZ,
			attackerPos.GetRealm(),
			MOVEOBJECT_FORCELOCATION
		))
			TS_StartTimer(attackInfo.GetAttacker().GetObjRef(), "desarmar", disarmDuration, 0, who);

			Message("*desarma o oponente com uma manobra desafiadora!*")
				.SendAbove(who);

			Message("*sua arma foi desarmada!*", Color(SYSTEM_COLOR::FAIL))
				.SendAbove(attackInfo.GetAttacker().GetObjRef());
		endif
	endif

	// Consume the ability after use (single use per activation)
	monitor._GetProcess().SendEvent(ABILITY_EVENT_ID::ABORT);

	return true;
endprogram
