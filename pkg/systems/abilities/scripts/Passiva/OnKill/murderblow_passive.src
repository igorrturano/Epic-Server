use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":attributes:attributes";

/**
 * Golpe Mortal (Murder Blow) - Passive Effect
 * ABILITY_ID::GOLPE_MORTAL (201)
 *
 * When killing an opponent, immediately attack another nearby enemy.
 *
 * Note: This script is called by _ExecutePassiveAbilities which already
 * verified the player HAS this ability, so no HasAbility check needed.
 */
program murderblow_passive(attackInfo)
	print("[MURDERBLOW] Passive script started!");
	AttackNearbyEnemyOnKill(attackInfo);

	return true;
endprogram

/**
 * AttackNearbyEnemyOnKill
 *
 * Find and attack a nearby hostile enemy after killing the current target
 */
function AttackNearbyEnemyOnKill(byref attackInfo)
	// Find nearby hostile targets within 2 tiles with line of sight
	var hostileList := array{};
	var nearbyHostiles := ListHostiles(attackInfo.GetAttacker().GetObjRef(), 2, LH_FLAG_LOS);

	foreach mobile in (nearbyHostiles)
		// Don't attack self or the just-killed defender
		if ((mobile.serial != attackInfo.GetAttacker().GetSerial()) &&
		    (mobile.serial != attackInfo.GetDefender().GetSerial()) &&
		    (GetVital(mobile, HITS) > 0))
			hostileList.append(mobile);
		endif
	endforeach

	// If there are nearby enemies, attack one
	if (hostileList.size() > 0)
		// Pick a random target from the list
		var nextTarget := hostileList[RandomInt(hostileList.size()) + 1];
		nextTarget := MobileWrapper(nextTarget);

		Message("*executa o oponente e ataca outro inimigo!*")
			.SendAbove(attackInfo.GetAttacker().GetObjRef());

		// Attack the next target
		attackInfo.GetAttacker().Attack(nextTarget);

		DebugMsg(
			attackInfo.GetAttacker().GetObjRef(),
			DEBUG_HAB,
			Message($"[GOLPE_MORTAL] Passivo: Atacou inimigo próximo!", Color(SYSTEM_COLOR::SUCCESS))
		);

		return true;
	endif

	return false;
endfunction
