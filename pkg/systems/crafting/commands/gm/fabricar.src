use uo;

include ":crafting:fabricaComplexos";

program fabricarItem(quem, texto)
	var entrada := SplitWords(texto);
	if(entrada.size() > 0)
		if(UPPER(entrada[1]) == "COMPLEXOS")
			if(UPPER(entrada[2]) == "BS")
				FabricaItensComplexos(quem, "Blacksmithy", true);
			elseif(UPPER(entrada[2]) == "DW")
				FabricaItensComplexos(quem, "Tailoring", true);
			elseif(UPPER(entrada[2]) == "CA")
				FabricaItensComplexos(quem, "Carpentry", true);
			elseif(UPPER(entrada[2]) == "TK")
				FabricaItensComplexos(quem, "Tinkering", true);
			elseif(UPPER(entrada[2]) == "AL")
				FabricaItensComplexos(quem, "Alchemy", true);
			elseif(UPPER(entrada[2]) == "FL")
				FabricaItensComplexos(quem, "BowcraftFletching", true);
			else
				SendSysMessageEX(quem, "parametros possiveis para complexos:", SSM_INFO);
				SendSysMessageEX(quem, "bs para Blacksmithy", SSM_INFO);
				SendSysMessageEX(quem, "dw para tailoring", SSM_INFO);
				SendSysMessageEX(quem, "ca para carpentry", SSM_INFO);
				SendSysMessageEX(quem, "tk para tinkering", SSM_INFO);
				SendSysMessageEX(quem, "al para alchemy", SSM_INFO);
				SendSysMessageEX(quem, "fl para fletching", SSM_INFO);
			endif
		else
			SendSysMessageEX(quem, "parametros possiveis [complexos <opcoes>]", SSM_INFO);
		endif

	else
		SendSysMessageEX(quem, "parametros possiveis [complexos <opcoes>]", SSM_INFO);
	endif

endprogram