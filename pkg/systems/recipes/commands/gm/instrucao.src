// GM command to create a craft recipe scroll with a specific recipe.
// Usage: .instrucao listar
//        .instrucao <recipeName>
// Defaults to MetalWork scroll type; the correct level is derived from the recipe config.
use uo;
use util;
use cfgfile;

include ":recipes:include/scrollRecipes";

program instrucao(who, nome)
    if (who.cmdlevel <= 1)
        return 0;
    endif

    if (!nome)
        SendSysMessage(who, "Usos validos:");
        SendSysMessage(who, ".instrucao listar");
        SendSysMessage(who, ".instrucao <nomedoitem>");
        return 0;
    endif

    var cfg := ReadConfigFile(":recipes:recipes");

    if (nome == "listar")
        var opcoes := "";
        foreach key in (GetConfigStringKeys(cfg))
            opcoes := opcoes + key + "\n";
        endforeach

        var gflayout := {
            "NoDispose",
            "GumpPic 0 0 1249",
            "text 50 50 0 0",
            "HtmlGump 50 70 300 220 1 0 1"
        };
        var gfdata := { "Instrucoes de Fabricacao: ", opcoes };
        SendDialogGump(who, gflayout, gfdata);
        return 0;
    endif

    foreach key in (GetConfigStringKeys(cfg))
        if (key == nome)
            var elem := FindConfigElem(cfg, key);
            var level := GetConfigInt(elem, "level");
            if (!level) level := 1; endif
            // Creates a MetalWork scroll of the correct level; CreateScript assigns a random recipe,
            // then we override with the specific requested recipe name.
            var item := CreateItemInBackpack(who, GetScrollObjtype("MW", level), 1);
            SetObjProperty(item, "recipe", key);
            return 1;
        endif
    endforeach

    SendSysMessage(who, "Instrucao nao encontrada.");
    return 0;
endprogram
