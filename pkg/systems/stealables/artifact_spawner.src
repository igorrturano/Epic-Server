/*
 * artifact_spawner.src
 * 
 * Script de gerenciamento de respawn de artefatos roubáveis
 * 
 * Este script é executado continuamente e gerencia o ciclo de vida de um artefato:
 * 1. Verifica se o artefato atual existe
 * 2. Se não existir ou foi roubado, aguarda o tempo de respawn baseado na raridade
 * 3. Spawna um novo artefato na localização do spawner
 */

use uo;
use os;

include "include/say";
include ":stealables:stealables";
include ":traps:traps";

program artifact_spawner(params)
	var spawner := params[1];
	
	if (!spawner)
		return 0;
	endif
	
	// Registra o processo para evitar duplicação
	SetObjProperty(spawner, "SpawnerPid", GetPid());
	
	var rarity := CInt(GetObjProperty(spawner, "Rarity"));
	var objtype := CInt(GetObjProperty(spawner, "ArtifactObjtype"));
	var artifact_color := GetObjProperty(spawner, "ArtifactColor");
	var artifact_name := GetObjProperty(spawner, "ArtifactName");
	var artifact_desc := GetObjProperty(spawner, "ArtifactDesc");
	
	if (!rarity || !objtype)
		return 0;
	endif
	
	while (spawner)
		var current_artifact := GetCurrentArtifact(spawner);
		
		// Se o artefato não existe, precisa spawnar um novo
		if (!current_artifact)
			// Verifica se está em cooldown
			var next_spawn_time := CInt(GetObjProperty(spawner, "NextSpawnTime"));
			
			if (next_spawn_time && next_spawn_time > ReadGameClock())
				// Ainda em cooldown, aguarda
				var wait_seconds := next_spawn_time - ReadGameClock();
				
				// Aguarda em chunks de 60 segundos para não bloquear muito tempo
				while (wait_seconds > 0 && spawner)
					var sleep_time := 60;
					if (wait_seconds < 60)
						sleep_time := wait_seconds;
					endif
					
					Sleep(sleep_time);
					wait_seconds := next_spawn_time - ReadGameClock();
				endwhile
				
				// Limpa a propriedade de cooldown
				EraseObjProperty(spawner, "NextSpawnTime");
			endif
			
			// Spawna o artefato
			SpawnArtifact(spawner, objtype, artifact_color, artifact_name, artifact_desc, rarity);
		endif
		
		// Aguarda 60 segundos antes de verificar novamente
		Sleep(60);
	endwhile
	
	return 1;
endprogram

/*
 * GetCurrentArtifact(spawner)
 * 
 * Retorna o artefato atual vinculado ao spawner, se existir
 */
function GetCurrentArtifact(spawner)
	var artifact_serial := GetObjProperty(spawner, "CurrentArtifactSerial");
	
	if (!artifact_serial)
		return 0;
	endif
	
	var artifact := SystemFindObjectBySerial(artifact_serial);
	
	// Se o artefato não existe mais, limpa a propriedade
	if (!artifact)
		EraseObjProperty(spawner, "CurrentArtifactSerial");
		return 0;
	endif
	
	return artifact;
endfunction

/*
 * SpawnArtifact(spawner, objtype, color, name, desc, rarity)
 * 
 * Cria um novo artefato na localização do spawner
 */
function SpawnArtifact(spawner, objtype, color, name, desc, rarity)
	var artifact := CreateItemAtLocation(spawner.x, spawner.y, spawner.z, objtype, 1, spawner.realm);
	
	if (!artifact)
		return 0;
	endif
	
	// Configura o artefato
	if (color)
		artifact.color := color;
	endif
	
	if (name)
		artifact.name := name;
	endif
	
	if (desc)
		artifact.desc := desc;
	endif
	
	// Marca como artefato roubável
	SetObjProperty(artifact, "PropStealable", 1);
	SetObjProperty(artifact, "StealableRarity", rarity);
	SetObjProperty(artifact, "StealableSpawnerSerial", spawner.serial);
	
	// Protege o artifact do sistema de destruíveis
	SetObjProperty(artifact, "isIndestrutivel", 1);
	
	// Adiciona armadilha usando o sistema existente
	var trap_enabled := CInt(GetObjProperty(spawner, "TrapEnabled"));
	if (trap_enabled)
		var trap_type := GetObjProperty(spawner, "TrapType");
		var trap_level := CInt(GetObjProperty(spawner, "TrapLevel"));
		
		if (trap_type && trap_level)
			// Mapeia o trap_level configurado pelo GM para o nivel final baseado na raridade
			// Isso permite que armadilhas cresçam em dificuldade junto com a raridade do item
			var final_trap_level := CalculateTrapLevel(rarity, trap_level);
			
			// Define o level do item (necessário para awareness e mechanics)
			SetObjProperty(artifact, "level", final_trap_level);
			
			// Usa AddTrap() do sistema de armadilhas existente
			AddTrap(artifact, trap_type, final_trap_level);
		endif
	endif
	
	// Fixa o item no chão (usando a função do fix.src)
	Fixar(artifact, 1);
	
	// Registra o serial do artefato no spawner
	SetObjProperty(spawner, "CurrentArtifactSerial", artifact.serial);
	
	return artifact;
endfunction

/*
 * Fixar(item, devefixar)
 * 
 * Fixa ou desfixa um item (baseado no fix.src)
 */
function Fixar(byref item, devefixar)
	item.movable := !devefixar;
	return item.movable;
endfunction

/*
 * CalculateTrapLevel(rarity, base_trap_level)
 * 
 * Mapeia a raridade do artefato (1-12) para o nível final da armadilha (1-6)
 * Combina a raridade com o nível base escolhido pelo GM
 * 
 * Lógica:
 * - Raridades 1-2: Trap level 1
 * - Raridades 3-4: Trap level 2
 * - Raridades 5-6: Trap level 3
 * - Raridades 7-8: Trap level 4
 * - Raridades 9-10: Trap level 5
 * - Raridades 11-12: Trap level 6
 * 
 * Mas o GM pode escolher um nível específico (1-5) que serve como modificador
 */
function CalculateTrapLevel(rarity, base_trap_level)
	var rarity_trap_level;
	
	// Mapeia raridade para trap level base
	case (rarity)
		1:
		2:
			rarity_trap_level := 1;
			break;
		3:
		4:
			rarity_trap_level := 2;
			break;
		5:
		6:
			rarity_trap_level := 3;
			break;
		7:
		8:
			rarity_trap_level := 4;
			break;
		9:
		10:
			rarity_trap_level := 5;
			break;
		11:
		12:
			rarity_trap_level := 6;
			break;
		default:
			rarity_trap_level := 3; // Fallback para nível médio
	endcase
	
	// Se o GM escolheu um nível específico de armadilha (1-5),
	// usa o maior entre o nível baseado na raridade e o escolhido
	var final_level := rarity_trap_level;
	if (base_trap_level > 0 && base_trap_level <= 5)
		// Usa o maior dos dois (raridade ou escolha do GM)
		if (base_trap_level > rarity_trap_level)
			final_level := base_trap_level;
		endif
	endif
	
	// Garante que está entre 1 e 6
	if (final_level < 1)
		final_level := 1;
	elseif (final_level > 6)
		final_level := 6;
	endif
	
	return final_level;
endfunction
