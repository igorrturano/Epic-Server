use uo;
use os;

include ":loot:lootParser";
include ":loot:chestPostProcess";
include ":traps:traps";
include ":chestspawn:treasurechest"; // Assuming this contains CreateTreasureChests
include ":chestspawn:include/trancaEspecial";

program EpicChestSpawner(spawner)
	var level := GetObjProperty(spawner, "epic_level");
	var amount := GetObjProperty(spawner, "epic_amount");
	var range_val := GetObjProperty(spawner, "epic_range");
	var chest_type := GetObjProperty(spawner, "epic_chest_type");
	var is_mimic := GetObjProperty(spawner, "epic_is_mimic");
	var mimic_chance := GetObjProperty(spawner, "epic_mimic_chance");
	var is_puzzle := GetObjProperty(spawner, "epic_is_puzzle");
	var puzzle_limit_count := GetObjProperty(spawner, "epic_puzzle_limit_count");
	var is_buried := GetObjProperty(spawner, "epic_is_buried");

	// Baú de tranca especial — defaults para spawners antigos
	var tranca_enabled           := GetPropOrDefault(spawner, "epic_tranca_enabled", 1);
	var tranca_chance            := ClampPct(GetPropOrDefault(spawner, "epic_tranca_chance", DEFAULT_TRANCA_CHANCE), MIN_TRANCA_CHANCE, 100);
	var tranca_mastermind_chance := ClampPct(GetPropOrDefault(spawner, "epic_tranca_mastermind_chance", DEFAULT_TRANCA_MASTERMIND_CHANCE));

	var frq := GetObjProperty(spawner, "duration"); // Duration in seconds

	if (!frq)
		frq := 1800; // Default to 30 min if not set
		SetObjProperty(spawner, "duration", frq);
	endif

	// Initial delay
	sleep(1);

	if (!amount || !level || !range_val || !chest_type)
		print("Epic Chest Spawner " + spawner.serial + " at: " + spawner.x + ", " + spawner.y + " is improperly configured");
		return;
	endif

	while (spawner)
		// Check current chests to see if we need to spawn
		var current_chests := GetObjProperty(spawner, "spawned_epic_chests");
		var needs_respawn := 0; // Default to false
		var missing_chests := 0;
		var opened_chests := 0;

		if (!current_chests)
			needs_respawn := 1; // No chests exist at all
			missing_chests := amount; // Need to spawn all chests
		else
			var active_chests := 0;
			var valid_chests := array{};
			foreach serial in current_chests
				var chest := SystemFindObjectBySerial(CInt(serial));
				if (chest)
					valid_chests.append(serial);
					if (GetObjProperty(chest, "IsBuriedDirt") || chest.locked)
						active_chests += 1;
					else
						opened_chests += 1;
					endif
				else
					missing_chests += 1; // Chest was destroyed
				endif
			endforeach

			// Update the chest list if any were missing or opened
			SetObjProperty(spawner, "spawned_epic_chests", valid_chests);
			current_chests := valid_chests;

			// Need to respawn if we have any missing or opened chests
			if (active_chests < amount)
				needs_respawn := 1;
			endif
		endif

		if (needs_respawn)
			if (missing_chests > 0)
				print("Spawning " + missing_chests + " chests to replace destroyed ones");
			endif
			if (opened_chests > 0)
				print("Spawning " + opened_chests + " chests to replace opened ones");
			endif
			ClearMySpawnedChests(spawner); // Clear opened chests before spawning new ones
			MakeEpicChests(spawner, level, amount, range_val, chest_type, is_mimic, mimic_chance, is_puzzle,
							puzzle_limit_count, is_buried, tranca_enabled, tranca_chance, tranca_mastermind_chance);
		endif

		sleep(frq); // Use the configured frequency for respawn
	endwhile
endprogram

function MakeEpicChests(spawner, level, amount, range_val, chest_type, is_mimic, mimic_chance,
						 is_puzzle, puzzle_limit_count, is_buried := 0,
						 tranca_enabled := 1, tranca_chance := 10, tranca_mastermind_chance := 25)
	var current_chests_serials := GetObjProperty(spawner, "spawned_epic_chests");
	if (!current_chests_serials)
		current_chests_serials := array;
	endif

	// Count and clean up existing chests
	var valid_chests := array;
	var chest_count := 0;
	foreach serial_val in current_chests_serials
		var existing_chest := SystemFindObjectBySerial(CInt(serial_val));
		if (existing_chest)
			valid_chests.append(serial_val);
			chest_count += 1;
		endif
		sleepms(50); // Small delay to prevent server stress
	endforeach

	// Update our tracking list
	current_chests_serials := valid_chests;
	SetObjProperty(spawner, "spawned_epic_chests", current_chests_serials);

	// If we already have the requested amount of chests, don't spawn more
	if (chest_count >= amount)
		return;
	endif

	// Calculate how many new chests we need to spawn
	var new_amount_to_spawn := amount - chest_count;

	var base_lootname := "EpicChest" + level;
	var flavor_suffix := "";
	case (chest_type)
		"Warrior":  flavor_suffix := "_FlavorWarrior"; break;
		"Thief":    flavor_suffix := "_FlavorThief"; break;
		"Artifice": flavor_suffix := "_FlavorArtifice"; break;
		"Mage":     flavor_suffix := "_FlavorMage"; break;
		"Misto":    flavor_suffix := ""; break;
		default:    flavor_suffix := ""; break;
	endcase

	var created_chests_this_cycle := array;
	var puzzle_chests_spawned_this_cycle := 0;

	for i := 1 to new_amount_to_spawn
		var new_x, new_y, new_z;
		var placement_tries := 0;
		var placed := 0;

		while (placement_tries < 30 && !placed)
			new_x := CInt(spawner.x + RandomInt(range_val) - RandomInt(range_val));
			new_y := CInt(spawner.y + RandomInt(range_val) - RandomInt(range_val));

			// Validate location is standable (not inside walls)
			var standing := GetStandingHeight(new_x, new_y, spawner.z, spawner.realm);
			if (standing.errortext)
				placement_tries += 1;
				sleepms(10);
				continue;
			endif
			new_z := standing.z;

			if (len(ListItemsNearLocation(new_x, new_y, new_z, 0, spawner.realm)) == 0)
				// Buried: create only invisible dirt marker, chest is created when dug up
				if (is_buried)
					var dirt := CreateItemAtLocation(new_x, new_y, new_z, 0x0914, 1, spawner.realm);
					if (dirt)
						placed := 1;
						dirt.invisible := 1;
						dirt.movable := 0;
						SetObjProperty(dirt, "IsBuriedDirt", 1);
						SetObjProperty(dirt, "link", spawner.serial);
						SetObjProperty(dirt, "level", level);
						created_chests_this_cycle.append(dirt.serial);
					endif
				else
					// Normal chest creation flow
					var new_chest;
					var chests := array{};

					// Sorteio independente de baú de tranca especial
					var tranca_roll := RandomInt(100);
					var tranca_hit := tranca_enabled && tranca_roll < tranca_chance;
					TrancaDebug("Hook sorteio: enabled=" + tranca_enabled + " roll=" + tranca_roll + " chance=" + tranca_chance + "% -> " + (tranca_hit ? "SIM" : "NAO"));
					if (tranca_hit)
						var tranca_custom_graphics := GetObjProperty(spawner, "epic_chest_graphics");
						new_chest := CreateBauTrancaEspecial(new_x, new_y, new_z, spawner.realm, level, base_lootname, flavor_suffix, tranca_mastermind_chance, tranca_custom_graphics);
					endif

					// Determine what type of chest to create
					if (!new_chest && is_puzzle)
						var current_puzzle_count := CInt(GetObjProperty(spawner, "current_puzzle_count"));
						if (!current_puzzle_count)
							current_puzzle_count := 0;
						endif

						if (puzzle_limit_count == -1 || current_puzzle_count < puzzle_limit_count)
							var custom_graphics := GetObjProperty(spawner, "epic_chest_graphics");
							var chest_info;

							if (custom_graphics && custom_graphics.size() > 0)
								var gfx := custom_graphics[RandomInt(custom_graphics.size()) + 1];
								chest_info := GetChestInfoByGraphic(gfx);
							else
								var default_gfx := 0xe42;
								if (RandomInt(2) == 0)
									default_gfx := 0xe43;
								endif
								chest_info := struct{
									"graphic" := default_gfx,
									"material" := DEFAULT_MATERIAL_WOOD,
									"maxhp" := DEFAULT_MAXHP_WOOD
								};
							endif

							new_chest := CreateItemAtLocation(new_x, new_y, new_z, chest_info.graphic, 1, spawner.realm);
							if (new_chest)
								new_chest.graphic := chest_info.graphic;
								SetObjProperty(new_chest, PROPNAME_MATERIAL, chest_info.material);
								SetObjProperty(new_chest, PROPNAME_DURABILIDADE_MAX, chest_info.maxhp * level);
								current_puzzle_count := current_puzzle_count + 1;
								SetObjProperty(spawner, "current_puzzle_count", current_puzzle_count);
								SetObjProperty(new_chest, "IsPuzzleChest", 1);
							endif
						endif
					endif

					if (!new_chest && is_mimic)
						if (RandomInt(100) < mimic_chance)
							var objtype := 0xCF89; // MimicEast
							if (RandomInt(2) == 0)
								objtype := 0xCF94; // MimicWest
							endif
							new_chest := CreateItemAtLocation(new_x, new_y, new_z, objtype, 1, spawner.realm);
							if (new_chest)
								var material := 0x1bd7;
								SetObjProperty(new_chest, PROPNAME_MATERIAL, material);
								SetObjProperty(new_chest, "IsMimic", 1);
							endif
						endif
					endif

					if (!new_chest)
						var custom_graphics := GetObjProperty(spawner, "epic_chest_graphics");
						var chest_info;

						if (custom_graphics && custom_graphics.size() > 0)
							var gfx := custom_graphics[RandomInt(custom_graphics.size()) + 1];
							chest_info := GetChestInfoByGraphic(gfx);
						else
							var default_gfx := 0xe42;
							if (RandomInt(2) == 0)
								default_gfx := 0xe43;
							endif
							chest_info := struct{
								"graphic" := default_gfx,
								"material" := DEFAULT_MATERIAL_WOOD,
								"maxhp" := DEFAULT_MAXHP_WOOD
							};
						endif

						new_chest := CreateItemAtLocation(new_x, new_y, new_z, chest_info.graphic, 1, spawner.realm);
						if (new_chest)
							new_chest.graphic := chest_info.graphic;
							SetObjProperty(new_chest, PROPNAME_MATERIAL, chest_info.material);
							SetObjProperty(new_chest, "IsTreasureChest", 1);
							SetObjProperty(new_chest, "level", level);
							SetObjProperty(new_chest, PROPNAME_DURABILIDADE_MAX, chest_info.maxhp * level);

							AddRandomTraps(new_chest, level);
							Loot_Generate(new_chest, base_lootname);
							if (flavor_suffix != "")
								Loot_Generate(new_chest, base_lootname + flavor_suffix);
							endif
							ChestLoot_PostProcess(new_chest);
						endif
					endif

					if (new_chest)
						placed := 1;
						SetObjProperty(new_chest, "link", spawner.serial);
						SetObjProperty(new_chest, "IsEpicChest", 1);
						SetObjProperty(new_chest, "chest_type", chest_type);
						SetObjProperty(new_chest, PROPNAME_DISPENSAVEL_FLAG, true);
						SetObjProperty(new_chest, "CreatedOn", ReadGameClock());
						new_chest.movable := 0;
						new_chest.locked := 1;

						// Baú de tranca especial já gerou loot e setou seu próprio level dentro do helper
						if (!GetObjProperty(new_chest, "IsTrancaEspecial"))
							SetObjProperty(new_chest, "level", level);

							if (GetObjProperty(new_chest, "IsPuzzleChest"))
								Loot_Generate(new_chest, base_lootname);
								if (flavor_suffix != "")
									Loot_Generate(new_chest, base_lootname + flavor_suffix);
								endif
								ChestLoot_PostProcess(new_chest);
							endif
						endif

						created_chests_this_cycle.append(new_chest.serial);
					endif
				endif
			endif
			placement_tries += 1;
			sleepms(10);
		endwhile
	endfor

	if (created_chests_this_cycle.size() > 0)
		foreach serial_val in created_chests_this_cycle
			current_chests_serials.append(CInt(serial_val));
		endforeach
		SetObjProperty(spawner, "spawned_epic_chests", current_chests_serials);
	endif
endfunction

function ClearMySpawnedChests(spawner)
	var chest_serials := GetObjProperty(spawner, "spawned_epic_chests");
	if (chest_serials)
		var valid_chests := array{};
		foreach serial_val in chest_serials
			var chest := SystemFindObjectBySerial(CInt(serial_val));
			if (chest && GetObjProperty(chest, "link") == spawner.serial)
				if (GetObjProperty(chest, "IsBuriedDirt"))
					valid_chests.append(serial_val); // Buried dirt stays until dug up
				elseif (!chest.locked)
					DestroyItem(chest);
				else
					valid_chests.append(serial_val);
				endif
			endif
			sleepms(5);
		endforeach
		SetObjProperty(spawner, "spawned_epic_chests", valid_chests); // Update the list with only locked chests
	endif
endfunction

// ============================================================
// BAÚ DE TRANCA ESPECIAL
// ============================================================
// Sorteio mastermind vs pinos pelo mastermind_chance recebido.
// chest.level = spawner_level (afeta loot tier e diff de lockpick).
// Pinos: graphic visual real + minigame_lock; mastermind: objtype 0xf022 + graphic visual sobrescrito.
// Sempre indestrutível. Armadilha herda intensidade do spawner.
function CreateBauTrancaEspecial(x, y, z, realm, spawner_level, base_lootname, flavor_suffix, mastermind_chance := DEFAULT_TRANCA_MASTERMIND_CHANCE, custom_graphics := 0)
	var mastermind_roll := RandomInt(100);
	var is_mastermind := (mastermind_roll < mastermind_chance);

	TrancaDebug("=== SPAWN BAÚ ESPECIAL ===");
	TrancaDebug("Mastermind roll: " + mastermind_roll + " < " + mastermind_chance + "? -> " + (is_mastermind ? "MASTERMIND" : "PINOS"));

	// Pool visual: GM selecionou ou default
	var graphics_pool;
	if (custom_graphics && custom_graphics.size() > 0)
		graphics_pool := custom_graphics;
		TrancaDebug("Pool: customizado do spawner (" + graphics_pool.size() + " graphics)");
	else
		graphics_pool := GetDefaultTrancaGraphics();
		TrancaDebug("Pool: default (GM não selecionou)");
	endif
	var visual_graphic := graphics_pool[RandomInt(graphics_pool.size()) + 1];

	// Pinos: criar direto com o graphic visual (já dispara container/use).
	// Mastermind: criar com 0xf022 (dispara PuzzleChestOpen via itemdesc), sobrescrever graphic depois.
	var create_objtype := is_mastermind ? BAU_ESPECIAL_PUZZLE_OBJTYPE : visual_graphic;
	var info := GetChestInfoByGraphic(visual_graphic);
	var chest_level := spawner_level;

	TrancaDebug("Objtype: " + Hex(create_objtype) + " | Visual: " + Hex(visual_graphic));
	TrancaDebug("Chest level (=spawner): " + chest_level + " | Material: " + Hex(info.material) + " | MaxHp: " + (info.maxhp * chest_level));
	TrancaDebug("Localização: " + x + "," + y + "," + z + " realm=" + realm);

	var new_chest := CreateItemAtLocation(x, y, z, create_objtype, 1, realm);
	if (!new_chest)
		TrancaDebug("ERRO: CreateItemAtLocation falhou!");
		return 0;
	endif

	TrancaDebug("Chest criado: serial=" + Hex(new_chest.serial));

	// Força graphic visual (necessário pra mastermind, onde 0xf022 é body de mob no client)
	new_chest.graphic := visual_graphic;
	SetName(new_chest, "baú de tranca especial");

	SetObjProperty(new_chest, "IsTrancaEspecial", 1);
	SetObjProperty(new_chest, PROPNAME_INDESTRUTIVEL, 1);
	SetObjProperty(new_chest, PROPNAME_MATERIAL, info.material);
	SetObjProperty(new_chest, PROPNAME_DURABILIDADE_MAX, info.maxhp * chest_level);
	SetObjProperty(new_chest, "level", chest_level);

	if (is_mastermind)
		// Não setar IsPuzzleChest — script PuzzleChestOpen já vem do itemdesc do 0xf022.
		// Setar evitaria Loot_Generate duplo no bloco final de MakeEpicChests.
		TrancaDebug("Mecânica: MASTERMIND (PuzzleChestOpen via itemdesc do 0xf022)");
	else
		SetObjProperty(new_chest, "minigame_lock", 1);
		TrancaDebug("Mecânica: PINOS (minigame_lock=1)");
	endif

	AddRandomTraps(new_chest, spawner_level);
	_LogTraps(new_chest, spawner_level);

	_GenerateAndLogLoot(new_chest, chest_level, flavor_suffix);

	TrancaDebug("=== FIM SPAWN ===");
	return new_chest;
endfunction

function _LogTraps(chest, strength)
	if (!DEBUG_TRANCA)
		return;
	endif
	var trap_list := GetObjProperty(chest, "TrapList");
	if (trap_list == error)
		TrancaDebug("Sem armadilhas");
		return;
	endif
	TrancaDebug("Armadilhas: " + trap_list.size());
	foreach trap in trap_list
		TrancaDebug("  - " + trap.Name + " (strength " + strength + ")");
	endforeach
endfunction

function _GenerateAndLogLoot(chest, chest_level, flavor_suffix)
	var loot_name := "EpicChest" + chest_level;
	TrancaDebug("Gerando loot: " + loot_name + (flavor_suffix != "" ? " + " + loot_name + flavor_suffix : ""));
	Loot_Generate(chest, loot_name);
	if (flavor_suffix != "")
		Loot_Generate(chest, loot_name + flavor_suffix);
	endif
	ChestLoot_PostProcess(chest);

	if (!DEBUG_TRANCA)
		return;
	endif
	var dropped := EnumerateItemsInContainer(chest);
	TrancaDebug("Itens dropados: " + dropped.size());
	foreach item in dropped
		TrancaDebug("  - " + item.name + " (" + Hex(item.objtype) + ") x" + item.amount);
	endforeach
endfunction

// Helper function - needs to be implemented based on how puzzle chests are tracked globally or per spawner.
function CountPuzzleChests(realm_val)
	var count := 0;
	// This is a placeholder. You'll need to iterate through items or use a global counter.
	// For example, if puzzle chests have a specific global property or are stored in a global array.
	// foreach item_in_world in ListItemsInRealm(realm_val) // This would be very slow
	//    if(GetObjProperty(item_in_world, "IsPuzzleChest") && GetObjProperty(item_in_world, "IsActivePuzzle"))
	//        count++;
	//    endif
	// endforeach
	// A better way is to have puzzle chests register/unregister themselves from a global list or increment/decrement a global counter.
	var global_puzzle_list := GetGlobalProperty("ActivePuzzleChestsSerials");
	if (global_puzzle_list.IsArray())
		count := global_puzzle_list.size();
	endif
	return count;
endfunction
