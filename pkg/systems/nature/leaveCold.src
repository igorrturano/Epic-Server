use uo;
use os;
use vitals;

program removecold(who, textarea)
	EraseObjProperty(who, "neve");
	EraseObjProperty(who, "teste_de_frio");

	var stam_penalty := GetObjProperty(who, "penalidadetaiga");
	if (stam_penalty != error)
		var stammod := CInt(GetObjProperty(who, "stammod"));
		SetObjProperty(who, "stammod", stammod - stam_penalty);
	endif
	EraseObjProperty(who, "penalidadetaiga");

	RecalcVitals(who);
endprogram
