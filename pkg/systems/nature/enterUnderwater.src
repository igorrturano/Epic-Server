use uo;
use os;
use util;

program enterunderwater(who, regname)
	if (!who || who.npctemplate)
		return;
	endif

	SetObjProperty(who, "underwater", regname);

	if (GetObjProperty(who, "#uw_running"))
		return;
	endif
	SetObjProperty(who, "#uw_running", 1);

	start_script(":nature:underwatereffect", { who });
endprogram
