
use uo;
use util;
use os;
use cfgfile;
use datafile;
use polsys;

include ":fls_core:fls_characters";
include ":nature:nature";
include ":death:death";
include ":debug:Controller/DebugController";
include "include/epicConstants";

program daynightsystem()
	Print("Starting Day\Night Cycle...");
	SetGlobalProperty("daynightpid", getpid());
	SetGlobalProperty("daynightAccelaration", 1);
	SetGlobalProperty("daynightStartingTime", ReadGameClock());
	var gmAcceleration := cint(GetGlobalProperty("daynightAccelaration"));
	var isAlreadyStarted := false;

    var config := readconfigfile(":nature:config/daynight"); // Moved up for clarity
    var settings := config["settings"]; // Use 'settings' to avoid conflict with 'config' var name if it's an element

	var darkness := cint(settings.darkness);
	var nightlength;
	var clockPid := 0;
	
	var i;
	while(1)
		var base_day_period_seconds := CInt(settings.daylength / gmAcceleration) * 60;
		var base_full_cycle_seconds := base_day_period_seconds * 2; // A full 24-game-hour cycle based on config

		SeasonRotate();  //muda o dia do ano e estação
		MoonFase();      // muda a fase da lua
		// Temperature();   //mmuda a temperatura local

		var season := getSeason();
        var durationDayMod := 1.0; // Initialize as float for precision
		var date := getCurrentDate();

		DebugMsgAll(DEBUG_CLIMA, Message("Dia do ano: " + date.dayYear));
		DebugMsgAll(DEBUG_CLIMA, Message("Dia: " + date.day));
		DebugMsgAll(DEBUG_CLIMA, Message("Mes: " + date.month));
		DebugMsgAll(DEBUG_CLIMA, Message("Ano: " + date.year));
		DebugMsgAll(DEBUG_CLIMA, Message("Lua: " + date.moonPhase));
		DebugMsgAll(DEBUG_CLIMA, Message("Estacao: " + season));

		if (date.month == "Idrithae")
			durationDayMod -= 0.3;
		endif

		if (season == SUMMER) //Checa se é solstício de verão ou inverno
			DebugMsgAll(DEBUG_CLIMA, Message($"Estacao: {SUMMER}"));
			DebugMsgAll(DEBUG_CLIMA, Message($"É Solstício de: {SUMMER}"));
			durationDayMod += 0.2;
		elseif (season == WINTER)
			DebugMsgAll(DEBUG_CLIMA, Message($"Estacao: {WINTER}"));
			DebugMsgAll(DEBUG_CLIMA, Message($"É Solstício de: {WINTER}"));
			durationDayMod -= 0.2;
		endif

        var actual_day_period_seconds := CInt(base_day_period_seconds * durationDayMod);
        var actual_night_period_seconds := CInt(base_full_cycle_seconds - actual_day_period_seconds);

		if (actual_day_period_seconds < 60) actual_day_period_seconds := 60; endif// Minimum 1 minute
        if (actual_night_period_seconds < 60) actual_night_period_seconds := 60; endif

		SetGlobalProperty("CurrentActualDaySeconds", actual_day_period_seconds);
        SetGlobalProperty("CurrentActualNightSeconds", actual_night_period_seconds);

		DebugMsgAll(DEBUG_CLIMA, Message($"Duração do dia: {actual_day_period_seconds / 60}min"));
		DebugMsgAll(DEBUG_CLIMA, Message($"Duração da noite: {actual_night_period_seconds / 60}min"));

		if(!isAlreadyStarted)
			SetGlobalProperty("halfdaytime", ReadGameClock());
			SetGlobalProperty("dia", "dia");
		endif

		if(!clockPid)
			clockPid := Start_Script("daynightClock", getPid());
			Print("Day\Night Cycle *STARTED* pid: " + clockPid.pid);
			isAlreadyStarted := true;
		endif
		
		var ev := Wait_For_Event( base_full_cycle_seconds * 2);

		if(ev.id == DAYNIGHT_EVTS::EV_ADVANCE_DAY_ID)
			advanceDay();
		elseif(ev.id == DAYNIGHT_EVTS::EV_DAY_ACCELATARION_CHANGE_ID)
			gmAcceleration := cint(GetGlobalProperty("daynightAccelaration"));
		endif
		
	endwhile
endprogram

