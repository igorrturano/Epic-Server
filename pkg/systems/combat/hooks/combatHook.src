//
// combathook.src
//
// Combat System Hooks
//
// Created: 2/26/2004 1:13AM
// Updated: 06/03/2007 1:13AM
//
// Responsavel por:
// Fazer os testes pra checar se eh possivel atacar
// Calcular chance de acerto
// Testar se acertou ou errou
// Fazer animacao de ataque
// Tocar sons de Miss ou Hit da arma e som de Damaged do defender
//
// NOTE: Precisa mexer no mainHitScript pra adicionar as linhas que removem Props do Arco
//       Precisa mexer no BowCraft pra adicionar o craft de flechas especiais.
//       Precisa mexer no itemdesc.cfg das armas pra colocar anim certa dos arcos e bestas
//
//       Variaveis com _d (defensor) e _a (atacante)
////////////////////////////////////////////

use uo;
use cfgfile;

// Internos
include ":combat:habilidades";
include ":combat:Model/AttackInfo";

// Externos
include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":debug:Controller/DebugController";
include ":mastery:Abilities";
include ":charsys:ViewModel/MobileWrapper";
include ":equipsys:ViewModel/EquipWrapperWeapon";
include ":equipsys:ViewModel/EquipWrapperArmor";
include ":diceroll:model/Dice";
include ":message:Model/Message";

const OFFHAND_DELAY := 500; // Delay da offhand weapon em ms

program Install()
	print("INSTALLING: AttackHook ... OK!");
	print("");
endprogram

exported function Attack(attacker, defender)
	var attackInfo;
	attacker := MobileWrapper(attacker);
	defender := MobileWrapper(defender);
	attackInfo := AttackInfo(attacker, defender);
	attackInfo.SetAttackerWeapon(attacker.GetEquipBySlot(EQUIP_SLOT::WEAPON))
			  .SetDefenderWeapon(defender.GetEquipBySlot(EQUIP_SLOT::WEAPON));

	if (!CanAttack(attackInfo))	return 1; endif

	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "=================");
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "ATAQUE INICIADO!");
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "=================");
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Mão -> MainHand");
	Start_Script(":combat:hooks/opportunityAttack", { attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef() });
	Start_Script(":combat:weaponHitScripts/AttackAnimation", { attackInfo.GetAttacker().GetMobRef() });

	attackInfo.SetHitChance(CalculateHitChance(attackInfo));
	attackInfo.RollHitChance();
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Chance de acerto: " + attackInfo.GetHitChance());
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Rolagem de acerto: " + attackInfo.GetHitChanceResult());

	if (attackInfo.Succeeded())
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ACERTOU!***");
		SkillChecks(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef(), 1);
		ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_HIT, attackInfo, TARGET::BOTH);
		ExecuteMasteryAbility(attackInfo);
		EpicAttack(attackInfo, EQUIP_LAYER::HAND1);
	else
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ERROU!***");
		ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_MISS, attackInfo, TARGET::BOTH);
		PlayMissSound(attackInfo);
	endif

	// Se é DualWield e o alvo está vivo ataca novamente com a penalidade de acerto
	if (attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetAttribute() == DUALWIELD && !attackInfo.GetDefender().IsDead())
		Start_Script(":combat:weaponHitScripts/AttackAnimation", { attackInfo.GetAttacker().GetMobRef(), OFFHAND_DELAY });
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Mão -> OffHand");

		var attackInfo2 := AttackInfo(attacker, defender);
		attackInfo2.SetDamageHand(DAMAGEHAND::OFFHAND)
				   .SetAttackerWeapon(attackInfo2.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON))
				   .SetDefenderWeapon(attackInfo2.GetDefender().GetEquipBySlot(EQUIP_SLOT::WEAPON))
				   .SetHitChance(attackInfo.GetHitChance())
				   .SetHitChancePenalty(CalculateDualWieldPenalty(attackInfo2));
		attackInfo2.RollHitChance();
		
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, $"Chance de acerto (PENALIDADE): {attackInfo2.GetHitChance()}(-{attackInfo2.GetHitChancePenalty()})");
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Rolagem de acerto: " + attackInfo2.GetDiceRoll());

		if (attackInfo2.Succeeded()) // No segundo hit só checa novamente as habilidades do defensor
			DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ACERTOU!***");
		SkillChecks(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef(), 1);

			ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_HIT, attackInfo, TARGET::DEFENDER);

			EpicAttack(attackInfo, EQUIP_LAYER::HAND2);
		else
			DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ERROU!***");

			ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_MISS, attackInfo, TARGET::DEFENDER);

			PlayMissSound(attackInfo2);
		endif
	endif

	// playSoundAndEffectForThrowingWeapons(attackInfo); // TODO: Transferir isso daqui para o AttackAnimation
	return 1;

endfunction

function CanAttack(attackInfo)
	if (attackInfo.GetAttacker().Equals(attackInfo.GetDefender())) // Impede de atacar-se
		ApplyRawDamage(attackInfo.GetAttacker().GetMobRef(), 5000);
		return 0;
	elseif (!CheckLineOfSight(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef()))
		return 0;
	endif

	if (!attackInfo.GetAttacker().IsNPC())
		if (!attackInfo.GetAttacker().IsWarMode())
			if (attackInfo.GetAttacker().GetMobRef().GetProp("attackmsg") <= polcore().systime)
				Message("Você precisa estar em modo de combate para ameaçar alguem.", SSM_FAIL).SendSys(attackInfo.GetAttacker().GetMobRef());
				attackInfo.GetAttacker().GetMobRef().SetProp("attackmsg", polcore().systime + 15);
			endif
			return 0;
		endif
	endif

	if ((attackInfo.GetAttacker().GetMobRef().paralyzed) || (attackInfo.GetAttacker().GetMobRef().frozen))
		Message("Você não consegue atacar.").SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	elseif ((attackInfo.GetAttacker().GetMobRef().concealed) && (attackInfo.GetAttacker().GetMobRef().cmdlevel == 0))
		attackInfo.GetAttacker().GetMobRef().concealed := 0;
	elseif (!DistanceChecks(attacker, defender))
		return 0;
	elseif (!FacingChecks(attacker, defender))
		return 0;
	elseif (!AmmoCheckCombatHook(attackInfo))
		return 0;
	elseif (GetCooldown(attackInfo.GetAttacker().GetMobRef(), "defesatotal") > 0)
		return 0;
	elseif (!arcane_shooting(attackInfo))
		return 0;
	elseif (attackInfo.GetAttacker().GetMobRef().npctemplate == ":brainai:GolemMartelo")
		return 0;
	elseif (CInt(attackInfo.GetAttacker().GetMobRef().GetProp("charmed_by")) == attackInfo.GetDefender().GetMobRef().serial)
		Message("*hipnotizado*").SendAbove(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif

	return 1;
endfunction

function EpicAttack(attackInfo, weaponHand)
	if (attackInfo.GetDefender().GetMobRef().frozen)
		attackInfo.GetDefender().GetMobRef().frozen := 0;
	endif

	var armor := GetArmorToHit(attackInfo);
	var dmg := CalculateRawDamage(attackInfo);

	if (weaponHand == EQUIP_LAYER::HAND1)
		dmg := Run_Script_To_Completion(":combat:mainHitScript", array{
			attacker,
			defender,
			attacker.weapon, 
			armor,
			dmg,
			dmg
		});
	else // Se for ataque da segunda arma, tem delay
		dmg := Start_Script(":combat:mainHitScript", array{
			attacker,
			defender,
			attacker.weapon, 
			armor,
			dmg,
			dmg,
			OFFHAND_DELAY
		});
	endif

	updateTooltip(armor);
endfunction

// Arqueiros
function AmmoCheckCombatHook(attackInfo)
	const STONE_OBJTYPE := 20481;
	var arcane_bows := array{ 0xFA6D, 0XF997 };

	if (!attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetTemplate().ProjectileType)
		return 1;
	endif

	if (GetCooldown(attackInfo.GetAttacker().GetMobRef(), "arcane_bow") && attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetObjType() in arcane_bows)
		return 1;
	endif

	if (attackInfo.GetAttacker().IsNPC())
		ArqueiroNPC(attackInfo);
		return 1;
	endif

	// Get saved ammo reference
	var ammo := GetObjProperty(attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef(), "ammo");
	if (!ammo)
		Message("Você não definiu o tipo de flecha que vai usar. [clique 2x no arco e na flecha]", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif
	var obj := SystemFindObjectBySerial(ammo);
	// Handle stones differently - they don't need aljava check
	var needs_aljava := (obj.objtype != STONE_OBJTYPE);

	if (needs_aljava)
		var aljavas := array{ 0x791c, 0x2fb7 };
		var aljava := attackInfo.GetAttacker().GetEquipByLayer(EQUIP_LAYER::CAPE);
		// var aljava := GetEquipmentByLayer(attacker, LAYER_CAPE);

		if (!(aljava.objtype in aljavas))
			aljava := attackInfo.GetAttacker().GetEquipByLayer(EQUIP_LAYER::WAIST);
			// aljava := GetEquipmentByLayer(attacker, LAYER_WAIST);
		endif

		// Check if ammo is in aljava
		var found_in_aljava := 0;
		foreach arrow in (EnumerateItemsInContainer(aljava))
			if (arrow.serial == ammo)
				found_in_aljava := 1;
				break;
			endif
		endforeach

		if (!found_in_aljava)
			return 0;
		endif
	endif

	// Handle the ammunition consumption and effect
	if (SubtractAmount(ammo, 1))
		var cfg := ReadConfigFile(":woodworking:itemdesc");
		var elem := FindConfigElem(cfg, GetObjType(ammo));
		var ammo_color := elem.color;
		PlayMovingEffectXYZHued(
			attackInfo.GetAttacker().GetMobRef(),
			attackInfo.GetDefender().GetMobRef(),
			attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetTemplate().ProjectileAnim,
			10, 10, 0, ammo_color
		);
		return 1;
	endif

	return 0;
endfunction

function playSoundAndEffectForThrowingWeapons(attackInfo) // TODO: Transferir isso daqui para o AttackAnimation
	if (attackInfo.GetAttacker().IsNPC())
		ThrowerNPC(attackInfo);
		return;
	endif

	if (attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetCategory() != WEAPON_CATEGORY::THROWING)
		return;
	endif

	if (!AP_ConsumeVital(attackInfo.GetAttacker().GetMobRef(), STAMINA, 10))
		Message("Você está exausto!", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return;
	endif

	PlayMovingEffectXYZHued(
		attackInfo.GetAttacker().GetMobRef(),
		attackInfo.GetDefender().GetMobRef(),
		attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetTemplate().ProjectileAnim,
		10, 10, 0,
		attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetColor()
	);

	PlayAttackAnimation(attackInfo.GetAttacker().GetMobRef()); // 0x9
	// PlayHitSounds(attacker, defender); // sounds {0x5D3, 0x5D4}

	var defenderPos := attackInfo.GetDefender().GetPosition();
	MoveObjectToLocation(
		attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef(),
		defenderPos.x,
		defenderPos.y,
		defenderPos.z,
		defenderPos.realm,
		MOVEOBJECT_FORCELOCATION
	);

endfunction

function arcane_shooting(attackInfo)
	if (!attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetTemplate().ProjectileType)
		return 1;
	endif

	var arcane_bows := array{ 0xFA6D, 0XF997 };
	if (!GetCooldown(attackInfo.GetAttacker().GetMobRef(), "arcane_bow") && !(attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetObjType() in arcane_bows))
		return 1;
	endif

	if (!DamageMANA(attackInfo.GetAttacker().GetMobRef(), 4))
		Message("Você está sem mana!", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif
	
	var ammo_color := 0;
	if (attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef().GetProp("fire_arrow"))
		ammo_color := COLOR_ELEMENTAL_FIRE;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef().GetProp("energy_arrow"))
		ammo_color := COLOR_ELEMENTAL_ENERGY;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef().GetProp("cold_arrow"))
		ammo_color := COLOR_ELEMENTAL_ICE;
	endif

	PlayMovingEffectXYZHued(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), 0xf42, 10, 10, 0, ammo_color);
	return 1;
endfunction

function ArqueiroNPC(attackInfo)
	var anim := attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetTemplate().ProjectileAnim;
	
	if (!anim)
		anim := 0xF79;
	endif

	PlayMovingEffectXYZHued(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), anim, 10, 10);

	return 1;
endfunction

function ThrowerNPC(attackInfo)
	var throwItem := attackInfo.GetAttacker().GetMobRef().GetProp("throwItem");
	if (!throwItem)
		return 0;
	endif

	PerformAction(attackInfo.GetAttacker().GetMobRef(), 4);

	// Play the throw effect
	PlayMovingEffectXYZHued(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), throwItem, 10, 10);

	return 1;
endfunction

function FacingChecks(attacker, defender)
	var retval := 1;

	if (!IsFacing(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y))
		if (attacker.IsNPC())
			TurnObjectToward(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y);
		else
			if (IsBehind(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y) && !(getcooldown(attacker, "deathdance")))
				Message("Você está de costas para o inimigo!", FONTCOLOR_ERROR).SendSys(attacker);
				retval := 0;
			endif
		endif
	endif

	return retval;
endfunction
