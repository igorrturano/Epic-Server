program Install()
	print("INSTALLING: AttackHook ... OK!");
	print("");
endprogram

exported function Attack(attacker, defender)
	var attackInfo := AttackInfo(MobileWrapper(attacker), MobileWrapper(defender));
	attackInfo.SetAttackerWeapon(attacker.GetEquipBySlot(WEAPON))
			  .SetDefenderWeapon(defender.GetEquipBySlot(WEAPON));

	if (!CanAttack(attackInfo))	return 1; endif

	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "=================");
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "ATAQUE INICIADO!");
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "=================");
	TryToAttack(attackInfo);

	if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetAttribute() == DUALWIELD) // Se é DualWield tenta atacar de novo
		attackInfo.SetDamageHand(DAMAGE_HAND::OFFHAND); // Troca a mão para a secundária
		TryToAttack(attackInfo);
	endif

	return 1;
endfunction

function CanAttack(byRef attackInfo)
	if (attackInfo.GetAttacker().Equals(attackInfo.GetDefender())) // Impede de atacar-se
		Message("Você não pode atacar você mesmo.\nMas, só pelo atrevimento... Tome...", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		ApplyRawDamage(attackInfo.GetAttacker().GetObjRef(), 5000);
		return false;
	endif
	
	if (!CheckLineOfSight(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef()))
		Message("Você não enxerga o alvo.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (attackInfo.GetDefender().GetObjRef().hidden) // Impede de atacar gente escondida
		return false;
	endif

	if (!attackInfo.GetAttacker().IsNPC())
		if (!attackInfo.GetAttacker().IsWarMode())
			if (attackInfo.GetAttacker().GetObjRef().GetProp("attackmsg") <= polcore().systime)
				Message("Você precisa estar em modo de combate para ameaçar alguem.", SSM_FAIL).SendSys(attackInfo.GetAttacker().GetObjRef());
				attackInfo.GetAttacker().GetObjRef().SetProp("attackmsg", polcore().systime + 15);
			endif
			return false;
		endif
	endif

	if ((attackInfo.GetAttacker().GetObjRef().paralyzed) || (attackInfo.GetAttacker().GetObjRef().frozen))
		Message("Você não consegue se mover.").SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (!CheckDistance(attackInfo.GetAttacker(), attackInfo.GetDefender()))
		Message("O alvo está fora do alcance.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (!CheckFacing(attackInfo.GetAttacker(), attackInfo.GetDefender()))
		Message("Você precisa estar de frente para o alvo.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (!CheckAmmo(attackInfo))
		return false;
	endif
	
	if (GetCooldown(attackInfo.GetAttacker().GetObjRef(), "defesatotal") > 0)
		Message("Você está totalmente concentrado na defesa.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif
	
	if (!arcane_shooting(attackInfo))
		return false;
	endif
	
	if (attackInfo.GetAttacker().GetObjRef().npctemplate == ":brainai:GolemMartelo")
		return false;
	endif

	if (CInt(attackInfo.GetAttacker().GetObjRef().GetProp("charmed_by")) == attackInfo.GetDefender().GetSerial())
		Message("*hipnotizado*").SendAbove(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (attackInfo.GetDefender().GetObjRef().GetProp("#PrisaoGelida"))
		Message("Você não pode atacar o alvo.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	return true;
endfunction

function TryToAttack(byRef attackInfo)
	attackInfo.SetHitChance(CalculateHitChance(attackInfo));

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Start_Script(":combat:hooks/opportunityAttack", { attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef() });
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "Mão -> MainHand");
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, $"Chance de acerto: {attackInfo.GetHitChance()}");
	elseif (attackInfo.GetDamageHand() == DAMAGE_HAND::OFFHAND)
		attackInfo.SetHitChancePenalty(CalculateDualWieldPenalty(attackInfo));
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "Mão -> OffHand");
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, $"Chance de acerto (PENALIDADE): {attackInfo.GetHitChance()}(-{attackInfo.GetHitChancePenalty()})");
	endif

	attackInfo.RollHitChance();
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "Rolagem de acerto: " + attackInfo.GetHitChanceResult());

	if (attackInfo.Succeeded())
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "***ACERTOU!***");
		// SkillChecks(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef(), attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetObjRef(), 1); // TODO: Checar apenas quando executar o dano de fato...
		
		if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
			ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_HIT, attackInfo, TARGET::BOTH);
			ExecuteMasteryAbility(attackInfo);
		endif

		DoAttack(attackInfo);
	else
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, "***ERROU!***");
		PlayAttackSFX(attackInfo); // Se errou, chama o som aqui
		ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_MISS, attackInfo, TARGET::BOTH);
	endif
endfunction

function DoAttack(byRef attackInfo)
	attackInfo.GetDefender().GetObjRef().frozen := 0;

	if (attackInfo.GetAttacker().GetObjRef().cmdlevel == 0)
		attackInfo.GetAttacker().GetObjRef().concealed := 0;
	endif

	if (attackInfo.GetAttacker().GetObjRef().hidden) // Checa se o atacante escondido revela ou não
		if (attackInfo.GetAttacker().GetObjRef().GetProp("ataquefurtivoaprimorado")) // Gasta a carga de Ataque Furtivo Aprimorado e não se revela
			attackInfo.GetAttacker().GetObjRef().EraseProp("ataquefurtivoaprimorado");
		else // Revela o atacante
			attackInfo.GetAttacker().GetObjRef().hidden := 0;
		endif
	endif
	
	if (!attackInfo.GetAttacker().IsNPC() &&
		attackInfo.GetAttacker().IsWarMode() &&
		attackInfo.GetDefender().IsNPC() &&
		attackInfo.GetDefender().GetObjRef().master) // Cria log de quem ataca Pet (É Personagem Jogador, está em warmode, atacou NPC e o NPC é domado)
			LogToFile(
				":fls_core:pets.log",
				attackInfo.GetDefender().GetObjRef().acctname + " atacou " + attackInfo.GetDefender().GetObjRef().name + " (" + attackInfo.GetDefender().GetNPCTemplate() + ")",
				LOG_DATETIME
			);
	endif

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Run_Script(":combat:attackHitScript", attackInfo);
	else // Se for ataque da segunda arma, executa async com delay
		Start_Script(":combat:attackHitScript", attackInfo);
	endif
endfunction

function CheckAmmo(byRef attackInfo)
	const STONE_OBJTYPE := 20481;

	if (!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileType) // Não tem projétil
		return true;
	endif

	var arcane_bows := array{0xFA6D, 0xF997};
	if (GetCooldown(attackInfo.GetAttacker().GetObjRef(), "arcane_bow") && attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjType() in arcane_bows)
		return true;
	endif

	var ammo := attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef().GetProp("ammo");
	if (!ammo)
		Message("Você não definiu o tipo de flecha que vai usar. [clique 2x no arco e na flecha]", FONTCOLOR_FAIL).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	// Handle stones differently - they don't need aljava check
	var obj := SystemFindObjectBySerial(ammo);
	attackInfo.SetAmmo(obj, 1);
	var needs_aljava := (obj.objtype != STONE_OBJTYPE);
	if (needs_aljava)
		var aljavas := array{ 0x791c, 0x2fb7 };
		var aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_CAPE);

		if (!(aljava.objtype in aljavas))
			aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_WAIST);
		endif

		// Check if ammo is in aljava
		var found_in_aljava := false;
		foreach arrow in (EnumerateItemsInContainer(aljava))
			if (arrow.serial == ammo)
				found_in_aljava := true;
				break;
			endif
		endforeach

		if (!found_in_aljava)
			return false;
		endif
	endif

	return false; // False por segurança, mas não deveria chegar aqui. Se chegar, vai travar o ataque e facilita encontrar o bug.
endfunction

