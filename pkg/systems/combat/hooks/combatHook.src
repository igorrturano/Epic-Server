program Install()
	print("INSTALLING: AttackHook ... OK!");
	print("");
endprogram

exported function Attack(attacker, defender)
	var attackInfo;
	attacker := MobileWrapper(attacker);
	defender := MobileWrapper(defender);
	attackInfo := AttackInfo(attacker, defender);
	attackInfo.SetAttackerWeapon(attacker.GetEquipBySlot(WEAPON))
			  .SetDefenderWeapon(defender.GetEquipBySlot(WEAPON));

	if (!CanAttack(attackInfo))	return 1; endif

	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "=================");
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "ATAQUE INICIADO!");
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "=================");
	TryToAttack(attackInfo);

	// Se é DualWield tenta atacar de novo
	if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetAttribute() == DUALWIELD)
		attackInfo.SetDamageHand(DAMAGEHAND::OFFHAND);
		TryToAttack(attackInfo);
	endif

	return 1;
endfunction

function CanAttack(attackInfo)
	if (attackInfo.GetAttacker().Equals(attackInfo.GetDefender())) // Impede de atacar-se
		Message("Você não pode atacar você mesmo.\nMas, só pelo atrevimento... Tome...", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		ApplyRawDamage(attackInfo.GetAttacker().GetMobRef(), 5000);
		return 0;
	endif
	
	if (!CheckLineOfSight(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef())) return 0; endif
	if (attackInfo.GetDefender().GetMobRef().hidden) return 0; endif // Impede de atacar gente escondida

	if (!attackInfo.GetAttacker().IsNPC())
		if (!attackInfo.GetAttacker().IsWarMode())
			if (attackInfo.GetAttacker().GetMobRef().GetProp("attackmsg") <= polcore().systime)
				Message("Você precisa estar em modo de combate para ameaçar alguem.", SSM_FAIL).SendSys(attackInfo.GetAttacker().GetMobRef());
				attackInfo.GetAttacker().GetMobRef().SetProp("attackmsg", polcore().systime + 15);
			endif
			return 0;
		endif
	endif

	if ((attackInfo.GetAttacker().GetMobRef().paralyzed) || (attackInfo.GetAttacker().GetMobRef().frozen))
		Message("Você não consegue atacar.").SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif

	if (!DistanceChecks(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef())) return 0; endif
	if (!FacingChecks(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef())) return 0; endif
	if (!AmmoCheckCombatHook(attackInfo)) return 0; endif
	if (GetCooldown(attackInfo.GetAttacker().GetMobRef(), "defesatotal") > 0) return 0; endif
	if (!arcane_shooting(attackInfo)) return 0; endif
	if (attackInfo.GetAttacker().GetMobRef().npctemplate == ":brainai:GolemMartelo") return 0; endif

	if (CInt(attackInfo.GetAttacker().GetMobRef().GetProp("charmed_by")) == attackInfo.GetDefender().GetSerial())
		Message("*hipnotizado*").SendAbove(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif

	if (attackInfo.GetDefender().GetMobRef().GetProp("#PrisaoGelida"))
		Message("Você não pode atacar o alvo.", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif

	if (attackInfo.GetAttacker().GetMobRef().hidden) // Checa se o atacante escondido revela ou não
		if (attackInfo.GetAttacker().GetMobRef().GetProp("ataquefurtivoaprimorado")) // Gasta a carga de Ataque Furtivo Aprimorado e não se revela
			attackInfo.GetAttacker().GetMobRef().EraseProp("ataquefurtivoaprimorado");
		else // Revela o atacante
			attackInfo.GetAttacker().GetMobRef().hidden := 0;
		endif
	endif
	
	if (!attackInfo.GetAttacker().IsNPC() &&
		attackInfo.GetAttacker().IsWarMode() &&
		attackInfo.GetDefender().IsNPC() &&
		attackInfo.GetDefender().GetMobRef().master) // Cria log de quem ataca Pet (É Personagem Jogador, está em warmode, atacou NPC e o NPC é domado)
			LogToFile(
				":fls_core:pets.log",
				attackInfo.GetDefender().GetMobRef().acctname + " atacou " + attackInfo.GetDefender().GetMobRef().name + " (" + attackInfo.GetDefender().GetNPCTemplate() + ")",
				LOG_DATETIME
			);
	endif

	if (attackInfo.GetAttacker().GetMobRef().cmdlevel == 0)
		attackInfo.GetAttacker().GetMobRef().concealed := 0;
	endif

	return 1;
endfunction

function TryToAttack(attackInfo)
	attackInfo.SetHitChance(CalculateHitChance(attackInfo));

	if (attackInfo.GetDamageHand() == DAMAGEHAND::MAINHAND)
		Start_Script(":combat:hooks/opportunityAttack", { attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef() });
		Start_Script(":combat:weaponHitScripts/AttackAnimation", { attackInfo.GetAttacker().GetMobRef() });
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Mão -> MainHand");
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, $"Chance de acerto: {attackInfo.GetHitChance()}");
	elseif (attackInfo.GetDamageHand() == DAMAGEHAND::OFFHAND)
		Start_Script(":combat:weaponHitScripts/AttackAnimation", { attackInfo.GetAttacker().GetMobRef(), 500 }); // Delay pro offhand
		attackInfo.SetHitChancePenalty(CalculateDualWieldPenalty(attackInfo));
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Mão -> OffHand");
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, $"Chance de acerto (PENALIDADE): {attackInfo.GetHitChance()}(-{attackInfo.GetHitChancePenalty()})");
	endif

	attackInfo.RollHitChance();
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "Rolagem de acerto: " + attackInfo.GetHitChanceResult());

	if (attackInfo.Succeeded())
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ACERTOU!***");
		// SkillChecks(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), attackInfo.GetAttacker().GetEquipBySlot(EQUIP_SLOT::WEAPON).GetItemRef(), 1); // TODO: Checar apenas quando executar o dano de fato...
		
		if (attackInfo.GetDamageHand() == DAMAGEHAND::MAINHAND)
			ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_HIT, attackInfo, TARGET::BOTH);
			ExecuteMasteryAbility(attackInfo);
		endif

		DoAttack(attackInfo);
	else
		DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, "***ERROU!***");
		ExecuteCombatAbilities(COMBATABILITY_MOMENT::ON_MISS, attackInfo, TARGET::BOTH);
		PlayAttackSound(attackInfo);
	endif
endfunction

function DoAttack(attackInfo)
	attackInfo.GetDefender().GetMobRef().frozen := 0;

	var armorsInZone := attackInfo.GetAttacker().GetEquipBySlot(CS_GetRandomArmorZone());

	if (attackInfo.GetDamageHand() == DAMAGEHAND::MAINHAND)
		Run_Script(":combat:attackHitScript", attackInfo);
	else // Se for ataque da segunda arma, executa async com delay
		Start_Script(":combat:attackHitScript", attackInfo);
	endif
endfunction

// Arqueiros
function AmmoCheckCombatHook(attackInfo)
	const STONE_OBJTYPE := 20481;
	var arcane_bows := array{ 0xFA6D, 0XF997 };

	if (!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileType)
		return 1;
	endif

	if (GetCooldown(attackInfo.GetAttacker().GetMobRef(), "arcane_bow") && attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjType() in arcane_bows)
		return 1;
	endif

	if (attackInfo.GetAttacker().IsNPC())
		ArqueiroNPC(attackInfo);
		return 1;
	endif

	// Get saved ammo reference
	var ammo := GetObjProperty(attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef(), "ammo");
	if (!ammo)
		Message("Você não definiu o tipo de flecha que vai usar. [clique 2x no arco e na flecha]", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif
	var obj := SystemFindObjectBySerial(ammo);
	// Handle stones differently - they don't need aljava check
	var needs_aljava := (obj.objtype != STONE_OBJTYPE);

	if (needs_aljava)
		var aljavas := array{ 0x791c, 0x2fb7 };
		var aljava := attackInfo.GetAttacker().GetEquipByLayer(EQUIP_LAYER::CAPE);
		// var aljava := GetEquipmentByLayer(attacker, LAYER_CAPE);

		if (!(aljava.objtype in aljavas))
			aljava := attackInfo.GetAttacker().GetEquipByLayer(EQUIP_LAYER::WAIST);
			// aljava := GetEquipmentByLayer(attacker, LAYER_WAIST);
		endif

		// Check if ammo is in aljava
		var found_in_aljava := 0;
		foreach arrow in (EnumerateItemsInContainer(aljava))
			if (arrow.serial == ammo)
				found_in_aljava := 1;
				break;
			endif
		endforeach

		if (!found_in_aljava)
			return 0;
		endif
	endif

	// Handle the ammunition consumption and effect
	if (SubtractAmount(ammo, 1))
		var cfg := ReadConfigFile(":woodworking:itemdesc");
		var elem := FindConfigElem(cfg, GetObjType(ammo));
		var ammo_color := elem.color;
		PlayMovingEffectXYZHued(
			attackInfo.GetAttacker().GetMobRef(),
			attackInfo.GetDefender().GetMobRef(),
			attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileAnim,
			10, 10, 0, ammo_color
		);
		return 1;
	endif

	return 0;
endfunction

