// include ":message:Model/Message";

program Install()
	print("INSTALLING: AttackHook ... OK!");
	print("");
endprogram

exported function Attack(attacker, defender)
	attacker := MobileWrapper(attacker);
	defender := MobileWrapper(defender);
	var attackInfo := AttackInfo(attacker, defender);
	attackInfo.SetWeapon(attacker.GetEquipBySlot(WEAPON));

	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("================="));
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("ATAQUE INICIADO!"));
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("================="));

	if (!CanAttack(attackInfo))
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("***NÃO PODE ATACAR***", Color(SYSTEM_COLOR::FAIL)));
		return 1;
	endif

	attackInfo.SetAttackType(attacker.GetCombatTraits().GetPosture());
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message($"Postura adotada no golpe: {attackInfo.GetAttackType()}"));

	TryToAttack(attackInfo);

	if (attackInfo.GetWeapon().GetAttribute() == DUALWIELD) // Se é DualWield tenta atacar de novo
		attackInfo.SetDamageHand(DAMAGE_HAND::OFFHAND); // Troca a mão para a secundária
		TryToAttack(attackInfo);
	endif

	return 1;
endfunction

function CanAttack(byRef attackInfo)
	var attacker := attackInfo.GetAttacker();
	var defender := attackInfo.GetDefender();

	if (attacker.Equals(defender)) // Impede de atacar-se
		Message("Você não pode atacar você mesmo.\nMas, só pelo atrevimento... Tome...", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		ApplyRawDamage(attacker.GetObjRef(), 5000);
		return false;
	endif
	
	if (!CheckLineOfSight(attacker.GetObjRef(), defender.GetObjRef()))
		Message("Você não enxerga o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif

	if (defender.GetObjRef().hidden) // Impede de atacar gente escondida
		return false;
	endif

	if (!attacker.IsNPC())
		if (!attacker.IsWarMode())
			if (attacker.GetObjRef().GetProp("attackmsg") <= polcore().systime)
				Message("Você precisa estar em modo de combate para ameaçar alguem.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
				attacker.GetObjRef().SetProp("attackmsg", polcore().systime + 15);
			endif
			return false;
		endif
	endif

	if ((attacker.GetObjRef().paralyzed) || (attacker.GetObjRef().frozen))
		Message("Você não consegue se mover.").SendSys(attacker.GetObjRef());
		return false;
	endif

	if (!CheckDistance(attacker, defender))
		Message("O alvo está fora do alcance.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif

	if (!CheckFacing(attackInfo))
		Message("Você precisa estar de frente para o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif

	
	if (!attacker.IsNPC())
		if (!CheckAmmo(attackInfo))
			return false;
		endif
	endif
	
	if (GetCooldown(attacker.GetObjRef(), "defesatotal") > 0)
		Message("Você está totalmente concentrado na defesa.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif
	
	if (!arcane_shooting(attackInfo))
		return false;
	endif
	
	// if (attacker.GetProperty("pilotando"))
	// 	Message("Utilize a habilidade Montagem do Golem para atacar enquanto pilota.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
	// 	return false;
	// endif

	if (CInt(attacker.GetObjRef().GetProp("charmed_by")) == defender.GetSerial())
		Message("*hipnotizado*").SendAbove(attacker.GetObjRef());
		return false;
	endif

	if (defender.GetObjRef().GetProp("#PrisaoGelida"))
		Message("Você não pode atacar o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif

	if (defender.GetObjRef().GetProp("#sanctuary"))
		Message("Esse alvo esta sob um santuario divino.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return false;
	endif

	if (attackInfo.GetWeapon().GetCategory() == WEAPON_CATEGORY::SPIRITUALBLADE)
		var elemental := attackInfo.GetWeapon().GetObjRef().GetProp("#elementalweapon");
		if (elemental == error)
			Message("Sua lâmina espiritual não consegue transpassar o oponente.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
			return false;
		endif
	endif

	return true;
endfunction

function TryToAttack(byRef attackInfo)
	var attacker := attackInfo.GetAttacker();
	var defender := attackInfo.GetDefender();
	attackInfo.SetHitChance(CalculateHitChance(attackInfo));

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Start_Script(":combat:hooks/opportunityAttack", array{attacker.GetObjRef(), defender.GetObjRef()});
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("Mão -> MainHand"));
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message($"Chance de acerto: {attackInfo.GetHitChance()}"));
	elseif (attackInfo.GetDamageHand() == DAMAGE_HAND::OFFHAND)
		attackInfo.SetHitChanceMod(CInt(attackInfo.GetHitChanceMod()) - CalculateDualWieldPenalty(attackInfo));
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("Mão -> OffHand"));
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message($"Chance de acerto (PENALIDADE): {attackInfo.GetHitChance()}({attackInfo.GetHitChanceMod()})"));
	endif

	if (Upper(attackInfo.GetWeapon().GetAttribute()) == Upper(RANGED) &&
		!attackInfo.GetWeapon().IsThrowable() &&
		attackInfo.GetWeapon().GetCategory() != WEAPON_CATEGORY::MAGICBOW)
		if (!attacker.IsNPC())
			if (ConsumeAmmo(attackInfo)) // Consome munição
				TryToRecoverAmmo(attackInfo); // Se consumiu, tenta recuperar
			else
				Message("Não foi possível encontrar a munição escolhida.", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
				return 1;
			endif
		endif
	endif

	attackInfo.RollHitChance();
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("Rolagem de acerto: " + attackInfo.GetHitChanceResult()));
	sleepms(2);

	ExecuteCombatAbilitiesBeforeHit(attackInfo);
	ExecutePassiveAbilitiesAttackerBeforeHit(attackInfo);
	ExecutePassiveAbilitiesDefenderBeforeHit(attackInfo);
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message($"HitChanceMod após passivas (acerto: {CInt(attackInfo.GetHitChanceMod())})"));
	sleepms(2);
	if (attackInfo.Succeeded())
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("***ACERTOU!***", Color(SYSTEM_COLOR::SUCCESS)));
		
		if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
			ExecuteMasteryAbility(attackInfo);
		endif

		DoAttack(attackInfo);
	else
		DebugMsg(attacker.GetObjRef(), DEBUG_HIT, Message("***ERROU!***", Color(SYSTEM_COLOR::FAIL)));
		// Se errou, chama os efeitos aqui
		PlayAttackFX(attackInfo);
		PlayAttackSFX(attackInfo);
		ExecuteCombatAbilitiesOnMiss(attackInfo);
		ExecuteCombatAbilitiesOnMissAttacker(attackInfo);
		ExecutePassiveAbilitiesOnMissAttacker(attackInfo);
	endif

	// Counter-attack (crosscut) - triggers on any attack attempt
	if (attackInfo.ShouldCounterAttack() && !defender.IsDead())
		defender.Attack(attacker);
	endif
endfunction

function DoAttack(byRef attackInfo)
	attackInfo.GetDefender().GetObjRef().frozen := 0;

	var _atkRef := attackInfo.GetAttacker().GetObjRef();
	var _inSmoke := IsInShinobiSmokeZone(_atkRef);

	if (_atkRef.cmdlevel == 0 && !attackInfo.GetAttacker().HasAbility(ABILITY_ID::FORMA_UMBRAL) && !_inSmoke)
		_atkRef.concealed := 0;
	endif
	
	if (!attackInfo.GetAttacker().IsNPC() &&
		attackInfo.GetAttacker().IsWarMode() &&
		attackInfo.GetDefender().IsNPC() &&
		attackInfo.GetDefender().GetObjRef().master) // Cria log de quem ataca Pet (É Personagem Jogador, está em warmode, atacou NPC e o NPC é domado)
			LogToFile(
				":fls_core:pets.log",
				attackInfo.GetDefender().GetObjRef().acctname + " atacou " + attackInfo.GetDefender().GetObjRef().name + " (" + attackInfo.GetDefender().GetTemplate() + ")",
				LOG_DATETIME
			);
	endif

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Run_Script_To_Completion(":combat:mainHitScript", attackInfo);
	else // Se for ataque da mão secundária, executa async por causa do delay
		Start_Script(":combat:mainHitScript", attackInfo);
	endif
endfunction

function CheckAmmo(byRef attackInfo)
	var weapon := attackInfo.GetWeapon();
	
	if (!weapon.GetTemplate().ProjectileType)
		return true;
	endif

	if (weapon.GetCategory() == WEAPON_CATEGORY::MAGICBOW)
		return true;
	endif

	var ammoSerial := weapon.GetObjRef().GetProp("ammo");
	if (!ammoSerial)
		Message($"Você não definiu o tipo de munição que vai usar. [clique 2x na arma e na munição]", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	var ammoObj := SystemFindObjectBySerial(ammoSerial);
	if (!ammoObj)
		weapon.GetObjRef().EraseProp("ammo");
		Message("Sua munição acabou.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	var ammo := Ammo(ammoObj);
	attackInfo.SetAmmo(ammo);

	if (ammo.NeedsQuiver())
		var aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_CAPE);
		if (aljava.GetCategory() != ITEM_CATEGORY::QUIVER)
			aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_WAIST);
		endif

		if (!aljava.Contains(ammo.GetItem()))
			Message("A munição não está na aljava.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif
	elseif (ammo.NeedsBandolier())
		var bandolier := attackInfo.GetAttacker().GetEquipByLayer(LAYER_WAIST);
		if (bandolier.GetCategory() != ITEM_CATEGORY::BANDOLIER)
			Message("Você precisa equipar uma Bandoleira de Artilharia.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif

		if (!bandolier.Contains(ammo.GetItem()))
			Message("A munição não está na bandoleira.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif
	endif

	return true;
endfunction

function arcane_shooting(byRef attackInfo)
	var attacker := attackInfo.GetAttacker();
	var defender := attackInfo.GetDefender();
	var attackerWeapon := attackInfo.GetWeapon();
	
	if (!attackerWeapon.GetTemplate().ProjectileType)
		return 1;
	endif

	if (attackerWeapon.GetCategory() != WEAPON_CATEGORY::MAGICBOW)
		return 1;
	endif

	var manaCost := 4;
	if (attacker.HasAbility(ABILITY_ID::FOCO_ARCANO))
		manaCost := manaCost - CInt(manaCost / 5);
	endif

	if (!DamageMANA(attacker.GetObjRef(), manaCost))
		Message("Você está sem mana!", Color(SYSTEM_COLOR::FAIL)).SendSys(attacker.GetObjRef());
		return 0;
	endif
	
	var ammo_effect := 0xf42;
	if (attackerWeapon.GetObjRef().GetProp("fire_arrow"))
		ammo_effect := FX_FIRE_ARROW;
	elseif (attackerWeapon.GetObjRef().GetProp("energy_arrow"))
		ammo_effect := FX_ELETRIC_BOLT;
	elseif (attackerWeapon.GetObjRef().GetProp("cold_arrow"))
		ammo_effect := 0xe3e5;
	endif

	PlayMovingEffect(attacker.GetObjRef(), defender.GetObjRef(), ammo_effect, 10);
	return 1;
endfunction

function CheckFacing(byRef attackInfo)
	var attacker := attackInfo.GetAttacker();
	var defender := attackInfo.GetDefender();
	
	if (!IsFacing(attacker.GetObjRef(), defender.GetPosition().GetX(), defender.GetPosition().GetY()))
		if (attacker.IsNPC())
			// TurnObjectToward(attacker.GetObjRef(), defender.GetObjRef().x, defender.GetObjRef().y);
		else
			if (IsBehind(attacker.GetObjRef(), defender.GetPosition().GetX(), defender.GetPosition().GetY()) && !(GetCooldown(attacker.GetObjRef(), "deathdance")))
				return false;
			endif
		endif
	endif

	var attackDirection;
	if (IsBehind(defender.GetObjRef(), attacker.GetPosition().GetX(), attacker.GetPosition().GetY()))
		attackDirection := ATTACK_DIRECTION::BACK;
	else
		attackDirection := ATTACK_DIRECTION::FRONT;
	endif
	attackInfo.SetDirection(attackDirection);
	DebugMsg(attacker.GetObjRef(), DEBUG_HIT, $"Direção do golpe: {(attackInfo.GetDirection() == ATTACK_DIRECTION::FRONT ? "Frente" : "Costas")}");

	return true;
endfunction

function TryToRecoverAmmo(byRef attackInfo)
	if (attackInfo.GetDefender().IsNPC() && attackInfo.GetDefender().GetObjRef().backpack)
		var chance := CInt(CS_GetSettingsCfgElem("Archery").RecoverChance);

		if (RandomInt(100 + 1) <= chance)
			var ammo := attackInfo.GetAmmo().GetItem().GetObjRef();
			if (ammo)
				CreateItemInBackPack(attackInfo.GetDefender().GetObjRef(), ammo, attackInfo.GetAmmoAmount());
			endif
		endif
	endif
endfunction