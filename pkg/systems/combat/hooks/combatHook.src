function FacingChecks(attacker, defender)
	var retval := 1;

	if (!IsFacing(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y))
		if (attacker.IsNPC())
			TurnObjectToward(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y);
		else
			if (IsBehind(attacker.GetMobRef(), defender.GetMobRef().x, defender.GetMobRef().y) && !(getcooldown(attacker, "deathdance")))
				Message("Você está de costas para o inimigo!", FONTCOLOR_ERROR).SendSys(attacker);
				retval := 0;
			endif
		endif
	endif

	return retval;
endfunction
