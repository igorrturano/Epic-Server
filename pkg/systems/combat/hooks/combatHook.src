function arcane_shooting(attackInfo)
	if (!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileType)
		return 1;
	endif

	var arcane_bows := array{ 0xFA6D, 0XF997 };
	if (!GetCooldown(attackInfo.GetAttacker().GetMobRef(), "arcane_bow") && !(attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjType() in arcane_bows))
		return 1;
	endif

	if (!DamageMANA(attackInfo.GetAttacker().GetMobRef(), 4))
		Message("Você está sem mana!", FONTCOLOR_ERROR).SendSys(attackInfo.GetAttacker().GetMobRef());
		return 0;
	endif
	
	var ammo_color := 0;
	if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef().GetProp("fire_arrow"))
		ammo_color := COLOR_ELEMENTAL_FIRE;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef().GetProp("energy_arrow"))
		ammo_color := COLOR_ELEMENTAL_ENERGY;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef().GetProp("cold_arrow"))
		ammo_color := COLOR_ELEMENTAL_ICE;
	endif

	PlayMovingEffectXYZHued(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), 0xf42, 10, 10, 0, ammo_color);
	return 1;
endfunction

