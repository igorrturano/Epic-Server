function CheckFacing(attacker, defender)
	var retval := 1;

	if (!IsFacing(attacker.GetObjRef(), defender.GetObjRef().x, defender.GetObjRef().y))
		if (attacker.IsNPC())
			TurnObjectToward(attacker.GetObjRef(), defender.GetObjRef().x, defender.GetObjRef().y);
		else
			if (IsBehind(attacker.GetObjRef(), defender.GetObjRef().x, defender.GetObjRef().y) && !(getcooldown(attacker, "deathdance")))
				Message("Você está de costas para o inimigo!", FONTCOLOR_ERROR).SendSys(attacker);
				retval := 0;
			endif
		endif
	endif

	return retval;
endfunction
