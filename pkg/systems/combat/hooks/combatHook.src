program Install()
	print("INSTALLING: AttackHook ... OK!");
	print("");
endprogram

exported function Attack(attacker, defender)
	var attackInfo := AttackInfo(MobileWrapper(attacker), MobileWrapper(defender));

	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("================="));
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("ATAQUE INICIADO!"));
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("================="));

	if (!CanAttack(attackInfo))
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("***NÃO PODE ATACAR***", Color(SYSTEM_COLOR::FAIL)));
		return 1;
	endif

	attackInfo.SetAttackType(attackInfo.GetAttacker().GetCombatTraits().GetPosture());
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message($"Postura adotada no golpe: {attackInfo.GetAttackType()}"));

	TryToAttack(attackInfo);

	if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetAttribute() == DUALWIELD) // Se é DualWield tenta atacar de novo
		attackInfo.SetDamageHand(DAMAGE_HAND::OFFHAND); // Troca a mão para a secundária
		TryToAttack(attackInfo);
	endif

	return 1;
endfunction

function CanAttack(byRef attackInfo)
	if (attackInfo.GetAttacker().Equals(attackInfo.GetDefender())) // Impede de atacar-se
		Message("Você não pode atacar você mesmo.\nMas, só pelo atrevimento... Tome...", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		ApplyRawDamage(attackInfo.GetAttacker().GetObjRef(), 5000);
		return false;
	endif
	
	if (!CheckLineOfSight(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef()))
		Message("Você não enxerga o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (attackInfo.GetDefender().GetObjRef().hidden) // Impede de atacar gente escondida
		return false;
	endif

	if (!attackInfo.GetAttacker().IsNPC())
		if (!attackInfo.GetAttacker().IsWarMode())
			if (attackInfo.GetAttacker().GetObjRef().GetProp("attackmsg") <= polcore().systime)
				Message("Você precisa estar em modo de combate para ameaçar alguem.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
				attackInfo.GetAttacker().GetObjRef().SetProp("attackmsg", polcore().systime + 15);
			endif
			return false;
		endif
	endif

	if ((attackInfo.GetAttacker().GetObjRef().paralyzed) || (attackInfo.GetAttacker().GetObjRef().frozen))
		Message("Você não consegue se mover.").SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (!CheckDistance(attackInfo.GetAttacker(), attackInfo.GetDefender()))
		Message("O alvo está fora do alcance.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (!CheckFacing(attackInfo))
		Message("Você precisa estar de frente para o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	
	if (!attackInfo.GetAttacker().IsNPC())
		if (!CheckAmmo(attackInfo))
			return false;
		endif
	endif
	
	if (GetCooldown(attackInfo.GetAttacker().GetObjRef(), "defesatotal") > 0)
		Message("Você está totalmente concentrado na defesa.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif
	
	if (!arcane_shooting(attackInfo))
		return false;
	endif
	
	if (attackInfo.GetAttacker().GetObjRef().npctemplate == ":brainai:GolemMartelo")
		return false;
	endif

	if (CInt(attackInfo.GetAttacker().GetObjRef().GetProp("charmed_by")) == attackInfo.GetDefender().GetSerial())
		Message("*hipnotizado*").SendAbove(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	if (attackInfo.GetDefender().GetObjRef().GetProp("#PrisaoGelida"))
		Message("Você não pode atacar o alvo.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	return true;
endfunction

function TryToAttack(byRef attackInfo)
	attackInfo.SetHitChance(CalculateHitChance(attackInfo));

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Start_Script(":combat:hooks/opportunityAttack", array{attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef()});
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("Mão -> MainHand"));
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message($"Chance de acerto: {attackInfo.GetHitChance()}"));
	elseif (attackInfo.GetDamageHand() == DAMAGE_HAND::OFFHAND)
		attackInfo.SetHitChanceMod(CInt(attackInfo.GetHitChanceMod()) - CalculateDualWieldPenalty(attackInfo));
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("Mão -> OffHand"));
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message($"Chance de acerto (PENALIDADE): {attackInfo.GetHitChance()}({attackInfo.GetHitChanceMod()})"));
	endif

	if (Upper(attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetAttribute()) == Upper(RANGED) &&
		!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).IsThrowable())
		if (!attackInfo.GetAttacker().IsNPC())
			if (ConsumeAmmo(attackInfo)) // Consome munição
				TryToRecoverAmmo(attackInfo); // Se consumiu, tenta recuperar
			else
				Message("Não foi possível encontrar a munição escolhida.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
				return 1;
			endif
		endif
	endif

	attackInfo.RollHitChance();
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("Rolagem de acerto: " + attackInfo.GetHitChanceResult()));

	ExecuteCombatAbilitiesBeforeHit(attackInfo);
	if (attackInfo.Succeeded())
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("***ACERTOU!***", Color(SYSTEM_COLOR::SUCCESS)));
		
		if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
			ExecuteMasteryAbility(attackInfo);
		endif

		DoAttack(attackInfo);
	else
		DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, Message("***ERROU!***", Color(SYSTEM_COLOR::FAIL)));
		// Se errou, chama os efeitos aqui
		PlayAttackFX(attackInfo);
		PlayAttackSFX(attackInfo);
		ExecuteCombatAbilitiesOnMiss(attackInfo);
	endif

	// Counter-attack (crosscut) - triggers on any attack attempt
	if (attackInfo.ShouldCounterAttack() && !attackInfo.GetDefender().IsDead())
		attackInfo.GetDefender().Attack(attackInfo.GetAttacker());
	endif
endfunction

function DoAttack(byRef attackInfo)
	attackInfo.GetDefender().GetObjRef().frozen := 0;

	// EVILTODO: Forma umbral nao deveria ser revelado ; shadowsteps.src -> protected() PRecisa refatorar?
	if (attackInfo.GetAttacker().GetObjRef().cmdlevel == 0)
		attackInfo.GetAttacker().GetObjRef().concealed := 0;
	endif
	
	if (!attackInfo.GetAttacker().IsNPC() &&
		attackInfo.GetAttacker().IsWarMode() &&
		attackInfo.GetDefender().IsNPC() &&
		attackInfo.GetDefender().GetObjRef().master) // Cria log de quem ataca Pet (É Personagem Jogador, está em warmode, atacou NPC e o NPC é domado)
			LogToFile(
				":fls_core:pets.log",
				attackInfo.GetDefender().GetObjRef().acctname + " atacou " + attackInfo.GetDefender().GetObjRef().name + " (" + attackInfo.GetDefender().GetTemplate() + ")",
				LOG_DATETIME
			);
	endif

	if (attackInfo.GetDamageHand() == DAMAGE_HAND::MAINHAND)
		Run_Script_To_Completion(":combat:mainHitScript", attackInfo);
	else // Se for ataque da mão secundária, executa async por causa do delay
		Start_Script(":combat:mainHitScript", attackInfo);
	endif
endfunction

function CheckAmmo(byRef attackInfo)
	if (!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileType)
		return true;
	endif

	if (GetCooldown(attackInfo.GetAttacker().GetObjRef(), "arcane_bow"))
		if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetCategory() == WEAPON_CATEGORY::MAGICBOW)
			return true;
		else
			return false;
		endif
	endif

	var ammoSerial := attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef().GetProp("ammo");
	if (!ammoSerial)
		Message($"Você não definiu o tipo de munição que vai usar. [clique 2x na arma e na munição]", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	var ammo := Ammo(SystemFindObjectBySerial(ammoSerial));
	attackInfo.SetAmmo(ammo);

	var weaponCategory := attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetCategory();

	if (ammo.NeedsQuiver())
		var aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_CAPE);
		if (aljava.GetCategory() != ITEM_CATEGORY::QUIVER)
			aljava := attackInfo.GetAttacker().GetEquipByLayer(LAYER_WAIST);
		endif

		if (!aljava.Contains(ammo.GetItem()))
			Message("A munição não está na aljava.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif
	elseif (ammo.NeedsBandolier())
		var bandolier := attackInfo.GetAttacker().GetEquipByLayer(LAYER_WAIST);
		if (bandolier.GetCategory() != ITEM_CATEGORY::BANDOLIER)
			Message("Você precisa equipar uma Bandoleira de Artilharia.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif

		if (!bandolier.Contains(ammo.GetItem()))
			Message("A munição não está na bandoleira.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif

		var powderFixer := 0xC611; // Socador de Polvora
		if (!bandolier.Contains(powderFixer))
			Message("Você não tem socador de pólvora na bandoleira.", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
			return false;
		endif
	endif

	return true;
endfunction

function arcane_shooting(byRef attackInfo)
	if (!attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetTemplate().ProjectileType)
		return 1;
	endif

	var arcane_bows := array{ 0xFA6D, 0XF997 };
	if (!GetCooldown(attackInfo.GetAttacker().GetObjRef(), "arcane_bow") && !(attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjType() in arcane_bows))
		return 1;
	endif

	if (!DamageMANA(attackInfo.GetAttacker().GetObjRef(), 4))
		Message("Você está sem mana!", Color(SYSTEM_COLOR::FAIL)).SendSys(attackInfo.GetAttacker().GetObjRef());
		return 0;
	endif
	
	var ammo_color := 0;
	if (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef().GetProp("fire_arrow"))
		ammo_color := COLOR_ELEMENTAL_FIRE;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef().GetProp("energy_arrow"))
		ammo_color := COLOR_ELEMENTAL_ENERGY;
	elseif (attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef().GetProp("cold_arrow"))
		ammo_color := COLOR_ELEMENTAL_ICE;
	endif

	PlayMovingEffectXYZHued(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef(), 0xf42, 10, 10, 0, ammo_color);
	return 1;
endfunction

function CheckFacing(byRef attackInfo)
	if (!IsFacing(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetPosition().GetX(), attackInfo.GetDefender().GetPosition().GetY()))
		if (attackInfo.GetAttacker().IsNPC())
			// TurnObjectToward(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetObjRef().x, attackInfo.GetDefender().GetObjRef().y);
		else
			if (IsBehind(attackInfo.GetAttacker().GetObjRef(), attackInfo.GetDefender().GetPosition().GetX(), attackInfo.GetDefender().GetPosition().GetY()) && !(GetCooldown(attackInfo.GetAttacker().GetObjRef(), "deathdance")))
				return false;
			endif
		endif
	endif

	var attackDirection;
	if (IsBehind(attackInfo.GetDefender().GetObjRef(), attackInfo.GetAttacker().GetPosition().GetX(), attackInfo.GetAttacker().GetPosition().GetY()))
		attackDirection := ATTACK_DIRECTION::BACK;
	else
		attackDirection := ATTACK_DIRECTION::FRONT;
	endif
	attackInfo.SetDirection(attackDirection);
	DebugMsg(attackInfo.GetAttacker().GetObjRef(), DEBUG_HIT, $"Direção do golpe: {(attackInfo.GetDirection() == ATTACK_DIRECTION::FRONT ? "Frente" : "Costas")}");

	return true;
endfunction

function TryToRecoverAmmo(byRef attackInfo)
	if (attackInfo.GetDefender().IsNPC() && attackInfo.GetDefender().GetObjRef().backpack)
		var chance := CInt(CS_GetSettingsCfgElem("Archery").RecoverChance);

		// TODO: Migrar para o nome Ability
		// if (TryToExecuteHab_ArrowRecovery(attackInfo))
		// 	chance += 15;
		// endif

		if (RandomInt(100 + 1) <= chance)
			var ammo := attackInfo.GetAmmo().GetItem().GetObjRef();
			if (ammo)
				CreateItemInBackPack(attackInfo.GetDefender().GetObjRef(), ammo, attackInfo.GetAmmoAmount());
			endif
		endif
	endif
endfunction