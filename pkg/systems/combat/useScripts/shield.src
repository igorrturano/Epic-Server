use uo;
include ":message:model/Message";

program use_Bladed(who, shield)
	// If weapon is not equipped, equip it
	if (who.shield != shield)
		if (EquipItem(who, shield))
			Message("Voce equipa seu escudo!").SetColor(SSM_INFO).SendSys(who);
			Message("Dica: Clique no escudo equipado para desequipá-lo.").SetColor(SSM_INFO).SendSys(who);
			return 1;
		else
			Message("Nao foi possivel equipar o escudo.").SetColor(SSM_FAIL).SendSys(who);
			return 0;
		endif
    else 
        MoveItemToContainer(shield, who.backpack);

	endif
endprogram