include ":attributes:attributes";

program SpecialAttack_Cutthroat(combatInfo)
	var attacker := combatInfo.attacker;
	var defender := combatInfo.defender;

	PrintTextAbove(attacker, $"*corta a garganta de {defender.name}*");
	PrintTextAbove(defender, "*garganta cortada*");
	PrintTextPrivate(defender, "Voce foi executado!", defender);
	PrintTextPrivate(defender, "Voce executou seu alvo!", attacker);

	ApplyRawDamage(defender, 1000); // Dano absurdo pra garantir que matou
	// RecalcVitals(defender);

	var location := struct{ x := defender.x, y := defender.y, z := defender.z,
							realm := defender.realm };
	FormarPocaSangue(location);

	return true;
endprogram

function FormarPocaSangue(center)

	for x := -1 to 1
		for y := -1 to 1
			var location := struct{ x := center.x, y := center.y, z := center.z, realm := center.realm };
			location.x := center.x + x;
			location.y := center.y + y;

			if (y == -1)
				if (x == -1)
					CreatePoolAt(location, 0x1CCF);
				elseif (x == 0)
					CreatePoolAt(location, 0x1CD6);
				elseif (x == 1)
					CreatePoolAt(location, 0x1CD0);
				endif
			endif

			if (y == 0)
				if (x == -1)
					CreatePoolAt(location, 0x1CD2);
				elseif (x == 0)
					CreatePoolAt(location, 0x1CD9);
				elseif (x == 1)
					CreatePoolAt(location, 0x1CD8);
				endif
			endif

			if (y == 1)
				if (x == -1)
					CreatePoolAt(location, 0x1CCD);
				elseif (x == 0)
					CreatePoolAt(location, 0x1CD4);
				elseif (x == 1)
					CreatePoolAt(location, 0x1CCE);
				endif
			endif

			SleepMS(5);
		endfor
	endfor
endfunction

function CreatePoolAt(location, id)
	var blood := CreateItemAtLocation(location.x, location.y, location.z, id, 1, location.realm);
	blood.movable := 0;
	blood.name := "sangue";
endfunction
