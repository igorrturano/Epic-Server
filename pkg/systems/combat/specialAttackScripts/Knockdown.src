use uo;

include ":debug:main";
include ":timedScripts:timedScripts";

program SpecialAttack_Knockdown(params)
	var attacker := params.attacker;
	var defender := params.defender;
	var effectTime := params.effectTime;

	PrintTextAbove(defender, "*Derrubado*");
	SendSysMessage(attacker, "Você derruba o oponente.");
	SendSysMessage(defender, "Você foi derrubado temporariamente.");

	TS_StartTimer(defender, "tombar", effectTime);

	return 1;
endprogram