use uo;

include ":debug:Controller/DebugController";

program SpecialAttack_CounterAttack(combatInfo)
	var attacker := combatInfo.attacker;
	var defender := combatInfo.defender;

	PrintTextAbove(defender, "*Contra-Ataque*");
	SendSysMessage(attacker, "Você realiza um contra-ataque.");

	attacker.attack_once(defender);

	return 1;
endprogram
