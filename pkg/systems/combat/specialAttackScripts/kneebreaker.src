use uo;

include "include/say";
include ":timedScripts:timedScripts";

program SpecialAttack_KneeBreaker(combatInfo)
	var attacker := combatInfo.attacker;
	var defender := combatInfo.defender;
	var effectTime := combatInfo.effectTime;

	PrintTextAbove(defender, "*Joelho quebrado*");
	SendSysMessage(attacker, "Você ataca o joelho do oponente.");
	SendSysMessage(defender, "Seu joelho foi quebrado temporariamente.");
	TS_StartTimer(defender, "lentidao", effectTime);

	return 1;
endprogram
