use uo;
use os;

include ":message:model/Message";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":gumps:gumps";
include ":gumps:selectionGump";
include "include/client";

const STEAMARMS_OBJTYPE := 0xFFC3;
const HANDCANNON_OBJTYPE := 0xFFC7;
const HARPOON_OBJTYPE := 0xFFC6;
const POWDERTRAP_OBJTYPE := 0xFFC8;

program use_steamarms(who, item)
	// If not equipped, equip it
	if (!_IsEquipped(who, item))
		if (EquipItem(who, item))
			Message("Voce equipa os Bracos a Vapor!").SetColor(SSM_INFO).SendSys(who);
			return 1;
		else
			Message("Nao foi possivel equipar.").SetColor(SSM_FAIL).SendSys(who);
			return 0;
		endif
	endif

	// Must have Tactical Shoulder ability
	var mobile := MobileWrapper(who);
	if (!mobile.HasAbility(ABILITY_ID::TACTICAL_SHOULDER))
		Message("Voce nao possui a habilidade Ombreira Tatica.").SetColor(SSM_FAIL).SendSys(who);
		return 0;
	endif

	// Block gadget swap while Explosive Fist is active
	if (GetObjProperty(who, "#explosive_fist"))
		Message("Desative os punhos explosivos antes de trocar o mecanismo.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		return 0;
	endif

	// Build options list
	var current := GetObjProperty(item, "InstalledGadget");
	var current_name := "Nenhum";
	case (current)
		"handcannon": current_name := "Canhao de Mao";
		"harpoon":    current_name := "Arpao Mecanico";
		"powdertrap": current_name := "Armadilha de Polvora";
	endcase

	var has_cannon  := FindObjtypeInContainer(who.backpack, HANDCANNON_OBJTYPE);
	var has_harpoon := FindObjtypeInContainer(who.backpack, HARPOON_OBJTYPE);
	var has_trap    := FindObjtypeInContainer(who.backpack, POWDERTRAP_OBJTYPE);

	if (!has_cannon && !has_harpoon && !has_trap && !current)
		Message($"Nenhum gadget disponivel. [Instalado: {current_name}]", Color(SYSTEM_COLOR::INFO)).SendSys(who);
		return 0;
	endif

	var choice := _GadgetGump(who, current, has_cannon, has_harpoon, has_trap);
	if (!choice)
		return 0;
	endif
	// Unequip current gadget first (5s to remove)
	if (current)
		Message("*Removendo o mecanismo atual...*").SendEmote(who);
		for i := 1 to 5
			PerformAction(who, HUMAN_ANIM::ATTACK_XBOW);
			PlaySoundEffect(who, 0x22C);
			sleep(1);
			if (who.dead || !_IsEquipped(who, item))
				Message("Remocao interrompida.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
				return 0;
			endif
		endfor
		_UnequipGadget(who, current);
		PerformAction(who, HUMAN_ANIM::ATTACK_2HAND_BLUNT);
	endif

	// Installation takes 10 seconds
	if (!choice["Remover"])
		Message("Comeca a instalar o mecanismo na ombreira...").SendEmote(who);
		for i := 1 to 5
			PerformAction(who, HUMAN_ANIM::ATTACK_XBOW);
			PlaySoundEffect(who, 0x22C);
			sleep(2);
			if (who.dead || !_IsEquipped(who, item))
				Message("Instalacao interrompida.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
				return 0;
			endif
		endfor
		PerformAction(who, HUMAN_ANIM::ATTACK_2HAND_BLUNT);
	endif

	var gadget := 0;
	if (choice["Canhao"])
		gadget := FindObjtypeInContainer(who.backpack, HANDCANNON_OBJTYPE);
		SetObjProperty(item, "InstalledGadget", "handcannon");
		Message("Canhao de Mao instalado na ombreira!", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who);
	elseif (choice["Arpao"])
		gadget := FindObjtypeInContainer(who.backpack, HARPOON_OBJTYPE);
		SetObjProperty(item, "InstalledGadget", "harpoon");
		Message("Arpao Mecanico instalado na ombreira!", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who);
	elseif (choice["Armadilha"])
		gadget := FindObjtypeInContainer(who.backpack, POWDERTRAP_OBJTYPE);
		SetObjProperty(item, "InstalledGadget", "powdertrap");
		Message("Armadilha de Polvora instalada na ombreira!", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who);
	elseif (choice["Remover"])
		EraseObjProperty(item, "InstalledGadget");
		Message("Gadget removido da ombreira.", Color(SYSTEM_COLOR::INFO)).SendSys(who);
	endif

	if (gadget)
		SetObjProperty(gadget, "#steam_install", 1);
		var result := EquipItem(who, gadget);
		if (!result || result == error)
			Message($"Erro ao equipar gadget: {result}", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
		endif
	endif
	PlaySoundEffect(who, 0x02B);

	return 1;
endprogram

function _IsEquipped(who, item)
	foreach equipped in ListEquippedItems(who)
		if (equipped.serial == item.serial)
			return 1;
		endif
	endforeach
	return 0;
endfunction

function _GadgetGump(who, current, has_cannon, has_harpoon, has_trap)
	var gump := GFCreateGump();
	GFClosable(gump, 1);
	GFMovable(gump, 1);

	// Background
	GFResizePic(gump, 0, 0, 0x0A28, 400, 260);

	// Title
	GFHTMLArea(gump, 0, 16, 400, 25, "<CENTER><BASEFONT SIZE=5 COLOR=#DDAA44>Ombreira Tatica</BASEFONT></CENTER>", 0, 0);

	// 3 gadget slots side by side
	var gadgets := array{
		struct{ key := "handcannon", name := "Canhao de Mao",         objtype := HANDCANNON_OBJTYPE, has := has_cannon,  desc := "AoE explosivo" },
		struct{ key := "harpoon",    name := "Arpao Mecanico",        objtype := HARPOON_OBJTYPE,    has := has_harpoon, desc := "Puxa o alvo"   },
		struct{ key := "powdertrap", name := "Lancador de Minas",     objtype := POWDERTRAP_OBJTYPE, has := has_trap,    desc := "Mina invisivel" }
	};

	var x := 15;
	var btn_id := 1;
	foreach g in gadgets
		// Card background
		var is_current := (current == g.key);
		GFResizePic(gump, x, 35, is_current ? 0x0BB8 : 0x13BE, 120, 170);

		// Item preview
		GFTilePic(gump, x + 35, 50, CInt(g.objtype), 0);

		// Name
		GFTextLine(gump, x + 5, 105, is_current ? 0x35 : 0x0, g.name);

		// Description
		GFTextLine(gump, x + 5, 125, 0x3B2, g.desc);

		// Status / Button
		if (is_current)
			GFTextLine(gump, x + 20, 155, 0x35, "[Instalado]");
		elseif (g.has)
			GFAddButton(gump, x + 15, 160, 0xFA5, 0xFA7, GF_CLOSE_BTN, btn_id);
			GFTextLine(gump, x + 50, 158, 0x44, "Instalar");
		else
			GFTextLine(gump, x + 15, 155, 0x26, "Indisponivel");
		endif

		btn_id += 1;
		x += 125;
	endforeach

	// Remove button
	if (current)
		GFAddButton(gump, 155, 218, 0xFB1, 0xFB3, GF_CLOSE_BTN, 10);
		GFTextLine(gump, 190, 216, 0x26, "Remover gadget");
	endif

	var result := GFSendGump(who, gump);
	var butid := result[0];
	if (!butid)
		return 0;
	endif

	var ret := struct{};
	case (butid)
		1: ret.+"Canhao" := 1;
		2: ret.+"Arpao" := 1;
		3: ret.+"Armadilha" := 1;
		10: ret.+"Remover" := 1;
	endcase

	return ret;
endfunction

function _UnequipGadget(who, gadget_key)
	var objtype := 0;
	case (gadget_key)
		"handcannon": objtype := HANDCANNON_OBJTYPE;
		"harpoon":    objtype := HARPOON_OBJTYPE;
		"powdertrap": objtype := POWDERTRAP_OBJTYPE;
	endcase

	foreach equipped in ListEquippedItems(who)
		if (equipped.objtype == objtype)
			MoveItemToContainer(equipped, who.backpack);
			return 1;
		endif
	endforeach
	return 0;
endfunction
