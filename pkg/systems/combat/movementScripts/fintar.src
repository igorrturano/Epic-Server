
use uo;

include ":fls_core:packets";
include ":combat:Controller/DamageController_legacy";
include ":blood:blood";
include ":combat:Controller/FXController";
include ":combat:Model/AttackInfo";
include ":tn:cooldown";

program doubleattack(params)
	var attacker := params[1];
	var defender := params[2];
	var weapon := params[3];
	var armor := params[4];
	var basedamage := params[5];
	var rawdamage := params[6];
	params := 0; // Not needed anymore.

	PlayAttackFX(AttackInfo(MobileWrapper(attacker), MobileWrapper(defender)));
	PlayAttackSFX(AttackInfo(MobileWrapper(attacker), MobileWrapper(defender)));

	PrintTextAbove(attacker, "*finta*");

	// SetObjProperty(defender, "finta", ReadGameclock());
	SetCooldown(defender, "finta", 20);

endprogram
