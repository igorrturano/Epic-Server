use uo;
use util;
use vitals;
use cfgfile;

include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":wrappers:Objects/Model/MobileWrapper";
include "include/client";
include "include/sounds";
include ":attributes:vitals";
include ":attributes:attributes";
include ":equipsys:utils/consts";

function CanActivate(who)
	var itemdesc := ReadConfigFile(":*:itemdesc");
	foreach item in (ListEquippedItems(who))
		if (item.isa(POLCLASS_ARMOR))
			var tipoProtecao := CStr(itemdesc[item.objtype].TipoProtecao);
			if (tipoProtecao["Armadura"] && !tipoProtecao["Leve"])
				return true; // non-light armor found, cannot activate
			endif
		endif
	endforeach
	return false; // naked, clothes only, or light armor = can activate
endfunction

program HitScript(params)
	var attacker := params[1];
	var defender := params[2];
	var weaponObj := params[3];
	// var armor	:= params[4];
	// var basedamage	:= params[5];
	// var rawdamage	:= params[6];
	params := 0; // Not needed anymore.

	var leftHand := MobileWrapper(attacker).GetEquipBySlot(SHIELD);
	var weapon := WeaponWrapper(weaponObj);
	if (!CanActivate(attacker) && (!leftHand || leftHand is @Exception))
		var maxDmg := weapon.GetMainDamage().GetMaximum();
		var dmg := CInt((maxDmg + 4) / 5); // ceil(20% of max weapon damage)
		if (dmg > 0)
			var freeType := weapon.GetAttackType();
			if (!freeType || freeType is @Exception)
				freeType := DAMAGE_TYPE::BLUNT;
			endif
			DealDamage(defender, dmg, freeType, attacker);
		endif
	endif

	return 1;
endprogram
