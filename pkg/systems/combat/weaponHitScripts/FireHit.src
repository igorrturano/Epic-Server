use uo;
use util;

include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include "include/client";
include "include/sounds";

program HitScript(params)
	var attacker := params[1];
	var defender := params[2];
	// var weapon	:= params[3];
	// var armor	:= params[4];
	// var basedamage	:= params[5];
	var rawdamage := params[6];
	params := 0; // Not needed anymore.

	PlayObjectCenteredEffectEx(defender, FX_EXPLODE_1, 7, 16, COLOR_ELEMENTAL_FIRE);
	PlaySoundEffect(defender, SFX_EXPLOSION_11);

	// ApplyDamageEX(defender, RandomDiceRoll("1d3"), DAMAGE_TYPE::FIRE, attacker);
	// ApplyDamageEX(defender, (rawdamage*0.5)+1, DAMAGE_TYPE::FIRE);
	DealDamage(defender, cint((rawdamage * 0.5) + 1), DAMAGE_TYPE::FIRE, attacker);

	return 1;
endprogram
