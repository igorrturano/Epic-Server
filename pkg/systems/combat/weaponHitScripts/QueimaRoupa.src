use uo;
use vitals;
use util;

include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":wrappers:Objects/Model/WeaponWrapper";
include "include/client";
include "include/sounds";

program HitScript(params)

	var attacker := params[1];
	var defender := params[2];
	// var weapon	:= params[3];
	// var armor	:= params[4];
	// var basedamage	:= params[5];
	var rawdamage := params[6];
	params := 0; // Not needed anymore.

	var dmg;
	if (Distance(attacker, defender) == 2)
		dmg := rawdamage / 2;
	endif

	if (dmg > 10)
		dmg := 10;
	endif

	var qrType := WeaponWrapper(attacker.weapon).GetAttackType();
	if (!qrType || qrType is @Exception)
		qrType := DAMAGE_TYPE::BLUNT;
	endif
	DealDamage(defender, CInt(dmg), qrType, attacker);

	return 1;
endprogram
