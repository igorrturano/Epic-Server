// Internal
include ":combat:Controller/DamageController";
include ":combat:Controller/FXController";
include ":combat:Model/AttackInfo";

// External
include ":objWrapper:Model/MobileWrapper";
include ":objWrapper:Model/WeaponWrapper";
include ":mastery:CombatController";
include ":achievements:CombatController";
include ":IO:CFGFile";
include ":message:model/Message";

program MainHitScript(attackInfo)
	// Define attacker como o originador do ataque
	SetScriptController(attackInfo.GetAttacker().GetMobRef());

	if (attackInfo.GetDamageHand() == DAMAGEHAND::OFFHAND)
		SleepMS(OFFHAND_DELAY); // Adiciona delay para ataques com a segunda arma
	endif

	if (attackInfo.GetDefender().IsDead()) return 1; endif

	CheckBodyRegionToHit(attackInfo); // Verifica a parte do corpo a ser atingida
	CheckParry(attackInfo); // Verifica se o ataque foi parado // TODO: Falta fazer
	
	if (ConsumeAmmo(attackInfo)) // Consome munição, se aplicável
		CheckAmmoRecover(attackInfo); // Se consumiu, tenta recuperar
	endif

	CheckPoison(attackInfo);

	WeaponHitScripts(attackInfo);
	ArmorHitScripts(attackInfo);

	PlayAttackAnimation(attackInfo);
	ApplyCombatDamage(attackInfo);
	PlayAttackSound(attackInfo);

	MasteryCombat_Advance(attackInfo.GetAttacker().GetMobRef(), struct{ hits := 1, damage := attackInfo.GetDamage().GetTotalDamage() });
	AchievementCombat_Advance(attackInfo.GetAttacker().GetMobRef(), attackInfo.GetDefender().GetMobRef(), struct{ hits := 1, damage := attackInfo.GetDamage().GetTotalDamage() });

	return 1;
endprogram

function CheckBodyRegionToHit(byRef attackInfo)
	var zoneToHit := CS_GetRandomArmorZone();
	DebugMsg(attackInfo.GetAttacker().GetMobRef(), DEBUG_HIT, $"Região atingida: {zoneToHit}");
endfunction

function CheckParry(byRef attackInfo)
	var attackerPos := attackInfo.GetAttacker().GetPosition();
	if (attackInfo.GetAttacker().GetMobRef().GetProp("backstab") ||
		IsBehind(attackInfo.GetDefender().GetMobRef(), attackerPos.x, attackerPos.y) ||
		!attackInfo.GetDefender().IsWarMode())
		
		return false;
	endif

	TryToParry(attackInfo);

	return true;
endfunction

function TryToParry(byRef attackInfo)
	attackInfo.SetParryChance();
endfunction

function ConsumeAmmo(byRef attackInfo)
	return SubtractAmount(attackInfo.GetAmmo(), attackInfo.GetAmmoAmount());
endfunction

function CheckAmmoRecover(byRef attackInfo)
	if (attackInfo.GetDefender().GetObjRef().IsA(POLCLASS_NPC) && attackInfo.GetDefender().GetObjRef().backpack)
		var chance := CInt(CS_GetSettingsCfgElem("Archery").RecoverChance);

		if (CheckHab_ArrowRecovery(attackInfo.GetAttacker().GetMobRef(), 0, chance))
			chance += 15;
		endif

		if (RandomInt(100 + 1) <= chance)
			var ammo := attackInfo.GetAmmo();
			if (ammo)
				CreateItemInBackPack(attackInfo.GetDefender().GetMobRef(), ammo, attackInfo.GetAmmoAmount());
			endif
		endif
	endif
endfunction

function CheckPoison(byRef attackInfo)
	if (attackInfo.GetDamage().GetTotalDamage() < 1)
		return 0;
	endif

	if (GetObjProperty(weapon, "ammo"))
		var aljavas := array{ 0x791c, 0x2fb7 };
		var aljava := GetEquipmentByLayer(attacker, LAYER_CAPE);

		if (aljava.objtype in aljavas)
			var aljava := GetEquipmentByLayer(attacker, LAYER_CAPE);
		else
			aljava := GetEquipmentByLayer(attacker, LAYER_WAIST);
		endif
		var ammo := GetObjProperty(weapon, "ammo");
		foreach arrow in (EnumerateItemsInContainer(aljava))
			if (arrow.serial == ammo)
				weapon := arrow;
			endif
		endforeach
	endif

	if (!attacker.npctemplate) // se nao for npc checa se tem poison na arma
		if (attacker.graphic == 21)
			if (IsPoisonImune(defender, "defaultPoison"))
				return 0;
			endif
			if (randomint(100) < 20)
				if (CheckResist(defender, FORTITUDE, RESIST_EASY, -2 * 2))
					Message("Você resistiu ao veneno.", SSM_INFO).SendSys(defender);
				else
					TS_StartTimer(defender, "defaultPoison", 60, 2, attacker);
				endif
			endif
		else
			var poisonInfo := GetObjProperty(weapon, "poisonInfo");
			if (poisonInfo == error)
				return 0;
				updateToolTip(weapon);
			endif
			if (poisonInfo.dosage != "infinito")
				poisonInfo.dosage := poisonInfo.dosage - 1;
			endif
			if (poisonInfo.dosage <= 0 && poisonInfo.dosage != "infinito") // se nao tiver mais cargas de veneno, deleta
				EraseObjProperty(weapon, "poisonInfo");
				updateToolTip(weapon);
				return 0;
			else // se ainda tiver atualiza na arma
				SetObjProperty(weapon, "poisonInfo", poisonInfo);
			endif
			updateToolTip(weapon);

			if (IsPoisonImune(defender, poisonInfo.name))
				return 0;
			endif
			// Sempre que for mexer nesse timer, mexer também  no .arremessar ou criar funcao e chamar em ambos
			if (poisonInfo.name == "paralyzePoison")
				var duration := CInt(AP_GetSkill(attacker, SCIENCE) / 20);
				if (duration < 2)
					duration := 2;
				endif
				if (temHabilidade(attacker, "Veneno Puro"))
					duration := duration * 2;
				endif
				poisonInfo.time := duration;
			endif

			if (CheckResist(defender, FORTITUDE, poisonInfo.difficulty, -poisonInfo.difficulty_mod))
				Message("Você resistiu ao veneno.", SSM_INFO).SendSys(defender);
			else
				if (TS_GetTimerInfo(defender, "defaultPoison")) // confere se está sob default poison para estabelecer o mais forte
					var defaultpoison := cint(TS_GetTimerLevel(defender, "defaultPoison"));
					setobjproperty(defender, "#poisontier", defaultpoison);
				endif
				if (getobjProperty(defender, "#poisontier"))
					var poison := ts_gettimernames(defender, type := "P");
					var teste := cint(getobjProperty(defender, "#poisontier"));
					if (teste <= poisoninfo.tier)
						// compara o poison atual com o novo, substituindo caso o novo seja maior
						TS_LowerDuration(defender, poison, -1);
						TS_StartTimer(defender, poisonInfo.Name, poisonInfo.time, poisonInfo.level, attacker);
					endif
				else
					setobjproperty(defender, "#poisontier", poisonInfo.tier);
					setobjproperty(defender, "#poisonbonus", poisonInfo.difficulty_mod);
					TS_StartTimer(defender, poisonInfo.name, poisonInfo.time, poisonInfo.level, attacker);
				endif
			endif
		endif
	else // se for npc checa a skill
		if (temhabilidade(defender, "Senso da Natureza"))
			return 0;
		endif

		var npcelem := NPC_GetNPCConfig(attacker.npctemplate);
		var poisonchance := GetConfigInt(npcelem, "Poisoning");
		if (poisonChance > 0)
			if (RandomInt(100) < poisonChance)
				var poisonName := GetConfigString(npcelem, "PoisonType");
				var level := Cint(GetConfigInt(npcelem, "PoisonLevel"));
				if (!level)
					level := 1;
				endif
				if (poisonName == error)
					return 0;
				endif
				if (IsPoisonImune(defender, poisonName))
					return 0;
				endif
				var time := level * 15;
				if (poisonName == "paralyzePoison")
					time := 10;
				endif
				if (CheckResist(defender, FORTITUDE, RESIST_EASY, -2 * level))
					Message("Você resistiu ao veneno.", SSM_INFO).SendSys(defender);
				else
					TS_StartTimer(defender, poisonName, time, level, attacker);
				endif
			endif
		else
			return 0;
		endif
	endif
endfunction

function WeaponHitScripts(byRef attackInfo)
	// Script mantido como o anterior, modificado apenas a entrada dos parâmetros
	var attacker := attackInfo.GetAttacker().GetMobRef(),
		defender := attackInfo.GetDefender().GetMobRef(),
		weapon	 := attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef();

	var weaponCfg := CFGFile("*", "itemdesc").SetElementName(weapon.objtype);
	var weapon_scripts := array{};

	if (weapon.IsA(POLCLASS_WEAPON))
		weapon_scripts := GetObjProperty(weapon, "HitScripts");

		if (!weapon_scripts) weapon_scripts := array{}; endif

		var other_scripts := weaponCfg.SetKeyName("HitScripts").GetElementValue();

		foreach script in other_scripts
			weapon_scripts.Append(script);
		endforeach
	endif

	var hitopt;
	if (attacker.npctemplate)
		var npcCfg := CFGFile("combat", "npcdesc").SetElementName(attacker.npctemplate);
		var others_scripts := npcCfg.SetKeyName("HitScripts").GetElementValue();

		if (weapon_scripts == error) weapon_scripts := array{}; endif

		var body_scripts := GetObjProperty(attacker, "HitScripts");

		foreach oscript in others_scripts
			weapon_scripts.append(oscript);
		endforeach

		foreach oscript in body_scripts
			weapon_scripts.append(oscript);
		endforeach

		hitopt := GetObjProperty(attacker, "generichit");
	else
		hitopt := GetObjProperty(weapon, "generichit");
	endif

	foreach hitscript in weapon_scripts
		var script := start_script(
			hitscript,
			array{ attacker, defender, weapon, armor, basedamage, rawdamage, hitopt }
		);

		if (!script || script.errortext)
			Message("*Attacker* Weapon script error starting [" + hitscript + "] :" + script.errortext)
				.SendSys(attacker)
				.SendSys(defender);
		endif
		sleepms(2);
	endforeach

	if (GetCooldown(weapon, "ataqueelemental"))
		EraseObjProperty(weapon, "#ataqueelemental");
		var elemental := GetObjProperty(weapon, "#elementalweapon");
		var dmg := basedamage + CInt(rawdamage * (AP_GetSkill(attacker, ARCANA) / 100));
		dmg := ApplyChargesCalculation(weapon, dmg, 1);

		if (elemental != error)
			if (elemental.type == DMG_FIRE)
				start_script(
					":combat:weaponHitScripts/FireHit",
					array{ attacker, defender, weapon, armor, basedamage, dmg * 2 }
				);
			elseif (elemental.type == DMG_COLD)
				start_script(
					":combat:weaponHitScripts/IceHit",
					array{ attacker, defender, weapon, armor, basedamage, dmg * 2 }
				);
			elseif (elemental.type == DMG_ENERGY)
				start_script(
					":combat:weaponHitScripts/LightningHit",
					array{ attacker, defender, weapon, armor, basedamage, dmg * 2 }
				);
			endif
		endif
	endif

	var arcane_bows := array{ 0xFA6D, 0XF997 };
	if (GetCooldown(attacker, "arcane_bow") && weapon.objtype in arcane_bows)
		var dmg := basedamage + CInt(rawdamage * (AP_GetSkill(attacker, ARCANA) / 100));
		var arcane_damage := dmg * 0.5;

		if (TemHabilidade(attacker, "Tirothan"))
			arcane_damage := dmg * 1.0;
		endif

		if (GetObjProperty(attacker.weapon, "fire_arrow"))
			start_script(
				":combat:weaponHitScripts/FireHit",
				array{ attacker, defender, weapon, armor, basedamage, arcane_damage }
			);
		elseif (GetObjProperty(attacker.weapon, "cold_arrow"))
			start_script(
				":combat:weaponHitScripts/IceHit",
				array{ attacker, defender, weapon, armor, basedamage, arcane_damage }
			);
		elseif (GetObjProperty(attacker.weapon, "energy_arrow"))
			start_script(
				":combat:weaponHitScripts/LightningHit",
				array{ attacker, defender, weapon, armor, basedamage, arcane_damage }
			);
		endif
	endif

	if (GetObjProperty(attacker, "#golpesangrento")) // VIVISEC do Igor
		// EraseObjProperty(attacker, "#golpesangrento");
		var dmg := 1;
		if (TemHabilidade(attacker, "Golpe Afiado"))
			dmg := basedamage + CInt(rawdamage * (AP_GetSkill(attacker, TACTICS) / 100));
			PlaySoundEffect(attacker, 0x510);
		else
			dmg := basedamage + CInt(rawdamage * (AP_GetSkill(attacker, ALCHEMY) / 100));
			PlaySoundEffect(attacker, 0x511);
		endif
		start_script(
			":combat:weaponHitScripts/bleedingstrike",
			array{ attacker, defender, weapon, armor, basedamage, dmg * 2 }
		);
	endif

	if (GetCooldown(weapon, "circulodevas"))
		var elemental := GetObjProperty(weapon, "#elementalweapon");
		if (elemental != error)
			var dmg := AP_GetSkill(attacker, ARCANA) / 10;
			dmg := ApplyChargesCalculation(weapon, dmg, 2);
			if (dmg < 3)
				dmg := 3;
			endif
			start_script(
				":combat:weaponHitScripts/areadmg",
				array{ attacker, defender, weapon, armor, basedamage, dmg * 2, elemental.type, 3 }
			);
		endif
	endif

	if (getCooldown(attacker, "golpesamplos"))
		var dmg := AP_GetSkill(attacker, TACTICS) / 20;
		if (dmg < 1)
			dmg := 1;
		endif
		start_script(
			":combat:weaponHitScripts/areadmg",
			array{ attacker, defender, weapon, armor, basedamage, dmg, DMG_PHYSICAL }
		);
	endif

	if (GetCooldown(weapon, "habelemental"))
		EraseObjProperty(weapon, "#habelemental");
		var elemental := GetObjProperty(weapon, "#elementalweapon");
		if (elemental != error)
			start_script(
				":combat:weaponHitScripts/habelemental",
				array{ attacker, defender, weapon, armor, basedamage, rawdamage * 2, elemental.type, 3 }
			);
		endif
	endif

	return 1;
endfunction

function ArmorHitScripts(byRef attackInfo)
	// Script mantido como o anterior, modificado apenas a entrada dos parâmetros
	var attacker := attackInfo.GetAttacker().GetMobRef(),
		defender := attackInfo.GetDefender().GetMobRef(),
		weapon	 := attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetItemRef();

	var itemCfg := CFGFile("*", "itemdesc").SetElementName(armor.objtype);
	
	var body_scripts := GetObjProperty(defender, "ArmorHitScripts");
	var armor_scripts := GetObjProperty(armor, "ArmorHitScripts");
	var others_scripts := itemCfg.SetKeyName("ArmorHitScripts").GetElementValue();
	if (defender.npctemplate)
		var npcelem := NPC_GetNPCConfig(defender.npctemplate);
		var npcCfg := CFGFile("combat", "npcdesc").SetElementName(defender.npctemplate);
		others_scripts := npcCfg.SetKeyName("ArmorHitScripts").GetElementValue();
	endif
	if (!body_scripts)
		body_scripts := array{};
	endif
	if (!armor_scripts)
		armor_scripts := array{};
	endif
	if (!others_scripts)
		others_scripts := array{};
	endif

	if (GetCooldown(defender, "campoeletrico"))
		var e := start_script(
			":combat:armorHitScripts/campoeletrico",
			array{ attacker, defender, weapon, armor, basedamage, rawdamage }
		);
		if (e == error)
			Message(e).SendAbove(defender);
		endif
	endif

	armor_scripts := armor_scripts + body_scripts + others_scripts;

	foreach hitscript in armor_scripts
		var script := start_script(
			hitscript,
			array{ attacker, defender, weapon, armor, basedamage, rawdamage }
		);
		if (script.errortext)
			// Message("*Defender* armor script error starting [" + hitscript + "] :" + script.errortext)
			// 	.SendSys(attacker)
			// 	.SendSys(defender);
		endif
		sleepms(2);
	endforeach

	return 1;
endfunction

function DoParry(byRef attackInfo)
endfunction

function DoMovement(byRef attackInfo)
	var move := attackInfo.GetAttacker().GetObjRef().GetProp("movement");
	var movtime := CInt(attackInfo.GetAttacker().GetObjRef().GetProp("#movtime"));
	if (move != error)
		if (ReadGameClock() < movtime + 30)
			var e := start_script(
				CStr(move),
				array{
					attackInfo.GetAttacker().GetObjRef(),
					attackInfo.GetDefender().GetObjRef(),
					attackInfo.GetAttacker().GetEquipBySlot(WEAPON).GetObjRef(),
					armor,
					basedamage,
					rawdamage
				}
			);
			attackInfo.GetAttacker().GetObjRef().EraseProp("movement");
			return 1;
		else
			Message("Você perdeu seu ataque especial.", FONTCOLOR_INFO).SendSys(attackInfo.GetAttacker().GetObjRef());
			attackInfo.GetAttacker().GetObjRef().EraseProp("movement");
		endif
	endif
endfunction
