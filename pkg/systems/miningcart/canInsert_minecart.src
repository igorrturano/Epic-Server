use uo;
use cfgfile;

function IsRawMaterial(item)
    // Minérios originais e logs. Pode utilizar as CProps do FabricacaoUtil do Epic Server
    var isOre := (item.objtype >= 0x19B7 && item.objtype <= 0x19BA); 
    var isLog := (item.objtype == 0x1BDD);
    var hasMaterialProp := GetObjProperty(item, "material");
    
    if (isOre || isLog || hasMaterialProp)
        return 1;
    endif
    
    // Aceita qualquer item definido no itemdesc.cfg do pacote gathering
    var gathering_cfg := ReadConfigFile(":gathering:itemdesc");
    if (gathering_cfg[item.objtype])
        return 1;
    endif
    
    return 0;
endfunction

program canInsert_minecart(mobile, container, movetype, inserttype, adding_item, existing_stack, amount_to_add)
    if (!IsRawMaterial(adding_item))
        SendSysMessage(mobile, "Apenas materia-prima bruta (minerios e toras) pode ser colocada no carrinho.", 3, 0x22);
        return 0;
    endif
    return 1;
endprogram