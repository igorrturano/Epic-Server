use uo;
use os;
use util;

include ":minecart:minecart";

program move_minecart(params)
    var who := params[1];
    var cart := params[2];
    var startStop := params[3];
    
    if (GetObjProperty(cart, "#Moving"))
        SendSysMessage(who, "O carrinho ja esta em movimento.");
        return 0;
    endif
    
    var targetStop := FindTargetStop(startStop);
    if (!targetStop)
        SendSysMessage(who, "Nao encontrei a estacao de destino (terminal oposto) nesta linha.", 3, 0x22);
        return 0;
    endif
    
    var lineId := CInt(GetObjProperty(startStop, "LineId"));
    if (!lineId) lineId := 1; endif
    
    var path := ExecuteBFS(struct{ "x" := cart.x, "y" := cart.y }, struct{ "x" := targetStop.x, "y" := targetStop.y }, cart.realm, lineId);
    
    if (path.size() == 0)
        SendSysMessage(who, "Nao consegui tracar um caminho pelos trilhos.", 3, 0x22);
        return 0;
    endif
    
    SetObjProperty(cart, "#Moving", 1);
    SendSysMessage(who, "Carrinho iniciado.", 3, 0x44);
    PlaySoundEffect(cart, 0x03B7); // Som de partida/saida
    
    var i := 1;
    while (i <= path.size())
        if (!cart || !GetObjProperty(cart, "#Moving"))
            return 0;
        endif
        
        var next_pos := path[i];
        if (i > 1)
            var prev_pos := path[i-1];
            if ((next_pos.x - prev_pos.x) != 0)
                cart.graphic := EAST_ID;
            else
                cart.graphic := SOUTH_ID;
            endif
        endif
        
        var was_movable := cart.movable;
        cart.movable := 1;
        MoveObjectToLocation(cart, next_pos.x, next_pos.y, next_pos.z + 1, cart.realm, MOVEOBJECT_FORCELOCATION);
        cart.movable := was_movable;
        
        if (RandomFloat(1.0) < 0.25)
            PlaySoundEffect(cart, 0x022B); // Som de movimento mecanico
            PlayStationaryEffect(cart.x, cart.y, cart.z, 0x3728, 10, 10, 0, cart.realm);
        endif
        
        sleep(1); // 1.0s = Aprox C# 1.3s timer
        
        // Checagem de Teleporter
        var telepad := FindTelepadAround(cart.x, cart.y, cart.realm);
        if (telepad)
            var destX := CInt(GetObjProperty(telepad, "DestX"));
            var destY := CInt(GetObjProperty(telepad, "DestY"));
            var destZ := CInt(GetObjProperty(telepad, "DestZ"));
            var destRealm := GetObjProperty(telepad, "DestRealm");
            if (!destRealm) destRealm := cart.realm; endif
            
            cart.movable := 1;
            MoveObjectToLocation(cart, destX, destY, destZ, destRealm, MOVEOBJECT_FORCELOCATION);
            cart.movable := was_movable;
            PlayStationaryEffect(cart.x, cart.y, cart.z, 0x3728, 10, 10, 0, cart.realm);
            PlaySoundEffect(cart, 0x1FE);
            
            sleep(5); // TeleportCooldownTicks
            
            // Refaz BFS pós teleporte
            path := ExecuteBFS(struct{ "x" := cart.x, "y" := cart.y }, struct{ "x" := targetStop.x, "y" := targetStop.y }, cart.realm, lineId);
            i := 0; // Vai somar no final do laço para virar 1
        endif
        i += 1;
    endwhile
    
    if (Distance(cart, targetStop) <= 1)
        PrintTextAbove(cart, "Cheguei a estacao!");
        PlaySoundEffect(cart, 0x03B7); // Som de Chegada
    endif
    EraseObjProperty(cart, "#Moving");
endprogram

function ExecuteBFS(start_pos, goal_pos, realm, lineId)
    // Implementação básica de BFS para encontrar caminhos em malhas
    var queue := array{start_pos};
    var visited := dictionary{ CStr(start_pos.x)+"_"+CStr(start_pos.y) -> 1 };
    var cameFrom := dictionary{};
    var found := 0;
    var goal_node;
    
    var dirs := array{
        struct{ "x" := 1, "y" := 0 },
        struct{ "x" := -1, "y" := 0 },
        struct{ "x" := 0, "y" := 1 },
        struct{ "x" := 0, "y" := -1 }
    };

    var iterations := 0;
    var path := array{};
    
    while (queue.size() > 0 && iterations < 1000)
        var current := queue[1];
        queue.erase(1);
        iterations += 1;
        
        if (current.x == goal_pos.x && current.y == goal_pos.y)
            goal_node := current;
            found := 1;
            break;
        endif
        
        foreach d in dirs
            var nx := current.x + d.x;
            var ny := current.y + d.y;
            var key := CStr(nx)+"_"+CStr(ny);
            
            if (!visited.exists(key))
                var trackZ := IsTrackAt(nx, ny, realm, lineId);
                if (trackZ != error)
                    visited.insert(key, 1);
                    var next_node := struct{ "x" := nx, "y" := ny, "z" := trackZ };
                    cameFrom.insert(key, current);
                    queue.append(next_node);
                endif
            endif
            sleepms(2);
        endforeach
    endwhile
    
    if (found)
        var curr := goal_node;
        while (curr.x != start_pos.x || curr.y != start_pos.y)
            path.insert(1, curr);
            curr := cameFrom[CStr(curr.x)+"_"+CStr(curr.y)];
        endwhile
    endif

    return path;
endfunction