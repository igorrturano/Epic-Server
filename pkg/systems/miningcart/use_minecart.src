use uo;
use os;

program use_minecart(who, cart)
    // Se o carrinho estiver solto (movable = 1), gira o gráfico
    if (cart.movable)
        var flips := GetObjProperty(cart, "Flips");
        if (flips)
            var flip_arr := SplitWords(flips, ",");
            var current_idx := 0;
            
            for i := 1 to flip_arr.size()
                if (CInt(flip_arr[i]) == cart.graphic)
                    current_idx := i;
                    break;
                endif
            endfor
            
            var next_idx := current_idx + 1;
            if (next_idx > flip_arr.size())
                next_idx := 1;
            endif
            
            cart.graphic := CInt(flip_arr[next_idx]);
        endif
        return 1; // Anula a abertura do container
    endif
    
    // Se estiver fixo (movable = 0), força a abertura da janela do container
    SendViewContainer(who, cart);
    return 1;
endprogram