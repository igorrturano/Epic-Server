use uo;
use os;

program use_trackTile(who, tile)
    // Se o trilho estiver solto (movable = 1), permite girar
    if (tile.movable)
        var flips := GetObjProperty(tile, "Flips");
        if (flips)
            var flip_arr := SplitWords(flips, ",");
            var current_idx := 0;
            
            for i := 1 to flip_arr.size()
                if (CInt(flip_arr[i]) == tile.graphic)
                    current_idx := i;
                    break;
                endif
            endfor
            
            var next_idx := current_idx + 1;
            if (next_idx > flip_arr.size())
                next_idx := 1;
            endif
            
            tile.graphic := CInt(flip_arr[next_idx]);
        endif
    endif
    return 1;
endprogram