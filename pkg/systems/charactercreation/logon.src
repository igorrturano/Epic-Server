use uo;
use os;
include ":message:include/model/Message";
include ":wrappers:Objects/Model/MobileWrapper";

// Repairs the buyhab dict for a character who just completed a stone-driven
// migration. The migrationStone sets `migration_preserve` and the creation
// flow leaves it in place after the XP/Level/name restore; logon (here)
// treats its presence as the repair flag, resets all odd-level slots
// (1, 3, 5, ..., 19) up to the character's current level so they can
// re-spend the stat purchases stranded by the rework, then erases the
// property so the repair only fires once.
function RepairMigratedBuyhab(who)
    var preserve := GetObjProperty(who, "migration_preserve");
    if (preserve == error || !preserve)
        return;
    endif

    var habs := GetObjProperty(who, "buyhab");
    if (habs == error || !habs)
        habs := dictionary;
    endif

    var curr_level := CInt(GetObjProperty(who, "Level"));
    if (curr_level < 1)
        curr_level := 1;
    endif

    var level;
    for (level := 1; level <= curr_level; level := level + 1)
        if (level % 2 == 1)
            habs[level] := 1;
        endif
    endfor

    SetObjProperty(who, "buyhab", habs);
    EraseObjProperty(who, "migration_preserve");

    Message("Sua redistribuição de status foi liberada — abra o menu de habilidades para reaplicar.")
        .SetColor(SSM_INFO)
        .SendSys(who);
endfunction

program createChar(who)
    var creation_completed := GetObjProperty(who, "creation_completed");

    // One-shot migration repair: runs once per char after the migration
    // stone, before bailing out for already-created chars.
    RepairMigratedBuyhab(who);

    // If already completed, never run again. Before bailing, recompute the
    // carry-weight mod from current sources (single source of truth). This
    // self-heals every existing character that still carries a drifted
    // carrying_capacity_mod from the old scattered +=/-=/:= era — idempotent,
    // so running it on every login is safe.
    if (creation_completed)
        MobileWrapper(who).RecalcCarryWeightMod();
        return;
    endif
    
    // Check if there's incomplete creation data
    var chardata := GetObjProperty(who, "chardata");
    
    if (chardata)
        // Character creation is broken/incomplete
        Message("Criação de personagem incompleta ou corrompida. Por favor, delete este personagem e crie um novo. Contate um GM se precisar de assistência.")
            .SetColor(SSM_FAIL)
            .SendSys(who);

            SetObjProperty(who, "Delete", 1); // Insta logoff
            
            sleep(1);
            DisconnectClient(who);
        return;
    endif
    
    // Start the creation process (only once)
    Start_Script(":charactercreation:epicgumpcriacao", who);
endprogram