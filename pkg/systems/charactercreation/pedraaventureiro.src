include ":tn:tngumps";
include ":charactercreation:habilidades";
include "include/say";
include ":gumps:yesNo";
include ":gumps:requestGump";

program pergrad(who, item)
	if (who.cmdlevel >= 1)
		if (YesNo(who, "Deseja configurar a pedra?"))
			SetObjProperty(item, "Nome", RequestGump(who, "Coloque o Nome da Pedra"));
			SetObjProperty(item, "Lado", RadioGump(who, 260, 160, "Por qual lado da pedra os jogadores virao?",
			   			array{ "Esquerda", "Direita" }));
			return;
		endif
	endif
	SendSysMessageEx(who, "Esta pedra nao reage a voce.", SSM_FAIL);
endprogram
