include ":charactercreation:habilidades";
use cfgfile;
include ":tn:tngumps";
include "include/say";
include ":attributes:attributes";
include "include/epicConstants";
include ":expbar:expbar";

program pergrad(who, item)
	Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1); // Adicionado para diminuir a quantidade de logs no arquivo script.log
	if (getObjProperty(item, "owner"))
		if (getObjProperty(item, "owner") != who.serial)
			SendSysMessage(who, "Esse é um conhecimento adquirido, não pode ser dado ou vendido.");
			return 0;
		endif
	endif

	var resultado := comprarHabilidade(who, item, -1);
	// Apos consumir este pergaminho, drena a fila — se LevelUp tinha pergaminhos
	// que nao couberam na mochila na hora, agora libera espaco e eles entram.
	EntregarPergaminhosPendentes(who);
	return resultado;
endprogram
