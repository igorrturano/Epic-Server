use uo;
use os;

include ":combat:Model/AttackInfo";
include ":combat:Model/CombatAbility";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":timedScripts:timedScripts";
include ":attributes:attributes";
include "include/client";

program murderblow(attackInfo)
	// Ignore armor and apply stun when Murder-blow is active
	if (attackInfo.GetAttacker().GetProperty("#murderblow"))
		IgnoreArmorAndStun(attackInfo);
		attackInfo.GetAttacker().EraseProperty("#murderblow");
	endif

	// Passive: Attack nearby enemy on kill
	if (attackInfo.GetDefender().GetCurrentHP() <= 0)
		if (attackInfo.GetAttacker().HasAbility(COMBAT_ABILITY::MURDER_BLOW))
			AttackNearbyEnemyOnKill(attackInfo);
		endif
	endif

	return true;
endprogram

/**
 * IgnoreArmorAndStun
 *
 * The murder-blow technique strikes a vulnerable point, ignoring armor
 * and stunning the target based on the attacker's Tactics skill
 */
function IgnoreArmorAndStun(byref attackInfo)
	// Reduce all armor resistance to minimal values (ignoring armor)
	var currentDamage := attackInfo.GetDamage();

	// Get the total raw damage (before armor reduction)
	var slashRaw := currentDamage.GetSlashRawDamage();
	var piercingRaw := currentDamage.GetPiercingRawDamage();
	var bluntRaw := currentDamage.GetBluntRawDamage();

	// Calculate how much was reduced by armor
	var slashReduced := slashRaw - currentDamage.GetSlashBaseDamage();
	var piercingReduced := piercingRaw - currentDamage.GetPiercingBaseDamage();
	var bluntReduced := bluntRaw - currentDamage.GetBluntBaseDamage();

	// Restore 70% of the armor-reduced damage (representing ignoring most armor)
	if (slashReduced > 0)
		currentDamage.IncreaseSlashBaseDamage(CInt(slashReduced * 0.7));
	endif
	if (piercingReduced > 0)
		currentDamage.IncreasePiercingBaseDamage(CInt(piercingReduced * 0.7));
	endif
	if (bluntReduced > 0)
		currentDamage.IncreaseBluntBaseDamage(CInt(bluntReduced * 0.7));
	endif

	// Calculate stun duration based on Tactics skill
	var tactics := AP_GetSkill(attackInfo.GetAttacker().GetObjRef(), TACTICS);
	var stunDuration := CInt(tactics / 10); // 1 second per 10 Tactics

	if (stunDuration < 2)
		stunDuration := 2; // Minimum 2 seconds
	endif
	if (stunDuration > 10)
		stunDuration := 10; // Maximum 10 seconds
	endif

	// Apply paralysis (stun) effect
	TS_StartTimer(attackInfo.GetDefender().GetObjRef(), "paralysis", stunDuration);

	Message("*acerta em cheio um ponto vulnerável com golpe mortal!*")
		.SendAbove(attackInfo.GetAttacker().GetObjRef());

	Message("*é atingido em um ponto vulnerável e fica atordoado!*", Color(SYSTEM_COLOR::FAIL))
		.SendAbove(attackInfo.GetDefender().GetObjRef());

	DebugMsg(
		attackInfo.GetAttacker().GetObjRef(),
		DEBUG_HAB,
		Message($"Possui Habilidade[{COMBAT_ABILITY::MURDER_BLOW}]: Ignorou 70% da armadura e aplicou {stunDuration}s de atordoamento!", Color(SYSTEM_COLOR::SUCCESS))
	);

	return true;
endfunction

/**
 * AttackNearbyEnemyOnKill
 *
 * Passive effect: When killing an opponent, immediately attack another nearby enemy
 * Similar to Trespassar ability
 */
function AttackNearbyEnemyOnKill(byref attackInfo)
	// Prevent infinite loop
	if (attackInfo.GetAttacker().GetObjRef().GetProp("#murderblowing") == 1)
		return false;
	endif

	// Find nearby hostile targets
	var hostileList := array{};
	foreach mobile in (ListHostiles(attackInfo.GetAttacker().GetObjRef(), 2, LH_FLAG_LOS))
		// Don't attack self or the just-killed defender
		if ((mobile.serial != attackInfo.GetAttacker().GetSerial()) &&
		    (mobile.serial != attackInfo.GetDefender().GetSerial()) &&
		    (GetVital(mobile, HITS) > 0))
			hostileList.append(mobile);
		endif
	endforeach

	// If there are nearby enemies, attack one
	if (hostileList.size() > 0)
		attackInfo.GetAttacker().GetObjRef().SetProp("#murderblowing", 1);

		var nextTarget := hostileList[RandomInt(hostileList.size()) + 1];
		nextTarget := MobileWrapper(nextTarget);

		Message("*executa o oponente e imediatamente ataca outro inimigo!*")
			.SendAbove(attackInfo.GetAttacker().GetObjRef());

		attackInfo.GetAttacker().Attack(nextTarget);

		attackInfo.GetAttacker().EraseProperty("#murderblowing");

		DebugMsg(
			attackInfo.GetAttacker().GetObjRef(),
			DEBUG_HAB,
			Message($"Possui Habilidade[{COMBAT_ABILITY::MURDER_BLOW}] (Passiva): Atacou inimigo próximo após execução!", Color(SYSTEM_COLOR::SUCCESS))
		);

		return true;
	endif

	return false;
endfunction
