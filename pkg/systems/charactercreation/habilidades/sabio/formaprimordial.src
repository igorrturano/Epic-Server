use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":attributes:attributes";
include "include/client";

const SPELL_BTN := 200;
const GUMPID_FORMAPRIMORDIAL := 0x00001D;

program formaprimordial(params)
	var player := params[1];

	// Check if player is in metamorphose
	var metamorfose := GetObjProperty(player, "metamorfose");
	if (!metamorfose)
		SendSysMessageEx(player, "Você precisa estar em forma animal para usar esta habilidade.", SSM_FAIL);
		return;
	endif

	SendSysMessage(player, "Escolha o elemento primordial para fundir com sua forma");

	var input := create_elemental_gump(player);
	if (input[0] == 201) // Fire
		ClearElementalProperties(player);
		if (!GetObjProperty(player, "primordial_fire"))
			SetObjProperty(player, "primordial_fire", 1);
		endif
	elseif (input[0] == 202) // Cold
		ClearElementalProperties(player);
		if (!GetObjProperty(player, "primordial_cold"))
			SetObjProperty(player, "primordial_cold", 1);
		endif
	elseif (input[0] == 203) // Energy
		ClearElementalProperties(player);
		if (!GetObjProperty(player, "primordial_energy"))
			SetObjProperty(player, "primordial_energy", 1);
		endif
	elseif (input[0] == 204) // Poison
		ClearElementalProperties(player);
		if (!GetObjProperty(player, "primordial_poison"))
			SetObjProperty(player, "primordial_poison", 1);
		endif
	elseif (input[0] == 205) // Neutral/Deactivate
		ClearElementalProperties(player);
		SendSysMessageEx(player, "Você retorna sua forma ao estado natural.", SSM_INFO);
		PlaySoundEffect(player, 0x1F3);
		return;
	endif

	player.frozen := 1;
	var sound := 0x666; // Energy default
	var elementName := "Energia";

	if (GetObjProperty(player, "primordial_fire"))
		sound := 0x5cb;
		elementName := "Fogo";
		// Apply fire resistance
		ApplyElementalResistance(player, "fire");
	elseif (GetObjProperty(player, "primordial_cold"))
		sound := 0x5c8;
		elementName := "Gelo";
		// Apply cold resistance
		ApplyElementalResistance(player, "cold");
	elseif (GetObjProperty(player, "primordial_energy"))
		sound := 0x666;
		elementName := "Energia";
		// Apply energy resistance
		ApplyElementalResistance(player, "energy");
	elseif (GetObjProperty(player, "primordial_poison"))
		sound := 0x247;
		elementName := "Veneno";
		// Apply poison resistance
		ApplyElementalResistance(player, "poison");
	endif

	PrintTextAbove(player, "*Fundindo-se com o elemento " + elementName + "*");
	PlaySoundEffect(player, sound);
	sleep(2);
	PlaySoundEffect(player, 0x656); // purgeMagic
	sleep(1);

	// Visual effect based on element
	var effectId := 0x3709; // Default energy effect
	if (GetObjProperty(player, "primordial_fire"))
		effectId := 0x3709; // Fire effect
	elseif (GetObjProperty(player, "primordial_cold"))
		effectId := 0x374A; // Cold effect
	elseif (GetObjProperty(player, "primordial_poison"))
		effectId := 0x374A; // Poison effect (green)
	endif

	PlayObjectCenteredEffect(player, effectId, 7, 16);

	player.frozen := 0;
	SendSysMessageEx(player, "Sua forma agora pulsa com o poder do elemento " + elementName + "!", SSM_INFO);

endprogram

function ClearElementalProperties(player)
	EraseObjProperty(player, "primordial_fire");
	EraseObjProperty(player, "primordial_cold");
	EraseObjProperty(player, "primordial_energy");
	EraseObjProperty(player, "primordial_poison");
	// Clear previous resistances
	ClearElementalResistances(player);
endfunction

function ApplyElementalResistance(player, element)
	// Clear all elemental resistances first
	ClearElementalResistances(player);

	// Apply resistance bonus to the chosen element (30% resistance)
	var resistBonus := 30;

	case(element)
		"fire":
			SetObjProperty(player, "primordial_resist_fire", resistBonus);
			player.resist_fire_mod := player.resist_fire_mod + resistBonus;
			break;
		"cold":
			SetObjProperty(player, "primordial_resist_cold", resistBonus);
			player.resist_cold_mod := player.resist_cold_mod + resistBonus;
			break;
		"energy":
			SetObjProperty(player, "primordial_resist_energy", resistBonus);
			player.resist_energy_mod := player.resist_energy_mod + resistBonus;
			break;
		"poison":
			SetObjProperty(player, "primordial_resist_poison", resistBonus);
			player.resist_poison_mod := player.resist_poison_mod + resistBonus;
			break;
	endcase
endfunction

function ClearElementalResistances(player)
	// Remove resistance bonuses
	var fireResist := GetObjProperty(player, "primordial_resist_fire");
	if (fireResist)
		player.resist_fire_mod := player.resist_fire_mod - fireResist;
		EraseObjProperty(player, "primordial_resist_fire");
	endif

	var coldResist := GetObjProperty(player, "primordial_resist_cold");
	if (coldResist)
		player.resist_cold_mod := player.resist_cold_mod - coldResist;
		EraseObjProperty(player, "primordial_resist_cold");
	endif

	var energyResist := GetObjProperty(player, "primordial_resist_energy");
	if (energyResist)
		player.resist_energy_mod := player.resist_energy_mod - energyResist;
		EraseObjProperty(player, "primordial_resist_energy");
	endif

	var poisonResist := GetObjProperty(player, "primordial_resist_poison");
	if (poisonResist)
		player.resist_poison_mod := player.resist_poison_mod - poisonResist;
		EraseObjProperty(player, "primordial_resist_poison");
	endif
endfunction

function create_elemental_gump(player)
	var gump := GFCreateGump();
	var elementos := array{};
	elementos.Append("Fogo");
	elementos.Append("Gelo");
	elementos.Append("Energia");
	elementos.Append("Veneno");
	elementos.Append("Neutro (Desativar)");

	GFResizePic(gump, 17, 31, 9390, 359, 125 + elementos.size() * 26);
	GFHTMLArea(gump, 114, 69, 192, 20, "<BASEFONT Size=5 Color=#999999 >Forma Primordial", 0, 0); // shadow
	GFHTMLArea(gump, 116, 71, 192, 20, "<BASEFONT Size=5 Color=#999999 >Forma Primordial", 0, 0); // shadow
	GFHTMLArea(gump, 115, 70, 192, 20, "<BASEFONT Size=5 Color=#ffffff >Forma Primordial", 0, 0);
	GFGumpPic(gump, 63, 91, 1469);
	GFGumpPic(gump, 80, 91, 1469);
	GFTextLine(gump, 63, 100, 0, "Elemento Primordial");
	GFTextLine(gump, 259, 100, 0, "Escolher");
	GFGumpPic(gump, 38, 103, 9773, 0);
	GFGumpPic(gump, 296, 0, 9000, 0);

	var y := 121;
	var i := 0;
	for (i := 1; i <= elementos.size(); i++)
		var elemento := elementos[i];

		var color := "#000000";
		// Highlight currently active element
		if (i == 1 && GetObjProperty(player, "primordial_fire"))
			color := "#FF0000"; // Red for fire
		elseif (i == 2 && GetObjProperty(player, "primordial_cold"))
			color := "#00FFFF"; // Cyan for cold
		elseif (i == 3 && GetObjProperty(player, "primordial_energy"))
			color := "#FFFF00"; // Yellow for energy
		elseif (i == 4 && GetObjProperty(player, "primordial_poison"))
			color := "#00FF00"; // Green for poison
		endif

		GFHTMLArea(gump, 63, y, 192, 24, "<BASEFONT color=" + color + ">" + elemento, 1, 0);
		GFAddButton(gump, 274, y + 5, 10006, 10006, GF_CLOSE_BTN, 200 + i);
		sleepms(2);
		y += 26;
	endfor

	return GFSendGump(player, gump);
endfunction