use uo;
use os;
use util;
use cfgfile;

include ":gumps:gumps";
include ":taming:taming";
include "include/client";
include "include/say";
include "include/sounds";
include ":attributes:attributes";
include ":attributes:skillCheck";
include ":tn:boss";
include ":spells:summon";
include ":timedScripts:timedScripts";
include "include/epicConstants";
include "include/packets";

const BTN_SUMMON := 200;
const BTN_BOND := 100;

program convocacaoselvagem(who)
	// Check if player has any bonded creatures
	var bonded_creatures := GetObjProperty(who, "spirit_bonds");

	if (!bonded_creatures)
		bonded_creatures := array;
	endif

	if (bonded_creatures.size() == 0)
		// No bonded creatures, go straight to bonding
		PerformAction(who, ANIM_CAST_AREA);
		return BondWithCreature(who);
	else
		// Has bonded creatures, show gump with options
		return ShowSpiritBondsGump(who, bonded_creatures);
	endif
endprogram

// Function to show the main gump with summon and bond options
function ShowSpiritBondsGump(who, bonded_creatures)
	var input := CreateSummonGump(who, bonded_creatures);

	if (!input[0] || input[0] == 0)
		return 0;
	endif

	if (input[0] == BTN_BOND)
		// Player wants to bond with a new creature
		return BondWithCreature(who);
	elseif (input[0] >= BTN_SUMMON)
		// Player wants to summon an existing bond
		var selected_index := input[0] - BTN_SUMMON;
		if (selected_index < 1 || selected_index > bonded_creatures.size())
			return 0;
		endif

		var selected_creature := bonded_creatures[selected_index];
		return SummonSelectedCreature(who, selected_creature);
	endif

	return 0;
endfunction

// Function to bond with a new creature
function BondWithCreature(who)
	SendSysMessageEx(who, "Escolha uma criatura selvagem para criar um vinculo espiritual.", SSM_REQUEST);
	var targ := Target(who);

	// Check validity of the target
	if (!IsValidBondTarget(who, targ))
		return 0;
	endif

	// Get player's Theology skill
	var theology := AP_GetSkill(who, THEOLOGY);
	var max_tier := CInt(theology / 20);

	if (max_tier < 1)
		max_tier := 1;
	elseif (max_tier > 5)
		max_tier := 5;
	endif

	// Get creature's tier
	var creature_tier := CInt(targ.getTier());
	if (!creature_tier)
		creature_tier := 1;
	endif

	// Check if the player's skill is high enough
	if (creature_tier > max_tier)
		SendSysMessageEx(who, "A criatura " + targ.name + " e poderosa demais para voce criar um vinculo. (Tier " + creature_tier + " requer " + (creature_tier * 20) + " de Theology)", SSM_FAIL);
		return 0;
	endif

	// Set a cooldown property to prevent spamming attempts
	SetObjProperty(who, "#bondwait", ReadGameClock() + 5);

	// Begin the bonding attempt loop
	var info := struct;
	info.+x := who.x;
	info.+y := who.y;
	info.+facing := who.facing;
	info.+difficulty := creature_tier * 20;

	while (BondLoop(who, targ, info))
		SetObjProperty(who, "#bondwait", ReadGameClock() + 5);
		sleep(3);

		// Check if the bonding attempt is successful based on the player's skill
		if (SkillCheck(who, THEOLOGY, CInt(info.difficulty)) > 0)
			SendSysMessageEx(who, "Voce criou um vinculo espiritual com " + targ.name + ".", SSM_INFO);
			
			PerformAction(who, ANIM_CAST_DIR);
			PlayMovingEffectXYZHued(who, targ, 0xF79, 10, 10, 0, 0);

			// Store the creature bond
			StoreBond(who, targ);

			PlaySoundEffect(who, SFX_SPELL_SUMMON_ELEMENTAL);
			PlayStationaryEffect(targ.x, targ.y, targ.z, EPIC_FX_TELEPORT, 10, 30, 0, who.realm);
			targ.hidden := 1;
			MoveObjectToLocation(targ, 6143, 0, 0, "britannia_alt", MOVEOBJECT_FORCELOCATION);

			ApplyRawDamage(targ, AP_GetVital(targ, "Hits") + 100);
			break; // Exit the loop after successful bond
		else
			SendSysMessageEx(who, "Voce falhou em criar um vinculo espiritual com " + targ.name + ".", SSM_FAIL);
			return 0;
		endif
	endwhile

	return 1;
endfunction

// Function to summon a selected creature
function SummonSelectedCreature(who, selected_creature)
	// Ask for target location
	SendSysMessageEx(who, "Escolha o local para invocar " + selected_creature.name + ".", SSM_REQUEST);
	var targ := TargetCoordinates(who);

	if (!targ)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return 0;
	endif

	// Visual and sound effects
	PerformAction(who, ANIM_CAST_DIR);
	PlaySoundEffect(who, SFX_SPELL_SUMMON_CREATURE);
	PlayStationaryEffect(targ.x, targ.y, targ.z, EPIC_FX_SUMMON_BEAST, 10, 30, 0, who.realm);

	// Summon the creature
	sleepms(1500);

	var creature := summon(selected_creature.template, targ, who);
	creature.color := 30000; // Spirit hue
	if (!creature)
		SendSysMessageEx(who, "Falha ao invocar o espirito.", SSM_FAIL);
		return 0;
	endif

	PrintTextAbove(who, "*invocando " + selected_creature.name + "*");
	SendSysMessageEx(who, "Voce invocou " + selected_creature.name + "!", SSM_INFO);
	// Set summon duration based on Theology skill
	var theology := AP_GetSkill(who, THEOLOGY);
	var duration := 60 + (theology * 3);
	var level := CInt(theology / 5) + 5;

	TS_StartTimer(creature, "summon", duration, level);

	return 1;
endfunction

// Function to create the summon selection gump
function CreateSummonGump(who, bonded_creatures)
	var gump := GFCreateGump();

	// Calculate theology for max bonds info
	var theology := AP_GetSkill(who, THEOLOGY);
	var max_bonds := CInt(theology / 20);
	if (max_bonds < 1)
		max_bonds := 1;
	elseif (max_bonds > 5)
		max_bonds := 5;
	endif

	var size := bonded_creatures.size() * 26 + 60; // Extra space for bond button

	GFResizePic(gump, 17, 31, 9390, 359, 125 + size);
	GFHTMLArea(gump, 94, 69, 232, 20, "<BASEFONT Size=5 Color=#999999 >Convocacao Selvagem", 0, 0); // shadow
	GFHTMLArea(gump, 96, 71, 232, 20, "<BASEFONT Size=5 Color=#999999 >Convocacao Selvagem", 0, 0); // shadow
	GFHTMLArea(gump, 95, 70, 232, 20, "<BASEFONT Size=5 Color=#2d8a2d >Convocacao Selvagem", 0, 0);
	GFGumpPic(gump, 63, 91, 1469);
	GFGumpPic(gump, 80, 91, 1469);
	GFTextLine(gump, 63, 100, 0, "Espiritos Vinculados");
	GFTextLine(gump, 259, 100, 0, "Tier");
	GFTextLine(gump, 304, 100, 0, "Invocar");
	GFGumpPic(gump, 38, 103, 9773, 0);
	GFGumpPic(gump, 296, 0, 9000, 0);

	var y := 121;
	foreach creature in bonded_creatures
		var color := "2d8a2d";
		GFHTMLArea(gump, 63, y, 192, 24, "<BASEFONT color=#{}>{}".format(color, creature.name), 1, 0);
		GFHTMLArea(gump, 259, y, 34, 24, "<center>{}".format(creature.tier), 1, 0);
		GFAddButton(gump, 319, y + 4, 10006, 10006, GF_CLOSE_BTN, BTN_SUMMON + _creature_iter);
		sleepms(2);
		y += 26;
	endforeach

	// Add separator line
	y += 10;
	GFGumpPic(gump, 38, y, 9773, 0);
	y += 10;

	// Show bond slots info and bond button
	var bond_info := "Vinculos: {}/{}".format(bonded_creatures.size(), max_bonds);
	GFHTMLArea(gump, 63, y, 192, 24, "<BASEFONT color=#2d8a2d>{}".format(bond_info), 0, 0);

	// Only show bond button if there's room for more bonds
	if (bonded_creatures.size() < max_bonds)
		GFAddButton(gump, 319, y + 4, 10006, 10006, GF_CLOSE_BTN, BTN_BOND);
		GFTextLine(gump, 304, y -20 , 0, "Vincular");
	else
		GFGumpPic(gump, 319, y + 5, 10006, 1891); // Grayed out button
		GFTextLine(gump, 304, y - 20, 1890, "Vincular");
	endif

	return GFSendGump(who, gump);
endfunction

// Function to check if the target is valid for bonding
function IsValidBondTarget(who, targ)
	if (!targ.IsA(POLCLASS_NPC))
		SendSysMessageEx(who, "Essa nao e uma criatura valida.", SSM_FAIL);
		return 0;
	endif

	// Check if it's an animal
	if (!targ.isAnimalBrain())
		SendSysMessageEx(who, "Voce so pode criar vinculos com animais selvagens.", SSM_FAIL);
		return 0;
	endif

	if (targ.script[":ghaia:tamed"])
		SendSysMessageEx(who, "Voce so pode criar vinculos com criaturas selvagens.", SSM_FAIL);
		return 0;
	endif

	if (!CheckLineOfSight(who, targ))
		SendSysMessageEx(who, "Voce nao pode ver claramente a criatura!", SSM_FAIL);
		return 0;
	endif

	if (isTrueBoss(targ))
		SendSysMessageEx(who, "Essa criatura poderosa nao pode ser vinculada.", SSM_FAIL);
		return 0;
	endif

	return 1;
endfunction

// Function to store the creature bond
function StoreBond(who, targ)
	var theology := AP_GetSkill(who, THEOLOGY);
	var max_bonds := CInt(theology / 20);

	if (max_bonds < 1)
		max_bonds := 1;
	elseif (max_bonds > 5)
		max_bonds := 5;
	endif

	// Create a new struct to store the bond details
	var bond := struct;
	bond.+name := targ.name;
	bond.+template := targ.npctemplate;
	bond.+tier := CInt(targ.getTier());

	// Check if the player already has a list of bonds
	var bond_list := GetObjProperty(who, "spirit_bonds");

	if (bond_list == error)
		bond_list := array;
	endif

	// Check if a bond with the same template already exists
	foreach old_bond in bond_list
		if (old_bond.template == targ.npctemplate)
			SendSysMessageEx(who, "Voce ja tem um vinculo com " + targ.name + ". O vinculo foi renovado.", SSM_INFO);
			bond_list.erase(_old_bond_iter);
			break;
		endif
	endforeach

	// Remove the oldest entry if the list exceeds the max bonds allowed
	if (bond_list.size() >= max_bonds)
		var old_bond := bond_list[1];
		SendSysMessageEx(who, "Ao criar um novo vinculo com " + targ.name + ", voce perde o vinculo com " + old_bond.name + ".", SSM_FAIL);
		bond_list.erase(1);
	endif

	// Add the new bond to the end of the list
	bond_list.append(bond);

	SetObjProperty(who, "spirit_bonds", bond_list);

	SendSysMessageEx(who, "Voce agora tem " + bond_list.size() + " vinculo(s) espiritual(is).", SSM_INFO);
endfunction

// Function to check bonding conditions
function BondLoop(who, targ, byref info)
	var my_hostiles := ListHostiles(who, 15);
	var targ_hostiles := ListHostiles(targ, 15);

	if (targ.master)
		SendSysMessageEx(who, "Voce so pode criar vinculos com criaturas selvagens.", SSM_FAIL);
		return 0;
	elseif (targ_hostiles.size() > 0)
		SendSysMessageEx(who, "O animal " + targ.name + " esta sob ataque e nao pode ser vinculado agora.", SSM_FAIL);
		return 0;
	elseif (my_hostiles.size() > 0)
		SendSysMessageEx(who, "Voce nao pode criar um vinculo com " + targ.name + " enquanto esta sendo atacado.", SSM_FAIL);
		return 0;
	elseif (Distance(who, targ) > 6)
		SendSysMessageEx(who, "Voce esta muito longe da criatura para criar um vinculo.", SSM_FAIL);
		return 0;
	endif

	PerformAction(who, ANIM_CAST_AREA);
	PrintTextAbove(who, "*criando um vinculo espiritual com " + targ.name + "*");

	return 1;
endfunction
