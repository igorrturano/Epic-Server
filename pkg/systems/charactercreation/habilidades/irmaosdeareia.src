use uo;

include ":attributes:attributes";
include ":timedScripts:timedScripts";
include "include/say";
include ":tn:cooldown";
include ":spells:summon";
include "include/client";
include "include/dungeons";
include "include/epicCombatUtils";

program summonSkeletaSteed(params)
    var who := params[1];

    var i := 0;
    who.frozen := 1;
    while (i < 4)
        PerformAction(who, ANIM_CAST_DIR);
        sleep(1);
        i++;
    endwhile
    who.frozen := 0;

    // Get all mobiles around caster
    var all_mobiles := listAllMobilesNearbyButPetsAndParty(who, 8);
    var excluded_serials := array{who.serial};
    var allies := array{};

    // Build list of allies (party members and their pets)
    if (who.party)
        foreach member in (who.party.members)
            excluded_serials.append(member.serial);
            var memberObj := SystemFindObjectBySerial(member.serial);
            if (memberObj)
                allies.append(memberObj);
            endif
        endforeach
    endif

    // Add caster's pets to allies
    var ownPets := ListAllPetsAndSummonedPetsNear(who, 8);
    foreach pet in ownPets
        excluded_serials.append(pet.serial);
        allies.append(pet);
    endforeach
	
	var duration := Cint(AP_GetSkill(who, THEOLOGY) / 10) * Cint(GetObjProperty(who, "shaman_souls"));
	EraseObjProperty(who, "shaman_souls");

    // Process enemies
    foreach mobile in all_mobiles
        PlayObjectCenteredEffectEx(mobile, EPIC_FX_CURSE_SPELL, 10, 20, 0, 0, 10);
        TS_StartTimer(mobile, "apodrecer", duration);
    endforeach

    // Process allies
    foreach ally in allies
        if (ally && ally.connected)
            SetObjProperty(ally, "#nextcritical", 1);
            PlayObjectCenteredEffectEx(ally, EPIC_FX_BLOOD_DROP, 10, 20, 0, 0, 10);
        endif
    endforeach

    PlaySoundEffect(who, SFX_SPELL_SUMMON_ELEMENTAL);
    SendSysMessageEx(who, "Xali'Gijak. PELA HORDA!");
    
    return 1;
endprogram