use uo;
use os;

include ":attributes:attributes";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include "include/say";

/**
 * Death Sentence / Sentença de Morte
 *
 * For TT/5 seconds, all landed attacks will be guaranteed critical hits.
 * Continuously sets #CriticalChance to 100 for the duration.
 */
program deathsentence(who)
	// Calculate duration based on Tactics skill
	var tactics := AP_GetSkill(who.GetObjRef(), TACTICS);
	var duration := CInt(tactics / 5); // TT/5 seconds

	if (duration < 3)
		duration := 3; // Minimum 3 seconds
	endif
	if (duration > 15)
		duration := 15; // Maximum 15 seconds
	endif

	Message("*sentença de morte pronunciada!*", Color(COLOR_NAME::RED))
		.SendAbove(who.GetObjRef());

	// Track elapsed time
	var elapsed := 0;

	// Maintain critical chance for the duration
	while (elapsed < duration)
		// Keep setting critical chance to 100
		who.GetObjRef().SetProp("#CriticalChance", 100);

		sleep(1); // Wait 1 second
		elapsed := elapsed + 1;

		// Optional: Remind player periodically
		if (elapsed % 3 == 0 && elapsed < duration)
			Message(who.GetObjRef(), $"Sentença de Morte ativa: {duration - elapsed}s restantes", Color(COLOR_NAME::RED)).SendSys();
		endif
	endwhile

	// Clear the critical chance property
	who.GetObjRef().EraseProp("#CriticalChance");

endprogram
