use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":tn:cooldown";

program crosscut(attackInfo)
	// Check if defender has Cross Cut ability and cooldown is active => TT/5 segundos
	if (attackInfo.GetDefender().HasAbility(ABILITY_ID::CROSS_CUT))
		if (GetCooldown(attackInfo.GetDefender().GetObjRef(), "crosscut") > 0)
			ExecuteCrossCutCounterAttack(attackInfo);
		endif
	endif

    // Garante a proxima defesa // Defeveria ser apenas uma vez
    if (attackInfo.GetDefender().HasAbility(ABILITY_ID::CROSS_CUT))
        attackInfo.GetDefender().GetObjRef().SetProp("#tempparrybonus", 100);
    endif

	return true;
endprogram

/**
 * ExecuteCrossCutCounterAttack
 *
 * Automatically counter-attacks the attacker during the Cross Cut window.
 * This happens on EVERY hit received while the cooldown is active.
 */
function ExecuteCrossCutCounterAttack(byref attackInfo)
    attackInfo.GetDefender().Attack(attackInfo.GetAttacker());
	// Visual feedback
	Message("*contra-golpe cruzado!*")
		.SendAbove(attackInfo.GetDefender().GetObjRef());

	// Execute counter-attack
	attackInfo.GetDefender().Attack(attackInfo.GetAttacker());

	// Debug message
	DebugMsg(
		attackInfo.GetDefender().GetObjRef(),
		DEBUG_HAB,
		Message($"Possui Habilidade[{ABILITY_ID::CROSS_CUT}]: Contra-ataque automático!", Color(SYSTEM_COLOR::SUCCESS))
	);

	return true;
endfunction
