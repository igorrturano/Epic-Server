use uo;

include ":fls_core:packets";
include ":combat:Controller/DamageController_legacy";
include ":blood:blood";
include ":combat:Controller/DamageController_legacy";
include "include/say";

program doubleattack(who)

	if (isBloodied(who))
		SendSysMessageEx(who, "Mate ou morra!", SSM_INFO);
		SetObjProperty(who, "#mataroumorrer", 3);
	else
		SendSysMessageEx(who, "Voce so pode usar essa habilidade quando estiver gravemente ferido.",
				   SSM_FAIL);
	endif

endprogram
