use uo;

include ":fls_core:packets";
include ":combat:Controller/DamageController_legacy";
include ":blood:blood";
include ":combat:Controller/DamageController_legacy";
include "include/say";

program doubleattack(who)
	SendSysMessageEx(who, "Voce achou um ponto fraco!", SSM_INFO);
	SetObjProperty(who, "#GuaranteedHit", 1);
	SetObjProperty(who, "#tiropenetrante", 1);
endprogram
