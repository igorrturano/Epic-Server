use uo;

include ":fls_core:packets";
include ":combat:Controller/DamageController_legacy";
include ":blood:blood";
include ":combat:Controller/DamageController_legacy";
include "include/say";
include ":timedscripts:timedScripts";

program tironojoelho(params)
	var attacker := params[1];
	var defender := params[2];
	var weapon := params[3];
	var armor := params[4];
	var basedamage := params[5];
	var rawdamage := params[6];
	params := 0; // Not needed anymore.

	if (lower(weapon.attribute) == "ranged")
		SendSysMessage(attacker, "A habilidade falhou, voce precisa estar usando arco");
		return 1;
	endif

	PlayAttackFX(AttackInfo(MobileWrapper(attacker), MobileWrapper(defender)));
	PlayAttackSFX(AttackInfo(MobileWrapper(attacker), MobileWrapper(defender)));

	TS_StartTimer(defender, "paralysis", 6);
	Run_Script_To_Completion(":combat:mainHitScript", array{ attacker, defender, weapon, armor,
														 	basedamage, rawdamage });

endprogram
