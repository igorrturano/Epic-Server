use uo;

include ":fls_core:packets";
include ":combat:combat";
include ":blood:blood";
include ":combat:Controller/DamageController_legacy";
include "include/say";

program doubleattack(who)

	SendSysMessageEx(who, "Ataque primeiro, pergunte depois!", SSM_INFO);
	SetObjProperty(who, "#ataqueinesperado", 1);

endprogram
