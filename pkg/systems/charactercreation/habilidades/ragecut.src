use uo;
use os;

include ":combat:Model/AttackInfo";
include ":abilities:models/Ability";
include ":wrappers:include/Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":debug:include/Controller/DebugController";
include ":attributes:attributes";

/**
 * Rage-Cut / Golpes Furiosos
 *
 * Performs TT/40 furious strikes on the opponent when activated.
 * Triggered when attacker has #ragecut property set.
 */
program ragecut(attackInfo)
	// Check if attacker activated Rage-Cut
	if (attackInfo.GetAttacker().HasAbility(ABILITY_ID::RAGE_CUT))
		ExecuteRageCutStrikes(attackInfo);
	endif

	return true;
endprogram

/**
 * ExecuteRageCutStrikes
 *
 * Executes multiple furious strikes based on Tactics skill
 */
function ExecuteRageCutStrikes(byref attackInfo)
	// Calculate number of extra strikes based on Tactics skill
	var tactics := AP_GetSkill(attackInfo.GetAttacker().GetObjRef(), TACTICS);
	var strike_rounds := CInt(tactics / 40);

	if (strike_rounds < 1)
		strike_rounds := 1; // At least 1 extra strike
	endif

	// Check if weapon is melee (not ranged)
	var weapon := attackInfo.GetAttacker().GetEquipBySlot(WEAPON);
	if (weapon.GetAttribute() == RANGED)
		Message("Você não pode usar golpes furiosos com arma de longo alcance!", Color(SYSTEM_COLOR::FAIL))
			.SendSys(attackInfo.GetAttacker().GetObjRef());
		return false;
	endif

	// Visual feedback
	Message("*desencadeia uma sequência de golpes furiosos!*")
		.SendAbove(attackInfo.GetAttacker().GetObjRef());

	DebugMsg(
		attackInfo.GetAttacker().GetObjRef(),
		DEBUG_HAB,
		Message($"Possui Habilidade[{ABILITY_ID::RAGE_CUT}]: Executando {strike_rounds} golpes extras!", Color(SYSTEM_COLOR::SUCCESS))
	);

	// Execute furious strikes
	for i := 1 to strike_rounds
		attackInfo.GetAttacker().Attack(attackInfo.GetDefender());
		sleepms(200); // Small delay between strikes for visual effect
	endfor
	return true;
endfunction
