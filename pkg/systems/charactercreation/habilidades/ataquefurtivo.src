use uo;

include ":combat:Controller/DamageController";
include ":combat:Controller/HitController";
include ":message:model/Message";
include ":objWrapper:Model/MobileWrapper";

program backstab(who)
	who := MobileWrapper(who);

	if (!CanBackStab(who) || !isAssassinWeapon(who.GetMobRef()))
		Message("Esta arma não é apropriada para um ataque furtivo.", FONTCOLOR_ERROR).SendSys(who.GetMobRef());
		return;
	endif

	who.GetMobRef().SetProp("backstab", 1);
	who.GetEquipBySlot(WEAPON).GetItemRef().SetProp("backstab", 1);
	
	if (who.hidden)
		who.GetMobRef().SetProp("#attackbonus", 100);
		if (who.HasAbility(COMBAT_ABILITY::INSTINTO_ASSASSINO))
			who.GetMobRef().SetProp("#nextcritical", 1);
		endif
	endif

	GrantPrivilege(who.GetMobRef(), "hiddenattack");
	who.GetMobRef().enable("hiddenattack");
	Message("Você está preparado para um ataque furtivo!", FONTCOLOR_SUCCESS).SendSys(who.GetMobRef());
endprogram
