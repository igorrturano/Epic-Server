use uo;

include "include/epicCombatUtils";
include ":combat:Controller/DamageController";
include ":combat:Controller/HitController";
include ":abilities:controllers/AbilityController";

program backstab(who)
	who := MobileWrapper(who);
	var instinto_assassino := Ability(ABILITY_ID::INSTINTO_ASSASSINO);

	if (!CanBackStab(who) || !isAssassinWeapon(who.GetObjRef()))
		Message("Esta arma não é apropriada para um ataque furtivo.", Color(SYSTEM_COLOR::ERRO)).SendSys(who.GetObjRef());
		return;
	endif

	who.SetProperty("backstab", 1);
	who.GetEquipBySlot(WEAPON).SetProperty("backstab", 1);

	if (who.IsHidden())
		who.SetProperty("#attackbonus", 100);
		if (who.HasAbility(instinto_assassino))
			who.SetProperty("#nextcritical", 1);
		endif
	endif

	GrantPrivilege(who.GetObjRef(), "hiddenattack");
	who.GetObjRef().enable("hiddenattack");
	Message("Você está preparado para um ataque furtivo!", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who.GetObjRef());
endprogram
