use uo;

include "include/epicCombatUtils";
include ":combat:Controller/DamageController";
include ":combat:Controller/HitController";
// include ":message:model/Message";
// include ":wrappers:Objects/Model/MobileWrapper";

program backstab(who)
	who := MobileWrapper(who);

	if (!CanBackStab(who) || !isAssassinWeapon(who.GetObjRef()))
		Message("Esta arma não é apropriada para um ataque furtivo.", FONTCOLOR_ERROR).SendSys(who.GetObjRef());
		return;
	endif

	who.GetObjRef().SetProp("backstab", 1);
	who.GetEquipBySlot(WEAPON).GetObjRef().SetProp("backstab", 1);

	if (who.hidden)
		who.GetObjRef().SetProp("#attackbonus", 100);
		if (who.HasAbility(COMBAT_ABILITY::INSTINTO_ASSASSINO))
			who.GetObjRef().SetProp("#nextcritical", 1);
		endif
	endif

	GrantPrivilege(who.GetObjRef(), "hiddenattack");
	who.GetObjRef().enable("hiddenattack");
	Message("Você está preparado para um ataque furtivo!", FONTCOLOR_SUCCESS).SendSys(who.GetObjRef());
endprogram
