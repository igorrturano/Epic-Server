include ":timedscripts:timedScripts";
include ":awareness:awareness";

program habilidade(who)
	var chardata := GetObjProperty(who, "chardata");
	var religiao := chardata.religion;
	var theology_bonus := Cint(AP_GetSkill(who, THEOLOGY) / 10);
	var divine_damage := Cint(AP_GetSkill(who, THEOLOGY) / 5);

	// Efeitos específicos por religião
	case (religiao)
		ELUITHORTH:  start_script(":charactercreation:habilidades/dominanciamatriarcal", who);
		BOKK_BHARAZ: start_script(":charactercreation:habilidades/martelotempestuoso", array{ who });

		HALLEUAD:
			var targ := getTarg(who);
			PlaySoundEffect(targ, 0x1F8);
			var blind_duration := theology_bonus;
			TS_StartTimer(targ, "blinded", blind_duration, 0, who);
			PrintTextAbove(targ, "*cegado pela luz divina*");

		VENERATIO:
			var targ := getTarg(who);
			// PlayObjectCenteredEffectEx(targ, /* 0x3789 */ FX_MORALE_DOWN, 7, 32, 2485, 1);
			var fx := CreateItemAtLocation(targ.x, targ.y, targ.z + 10, FX_MORALE_DOWN, 1, targ.realm);
			Sleepms(800);
			DestroyItem(fx);
			PlaySoundEffect(targ, 0x58E);

			// Debuff baseado em repreensao pelo odio
			var debuff_percent := Cint(theology_bonus * 2); // Porcentagem do debuff
			if (debuff_percent > 50)
				debuff_percent := 50;
			endif // Cap no debuff

			// Dex Debuff
			var stat := AP_GetStat(targ, DEXTERITY);
			var points := Cint((stat * debuff_percent) / 100) * -1;
			SetObjProperty(targ, "#ClumsyMod", points);
			AP_ModifyStatMod(targ, DEXTERITY, points);
			var dex_points := points;

			// Str Debuff
			stat := AP_GetStat(targ, STRENGTH);
			points := Cint((stat * debuff_percent) / 100) * -1;
			SetObjProperty(targ, "#WeakenMod", points);
			AP_ModifyStatMod(targ, STRENGTH, points);
			var str_points := points;

			// Int Debuff
			stat := AP_GetStat(targ, INTELLIGENCE);
			points := Cint((stat * debuff_percent) / 100) * -1;
			SetObjProperty(targ, "#FeebleMindMod", points);
			AP_ModifyStatMod(targ, INTELLIGENCE, points);
			var int_points := points;

			PrintTextAbove(targ, "*enfraquecido pela ira divina*");
			SendSysMessageEx(who, "Seu alvo foi enfraquecido pela ira sagrada!", SSM_INFO);

			// Remove debuffs após duração
			var debuff_duration := theology_bonus;
			sleep(debuff_duration);
			EraseObjProperty(targ, "#ClumsyMod");
			EraseObjProperty(targ, "#WeakenMod");
			EraseObjProperty(targ, "#FeebleMindMod");
			AP_ModifyStatMod(targ, DEXTERITY, dex_points * -1);
			AP_ModifyStatMod(targ, STRENGTH, str_points * -1);
			AP_ModifyStatMod(targ, INTELLIGENCE, int_points * -1);
		// PlayStationaryEffectEx(targ.x, targ.y, targ.z/* +10 */, targ.realm, , 5, theology_bonus * 3, 2, 2740);

		KAI:
			var targ := getTarg(who);
			PlaySoundEffect(targ, 0x51D);

			TS_StartTimer(targ, "exposed", theology_bonus, 0, who);

			SendSysMessageEx(who, "Seu alvo está exposto!", SSM_INFO);
			SendSysMessageEx(targ, "Você foi marcado! Sua defesa está comprometida!", SSM_FAIL);
	endcase

	return 1;
endprogram

function getTarg(who)
	var targ := Target(who);
	if (!targ)
		SendSysMessageEx(who, "Você não conseguiu selecionar um alvo.", SSM_FAIL);
		return 0;
	endif

	if (!CheckLineOfSight(who, targ))
		SendSysMessageEx(who, "Você não consegue ver o alvo.", SSM_FAIL);
		return 0;
	endif

	if (Distance(who, targ) > 8)
		SendSysMessageEx(who, "Muito distante.", SSM_FAIL);
		return 0;
	endif

	return targ;
endfunction
