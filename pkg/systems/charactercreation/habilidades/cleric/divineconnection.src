use uo;

include "include/sounds";
include "include/epicMageryUtils";

program habilidade(who)
	var chardata := GetObjProperty(who, "chardata");
	var religiao := chardata.religion;
	var theology_bonus := Cint(AP_GetSkill(who, THEOLOGY) / 5);
	var diaounoite := GetGlobalProperty("dia");

	PrintTextAbove(who, "*Conecta com energia divina*");
	PlayObjectCenteredEffect(who, 0x376A, 1, 32);

	case (religiao)
		KAI:
			var targ := Target(who);
			PlayObjectCenteredEffect(targ, 0x37B9, 0x0A, 0x1E);
			PlaySoundEffect(targ, 0x51D);
			SetCooldown(targ, "vitalidadeinabalavel", theology_bonus);
			SendSysMessageEx(targ, "Você sente vitalidade inabalável fluindo por seu corpo!", SSM_INFO);

		ELUITHORTH:
			// Use truesight ability
			start_script(":charactercreation:habilidades/truesight", who);
			SendSysMessageEx(who, "Sua visão verdadeira se ativa!", SSM_INFO);

		VENERATIO:
			var targ := Target(who);
			PlaySoundEffect(who, SFX_MAGIC_ARROW);
			PlayMovingEffectXYZHued(who, targ, FX_MAGIC_ARROW, 10, 1643, 0);
			SetCooldown(who, "silence", theology_bonus);
			SendSysMessageEx(targ, "Você foi silenciado pela conexão divina!", SSM_INFO);
			var dmg := RandomDiceRoll("1d4");
			dmg += epicWisdomPathBonus(who);
			DamageFLS(targ, cint(dmg), DMG_FORCED, who, "Conexão Divina");

		BOKK_BHARAZ:
			// Use barreira de escudos ability
			start_script(":charactercreation:habilidades/barreiradeescudos", who);
			SendSysMessageEx(who, "Você canaliza a proteção divina!", SSM_INFO);
			PrintTextAbove(who, "*Parede de Escudos*");

		HALLEUAD:
			var skill := TACTICS;
			var targ := Target(who);
			if (diaounoite == "dia")
				// Dawn/day: Tactics bonus
				AP_ModifySkillMod(targ, skill, theology_bonus);
				SendSysMessageEx(targ, "A luz do dia fortalece suas táticas de combate!", SSM_INFO);
				PlayObjectCenteredEffect(targ, 0x373A, 10, 20);
				PlaySoundEffect(targ, 0x1F5);
				sleep(theology_bonus);
			else
				// Dusk/night: Awareness bonus
				skill := AWARENESS;
				AP_ModifySkillMod(targ, skill, theology_bonus);
				SendSysMessageEx(targ, "A escuridão aguça seus sentidos!", SSM_INFO);
				PlayObjectCenteredEffect(targ, 0x375A, 10, 20);
				PlaySoundEffect(targ, 0x1F8);
			endif
			sleep(theology_bonus);
			AP_ModifySkillMod(targ, skill, -theology_bonus);
	endcase

	return 1;
endprogram
