use uo;

include "include/sounds";
include "include/epicMageryUtils";
include ":timedscripts:timedScripts";
include ":attributes:attributes";

program habilidade(who)
	var chardata := GetObjProperty(who, "chardata");
	var religiao := chardata.religion;
	var theology_bonus := Cint(AP_GetSkill(who, THEOLOGY) / 5);
	PerformAction(who, HUMAN_ANIM::CAST_DIR);

	case (religiao)
		ELUITHORTH:
			// Prole Sombria
			var targ := Target(who);
			if (!targ)
				SendSysMessageEx(who, "Você deve selecionar um local.", SSM_FAIL);
				return 0;
			endif
			start_script(":charactercreation:habilidades/prolesombria", array{ who, targ });

		BOKK_BHARAZ:
			// Salto Bigorna
			start_script(":charactercreation:habilidades/saltobigorna", array{ who });

		HALLEUAD:
			// Cavalgar o Vento
			var targ := Target(who);
			if (!targ)
				SendSysMessageEx(who, "Você deve selecionar um alvo.", SSM_FAIL);
				return 0;
			endif

			PlayObjectCenteredEffectEx(targ, FX_SPEED_BOOTS, 7, 32, 0, 1);
			PlaySoundEffect(targ, 0x20F);
			TS_StartTimer(targ, "velocidade", theology_bonus);

		VENERATIO:
			// Buff de combate
			var targ := Target(who);
			if (!targ)
				SendSysMessageEx(who, "Você deve selecionar um alvo.", SSM_FAIL);
				return 0;
			endif

			PlayObjectCenteredEffectEx(targ, FX_MORALE_UP, 7, 32);
			PlaySoundEffect(targ, 0x1F5);

			// Buff em todas as stats
			var buff_percent := Cint(theology_bonus * 2);
			if (buff_percent > 50)
				buff_percent := 50;
			endif

			// Str Buff
			var stat := AP_GetStat(targ, STRENGTH);
			var points := Cint((stat * buff_percent) / 100);
			SetObjProperty(targ, "#StrengthMod", points);
			AP_ModifyStatMod(targ, STRENGTH, points);
			var str_points := points;

			// Dex Buff
			stat := AP_GetStat(targ, DEXTERITY);
			points := Cint((stat * buff_percent) / 100);
			SetObjProperty(targ, "#DexterityMod", points);
			AP_ModifyStatMod(targ, DEXTERITY, points);
			var dex_points := points;

			// Int Buff
			stat := AP_GetStat(targ, INTELLIGENCE);
			points := Cint((stat * buff_percent) / 100);
			SetObjProperty(targ, "#IntelligenceMod", points);
			AP_ModifyStatMod(targ, INTELLIGENCE, points);
			var int_points := points;

			SendSysMessageEx(targ, "Você se sente fortalecido pela aura divina!", SSM_INFO);
			SendSysMessageEx(who, "Seu alvo foi abençoado com força divina!", SSM_INFO);

			// Remove buffs após duração
			var buff_duration := theology_bonus * 2;
			sleep(buff_duration);
			EraseObjProperty(targ, "#StrengthMod");
			EraseObjProperty(targ, "#DexterityMod");
			EraseObjProperty(targ, "#IntelligenceMod");
			AP_ModifyStatMod(targ, STRENGTH, str_points * -1);
			AP_ModifyStatMod(targ, DEXTERITY, dex_points * -1);
			AP_ModifyStatMod(targ, INTELLIGENCE, int_points * -1);

		KAI:
			// Bônus para acerto
			var targ := Target(who);
			if (!targ)
				SendSysMessageEx(who, "Você deve selecionar um alvo.", SSM_FAIL);
				return 0;
			endif

			PlayObjectCenteredEffect(targ, 0x373A, 10, 20);
			PlaySoundEffect(targ, 0x1F7);

			var attack_bonus := Cint(AP_GetSkill(who, THEOLOGY) / 2);
			SetObjProperty(targ, "#attackbonus", attack_bonus);

			SendSysMessageEx(targ, "Sua precisão foi aprimorada pela aura divina!", SSM_INFO);
			SendSysMessageEx(who, "Você concede precisão divina ao alvo!", SSM_INFO);
	endcase

	return 1;
endprogram
