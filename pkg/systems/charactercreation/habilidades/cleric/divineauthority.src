use uo;

include "include/sounds";
include "include/epicMageryUtils";
include ":timedscripts:timedScripts";
include ":attributes:attributes";
include ":tn:cooldown";

program habilidade(who)
	var chardata := GetObjProperty(who, "chardata");
	var religiao := chardata.religion;
	var theology_bonus := Cint(AP_GetSkill(who, THEOLOGY) / 5);
	var duration := theology_bonus;

	PrintText(who, "*Cria terreno consagrado*");
	PlayObjectCenteredEffect(who, 0x376A, 1, 32);
	PlaySoundEffect(who, 0x1F2);

	// Get all mobiles in 3 tile radius
	var nearby_mobiles := ListMobilesNearLocation(who.x, who.y, who.z, 3, who.realm);
	var allies := array{};
	var enemies := array{};

	// Separate allies from enemies
	foreach mobile in nearby_mobiles
		if (mobile == who)
			continue;
		endif

		var is_ally := 0;

		// Check if in same party
		if (who.party && mobile.party && who.party == mobile.party)
			is_ally := 1;
		endif

		// Check if same guild (if not in party)
		if (!is_ally && who.guild && mobile.guild && who.guild == mobile.guild)
			is_ally := 1;
		endif

		// Check if pet/summon
		if (!is_ally)
			var owner := GetObjProperty(mobile, "owner");
			if (owner == who.serial)
				is_ally := 1;
			endif
		endif

		if (is_ally)
			allies.append(mobile);
		else
			enemies.append(mobile);
		endif
	endforeach

	case (religiao)
		VENERATIO:
			// Sentinel of Order - Silence all in area
			PlayStationaryEffect(who.x, who.y, who.z, 0x37C4, 10, 20);
			foreach mobile in nearby_mobiles
				if (mobile != who)
					SetCooldown(mobile, "silence", duration);
					PrintText(mobile, "*silenciado*");
				endif
			endforeach
			SendSysMessageEx(who, "Você cria um campo de silêncio divino!", SSM_INFO);

		KAI:
			// Balance Restored - Allies immune to critical hits
			PlayStationaryEffect(who.x, who.y, who.z, 0x373A, 10, 20);
			foreach ally in allies
				SetCooldown(ally, "balance_restored", duration);
				PrintText(ally, "*equilibrio restaurado*");
				SendSysMessageEx(ally, "Você está protegido contra ataques críticos!", SSM_INFO);
			endforeach
			SendSysMessageEx(who, "Você restaura o equilíbrio divino aos aliados!", SSM_INFO);

		BOKK_BHARAZ:
			// Mountain's Strength - Physical damage reduced to 1 for allies
			PlayStationaryEffect(who.x, who.y, who.z, 0x6d67, 10, 20);
			foreach ally in allies
				SetCooldown(ally, "mountains_strength", duration);
				PrintText(ally, "*forca da montanha*");
				SendSysMessageEx(ally, "Você sente a força inabalável da montanha!", SSM_INFO);
			endforeach
			SendSysMessageEx(who, "Você concede a força da montanha aos aliados!", SSM_INFO);

			HALLEUAD: // Eclipse - Blind all targets in area
													foreach mobile in enemies
				if (mobile != who)
					PlayStationaryEffectEx(mobile.x, mobile.y, mobile.z + 10, mobile.realm, 0x6e0d, 5, duration * 3,
											2, 2740);
					SetCooldown(mobile, "blinded", duration);
					PrintText(mobile, "*cegado pelo eclipse*");
					SendSysMessageEx(mobile, "Você foi cegado pelo eclipse divino!", SSM_FAIL);
				endif
			endforeach
			SendSysMessageEx(who, "Você invoca um eclipse cegante!", SSM_INFO);

		ELUITHORTH:
			// Shadow Dominion - Allies wrapped in darkness
			PlayStationaryEffect(who.x, who.y, who.z, 0x37C4, 10, 20);
			foreach mob in nearby_mobiles
				SetCooldown(mob, "true_darkness", duration);
				SetCooldown(mob, "darkness", duration);
				PrintText(mob, "*envolvido em trevas*");
				SendSysMessageEx(mob, "Você é envolvido pelas trevas sagradas!", SSM_INFO);
			endforeach
			SendSysMessageEx(who, "Você concede o domínio das sombras aos aliados!", SSM_INFO);
	endcase

	return 1;
endprogram
