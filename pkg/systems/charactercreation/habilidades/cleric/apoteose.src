use uo;

include "include/sounds";
include "include/epicMageryUtils";
include ":timedscripts:timedScripts";
include ":attributes:attributes";
include ":tn:cooldown";
include ":brainai:npcUtil";
include ":combat:Controller/DamageController_legacy";

program habilidade(who)
	var chardata := GetObjProperty(who, "chardata");
	var religiao := chardata.religion;
	var theology_skill := AP_GetSkill(who, THEOLOGY);
	var duration := Cint(theology_skill / 5);

	PrintTextAbove(who, "*Ascende à manifestação divina*");
	PlayObjectCenteredEffect(who, 0x37C4, 1, 32);
	PlaySoundEffect(who, 0x1F2);

	SetCooldown(who, "divine_manifestation", duration);
	SendSysMessageEx(who, "Você ascendeu à manifestação divina! Suas magias divinas não consomem mana nem possuem delay!",
				  SSM_INFO);

	// Religion-specific effects
	case (religiao)
		VENERATIO:
			// Glória Eterna - Enemies take double damage
			var nearby_enemies := GetNearbyEnemies(who, 8);
			foreach enemy in nearby_enemies
				TS_StartTimer(enemy, "apodrecer", duration);
				PrintTextAbove(enemy, "*marcado pela glória eterna*");
				PlayObjectCenteredEffect(enemy, 0x37C4, 10, 20);
				SendSysMessageEx(enemy, "Você foi marcado pela glória divina eterna!", SSM_FAIL);
			endforeach
			SendSysMessageEx(who, "Você manifesta a Glória Eterna de Veneratio!", SSM_INFO);

		BOKK_BHARAZ:
			// Fortaleza Inabalável - Stone skin for cleric
			start_script(":charactercreation:habilidades/pelepedra", who);
			SendSysMessageEx(who, "Você manifesta a Fortaleza Inabalável de Bokk Bharaz!", SSM_INFO);

		HALLEUAD:
			// Sol Divino - Emanates light that heals allies and destroys darkness creatures
			var nearby_mobiles := ListMobilesNearLocation(who.x, who.y, who.z, 8, who.realm);
			PlayStationaryEffect(who.x, who.y, who.z + 10, 0x37C4, 10, 30);

			foreach mobile in nearby_mobiles
				if (mobile == who)
					continue;
				endif

				var is_ally := IsPlayerAlly(who, mobile);

				if (is_ally)
					// Heal allies
					var heal_amount := Cint(theology_skill * 1.4);
					applyEpicHealing(mobile, heal_amount);
					PlayObjectCenteredEffect(mobile, 0x375A, 0, 16);
					SendSysMessageEx(mobile, "Você é curado pela luz divina!", SSM_INFO);
				else
					// Check if it's a darkness creature
					var npc_elem := NPC_GetNPCConfig(mobile.npctemplate);
					var isDarknessCreature := GetObjProperty(mobile, "Mobnoturno") || Lower(npc_elem.Category) == "undead";

					if (isDarknessCreature && !InDarkness(mobile))
						ApplyRawDamage(mobile, CInt(AP_GetVitalMaximumValue(mobile, "Hits")));
						PrintTextAbove(mobile, "*destruido pela luz divina*");
						PlayObjectCenteredEffect(mobile, 0x36BD, 10, 20);
					endif
				endif
				sleepms(50);
			endforeach
			SendSysMessageEx(who, "Você manifesta o Sol Divino de Halleuad!", SSM_INFO);

		ELUITHORTH:
			// Tormento de Idrith - Torments all, paralyzing and dealing continuous damage
			start_script(":charactercreation:habilidades/tormentoidrith", who);
			SendSysMessageEx(who, "Você manifesta o Tormento de Idrith!", SSM_INFO);

		KAI:
			// Destino Manifesto - Guarantees critical hits for all allies
			var nearby_allies := GetNearbyAllies(who, 8);
			foreach ally in nearby_allies
				SetObjProperty(ally, "#attackbonus", 100);
				SetObjProperty(ally, "#CriticalChance", 100);

				PrintTextAbove(ally, "*destino manifesto*");
				PlayObjectCenteredEffect(ally, 0x373A, 10, 20);
				SendSysMessageEx(ally, "Seu destino foi manifestado! Seu próximo atque será um acerto crítico!",
								  SSM_INFO);
			endforeach
			SendSysMessageEx(who, "Você manifesta o Destino de Kai!", SSM_INFO);
	endcase

	return 1;
endprogram

function GetNearbyEnemies(who, range)
	var enemies := array{};
	var nearby_mobiles := ListMobilesNearLocation(who.x, who.y, who.z, range, who.realm);

	foreach mobile in nearby_mobiles
		if (mobile == who)
			continue;
		endif

		if (!IsPlayerAlly(who, mobile))
			enemies.append(mobile);
		endif
	endforeach

	return enemies;
endfunction

function GetNearbyAllies(who, range)
	var allies := array{};
	var nearby_mobiles := ListMobilesNearLocation(who.x, who.y, who.z, range, who.realm);

	foreach mobile in nearby_mobiles
		if (mobile == who)
			allies.append(mobile); // Include self
			continue;
		endif

		if (IsPlayerAlly(who, mobile))
			allies.append(mobile);
		endif
	endforeach

	return allies;
endfunction

function IsPlayerAlly(who, mobile)
	// Check if in same party
	if (who.party && mobile.party && who.party == mobile.party)
		return 1;
	endif

	// Check if same guild
	if (who.guild && mobile.guild && who.guild == mobile.guild)
		return 1;
	endif

	// Check if pet/summon
	var owner := GetObjProperty(mobile, "owner");
	if (owner == who.serial)
		return 1;
	endif

	return 0;
endfunction
