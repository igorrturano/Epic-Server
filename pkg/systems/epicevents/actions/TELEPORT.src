use uo;
use os;
use polsys;

include "include/epicCombatUtils";

program TELEPORT_Action(params)
	var event := params[2];
	var action_params := params[3];

	var mobile := event.source;
	if (!mobile || !mobile.acctname)
		return 0;
	endif

	if (!action_params)
		return 0;
	endif

	var x := CInt(action_params.x);
	var y := CInt(action_params.y);
	var z := CInt(action_params.z);
	var realm := action_params.realm ? action_params.realm : mobile.realm;

	if (!x || !y)
		return 0;
	endif

	var pets := ListAllPetsAndSummonedPetsNear(mobile, 4);

	SetObjProperty(mobile, "#Teleported", ReadMillisecondClock());
	MoveObjectToLocation(mobile, x, y, z, realm, MOVEOBJECT_FORCELOCATION);

	foreach pet in pets
		SetObjProperty(pet, "#Teleported", ReadMillisecondClock());
		MoveObjectToLocation(pet, x, y, z, realm, MOVEOBJECT_FORCELOCATION);
		sleepms(10);
	endforeach

	return 1;
endprogram
