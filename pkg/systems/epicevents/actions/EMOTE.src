use uo;
use os;

include ":message:model/Message";
include ":text:Color";

program EMOTE_Action(params)
	var item := params[1];
	var event := params[2];
	var action_params := params[3];

	var emote_text := action_params.text;

	if (!emote_text || emote_text == "")
		return 0;
	endif

	if (action_params.show_on_source && event.source)
		Message(emote_text, Color(MESSAGE_COLOR::NARRATOR)).SendAbove(event.source);
		return 1;
	endif

	// If item is an NPC, show text directly above it (no anchor needed)
	if (item.npctemplate)
		Message(emote_text, Color(MESSAGE_COLOR::NARRATOR)).SendAbove(item);
		return 1;
	endif

	var anchor := CreateItemAtLocation(item.x, item.y, item.z, 0x00C3, 1, item.realm);
	anchor.movable := 0;

	PrintTextAbove(anchor, emote_text, MESSAGE_COLOR::NARRATOR);
	sleep(5);
	DestroyItem(anchor);
	return 1;
endprogram
