use uo;
use os;

include ":epicevents:Controller/SpawnController";
include ":epicevents:Controller/TriggerController";
include ":epicevents:Controller/ActionController";
include ":epicevents:Model/EventConfig";
include ":epicevents:Model/TriggerConfig";
include ":epicevents:Model/ActionConfig";
include "include/sysEvent";

const DEFAULT_TRIGGER_RADIUS := 8;
const EVENT_LOOP_THROTTLE_MS := 100;

program eventController(item)
	var ev;
	Set_Event_Queue_Size(50);

	var config_struct := GetObjProperty(item, "config");
	if (!config_struct)
		return;
	endif

	var config := EventConfig();
	config.FromStruct(config_struct);

	// Enable events conditionally based on trigger type
	var trigger_type := config.trigger_type;

	// Get radius from trigger_params if available
	var radius := DEFAULT_TRIGGER_RADIUS;
	if (config.trigger_params && config.trigger_params.radius)
		radius := CInt(config.trigger_params.radius);
		if (radius < 1)
			radius := DEFAULT_TRIGGER_RADIUS;
		endif
	endif

	// Only enable the specific event type needed
	case (trigger_type)
		"SPEECH":
			RegisterForSpeechEvents(item, radius);
			print("[EpicEvents] Registered SPEECH trigger (radius: " + radius + " tiles)");
		"ENTEREDAREA":
			EnableEvents(SYSEVENT_ENTEREDAREA, radius);
			print("[EpicEvents] Enabled ENTEREDAREA trigger (radius: " + radius + " tiles)");
		"LEFTAREA":
			EnableEvents(SYSEVENT_LEFTAREA, radius);
			print("[EpicEvents] Enabled LEFTAREA trigger (radius: " + radius + " tiles)");
		"ITEM_GIVEN":
			EnableEvents(SYSEVENT_ITEM_GIVEN);
			print("[EpicEvents] Enabled ITEM_GIVEN trigger");
		"DOUBLECLICKED":
			EnableEvents(SYSEVENT_DOUBLECLICKED);
			print("[EpicEvents] Enabled DOUBLECLICKED trigger");
	endcase

	// Create TriggerConfig from stored params
	var trigger_config := TriggerConfig(trigger_type);
	if (config.trigger_params)
		trigger_config.params := config.trigger_params;
	endif

	print("[EpicEvents] Event controller started - Trigger type: " + trigger_type);
	print("[EpicEvents] Location: " + item.x + "," + item.y + "," + item.z);

	while (true)
		ev := os::wait_for_event(1);
		if (ev)
			if (ProcessTriggerEvent(item, ev, trigger_config))

				// Execute configured actions
				var actions_succeeded := 0;
				if (config.actions && config.actions.size() > 0)
					actions_succeeded := ExecuteActions(item, ev, config.actions);
				else
					// No actions configured - use spawn fallback
					var spawn_action := ActionConfig("SPAWN");
					spawn_action.params := config.ToStruct();
					actions_succeeded := ExecuteActions(item, ev, array{spawn_action});
				endif

				// Only set cooldown if at least one action succeeded
				if (actions_succeeded)
					// Calculate cooldown from min/max delay range (in minutes)
					var min_minutes := CInt(config.min_delay);
					var max_minutes := CInt(config.max_delay);

					if (min_minutes < 1)
						min_minutes := DEFAULT_MIN_DELAY_MINUTES;
					endif
					if (max_minutes < min_minutes)
						max_minutes := min_minutes;
					endif

					// Randomize delay between min and max
					var delay_minutes := RandomInt(max_minutes - min_minutes + 1) + min_minutes;
					var cooldown_seconds := delay_minutes * 60;

					UpdateTriggerCooldown(item, cooldown_seconds);
				endif
			endif
		endif
		sleepms(EVENT_LOOP_THROTTLE_MS);
	endwhile
endprogram
