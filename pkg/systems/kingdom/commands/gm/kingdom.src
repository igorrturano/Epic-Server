// ============================================================================
// .kingdom GM Command
// Kingdom Management Interface for GMs
// Epic! Shard - Kingdom Management System v0.1.0
// ============================================================================

use uo;
use os;
use cfgfile;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:requestGump";
include ":gumps:yesNo";
include ":kingdom:constants";
include ":kingdom:datafile";
include ":kingdom:territory";
include ":kingdom:kingdom";

program KingdomGMCommand(who)
	if (!who.cmdlevel)
		SendSysMessage(who, "You do not have permission to use this command.");
		return;
	endif
	print("" + who.name + " used .kingdom GM command.");
	ShowMainMenu(who);
endprogram

// ============================================================================
// MAIN MENU
// ============================================================================

function ShowMainMenu(who)
	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 400, 500);
	GFResizePic(gump, 10, 10, 9350, 380, 480);

	// Title
	GFTextMid(gump, 10, 20, 380, 1153, "Kingdom Management System");
	GFTextMid(gump, 10, 40, 380, 2100, "v0.1.0 - GM Interface");

	// Territory Management Section
	GFTextLine(gump, 30, 70, 2100, "Territory Management:");
	GFAddButton(gump, 40, 95, 4005, 4007, GF_CLOSE_BTN, 1); // Create Territory
	GFTextLine(gump, 75, 95, 1149, "Create New Territory");

	GFAddButton(gump, 40, 120, 4005, 4007, GF_CLOSE_BTN, 2); // List Territories
	GFTextLine(gump, 75, 120, 1149, "List All Territories");

	GFAddButton(gump, 40, 145, 4005, 4007, GF_CLOSE_BTN, 3); // View Territory
	GFTextLine(gump, 75, 145, 1149, "View Territory Info");

	GFAddButton(gump, 40, 170, 4005, 4007, GF_CLOSE_BTN, 4); // Delete Territory
	GFTextLine(gump, 75, 170, 137, "Delete Territory");

	// Kingdom Management Section
	GFTextLine(gump, 30, 210, 2100, "Kingdom Management:");
	GFAddButton(gump, 40, 235, 4005, 4007, GF_CLOSE_BTN, 5); // List Kingdoms
	GFTextLine(gump, 75, 235, 1149, "List All Kingdoms");

	GFAddButton(gump, 40, 260, 4005, 4007, GF_CLOSE_BTN, 6); // View Kingdom
	GFTextLine(gump, 75, 260, 1149, "View Kingdom Info");

	GFAddButton(gump, 40, 285, 4005, 4007, GF_CLOSE_BTN, 7); // Delete Kingdom
	GFTextLine(gump, 75, 285, 137, "Delete Kingdom");

	// Debug/Utility Section
	GFTextLine(gump, 30, 325, 2100, "Debug & Utilities:");
	GFAddButton(gump, 40, 350, 4005, 4007, GF_CLOSE_BTN, 8); // Reload Configs
	GFTextLine(gump, 75, 350, 1149, "Reload Configurations");

	GFAddButton(gump, 40, 375, 4005, 4007, GF_CLOSE_BTN, 9); // View Datafiles
	GFTextLine(gump, 75, 375, 1149, "View Datafile Status");

	var result := GFSendGump(who, gump);
	if (!result || !result[0])
		return;
	endif

	case (result[0])
		1: CreateTerritoryMenu(who);
		2: ListTerritoriesMenu(who);
		3: ViewTerritoryMenu(who);
		4: DeleteTerritoryMenu(who);
		5: ListKingdomsMenu(who);
		6: ViewKingdomMenu(who);
		7: DeleteKingdomMenu(who);
		8: ReloadConfigs(who);
		9: ViewDatafileStatus(who);
	endcase
endfunction

// ============================================================================
// CREATE TERRITORY
// ============================================================================

function CreateTerritoryMenu(who)
	// Get territory name
	var name := RequestGumpEx(who, "Enter territory name:", "", "", 1);
	if (!name || name == "")
		SendSysMessage(who, "Territory creation cancelled.");
		ShowMainMenu(who);
		return;
	endif

	// Get size level (1-5)
	var size_str := RequestGumpEx(who, "Enter territory size (1-5):", "1-Small, 2-Medium, 3-Large, 4-Huge, 5-Massive", "1", 1);
	if (!size_str || size_str == "")
		SendSysMessage(who, "Territory creation cancelled.");
		ShowMainMenu(who);
		return;
	endif

	var size_level := CInt(size_str);
	if (!KD_IsValidTerritorySize(size_level))
		SendSysMessage(who, "Invalid size level. Must be 1-5.");
		ShowMainMenu(who);
		return;
	endif

	// Get rare resources
	var resources_str := RequestGumpEx(who, "Enter rare resources (comma-separated):", "Example: Iron, Gold", "", 1);
	var rare_resources := array{};
	if (resources_str && resources_str != "")
		var parts := SplitWords(resources_str, ",");
		foreach part in parts
			var trimmed := Trim(part);
			if (trimmed != "")
				rare_resources.append(trimmed);
			endif
		endforeach
	endif

	// Calculate rect from GM's position
	var rect := TRTY_CalculateRectFromCenter(who.x, who.y, who.realm, size_level);
	if (!rect || rect == "")
		SendSysMessage(who, "Failed to calculate territory bounds.");
		ShowMainMenu(who);
		return;
	endif

	// Create territory (using name as the unique ID)
	var result := TRTY_CreateTerritory(name, rect, size_level, rare_resources, who);
	if (result)
		SendSysMessage(who, "Territory created successfully: " + name);
		SendSysMessage(who, "Size: Level " + size_level);
		SendSysMessage(who, "Center: " + who.x + ", " + who.y);
		SendSysMessage(who, "Rare Resources: " + resources_str);
	else
		SendSysMessage(who, "Failed to create territory (name might already exist).");
	endif

	ShowMainMenu(who);
endfunction

// ============================================================================
// LIST TERRITORIES
// ============================================================================

function ListTerritoriesMenu(who)
	var territories := TRTY_ListAllTerritories();

	if (territories.size() == 0)
		SendSysMessage(who, "No territories found.");
		ShowMainMenu(who);
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 600);
	GFResizePic(gump, 10, 10, 9350, 480, 580);

	GFTextMid(gump, 10, 20, 480, 1153, "All Territories");
	GFTextMid(gump, 10, 40, 480, 2100, "Total: " + territories.size());

	// Headers
	GFTextLine(gump, 30, 70, 2100, "Name");
	GFTextLine(gump, 250, 70, 2100, "Owner");
	GFTextLine(gump, 400, 70, 2100, "Size");

	var y_offset := 95;
	var page_size := 15;
	var count := 0;

	foreach territory_name in (territories)
		var territory := KD_GetTerritory(territory_name);
		if (territory)
			var owner := territory.owner_faction;
			if (!owner || owner == "")
				owner := "(Unclaimed)";
			endif

			GFTextLine(gump, 30, y_offset, 1149, territory.name);
			GFTextLine(gump, 250, y_offset, 1149, owner);
			GFTextLine(gump, 400, y_offset, 1149, CStr(territory.size_level));

			y_offset += 20;
			count += 1;

			if (count >= page_size)
				break;
			endif
		endif
		sleepms(2);
	endforeach

	// Close Button
	GFAddButton(gump, 200, 550, 4017, 4019, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 550, 1149, "Back");

	var result := GFSendGump(who, gump);
	ShowMainMenu(who);
endfunction

// ============================================================================
// VIEW TERRITORY
// ============================================================================

function ViewTerritoryMenu(who)
	var territories := TRTY_ListAllTerritories();

	if (territories.size() == 0)
		SendSysMessage(who, "No territories found.");
		ShowMainMenu(who);
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 600);
	GFResizePic(gump, 10, 10, 9350, 480, 580);

	GFTextMid(gump, 10, 20, 480, 1153, "VIEW TERRITORY INFO");
	GFTextMid(gump, 10, 40, 480, 2100, "Click a territory to view details");

	// Headers
	GFTextLine(gump, 30, 70, 2100, "Name");
	GFTextLine(gump, 250, 70, 2100, "Owner");
	GFTextLine(gump, 400, 70, 2100, "Size");

	var y_offset := 95;
	var page_size := 15;
	var count := 0;
	var button_id := 100;

	foreach territory_name in (territories)
		var territory := KD_GetTerritory(territory_name);
		if (territory)
			var owner := territory.owner_faction;
			if (!owner || owner == "")
				owner := "(Unclaimed)";
			endif

			// View button for this territory
			GFAddButton(gump, 30, y_offset, 4005, 4007, GF_CLOSE_BTN, button_id);
			GFTextLine(gump, 65, y_offset, 1149, territory.name);
			GFTextLine(gump, 250, y_offset, 1149, owner);
			GFTextLine(gump, 400, y_offset, 1149, CStr(territory.size_level));

			y_offset += 20;
			button_id += 1;
			count += 1;

			if (count >= page_size)
				break;
			endif
		endif
		sleepms(2);
	endforeach

	// Close Button
	GFAddButton(gump, 200, 550, 4017, 4019, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 550, 1149, "Back");

	var result := GFSendGump(who, gump);

	if (!result || !result[0] || result[0] == 0)
		ShowMainMenu(who);
		return;
	endif

	// User clicked a view button (button_id 100+)
	var clicked_index := result[0] - 100;
	if (clicked_index < 0 || clicked_index >= territories.size())
		SendSysMessage(who, "Invalid selection.");
		ShowMainMenu(who);
		return;
	endif

	var territory_name := territories[clicked_index + 1];
	var territory := KD_GetTerritory(territory_name);
	if (!territory)
		SendSysMessage(who, "Territory not found: " + territory_name);
		ShowMainMenu(who);
		return;
	endif

	// Display info
	SendSysMessage(who, "=== Territory Info ===");
	SendSysMessage(who, "Name: " + territory.name);
	SendSysMessage(who, "Rect: " + territory.rect);
	SendSysMessage(who, "Size Level: " + territory.size_level);
	SendSysMessage(who, "Owner: " + (territory.owner_faction ? territory.owner_faction : "(Unclaimed)"));
	SendSysMessage(who, "Is Capital: " + (territory.is_capital ? "Yes" : "No"));
	SendSysMessage(who, "Rare Resources: " + Join(territory.rare_resources, ", "));
	SendSysMessage(who, "Buildings: " + territory.buildings.size());
	SendSysMessage(who, "Claimed Date: " + FormatTimestamp(territory.claimed_date));

	ShowMainMenu(who);
endfunction

// ============================================================================
// DELETE TERRITORY
// ============================================================================

function DeleteTerritoryMenu(who)
	var territories := TRTY_ListAllTerritories();

	if (territories.size() == 0)
		SendSysMessage(who, "No territories to delete.");
		ShowMainMenu(who);
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 600);
	GFResizePic(gump, 10, 10, 9350, 480, 580);

	GFTextMid(gump, 10, 20, 480, 1153, "DELETE TERRITORY");
	GFTextMid(gump, 10, 40, 480, 137, "Click a territory to delete it (WARNING: PERMANENT!)");

	// Headers
	GFTextLine(gump, 30, 70, 2100, "Name");
	GFTextLine(gump, 250, 70, 2100, "Owner");
	GFTextLine(gump, 400, 70, 2100, "Size");

	var y_offset := 95;
	var page_size := 15;
	var count := 0;
	var button_id := 100;

	foreach territory_name in (territories)
		var territory := KD_GetTerritory(territory_name);
		if (territory)
			var owner := territory.owner_faction;
			if (!owner || owner == "")
				owner := "(Unclaimed)";
			endif

			// Delete button for this territory
			GFAddButton(gump, 30, y_offset, 4017, 4019, GF_CLOSE_BTN, button_id);
			GFTextLine(gump, 65, y_offset, 137, territory.name);
			GFTextLine(gump, 250, y_offset, 1149, owner);
			GFTextLine(gump, 400, y_offset, 1149, CStr(territory.size_level));

			y_offset += 20;
			button_id += 1;
			count += 1;

			if (count >= page_size)
				break;
			endif
		endif
		sleepms(2);
	endforeach

	// Close Button
	GFAddButton(gump, 200, 550, 4005, 4007, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 550, 1149, "Cancel");

	var result := GFSendGump(who, gump);

	if (!result || !result[0] || result[0] == 0)
		ShowMainMenu(who);
		return;
	endif

	// User clicked a delete button (button_id 100+)
	var clicked_index := result[0] - 100;
	if (clicked_index < 0 || clicked_index >= territories.size())
		SendSysMessage(who, "Invalid selection.");
		ShowMainMenu(who);
		return;
	endif

	var territory_name := territories[clicked_index + 1];
	var territory := KD_GetTerritory(territory_name);
	if (!territory)
		SendSysMessage(who, "Territory not found: " + territory_name);
		ShowMainMenu(who);
		return;
	endif

	// Confirm deletion
	var confirm := YesNo(who, "Delete territory: " + territory.name + "? This cannot be undone!");
	if (!confirm)
		SendSysMessage(who, "Deletion cancelled.");
		ShowMainMenu(who);
		return;
	endif

	var delete_result := TRTY_DeleteTerritory(territory_name);
	if (delete_result)
		SendSysMessage(who, "Territory deleted: " + territory_name);
	else
		SendSysMessage(who, "Failed to delete territory.");
	endif

	ShowMainMenu(who);
endfunction

// ============================================================================
// LIST KINGDOMS
// ============================================================================

function ListKingdomsMenu(who)
	var kingdoms := KGD_ListAllKingdoms();

	if (kingdoms.size() == 0)
		SendSysMessage(who, "No kingdoms found.");
		ShowMainMenu(who);
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 600);
	GFResizePic(gump, 10, 10, 9350, 480, 580);

	GFTextMid(gump, 10, 20, 480, 1153, "All Kingdoms");
	GFTextMid(gump, 10, 40, 480, 2100, "Total: " + kingdoms.size());

	// Headers
	GFTextLine(gump, 30, 70, 2100, "Faction");
	GFTextLine(gump, 200, 70, 2100, "Culture");
	GFTextLine(gump, 300, 70, 2100, "Level");
	GFTextLine(gump, 370, 70, 2100, "Territories");

	var y_offset := 95;
	var page_size := 15;
	var count := 0;

	foreach faction_name in (kingdoms)
		var kingdom := KD_GetKingdom(faction_name);
		if (kingdom)
			GFTextLine(gump, 30, y_offset, 1149, faction_name);
			GFTextLine(gump, 200, y_offset, 1149, kingdom.culture);
			GFTextLine(gump, 300, y_offset, 1149, CStr(kingdom.level));
			GFTextLine(gump, 370, y_offset, 1149, CStr(kingdom.territories.size()));

			y_offset += 20;
			count += 1;

			if (count >= page_size)
				break;
			endif
		endif
		sleepms(2);
	endforeach

	// Close Button
	GFAddButton(gump, 200, 550, 4017, 4019, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 550, 1149, "Back");

	var result := GFSendGump(who, gump);
	ShowMainMenu(who);
endfunction

// ============================================================================
// VIEW KINGDOM
// ============================================================================

function ViewKingdomMenu(who)
	var kingdoms := KGD_ListAllKingdoms();

	if (kingdoms.size() == 0)
		SendSysMessage(who, "No kingdoms found.");
		ShowMainMenu(who);
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 600);
	GFResizePic(gump, 10, 10, 9350, 480, 580);

	GFTextMid(gump, 10, 20, 480, 1153, "VIEW KINGDOM INFO");
	GFTextMid(gump, 10, 40, 480, 2100, "Click a kingdom to view details");

	// Headers
	GFTextLine(gump, 30, 70, 2100, "Faction");
	GFTextLine(gump, 200, 70, 2100, "Culture");
	GFTextLine(gump, 300, 70, 2100, "Level");
	GFTextLine(gump, 370, 70, 2100, "Territories");

	var y_offset := 95;
	var page_size := 15;
	var count := 0;
	var button_id := 100;

	foreach faction_name in (kingdoms)
		var kingdom := KD_GetKingdom(faction_name);
		if (kingdom)
			// View button for this kingdom
			GFAddButton(gump, 30, y_offset, 4005, 4007, GF_CLOSE_BTN, button_id);
			GFTextLine(gump, 65, y_offset, 1149, faction_name);
			GFTextLine(gump, 200, y_offset, 1149, kingdom.culture);
			GFTextLine(gump, 300, y_offset, 1149, CStr(kingdom.level));
			GFTextLine(gump, 370, y_offset, 1149, CStr(kingdom.territories.size()));

			y_offset += 20;
			button_id += 1;
			count += 1;

			if (count >= page_size)
				break;
			endif
		endif
		sleepms(2);
	endforeach

	// Close Button
	GFAddButton(gump, 200, 550, 4017, 4019, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 550, 1149, "Back");

	var result := GFSendGump(who, gump);

	if (!result || !result[0] || result[0] == 0)
		ShowMainMenu(who);
		return;
	endif

	// User clicked a view button (button_id 100+)
	var clicked_index := result[0] - 100;
	if (clicked_index < 0 || clicked_index >= kingdoms.size())
		SendSysMessage(who, "Invalid selection.");
		ShowMainMenu(who);
		return;
	endif

	var faction_name := kingdoms[clicked_index + 1];
	var kingdom := KD_GetKingdom(faction_name);
	if (!kingdom)
		SendSysMessage(who, "Kingdom not found: " + faction_name);
		ShowMainMenu(who);
		return;
	endif

	// Display info
	SendSysMessage(who, "=== Kingdom Info ===");
	SendSysMessage(who, KGD_FormatKingdomInfo(kingdom));

	// List territories
	SendSysMessage(who, "=== Territories ===");
	foreach territory_name in (kingdom.territories)
		var territory := KD_GetTerritory(territory_name);
		if (territory)
			var capital_marker := (territory.is_capital ? " [CAPITAL]" : "");
			SendSysMessage(who, "- " + territory.name + capital_marker);
		endif
		sleepms(2);
	endforeach

	ShowMainMenu(who);
endfunction

// ============================================================================
// DELETE KINGDOM
// ============================================================================

function DeleteKingdomMenu(who)
	var faction_name := RequestGumpEx(who, "Enter faction name to DELETE kingdom:", "WARNING: This is permanent!", "", 1);
	if (!faction_name || faction_name == "")
		SendSysMessage(who, "Cancelled.");
		ShowMainMenu(who);
		return;
	endif

	var kingdom := KD_GetKingdom(faction_name);
	if (!kingdom)
		SendSysMessage(who, "Kingdom not found: " + faction_name);
		ShowMainMenu(who);
		return;
	endif

	// Confirm deletion
	var confirm := YesNo(who, "Delete kingdom: " + faction_name + "? This will unclaim all territories!");
	if (!confirm)
		SendSysMessage(who, "Deletion cancelled.");
		ShowMainMenu(who);
		return;
	endif

	var result := KGD_DeleteKingdom(faction_name);
	if (result)
		SendSysMessage(who, "Kingdom deleted: " + faction_name);
	else
		SendSysMessage(who, "Failed to delete kingdom.");
	endif

	ShowMainMenu(who);
endfunction

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

function ReloadConfigs(who)
	SendSysMessage(who, "Configuration reload not yet implemented.");
	SendSysMessage(who, "Restart server to reload configs.");
	ShowMainMenu(who);
endfunction

function ViewDatafileStatus(who)
	SendSysMessage(who, "=== Datafile Status ===");

	// Count territories
	var territories := TRTY_ListAllTerritories();
	SendSysMessage(who, "Territories: " + territories.size());

	// Count kingdoms
	var kingdoms := KGD_ListAllKingdoms();
	SendSysMessage(who, "Kingdoms: " + kingdoms.size());

	// Count claimed territories
	var claimed_count := 0;
	foreach territory_name in (territories)
		var territory := KD_GetTerritory(territory_name);
		if (territory && territory.owner_faction != "")
			claimed_count += 1;
		endif
		sleepms(2);
	endforeach
	SendSysMessage(who, "Claimed Territories: " + claimed_count);
	SendSysMessage(who, "Unclaimed Territories: " + (territories.size() - claimed_count));

	ShowMainMenu(who);
endfunction

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

function Join(arr, separator)
	if (!arr || arr.size() == 0)
		return "";
	endif

	var result := "";
	foreach item in (arr)
		if (result != "")
			result += separator;
		endif
		result += item;
	endforeach

	return result;
endfunction