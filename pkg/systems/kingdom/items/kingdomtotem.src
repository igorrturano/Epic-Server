// ============================================================================
// Kingdom Totem Script
// Allows faction leaders to claim conquered territories
// Epic! Shard - Kingdom Management System v0.1.0
// ============================================================================

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":kingdom:constants";
include ":kingdom:datafile";
include ":kingdom:territory";
include ":kingdom:kingdom";

program KingdomTotem(who, totem)
	if (!who.IsA(POLCLASS_MOBILE))
		return 0;
	endif

	var territory_name := totem.GetProp("territory_name");
	if (!territory_name || territory_name == "")
		SendSysMessage(who, "Error: This totem is not linked to a territory.");
		return 0;
	endif

	var territory := KD_GetTerritory(territory_name);
	if (!territory)
		SendSysMessage(who, "Error: Territory not found.");
		return 0;
	endif

	// Check if already claimed
	if (territory.owner_faction != "")
		SendSysMessage(who, "This territory has already been claimed by " + territory.owner_faction + ".");
		return 0;
	endif

	// Check if claimable
	if (!totem.GetProp("claimable"))
		SendSysMessage(who, "This territory is not yet ready to be claimed.");
		return 0;
	endif

	// Show claim menu
	ShowClaimMenu(who, totem, territory);

	return 1;
endprogram

function ShowClaimMenu(who, totem, territory)
	// Get player's faction
	var faction_name := KGD_GetPlayerFaction(who);

	if (!faction_name || faction_name == "")
		SendSysMessage(who, ERR_NO_FACTION);
		return;
	endif

	// Check if player is faction leader
	if (!KGD_ValidateFactionLeader(who, faction_name))
		// Error message sent by validation function
		return;
	endif

	// Show gump
	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 500, 400);
	GFResizePic(gump, 10, 10, 9350, 480, 380);

	GFTextMid(gump, 10, 20, 480, 1153, "CLAIM TERRITORY");
	GFTextMid(gump, 10, 40, 480, 2100, territory.name);

	var y_offset := 80;

	GFTextLine(gump, 30, y_offset, 2100, "Faction: " + faction_name);
	y_offset += 30;

	// Check if kingdom exists
	var kingdom := KD_GetKingdom(faction_name);

	if (!kingdom)
		// No kingdom - this will be capital
		GFTextLine(gump, 30, y_offset, 0x44, "This will be your faction's CAPITAL territory.");
		y_offset += 20;
		GFTextLine(gump, 30, y_offset, 1149, "You must select a culture for your kingdom.");
		y_offset += 40;

		// Culture selection
		GFTextLine(gump, 30, y_offset, 2100, "Select Culture:");
		y_offset += 25;

		// Culture buttons
		var cultures := array{
			CULTURE_AIGLA,
			CULTURE_LESTE,
			CULTURE_HAROLOTH,
			CULTURE_BJORSKE,
			CULTURE_ALURIEL,
			CULTURE_POLKINEA,
			CULTURE_BADURAN,
			CULTURE_GULTHRAK
		};

		var button_id := 100;
		var col := 0;
		foreach culture in (cultures)
			var x := 30 + (col * 150);

			GFAddButton(gump, x, y_offset, 4005, 4007, GF_CLOSE_BTN, button_id);
			GFTextLine(gump, x + 35, y_offset, 1149, culture);

			button_id += 1;
			col += 1;

			if (col >= 3)
				col := 0;
				y_offset += 25;
			endif

			sleepms(2);
		endforeach

	else
		// Has kingdom - this is expansion
		GFTextLine(gump, 30, y_offset, 0x58, "This will be added as an EXPANSION territory.");
		y_offset += 20;

		GFTextLine(gump, 30, y_offset, 1149, "Current Kingdom:");
		y_offset += 20;
		GFTextLine(gump, 50, y_offset, 2100, "Culture: " + kingdom.culture);
		y_offset += 20;
		GFTextLine(gump, 50, y_offset, 2100, "Level: " + kingdom.level + " (" + KGD_GetLevelName(faction_name) + ")");
		y_offset += 20;
		GFTextLine(gump, 50, y_offset, 2100, "Territories: " + kingdom.territories.size() + "/" + KGD_GetTerritoryLimit(faction_name));
		y_offset += 40;

		// Check territory limit
		var limit := KGD_GetTerritoryLimit(faction_name);
		if (kingdom.territories.size() >= limit)
			GFTextLine(gump, 30, y_offset, 0x26, "ERROR: Territory limit reached!");
			y_offset += 20;
			GFTextLine(gump, 30, y_offset, 0x26, "Level up your kingdom to expand further.");
		else
			// Allow claiming
			GFAddButton(gump, 200, 320, 4029, 4031, GF_CLOSE_BTN, 1);
			GFTextLine(gump, 235, 320, 0x44, "CLAIM TERRITORY");
		endif
	endif

	// Close button
	GFAddButton(gump, 200, 350, 4017, 4019, GF_CLOSE_BTN, 0);
	GFTextLine(gump, 235, 350, 1149, "Close");

	var result := GFSendGump(who, gump);

	if (!result || !result[0])
		return;
	endif

	// Handle result
	if (result[0] == 1)
		// Claim as expansion
		if (kingdom)
			ClaimAsExpansion(who, totem, territory, faction_name);
		endif
	elseif (result[0] >= 100 && result[0] <= 107)
		// Create kingdom with selected culture
		var cultures := array{
			CULTURE_AIGLA,
			CULTURE_LESTE,
			CULTURE_HAROLOTH,
			CULTURE_BJORSKE,
			CULTURE_ALURIEL,
			CULTURE_POLKINEA,
			CULTURE_BADURAN,
			CULTURE_GULTHRAK
		};

		var culture_index := result[0] - 99;
		if (culture_index > 0 && culture_index <= cultures.size())
			var selected_culture := cultures[culture_index];
			CreateKingdomAndClaim(who, totem, territory, faction_name, selected_culture);
		endif
	endif
endfunction

function CreateKingdomAndClaim(who, totem, territory, faction_name, culture)
	// Create kingdom
	if (!KGD_CreateKingdom(faction_name, territory.name, culture))
		SendSysMessage(who, "Failed to create kingdom.", 0x26);
		return;
	endif

	// Claim territory
	if (!TRTY_ClaimTerritory(territory.name, faction_name, 1)) // 1 = capital
		SendSysMessage(who, "Failed to claim territory.", 0x26);
		// Cleanup kingdom
		KGD_DeleteKingdom(faction_name);
		return;
	endif

	// Success - spawn management items
	SpawnManagementItems(who, totem, territory, faction_name);

	// Announce to faction
	SendSysMessage(who, "Kingdom created successfully!", 0x44);
	SendSysMessage(who, "Culture: " + culture, 0x58);
	SendSysMessage(who, "Capital: " + territory.name, 0x58);

	// Remove totem
	DestroyItem(totem);

	syslog("KINGDOM: Kingdom created and claimed - " + faction_name + " (" + culture + ") at " + territory.name);
endfunction

function ClaimAsExpansion(who, totem, territory, faction_name)
	// Add territory to kingdom
	if (!KGD_AddTerritory(faction_name, territory.name))
		SendSysMessage(who, "Failed to add territory to kingdom.", 0x26);
		return;
	endif

	// Claim territory
	if (!TRTY_ClaimTerritory(territory.name, faction_name, 0)) // 0 = expansion
		SendSysMessage(who, "Failed to claim territory.", 0x26);
		// Rollback
		KGD_RemoveTerritory(faction_name, territory.name);
		return;
	endif

	// Success
	SendSysMessage(who, "Territory claimed as expansion!", 0x44);
	SendSysMessage(who, "Expansion: " + territory.name, 0x58);

	// Remove totem
	DestroyItem(totem);

	syslog("KINGDOM: Expansion claimed - " + faction_name + " at " + territory.name);
endfunction

function SpawnManagementItems(who, totem, territory, faction_name)
	// Spawn management board near totem
	var board := CreateItemAtLocation(totem.x + 2, totem.y, totem.z, 0x1E5E, 1, totem.realm);
	if (board)
		board.SetProp("territory_name", territory.name);
		board.SetProp("faction", faction_name);
		board.name := "Management Board [" + territory.name + "]";
		board.movable := 0;

		// Update territory with board serial
		territory.management_board_serial := board.serial;
	endif

	// Spawn donation chest
	var chest := CreateItemAtLocation(totem.x - 2, totem.y, totem.z, 0x0E41, 1, totem.realm);
	if (chest)
		chest.SetProp("territory_name", territory.name);
		chest.SetProp("faction", faction_name);
		chest.name := "Donation Chest [" + territory.name + "]";
		chest.movable := 0;

		// Update territory with chest serial
		territory.chest_serial := chest.serial;
	endif

	// Save territory updates
	KD_SaveTerritory(territory.name, territory);

	SendSysMessage(who, "Management items placed.", 0x58);
endfunction