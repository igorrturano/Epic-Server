// ============================================================================
// Management Board Script
// Territory management interface for faction leaders
// Epic! Shard - Kingdom Management System v0.1.0
// ============================================================================

use uo;
use os;

include ":kingdom:constants";
include ":kingdom:datafile";
include ":kingdom:territory";
include ":kingdom:kingdom";

program ManagementBoard(who, board)
	if (!who.IsA(POLCLASS_MOBILE))
		return 0;
	endif

	var territory_name := board.GetProp("territory_name");

	if (!territory_name || territory_name == "")
		SendSysMessage(who, "Error: This board is not linked to a territory.");
		return 0;
	endif

	var territory := KD_GetTerritory(territory_name);
	if (!territory)
		SendSysMessage(who, "Error: Territory not found.");
		return 0;
	endif

	// Check if player is faction leader
	var faction_name := KGD_GetPlayerFaction(who);
	if (faction_name != territory.owner_faction)
		SendSysMessage(who, "You are not a member of the faction that owns this territory.");
		return 0;
	endif

	if (!KGD_ValidateFactionLeader(who, faction_name))
		SendSysMessage(who, "Only the faction leader can manage this territory.");
		return 0;
	endif

	// TODO Phase 4: Building construction menu
	SendSysMessage(who, "Management Board - Coming in Phase 4 (Building Construction)");
	SendSysMessage(who, "Territory: " + territory.name);

	return 1;
endprogram