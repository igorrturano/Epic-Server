// Boot hook: registrará o packet handler 0x3F do UltimaLive.
use os;

print("UltimaLive: package carregado.");

var regen_script := start_script(":ultimalive:ul_tree_regen");
if (regen_script.errortext)
    SysLog("UltimaLive: erro ao iniciar ul_tree_regen: " + regen_script.errortext);
else
    print("UltimaLive: ul_tree_regen daemon iniciado.");
endif
