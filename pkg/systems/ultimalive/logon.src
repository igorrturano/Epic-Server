use uo;
use polsys;
use basic;
use os;

include ":ultimalive:include/packets";

program logon(who)
    if (who.npctemplate)
        return 0;
    endif
    var result := UL_SendHandshake(who);
    if (result == error)
        Print("UL logon error [" + who.name + "]: " + result.errortext);
        return 1;
    endif
    UL_SendPlayerBlockWindow(who);
    var monitor := Start_Script(":ultimalive:ul_block_monitor", who);
    if (!monitor)
        Print("UL: failed to start ul_block_monitor for " + who.name);
    endif
    return 1;
endprogram
