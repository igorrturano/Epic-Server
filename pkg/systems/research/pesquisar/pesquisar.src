use uo;
use math;
use cfgfile;
use vitals;
use os;

include "include/client";
include "include/sounds";
include ":attributes:attributes";
include ":timedScripts:timedScripts";
include ":gumps:gumps";
include ":gumps:yesNo";
include ":gumps:requestGump";
include ":tn:tngumps";
include ":fls_core:fls_crafting";
include ":recipes:include/scrollRecipes";

// ============================================
// ALTERAÇÕES NESTE ARQUIVO (feat/ea-pesquisar3)
// ============================================
// - Pesquisa extensiva agora exige pena e tinteiro (CheckForPen).
//   O check existia na pesquisa rápida via CheckResearchRequirements,
//   mas o fluxo extensivo (ShowExtensiveResearchGump) o ignorava.
//   Corrigido adicionando o check antes de ValidateResearchParameters.
// ============================================

// ============================================
// CONFIGURAÇÕES DO SISTEMA DE PESQUISA
// ============================================

// Recursos Necessários
const PERGAMINHO_OBJTYPE := 0xE34;
const PERGAMINHO_AMOUNT_RAPIDA := 5;
const PERGAMINHO_AMOUNT_EXTENSIVA := 20;

// Requisitos Mínimos
const MIN_SKILL := 40;
const MIN_MANA := 40;

// Tempo de Pesquisa — proporcional ao nível (ver GetResearchDuration)

// UI - Cores das Barras
const BARRA_BACKGROUND := 83;
const BARRA_FOREGROUND := 50;

// Thresholds de skill usados para determinar o máximo power possível
// para diferentes tipos de pesquisa. O array representa os limites de
// skill para os níveis 5..1 (ver lógica em GetMaxPowerForSkill).
// Usamos var aqui porque a inicialização complexa como struct/array
// pode não ser aceita em uma const expression pelo compilador.
var SKILL_THRESHOLDS := struct{
    "default" := array{80, 70, 60, 50, 40},
    "magic"   := array{100, 90, 80, 70, 0}
};

var STUDY_ACTIONS;
var BOOK_OBJTYPES;
function InitializeGlobals()
    STUDY_ACTIONS := array{"*estudando*", "*escrevendo*", "*tomando notas*", "*conferindo as páginas*", "*lendo um livro*"};
    BOOK_OBJTYPES := array{0xA9D, 0xA9E};
endfunction


program use_research_book(params)
    var who, book;
    if (TypeOf(params) == "Array")
        who := params[1];
        book := params[2];
    elseif (TypeOf(params) == "Struct")
        who := SystemFindObjectBySerial(params.playerSerial);
        book := SystemFindObjectBySerial(params.bookSerial);
    else
        who := params;
        book := 0; 
    endif
    InitializeGlobals();
    
    if (!IsValidPlayer(who))
        return 0;
    endif
    
    if (book && (book == error || TypeOf(book) != "ItemRef"))
        return 0;
    endif
    var gump := GFCreateGump(); 
    
    var activeResearch := GetActiveResearch(who);
    if (activeResearch && GetObjProperty(book, "ShowOngoing"))
        EraseObjProperty(book, "ShowOngoing");
        if (!ShowOngoingResearchGump(who, gump))
            return 0;
        endif
    else
        if (!ShowMainResearchGump(who, gump))
            return 0;
        endif
    endif
    return 1;
endprogram

function GFInitGump(byref gump)
    gump.layout := array{};
    gump.data := array{};
    gump.data_id := 1;
    gump.cur_page := 0;
endfunction


function IsValidPlayer(who)
    return (who && who != error && TypeOf(who) == "MobileRef" && who.connected);
endfunction

function GetManaRequirement(power)
    // Retorna quantidade de mana necessária baseado no power
    case (power)
        1: return 20;
        2: return 25;
        3: return 30;
        4: return 35;
        5: return 40;
        default: return 20;
    endcase
endfunction

function GetIntelligenceRequirement(power)
    // Retorna inteligência mínima necessária baseado no power
    case (power)
        1: return 45;
        2: return 55;
        3: return 65;
        4: return 75;
        5: return 85;
        default: return 45;
    endcase
endfunction

function GetSkillRequirement(power)
    // Retorna skill mínima necessária baseado no power
    case (power)
        1: return 40;
        2: return 50;
        3: return 60;
        4: return 70;
        5: return 80;
        default: return 40;
    endcase
endfunction

function GetResearchDuration(power)
    case (power)
        1: return 2880;
        2: return 4320;
        3: return 5760;
        4: return 8640;
        5: return 10080;
        default: return 1; //10080;
    endcase
endfunction


function ShowMainResearchGump(who, byref gump)
    // ============================================
    // EXIBE O GUMP PRINCIPAL DO SISTEMA DE PESQUISA
    // ============================================
    // Responsável por mostrar a interface principal do livro de pesquisa,
    // verificando se o jogador possui skills válidas e exibindo opções
    // de pesquisa rápida ou extensiva, além de mostrar progresso de
    // pesquisas em andamento.
    // ============================================
    if (!IsValidPlayer(who))
        return 0;
    endif
    
    GFInitGump(gump);
    GFPage(gump, 0);
    GFGumpPic(gump, 0, 0, 114, 0); 
    
    var left_margin := 40;
    var right_margin := 640;
    var top_margin := 40;
    var bottom_margin := 460; 
    var y_pos := top_margin + 70;
    
    BuildGumpHeader(gump, "Livro de Pesquisa");

    // Verificar se o jogador tem alguma skill válida
    var skills := GetResearchSkills(who);
    var hasValidSkill := (skills.ferreiro >= MIN_SKILL || 
                         skills.costureiro >= MIN_SKILL || 
                         skills.carpenter >= MIN_SKILL || 
                         skills.alquimista >= MIN_SKILL || 
                         skills.mago >= MIN_SKILL);

    if (!hasValidSkill)
        // Calcular posição central para a mensagem
        var centerY := (bottom_margin - top_margin) / 2 + top_margin - 50;
        
        // Adicionar um fundo decorativo para a mensagem
        GFResizePic(gump, left_margin, centerY - 20, 83, 270, 100);
        
        // Adicionar as mensagens centralizadas
        GFTextMid(gump, left_margin, centerY, 300, 2517, "Você não possui nenhuma");
        GFTextMid(gump, left_margin, centerY + 20, 300, 2517, "skill necessária para");
        GFTextMid(gump, left_margin, centerY + 40, 300, 2517, "realizar pesquisas.");
    else
        GFTextLine(gump, left_margin, top_margin + 30, 2505, "Escolha uma opção:");
        
        GFAddButton(gump, left_margin, y_pos, 4005, 4006, GF_CLOSE_BTN, 1);
        GFTextLine(gump, left_margin + 35, y_pos, 2517, "Pesquisa Rápida");
        
        y_pos += 40;
        GFAddButton(gump, left_margin, y_pos, 4005, 4006, GF_CLOSE_BTN, 2);
        GFTextLine(gump, left_margin + 35, y_pos, 2517, "Pesquisa Extensiva");
        
        y_pos += 40;
        GFAddButton(gump, left_margin, y_pos, 4005, 4006, GF_CLOSE_BTN, 3);
        GFTextLine(gump, left_margin + 35, y_pos, 2517, "Pesquisa em Desenvolvimento");
    endif

    GFResizePic(gump, 461, 70, 83, 80, 78);
    GFResizePic(gump, 388, 162, 83, 73, 74);
    GFResizePic(gump, 440, 248, 83, 129, 113);
    GFResizePic(gump, 540, 162, 83, 73, 74);

    GFTilePic(gump, 461 + 10, 70 + 10, 0xE9C1);  
    GFTilePic(gump, 388 + 15, 162 + 25, 0xE34); 
    GFTilePic(gump, 540 + 20, 162 + 25, 0xFBF);  
    GFTilePic(gump, 440 + 48, 248 + 15, 0x0A99);  

    GFTextLine(gump, 492, 191, 2103, "+");

    GFTextLine(gump, 372, 371, 2505, "Para pesquisar é necessário");
    GFTextLine(gump, 372, 394, 2517, "- Minimo de mana: 20 rápida / 40 extensiva");
    GFTextLine(gump, 372, 415, 2517, "- Minimo de skill: 40");
    GFTextLine(gump, 372, 433, 2517, "- Minimo de INT: 45 rápida / 55 extensiva");

    var activeResearch := GetActiveResearch(who);
    if (activeResearch)
        y_pos := bottom_margin - 100; 
        GFTextLine(gump, left_margin, y_pos, 2505, "Pesquisa em andamento:");
        y_pos += 20;
        GFTextLine(gump, left_margin, y_pos, 2517, activeResearch.type);
        y_pos += 20;
        
        var nivelTexto := "Nível " + activeResearch.power;
        GFTextLine(gump, left_margin, y_pos, 2517, nivelTexto);
        y_pos += 20;
        
        GFTextLine(gump, left_margin, y_pos, 2517, "Progresso: " + CustomFormatRealToString(CalculateProgress(activeResearch), 2) + "%");
    endif

    var input := GFSendGump(who, gump);
    if (input[0] == error)
        return 1;
    endif

    if (!hasValidSkill)
        return 1;
    endif

    case (input[0])
        1: ShowQuickResearchGump(who, gump);
        2: 
            var result := StartExtensiveResearch(who, gump);
            if (result == 1)
            elseif (result == 0)
            else
                SendSysMessageEx(who, "Não foi possível iniciar a pesquisa extensiva. Tente novamente.", SSM_FAIL);
            endif
        3: ShowOngoingResearchGump(who, gump);
        default: 
    endcase

    return 1;
endfunction

function ShowQuickResearchGump(who, byref gump)
    if (!IsValidPlayer(who))
        return 0;
    endif
    
     
 
    var skills := GetResearchSkills(who);
    var types := GetAvailableResearchTypes(skills, 1);
    var selectedType := "";
    var selectedPower := 0;
    
    while (1)
        GFInitGump(gump);  
        GFPage(gump, 0);
        GFGumpPic(gump, 0, 0, 114, 0);
        
        var left_margin := 40;
        var right_margin := 640; 
        var top_margin := 40;
        var bottom_margin := 460; 
        
    BuildGumpHeader(gump, "Pesquisa Rápida");
        GFTextLine(gump, left_margin, top_margin + 30, 2505, "Escolha o tipo de Pesquisa Rápida:");
        
        var y_pos := top_margin + 70;
           
        foreach type in types
            GFAddButton(gump, left_margin, y_pos, 4005, 4006, GF_CLOSE_BTN, 100 + _type_iter);
            GFTextLine(gump, left_margin + 35, y_pos, 2517, type);
            y_pos += 40; 
        endforeach

        if (selectedType != "")
            GFTextMid(gump, right_margin / 2 + 30, top_margin, right_margin / 2, 2517, "Complexidade da " + selectedType + "");
            
            var maxPower := 5;
            case (selectedType)
                "Receita Alquimica":
                "Tinta":
                    maxPower := Min(GetMaxPowerForInk(skills.alquimista), 5);
                "Instrução de Metalurgia":
                    maxPower := Min(GetMaxPowerForSkill(skills.ferreiro), 5);
                "Instrução de Marcenaria":
                    maxPower := Min(GetMaxPowerForSkill(skills.carpenter), 2);
                "Instrução de Trabalho Doméstico":
                    maxPower := Min(GetMaxPowerForSkill(skills.costureiro), 2);
                "Magia":
                    maxPower := Min(GetMaxPowerForMagic(skills.mago), 5);
                default:
                    maxPower := 2;
            endcase

            y_pos := top_margin + 70;
            for i := 1 to maxPower
                GFAddButton(gump, right_margin / 2 + 50, y_pos, 4005, 4006, GF_CLOSE_BTN, i);
                GFTextLine(gump, right_margin / 2 + 85, y_pos, 2517, "Nível " + i + "  (" + GetManaRequirement(i) + " mana)");
                y_pos += 40;
            endfor
        else
            GFResizePic(gump, 570, 69, 83, 67, 70);
            GFTextLine(gump, 363, 97, 2517, "Consome 5 pergaminhos em branco");
            GFTextLine(gump, 363, 180, 2517, "Consome 20 a 40 de mana (por nível)");
            GFTextLine(gump, 448, 143, 2517, "+");
            GFResizePic(gump, 363, 290, 83, 80, 131);
            GFResizePic(gump, 449, 290, 83, 80, 131);
            GFResizePic(gump, 535, 290, 83, 80, 131);
            GFTextMid(gump, 363, 424, 80, 2505, "Comuns");
            GFTextMid(gump, 363, 444, 80, 2505, "Lv 1-2");
            GFTextMid(gump, 449, 424, 80, 2505, "Antigos");
            GFTextMid(gump, 449, 444, 80, 2505, "Lv 3");
            GFTextMid(gump, 535, 424, 80, 2505, "Raros");
            GFTextMid(gump, 535, 444, 80, 2505, "Lv 4-5");

            GFTilePic(gump, 560 + 20, 70 + 25, 0xE34);
            GFTilePic(gump, 363 + 30, 290 + 15, 0x0A99);
            GFTilePic(gump, 449 + 30, 290 + 15, 0x63FE);
            GFTilePic(gump, 535 + 30, 290 + 15, 0x0C15);
        endif

        AddBackButton(gump, left_margin, bottom_margin);

        var input := GFSendGump(who, gump);
        
        if (input[0] == 0)
            ShowMainResearchGump(who, gump);  
            return 0;
        elseif (input[0] >= 101 && input[0] <= 100 + types.size())
            selectedType := types[input[0] - 100];
            selectedPower := 0; 
        elseif (input[0] >= 1 && input[0] <= 5 && selectedType != "")
            selectedPower := input[0];
            break; 
        endif
    endwhile

if (selectedType != "" && selectedPower > 0)
    var recipe := struct{"type" := selectedType, "power" := selectedPower};
    return PerformQuickResearch(who, recipe, gump);
endif
    
    return 0;
endfunction

function PerformQuickResearch(who, recipe, byref gump)
    if (!CheckResearchRequirements(who, 1, recipe.power, recipe))
        return 0;
    endif

    var result := PerformRapidResearch(who, recipe, gump);
    ShowMainResearchGump(who, gump);  
    
    return result;
endfunction

function ShowExtensiveResearchGump(who, byref gump)
    if (!IsValidPlayer(who))
        return 0;
    endif
    
     
 
    var skills := GetResearchSkills(who);
    var types := GetAvailableResearchTypes(skills);
    var selectedType := "";
    var selectedPower := 0;
    
    while (1)
        GFInitGump(gump);  
        GFPage(gump, 0);
        GFGumpPic(gump, 0, 0, 114, 0);
        
        var left_margin := 40;
        var right_margin := 640;
        var top_margin := 40;
        var bottom_margin := 460;
        
    BuildGumpHeader(gump, "Pesquisa Extensiva");
        GFTextLine(gump, left_margin, top_margin + 30, 2505, "Escolha o tipo de Pesquisa:");
        
        var y_pos := top_margin + 140;
        
        foreach type in types
            GFAddButton(gump, left_margin, y_pos - 70, 4005, 4006, GF_CLOSE_BTN, 100 + _type_iter);
            GFTextLine(gump, left_margin + 35, y_pos - 70, 2517, type);
            y_pos += 40;
        endforeach

        if (selectedType != "")
            GFTextMid(gump, right_margin / 2 + 30, top_margin, right_margin / 2, 2517, "Complexidade da " + selectedType + ":");
            
            var maxPower := 5;
            case (selectedType)
                "Receita Alquimica":
                "Tinta":
                    maxPower := Min(GetMaxPowerForInk(skills.alquimista), 5);
                "Instrução de Metalurgia":
                    maxPower := Min(GetMaxPowerForSkill(skills.ferreiro), 5);
                "Instrução de Marcenaria":
                    maxPower := Min(GetMaxPowerForSkill(skills.carpenter), 2);
                "Instrução de Trabalho Doméstico":
                    maxPower := Min(GetMaxPowerForSkill(skills.costureiro), 2);
                "Magia":
                    maxPower := Min(GetMaxPowerForMagic(skills.mago), 5);
                default:
                    maxPower := 2;
            endcase

            y_pos := top_margin + 70;
            for i := 1 to maxPower
                GFAddButton(gump, right_margin / 2 + 50, y_pos, 4005, 4006, GF_CLOSE_BTN, i);
                GFTextLine(gump, right_margin / 2 + 85, y_pos, 2517, "Nível " + i);
                y_pos += 40;
            endfor

            if (selectedPower > 0)
                var researchTimeSeconds := GetResearchDuration(selectedPower) * 60;
                var formattedTime := FormatResearchTime(researchTimeSeconds);

                GFPicTiled(gump, right_margin / 2 + 50, y_pos + 20, 280, 5, 96);
                GFTextLine(gump, right_margin / 2 + 50, y_pos + 40, 2517, "Você deseja iniciar essa pesquisa?");
                GFTextLine(gump, right_margin / 2 + 50, y_pos + 60, 2517, "Ela vai requerer " + formattedTime + " de estudo");
                GFAddButton(gump, right_margin / 2 + 50, y_pos + 100, 4005, 4006, GF_CLOSE_BTN, 1001);
                GFAddButton(gump, right_margin / 2 + 225, y_pos + 100, 4005, 4006, GF_CLOSE_BTN, 1002);
                GFTextLine(gump, right_margin / 2 + 89, y_pos + 102, 2517, "Sim");
                GFTextLine(gump, right_margin / 2 + 265, y_pos + 102, 2517, "Não");
            endif
        else

            GFResizePic(gump, 580, 69, 83, 67, 70);
            GFTextLine(gump, 363, 97, 2517, "Consome 20 pergaminhos em branco");
            GFTextLine(gump, 448, 133, 2517, "+");
            GFTextLine(gump, 363, 160, 2517, "Consome 40 de mana");
            GFTextLine(gump, 448, 187, 2517, "+");
            GFTextLine(gump, 360, 214, 2517, "Duração: 2 dias (Lv1) a 7 dias (Lv5)");
            GFResizePic(gump, 363, 290, 83, 80, 131);
            GFResizePic(gump, 449, 290, 83, 80, 131);
            GFResizePic(gump, 535, 290, 83, 80, 131);
            GFTextMid(gump, 363, 424, 80, 2505, "Comum");
            GFTextMid(gump, 363, 444, 80, 2505, "Lv 1-2");
            GFTextMid(gump, 449, 424, 80, 2505, "Velha");
            GFTextMid(gump, 449, 444, 80, 2505, "Lv 3");
            GFTextMid(gump, 535, 424, 80, 2505, "Rara");
            GFTextMid(gump, 535, 444, 80, 2505, "Lv 4-5");

            GFTilePic(gump, 570 + 20, 70 + 25, 0xE34);
            GFTilePic(gump, 363 + 30, 290 + 15, 0x0A99);
            GFTilePic(gump, 449 + 30, 290 + 15, 0x63FE);
            GFTilePic(gump, 535 + 30, 290 + 15, 0x0C15);
        endif

        GFAddButton(gump, left_margin, bottom_margin - 40, 4005, 4006, GF_CLOSE_BTN, 0);
        GFTextLine(gump, left_margin + 35, bottom_margin - 40, 2517, "Cancelar");
        AddBackButton(gump, left_margin, bottom_margin);

   var input := GFSendGump(who, gump);
        
        if (input[0] == 0)
            ShowMainResearchGump(who, gump);  
            return 0;
        elseif (input[0] >= 101 && input[0] <= 100 + types.size())
            selectedType := types[input[0] - 100];
            selectedPower := 0;
        elseif (input[0] >= 1 && input[0] <= 5 && selectedType != "")
            selectedPower := input[0];
        elseif (input[0] == 1001)
            var recipe := struct{"type" := selectedType, "power" := selectedPower, "extensiveResearch" := 1};
            case (selectedType)
                "Instrução de Metalurgia":            recipe.+craftSkillType := "MW";
                "Instrução de Marcenaria":            recipe.+craftSkillType := "WW";
                "Instrução de Trabalho Doméstico":    recipe.+craftSkillType := "DW";
            endcase

            if (!CheckforBooks(who, selectedPower))
                SendSysMessageEx(who, "Você não está em uma biblioteca apropriada para este nível de pesquisa.", SSM_FAIL);
                continue;
            endif

            if (!CheckForPen(who.backpack, 0))
                SendSysMessageEx(who, "Você precisa de uma pena e tinteiro para iniciar a pesquisa.", SSM_FAIL);
                continue;
            endif

            if (!CheckResearchRequirements(who, 0, selectedPower, recipe))
                selectedType := "";
                selectedPower := 0;
                continue;
            endif

            if (!ValidateResearchParameters(who, recipe))
                selectedType := "";
                selectedPower := 0;
                continue;
            endif

            if (ConsumeResearchResources(who, recipe))
                if (InitiateResearch(who, recipe))
                    SendSysMessageEx(who, "Pesquisa extensiva iniciada com sucesso!", SSM_INFO);
                    return 1;
                endif
            else
                SendSysMessageEx(who, "Não foi possível iniciar a pesquisa. Verifique os requisitos.", SSM_FAIL);
            endif
            selectedType := "";
            selectedPower := 0;
        elseif (input[0] == 1002)
            selectedPower := 0;
        endif
    endwhile

    return 0;
endfunction

function ValidateResearchParameters(who, recipe)
    // ============================================
    // VALIDA OS PARÂMETROS DA PESQUISA
    // ============================================
    // Verifica se o nível de poder da pesquisa está dentro dos limites
    // válidos (1-5) e se o tipo de pesquisa selecionado está disponível
    // para as skills do jogador.
    // ============================================
    if (recipe.power < 1 || recipe.power > 5)
        SendSysMessageEx(who, "Nível de poder inválido para a pesquisa.", SSM_FAIL);
        return 0;
    endif

    var availableTypes := GetAvailableResearchTypes(GetResearchSkills(who));
    if (!(recipe.type in availableTypes))
        SendSysMessageEx(who, "Tipo de pesquisa inválido selecionado.", SSM_FAIL);
        return 0;
    endif

    return 1;
endfunction

function ConsumeResearchResources(who, recipe)
    // ============================================
    // CONSUME OS RECURSOS NECESSÁRIOS PARA A PESQUISA
    // ============================================
    // Remove os pergaminhos em branco necessários do inventário do jogador
    // com base no tipo de pesquisa (rápida ou extensiva).
    // ============================================
    
    // Adicionado consumo de mana para pesquisa extensiva.
    if (recipe.extensiveResearch)
        if (!CheckAndConsumeMana(who, 0, recipe.power))
            return 0; // Mensagem de erro já é enviada por CheckAndConsumeMana
        endif
    endif

    var pergaminho_amount := recipe.extensiveResearch ? PERGAMINHO_AMOUNT_EXTENSIVA : PERGAMINHO_AMOUNT_RAPIDA;

    if (!ConsumeSubstance(who.backpack, PERGAMINHO_OBJTYPE, pergaminho_amount))
        SendSysMessageEx(who, "Você precisa de no mínimo " + pergaminho_amount + " pergaminhos em branco para iniciar esta pesquisa", SSM_FAIL);
        
        // Se a pesquisa for extensiva, devolve a mana consumida.
        if (recipe.extensiveResearch)
            var manaToRefund := GetManaRequirement(recipe.power);
            AP_SetVital(who, "Mana", AP_GetVital(who, "Mana") + manaToRefund);
        endif
        
        return 0;
    endif

    
    return 1;
endfunction

function InitiateResearch(who, recipe)
    // ============================================
    // INICIA O PROCESSO DE PESQUISA EXTENSIVA
    // ============================================
    // Define os timestamps de início e fim da pesquisa, chama StartResearch
    // para iniciar o processo, e fornece feedback sonoro e visual ao jogador
    // sobre o sucesso ou falha do início da pesquisa.
    // ============================================
    recipe.start := ReadGameClock();
    recipe.end := recipe.start + (GetResearchDuration(recipe.power) * 60);
    
    var startResult := StartResearch(who, recipe);

    if (startResult)
        if (who.gender == 1)
            PlaySoundEffect(who, 0x32C); 
        else
            PlaySoundEffect(who, 0x43e); 
        endif
        
        PrintTextAbove(who, "*inicia a pesquisa com determinação*");
        
        NotifyResearchResult(who, 1);
        return 1;
    else
        NotifyResearchResult(who, 0);
        return 0;
    endif
endfunction

function StartResearch(who, recipe, remainingTime := 0)
    // ============================================
    // INICIA O TIMER E PROCESSO DE PESQUISA
    // ============================================
    // Configura o timer para pesquisa extensiva, seleciona magia se necessário,
    // salva os dados da pesquisa no jogador e inicia verificações periódicas
    // do progresso da pesquisa.
    // ============================================
    if (!who || who == error)
        return 0;
    endif

    if (remainingTime)
        recipe.start := ReadGameClock() - (GetResearchDuration(recipe.power) * 60 - remainingTime);
    else
        recipe.start := ReadGameClock();
    endif

    if (recipe.type == "Magia")
        var spellId := SelectRandomSpell(recipe.power);
        if (spellId)
            recipe.spellId := spellId;
        else
            return 0;
        endif
    endif

    SetObjProperty(who, "aprenderrecipe", recipe);

    var research_actions := array{
        "*estudando profundamente*",
        "*fazendo anotações detalhadas*",
        "*analisando cuidadosamente*",
        "*colocando alguns livros na mochila*",
        "*consultando referências*",
        "*realizando experimentos*"
    };

    for i := 1 to 5
        if (!CheckStudyConditions(who, who.x, who.y, who.facing))
            SendSysMessageEx(who, "Condições de estudo não atendidas.", SSM_FAIL);
            return 0;
        endif
        
        PrintTextAbove(who, research_actions[RandomInt(research_actions.size()) + 1]);
        PlaySoundEffect(who, 0x24a);   

        sleep(3);
    endfor

    var duration := remainingTime ? remainingTime : (GetResearchDuration(recipe.power) * 60);
    var timerName := "CompleteResearch";
    var level := 0;
    var timerInfo := struct{
        "type" := "CompleteResearch",
        "playerSerial" := who.serial,
        "recipeType" := recipe.type,
        "recipePower" := recipe.power,
        "craftSkillType" := recipe.craftSkillType,
        "startTime" := recipe.start,
        "spellId" := recipe.spellId
    };

    var result := TS_StartTimer(who, timerName, duration, level, timerInfo);

    if (result != 1)
        EraseObjProperty(who, "aprenderrecipe");
        return 0;
    endif

    StartResearchCheck(who);

    return 1;
endfunction

function StartExtensiveResearch(who, byref gump)
    if (!who || who == error)
        return -1;
    endif
    
    var handleResult := HandleExistingResearch(who, gump);
    if (handleResult != 1)
        return 0;
    endif

    var result := ShowExtensiveResearchGump(who, gump);
    if (result == 0)
        return 0;
    endif

    return 1;
endfunction

function NotifyResearchResult(who, success, message := "")
    if (success)
        SendSysMessageEx(who, message, SSM_INFO);
    else
        if (message == "")
            message := "Falha ao iniciar a pesquisa. Tente novamente.";
        endif
        SendSysMessageEx(who, message, SSM_FAIL);
    endif
endfunction

function ShowOngoingResearchGump(who, byref gump)
    if (!who || who == error || TypeOf(who) != "MobileRef")
        return;
    endif
    
    var activeResearch := GetActiveResearch(who);
    if (!activeResearch)
        SendSysMessageEx(who, "Você não tem nenhuma pesquisa em andamento.", SSM_FAIL);
        ShowMainResearchGump(who, gump);  
        return;
    endif
    

    GFInitGump(gump);
    GFPage(gump, 0);
    GFGumpPic(gump, 0, 0, 114, 0);
    
    var left_margin := 40;
    var right_margin := 640;
    var top_margin := 40;
    var bottom_margin := 460;
    
    BuildGumpHeader(gump, "Pesquisa em Andamento");
    
    var y_pos := top_margin + 40;
    GFTextLine(gump, left_margin, y_pos, 2505, "Tipo: " + activeResearch.type);
    y_pos += 40;
    GFTextLine(gump, left_margin, y_pos, 2505, "Complexidade: " + activeResearch.power);
    y_pos += 40;
    
    var progresso := CalculateProgress(activeResearch);
    
    // Barra de progresso
    var progressoInt := CInt(progresso);
    var barraTotal := right_margin - left_margin - 40;
    var barraAltura := 36;
    GFBuildBarCustom(gump, left_margin + 20, y_pos, barraTotal, barraAltura, progressoInt, 100);
    GFTextMid(gump, left_margin + 20, y_pos + 10, barraTotal, 2517, progressoInt + "%");
    y_pos += barraAltura + 20;

    var tempoRestante := CalculateRemainingTime(activeResearch);
    var totalSeconds := tempoRestante.horas * 3600 + tempoRestante.minutos * 60 + tempoRestante.segundos;
    var formattedTime := FormatResearchTime(totalSeconds);
    GFTextLine(gump, left_margin, y_pos, 2505, "Tempo restante: " + formattedTime);
    
    if (progresso >= 100)
        GFAddButton(gump, left_margin, bottom_margin - 40, 4005, 4006, GF_CLOSE_BTN, 1);
        GFTextLine(gump, left_margin + 35, bottom_margin - 40, 2517, "Receber o Pergaminho");
    else
        GFTextLine(gump, left_margin, bottom_margin - 40, 2517, "Pesquisa em andamento...");
    endif

    AddBackButton(gump, left_margin, bottom_margin);

    var result := GFSendGump(who, gump);
    if (result[0] == 0)
        ShowMainResearchGump(who, gump);  
        return;
    endif
    if (result == error)
        return;
    endif
if (result[0] == 1 && progresso >= 100)
    CheckResearchCompletion(who, gump);  
    ShowMainResearchGump(who, gump);
endif
endfunction

function GFBuildBarCustom(byref gump, x, y, width, height, curValue := 0, maxValue := 100)
   // Barra de fundo
   GFResizePic(gump, x, y, BARRA_BACKGROUND, width, height);

   // Calcular a largura da barra de progresso
   var barWidth := CInt((CDbl(curValue) / CDbl(maxValue)) * (width - 24));  

   // Garantir que a barra não ultrapasse a largura total
   barWidth := Max(Min(barWidth, width - 24), 0);  // Prevenir valores negativos

   // Barra de progresso
   if (barWidth > 0)
   // Usar GFGumpPicTiled para uma aparência mais consistente
      GFGumpPicTiled(gump, x + 12, y + 12, barWidth, height - 24, BARRA_FOREGROUND);
   endif

   return 1;
endfunction

function CheckResearchRequirements(who, isQuickResearch := 0, power := 0, recipe := 0)
    // Verificar Inteligência
    var minInt := GetIntelligenceRequirement(power);

    if (AP_GetStat(who, "Intelligence") < minInt)
        SendSysMessageEx(who, "Você precisa ter no mínimo " + minInt + " de Inteligência para pesquisa nível " + power + ".", SSM_FAIL);
        return 0;
    endif

    // Verificar Mana
    var minMana := GetManaRequirement(power);

    var currentMana := AP_GetVital(who, "Mana");
    if (currentMana < minMana)
        SendSysMessageEx(who, "Você precisa ter no mínimo " + minMana + " de mana para esta pesquisa.", SSM_FAIL);
        return 0;
    endif

    // Verificar Skill
    var minSkill := GetSkillRequirement(power);

    var skillLevel := 0;
    if (recipe)
        case (recipe.type)
            "Instrução de Metalurgia":
                skillLevel := EffectiveSkill(who, "Smithing");
            "Instrução de Marcenaria":
                skillLevel := EffectiveSkill(who, "Carpentry");
            "Instrução de Trabalho Doméstico":
                // Path-rework: legacy "Trabalho Doméstico" recipes cover both
                // tailoring and provisioning. Use the higher of the two new
                // skills (or the legacy parent via EffectiveSkill bridge).
                var _td_tail := EffectiveSkill(who, "Tailoring");
                var _td_prov := EffectiveSkill(who, "Provisioning");
                skillLevel := (_td_tail > _td_prov) ? _td_tail : _td_prov;
            "Receita Alquimica":
            "Tinta":
                skillLevel := AP_GetSkill(who, ALCHEMY);
            "Magia":
                skillLevel := AP_GetSkill(who, MAGERY);
        endcase

        if (skillLevel < minSkill)
            SendSysMessageEx(who, "Você precisa ter no mínimo " + minSkill + " de skill para esta pesquisa.", SSM_FAIL);
            return 0;
        endif
    endif

    // Verificar Montaria
    if (GetEquipmentByLayer(who, LAYER_MOUNT))
        SendSysMessageEx(who, "Você não pode pesquisar montado.", SSM_FAIL);
        return 0;
    endif

    // Verificar Local de Estudo
    if (!CheckforBooks(who, power))
        SendSysMessageEx(who, "Você está distante demais de um local de estudo apropriado para este nível de pesquisa", SSM_FAIL);
        return 0;
    endif

    // Verificar Pena
    if (!CheckForPen(who.backpack, 0))
        SendSysMessageEx(who, "Você precisa de uma pena e tinteiro para iniciar a pesquisa.", SSM_FAIL);
        return 0;
    endif
    
    // Verificar Pergaminhos
    var requiredPergaminhos := isQuickResearch ? PERGAMINHO_AMOUNT_RAPIDA : PERGAMINHO_AMOUNT_EXTENSIVA;
    if (!CountPergaminhosInBackpack(who.backpack, requiredPergaminhos))
        SendSysMessageEx(who, "Você precisa de " + requiredPergaminhos + " pergaminhos em branco para iniciar esta pesquisa.", SSM_FAIL);
        return 0;
    endif
    
    return 1;
endfunction

function CountPergaminhosInBackpack(backpack, requiredAmount)
    var count := 0;
    foreach item in EnumerateItemsInContainer(backpack)
        if (item.objtype == PERGAMINHO_OBJTYPE)
            count += item.amount;
            if (count >= requiredAmount)
                return 1;
            endif
        endif
    endforeach
    return 0;
endfunction

function GetActiveResearch(who)
    if (!who || who == error || TypeOf(who) != "MobileRef")
        return error;
    endif
    
    var activeResearch := GetObjProperty(who, "aprenderrecipe");
    if (activeResearch == error)
        return error;
    endif
    return activeResearch;
endfunction

function CheckforBooks(who, power := 0)
    // Validação defensiva: prevenir chamadas com parâmetros inválidos
    if (!who || who == error)
        return 0;
    endif

    if (power < 0 || power > 5)
        return 0;
    endif

    var items := ListItemsNearLocation(who.x, who.y, who.z, 5, who.realm);

    var commonBooks := {0x6F97, 0x6F98};  // comum — power 1-2
    var oldBooks    := {0x63FE, 0x63FD, 0x63FF, 0x6400, 0x6A9E, 0x6A9F, 0x6AA0, 0x6AA1};  // velha — power 3
    var rareBooks   := {0xEA08, 0xEA07, 0x2DEF, 0x2DF0, 0x6A94, 0x6A95, 0x6A96, 0x6A97, 0x0C14, 0x0C15};  // rara — power 4-5

    foreach item in items
        if (item.objtype in rareBooks)
            return 1;
        endif
        if (item.objtype in oldBooks && power <= 3)
            return 1;
        endif
        if (item.objtype in commonBooks && power <= 2)
            return 1;
        endif
    endforeach
    
    return 0;
endfunction

function GetResearchSkills(who)
    // "costureiro" is the tailor display entry — bridge to Tailoring (with
    // EffectiveSkill falling back to legacy Domestic_Work for pre-migration
    // characters). Other entries use legacy constants that resolve to the
    // same SkillId as their new names via cfg Aliases.
    return struct{
        "ferreiro" := EffectiveSkill(who, "Smithing"),
        "costureiro" := EffectiveSkill(who, "Tailoring"),
        "alquimista" := AP_GetSkill(who, ALCHEMY),
        "mago" := AP_GetSkill(who, MAGERY),
        "carpenter" := EffectiveSkill(who, "Carpentry")
    };
endfunction

function CheckResearchCompletion(who, byref gump)   
    var activeResearch := GetActiveResearch(who);
    if (activeResearch)
        var progress := CalculateProgress(activeResearch);
        if (progress >= 100)
            CompleteResearch(who, activeResearch, gump);
        endif
    endif
endfunction

function CustomYesNoGump(who, prompt, byref gump, yes_text := "Sim", no_text := "Não")
    
   
   GFInitGump(gump); 
   GFPage(gump, 0);
   GFGumpPic(gump, 0, 0, 114, 0); 
   
   var left_margin := 40;
   var right_margin := 640; 
   var top_margin := 40;
   var bottom_margin := 460; 
   
   GFTextMid(gump, left_margin, top_margin, right_margin - left_margin, 2439, "Confirmação");
   
   var y_pos := top_margin + 80;
   GFTextMid(gump, left_margin, y_pos, right_margin - left_margin, 2505, prompt);
   
   y_pos += 80;
   
   GFAddButton(gump, left_margin + 100, y_pos, 4005, 4006, GF_CLOSE_BTN, 1);
   GFTextLine(gump, left_margin + 135, y_pos, 2517, yes_text);
   
   GFAddButton(gump, right_margin - 200, y_pos, 4005, 4006, GF_CLOSE_BTN, 0);
   GFTextLine(gump, right_margin - 165, y_pos, 2517, no_text);
   
   AddBackButton(gump, left_margin, bottom_margin);

   var input := GFSendGump(who, gump);
   if (input[0] == 0)
       ShowMainResearchGump(who, gump);  
       return -1;
   endif
   return (input[0] == 1);
endfunction

function HandleExistingResearch(who, byref gump)
    if (!who || who == error)
        return 0;
    endif
    var aprendendo := GetObjProperty(who, "aprenderrecipe");
    if (aprendendo != error)
        var result := CustomYesNoGump(who, "Você ainda está fazendo uma pesquisa. Deseja cancelar e começar outra?", gump);
        if (result == -1) 
            ShowMainResearchGump(who, gump);
            return -1;
        elseif (!result)
            SendSysMessageEx(who, "Pesquisa atual mantida.", SSM_INFO);
            ShowMainResearchGump(who, gump);
            return 0;
        endif
        EraseObjProperty(who, "aprenderrecipe");
    endif
    return 1;
endfunction


function AddBackButton(gump, left_margin, bottom_margin)
    GFAddButton(gump, left_margin, bottom_margin - 40, 4014, 4015, GF_CLOSE_BTN, 0);
    GFTextLine(gump, left_margin + 35, bottom_margin - 40, 2517, "Voltar");
endfunction


// Helper para construir cabeçalhos de Gump consistentes
function BuildGumpHeader(byref gump, title)
    var left_margin := 40;
    var top_margin := 40;
    var right_margin := 640;
    // Texto centralizado no topo do gump; o font 2439 é usado nos outros gumps
    GFTextMid(gump, left_margin - 160, top_margin, right_margin - left_margin, 2439, title);
endfunction



function CompleteResearchTimer(params, byref gump)   
    if (!params)
        return;
    endif

    var who := SystemFindObjectBySerial(params.playerSerial);
    if (!who || who == error || TypeOf(who) != "MobileRef")
        return;
    endif
    
    var activeResearch := GetActiveResearch(who);
    if (!activeResearch || activeResearch.type != params.recipeType || activeResearch.power != params.recipePower)
        return;
    endif

    if (params.spellId)
        activeResearch.spellId := params.spellId;
    endif
    
    
    CompleteResearch(who, activeResearch, gump);
endfunction

function DetermineResearchItem(recipe)
    var skillType;
    case (recipe.type)
        "Instrução de Metalurgia":
            skillType := (recipe.craftSkillType != error) ? recipe.craftSkillType : "MW";
            return GetScrollObjtype(skillType, recipe.power);
        "Instrução de Marcenaria":
            skillType := (recipe.craftSkillType != error) ? recipe.craftSkillType : "WW";
            return GetScrollObjtype(skillType, recipe.power);
        "Instrução de Trabalho Doméstico":
            skillType := (recipe.craftSkillType != error) ? recipe.craftSkillType : "DW";
            return GetScrollObjtype(skillType, recipe.power);
        "Receita Alquimica": return GetScrollObjtype("alchemy", recipe.power);
        "Tinta":             return GetScrollObjtype("dye", recipe.power);
        "Magia":             return GetMagicScrollObjtype(recipe.power);
    endcase
    return 0;
endfunction

function ResearchTimer(event)
    var params := struct{
        "playerSerial" := event.player,
        "bookSerial" := event.bookSerial
    };
    
    var who := SystemFindObjectBySerial(event.player);
    if (!who || who == error || TypeOf(who) != "MobileRef")
        return;
    endif

    var activeResearch := GetActiveResearch(who);
    if (activeResearch)
        var progress := CalculateProgress(activeResearch);
        
        if (progress < 100)
            StartResearchCheck(who);
        else
            use_research_book(params);  
        endif
    else
        TS_LowerDuration(who, "ResearchCheck", -1);
    endif
endfunction

function StartResearchCheck(who)
    if (!who || who == error)
        return;
    endif

    var activeResearch := GetActiveResearch(who);
    if (!activeResearch)
        return;
    endif

    var checkInterval := 60; // Verifica a cada 1 minuto
    var timerName := "ResearchCheck";
    
    // Remover timer existente, se houver
    if (TS_GetTimerInfo(who, timerName))
        TS_LowerDuration(who, timerName, -1);
    endif

    var params := struct{
        "type" := "ResearchCheck",
        "playerSerial" := who.serial
    };

    var result := TS_StartTimer(who, timerName, checkInterval, 0, params);
    
    if (result != 1)
        // Timer não pôde ser iniciado
    endif

endfunction

function NotifyResearchCompletion(who, recipe)
    PlaySoundEffect(who, 0x1F3);
endfunction

function FinishQuickResearch(who, recipe)
    var itemID := DetermineResearchItem(recipe);
    if (!itemID)
        SendSysMessageEx(who, "Erro ao determinar o item da pesquisa. Contate um GM.", SSM_FAIL);
        return 0;
    endif

    // CreateItemInBackpack fires the CreateScript which assigns the recipe via scrollRecipes.inc
    var item := CreateItemInBackpack(who, itemID, 1);
    if (!item)
        SendSysMessageEx(who, "Erro ao criar o item da pesquisa: " + item.errortext, SSM_FAIL);
        return 0;
    endif

    if (recipe.type == "Magia")
        SetObjProperty(item, "SpellId", recipe.spellId);
        SendSysMessageEx(who, "Voce criou um novo pergaminho de magia!", SSM_INFO);
    else
        SendSysMessageEx(who, "Voce concluiu sua pesquisa rapida com sucesso!", SSM_INFO);
    endif

    return 1;
endfunction


function GetAvailableResearchTypes(skills, isRapid := 0)
    var types := array{};
    if (skills.ferreiro >= MIN_SKILL)
        types.append("Instrução de Metalurgia");
    endif
    if (skills.carpenter >= MIN_SKILL)
        types.append("Instrução de Marcenaria");
    endif
    if (skills.costureiro >= MIN_SKILL)
        types.append("Instrução de Trabalho Doméstico");
    endif
    if (skills.alquimista >= MIN_SKILL)
        types.append("Receita Alquimica");
        types.append("Tinta");
    endif
    if (skills.mago >= MIN_SKILL)
        types.append("Magia");
    endif

    // Parâmetro isRapid em place para futuras diferenças entre
    // pesquisa rápida e extensiva. No momento retornam-se os mesmos tipos.

    return types;
endfunction

// GetAvailableRapidResearchTypes foi removida: use GetAvailableResearchTypes(skills, isRapid := 1)

function GetMaxPowerForCrafting(skills)
    var maxSkill := Max(skills.ferreiro, Max(skills.costureiro, skills.carpenter));
    return GetMaxPowerForSkill(maxSkill);
endfunction

function GetMaxPowerForSkill(skill, kind := "default")
    var thresholds := SKILL_THRESHOLDS[kind];
    if (!thresholds)
        return 0;
    endif

    for i := 1 to thresholds.size()
        if (skill >= thresholds[i])
            // thresholds[1] corresponde ao nível 5, thresholds[5] ao nível 1
            return (6 - i);
        endif
    endfor

    // Para magia, o mínimo é 1; para o resto, 0
    return (kind == "magic" ? 1 : 0);
endfunction

function GetMaxPowerForMagic(skill)
    return GetMaxPowerForSkill(skill, "magic");
endfunction

function PerformRapidResearch(who, recipe, byref gump)
    if (!CheckforBooks(who, recipe.power))
        SendSysMessageEx(who, "Você está distante demais de um local de estudo apropriado para este nível de pesquisa.", SSM_FAIL);
        return 0;
    endif

    // Adicionar verificação e consumo de mana aqui
    if (!CheckAndConsumeMana(who, 1, recipe.power))
        return 0; // Retorna se não tiver mana suficiente ou falhar no consumo
    endif

    var my_x := who.x;
    var my_y := who.y;
    var my_facing := who.facing;

    if (!ConsumeSubstance(who.backpack, PERGAMINHO_OBJTYPE, PERGAMINHO_AMOUNT_RAPIDA))
        SendSysMessageEx(who, "Você não tem pergaminhos suficientes para realizar a pesquisa.", SSM_FAIL);
        return 0; 
    endif

    var success := 0;
    var skillname;
    case (recipe.type)
        "Instrução de Metalurgia":
            skillname := METALWORKING;
            recipe.+craftSkillType := "MW";
        "Instrução de Marcenaria":
            skillname := WOODWORKING;
            recipe.+craftSkillType := "WW";
        "Instrução de Trabalho Doméstico":
            // skillname is set but appears unused downstream in PerformRapidResearch;
            // setting to "Tailoring" for consistency with the new system. Bridge
            // to legacy Domestic_Work would happen via EffectiveSkill if read.
            skillname := "Tailoring";
            recipe.+craftSkillType := "DW";
        "Receita Alquimica": skillname := ALCHEMY;
        "Tinta": skillname := ALCHEMY;
        "Magia": 
            skillname := MAGERY;
            var spellId := SelectRandomSpell(recipe.power);
            recipe.spellId := spellId;
        default: skillname := ALCHEMY;  
    endcase

    var powerBonus := 0;
    case (CInt(recipe.power))
        1: powerBonus := 1;
        2: powerBonus := 0.7;
        3: powerBonus := 0.5;
        4: powerBonus := 0.2;
        5: powerBonus := 0;
    endcase

    ResetFailuresIfDifferentResearch(who, recipe);
    
    SetObjProperty(who, "#QuickResearching", 1);
    for i := 1 to 5
        if (!CheckStudyConditions(who, my_x, my_y, my_facing))
            SendSysMessageEx(who, "Condições de estudo não atendidas.", SSM_FAIL);
            break;
        endif
        
        SetObjProperty(who, "#QuickResearching", 1);
        
        PrintTextAbove(who, STUDY_ACTIONS[RandomInt(STUDY_ACTIONS.size()) + 1]);
        PlaySoundEffect(who, 0x24a);

        sleep(5); 

        EraseObjProperty(who, "#QuickResearching");

        if (i == 3) // Na última iteração, faça a verificação de sucesso
            // Calcular chance normalmente usando a função central (CalculateResearchChance)
            var chance := CalculateResearchChance(who, recipe);
            var rollResult := RandomInt(10000);
            var chanceThreshold := CInt(chance * 100);

            if (rollResult <= chanceThreshold)
                success := 1;
                SendSysMessageEx(who, "Pesquisa bem-sucedida!", SSM_INFO);
                EraseObjProperty(who, "#ResearchFailures");
            else
                UpdateFailureCount(who);
            endif
        endif
    endfor

    if (success)
        if (who.gender == 1) 
            PlaySoundEffect(who, 0x30c);
        else
            PlaySoundEffect(who, 0x41b); 
        endif
        return FinishQuickResearch(who, recipe); 
    else
        return 0;  
    endif
endfunction

function CustomFormatRealToString(value, decimal_places := 2)
    var integer_part := Floor(value);
    var fractional_part := value - integer_part;
    var fractional_string := "";

    if (fractional_part > 0)
        fractional_string := "." + CStr(Floor(fractional_part * CDbl(10^decimal_places)));
        while (len(fractional_string) <= decimal_places)
            fractional_string := fractional_string + "0";
        endwhile
    endif

    return CStr(integer_part) + fractional_string;
endfunction


function CheckStudyConditions(who, my_x, my_y, my_facing)
    if (who.hidden || who.x != my_x || who.y != my_y || who.facing != my_facing || GetEquipmentByLayer(who, LAYER_MOUNT))
        SendSysMessageEx(who, "Você interrompeu sua pesquisa.", SSM_FAIL);
        return 0;
    endif
    
    // Manter essa verificação pois é específica para o estudo contínuo
if (AP_GetVital(who, "Mana") < 3)
    SendSysMessageEx(who, "Você está muito cansado para continuar.", SSM_FAIL);
    return 0;
endif
    return 1;
endfunction



function CalculateProgress(recipe)
    if (!recipe || !recipe.start)
        return 0;
    endif

    var current_timestamp := ReadGameClock();
    var segundosPassados := Max(0, current_timestamp - recipe.start);
    
    var duracaoTotal := recipe.duration ? recipe.duration : (GetResearchDuration(recipe.power) * 60);
    
    var progresso := Min((CDbl(segundosPassados) / duracaoTotal) * 100, 100);
    
    return progresso;
endfunction

function CalculateRemainingTime(recipe)
    var current_timestamp := ReadGameClock();
    var segundosPassados := Max(0, current_timestamp - recipe.start);
    var segundosTotal := recipe.duration ? recipe.duration : (GetResearchDuration(recipe.power) * 60);
    var segundosRestantes := Max(0, segundosTotal - segundosPassados);
    var progresso := (CDbl(segundosPassados) / segundosTotal) * 100;
    
    var horasRestantes := CInt(segundosRestantes / 3600);
    var minutosRestantes := CInt((segundosRestantes % 3600) / 60);
    var segundosRestantesFinal := segundosRestantes % 60;

    return struct{
        "horas" := horasRestantes,
        "minutos" := minutosRestantes,
        "segundos" := segundosRestantesFinal,
        "progresso" := progresso
    };
endfunction

function FormatResearchTime(totalSeconds)
    var hours := Floor(totalSeconds / 3600);
    var minutes := Floor((totalSeconds % 3600) / 60);
    var seconds := totalSeconds % 60;
    
    var parts := array{};
    
    if (hours > 0)
        parts.append(hours + " hora" + (hours != 1 ? "s" : ""));
    endif
    
    if (minutes > 0)
        parts.append(minutes + " minuto" + (minutes != 1 ? "s" : ""));
    endif
    
    if (seconds > 0 || parts.size() == 0)
        parts.append(seconds + " segundo" + (seconds != 1 ? "s" : ""));
    endif
    
    // Juntar com espaços
    var result := "";
    for i := 1 to parts.size()
        result += parts[i];
        if (i < parts.size())
            result += " ";
        endif
    endfor
    
    return result;
endfunction

function CompleteResearch(who, recipe, byref gump)
    // ============================================
    // FINALIZA A PESQUISA E CRIA O ITEM RESULTANTE
    // ============================================
    // Cria o item de pesquisa no inventário do jogador baseado no tipo
    // e nível da pesquisa completada, configura suas propriedades específicas
    // e fornece feedback sonoro e visual sobre o sucesso.
    // ============================================  
    if (!who || who == error || TypeOf(who) != "MobileRef")
        return;
    endif

    var itemID := DetermineResearchItem(recipe);
    if (itemID == 0)
        SendSysMessageEx(who, "Erro ao determinar o item da pesquisa. Contate um GM.", SSM_FAIL);
        return 0;
    endif

    // CreateItemInBackpack fires the CreateScript which assigns the recipe via scrollRecipes.inc
    var item := CreateItemInBackpack(who, itemID, 1);
    if (item)
        if (recipe.type == "Magia")
            if (!recipe.spellId)
                SendSysMessageEx(who, "Erro ao definir a magia. Contate um GM.", SSM_FAIL);
                DestroyItem(item);
                return 0;
            endif
            SetObjProperty(item, "SpellId", recipe.spellId);
            SendSysMessageEx(who, "Você criou um novo pergaminho de magia!", SSM_INFO);
        else
            SendSysMessageEx(who, "Você concluiu sua pesquisa com sucesso!", SSM_INFO);
        endif

        if (who.gender == 1)
            PlaySoundEffect(who, 0x30c); 
        else
            PlaySoundEffect(who, 0x41b); 
        endif

        NotifyResearchCompletion(who, recipe);
        EraseObjProperty(who, "aprenderrecipe");
        return 1;
    else
        SendSysMessageEx(who, "Erro ao criar o item da pesquisa: " + item.errortext, SSM_FAIL);
        return 0;
    endif
endfunction


function CheckAndConsumeMana(who, isQuickResearch := 0, power := 0)
    // Define o requisito de mana baseado no power
    var requiredMana := GetManaRequirement(power);

    var currentMana := AP_GetVital(who, "Mana");
    var maxMana := AP_GetVitalMaximumValue(who, "Mana");
    
    // Para pesquisa rápida, precisa estar com a mana cheia
    if (isQuickResearch)
        if (currentMana < requiredMana)
            SendSysMessageEx(who, "Você precisa ter no mínimo " + requiredMana + " de mana para esta pesquisa.", SSM_FAIL);
            return 0;
        endif
        
        // Consome a mana baseada no power
        return AP_ConsumeVital(who, "Mana", requiredMana);
    else
        // Para pesquisa extensiva
        if (currentMana < requiredMana)
            SendSysMessageEx(who, "Você precisa ter no mínimo " + requiredMana + " de mana para esta pesquisa.", SSM_FAIL);
            return 0;
        endif
        return AP_ConsumeVital(who, "Mana", requiredMana);
    endif
endfunction




function CalculateResearchChance(who, recipe)
    var baseInt := AP_GetTrueStat(who, "Intelligence");
    
    var intBonus := 0.0;
    if (baseInt > 40)
        intBonus := Min(10.0, ((baseInt - 40) * 10.0) / 100.0);
    endif
    
    // Corrigindo a sintaxe do case
    var levelBonus := 0.0;
    case (CInt(recipe.power))
        1: levelBonus := 10.0;
        2: levelBonus := 8.0;
        3: levelBonus := 6.0;
        4: levelBonus := 4.0;
        default: levelBonus := 2.0;
    endcase


    var failureAttempts := CInt(GetObjProperty(who, "#ResearchFailures")) ? CInt(GetObjProperty(who, "#ResearchFailures")) : 0;
    var maxFailureBonus := 30.0 - (4.0 + intBonus + levelBonus);
    var failureBonus := Min(failureAttempts, Floor(maxFailureBonus));

    var totalChance := 5.0 + intBonus + levelBonus + failureBonus;
    
    return totalChance;
endfunction

function UpdateFailureCount(who)
    var currentFailures := CInt(GetObjProperty(who, "#ResearchFailures")) ? CInt(GetObjProperty(who, "#ResearchFailures")) : 0;
    SetObjProperty(who, "#ResearchFailures", currentFailures + 1);
    SendSysMessageEx(who, "Você não encontrou a resposta que buscava, mas entendeu um pouco mais da lógica da sua pesquisa", SSM_INFO);
endfunction

function ResetFailuresIfDifferentResearch(who, newRecipe)
    var lastRecipe := GetObjProperty(who, "#LastResearchType");
    if (lastRecipe)
        if (lastRecipe.type != newRecipe.type || lastRecipe.power != newRecipe.power)
            EraseObjProperty(who, "#ResearchFailures");
        endif
    endif
    SetObjProperty(who, "#LastResearchType", newRecipe);
endfunction

function CheckIntelligenceForLevel(who, power)
    var minInt := GetIntelligenceRequirement(power);

    var playerInt := AP_GetStat(who, "Intelligence");
    if (playerInt < minInt)
        SendSysMessageEx(who, "Você precisa ter no mínimo " + minInt + " de Inteligência para pesquisa nível " + power + ".", SSM_FAIL);
        return 0;
    endif

    return 1;
endfunction

function GetMaxPowerForInk(skill)
    return GetMaxPowerForSkill(skill, "default");
endfunction