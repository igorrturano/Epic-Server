include ":message:model/Message";

program Sender(params)
	print("Starting Sender...");
	var who := params.who;
	var message := params.message;
	var translate := params.translate;
	var msg_type := params.msg_type;

	message.SetAsync(false); // Desativa o async pra conseguir enviar aqui
	if (msg_type == MSG_TYPE::SYSMSG) message.SendSys(who);
	elseif (msg_type == MSG_TYPE::SYSMSGALL) message.SendSysAll();
	elseif (msg_type == MSG_TYPE::PRINTTEXT) message.SendAbove(who);
	elseif (msg_type == MSG_TYPE::PRINTTEXTPRIVATE) message.SendAbovePrivate(who);
	endif

	return message;
endprogram