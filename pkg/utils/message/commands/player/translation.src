include ":gumpDesigner:Gump/Gump";
include ":gumpDesigner:Control/Button";
include ":gumpDesigner:Control/Text";
include ":gumpDesigner:Control/Container/ContainerGridLayout";

program cmd_translation(who)
	// TODO: Gump para escolher a lingua que fala
		// Também escolher se quer as falas traduzidas ou legendas
	
	var cont := true;
	while(cont)
		var gump := Gump(who, "Translation Settings", 300, 200);
		var label := Text("Text1", 0, 0, "Setting");
		var label2 := Text("Text2", 0, 0, "Ativar Legenda");
		var label3 := Text("Text3", 0, 0, "Ativar Dublagem");
		var label4 := Text("Text4", 0, 0, "Desativar Tradução");

		var button2 := Button("Legenda", 0, 3);
		var button3 := Button("Dublagem", 0, 3);
		var button4 := Button("Tradução", 0, 3);

		var container := ContainerGridLayout("Container1", 30, 80, 100, 100, 4, 2);
		container.SetVisible(true);
		container.AddControl(label, 1, 2);
		container.AddControl(label2, 2, 2);
		container.AddControl(label3, 3, 2);
		container.AddControl(label4, 4, 2);
		container.AddControl(button2, 2, 1);
		container.AddControl(button3, 3, 1);
		container.AddControl(button4, 4, 1);
		gump.AddControl(container);

		var result := gump.Show();
		print(result.GetControl());

		if (result.GetControl() == "CLOSED")
			cont := false;
		elseif (result.GetControl().Equals(button2))
			print("Legenda");
			who.SetProp("translation", 1);
		elseif (result.GetControl().Equals(button3))
			print("Dublagem");
			who.SetProp("translation", 2);
		elseif (result.GetControl().Equals(button4))
			print("Tradução Desativada");
			who.SetProp("translation", 0);
		endif
	endwhile
endprogram