include ":gumpDesigner:gumps/Gump";
include ":gumpDesigner:controls/Button";
include ":gumpDesigner:controls/Text";
include ":gumpDesigner:controls/containers/ContainerGridLayout";
include ":message:model/Message";
include ":wrappers:Objects/Model/MobileWrapper";

program cmd_translation(who)
	// TODO: Gump para escolher a lingua que fala
	who := MobileWrapper(who);
	
	var cont := true;
	while (cont)
		var gump := Gump(who.GetObjRef(), "Translation Settings", 300, 200);
		var label := Text("Text1", 0, 0, "Setting");
		var label2 := Text("Text2", 0, 0, "Ativar Legenda");
		var label3 := Text("Text3", 0, 0, "Ativar Dublagem");
		var label4 := Text("Text4", 0, 0, "Desativar Tradução");

		var button2 := Button("Legenda", 0, 3);
		var button3 := Button("Dublagem", 0, 3);
		var button4 := Button("Desativado", 0, 3);

		var container := ContainerGridLayout("Container1", 30, 80, 100, 100, 4, 2)
			.AddControl(label, 1, 2)
			.AddControl(label2, 2, 2)
			.AddControl(label3, 3, 2)
			.AddControl(label4, 4, 2)
			.AddControl(button2, 2, 1)
			.AddControl(button3, 3, 1)
			.AddControl(button4, 4, 1);
		
		gump.AddControl(container);

		var result := gump.Show();

		if (result.GetControl() is @NoEventHandledException)
			cont := false;
		elseif (result.GetControl().Equals(button2))
			who.SetProperty("translation", 1);
			Message("Tradução: Legenda Ativada.").SendSys(who.GetObjRef());
		elseif (result.GetControl().Equals(button3))
			who.SetProperty("translation", 2);
			Message("Tradução: Dublagem Ativada.").SendSys(who.GetObjRef());
		elseif (result.GetControl().Equals(button4))
			who.SetProperty("translation", 0);
			Message("Tradução: Desativada.").SendSys(who.GetObjRef());
		endif
	endwhile
endprogram