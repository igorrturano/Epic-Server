/*
 * isMage(who)
 * Checks if NPC is a mage (has SpellSchool)
 * O(1) via cache lookup + runtime property check
 */
exported function isMage(who)
	// First check if it's a shaman - if so, definitely not a mage
	if (who.isShaman())
		return 0;
	endif

	var cache := NPC_GetCachedData(who);

	// Check cached config SpellSchool
	if (cache.abilities.hasMageConfig)
		return 1;
	endif

	// Check runtime property (for dynamically assigned schools)
	if (GetObjProperty(who, "SpellSchool"))
		return 1;
	endif

	return 0;
endfunction

