/*
 * getTameDifficulty(who)
 * Returns tame difficulty for animal NPCs
 * O(1) via cache lookup for brain type
 */
exported function getTameDifficulty(who)
	var cache := NPC_GetCachedData(who);
	if (!cache.abilities.isAnimalBrain)
		return error;
	endif
	var diff := CInt(AP_GetSkill(who, WRESTLING));

    // ajuste para montarias
    if (IsMountable(who))
        if (diff < 45)
            diff := 45;
        endif
    endif
	return Cint(AP_GetSkill(who, WRESTLING));
endfunction

