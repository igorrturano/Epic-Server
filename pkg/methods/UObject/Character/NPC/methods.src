/*
ABILITY REGISTRY
To add a new ability:
1. Create the Can* function in methods.src
2. Add the ability to GetAvailableCustomAbilities() in epicBoss.inc
3. Add appropriate properties to the ability dictionary
4. Add the ability to BuildAbilitiesCache() in npcDataCache.inc

Current Abilities:
- CanAmbush
- CanCharm
- CanClimbWall
- CanDoWebWrap
- CanLayEggSac
- CanPoisonBite
- CanShootWeb
- CanTongueGrab
- canBite
- canCharge
- canDoConfusion
- canPetrify
- canSpitAcid
- canThrow
- hasHiveMind
- hasRage
- hasTunnelTactics
- isDoppelganger
Remember to maintain alphabetical order in both the comment block and the dictionary.

PERFORMANCE NOTE:
All ability checks use O(1) cache lookups via NPC_GetCachedData().
Cache is built ONCE at spawn time. See npcDataCache.inc for details.
*/
use uo;
include ":tn:cooldown";
include "include/epicConstants";
include "include/client";
include ":charactercreation:habilidades";
include ":epicAI:npcDataCache";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":mounts:mounts";

program Install()
	print("INSTALLING: Methods for NPC... OK!");
	return 1;
endprogram

/*
 * GetParsedTemplate(npc)
 * Returns the template name (case-preserved)
 * O(1) via cache lookup
 */
exported function GetParsedTemplate(npc)
	var cache := NPC_GetCachedData(npc);
	return cache.template;
endfunction

/*
 * GetEnvironment(npc)
 * Returns the NPC environment from config
 * O(1) via cache lookup
 */
exported function GetEnvironment(npc)
	var cache := NPC_GetCachedData(npc);
	return cache.environment;
endfunction

/*
 * HasCustomAbility(who, method_name)
 * Checks if NPC has a custom ability via CustomAbilities property
 * Used as fallback for boss/special NPCs
 */
exported function HasCustomAbility(who, method_name)
	var custom_abilities := GetObjProperty(who, "CustomAbilities");
	if (!custom_abilities)
		return 0;
	endif

	foreach ability in custom_abilities
		if (ability.method == method_name)
			return 1;
		endif
	endforeach

	return 0;
endfunction

/*
 * canCharge(who)
 * Checks if NPC can perform a charge attack
 * O(1) via cache lookup + cooldown check
 */
exported function canCharge(who)
	// Don't allow charge if already charging
	if (GetObjProperty(who, "#chargestart"))
		return 0;
	endif

	// Don't allow charge if NPC is on cooldown
	if (GetCooldown(who, "charge"))
		return 0;
	endif

	return HasCachedAbility(who, "canCharge");
endfunction

