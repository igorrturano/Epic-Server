function TriggerChairFall(x, y, z, realm)
	foreach mobile in ListMobilesNearLocation(x, y, z, 1, realm)
		if (IsSittingAt(mobile, x, y, z))
			PrintTextAbove(mobile, "*Cai da cadeira*");
			Start_Script(":commands:player/deitar", mobile);
		endif
	endforeach
endfunction

function IsSittingAt(mobile, x, y, z)
	if (mobile.npctemplate || !mobile.connected)
		return 0;
	endif
	if (mobile.x != x || mobile.y != y)
		return 0;
	endif
	var dz := mobile.z - z;
	if (dz < 0) dz := -dz; endif
	return dz <= 1;
endfunction
