use uo;
use os;
use npc;
use util;
use guilds;

include ":attributes:attributes";
include "include/sysEvent";
include ":tn:cooldown";
include ":faccao:faccao";
include ":faccao:membership";
include ":combat:Controller/DamageController_legacy";
include ":faccao:npc_laws_enforce";

set_script_option(SCRIPTOPT_CAN_ACCESS_OFFLINE_MOBILES, 1);

var me           := self();
var guild        := 0;
var following    := 0;
var fighting     := 0;
var fix_location := 0;
var wait_time    := 10;

// Estado interno: IDLE (0), TRACKING (1), COMBAT (3)
var state       := 0;
var track_target := 0;

const FOLLOW_CMD := 0xA001;
const ATTACK_CMD := 0xA002;
const GO_LOC_CMD := 0xA008;
const HELP_CMD   := 0x78458;

const AMBUSH_RANGE  := 1;   // tiles para disparar emboscada (melee)
const DETECT_RANGE  := 8;   // tiles para comecar a rastrear
const CLEAR_RANGE   := 20;  // tiles para considerar area limpa e voltar as sombras

// ============================================================
// INICIALIZACAO
// ============================================================

function Setup()
	var guildid := GetObjProperty(me, "guild");
	if (guildid)
		guild := FindGuild(guildid);
		if (!guild)
			ApplyRawDamage(me, 600);
			return;
		endif
	else
		sleep(5);
		Setup();
		return;
	endif

	guild_leader := guild.getProp("leader");
	guild_laws   := guild.getProp("laws");
	if (!guild_laws) guild_laws := array{}; endif

	fix_location := GetObjProperty(me, "fix_loc");
	if (fix_location == error) fix_location := 0; endif

	if (!me.backpack)
		var new_pack := CreateItemAtLocation(me.x, me.y, me.z, "backpack", 1);
		EquipItem(me, new_pack);
	endif

	me.cmdlevel := 2;
	GrantPrivilege(me, "hiddenattack");
	me.enable("hiddenattack");
	GrantPrivilege(me, "runwhilestealth");
	me.enable("runwhilestealth");
	// NPC sempre nasce visivel; shadow_mode prop controla quando vai para as sombras
	if (GetObjProperty(me, "shadow_mode"))
		me.stealthsteps := 9999;
		me.hidden := 1;
	endif
endfunction

// ============================================================
// AUXILIARES
// ============================================================

function IsValidTarget(who)
	if (who.hidden) return 0; endif
	return IsValidCombatTarget(who);
endfunction

function GetHPPercent()
	if (me.maxhits <= 0) return 100; endif
	return CInt((me.hits * 100) / me.maxhits);
endfunction

function GetNearTarget()
	foreach mob in ListMobilesNearLocationEx(me.x, me.y, me.z, DETECT_RANGE,
		LISTEX_FLAG_NORMAL, me.realm)
		sleepms(2);
		if (IsValidTarget(mob)) return mob; endif
	endforeach
	return 0;
endfunction

function SneakAttack(targ)
	// Primeiro golpe garantido e critico enquanto ainda oculto (hiddenattack ativo)
	SetObjProperty(me, "#GuaranteedHit", 1);
	SetObjProperty(me, "#nextcritical", 1);
	me.stealthsteps := 9999;
	me.frozen   := 0;
	stand_fight := 1;
	SetOpponent(targ);
	SetWarMode(1);
	// NPC permanece oculto — CombatTick revela apos o primeiro golpe
endfunction

// Volta para as sombras quando a area limpa (chamado so quando nao ha mais alvos em 20 tiles)
function ReturnToShadow()
	if (guild) AddReport(guild, "{} voltou as sombras".format(me.name)); endif
	stand_fight  := 0;
	fighting     := 0;
	track_target := 0;
	SetOpponent(0);
	SetWarMode(0);
	state := 0;
	if (GetObjProperty(me, "shadow_mode"))
		me.stealthsteps := 9999;
		me.hidden := 1;
	endif
endfunction

// Busca alvo em raio maior (usado pos-combate)
function GetTargetInRange(range)
	foreach mob in ListMobilesNearLocationEx(me.x, me.y, me.z, range, LISTEX_FLAG_NORMAL, me.realm)
		sleepms(2);
		if (IsValidTarget(mob)) return mob; endif
	endforeach
	return 0;
endfunction

function CombatTick()
	// Revelar no primeiro tick de combate (apos o primeiro golpe invisivel)
	if (me.hidden)
		me.stealthsteps := 0;
		me.hidden := 0;
		PrintTextAbove(me, "*sai das sombras*");
	endif

	// Alvo invalido, morto, invisivel ou oculto
	var _targ_gone := (!fighting || !fighting.isA(POLCLASS_MOBILE) || fighting.dead || fighting.hidden || fighting.concealed);
	if (_targ_gone)
		SetOpponent(0);
		SetWarMode(0);
		var _next := GetTargetInRange(13);
		if (_next)
			fighting := _next;
			SetOpponent(_next);
			SetWarMode(1);
			return;
		endif
		ReturnToShadow();
		return;
	endif

	// Verificar distancia e linha de visao
	var dist := Distance(me, fighting);
	if (dist > 13 || !CheckLineOfSight(me, fighting))
		var _next2 := GetTargetInRange(13);
		if (_next2)
			fighting := _next2;
			SetOpponent(_next2);
			SetWarMode(1);
			return;
		endif
		ReturnToShadow();
		return;
	endif

	// Perseguir alvo
	if (dist > 1)
		RunTowardLocation(fighting.x, fighting.y);
	endif

	wait_time := 0;
endfunction

// ============================================================
// LOOP PRINCIPAL
// ============================================================

program AssassinoSinodoMain()
	EnableEvents(SYSEVENT_ENTEREDAREA, 6);
	EnableEvents(SYSEVENT_ENGAGED);
	EnableEvents(SYSEVENT_DAMAGED);
	EnableEvents(SYSEVENT_DOUBLECLICKED, 5);
	EnableEvents(SYSEVENT_SPEECH, 8);
	EnableEvents(PICKPOCKET_EVENT);
	EnableEvents(REVELADO_EVENT);
	EnableEvents(LOCKPICK_EVENT);
	EnableEvents(CERCA_EVENT);
	EnableEvents(RESET_SETUP_EVENT);

	Setup();
	sleep(1);

	while (me)

		// Re-leitura do guild se necessario
		if (!guild)
			var _gid := GetObjProperty(me, "guild");
			if (_gid)
				guild        := FindGuild(_gid);
				guild_leader := guild ? guild.getProp("leader") : 0;
				guild_laws   := guild ? guild.getProp("laws")   : array{};
				if (!guild_laws) guild_laws := array{}; endif
			endif
		endif

		// Controle de territorio (hunt_mode ignora limites)
		if (guild && !GetObjProperty(me, "hunt_mode"))
			if (GetObjProperty(me, "tipo_faccao") == "staff")
				HandleWalkRectBreach(me, wait_time);
			elseif (!inGuildRect(guild, me, 4))
				// Retornar ao territorio sem interromper estado de combate
				if (state != 3)
					var _center := GetGuildCenter(guild, me.z);
					if (_center)
						me.stealthsteps := 9999;
						RunTowardLocation(_center.x, _center.y);
						wait_time := 0;
					endif
					state := 0;
					track_target := 0;
					fighting := 0;
					SetOpponent(0);
					SetWarMode(0);
				endif
			endif
		endif

		var _shadow := GetObjProperty(me, "shadow_mode");
		case (state)

			0: // IDLE
				if (_shadow)
					me.stealthsteps := 9999;
					if (!me.hidden && !stand_fight) me.hidden := 1; endif
				endif

				// Seguir target designado
				if (following)
					if (following.isA(POLCLASS_MOBILE) && !following.dead)
						WalkTowardLocation(following.x, following.y);
						wait_time := 0;
					else
						following := 0;
					endif
				endif

				// Patrulhar entre dois pontos
				var _patrol := GetObjProperty(me, "patrolling");
				if (!following && _patrol && _patrol.size() >= 2)
					var _pidx := GetObjProperty(me, "#patrol_idx");
					if (_pidx == error || !_pidx) _pidx := 1; endif
					var _ppt := _patrol[_pidx];
					if (CoordinateDistance(me.x, me.y, _ppt.x, _ppt.y) <= 1)
						_pidx := (_pidx % 2) + 1;
						SetObjProperty(me, "#patrol_idx", _pidx);
					else
						WalkTowardLocation(_ppt.x, _ppt.y);
						wait_time := 0;
					endif
				elseif (!following && fix_location)
					var dist_posto := CoordinateDistance(me.x, me.y, fix_location.x, fix_location.y);
					if (dist_posto > 1)
						WalkTowardLocation(fix_location.x, fix_location.y);
						wait_time := 0;
					else
						me.facing := fix_location.facing;
					endif
				endif

				// Verificar leis para players proximos
				if (!warning && !GetCooldown(me, "lawscan_cd"))
					foreach _mob in ListMobilesNearLocationEx(me.x, me.y, me.z, 6,
							LISTEX_FLAG_NORMAL, me.realm)
						sleepms(2);
						if (!_mob.npctemplate) CheckPlayerLaws(_mob); endif
						if (warning) break; endif
					endforeach
					SetCooldown(me, "lawscan_cd", 3);
				endif

				// Vaguear: hunt_mode = cidade toda; shadow_mode normal = so territorio
				if (!following && !fix_location && !GetObjProperty(me, "patrolling") &&
						!GetCooldown(me, "wander_cd"))
					var _in_hunt := GetObjProperty(me, "hunt_mode");
					if (_in_hunt)
						// Wander livre — ignora limites do territorio
						me.stealthsteps := 9999;
						me.hidden := 1;
						var _wx := me.x + RandomInt(21) - 10;
						var _wy := me.y + RandomInt(21) - 10;
						WalkTowardLocation(_wx, _wy);
						SetCooldown(me, "wander_cd", RandomInt(6) + 3);
						wait_time := 0;
					elseif (_shadow)
						var _wp := GetRandomWanderPoint();
						if (_wp)
							me.stealthsteps := 9999;
							WalkTowardLocation(_wp.x, _wp.y);
							SetCooldown(me, "wander_cd", RandomInt(8) + 4);
							wait_time := 0;
						endif
					endif
				endif

				// Detectar alvo
				if (!GetCooldown(me, "detect_cd"))
					var targ := GetNearTarget();
					if (targ)
						track_target := targ;
						state := 1;
						wait_time := 0;
					else
						// Area limpa — voltar as sombras imediatamente se estiver exposto
						if (!me.hidden && _shadow && stand_fight == 0)
							me.stealthsteps := 9999;
							me.hidden := 1;
						endif
					endif
					SetCooldown(me, "detect_cd", 2);
				endif

				CheckRevealTimeout();
				break;  // fim case 0

			1: // TRACKING — seguir alvo
				if (!IsValidTarget(track_target))
					track_target := 0;
					state := 0;
					break;
				endif

				if (_shadow)
					me.stealthsteps := 9999;
					if (!me.hidden) me.hidden := 1; endif
				endif

				var dist_track := Distance(me, track_target);

				if (dist_track > DETECT_RANGE + 2)
					track_target := 0;
					fighting     := 0;  // limpar fighting orfao se houver
					state        := 0;
				elseif (dist_track <= AMBUSH_RANGE)
					SneakAttack(track_target);
					fighting     := track_target;
					track_target := 0;
					state        := 3;
					if (guild) AddReport(guild, "{} emboscou {}".format(me.name, fighting ? fighting.name : "?")); endif
					wait_time := 0;
				else
					if (_shadow)
						WalkTowardLocation(track_target.x, track_target.y);
					else
						RunTowardLocation(track_target.x, track_target.y);
					endif
					wait_time := 0;
				endif
				break;  // fim case 1

			3: // COMBAT
				CombatTick();
				break;

		endcase

		// Processar aviso de violacao de lei
		if (guild && warning) WarnViolator(); endif

		var ev := Wait_For_Event(wait_time);
		wait_time := 3;

		HandleLawEvent(ev);

		case (ev.type)
			SYSEVENT_DOUBLECLICKED:
				ShowFaccaoCombatGump(ev);
				if (fighting) state := 3; endif
				if (!fighting) state := 0; track_target := 0; endif
				break;

			SYSEVENT_ENGAGED:
				if (!ev.source.dead && !ev.source.concealed)
					if (IsValidTarget(ev.source) && state != 3)
						fighting := ev.source;
						state    := 3;
						SetOpponent(fighting);
						SetWarMode(1);
					endif
				endif
				break;

			SYSEVENT_DAMAGED:
				if (ev.source && !ev.source.hidden && IsValidTarget(ev.source))
					if (state == 0 || state == 1)
						// Revelado: engajar imediatamente, sem voltar as sombras ate area limpa
						fighting := ev.source;
						state    := 3;
						stand_fight := 1;
						me.hidden := 0;
						SetOpponent(fighting);
						SetWarMode(1);
					endif
				endif
				// Sinodo nao foge por HP — aguenta o combate ate a area estar limpa
				break;

			SYSEVENT_ENTEREDAREA:
				if (state == 0 && IsValidTarget(ev.source))
					track_target := ev.source;
					state := 1;
					wait_time := 0;
				endif
				if (me.hidden && ev.source.connected && !ev.source.dead)
					CheckAwarenessDetection(ev.source);
				endif
				break;

			FOLLOW_CMD:
				fighting     := 0;
				track_target := 0;
				state        := 0;
				following    := ev.targ;
				SetOpponent(0);
				SetWarMode(0);
				fix_location := 0;
				EraseObjProperty(me, "fix_loc");
				break;

			ATTACK_CMD:
				if (ev.targ && IsValidTarget(ev.targ))
					track_target := ev.targ;
					state := 1;
					wait_time := 0;
				endif
				break;

			HELP_CMD:
				if (!fighting && ev.targ && IsValidTarget(ev.targ))
					track_target := ev.targ;
					state := 1;
					wait_time := 0;
				endif
				break;

			SYSEVENT_SPEECH:
				HandleRevealSpeech(ev);
				break;

			default:
				wait_time := 5;
		endcase

		sleepms(10);
	endwhile
endprogram
