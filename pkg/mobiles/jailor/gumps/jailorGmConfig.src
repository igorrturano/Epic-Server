// jailorGmConfig — GM-only gump to set this Jailor's served faccao.
// Mirrors :merchants:citizen/gumps/citizenGmConfig layout. Uses radio
// buttons since a Jailor serves exactly one faccao.

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":faccao:include/faccao";
include ":jailor:include/jailor";

program jailorGmConfig(params)
	var npc := params[1];
	var player := params[2];

	if (!npc || !player)
		return;
	endif

	var current := GetJailorFaccao(npc);

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 360, 280);
	GFResizePic(gump, 15, 15, 9350, 330, 250);
	GFTextMid(gump, 15, 25, 330, 53, "Configurar Jailor");
	GFTextLine(gump, 30, 50, 1153, "Faccao servida por este Jailor:");

	var y := 80;
	var idx := 1;
	foreach name in (FACCAO_NOMES)
		var checked := 0;
		if (idx == current)
			checked := 1;
		endif
		GFRadioButton(gump, 30, y, 2361, 2362, checked, idx);
		GFTextLine(gump, 60, y, 1153, name);
		y := y + 25;
		idx := idx + 1;
		sleepms(2);
	endforeach

	GFAddButton(gump, 60, 240, 2130, 2129, GF_CLOSE_BTN, 1);
	GFAddButton(gump, 220, 240, 2119, 2120, GF_CLOSE_BTN, 0);

	var input := GFSendGump(player, gump);
	if (!input || input[0] != 1)
		return;
	endif

	var selected := 0;
	var i := 1;
	while (i <= FACCAO_NOMES.size())
		if (input[i])
			selected := i;
			break;
		endif
		i := i + 1;
	endwhile

	if (!selected)
		SendSysMessage(player, "Nenhuma faccao selecionada.");
		return;
	endif

	SetJailorFaccao(npc, selected);
	SendSysMessage(player, "Jailor agora serve: " + FACCAO_NOMES[selected]);
endprogram
