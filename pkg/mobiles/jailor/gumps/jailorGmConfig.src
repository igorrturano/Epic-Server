// jailorGmConfig — GM-only gump to set which faccoes this Jailor serves.
// Literal port of :merchants:citizen/gumps/citizenGmConfig — same checkbox
// layout, same pic ids, same submit handling.

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":faccao:include/faccao";
include ":jailor:include/jailorStore";

program jailorGmConfig(params)
	var npc := params[1];
	var player := params[2];

	if (!npc || !player)
		return;
	endif

	var current := GetJailorFactions(npc);

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 360, 280);
	GFResizePic(gump, 15, 15, 9350, 330, 250);
	GFTextMid(gump, 15, 25, 330, 53, "Configurar Jailor");
	GFTextLine(gump, 30, 50, 1153, "Faccoes que este Jailor serve:");

	var y := 80;
	var idx := 1;
	foreach name in (FACCAO_NOMES)
		var checked := 0;
		if (idx in current)
			checked := 1;
		endif
		GFCheckBox(gump, 30, y, 2361, 2362, checked, idx);
		GFTextLine(gump, 60, y, 1153, name);
		y := y + 25;
		idx := idx + 1;
		sleepms(2);
	endforeach

	GFAddButton(gump, 60, 240, 2130, 2129, GF_CLOSE_BTN, 1);
	GFAddButton(gump, 220, 240, 2119, 2120, GF_CLOSE_BTN, 0);

	var input := GFSendGump(player, gump);
	if (!input || input[0] != 1)
		return;
	endif

	var selected := array{};
	var i := 1;
	while (i <= FACCAO_NOMES.size())
		if (input[i])
			selected.append(i);
		endif
		i := i + 1;
	endwhile

	SetJailorFactions(npc, selected);
	SendSysMessage(player, "Jailor configurado com " + selected.size() + " faccao(oes).");
endprogram
