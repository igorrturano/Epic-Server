// jailorPunish — guard-only gump that picks the crime severity and targets
// the offender. Mirrors the citizen GmConfig layout — same pic ids, checkbox
// rows, OK/Cancel pair. Single-select enforced server-side (first checked
// wins; cancel returns nothing).

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include "include/say";
include ":jailor:include/jailAction";

program jailorPunish(params)
	var jailor := params[1];
	var guard := params[2];

	if (!jailor || !guard)
		return;
	endif

	var severities := array{
		struct{ key := SEVERITY_LEVE,     label := "Leve  -  100 pedras" },
		struct{ key := SEVERITY_MODERADO, label := "Moderado  -  400 pedras" },
		struct{ key := SEVERITY_PESADO,   label := "Pesado  -  1000 pedras" },
		struct{ key := SEVERITY_SUBORNO,  label := "Suborno  -  resolver socialmente" }
	};

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 360, 280);
	GFResizePic(gump, 15, 15, 9350, 330, 250);
	GFTextMid(gump, 15, 25, 330, 53, "Sentenca");
	GFTextLine(gump, 30, 50, 1153, "Selecione a pena:");

	var y := 80;
	var idx := 1;
	foreach entry in (severities)
		GFCheckBox(gump, 30, y, 2361, 2362, 0, idx);
		GFTextLine(gump, 60, y, 1153, entry.label);
		y := y + 25;
		idx := idx + 1;
		sleepms(2);
	endforeach

	GFAddButton(gump, 60, 240, 2130, 2129, GF_CLOSE_BTN, 1);
	GFAddButton(gump, 220, 240, 2119, 2120, GF_CLOSE_BTN, 0);

	var input := GFSendGump(guard, gump);
	if (!input || input[0] != 1)
		return;
	endif

	var selected_idx := 0;
	var i := 1;
	while (i <= severities.size())
		if (input[i])
			selected_idx := i;
			break;
		endif
		i := i + 1;
	endwhile

	if (!selected_idx)
		SendSysMessage(guard, "Selecione uma pena.");
		return;
	endif

	var severity := severities[selected_idx].key;

	SendSysMessageEx(guard, "Mire no alvo da sentenca.", SSM_REQUEST);
	var prisoner := Target(guard);
	if (!prisoner)
		SendSysMessageEx(guard, "Cancelado.", SSM_FAIL);
		return;
	endif

	JailPlayer(jailor, guard, prisoner, severity);
endprogram
