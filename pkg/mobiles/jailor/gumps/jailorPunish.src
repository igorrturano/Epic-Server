// jailorPunish — guard-only gump that picks the crime severity and targets
// the offender. JailPlayer in jailAction.inc handles the rest.

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include "include/say";
include ":jailor:include/jailAction";

const BTN_LEVE      := 1;
const BTN_MODERADO  := 2;
const BTN_PESADO    := 3;
const BTN_SUBORNO   := 4;

program jailorPunish(params)
	var jailor := params[1];
	var guard := params[2];

	if (!jailor || !guard)
		return;
	endif

	var gump := GFCreateGump();
	GFResizePic(gump, 0, 0, 9200, 340, 240);
	GFResizePic(gump, 15, 15, 9350, 310, 210);
	GFTextMid(gump, 15, 25, 310, 53, "Sentenca");
	GFTextLine(gump, 30, 50, 1153, "Qual o nivel do crime?");

	GFAddButton(gump, 30, 80,  2113, 2114, GF_CLOSE_BTN, BTN_LEVE);
	GFTextLine(gump, 60, 80,  1153, "Leve  -  100 pedras");

	GFAddButton(gump, 30, 105, 2113, 2114, GF_CLOSE_BTN, BTN_MODERADO);
	GFTextLine(gump, 60, 105, 1153, "Moderado  -  400 pedras");

	GFAddButton(gump, 30, 130, 2113, 2114, GF_CLOSE_BTN, BTN_PESADO);
	GFTextLine(gump, 60, 130, 1153, "Pesado  -  1000 pedras");

	GFAddButton(gump, 30, 155, 2113, 2114, GF_CLOSE_BTN, BTN_SUBORNO);
	GFTextLine(gump, 60, 155, 1153, "Suborno  -  resolver socialmente");

	GFAddButton(gump, 220, 195, 2119, 2120, GF_CLOSE_BTN, 0);

	var input := GFSendGump(guard, gump);
	if (!input)
		return;
	endif

	var pressed := Cint(input[0]);
	var severity := "";
	case (pressed)
		BTN_LEVE:     severity := SEVERITY_LEVE;
		BTN_MODERADO: severity := SEVERITY_MODERADO;
		BTN_PESADO:   severity := SEVERITY_PESADO;
		BTN_SUBORNO:  severity := SEVERITY_SUBORNO;
		default:      return;
	endcase

	SendSysMessageEx(guard, "Mire no alvo da sentenca.", SSM_REQUEST);
	var prisoner := Target(guard);
	if (!prisoner)
		SendSysMessageEx(guard, "Cancelado.", SSM_FAIL);
		return;
	endif

	JailPlayer(jailor, guard, prisoner, severity);
endprogram
