use npc;

include "include/epicai";
include "include/spellCache";
include "include/stateManager";
include "include/abilityTable";
include "include/monsterBrain";
include "include/animalBrain";
include "include/humanoidBrain";
include "include/epicNPCUtils";
include "include/genericBrain";
include "include/passiveBrain";
include "include/eventID";

var brain_type;
var me := Self();
const AREA_SIZE := 15;

// Script-level vars for ephemeral combat state (replaces per-tick SetObjProperty/GetObjProperty)
var pursuit_tracker := 0;
var los_cache_var := 0;
var path_cache_var := 0;
var runaway_progress_var := 0;
var target_lock_var := 0;
var threat_list_var := array{};
var cached_weapon_range := 0;
var combat_abilities := array{};
var enter_abilities := array{};

/*
 * KillPlayers()
 *
 * Phase 3: Pure Event-Driven Dormancy (No Polling)
 * - NPCs only wake from ENTEREDAREA events, zero CPU when dormant
 * - No HasPlayerNear polling fallback
 * - Script loops between dormant and active states
 */
program KillPlayers()
    Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

    // Initialize NPC once at spawn
    if (!GetObjProperty(me, "started"))
        set_critical(1);
        InitializeEpicNPC(me);
        set_critical(0);
    endif

    // Build spell cache once (lazy init shared across all NPC scripts via script-level vars)
    InitSpellCache();

    EnableMainEvents();

    // Check for players already in range at spawn time
    InitializeEnterArea(me);

    // Main event loop - alternates between dormant and active states
    while (me)
        // ===== DORMANT MODE =====
        // Pure event-driven: only wake on ENTEREDAREA, no polling
        while (me)
            var ev := wait_for_event(120); // 2 min timeout, just keeps script alive

            if (!ev)
                continue; // Timeout - stay dormant, no polling
            endif

            if (ev.type == SYSEVENT_ENTEREDAREA)
                if (ev.source.acctname)
                    // Player entered range - activate brain!
                    break;
                endif
            endif
        endwhile

        // ===== ACTIVE MODE =====
        // Player is nearby, run appropriate brain AI
        DetermineBrainType();
        SetWarMode(0);

        // Send ENTEREDAREA events for nearby players/pets so brain can detect them
        // (Must be called here and before dormant loop, so brain receives the events)
        InitializeEnterArea(me);

        case (brain_type)
            "monster":  MonsterBrain();
            "animal":   AnimalBrain();
            "humanoid": HumanoidBrain();
            "passive":  PassiveBrain();
            default:    GenericBrain();
        endcase

        // Brain returned (ShouldGoDormant triggered) - loop back to dormant
        SetWarMode(0);
        SetOpponent(0);
        // Reset ephemeral combat state
        pursuit_tracker := 0;
        los_cache_var := 0;
        path_cache_var := 0;
        runaway_progress_var := 0;
        target_lock_var := 0;
        threat_list_var := array{};
        cached_weapon_range := 0;
        combat_abilities := array{};
        enter_abilities := array{};
        nearby_cache_var := dictionary;
        enemy_last_loc_var := 0;
        initial_allies_var := 0;
        SM_TransitionTo("IDLE");
    endwhile
endprogram

/*
 * DetermineBrainType()
 *
 * Purpose: Determine which brain AI to run
 * Now uses cached data instead of config lookup
 */
function DetermineBrainType()
    var cache := NPC_GetCachedData(me);
    brain_type := cache.brain_type;
    if (!brain_type)
        brain_type := "generic";
    endif
endfunction