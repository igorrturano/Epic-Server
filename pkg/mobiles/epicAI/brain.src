use npc;

include "include/epicai";
include "include/monsterBrain";
include "include/animalBrain";
include "include/humanoidBrain";
include "include/epicNPCUtils";
include "include/genericBrain";

var brain_type;
var me := Self();
const AREA_SIZE := 18;

program KillPlayers()
    Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

    set_critical(1);
    InitializeEpicNPC(me);
    DetermineBrainType();
    set_critical(0);

    SetWarMode(0);

    case (brain_type)
        "monster":  MonsterBrain();
        "animal":   AnimalBrain();
        "humanoid": HumanoidBrain();
        default:    GenericBrain();
    endcase

endprogram

function DetermineBrainType()
    var npc_config := NPC_GetNPCConfig(me);
    brain_type := lower(npc_config.BrainType);
    if (!brain_type)
        brain_type := "generic";
    endif
endfunction