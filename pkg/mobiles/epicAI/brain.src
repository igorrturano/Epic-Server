use npc;

include "include/epicai";
include "include/monsterBrain";
include "include/animalBrain";
include "include/humanoidBrain";
include "include/epicNPCUtils";
include "include/genericBrain";
include "include/eventID";

var brain_type;
var me := Self();
const AREA_SIZE := 15;

/*
 * KillPlayers()
 *
 * Phase 3: Pure Event-Driven Dormancy (No Polling)
 * - NPCs only wake from ENTEREDAREA events, zero CPU when dormant
 * - No HasPlayerNear polling fallback
 * - Script loops between dormant and active states
 */
program KillPlayers()
    Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

    // Initialize NPC once at spawn
    if (!GetObjProperty(me, "started"))
        set_critical(1);
        InitializeEpicNPC(me);
        set_critical(0);
    endif

    EnableMainEvents();

    // Main event loop - alternates between dormant and active states
    while (me)
        // ===== DORMANT MODE =====
        // Pure event-driven: only wake on ENTEREDAREA, no polling
        while (me)
            var ev := wait_for_event(120); // 2 min timeout, just keeps script alive

            if (!ev)
                continue; // Timeout - stay dormant, no polling
            endif

            if (ev.type == SYSEVENT_ENTEREDAREA)
                if (ev.source.acctname)
                    // Player entered range - activate brain!
                    break;
                endif
            endif
        endwhile

        // ===== ACTIVE MODE =====
        // Player is nearby, run appropriate brain AI
        DetermineBrainType();
        SetWarMode(0);

        // Send ENTEREDAREA events for nearby players/pets so brain can detect them
        // (Must be called here, not before dormant loop, so brain receives the events)
        InitializeEnterArea(me);

        case (brain_type)
            "monster":  MonsterBrain();
            "animal":   AnimalBrain();
            "humanoid": HumanoidBrain();
            default:    GenericBrain();
        endcase

        // Brain returned (ShouldGoDormant triggered) - loop back to dormant
        SetWarMode(0);
        SetOpponent(0);
        // Loop continues to dormant mode automatically
    endwhile
endprogram

/*
 * DetermineBrainType()
 *
 * Purpose: Determine which brain AI to run
 * Now uses cached data instead of config lookup
 */
function DetermineBrainType()
    var cache := NPC_GetCachedData(me);
    brain_type := cache.brain_type;
    if (!brain_type)
        brain_type := "generic";
    endif
endfunction