use npc;

include "include/epicai";
include "include/monsterBrain";
include "include/animalBrain";
include "include/humanoidBrain";
include "include/epicNPCUtils";
include "include/genericBrain";

var brain_type;
var me := Self();
const AREA_SIZE := 18;

program KillPlayers()
    Set_Script_Option(SCRIPTOPT_NO_RUNAWAY, 1);

    // Only initialize if not already done
    var already_started := GetObjProperty(me, "started");
    if (!already_started)
        set_critical(1);
        InitializeEpicNPC(me);
        set_critical(0);
    endif
    
    DetermineBrainType();
    SetWarMode(0);
    
    // Wait for player to come near
    while (!HasPlayerNear(me))
        Sleep(15);
    endwhile

    // Run the appropriate brain (will return when going idle)
    case (brain_type)
        "monster":  MonsterBrain();
        "animal":   AnimalBrain();
        "humanoid": HumanoidBrain();
        default:    GenericBrain();
    endcase
    
    // Brain returned = no players nearby
    // Restart the script (goes back to waiting)
    RestartScript(me);
endprogram

function DetermineBrainType()
    var npc_config := NPC_GetNPCConfig(me);
    brain_type := lower(npc_config.BrainType);
    if (!brain_type)
        brain_type := "generic";
    endif
endfunction