use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include ":combat:Controller/DamageController_legacy";
include ":charactercreation:resists";

program InfernalBurst(params)
	var me := params[1];

	if (!me || me.dead)
		return 0;
	endif

	var tier := CInt(MobileWrapper(me).GetTier());
	var burst_damage := tier * 6;

	PrintTextAbove(me, "*explosão infernal*");
	PlaySoundEffect(me, 0x208);

	var targets := ListMobilesNearLocation(me.x, me.y, me.z, 3, me.realm);
	foreach mobile in (targets)
		sleepms(2);
		if (me.dead)
			break;
		endif
		if (mobile.serial == me.serial || mobile.dead)
			continue;
		endif
		if (mobile.npctemplate && !mobile.master)
			continue;
		endif
		PlayStationaryEffectEx(mobile.x, mobile.y, mobile.z, mobile.realm, 0x3709, 10, 30);

		var final_damage := burst_damage;
		if (CheckResist(mobile, REFLEXES, RESIST_HARD))
			final_damage := CInt(burst_damage / 2);
			SendSysMessageEx(mobile, "Você se esquiva parcialmente da explosão!", SSM_REQUEST);
		endif
		DamageFLS(mobile, final_damage, DMG_FIRE, me, "infernalburst");
	endforeach

	return 1;
endprogram
