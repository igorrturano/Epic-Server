use uo;
use os;

include ":charactercreation:resists";
include ":timedScripts:timedScripts";

program DirtyTrick(params)
	var me := params[1];
	var targ := params[2];

	if (!me || !targ || me.dead || targ.dead)
		return 0;
	endif

	if (Distance(me, targ) > 2)
		return 0;
	endif

	// Don't refresh an already-active blind — prevents multi-goblin lockdown
	if (GetObjProperty(targ, "#blinded"))
		return 0;
	endif

	PrintTextAbove(me, "*joga sujeira*");

	if (!CheckResist(targ, REFLEXES, RESIST_MEDIUM))
		TS_StartTimer(targ, "blinded", 5, 0, me);
		SendSysMessageEx(targ, "Sujeira nos seus olhos! Você não enxerga!", SSM_FAIL);
	else
		SendSysMessageEx(targ, "Você desvia da sujeira!", SSM_REQUEST);
	endif

	return 1;
endprogram
