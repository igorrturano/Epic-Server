use uo;
use os;
use vitals;

include ":wrappers:Objects/Model/MobileWrapper";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":charactercreation:resists";
include ":timedScripts:timedScripts";

program FrostAura(params)
	var me := params[1];

	if (!me || me.dead)
		return 0;
	endif

	var cur_hp := GetVital(me, HITS) / 100;
	var max_hp := GetVitalMaximumValue(me, HITS) / 100;
	if (cur_hp >= CInt(max_hp * 0.6))
		return 0;
	endif

	var tier := CInt(MobileWrapper(me).GetTier());
	var damage := tier * 2;

	PrintTextAbove(me, "*emana frio sobrenatural*");

	var targets := ListMobilesNearLocation(me.x, me.y, me.z, 3, me.realm);
	foreach mobile in (targets)
		sleepms(2);
		if (me.dead)
			break;
		endif
		if (mobile.serial == me.serial || mobile.dead)
			continue;
		endif
		if (mobile.npctemplate && !mobile.master)
			continue;
		endif

		DealDamage(mobile, damage, DAMAGE_TYPE::COLD, me);

		if (!CheckResist(mobile, FORTITUDE, RESIST_MEDIUM))
			TS_StartTimer(mobile, "lentidao", 3);
		endif
	endforeach

	return 1;
endprogram
