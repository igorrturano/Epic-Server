use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":charactercreation:resists";
include ":timedScripts:timedScripts";
include "include/shapes";
include "include/tileEffects";

program FrozenBreath(params)
	var me := params[1];
	var targ := params[2];

	if (!me || !targ || me.dead || targ.dead)
		return 0;
	endif

	var tier := CInt(MobileWrapper(me).GetTier());
	if (!tier) tier := 1; endif
	var damage := tier * 5;

	PrintTextAbove(me, "*sopra um vento gélido*");
	PlayMovingEffect(me, targ, 0xE184, 7, 10, 1);
	PlaySoundEffect(targ, 0x10B);

	var coord_list := GetCoordsInLine(me.x, me.y, targ.x, targ.y);
	foreach coord in coord_list
		if (_coord_iter < 2)
			continue;
		endif
		PlayStationaryEffect(coord.x, coord.y, me.z, FX_BLUE_SPARKLE_GROUND, 3, 4, 0, me.realm);
		sleepms(60);
	endforeach

	if (me.dead)
		return 0;
	endif

	var targets := ListMobilesNearLocation(targ.x, targ.y, targ.z, 2, targ.realm);
	foreach mobile in (targets)
		sleepms(2);
		if (me.dead)
			break;
		endif
		if (mobile.serial == me.serial || mobile.dead)
			continue;
		endif
		if (mobile.npctemplate && !mobile.master)
			continue;
		endif

		if (CheckResist(mobile, WILL, RESIST_HARD) > 0)
			DealDamage(mobile, CInt(damage / 2), DAMAGE_TYPE::COLD, me);
			TS_StartTimer(mobile, "lentidao", tier * 2);
			SendSysMessageEx(mobile, "O frio cala em seus ossos.", SSM_REQUEST);
			PrintTextAbove(mobile, "*lento*");
		else
			DealDamage(mobile, damage, DAMAGE_TYPE::COLD, me);
			TS_StartTimer(mobile, "prisaogelida", 3);
			PlayObjectCenteredEffect(mobile, FX_BLUE_SPARKLE_GROUND, 3, 4);
			SendSysMessageEx(mobile, "O sopro congelante te aprisiona!", SSM_FAIL);
		endif
	endforeach

	return 1;
endprogram
