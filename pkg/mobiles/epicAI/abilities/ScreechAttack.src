use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":timedScripts:timedScripts";
include ":charactercreation:resists";

program ScreechAttack(params)
	var me := params[1];

	if (!me || me.dead)
		return 0;
	endif

	PrintTextAbove(me, "*grito ensurdecedor!*");
	PlaySoundEffect(me, 0x195);

	var targets := ListMobilesNearLocation(me.x, me.y, me.z, 4, me.realm);
	foreach mobile in (targets)
		sleepms(2);
		if (mobile.serial == me.serial || mobile.dead || mobile.npctemplate)
			continue;
		endif

		if (MobileWrapper(mobile).HasAbility(ABILITY_ID::AURA_DIVINA))
			SendSysMessageEx(mobile, "Sua fé protege você!", SSM_REQUEST);
			continue;
		endif

		if (CheckResist(mobile, WILL, RESIST_HARD))
			SendSysMessageEx(mobile, "Você resiste ao grito!", SSM_REQUEST);
			continue;
		endif

		TS_StartTimer(mobile, "paralysis", 5);
		SendSysMessageEx(mobile, "O grito ensurdecedor paralisa você!", SSM_FAIL);
	endforeach

	return 1;
endprogram
