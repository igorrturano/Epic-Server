use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include ":combat:Controller/DamageController_legacy";
include ":charactercreation:resists";
include ":timedScripts:timedScripts";

program HammerSlam(params)
	var me := params[1];

	if (!me || me.dead)
		return 0;
	endif

	var tier := CInt(MobileWrapper(me).GetTier());
	if (!tier) tier := 1; endif
	var damage := tier * 7;

	PrintTextAbove(me, "*esmaga com o martelo!*");
	PlaySoundEffect(me, 0x233);
	PlayObjectCenteredEffect(me, 0x36BD, 5, 15);

	var targets := ListMobilesNearLocation(me.x, me.y, me.z, 4, me.realm);
	foreach mobile in (targets)
		sleepms(2);
		if (me.dead)
			break;
		endif
		if (mobile.serial == me.serial || mobile.dead)
			continue;
		endif
		if (mobile.npctemplate && !mobile.master)
			continue;
		endif

		DamageFLS(mobile, damage, DMG_BLUNT, me, "hammerslam");

		if (!CheckResist(mobile, FORTITUDE, RESIST_HARD))
			TS_StartTimer(mobile, "tombar", 5);
			TS_StartTimer(mobile, "lentidao", 4);
			SendSysMessageEx(mobile, "O impacto do martelo te derruba!", SSM_FAIL);
		else
			SendSysMessageEx(mobile, "Você se mantém em pé contra o impacto.", SSM_REQUEST);
		endif
	endforeach

	return 1;
endprogram
