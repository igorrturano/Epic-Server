use uo;
use os;

program PackTactics(params)
	var me := params[1];
	var targ := params[2];

	if (!me || !targ || me.dead)
		return 0;
	endif

	// Count allies attacking same target within 4 tiles
	var pack_count := 0;
	var allies := ListMobilesNearLocation(me.x, me.y, me.z, 4, me.realm);
	foreach mobile in (allies)
		sleepms(2);
		if (mobile.serial == me.serial || !mobile.npctemplate)
			continue;
		endif
		if (mobile.opponent.serial == targ.serial)
			pack_count += 1;
		endif
	endforeach

	if (pack_count < 1)
		return 0;
	endif

	// Apply pack bonus as hitchance (visible, stacks with pack size)
	var bonus := pack_count * 3;

	// Remove old bonus before applying new
	var old_bonus := GetObjProperty(me, "#pack_bonus");
	if (old_bonus != error)
		me.hitchance_mod := me.hitchance_mod - old_bonus;
	endif

	me.hitchance_mod := me.hitchance_mod + bonus;
	SetObjProperty(me, "#pack_bonus", bonus);

	if (pack_count >= 2)
		PrintTextAbove(me, "*uiva*");
	endif

	return 1;
endprogram
