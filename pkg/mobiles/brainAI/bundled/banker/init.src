use uo;
use os;

include ":brainAI:npcNerves";
include ":brainAI:npcInit";
include ":brainAI:npcCommands";
include ":dyes:dyes";

program BrainCriticalScript(params)
	var npc := params[1];
	// var settings	:= params[2];
	// var scripts	:= params[3];
	params := 0; // Not needed anymore.

	NPC_SetupName(npc);
	NPC_SetupRandomEquipment(npc);

	foreach item in (ListEquippedItems(npc))
		item.color := RandomDyeColor();
		sleepms(2);
	endforeach

	// Set default language to Common (no prefix)
	if (!GetObjProperty(npc, "lingua_escolhida"))
		SetObjProperty(npc, "lingua_escolhida", "Comum");
	endif

	return 1;
endprogram
