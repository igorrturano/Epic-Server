use uo;
use util;
use os;

include ":brainAI:include/npcInit";
include ":dyes:include/dyes";
include ":merchants:pcmerchant/merchantRaceInit";

program InitScript(params)
	var npc := params[1];
	var settings := params[2];

	npc.color := 1056 - RandomInt(55); // 1002-1056
	npc.truecolor := npc.color;

	var result := MerchantSetupRace(npc);

	SetObjProperty(npc, "shift", "ambos");

	var registry := GetGlobalProperty("ShiftMerchantRegistry");
	if (!registry || registry == error)
		registry := dictionary;
	endif
	registry[npc.serial] := "ambos";
	SetGlobalProperty("ShiftMerchantRegistry", registry);

	if (result.errortext)
		return result;
	endif

	result := NPC_SetupRandomEquipment(npc);
	if (result.errortext)
		PrintTextAbove(npc, result.errortext);
		return 0;
	endif

	foreach item in (ListEquippedItems(npc))
		if (CanDye(item))
			item.color := RandomDyeColor();
		endif
		SleepMS(2);
	endforeach

	return 1;
endprogram
