							  "Roupas" -> 8,
							  "Armas" -> 9,
							  "Carpintaria" -> 10,
							  "Materia-Prima" -> 11,
							  "Joias" -> 12,
							  "Receitas" -> 13,
							  "Alimentos" -> 14,
							  "Artigos" -> 15,
							  "Pergaminhos" -> 16,
							  "Containers" -> 17,
							  "Elmos/Mascaras" -> 18 };

