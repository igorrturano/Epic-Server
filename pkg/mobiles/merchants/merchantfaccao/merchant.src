						  0xef2b,
						  0xef3c,
						  0xef3d,
						  0xef3e,
						  0xef3f,
						  0xef2b,   // pergaminhos tinta

						  0xef1f,
						  0xef2c,
						  0xef2d,
						  0xef2e,
						  0xef2f,   // Pergaminhos alquimicos.

						  0x6100,
