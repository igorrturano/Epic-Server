// =============================================================================
// citizenInterrogate.src — Player-facing interrogation gump.
//
// Started by dblclick.src for non-GM players. Six pre-set buttons.
//
// Eligibility (no SkillCheck — gating is membership-based to prevent grinding):
//   * chardata.Skills[AWARENESS] == 3   (PRI tier)            → eligible
//   * Player's faccao is in citizen's configured factions     → eligible
//   * everyone else                                           → chit chat only
//
// Daily cooldown (per citizen, per player):
//   * Eligible players consume one info pull per 24h per citizen.
//   * Cooldown is only burned when the citizen actually had matching news
//     to share — empty queries cost nothing.
//   * After the cooldown is burned, the citizen says "ja te contei tudo
//     que sabia hoje" until 24h elapses.
// =============================================================================

use uo;
use os;
use util;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":attributes:attributeConstants";
include ":brainAI:npcCommands";
include ":merchants:citizen/include/citizenStore";
include ":merchants:citizen/include/citizenAuthority";

const Q_SUSPICIOUS := 1;
const Q_MAGIC      := 2;
const Q_HIDING     := 3;
const Q_LOCKPICK   := 4;
const Q_TARGET     := 5;
const Q_DESCRIBE   := 6;

program citizenInterrogate(params)
    var npc := params[1];
    var player := params[2];

    if (!npc || !player)
        return;
    endif

    while (1)
        var gump := GFCreateGump();
        GFResizePic(gump, 0, 0, 9200, 380, 270);
        GFResizePic(gump, 15, 15, 9350, 350, 240);
        GFTextMid(gump, 15, 25, 350, 53, "Conversar com " + npc.name);

        GFAddButton(gump, 30, 60, 4005, 4006, GF_CLOSE_BTN, Q_SUSPICIOUS);
        GFTextLine(gump, 70, 62, 1153, "Voce viu algo suspeito?");

        GFAddButton(gump, 30, 90, 4005, 4006, GF_CLOSE_BTN, Q_MAGIC);
        GFTextLine(gump, 70, 92, 1153, "Alguem invocando magia?");

        GFAddButton(gump, 30, 120, 4005, 4006, GF_CLOSE_BTN, Q_HIDING);
        GFTextLine(gump, 70, 122, 1153, "Alguem se escondendo?");

        GFAddButton(gump, 30, 150, 4005, 4006, GF_CLOSE_BTN, Q_LOCKPICK);
        GFTextLine(gump, 70, 152, 1153, "Voce viu alguem cometendo arrombamentos?");

        GFAddButton(gump, 30, 180, 4005, 4006, GF_CLOSE_BTN, Q_TARGET);
        GFTextLine(gump, 70, 182, 1153, "Voce viu alguem em particular?");

        GFAddButton(gump, 30, 210, 4005, 4006, GF_CLOSE_BTN, Q_DESCRIBE);
        GFTextLine(gump, 70, 212, 1153, "Pode descrever a ultima pessoa que viu?");

        var input := GFSendGump(player, gump);
        if (!input)
            return;
        endif

        var fn := input[0];
        if (fn != Q_SUSPICIOUS && fn != Q_MAGIC && fn != Q_HIDING && fn != Q_LOCKPICK && fn != Q_TARGET && fn != Q_DESCRIBE)
            return;
        endif

        // Tier 1 — eligibility. Non-eligible players get chit chat and the
        // gump reopens for another try (or they right-click to leave).
        if (!_IsEligibleForInfo(npc, player))
            AI_Speak(npc, _ChitChat());
            sleep(2);
            continue;
        endif

        // Tier 2 — daily cooldown. Already consumed today? Brush off.
        if (!IsAwarenessFreeAvailable(npc, player))
            AI_Speak(npc, "Ja te contei tudo que sabia hoje. Volte amanha.");
            sleep(2);
            continue;
        endif

        // Compute the answer. Helpers return { found, message }; "found"
        // means the citizen had news to share — only then do we burn the
        // daily cooldown.
        var result := struct{ "found" := 0, "message" := "" };
        case (fn)
            Q_SUSPICIOUS: result := _AnswerSuspicious(npc);
            Q_MAGIC:      result := _AnswerByType(npc, "cast", "invocando magia");
            Q_HIDING:     result := _AnswerByType(npc, "hide", "se escondendo");
            Q_LOCKPICK:   result := _AnswerByType(npc, "lockpick", "arrombando ou mexendo em armadilhas");
            Q_TARGET:     result := _AnswerAboutTarget(npc, player);
            Q_DESCRIBE:   result := _AnswerDescribe(npc, player);
        endcase

        if (result.found)
            MarkAwarenessFreeUsed(npc, player);
        endif

        if (result.message != "")
            AI_Speak(npc, result.message);
        endif
        sleep(2);
    endwhile
endprogram

// ── Eligibility helpers ─────────────────────────────────────────────────────

function _IsEligibleForInfo(npc, player)
    if (_HasPrimaryAwareness(player))
        return 1;
    endif
    if (_IsCitizenFactionMember(npc, player))
        return 1;
    endif
    return 0;
endfunction

function _HasPrimaryAwareness(player)
    var chardata := GetObjProperty(player, "chardata");
    if (chardata == error || chardata.Skills == error)
        return 0;
    endif
    if (!chardata.Skills.Exists(AWARENESS))
        return 0;
    endif
    return chardata.Skills[AWARENESS] == 3;
endfunction

function _IsCitizenFactionMember(npc, player)
    var factions := GetCitizenFactions(npc);
    if (!factions || !factions.size())
        return 0;
    endif
    var idx := GetMobileFactionIndex(player);
    if (!idx)
        return 0;
    endif
    return idx in factions;
endfunction

function _ChitChat()
    var lines := array{
        "Que dia tranquilo, nao?",
        "Esses tempos andam mesmo agitados.",
        "Bom dia, estranho. Cuide-se por ai.",
        "Ando ocupado, vai me desculpar.",
        "Pena, nao tenho noticias para voce.",
        "Tem coisas que nao se conta para qualquer um."
    };
    return lines[RandomInt(lines.size()) + 1];
endfunction

// ── Answer functions ────────────────────────────────────────────────────────

function _AnswerSuspicious(npc)
    var entries := GetWitnessLog(npc);
    if (!entries.size())
        return struct{ "found" := 0, "message" := "Nao vi nada estranho ultimamente." };
    endif
    return struct{ "found" := 1, "message" := _DescribeEntry(entries[entries.size()]) };
endfunction

function _AnswerByType(npc, target_type, label)
    var entries := GetWitnessLog(npc);
    var match := 0;
    var i := entries.size();
    while (i >= 1)
        if (entries[i].type == target_type)
            match := entries[i];
            i := 0;
        else
            i := i - 1;
        endif
    endwhile
    if (!match)
        return struct{ "found" := 0, "message" := "Nao, nao vi ninguem " + label + " por aqui." };
    endif
    return struct{ "found" := 1, "message" := _DescribeEntry(match) };
endfunction

function _AnswerAboutTarget(npc, player)
    SendSysMessage(player, "Sobre quem voce quer perguntar?");
    var targ := Target(player);
    if (!targ)
        return struct{ "found" := 0, "message" := "Hmm, esquece." };
    endif
    var entries := GetWitnessLog(npc);
    var match := 0;
    var i := entries.size();
    while (i >= 1)
        if (entries[i].whoSerial == targ.serial)
            match := entries[i];
            i := 0;
        else
            i := i - 1;
        endif
    endwhile
    if (!match)
        return struct{ "found" := 0, "message" := "Nao vi " + targ.name + " fazendo nada por aqui." };
    endif
    return struct{ "found" := 1, "message" := _DescribeEntry(match) };
endfunction

function _AnswerDescribe(npc, player)
    var entries := GetWitnessLog(npc);
    if (!entries.size())
        return struct{ "found" := 0, "message" := "Nao vi ninguem suspeito ultimamente." };
    endif
    var entry := entries[entries.size()];
    Start_Script(":merchants:citizen/gumps/citizenReport", { npc, player, entry });
    return struct{ "found" := 1, "message" := "Deixa eu te mostrar..." };
endfunction

function _DescribeEntry(entry)
    var action := "agindo de forma suspeita";
    case (entry.type)
        "hide":     action := "tentando se esconder";
        "lockpick": action := "mexendo em uma fechadura";
        "cast":     action := "invocando uma magia";
        "attack":   action := "atacando alguem";
    endcase

    var was_incognito := 0;
    if (entry.wasIncognito != error && entry.wasIncognito)
        was_incognito := 1;
    endif

    var traits := "";
    if (entry.rpTraits != error)
        traits := CStr(entry.rpTraits);
    endif

    var descricao := "";
    if (entry.descricao != error)
        descricao := CStr(entry.descricao);
    endif

    if (was_incognito)
        var msg := "Vi alguem encapuzado " + action + ".";
        if (traits != "")
            msg := msg + " Mas notei: " + traits + ".";
        endif
        return msg;
    endif

    var msg := "Vi " + entry.whoName + " " + action + ".";
    if (descricao != "")
        msg := msg + " Sobre sua aparencia: " + descricao;
    elseif (traits != "")
        msg := msg + " Notei: " + traits + ".";
    endif
    return msg;
endfunction
