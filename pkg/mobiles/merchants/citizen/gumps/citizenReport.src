// =============================================================================
// citizenReport.src — Visual profile report gump.
//
// Started by citizenInterrogate.src when the player clicks "Pode descrever
// a pessoa?". Displays the most recent witness entry's perpetrator in a
// profile-style layout (image + name + race + descricao). Mirrors the
// :CharProfile:parseCharProfile gump dimensions.
//
// For perpetrators that were Incognito at witness time, shows the generic
// incognito splash and a description built from snapshotted RP traits.
// =============================================================================

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:htmlGump";

const PROFILE_GUMP_WIDTH    := 232;
const PROFILE_GUMP_HEIGHT   := 510;
const PROFILE_IMAGE_WIDTH   := 210;
const PROFILE_IMAGE_HEIGHT  := 330;
const PROFILE_IMAGE_Y       := 41;
const PROFILE_RACE_Y        := 375;
const PROFILE_DESC_Y        := 400;
const PROFILE_DESC_HEIGHT   := 100;

const INCOGNITO_URL := "https://th.bing.com/th/id/OIG.0XmfkJZCmPd.wGE6C9x_?pid=ImgGn&w=1024&h=1024&rs=1";

program citizenReport(params)
    var npc := params[1];
    var player := params[2];
    var entry := params[3];

    if (!player || !entry)
        return;
    endif

    var was_incognito := 0;
    if (entry.wasIncognito != error && entry.wasIncognito)
        was_incognito := 1;
    endif

    var name := "";
    var race := "";
    var url := "";
    var description := "";

    if (was_incognito)
        name := "Desconhecido";
        race := "Desconhecida";
        url := INCOGNITO_URL;
        var traits := "";
        if (entry.rpTraits != error)
            traits := CStr(entry.rpTraits);
        endif
        if (traits != "")
            description := "Estava encapuzado, mas notei: " + traits + ".";
        else
            description := "Estava encapuzado, sem detalhes claros.";
        endif
    else
        if (entry.whoName != error)
            name := CStr(entry.whoName);
        else
            name := "Desconhecido";
        endif
        if (entry.race != error && entry.race != "")
            race := CStr(entry.race);
        else
            race := "Desconhecida";
        endif
        if (entry.url != error && entry.url != "")
            url := CStr(entry.url);
        endif
        if (entry.descricao != error && entry.descricao != "")
            description := CStr(entry.descricao);
        elseif (entry.rpTraits != error && entry.rpTraits != "")
            description := "Notei: " + CStr(entry.rpTraits) + ".";
        else
            description := "Sem detalhes adicionais.";
        endif
    endif

    var gump := GFCreateGump();
    GFPage(gump, 0);
    GFResizePic(gump, 4, 3, 9270, PROFILE_GUMP_WIDTH, PROFILE_GUMP_HEIGHT);
    GFHTMLArea(gump, 15, 14, PROFILE_IMAGE_WIDTH, 24, name, 1, 0);

    if (url != "")
        GFHTMLArea(gump, 15, PROFILE_IMAGE_Y, PROFILE_IMAGE_WIDTH, PROFILE_IMAGE_HEIGHT,
                   "<img src=\"" + url + "\" width=\"" + PROFILE_IMAGE_WIDTH +
                   "\" height=\"" + PROFILE_IMAGE_HEIGHT + "\" x=\"0\" y=\"0\">");
    endif

    GFHTMLArea(gump, 15, PROFILE_RACE_Y, PROFILE_IMAGE_WIDTH, 24, race, 1, 0);
    GFHTMLArea(gump, 15, PROFILE_DESC_Y, PROFILE_IMAGE_WIDTH, PROFILE_DESC_HEIGHT, description, 1, 1);

    GFSendGump(player, gump);
endprogram
