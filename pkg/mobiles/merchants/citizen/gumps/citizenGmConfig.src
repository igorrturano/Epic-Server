// =============================================================================
// citizenGmConfig.src — GM-only citizen configuration gump.
//
// Started by dblclick.src when the doubleclicker is GM (cmdlevel >= 1).
// Lets the GM toggle which factions this citizen denounces to (multi-select
// over the 5 canonical factions in FACCAO_NOMES). Phase 1 jurisdiction is
// hardcoded to Valtheris, no UI for it.
// =============================================================================

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":faccao:include/faccao";
include ":merchants:citizen/include/citizenStore";

program citizenGmConfig(params)
    var npc := params[1];
    var player := params[2];

    if (!npc || !player)
        return;
    endif

    var current := GetCitizenFactions(npc);

    var gump := GFCreateGump();
    GFResizePic(gump, 0, 0, 9200, 360, 280);
    GFResizePic(gump, 15, 15, 9350, 330, 250);
    GFTextMid(gump, 15, 25, 330, 53, "Configurar Cidadao");
    GFTextLine(gump, 30, 50, 1153, "Faccoes que este cidadao denuncia:");

    var y := 80;
    var idx := 1;
    foreach name in (FACCAO_NOMES)
        var checked := 0;
        if (idx in current)
            checked := 1;
        endif
        GFCheckBox(gump, 30, y, 2361, 2362, checked, idx);
        GFTextLine(gump, 60, y, 1153, name);
        y := y + 25;
        idx := idx + 1;
        sleepms(2);
    endforeach

    GFAddButton(gump, 60, 240, 2130, 2129, GF_CLOSE_BTN, 1);
    GFAddButton(gump, 220, 240, 2119, 2120, GF_CLOSE_BTN, 0);

    var input := GFSendGump(player, gump);
    if (!input || input[0] != 1)
        return;
    endif

    var selected := array{};
    var i := 1;
    while (i <= FACCAO_NOMES.size())
        if (input[i])
            selected.append(i);
        endif
        i := i + 1;
    endwhile

    SetCitizenFactions(npc, selected);
    SendSysMessage(player, "Cidadao configurado com " + selected.size() + " faccao(oes).");
endprogram
