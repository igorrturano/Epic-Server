use uo;
use basic;

include ":tn:tngumps";
include "include/say";
include ":gumps:requestGump";
include ":gumps:htmlGump";
include ":uose:/include/merchant";

program vendoropt(who)

	SendSysMessageEx(who, "Escolha o npc vendor", SSM_REQUEST);
	var targ := Target(who);

	if (!targ)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return;
	endif

	if (!targ.npctemplate)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return;
	endif

	var opt := array;
	if (GetObjProperty(targ, "secret"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "onlyartifice"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "taverneiro"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "onlygmsells"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "onlyplayersells"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "startbuy") || GetObjProperty(targ, "endbuy"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "cofre") || GetObjProperty(targ, "cofre"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "Taxa") || GetObjProperty(targ, "taxap"))
		opt.append(1);
	else
		opt.append(0);
	endif
	if (GetObjProperty(targ, "faccao"))
		opt.append(1);
	else
		opt.append(0);
	endif
	opt.append(0);

	var curandeiro;
	if (targ.npctemplate == ":merchants:curandeiro")
		curandeiro := 1;
	endif

	var opcoes := { "Secreto", "Kit Artifice", "Sem Limite Minimo de 10", "Apenas GM vende", "Apenas Um Player Vende",
					"Alterar Mensagens de Compra", "Cofre", "Taxa", "Faccao", "Gerenciar Itens à Venda" };
	if (curandeiro == 1)
		opcoes.append("Custo por Sintoma");
	endif

	var result := CheckBoxGump(who, 300, 275, "Opcoes do Vendor", opcoes, opt);

	EraseObjProperty(targ, "secret");
	EraseObjProperty(targ, "onlyartifice");
	EraseObjProperty(targ, "taverneiro");
	EraseObjProperty(targ, "onlygmsells");
	EraseObjProperty(targ, "oneplayersells");
	EraseObjProperty(targ, "startbuy");
	EraseObjProperty(targ, "endbuy");

	foreach r in result
		if (r == "Secreto")
			SetObjProperty(targ, "secret", 1);
		elseif (r == "Kit Artifice")
			SetObjProperty(targ, "onlyartifice", 1);
		elseif (r == "Sem Limite Minimo de 10")
			SetObjProperty(targ, "taverneiro", 1);
		elseif (r == "Apenas GM vende")
			SetObjProperty(targ, "onlygmsells", 1);
		elseif (r == "Apenas Um Player Vende")
			var oneplayer := cstr(RequestGump(who, "Qual o nome do player?"));
			SetObjProperty(targ, "oneplayersells", oneplayer);
		elseif (r == "Alterar Mensagens de Compra")
			var startbuy := cstr(RequestGump(who, "Qual a mensagem de boas-vindas? [Cancele para deixar padrao]"));
			if (startbuy)
				SetObjProperty(targ, "startbuy", startbuy);
			endif
			var endbuy := cstr(RequestGump(who, "Qual a mensage? [Cancele para deixar padrao]"));
			if (endbuy)
				SetObjProperty(targ, "endbuy", endbuy);
			endif
		elseif (r == "Cofre")
			SendSysMessageEx(who, "Escolha o cofre", SSM_REQUEST);
			var cofre := Target(who);
			if (cofre.objtype == 40512)
				SetObjProperty(targ, "cofreid", cofre.serial);
			else
				SendSysMessageEx(who, "Escolha um container", SSM_REQUEST);
				return 1;
			endif
		elseif (r == "Taxa")
			var taxa := cint(RequestGump(who, "Insira a taxa cobrada em porcentagem [somente numeros inteiros]"));
			SetObjProperty(targ, "taxap", taxa);
		elseif (r == "faccao")
			var faccao := RequestGump(who, "Insira a faccao deste npc");
			SetObjProperty(targ, "faccao", faccao);
		elseif (r == "Custo por Sintoma")
			var custo := cint(RequestGump(who, "Insira o custo por sintoma [somente numeros inteiros]"));
			SetObjProperty(targ, "custo", custo);
		elseif (r == "Gerenciar Itens à Venda")
			GerenciarItensVenda(who, targ);
		endif
	endforeach

endprogram

function ContemNaoAscii(s)
	var i;
	for (i := 1; i <= Len(s); i := i + 1)
		if (CAsc(s[i]) > 127)
			return 1;
		endif
	endfor
	return 0;
endfunction

function EscaparHtml(s)
	s := StrReplace(s, "&", "&amp;");
	s := StrReplace(s, "<", "&lt;");
	s := StrReplace(s, ">", "&gt;");
	return s;
endfunction

function MontarFlags(item, lote)
	var flags := "";
	var graphic := cint(item.graphic);
	if (graphic <= 0 || graphic >= 0x4000)
		flags := flags + " [!gfx]";
	endif
	var desc := item.desc;
	if (!desc) desc := ""; endif
	if (Len(desc) > 30)
		flags := flags + " [!len]";
	endif
	if (desc["<"] != error || desc[">"] != error || desc["&"] != error)
		flags := flags + " [!html]";
	endif
	if (ContemNaoAscii(desc))
		flags := flags + " [!utf8]";
	endif
	if (cint(lote) <= 0)
		flags := flags + " [!lote]";
	endif
	return flags;
endfunction

function GerenciarItensVenda(who, npc)
	while (1)
		var slots := GetItemsSoldList(npc);
		if (!slots || slots.size() == 0)
			SendSysMessageEx(who, "Nenhum item à venda neste vendedor.", SSM_INFO);
			return;
		endif

		var html := "<basefont color=#FFFFFF>";
		html := html + "<b>" + npc.name + "</b> — " + cstr(slots.size()) + " itens<br><br>";

		foreach slot in slots
			sleepms(2);
			var info := GetItemSoldInfo(npc, slot);
			if (info == error || !info)
				continue;
			endif
			var cost := info[1];
			var item := info[2];

			var desc := item.desc;
			if (!desc) desc := "?"; endif
			var graphic := cint(item.graphic);
			var seller := cint(cost.seller);
			var flags := MontarFlags(item, cost.lote);

			html := html + "[" + cstr(slot) + "] gfx=" + Hex(graphic)
			            + " '" + EscaparHtml(desc) + "'"
			            + " seller=" + Hex(seller);
			if (flags != "")
				html := html + " <basefont color=#FF6666>" + flags + "<basefont color=#FFFFFF>";
			endif
			html := html + "<br>";
		endforeach

		SendHTMLGump(who, "Itens a Venda", html);

		var input := RequestGump(who, "Slot a remover (vazio = sair):");
		if (input == error || !input)
			return;
		endif
		var slot_num := cint(input);
		if (slot_num <= 0)
			return;
		endif
		var alvo := GetItemSoldInfo(npc, slot_num);
		if (alvo == error || !alvo)
			SendSysMessageEx(who, "Slot " + cstr(slot_num) + " nao existe.", SSM_FAIL);
			continue;
		endif
		RemoveItemForSale(npc, slot_num, 0, 1);
		SendSysMessageEx(who, "Slot " + cstr(slot_num) + " removido.", SSM_INFO);
	endwhile
endfunction
