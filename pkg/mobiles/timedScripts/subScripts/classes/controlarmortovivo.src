use uo;
use os;

include "include/say";

include ":attributes:attributes";
include ":taming:taming";

program TimedScript_Clumsy(params)
	var mobile := params[1];
	var attacker := params[2];
	params := 0; // Not needed anymore.

	mobile.SetMaster(attacker);
	// Registra o undead em TamedPets do controlador para que ListPetsNear()
	// o encontre nos teleports/walkOns. _TallyPets poda a entrada quando o
	// timer expira e o master volta a 0.
	AddPet(attacker, mobile.serial);

	SetObjProperty(mobile, "owner", attacker.serial);
	SetObjProperty(mobile, "name", mobile.name);
	SetObjproperty(mobile, "script", mobile.script);
	SetObjProperty(mobile, "AntigoTreinadorID", attacker.serial);

	mobile.script := ":epicai:controlledBrain";
	RestartScript(mobile);

	return 1;
endprogram
