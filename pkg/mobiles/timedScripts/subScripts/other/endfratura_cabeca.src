use uo;

include ":attributes:attributes";
include ":timedscripts:fraturaUtil";
include ":hotbar:include/custombuff";

program EndFraturaCabeca(params)
	var mobile := params[1];

	var penalty := CInt(GetObjProperty(mobile, "#fratura_cabeca_penalty"));
	if (penalty)
		AP_ModifyStatMod(mobile, INTELLIGENCE, penalty);
		mobile.hitchance_mod := mobile.hitchance_mod + 10;
		EraseObjProperty(mobile, "#fratura_cabeca_penalty");
	endif
	RemoveCustomBuff(mobile, BUFF_ID_FRATURA_CABECA);

	EndFratura_Finalize(mobile, "Cabeca");
endprogram
