use uo;
include ":attributes:attributes";

program EndFraturaBracos(params)
	var mobile := params[1];
	var penalty := CInt(GetObjProperty(mobile, "#fratura_bracos_penalty"));
	if (penalty)
		AP_ModifyStatMod(mobile, STRENGTH, penalty);
	endif
	EraseObjProperty(mobile, "#fratura_bracos_penalty");
	return 1;
endprogram