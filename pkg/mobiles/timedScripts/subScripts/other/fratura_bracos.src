use uo;
use os;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":tn:cooldown";
include "include/say";

function StartScript(mobile, attacker := 0, level := 0)
	var penalty := CInt(AP_GetStat(mobile, STRENGTH) / 2);
	SetObjProperty(mobile, "#fratura_bracos_penalty", penalty);
	AP_ModifyStatMod(mobile, STRENGTH, -penalty);
	SendSysMessage(mobile, "Seus bracos fraturados reduzem sua forca pela metade.");

	while (AP_GetVital(mobile, "DP") <= 19 || GetCooldown(mobile, "hurt_fratura_bracos") > 0)
		sleep(4);
	endwhile

	AP_ModifyStatMod(mobile, STRENGTH, penalty);
	EraseObjProperty(mobile, "#fratura_bracos_penalty");
	return 1;
endfunction

function EndScript(mobile)
	var penalty := CInt(GetObjProperty(mobile, "#fratura_bracos_penalty"));
	if (penalty)
		AP_ModifyStatMod(mobile, STRENGTH, penalty);
	endif
	EraseObjProperty(mobile, "#fratura_bracos_penalty");
	return 1;
endfunction

function LogOffScript(mobile)
	return 1;
endfunction

program TimedScriptInit(params)
	var mobile := params[1];
	var type := params[2];
	var level := params[3];

	if (typeof(type) == "String")
		if (type == "End")
			return EndScript(mobile);
		elseif (type == "LogOff")
			return LogOffScript(mobile);
		endif
	endif

	return StartScript(mobile, type, level);
endprogram