use uo;
use os;
use vitals;

include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":medicine:disease";

program TimedScript_disease(params)
	var mobile := params[1];
	var diseases_system := GetObjProperty(mobile, "Diseases_System");
	// Se Diseases_System esta corrompido (error/non-struct), tratar como nao-falhou
	// para garantir cleanup dos mods de STR/DEX/INT via enddisease_effect.
	var falhou := 0;
	if (diseases_system != error && TypeOf(diseases_system) == "Struct")
		falhou := CInt(diseases_system.falhou_cura);
	endif

	if (!falhou)
//print("NETROU NO END DISEASE");
		UpdateDiseaseProperty(mobile, "end_disease", 1);
		TS_LowerDuration(mobile, "diseaseeffect", -1);

/*var corpo_peste_id := diseases_system.serial_peste_corpse;

if (corpo_peste_id)
    var corpo_peste := SystemFindObjectBySerial(corpo_peste_id);

    if (corpo_peste)
        corpo_peste.movable := 1;

        // 🔥 força sair do corpo (ESSENCIAL)
        MoveObjectToLocation(corpo_peste, 1, 1, 1, mobile.realm, MOVEOBJECT_FORCELOCATION);

        sleepms(10); // dá tempo do servidor processar

        DestroyItem(corpo_peste);
    endif
endif
*/		
		return 1;
	endif

	UpdateDiseaseProperty(mobile, "falhou_cura", 0);

	return 1;
endprogram
