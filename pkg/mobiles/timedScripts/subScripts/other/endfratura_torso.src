use uo;
use vitals;

include ":attributes:attributes";
include ":timedscripts:fraturaUtil";
include ":hotbar:include/custombuff";

program EndFraturaTorso(params)
	var mobile := params[1];

	if (CInt(GetObjProperty(mobile, "#fratura_torso_penalty")))
		AP_SetVitalRegenRateMod(mobile, "Stamina", AP_GetVitalRegenRateMod(mobile, "Stamina") + 60);
		RecalcVitals(mobile);
		EraseObjProperty(mobile, "#fratura_torso_penalty");
	endif
	RemoveCustomBuff(mobile, BUFF_ID_FRATURA_TORSO);

	EndFratura_Finalize(mobile, "Torso");
endprogram
