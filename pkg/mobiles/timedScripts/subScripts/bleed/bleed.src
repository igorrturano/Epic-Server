use uo;
use vitals;
use os;

include ":attributes:attributes";
include ":attributes:skills";
include ":timedscripts:timedScripts";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":blood:blood";
include "include/client";

program default_poison(params)

	var who := params[1];
	var attacker := params[2];

	if (GetObjProperty(who, "bleed"))
		SendSysMessageEx(who, "O alvo ja esta sangrando", SSM_FAIL);
		return;
	endif

	if (attacker)
		SetScriptController(attacker);
	endif

	var dmg := CInt(AP_GetSkill(attacker, TACTICS) / 8) ? CInt(AP_GetSkill(attacker, TACTICS) / 8) : 3;
	var i;
	var loops := CInt(AP_GetSkill(attacker, TACTICS) / 10) ? CInt(AP_GetSkill(attacker, TACTICS) / 10)
				   : 5;

	var poisonedmsg := "";
	var viewermsg := "";
	poisonedmsg := "Voce esta com uma grave hemorragia!";
	viewermsg := "* - " + who.name + " esta sangrando muito! - *";

	for (i := 0; i < loops; i := i + 1)
		PrintTextPrivate(who, poisonedmsg, who);
		foreach mobile in (ListMobilesInLineOfSight(who, 8))
			if (mobile.ip && mobile != who)
				PrintTextPrivate(who, viewermsg, mobile);
			endif
			sleepms(2);
		endforeach

		// Bleed is internal cut damage — bypasses the resist chain.
		DealDamage(who, cint(dmg), DAMAGE_TYPE::FORCED, attacker);
		MakeBleed(who);
		PlayObjectCenteredEffect(who, FX_BLOOD_DROP, 0, 15);

		if (who.dead)
			break;
		endif

		sleep(4);
	endfor

	// 	TS_CurePoison(who, 120,"P", 5);
	TS_LowerDuration(who, "bleed", -1);
	var script := GetProcess(GetPid());
	script.kill();

	return;
endprogram
