use uo;
use os;
use util;
include ":charactercreation:habilidades";
include ":tn:cooldown";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";

program TimedScript_Paralysis(params)
	var mobile := params[1];

	if (GetObjProperty(mobile, "chardata").trait == "Defensor Anão")
		return;
	endif

	if (temhabilidade(mobile, "Movimento Livre") || GetCooldown(mobile, "vitalidadeinabalavel") ||
	 GetCooldown(mobile, "VontadeIndomavel") || (MobileWrapper(mobile).HasAbility(ABILITY_ID::FURIA_INDOMAVEL) &&
	 GetCooldown(mobile, "furia")))
		return;
	endif

	PlaySoundEffect(mobile, 0x65b);
	var originalcolor;
	originalcolor := mobile.color;
	SetObjProperty(mobile, "originalcolor", originalcolor);
	mobile.color := 2221;

	SendSysMessage(mobile, "Voce esta congelado.");
	mobile.frozen := 1;

	return 1;
endprogram
