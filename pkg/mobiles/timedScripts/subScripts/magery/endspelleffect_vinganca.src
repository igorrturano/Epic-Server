use uo;
use vitals;

include ":spells:Controller/SpellController";

program endspelleffect_vinganca(params)
	var mobile := params[1];
	var spellId := CInt(GetObjProperty(mobile, "prop"));

	var points := CInt(GetObjProperty(mobile, "#vinganca"));
	EraseObjProperty(mobile, "#vinganca");
	if (points > 0)
		ApplyRawDamage(mobile, points);
	endif

	SC_RemoveEffect(mobile, spellId);
	EraseObjProperty(mobile, "prop");

	return 1;
endprogram
