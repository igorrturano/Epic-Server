use uo;
use os;

program TimedScript_EndPetrify(params)
	var mobile := params[1];

	// Restore paralysis state (should be 0)
	mobile.paralyzed := 0;

	// Restore the original color
	var original_color := GetObjProperty(mobile, "#originalcolor");
	if (original_color)
		mobile.color := original_color;
		EraseObjProperty(mobile, "#originalcolor");
	else
		// If no color was saved, restore to default
		mobile.color := 0;
	endif

	// Remove petrified mark
	EraseObjProperty(mobile, "#petrified");
	EraseObjProperty(mobile, "noattack");

	// Visual and audio effects showing recovery
	PlaySoundEffect(mobile, 0x1F1);  // Despetrification sound
	PlayObjectCenteredEffect(mobile, 0x373A, 10, 10);  // Recovery effect

	SendSysMessage(mobile, "Voce voltou ao normal!");
	PrintTextAbove(mobile, "*Livre da pedra*");

	return 1;
endprogram
