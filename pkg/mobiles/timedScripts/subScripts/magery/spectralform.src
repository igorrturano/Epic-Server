
use uo;
use os;

include ":attributes:attributes";

program TimedScript_Clumsy(params)
	var who := params[1];

	SendSysMessage(who, "Voce assume uma forma espectral.");
	SetObjProperty(who, "#spectralform", who.color);
	who.color := 30000;

	who.evasionchance_mod := who.evasionchance_mod + 20;
	// Debug message
	if (!who.npctemplate)
		DebugMsg(who, DEBUG_HIT, Message($"[Forma Espectral] Aplicado -20 evasion_mod"));
	endif

	return 1;
endprogram
