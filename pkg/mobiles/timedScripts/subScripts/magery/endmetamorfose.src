use uo;
use os;
use vitals;

include ":attributes:attributes";
include "include/say";
include ":death:death";
include ":mounts:mounts";
include ":death:settings";
include ":attributes:vitals";
include ":timedscripts:timedScripts";
include ":fls_core:packets";
include ":wrappers:Objects/Model/MobileWrapper";
include ":message:model/Message";
include ":hotbar:include/custombuff";
include ":abilities:models/Ability";
include ":spells:Controller/SpellController";

program cureScript(params)
	var who := params[1];

	// Always clean up polymorph stat modifiers first, regardless of metamorfose state
	var hitsmod := CINT(GetObjProperty(who, "polymorph_hitsmod"));
	var manamod := CINT(GetObjProperty(who, "polymorph_manamod"));
	var stammod := CINT(GetObjProperty(who, "polymorph_stammod"));

	if (hitsmod)
		SetObjProperty(who, "hitsmod", CINT(GetObjProperty(who, "hitsmod")) - hitsmod);
	endif

	if (manamod)
		SetObjProperty(who, "manamod", CINT(GetObjProperty(who, "manamod")) - manamod);
	endif

	if (stammod)
		SetObjProperty(who, "stammod", CINT(GetObjProperty(who, "stammod")) - stammod);
	endif

	// Reset resistances
	var resist := CINT(GetObjProperty(who, "polymorph_resistmod"));
	if (resist)
		who.resist_physical_mod := who.resist_physical_mod - resist;
		who.resist_fire_mod := who.resist_fire_mod - resist;
		who.resist_cold_mod := who.resist_cold_mod - resist;
		who.resist_poison_mod := who.resist_poison_mod - resist;
		who.resist_energy_mod := who.resist_energy_mod - resist;

		// Clear wildshape portion from #SpellResist (used by status bar and DamageController)
		var mw := MobileWrapper(who);
		var sr := mw.GetProperty("#SpellResist");
		if (sr && !sr.errortext)
			sr.slash    -= resist;
			sr.piercing -= resist;
			sr.blunt    -= resist;
			sr.fire     -= resist;
			sr.cold     -= resist;
			sr.poison   -= resist;
			sr.energy   -= resist;
			mw.SetProperty("#SpellResist", sr);
		endif
	endif

	RecalcVitals(who);
	SendStatus(who);
	// Client's ArmorResistances dict went stale while armor was stripped during
	// transformation — re-emit packets so status gump reflects current #SpellResist.
	SC_RefreshArmorPackets(who);

	// Revert appearance if metamorfose data exists
	var metamorfose := GetObjProperty(who, "metamorfose");
	if (metamorfose != error)
		who.color := metamorfose.originalcolor;
		who.graphic := metamorfose.originalgraphic;
		who.truegraphic := metamorfose.originalgraphic;

		// Re-apply color overlays from any still-active SpellController effect
		// (e.g. barkskin casts color=2826). originalcolor is now the druid's
		// truecolor, so spells that were tinting before/during transformation
		// need their visual stamped back on.
		var timer_list := TS_GetTimerList(who);
		var mwc := MobileWrapper(who);
		foreach timer in (timer_list)
			if (_timer_iter[1, 12] != "spelleffect_")
				continue;
			endif
			var opts := mwc.GetProperty($"SpellOpts_{CInt(timer.level)}");
			if (opts && !opts.errortext && opts.color)
				who.color := opts.color;
			endif
		endforeach

		var namechar := GetObjProperty(who, "charname");
		SetName(who, namechar);
	endif

	// Re-equip gear stripped at transformation. POL keeps #EquippedOn set when
	// MoveItemToContainer unequips an item, so anything currently in the backpack
	// tagged with this mobile's serial is pre-shift kit. Skip if dead — at that
	// point items already live on the corpse and wakeup.inc handles re-equip.
	if (!who.dead && who.backpack)
		var serialC := who.serial;
		foreach item in EnumerateItemsInContainer(who.backpack)
			if (item.container == who.backpack && CInt(GetObjProperty(item, "#EquippedOn")) == serialC)
				if (!EquipItem(who, item))
					EraseObjProperty(item, "#EquippedOn");
				endif
			endif
		endforeach
	endif

	// Call the new function to handle werewolf buffs removal
	removeWerewolfBuffs(who);

	// Clean up primordial form elemental properties
	ClearPrimordialProperties(who);

	// Clean up transformation properties
	TS_LowerDuration(who, "velocidade", -1);
	TS_LowerDuration(who, "lentidao", -1);
	TS_LowerDuration(who, "strength", -1);
	TS_LowerDuration(who, "agility", -1);
	TS_LowerDuration(who, "intelligence", -1);
	EraseObjProperty(who, "skill_a");
	EraseObjProperty(who, "skill_d");
	EraseObjProperty(who, "dicedmg");
	EraseObjProperty(who, "polymorphbonus");
	EraseObjProperty(who, "metamorfose");
	EraseObjProperty(who, "polymorph_hitsmod");
	EraseObjProperty(who, "polymorph_manamod");
	EraseObjProperty(who, "polymorph_stammod");
	EraseObjProperty(who, "polymorph_resistmod");
	EraseObjProperty(who, "namechar");
	EraseObjProperty(who, "HitScripts");

	// Restore speech on form end
	who.squelch(0);

	SendPacket(who, "BF0006002600"); // Disable speed boost packet

	if (who.npctemplate)
		var normal_speed := GetObjProperty(who, "runspeed");

		who.run_speed := Cint(normal_speed);
	endif

	RemoveAbilityBuff(who, ABILITY_ID::ELO_NATURAL);

	PlaySoundEffect(who, SFX_SPELL_POLYMORPH);
endprogram

function removeWerewolfBuffs(who)
	var bonus := GetObjProperty(who, "polymorphbonus_moon");
	if (bonus != error)
		AP_SetSkillMod(who, TACTICS, AP_GetSkillMod(who, TACTICS) - bonus);
		EraseObjProperty(who, "polymorphbonus_moon");
	endif
endfunction

function ClearPrimordialProperties(who)
	// Clear primordial element flags
	EraseObjProperty(who, "primordial_fire");
	EraseObjProperty(who, "primordial_cold");
	EraseObjProperty(who, "primordial_energy");
	EraseObjProperty(who, "primordial_poison");

	// Clear elemental resistances from primordial form
	var fireResist := GetObjProperty(who, "primordial_resist_fire");
	if (fireResist)
		who.resist_fire_mod := who.resist_fire_mod - fireResist;
		EraseObjProperty(who, "primordial_resist_fire");
	endif

	var coldResist := GetObjProperty(who, "primordial_resist_cold");
	if (coldResist)
		who.resist_cold_mod := who.resist_cold_mod - coldResist;
		EraseObjProperty(who, "primordial_resist_cold");
	endif

	var energyResist := GetObjProperty(who, "primordial_resist_energy");
	if (energyResist)
		who.resist_energy_mod := who.resist_energy_mod - energyResist;
		EraseObjProperty(who, "primordial_resist_energy");
	endif

	var poisonResist := GetObjProperty(who, "primordial_resist_poison");
	if (poisonResist)
		who.resist_poison_mod := who.resist_poison_mod - poisonResist;
		EraseObjProperty(who, "primordial_resist_poison");
	endif
endfunction
