/* $Id: npcdeath.src 916 2005-11-05 23:44:32Z austin $
 *
 * Purpose
 * This script allows side effects to be triggered as a result of NPC death, like unmounting
 * players off their dying mount, playing death sounds, etc. This script is common for all NPCs,
 * and is called for each.
 *
*/
use uo;
use os;
use util;
use cfgfile;
use storage;

include ":containers:merchantUtil";
include ":containers:personalLoot";
include ":timedscripts:timedScripts";
include ":death:death";
include ":mounts:mounts";
include ":taming:taming";
include ":tn:questevent";
include ":attributes:vitals";
include ":combat:hitscripts";
include "include/say";
include ":tn:npcutil";
include ":epicAI:include/epicNPCCombat";   // CleanupDoppelgangerEquipment
include ":taming:taming";
include "include/epicCombatUtils";
include ":commands:possess";
include ":expbar:expbar";
include ":epicAI:epicai";
include ":tn:cooldown";
include ":hotbar:include/custombuff";
// include ":entropy:entropy";

program core_npcDeath(params)
	var corpse := params[1];
	// Check if this is a conquest NPC
	// if (corpse.GetProp("conquest_totem"))
	// 	CNQST_OnNPCDeath(corpse);
	// endif

	// Clean up doppelganger equipment and storage (appearance was already restored in candie.src)
	if (GetObjProperty(corpse, "#doppelganger_transformed"))
		CleanupDoppelgangerEquipment(corpse);
	endif

	var lastHit := GetObjProperty(corpse, "lastHit");
	if (":combat:weaponHitScripts/generic" in lastHit.hitscript)
		if (lastHit.attacker && !lastHit.attacker.errortext)
			var attacker := SystemFindObjectBySerial(lastHit.attacker);
			if (attacker != error)
				execonkill(attacker, corpse);
			endif
		endif
	endif

	if (cint(GetObjProperty(corpse, "soulstone")) == 1)
		CreateItemInContainer(corpse, "soulstone", 1);
	endif
	var nearbyMobs := array{};
	if (!GetObjProperty(corpse, "MirrorImage") && !GetObjProperty(corpse, "summoned") && !GetObjProperty(corpse, "owner"))
		nearbyMobs := HandleExpGain(corpse);
	endif
	// handleEntropyGain(corpse);
	foreach item in (EnumerateItemsInContainer(corpse))
		// Lista de itens que podem dropar do npc, mas ficam com prop de restrito_mob, não deixando o player equipar
		// var lista_itens := {
		//    0x1415, //Plate
		//    0x1416, //Plate
		//    0x1410, //Plate
		//    0x1417, //Plate
		//    0x1411, //Plate
		//    0x141A, //Plate
		//    0x1414, //Plate
		//    0x1418, //Plate
		//    0x1413  //Plate
		// };

		// foreach item_lista in lista_itens
		//    if (item.objtype == item_lista)
		//        SetObjProperty(item, "restrito_mob", 1);
		//        break;
		//    endif
		// endforeach
		var colored_lanterns := { 0x40FE, 0x40FF, 0x4100, 0x4101 };
		if (item.objtype in colored_lanterns)
			DestroyItem(item);
		endif

		if (item.isA(POLCLASS_ARMOR) || item.isA(POLCLASS_WEAPON))
			if (GetObjProperty(item, "itemunico") == error && GetObjProperty(item, "LootedBy") == error)
				item.hp -= Cint(item.hp * 0.8);
			endif
		endif
	endforeach

	HandleEpicBossLoot(corpse);
	HandleLeverSpawnedBoss(corpse);

	if (GetObjProperty(corpse, "true_boss") == 1)
		if (PersonalLoot_Arm(corpse))
			PersonalLoot_Stamp(corpse);
		endif
	endif

	if (getObjProperty(corpse, "owner")) // se for tamed, atualiza a prop tamedpets do master
		var lastDamage := GetObjProperty(corpse, "LastDamage");
		var region := GetRegionName(corpse);
		var char_name := lastDamage.serial;
		var tipo := "morreu";
		var fin, nome;
		if (char_name && !char_name.errortext)
			fin := SystemFindObjectBySerial(char_name, SYSFIND_SEARCH_OFFLINE_MOBILES);
			if (fin)
				nome := GetObjProperty(fin, "nome_inicial");
			endif
		endif
		var coords := { corpse.x, corpse.y, corpse.z, CStr(corpse.realm) };
		var trueBoss := GetObjProperty(corpse, "true_boss");
		if (fin && nome)
			var pet_name := corpse.desc;
			pet_name["A corpse of "] := "";
			Start_script(":DiscordWebhook:discord", { tipo, nome, fin.acctname, pet_name,
										  			region, coords, 0 });
		endif

		var masterserial := getObjProperty(corpse, "owner");
		if (masterserial && !masterserial.errortext)
			var master := SystemFindObjectBySerial(masterserial);
			if (!master)
				return;
			endif

			var summon := GetObjProperty(corpse, "summoned");
			if (summon == 1) // se for summon de druid para retirar da barra de buff e liberar o slot
				var masterseriali := getObjProperty(corpse, "owneri");
				if (masterseriali && !masterseriali.errortext)
					var masteri := SystemFindObjectBySerial(masterseriali);
					if (masteri)
						var timer_num := GetObjProperty(corpse, "slot");
						var timer := "summon_" + timer_num;
						TS_LowerDuration(masteri, timer, -1);
					endif
				endif
			elseif (!getobjproperty(corpse, "Necro"))
				GetNumPets(master);
				var teste := GetObjProperty(corpse, "LastDP");
				SetObjProperty(master, "LastPetCorpse", corpse.serial);
				if (GetObjProperty(corpse, "NeverRelease")) // &&
					// if (GetObjProperty(corpse, "LastDP") >= 10 ) ) // PARA TESTAR VOLTAR DPS
					SendSysMessageEx(master, "Seu pet fiel irá acordar em 3 minutos", SSM_INFO);
					sleep(180);
					RessuscitarPet(corpse, master);
					return;
				// else
				// SendSysMessageEx(master, "Seu pet fiel precisa ser reanimado!", SSM_FAIL);
				// endif
				endif
			else
				var numbersummons := Cint(GetObjProperty(master, "NecroSummons"));
				SetObjProperty(master, "NecroSummons", (numbersummons - 1));
			endif
		endif // Close the masterserial check				
	endif

	if (getObjProperty(corpse, "oldbodydominio"))
		var masterserial := getObjProperty(corpse, "oldbodydominio");
		if (masterserial && !masterserial.errortext)
			var master := SystemFindObjectBySerial(masterserial);
			if (master)
				SetObjProperty(master, "oldbodymorto", 1);
				EraseObjProperty(master, "oldbodyserial");
			endif
		endif
	endif

	var pilot := GetObjProperty(corpse, "golem_maker");
	if (pilot != error && pilot != 0)
		if (CInt(pilot) && !CInt(pilot).errortext)
			var who := SystemFindObjectBySerial(CInt(pilot));
			if (who)
				// NPC-specific handling
				if (who.npctemplate)
					SetObjProperty(who, "anchor", array{ corpse.x, corpse.y, corpse.z });
					MoveObjectToLocation(who, corpse.x, corpse.y, corpse.z, corpse.realm, MOVEOBJECT_FORCELOCATION);
				else
					leaveGolem(who);
					unpossess(who, 1, 1);
					who.concealed := 0;
				endif

				EraseObjProperty(who, "golem_maker");
				PrintTextAbove(corpse, "*EJETAR*");
				sleep(1);
				PushBackEX(who, 3, 300);
				PrintTextAbove(corpse, "*Iniciar auto destruição*");

				var i := 1;
				while (i <= 3)
					sleep(1);
					PrintTextAbove(corpse, Cstr(i));
					i++;
				endwhile

				AP_SetTrueSkill(corpse, ARCANA, 100);
				Run_Script(":spells:spell_logic/mage/fireball", { corpse, corpse });
			endif
		endif
	endif

	foreach mob in nearbyMobs
		// PrintTextAbove(corpse, "procurando mobs " + mob.name);
		if (cint(GetObjProperty(mob, "#satisfacaosadica")))
			// 	PrintTextAbove(corpse, "tem satisfacao " + cint(GetObjProperty(mob, "#satisfacaosadica")) + " " + readgameclock() );
			if (cint(GetObjProperty(mob, "#satisfacaosadica")) > readgameclock())
				// 		PrintTextAbove(corpse, "ta no time ");
				// 		var souls := Cint(getobjProperty(mob, "souls"));
				// 		souls := souls + 1;
				// 		SetobjProperty(mob, "souls", souls);
				PlayMovingEffect(corpse, mob, 14202, 5, 1, 0);
				PlaySoundEffect(mob, 383);
				applyEpicHealing(mob, 5);
				recalcvitals(mob);
			endif
		endif

		var shaman_reap_bonus := Cint(AP_GetSkill(mob, THEOLOGY) / 10);

		// HABILIDADES SHAMAN
		if (MobileWrapper(mob).HasAbility(ABILITY_ID::BLOODTHIRST))
			applyEpicHealing(mob, shaman_reap_bonus);
		endif
		// FIM HABILIDADES SHAMAN

		// GOLEM MAKER
		if (Getobjproperty(mob, "golem_maker"))
			EraseObjProperty(mob, "golem_maker");
		endif
		// FIM GOLEM MAKER

		if ((GetObjProperty(mob, "#presenteespiritual") != error))
			if (GetObjProperty(mob, "#presenteespiritual") > readgameclock())
				var souls := Cint(getobjProperty(mob, "souls"));
				souls := souls + 1;
				SetobjProperty(mob, "souls", souls);
				PlayMovingEffect(corpse, mob, 14202, 5, 1, 0);
				PlaySoundEffect(mob, 383);
				HealMana(mob, 10);
			// var mymana := AP_GetVital(mob, MANA) + 10;
			// var maxmana := AP_GetVitalMaximumValue(mob, MANA);

			// if (mymana > maxmana)
			// 	mymana := maxmana;
			// endif

			// AP_SetVital(mob, MANA, mymana);
			endif
		endif
	endforeach

	var accepted_sacrifice := 0;
	foreach item in ListItemsNearLocation(corpse.x, corpse.y, corpse.z, 4, corpse.realm)
		if (item.objtype == 0xA06A) // xamaaltar
			if (GetObjProperty(corpse, "animal_sacrifice"))
				accepted_sacrifice := 1;
			endif
		endif
	endforeach
	var shaman := SystemFindObjectBySerial(GetObjProperty(corpse, "animal_sacrifice"));
	if (accepted_sacrifice == 1 && shaman && shaman != error)
		var time := 3600;
		if (GetObjProperty(corpse, "aklat_sacrifice"))
			time := 9800;
		endif
		TS_StartTimer(shaman, "bless", time);
		// Death protection is delivered here, on the kill — not on cast.
		// Same cooldown the Protecao Contra a Morte spell (616) uses, so
		// players.src honors it via GetCooldown and it auto-expires.
		SetCooldown(shaman, "protecaomorte", time);
		SendSpellBuff(shaman, shaman, 617, time);
		SendSysMessageEx(shaman, "O Deserto se lembra. Voce esta protegido contra a morte.", SSM_INFO);
    	PlayStationaryEffect(shaman.x, shaman.y, shaman.z, 0xD035, 10, 30, 0, shaman.realm);
    	PlaySoundEffect(shaman, 0x1F1); // Sacrifice sound effect
	endif

	TS_Death(corpse); // Will still get the PID from the corpse.

	var corpse_name := corpse.desc;
	SetObjProperty(corpse, "originalname", corpse_name);
	var npc_name := corpse_name;
	npc_name["A corpse of "] := "";
	corpse_name["A corpse of"] := "corpo de";
	SetName(corpse, corpse_name);

	var template := GetObjProperty(corpse, "npctemplate"); // Set by the core.
	var npc_cfg := NPC_GetNPCConfig(template);
	var death_script;

	if (npc_cfg && !npc_cfg.errortext)
		death_script := npc_cfg.DeathScript;

		var speech := GetConfigStringArray(npc_cfg, "diespeech");
		if (speech && speech.size() > 0)
			if (RandomInt(100) < 30) // sempre 30% de chance de falar
				PrintTextAbove(corpse, speech[RandomInt(speech.size() + 1)]);
			endif
		endif
	endif

	var spawnpoint_serial := GetObjProperty(corpse, "spawnpoint");
	var spawnpoint;
	if (spawnpoint_serial && !spawnpoint_serial.errortext)
		spawnpoint := SystemFindObjectBySerial(spawnpoint_serial);
	endif
	// PrintTextAbove(corpse, "spawnpoint " + spawnpoint);
	if (GetObjProperty(corpse, "spawnkill") == error)
		if (spawnpoint)
			if (GetObjProperty(spawnpoint, "unique") == 1)
				var boss := GetObjProperty(spawnpoint, "uniquestat");
				if (boss.deathevent)
					foreach nevent in (boss.deathevent)
						// 	PrintTextAbove(corpse, " " + nevent.type);
						if ((nevent.type == "Criar Npcs") && (cint(nevent.x) == 6) && (cint(nevent.y) == 6) &&
		  (cint(nevent.z) == 6))
							nevent.x := corpse.x;
							nevent.y := corpse.y;
							nevent.z := corpse.z;
						// PrintTextAbove(corpse, "mudei o evento");
						endif
						ExecuteEvent(nevent);
					endforeach
				endif
			endif
		endif
	endif

	if (GetObjProperty(corpse, "spawnkill") == error)
		if (death_script)
			params.Append(npc_cfg);
			var result := Start_Script("deathscripts/" + death_script, params);
			if (result.errortext)
				PrintTextAbove(corpse, "Error::Death Script -" + result.errortext);
				SysLog("Error::Death Script Tmplt:[" + template + "] Desc:[" + corpse.desc + "] Ser:[" + Hex(corpse.serial)
						+ "] - " + result.errortext);
			endif
		endif
	endif

	// 	if (GetObjProperty(corpse, "spawnnet")) //se for spawnado pelo spawnet
	// 		SpawnNet_Clear(corpse);
	// 	elseif (GetObjProperty(corpse, "SpawnRegion") )//se for spawnado pelo regionspawn
	// 		SpawnRegionDeath(corpse);
	// 	endif		

	DP_PlayDeathSound(corpse);
	CPM_DeleteContainers(corpse);

	// PrintTextAbove(corpse, " " + corpse);	

	if (corpse)
		var loot := NoLootCheck(corpse, npc_cfg);
		var corp := NoCorpseCheck(corpse, npc_cfg);
		var lastDamage := GetObjProperty(corpse, "LastDamage");

		if (!lastDamage)
		// Do nothing
		else
			var region := GetRegionName(corpse);
			var char_name := lastDamage.serial;
			var fin, nome;
			if (char_name && !char_name.errortext)
				fin := SystemFindObjectBySerial(char_name, SYSFIND_SEARCH_OFFLINE_MOBILES);
				if (fin)
					nome := GetObjProperty(fin, "nome_inicial");
				endif
			endif
			var coords := { corpse.x, corpse.y, corpse.z, CStr(corpse.realm) };
			var trueBoss := Cint(GetObjProperty(corpse, "true_boss"));
			var epicboss := GetObjProperty(corpse, "EpicBossStruct");
			if (isBoss(corpse) || epicboss)
				SetObjProperty(corpse, "coords", coords);
				if (trueBoss == 1 && fin && nome) // Para acionar o DiscordWebhook
					var tipo := "boss";
					Start_script(":DiscordWebhook:discord", { tipo, nome, fin.acctname, npc_name,
										  					region, coords, corpse });
				elseif (fin && fin.cmdlevel == 4 && trueBoss == 1)
					var finOwner := Cint(GetObjProperty(fin, "owner"));
					if (finOwner && !finOwner.errortext)
						var fin_owner := SystemFindObjectBySerial(finOwner);
						if (fin_owner)
							var tipo := "boss";
							Start_script(":DiscordWebhook:discord", { tipo, nome, fin_owner.acctname, npc_name,
										  							region, coords, 0 });
						endif
					endif
				endif
			endif
		endif

		if (!(corp || loot))
			MP_DeathUnmount(corpse);
		endif
	endif
endprogram

function NoLootCheck(corpse, npc_cfg)
	if (GetObjProperty(corpse, "GuardKill"))
	// Nothing
	elseif (GetObjProperty(corpse, "guardkill"))
	// Nothing - Old CProp
	elseif (npc_cfg.NoLoot)
	// Nothing
	elseif (GetObjProperty(corpse, "NoCorpse"))
	// Nothing
	elseif (GetObjProperty(corpse, "nocorpse"))
	// Nothing - Old Cprop
	elseif (GetObjProperty(corpse, "summoned"))
	// Nothing;
	else
		return 0;
	endif

	// No corpse. Don't drop backpack contents.
	// PrintTextAbove(corpse, "*guardkilling*");
	foreach item in (EnumerateItemsInContainer(corpse))
		if (item.container == corpse)
			DestroyItem(item);
		endif
		sleepms(2);
	endforeach
	// PrintTextAbove(corpse, "no loot check");
	// no loot  nao destroi o corpo, so NoCorpse
	// DestroyItem(corpse);

	return 1;
endfunction

function NoCorpseCheck(corpse, npc_cfg)
	if (npc_cfg.NoCorpse)
	// Nothing
	elseif (GetObjProperty(corpse, "NoCorpse"))
	// Nothing
	elseif (GetObjProperty(corpse, "nocorpse"))
	// Nothing - Old Cprop
	elseif (GetObjProperty(corpse, "summoned"))
	// Nothing;
	else
		return 0;
	endif

	// No corpse. Place backpack contents where the corpse is.
	// PrintTextAbove(corpse, "no corpse");
	foreach item in (EnumerateItemsInContainer(corpse))
		// if ( item.container == corpse )
		var itm := MoveObjectToLocation(item, corpse.x, corpse.y, corpse.z, item.realm,
										 MOVEOBJECT_FORCELOCATION);

		// endif
		// PrintTextAbove(corpse, " " + item + " " + itm);
		sleepms(2);
	endforeach
	// PrintTextAbove(corpse, "no corpse check");
	DestroyItem(corpse);

	return 1;
endfunction

function PushBackEX(who, dist, delay, invert := 0)
	var mod := GetModByFacing(who.facing);
	var x := mod[1];
	var y := mod[2];

	if (!invert)
		x := x * -1;
		y := y * -1;
	endif

	var finalx := who.x + (dist * x);
	var finaly := who.y + (dist * y);
	var world_z := GetStandingHeight(finalx, finaly, who.z - 15, who.realm);
	var force := _ifElse(world_z.z != error && world_z.z <= who.z, MOVEOBJECT_FORCELOCATION,
					  MOVEOBJECT_NORMAL);
	for i := 1 to dist
		var finalx := (who.x + x);
		var finaly := (who.y + y);
		if (!CheckLosAt(who, finalx, finaly, who.z))
			return 0;
		endif
		var world_z := GetStandingHeight(who.x, who.y, who.z, who.realm);
		if (world_z.z > who.z)
			return 0;
		endif

		var err := MoveObjectToLocation(who, finalx, finaly, who.z, who.realm, force);
		if (err == error)
			// 	PrintTextAbove(who, "*bate no obstaculo*");
			return 0;
		endif
		sleepms(delay);
	endfor

	return 1;
endfunction

function HandleEpicBossLoot(corpse)
	var boss_struct := GetObjProperty(corpse, "EpicBossStruct");
	if (!boss_struct)
		return 0;
	endif

	if (!boss_struct.loot || boss_struct.loot.size() < 1)
		return 0;
	endif

	foreach loot_item in (boss_struct.loot)
		if (!loot_item.on_death)
			continue; // Skip non-death items
		endif

		var roll := RandomInt(100);
		if (roll >= loot_item.drop_chance)
			continue; // Failed drop roll
		endif

		var item := CreateItemInContainerFromTemplate(corpse, loot_item.template);
		if (!item)
			continue;
		endif

		item.movable := 1;
	endforeach

	return 1;
endfunction

function HandleLeverSpawnedBoss(corpse)
	// Check if this boss was spawned by a lever
	var lever_serial := GetObjProperty(corpse, "spawned_by_lever");
	if (!lever_serial)
		return 0;
	endif

	// Find the lever
	var lever := SystemFindObjectBySerial(lever_serial);
	if (!lever || lever == error)
		return 0;
	endif

	// Get respawn configuration (default 120-150 minutes)
	var respawn_min := GetObjProperty(lever, "respawn_min");
	var respawn_max := GetObjProperty(lever, "respawn_max");
	if (!respawn_min) respawn_min := 120; endif
	if (!respawn_max) respawn_max := 150; endif

	// Calculate random respawn time in seconds
	var respawn_minutes := RandomInt(respawn_max - respawn_min + 1) + respawn_min;
	var respawn_seconds := respawn_minutes * 60;

	// Set cooldown on lever (cooldown.inc uses "#" prefix internally)
	SetObjProperty(lever, "#boss_respawn", Cint(ReadGameClock() + respawn_seconds));

	// Unlock the lever
	EraseObjProperty(lever, "#inuse");

	// Clean up boss reference
	EraseObjProperty(lever, "champ");

	return 1;
endfunction
