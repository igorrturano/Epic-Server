use uo;
use os;

include ":death:wakeup";

program logon(player)
	var waketime := GetObjProperty(player, "death_waketime");
	if (waketime == error)
		return 1;
	endif

	if (CInt(GetObjProperty(player, "morto")) == 1)
		EraseObjProperty(player, "death_waketime");
		EraseObjProperty(player, "death_corpse_serial");
		return 1;
	endif

	var corpse_serial := GetObjProperty(player, "death_corpse_serial");
	var corpse := SystemFindObjectBySerial(CInt(corpse_serial));

	var now := polcore().systime;
	var remaining := CInt(waketime - now);

	if (remaining > 0)
		var ticks := CInt(remaining / 30);
		if (ticks < 1)
			ticks := 1;
		endif
		while (ticks > 0)
			if (ticks % 2 == 0)
				SendSysMessage(player, "Voce acordara em " + (ticks / 2) + " minuto(s).");
			endif
			if (ticks != 1)
				sleep(30);
			else
				SendSysMessage(player, "30 segundos...");
				sleep(10);
				SendSysMessage(player, "20 segundos...");
				sleep(10);
				SendSysMessage(player, "10 segundos...");
				sleep(10);
			endif
			// Re-check corpse for curado/morto during wait
			corpse := SystemFindObjectBySerial(CInt(corpse_serial));
			if (corpse)
				if (GetObjProperty(corpse, "curado"))
					SendSysMessage(player, "Voce foi curado e acordara em 5 segundos!");
					EraseObjProperty(player, "hurt");
					sleep(5);
					break;
				elseif (CInt(GetObjProperty(corpse, "morto")) || CInt(GetObjProperty(player, "morto")))
					SendSysMessage(player, "Algo aconteceu... Voce morreu.");
					SetObjProperty(corpse, "morto", 1);
					SetObjProperty(player, "morto", 1);
					EraseObjProperty(player, "death_waketime");
					EraseObjProperty(player, "death_corpse_serial");
					return 1;
				endif
			endif
			ticks := ticks - 1;
		endwhile
	endif

	// Re-fetch corpse in case it changed
	corpse := SystemFindObjectBySerial(CInt(corpse_serial));
	if (corpse)
		KataWakeUp(player, corpse);
	else
		FallbackResurrect(player);
	endif

	return 1;
endprogram
