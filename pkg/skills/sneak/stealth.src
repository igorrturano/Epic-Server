use uo;

include ":attributes:attributeConstants";
include ":attributes:attributes";
include ":charactercreation:habilidades";
include "include/say";
include "include/facings";
include "include/creationUtils";
include "include/dungeons";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":tn:cooldown";
include ":message:model/Message";
include ":merchants:citizen/include/citizenWitness";
include ":combat:Controller/HitController";
include "include/noiseAlert";
include "include/packets";

program skill_Stealth(who)

	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");

	if (who.hidden)
		DoStealthReroll(who);
	else
		DoHide(who);
	endif

endprogram

function _GrantStealthSteps(who, skill)
	var steps := qtdSteps(who, skill);
	if (GetObjProperty(who, "chardata").trait == "Desapercebido")
		steps := Cint(steps * 1.5);
	endif
	var mw := MobileWrapper(who);
	if (mw.HasAbility(ABILITY_ID::ESPREITA_SELVAGEM))
		steps := Cint(steps * 2.0);
	endif
	if (mw.HasAbility(ABILITY_ID::SMOKE_SCREEN))
		steps := steps * 2;
	endif
	if (InDarkness(who))
		steps := Cint(steps * 1.5);
	elseif (HasLightNearby(who))
		steps := Cint(steps * 0.66);
	endif
	return steps;
endfunction

function DoStealthReroll(who)

	if (GetEquipmentByLayer(who, 25))
		who.hidden := 0;
		SendSysMessageEx(who, "Voce nao pode ficar furtivo montado!", SSM_FAIL);
		return 0;
	endif

	var skill := EffectiveSkill(who, "Stealth");
	var skillTested := SNEAK;
	var mw := MobileWrapper(who);

	var atualStep := CInt(GetObjProperty(who, "#steathsteps"));
	var diff := 15 + atualStep * 10;
	if (!mw.HasAbility(ABILITY_ID::NINJA_PATH) && !mw.HasAbility(ABILITY_ID::ASSASSINAR))
		diff := diff + 50;
	endif

	var check := SkillCheck(who, skillTested, diff);
	if (check > 0)
		who.stealthsteps := _GrantStealthSteps(who, skill);
		SendSysMessageEx(who, "Voce esta se movendo silenciosamente.", SSM_INFO);

		if (who.hidden == 1)
			while (who.stealthsteps == 1)
				SendSysMessage(who, "Seu proximo passo ira te revelar");
				sleep(5);
			endwhile
		endif

		SetObjProperty(who, "#steathsteps", atualStep + 2);
		return 1;
	elseif (check >= -15)
		SendSysMessageEx(who, "Voce falhou mas se manteve escondido.", SSM_FAIL);
		return 0;
	else
		if (who.hidden)
			SendSysMessageEx(who, "Voce falhou e se revelou.", SSM_FAIL);
			ScreenShake(who, 0.6, 15);
			who.hidden := 0;
			Message("*aparece*").SendEmote(who);
			EmitNoise(who, 12, 1);

			var last_loc := struct{ "x" := who.x, "z" := who.z, "y" := who.y };
			foreach monster in ListMobilesNearLocationEx(who.x, who.y, who.z, 12,
														  LISTEX_FLAG_NORMAL | LISTEX_FLAG_HIDDEN | LISTEX_FLAG_NPC_ONLY)
				if (GetObjProperty(monster, "guild"))
					SendEvent(monster, struct{ "type" := 0x78460, source := who, "last_loc" := last_loc });
				endif
				sleepms(2);
			endforeach
		else
			SendSysMessageEx(who, "Voce falhou.", SSM_FAIL);
		endif
		return 0;
	endif

endfunction

function qtdSteps(who, skill)
	var steps := CInt(skill / 7);
	if (steps < 3)
		steps := 3;
	endif
	return steps;
endfunction

function DoHide(who)

	EraseObjProperty(who, "#overridehiding");
	var orig_x := who.x;
	var orig_y := who.y;
	var isPequilho := GetObjProperty(who, "chardata").race == PEQUILHO;

	if (!CanHide(who, orig_x, orig_y))
		return;
	elseif (GetProcess(CInt(GetObjProperty(who, "#HidePid"))))
		SendSysMessageEx(who, "Voce ja esta tentando se esconder.", SSM_FAIL);
		return;
	else
		SetObjProperty(who, "#HidePid", GetPid());
	endif

	SendSysMessageEx(who, "Voce comecou a tentar se esconder...", SSM_INFO);

	while (1)
		if (isPequilho)
			sleep(2);
		else
			sleep(3);
		endif

		if (!CanHide(who, orig_x, orig_y))
			break;
		endif
		var check := SkillCheck(who, SNEAK, -1);
		var diff := 0;
		if (GetObjProperty(who, "forjoumorte") == 1)
			diff := diff - 50;
			if (diff <= 0)
				diff := 5;
			endif
		endif
		var chardata := GetObjProperty(who, "chardata");
		if (chardata.trait == "Sorrateiro")
			diff := -10;
			if (diff <= 0)
				diff := 5;
			endif
		endif

		if (InDarkness(who))
			diff := diff - 10;
		endif
		if (HasLightNearby(who))
			diff := diff + 15;
		endif

		var semfalha := EffectiveSkill(who, "Stealth");

		if (check > diff)
			SendSysMessageEx(who, "Voce se escondeu.", SSM_INFO);
			who.hidden := 1;
			NotifyCitizenWitnesses(who, "hide", struct);
			var a := start_script(":sneak:stealthmode", array{ who });
			EraseObjProperty(who, "#steathsteps");
			who.stealthsteps := _GrantStealthSteps(who, EffectiveSkill(who, "Stealth"));
			SendSysMessageEx(who, "Voce esta se movendo silenciosamente.", SSM_INFO);
			if (GetCooldown(who, "partyhiding") > 0)
				HidingParty(who);
			endif
			break;
		elseif (check >= -25)
			SendSysMessageEx(who, "Voce falhou ao tentar se esconder.", SSM_FAIL);
			who.hidden := 0;
		elseif (semfalha <= 79)
			Message("*tentando se esconder*").SendEmote(who);
		endif
	endwhile
	SetObjProperty(who, "#hidewait", readgameclock() + 5);
endfunction

function HidingParty(who)

	var festa := who.party;

	if (!festa)
		return;
	endif

	var skill := EffectiveSkill(who, "Stealth");

	foreach member in (festa.members)
		if (member.serial != who.serial)
			if (Distance(who, member) < 8)
				if (CanHide(member, member.x, member.y, skill))
					SendSysMessageEx(member, "Voce esta preparando a emboscada!", SSM_INFO);
					member.hidden := 1;
					start_script(":sneak:stealthmode", array{ who });
					SetObjProperty(member, "#overridehiding", skill);
				else
					SendSysMessageEx(member, "Voce nao pode se esconder!", SSM_FAIL);
					SendSysMessageEx(who, member.name + " nao consegue se esconder!", SSM_FAIL);
				endif
			endif
		endif
	endforeach

endfunction

function CanHide(who, orig_x, orig_y, override_hiding := 0)

	if (who.warmode)
		SendSysMessageEx(who, "Voce nao pode se esconder em posicao de combate.", SSM_FAIL);
		return 0;
	elseif (who.x != orig_x || who.y != orig_y)
		SendSysMessageEx(who, "Voce parou de tentar se esconder.", SSM_FAIL);
		return 0;
	elseif (GetEquipmentByLayer(who, 0x19))
		SendSysMessageEx(who, "Voce nao pode fazer isto montado.", SSM_FAIL);
		return 0;
	elseif (who.frozen)
		SendSysMessageEx(who, "Voce nao pode fazer isto.", SSM_FAIL);
		return 0;
	endif

	foreach item in ListEquippedItems(who)
		if (CInt(item.graphic) in {0x0a12, 0x0a22, 0x0a23, 0x0a24, 0x0a15, 0xC626, 0xC620, 0xC622, 0xC628})
			SendSysMessageEx(who, "Voce nao pode se esconder carregando uma fonte de luz acesa!", SSM_FAIL);
			return 0;
		endif
	endforeach

	var skill := EffectiveSkill(who, "Stealth");

	if (override_hiding)
		skill := override_hiding;
	endif
	var range := GetHidingRange(skill);

	var rangebonus := Cint(GetObjProperty(who, "esconderseaprimorado"));
	range := range - rangebonus;
	if (range <= 1)
		range := 1;
	endif

	var hostiles := ListHostiles(who, range);
	var mw := MobileWrapper(who);
	if (mw.HasAbility(ABILITY_ID::FUGA_DE_EMERGENCIA) || mw.HasAbility(ABILITY_ID::STEALTH_RUN))
		return 1;
	elseif (hostiles[1])
		SendSysMessageEx(who, "Voce nao pode se esconder enquanto " + hostiles[1].name
				   + " esta atacando voce.", SSM_FAIL);
		return 0;
	endif

	var num_watching := GetWatchingPeople(who);
	var skill2 := EffectiveSkill(who, "Stealth") / 20;

	if (skill2 < 1)
		skill2 := 0;
	endif

	if (num_watching > skill2)
		SendSysMessageEx(who, "Existem muitas pessoas olhando voce se esconder aqui.", SSM_FAIL);
		return 0;
	endif

	return 1;
endfunction

function GetWatchingPeople(who)
	var counter := 0;
	var counterpt := 0;
	var range := GetHidingRange(EffectiveSkill(who, "Stealth"));
	foreach person in ListMobilesInLineOfSight(who, range)
		if ((person.connected) && (person != who))
			if ((person in who.party.members))
				if (IsFacing(person, who.x, who.y))
					counterpt := counterpt + 1;
				endif
			endif
		endif
		if (IsFacing(person, who.x, who.y))
			counter := counter + 1;
		endif
		sleepms(4);
	endforeach
	var counterliq := counter - counterpt;
	return counterliq;
endfunction

function GetHidingRange(skill)

	if (skill >= 100)
		return 2;
	elseif (skill >= 90)
		return 4;
	elseif (skill >= 80)
		return 6;
	elseif (skill >= 70)
		return 7;
	elseif (skill >= 60)
		return 8;
	elseif (skill >= 50)
		return 9;
	elseif (skill >= 40)
		return 10;
	elseif (skill >= 30)
		return 12;
	else
		return 15;
	endif
endfunction
