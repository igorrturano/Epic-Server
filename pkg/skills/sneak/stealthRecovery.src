use uo;
use os;

include ":attributes:attributes";
include "include/say";
include ":message:model/Message";
include ":combat:Controller/HitController";

program stealthRecovery(who)

	SetObjProperty(who, "#stealthRecoveryPid", GetPid());

	var still_ticks := 0;
	var last_x := who.x;
	var last_y := who.y;

	while (who && who.hidden)
		var exausto := CInt(GetObjProperty(who, "#stealthExausto"));
		var chain := CInt(GetObjProperty(who, "#steathsteps"));

		if (!exausto && chain == 0)
			break;
		endif

		var moved := (who.x != last_x || who.y != last_y);
		last_x := who.x;
		last_y := who.y;

		if (moved)
			still_ticks := 0;
			if (exausto)
				if (!AP_ConsumeVital(who, "Stamina", 10))
					AP_ConsumeVital(who, "Hits", 10);
				endif
				if (AP_GetVital(who, "Stamina") <= 0)
					RevealExhausted(who);
					break;
				endif
			endif
		else
			var stam := AP_GetVital(who, "Stamina");
			if (InDarkness(who) && stam > 0)
				still_ticks := still_ticks + 1;
				if (still_ticks % 2 == 0 && chain > 0)
					SetObjProperty(who, "#steathsteps", chain - 1);
				endif
				if (still_ticks >= 5 && exausto)
					EraseObjProperty(who, "#stealthExausto");
					EraseObjProperty(who, "#stealthExaustoMsg");
					who.stealthsteps := who.stealthsteps + 3;
					SendSysMessageEx(who, "Você recupera o fôlego.", SSM_INFO);
				endif
			endif
		endif

		sleepms(1000);
	endwhile

	EraseObjProperty(who, "#stealthRecoveryPid");
endprogram

function RevealExhausted(who)
	who.hidden := 0;
	EraseObjProperty(who, "#stealthExausto");
	EraseObjProperty(who, "#stealthExaustoMsg");
	EraseObjProperty(who, "#stealthBudgetTotal");
	EraseObjProperty(who, "#stealthShakeFired");
	SendSysMessageEx(who, "Você desaba de exaustão e é revelado.", SSM_FAIL);
	Message("*desaba exausto*").SendEmote(who);

	var last_loc := struct{ "x" := who.x, "z" := who.z, "y" := who.y };
	foreach monster in ListMobilesNearLocationEx(who.x, who.y, who.z, 12,
												  LISTEX_FLAG_NORMAL | LISTEX_FLAG_HIDDEN | LISTEX_FLAG_NPC_ONLY)
		if (GetObjProperty(monster, "guild"))
			SendEvent(monster, struct{ "type" := 0x78460, source := who, "last_loc" := last_loc });
		endif
		sleepms(2);
	endforeach
endfunction
