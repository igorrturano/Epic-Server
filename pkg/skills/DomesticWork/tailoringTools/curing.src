					intacta_name := "cabecalagartodigelo";
					break;
				0xC139: 
					intacta_obj := 0xd221;
					intacta_name := "cabecalagartodeserto2";
					break;
				// --- fixes mapeamento trofeus ---
				0xC0EB:
					intacta_obj := 0xd1b7;
					intacta_name := "cabecadeogro";
					break;
				0xC130:
					intacta_obj := 0xd222;
					intacta_name := "cabecadetroll";
					break;
				0xC0AF:
					intacta_obj := 0xd223;
					intacta_name := "perca";
					break;
endcase

			if (intacta_obj)
				var dom_skill := AP_GetTrueSkill(who, DOMESTIC_WORK);
				var sur_skill := AP_GetTrueSkill(who, SURVIVAL);
				var use_skill := DOMESTIC_WORK;
				if (sur_skill > dom_skill)
					use_skill := SURVIVAL;
				endif
				var difficulty := GetSkinningDifficulty(intacta_name);

				PrintTextAbove(who, "*curtindo cabeca*");
				Sleep(3);

				if (SkillCheck(who, use_skill, difficulty) > 0)
					if (SubtractAmount(useon, 1))
						CreateItemInBackpack(who, intacta_obj, 1);
						SendSysMessage(who, "Voce curtiu a cabeca com sucesso.");
						PlaySoundEffect(who, 0x49);
					endif
				else
					if (SubtractAmount(useon, 1))
						SendSysMessage(who, "Voce estragou a cabeca ao tentar curti-la.");
					endif
				endif
				return;
			endif

			case (obj_type)
				0x1078:
				0x1079:
					// couro
					prod_type := 0xee45;
					break;
				0xee46:
					// corda
					prod_type := 0xee47;
					break;
				0xee51:
					// pelebege
					prod_type := 0xee57;
					break;
				0xee52:
					// pelepolar
					prod_type := 0xee58;
					break;
				0xee53:
					// pelemarrom
					prod_type := 0xee56;
					break;
				0xee54:
					// pelecinza
					prod_type := 0xee55;
					break;
				0xef11:
					// couroescamoso
					prod_type := 0xef20;
					break;
				0xef13:
					// couronegro
					prod_type := 0xc605;
					break;
				0xef15:
					// couropeludo
					prod_type := 0xef24;
					break;
				0xef16:
					// courocinzento
					prod_type := 0xef25;
					break;
				0xef17:
					// couropolar
					prod_type := 0xef26;
					break;
				0xef18:
					// courogigante
					prod_type := 0xef27;
					break;
				0xed20:
					// courodraconiano
					prod_type := 0xed29;
					break;
				default: SendSysMessage(who, "Voce so pode usar couro aqui"); return;
			endcase

			var characterx := who.x;
			var charactery := who.y;
			var qtd := useon.amount;
			repeat
				if (qtd > 5)
					if (SubtractAmount(useon, 5))
						PrintTextAbove(who, "*curtindo couro*");
						Sleep(3);
						CreateItemInBackpack(who, prod_type, 5);
						PlaySoundEffect(who, 0x49);
						qtd := qtd - 5;
					else
						SendSysMessage(who, "Voce nao tem mais material para usar aqui");
						break;
					endif
				else
					if (SubtractAmount(useon, qtd))
						PrintTextAbove(who, "*curtindo couro*");
						Sleep(3);
						CreateItemInBackpack(who, prod_type, qtd);
						PlaySoundEffect(who, 0x49);
						break;
					else
						SendSysMessage(who, "Voce nao tem mais material para usar aqui");
						break;
					endif
				endif
			until (who.x != characterx || who.y != charactery);
		endif
	endif
endprogram
