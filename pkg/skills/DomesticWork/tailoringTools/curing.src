					break;
				0xC01F:
					intacta_obj := 0xd1c1;
					intacta_name := "cabecaderato";
					break;
				0x1e8e:
					intacta_obj := 0xd1c0;
					intacta_name := "pigshead";
					break;
				0x315B:
					intacta_obj := 0xd1ed;
					intacta_name := "unicornhead";
					break;
							// --- Materiais de trofeu (nao-cabecas) ---
				0xC09A:
					intacta_obj := 0xd1fd;
					intacta_name := "peixeazul";
					break;
				0xC09D:
					intacta_obj := 0xd1fe;
