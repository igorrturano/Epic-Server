					break;
				0xC115:
					intacta_obj := 0xd214;
					intacta_name := "cabecademoniochifrudo";
					break;
				0xC118:
					intacta_obj := 0xd215;
					intacta_name := "cabecademoniodasprofundezas";
					break;
				0xC0E2:
					intacta_obj := 0xd216;
					intacta_name := "cabecagiganteGelo";
					break;
				0xC0E5:
					intacta_obj := 0xd217;
					intacta_name := "cabecagigantedeserto2";
					break;
				0xC0E8:
					intacta_obj := 0xd218;
					intacta_name := "cabecagigantegelocombatente";
					break;
				0xC037:
					intacta_obj := 0xd219;
					intacta_name := "cabecadragao6";
					break;
				0xC040:
					intacta_obj := 0xd21a;
					intacta_name := "cabecadragao9";
