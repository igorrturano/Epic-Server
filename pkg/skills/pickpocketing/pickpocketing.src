use uo;
use os;
use util;
use cfgfile;
use storage;

include ":attributes:attributes";
include "include/facings";
include "include/say";
include ":timedscripts:timedScripts";
include ":tn:boss";
include "include/epicNPCUtils";
include ":stealables:stealables";
include ":traps:traps";
include ":message:model/Message";
include ":tn:cooldown";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":debug:Controller/DebugController";

function DifficultyTier(diff)
	if (diff < 20)
		return "Fácil";
	elseif (diff < 40)
		return "Médio";
	elseif (diff < 60)
		return "Difícil";
	else
		return "Perigoso";
	endif
endfunction

program skill_Stealing(mobile)
	if (GetProcess(CInt(GetObjProperty(mobile, "#PickPid"))))
		Message("Voce ja esta roubando alguem.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return;
	else
		SetObjProperty(mobile, "#PickPid", GetPid());
	endif

	if (CInt(GetObjProperty(mobile, "#StealWait")) > ReadGameClock())
		Message("Voce deve aguardar um pouco para usar essa pericia novamente.").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
		return 0;
	else
		SetObjProperty(mobile, "#StealWait", ReadGameClock() + 5);
	endif

	if (!maolivre(mobile, 1))
		return 0;
	endif

	var metamorfose := GetObjProperty(mobile, "metamorfose");
	if (metamorfose != error)
		Message("Voce nao pode roubar enquanto estiver metamorfoseado.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif

	Message("Selecione que pessoa ou item voce deseja roubar.").SetColor(Color(SYSTEM_COLOR::ALERT)).SendSys(mobile);
	var targ := Target(mobile);
	
	// Verifica se é um artefato roubável
	if (targ && targ.IsA(POLCLASS_ITEM) && IsStealableArtifact(targ))
		return HandleStealableArtifact(mobile, targ);
	endif
	
	var difbonus := 0;
	if (targ == mobile)
		Message("Espertao voce hein..?").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	elseif (targ.connected == 0)
		Message("Voce nao pode roubar jogadores desconectados.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	// elseif ( targ.npctemplate )
	// 	Message("Voce so pode roubar jogadores.", SSM_FAIL).SendSys(mobile);
	// 	return 0;
	// elseif ( targ.warmode && targ.npctemplate )
	// 	Message("O alvo esta se movimentando demais lutando.", SSM_FAIL).SendSys(mobile);
	// 	return 0;
	elseif (!targ.IsA(POLCLASS_MOBILE))
		Message("Voce so pode roubar jogadores.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	elseif (targ.npctemplate == ":merchants:estalagem")
		Message("Voce nao pode roubar este tipo de NPC.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	elseif (isBoss(targ))
		Message("Voce nao pode roubar este tipo de NPC.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	elseif (Distance(mobile, targ) > 2)
		Message("O alvo esta muito longe.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	elseif (!IsBehind(targ, mobile.x, mobile.y))
		if (!MobileWrapper(mobile).HasAbility(ABILITY_ID::BATEDOR_DE_CARTEIRA))
			Message("Voce precisa estar nas costas do alvo.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
			return 0;
		else
			difbonus := 10;
		endif
	endif

	var diff := 15 + CInt(AP_GetSkill(targ, AWARENESS));
	if (MobileWrapper(mobile).HasAbility(ABILITY_ID::VALENTAO))
		var multidao := ListMobilesNearLocation(targ.x, targ.y, targ.z, 4, targ.realm).size();
		if (multidao > 4)
			var bonus := 5 * (multidao - 4);
			diff := diff - bonus;
			Message("Bonus de Ladrão de Multidões: +" + bonus + ".").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
		endif
	endif

	Message("Você avalia " + targ.name + "... " + DifficultyTier(diff) + ".", Color(SYSTEM_COLOR::INFO)).SendSys(mobile);

	var check := SkillCheck(mobile, PICKPOCKETING, diff);
	DebugMsg(
		mobile,
		DEBUG_HAB,
		Message(
			"[PICKPOCKET] bag-open skill=" + AP_GetSkill(mobile, PICKPOCKETING) +
			" awar=" + AP_GetSkill(targ, AWARENESS) +
			" diff=" + diff + " check=" + check,
			Color(SYSTEM_COLOR::INFO)
		)
	);
	if (check > 0)

		if (!mobile.hidden)
			var range := 13 - CInt(AP_GetSkill(mobile, PICKPOCKETING) / 7);
			var diff_awar := CInt(AP_GetSkill(mobile, PICKPOCKETING)) - 15;
			foreach player in (ListMobilesInLineOfSight(targ, range))
				if (player.npctemplate)
				elseif (player == mobile)
				elseif (player == targ)
				elseif (!IsBehind(player, targ.x, targ.y) && (SkillCheck(player, AWARENESS, diff_awar) > 0))
					Message("Voce nota que " + player.name + " percebeu algo.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
					Message("Voce nota " + mobile.name + " tentando roubar de " + targ.name + ".").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(player);
				endif
				SleepMS(2);
			endforeach
		endif

		Message("Voce conseguiu abrir a mochila de " + targ.name + ".").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
	SendOpenSpecialContainer(mobile, targ.backpack);
	Message("Se desejar parar de roubar, pressione Esc no momento da escolha do item.").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);

	var steal_attempts := 0;
	var max_steal_attempts := 50;  // Proteção: máximo 50 tentativas por sessão
	
	while (steal_attempts < max_steal_attempts)
		steal_attempts := steal_attempts + 1;
		
		Message("Escolha um item para roubar.").SetColor(Color(SYSTEM_COLOR::ALERT)).SendSys(mobile);
		var steal := Target(mobile); // , TGTOPT_NOCHECK_LOS);
			if (!steal)
				Message("Voce parou de roubar.").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
				break;
			elseif (Distance(mobile, targ) > 2)
				Message("O alvo se afastou demais.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				break;
			elseif (!IsBehind(targ, mobile.x, mobile.y))
				if (!MobileWrapper(mobile).HasAbility(ABILITY_ID::BATEDOR_DE_CARTEIRA))
					Message("O alvo nao esta mais de costas para voce.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
					break;
				endif
			elseif (steal == targ)
				Message("Alvo invalido.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				continue;
			endif
			var aux := steal;
			while (aux.container)
				aux := aux.container;
			endwhile
			if (aux != targ)
				Message("Voce so pode roubar da bolsa que abriu.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				continue;
			elseif (steal.IsA(POLCLASS_CONTAINER) && steal.objtype != 0x1011)
				if (steal.locked)
					Message(steal.desc + " esta trancado.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				else
					SendViewContainer(mobile, steal);
					Message("Voce abriu " + steal.desc + ".").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
				endif
				continue;
			endif

			var batedor := MobileWrapper(mobile).HasAbility(ABILITY_ID::BATEDOR_DE_CARTEIRA);
			if (steal.objtype IN { 0xba63, 0xba64, 0xba65 }) // moeda
				diff := CInt(steal.amount / 5);
				if (batedor)
					diff := 0;
					DebugMsg(mobile, DEBUG_HAB, Message("[PICKPOCKET] Batedor override: auto-success para moedas", Color(SYSTEM_COLOR::INFO)));
				endif
			elseif (steal.objtype IN { 0x1085, 0x1086, 0x1087, 0x1088, 0xA349, 0x1089, 0x108a,
						   			0x2b6e, 0x2b6f, 0x2b70, 0xCE3D, 0xCE3E, 0xCE3F }) // joias
				diff := CInt(steal.weight * 10);
				if (batedor)
					diff := 0;
					DebugMsg(mobile, DEBUG_HAB, Message("[PICKPOCKET] Batedor override: auto-success para joias", Color(SYSTEM_COLOR::INFO)));
				endif
			elseif (steal.objtype IN { 0x1011, 0x100E, 0x100F, 0x1010, 0x1012, 0x1013 }) // chaves
				diff := 35;
				if (batedor)
					diff := 0;
					DebugMsg(mobile, DEBUG_HAB, Message("[PICKPOCKET] Batedor override: auto-success para chaves", Color(SYSTEM_COLOR::INFO)));
				endif
			else
				diff := CInt(steal.weight * 10);
			endif

			diff := diff + difbonus;

			if (diff > 1.5 * AP_GetSkill(mobile, PICKPOCKETING))
				Message(steal.desc + " (peso " + steal.weight + "): Voce nao tentara roubar isso, pois tem certeza que falhara.", Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				continue;
			endif

			if (batedor && diff == 0)
				Message("Seus dedos deslizam sobre " + steal.desc + "...", Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
			else
				Message("Voce estima " + steal.desc + " (peso " + steal.weight + ")... " + DifficultyTier(diff) + ".", Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
			endif

			var item_check := SkillCheck(mobile, PICKPOCKETING, diff);
			DebugMsg(
				mobile,
				DEBUG_HAB,
				Message(
					"[PICKPOCKET] item=" + steal.desc + " objtype=" + steal.objtype +
					" weight=" + steal.weight + " amount=" + steal.amount +
					" diff=" + diff + " check=" + item_check +
					" skill=" + AP_GetSkill(mobile, PICKPOCKETING),
					Color(SYSTEM_COLOR::INFO)
				)
			);
			if (item_check > 0)
				if (MobileWrapper(targ).HasAbility(ABILITY_ID::VINCULO_ELEMENTAL))
					if (GetObjProperty(steal, "#elementalweapon"))
						Message("O alvo tem uma ligacao magica com a arma.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
						return 1;
					endif
				endif
				MoveObjectToLocation(steal, 0, 0, 0, mobile.realm);
				MoveItemToContainer(steal, mobile.backpack);
				Message("Voce roubou " + steal.desc + ".", Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
				if (item_check > 25)
					Message("*mão leve como uma pluma*", Color(SYSTEM_COLOR::SUCCESS)).SendAbovePrivate(mobile, mobile);
				elseif (item_check <= 5)
					Message("Por um triz! " + targ.name + " quase te pegou...", Color(SYSTEM_COLOR::ALERT)).SendSys(mobile);
				endif
				SkillCheck(mobile, PICKPOCKETING, -1);

				var region := GetRegionName(mobile);
				var char_name := mobile.serial;
				var fin := SystemFindObjectBySerial(char_name, SYSFIND_SEARCH_OFFLINE_MOBILES);
				// var coords := GetObjProperty(mobile, "anchor");
				var tipo := "furto";
				var coords := { mobile.x, mobile.y };

				var nome1 := GetObjProperty(mobile, "nome_inicial");
				var nome2 := GetObjProperty(targ, "nome_inicial");
				var tempo_furto := polcore().systime;
				if (targ.connected == 1)
					if (GetObjProperty(targ, "ultimo_furto"))
						Eraseobjproperty(targ, "ultimo_furto");
					endif
					var furto_info := struct;
					furto_info.+local := struct;
					furto_info.local.+regiao := region;
					furto_info.local.+coordenadas := coords;
					furto_info.+autor := nome1;
					furto_info.+ladraoserial := mobile.serial;
					furto_info.+item_furtado := steal.desc;
					furto_info.+tempo := tempo_furto;
					SetObjProperty(targ, "ultimo_furto", furto_info);
					Start_script(":DiscordWebhook:discord", { tipo, nome1, fin.acctname, nome2,
										  					region, coords, steal.desc });
				endif
			else
				Message("Voce nao conseguiu roubar " + steal.desc + ".").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				if (TS_GetTimerInfo(targ, "sleep"))
					Message("Voce acelerou o despertar do alvo!").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
					var tempo_faltante := TS_GetTimerDuration(targ, "sleep");
					var tempo_metade := tempo_faltante / 2;
					TS_LowerDuration(targ, "sleep", -1);
					TS_StartTimer(targ, "sleep", tempo_metade, 1, 0, 0);
					Detach();
				endif
				if (item_check < -25)
					DebugMsg(
						mobile,
						DEBUG_HAB,
						Message("[PICKPOCKET] critical failure on item (check=" + item_check + ")", Color(SYSTEM_COLOR::FAIL))
					);
					StealCriticalFailure(mobile, targ);
				endif
				break;
			endif
		endwhile
		
		// Aviso se atingiu o limite de tentativas
		if (steal_attempts >= max_steal_attempts)
			Message("Voce atingiu o limite de tentativas de roubo. Tente novamente.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		endif
		
		MoveObjectToLocation(mobile, mobile.x, mobile.y, mobile.z, mobile.realm, MOVEOBJECT_FORCELOCATION);
	else
		Message("Voce nota que o alvo percebeu algo.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		Message("Voce sentiu algo na sua bolsa.").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(targ);

		if (!mobile.hidden)
			var range := 13 - CInt(AP_GetSkill(mobile, PICKPOCKETING) / 7);
			var diff_awar := CInt(AP_GetSkill(mobile, PICKPOCKETING)) - 15;
			foreach player in (ListMobilesInLineOfSight(targ, range))
				if (player.npctemplate)
				elseif (player == mobile)
				elseif (player == targ)
				elseif (!IsBehind(player, targ.x, targ.y) && (SkillCheck(player, AWARENESS, diff_awar) > 0))
					Message("Voce nota que " + player.name + " percebeu algo.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
					Message("Voce nota " + mobile.name + " tentando roubar de " + targ.name + ".").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(player);
				endif
				SleepMS(2);
			endforeach
		endif

		if (check < -10) // Falha Crítica
			DebugMsg(
				mobile,
				DEBUG_HAB,
				Message("[PICKPOCKET] outer critical failure (check=" + check + ")", Color(SYSTEM_COLOR::FAIL))
			);
			StealCriticalFailure(mobile, targ);
		endif
	endif
endprogram

/*
 * HandleStealableArtifact(mobile, artifact)
 * 
 * Lida com a tentativa de roubo de um artefato roubável
 * 
 * Parâmetros:
 *   mobile - Jogador tentando roubar
 *   artifact - Artefato a ser roubado
 * 
 * Retorno:
 *   1 se bem-sucedido, 0 caso contrário
 */
function HandleStealableArtifact(mobile, artifact)
	// Verifica distância
	if (Distance(mobile, artifact) > 2)
		Message("O artefato está muito longe.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif
	
	// Verifica cooldown global de tentativas (10 segundos)
	var cooldown := setCooldown(mobile, "StealableLastAttempt", 10);
	if (cooldown)
		Message("Você precisa esperar " + cooldown + " segundos antes de tentar roubar novamente.").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		return 0;
	endif
	
	// Pega a raridade do artefato
	// IMPORTANTE: A raridade está armazenada no SPAWNER, não no item!
	var spawner_serial := GetObjProperty(artifact, "StealableSpawnerSerial");
	var rarity := 1; // Default
	
	if (spawner_serial)
		var spawner := SystemFindObjectBySerial(spawner_serial);
		if (spawner)
			rarity := CInt(GetObjProperty(spawner, "Rarity"));
			if (!rarity)
				rarity := 1;
			endif
		endif
	else
		// Se não tem spawner, tenta pegar direto do artifact
		rarity := CInt(GetObjProperty(artifact, "StealableRarity"));
		if (!rarity)
			rarity := 1; // Default
		endif
	endif
	
	// Verifica se o jogador está bloqueado neste artefato específico
	var artifact_key := "StealableBlock_" + artifact.serial;
	var block_until := CInt(GetObjProperty(mobile, artifact_key));
	if (block_until && ReadGameClock() < block_until)
		Message("Você sente que deve esperar antes de tentar novamente.").SetColor(38).SendSys(mobile);
		return 0;
	endif
	
	// Calcula a dificuldade baseada na raridade e peso
	var difficulty := CalculateStealingDifficulty(rarity, artifact.weight);
	
	// Pega o valor da skill do jogador (sempre Pickpocketing)
	var player_skill := AP_GetSkill(mobile, PICKPOCKETING);
	
	// Verifica se o jogador tem skill suficiente
	if (difficulty > 1.5 * player_skill)
		var msg1 := Message("Suas mãos tremem ao tocar o artefato...");
		msg1.SetColor(Color(SYSTEM_COLOR::FAIL));
		msg1.SendSys(mobile);
		
		var msg2 := Message("Você não possui a habilidade necessária para tentar isso.");
		msg2.SetColor(Color(SYSTEM_COLOR::FAIL));
		msg2.SendSys(mobile);
		
		var msg3 := Message("Seria loucura tentar, você certamente será pego.");
		msg3.SetColor(Color(SYSTEM_COLOR::FAIL));
		msg3.SendSys(mobile);
		
		return 0;
	endif
	
	// Animação e som de tentativa de roubo a cada 5 segundos (total 15 segundos)
	var i;
	for (i := 1; i <= 3; i := i + 1)
		PrintTextAbove(mobile, "*Tenta roubar*");
		PerformAction(mobile, 0x0020); // ACTION_BOW
		PlaySoundEffect(mobile, 0x58); // SOUND_SCRUNCH
		Sleep(5); // 5 segundos entre cada tentativa
	endfor
	
	// Tenta roubar usando Pickpocketing
	var check := SkillCheck(mobile, PICKPOCKETING, difficulty);
	
	if (check > 0)
		// Sucesso! Mas verifica se há armadilha não desarmada
		var trap_list := GetObjProperty(artifact, "TrapList");
		
		if (trap_list != error && trap_list.size() > 0)
			// Verifica se a armadilha foi desarmada
			var trap_disarmed := GetObjProperty(artifact, "trapDesarmada");
			
			if (!trap_disarmed)
				// ARMADILHA NÃO FOI DESARMADA! Dispara ao roubar
				var trap_last_triggered := CInt(GetObjProperty(artifact, "TrapLastTriggered"));
				var time_since_trigger := ReadGameClock() - trap_last_triggered;
				
				if (!trap_last_triggered || time_since_trigger >= 21600)
					// Registra quando a armadilha foi ativada
					SetObjProperty(artifact, "TrapLastTriggered", ReadGameClock());
					
					// Executa as armadilhas usando o sistema existente
					RunTraps(artifact, mobile);
					
					Message("Você roubou o artefato, mas ativou uma armadilha!").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
					PrintTextAbove(mobile, "*Ativa uma armadilha ao roubar*");
				else
					var time_remaining := 21600 - time_since_trigger;
					var hours := CInt(time_remaining / 3600);
					Message("A armadilha está recarregando (" + hours + " horas).").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
				endif
				
				// Continua com o roubo mesmo após a armadilha
			endif
		endif
		
		// Limpa contadores de falha
		var fail_key := "StealableFails_" + artifact.serial;
		var attempts_key := "StealableAttempts_" + artifact.serial;
		EraseObjProperty(mobile, fail_key);
		EraseObjProperty(mobile, attempts_key);
		
		Message("Você conseguiu roubar " + artifact.desc + "!").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
		
		// Mensagem overhead visível para todos
		PrintTextAbove(mobile, "Você roubou um item sem ser pego, ele agora é seu.");
		
		// Pega o spawner
		var spawner := GetArtifactSpawner(artifact);
		
		if (spawner)
			// Define o próximo tempo de spawn baseado na raridade
			var respawn_time := GetRespawnTime(rarity);
			var next_spawn := ReadGameClock() + respawn_time;
			SetObjProperty(spawner, "NextSpawnTime", next_spawn);
			
			// Limpa o artefato atual do spawner
			EraseObjProperty(spawner, "CurrentArtifactSerial");
			
			// ATUALIZA AS ESTATÍSTICAS DE ROUBO NO DATAFILE
			IncrementStealCount(spawner);
		endif
		
		// Desfixa e move para o inventário
		artifact.movable := 1;
		EraseObjProperty(artifact, "PropStealable");
		EraseObjProperty(artifact, "StealableRarity");
		EraseObjProperty(artifact, "StealableSpawnerSerial");
		
		MoveItemToContainer(artifact, mobile.backpack);
		
		// Treina Pickpocketing
		SkillCheck(mobile, PICKPOCKETING, -1);
		
		// Log do roubo
		var region := GetRegionName(mobile);
		var coords := array{mobile.x, mobile.y};
		var nome := GetObjProperty(mobile, "nome_inicial");
		if (!nome)
			nome := mobile.name;
		endif
		
		LogToFile("stealables.log", "[" + polcore().systime + "] " + nome + " roubou " + 
				  artifact.desc + " (Raridade " + rarity + ") em " + region + " " + coords);
		
		return 1;
	else
		// Falha
		Message("Você falhou ao tentar roubar " + artifact.desc + ".").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
		
		// Treina Pickpocketing mesmo em falha (você aprende tentando!)
		SkillCheck(mobile, PICKPOCKETING, -1);
		
		// Incrementa contador de tentativas
		var attempts_key := "StealableAttempts_" + artifact.serial;
		var total_attempts := CInt(GetObjProperty(mobile, attempts_key)) + 1;
		SetObjProperty(mobile, attempts_key, total_attempts);
		
		// Feedback sutil sobre o progresso
		var fail_key := "StealableFails_" + artifact.serial;
		var current_critical_fails := CInt(GetObjProperty(mobile, fail_key));
		
		if (current_critical_fails > 0)
			Message("Você sente que o artefato está ficando mais difícil de manipular...").SetColor(2100).SendSys(mobile);
		endif
		
		// Reseta contador após 10 tentativas sem acumular 3 críticas
		if (total_attempts > 10)
			EraseObjProperty(mobile, "StealableFails_" + artifact.serial);
			SetObjProperty(mobile, attempts_key, 1);
			total_attempts := 1;
			Message("Você sente que pode tentar novamente com mais cuidado.").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
		endif
		
		// Falha crítica
		if (check < -25)
			Message("Suas mãos escorregam desajeitadamente no artefato!").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
			PrintTextAbove(mobile, "*Movimento brusco*");
			
			// Verifica se tem armadilha configurada
			var trap_list := GetObjProperty(artifact, "TrapList");
			
			if (trap_list != error && trap_list.size() > 0)
				// Verifica se a armadilha já disparou recentemente (6 horas = 21600 segundos)
				var trap_last_triggered := CInt(GetObjProperty(artifact, "TrapLastTriggered"));
				var time_since_trigger := ReadGameClock() - trap_last_triggered;
				
				if (!trap_last_triggered || time_since_trigger >= 21600)
					// Registra quando a armadilha foi ativada
					SetObjProperty(artifact, "TrapLastTriggered", ReadGameClock());
					
					// Executa as armadilhas usando o sistema existente
					RunTraps(artifact, mobile);
					
					Message("Você ativou uma armadilha!").SetColor(Color(SYSTEM_COLOR::FAIL)).SendSys(mobile);
				else
					var time_remaining := 21600 - time_since_trigger;
					var hours := CInt(time_remaining / 3600);
					Message("A armadilha ainda está recarregando (" + hours + " horas restantes).").SetColor(Color(SYSTEM_COLOR::INFO)).SendSys(mobile);
				endif
			endif
			
			// Cooldown adicional de 60 segundos em falha crítica
			SetObjProperty(mobile, "#StealableLastAttempt", ReadGameClock() + 60);
			
			// Incrementa contador de falhas críticas
			var fail_key := "StealableFails_" + artifact.serial;
			var critical_fails := CInt(GetObjProperty(mobile, fail_key)) + 1;
			SetObjProperty(mobile, fail_key, critical_fails);
			
			// Feedback sobre falhas críticas
			if (critical_fails == 1)
				Message("O artefato parece ter notado sua presença...").SetColor(38).SendSys(mobile);
				Message("Você sente que não deveria falhar assim novamente.").SetColor(38).SendSys(mobile);
			elseif (critical_fails == 2)
				Message("O artefato parece resistir ativamente às suas tentativas!").SetColor(53).SendSys(mobile);
				Message("Um erro a mais e você não poderá mais tocá-lo...").SetColor(53).SendSys(mobile);
			endif
			
			// Verifica se atingiu 3 falhas críticas dentro de 10 tentativas
			if (critical_fails >= 3 && total_attempts <= 10)
				// Bloqueia o jogador deste artefato por 24 horas (86400 segundos)
				var block_key := "StealableBlock_" + artifact.serial;
				var block_time := ReadGameClock() + 86400; // 24 horas
				SetObjProperty(mobile, block_key, block_time);
				
				Message("Talvez amanhã suas energias se alinhem novamente.").SetColor(33).SendSys(mobile);
				PrintTextAbove(mobile, "*Repelido pelo artefato*");
				
				// Limpa contadores
				EraseObjProperty(mobile, fail_key);
				EraseObjProperty(mobile, attempts_key);
				
				// Log do bloqueio
				var nome := GetObjProperty(mobile, "nome_inicial");
				if (!nome)
					nome := mobile.name;
				endif
				LogToFile("stealables.log", "[" + polcore().systime + "] " + nome + 
						  " foi bloqueado do artefato " + artifact.desc + " (Serial: " + artifact.serial + ") por 24 horas");
			endif
		endif
		
		return 0;
	endif
endfunction

