use uo;
use cfgfile;
use os;
use util;
use datafile;
use vitals;
use attributes;

include "include/client";
include ":attributes:attributes";
include ":gumps:gumps_ex";
include ":gumps:gumps";
include "include/say";
include ":tn:cooldown";
include ":charactercreation:habilidades";
include ":blood:blood";
include ":gumps:yesNo";
include ":gumps:selectionGump";
include ":medicine:anatomy";
