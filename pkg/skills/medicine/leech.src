use uo;
use os;

include "include/client";
include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":charactercreation:habilidades";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include ":gumps:yesNo";
include ":charactercreation:resists";

program UseLeech(who, leech)
var primarias := GetPrimarias(who);
	if ("Medicine" in primarias || who.cmdlevel > 2)
	else
		SendSysMessage(who, "Você não tem conhecimento o bastante para tratar com sangria!");
		return 0;
	endif

	SendSysMessage(who, "Em quem você deseja usar isto?");
	var targ := target(who);

	if (!targ.acctname)
		SendSysMessage(who, "Cancelado");
		return;
	elseif (Distance(who, targ) > 2)
		SendSysMessage(who, targ.name + " está muito distante.");
		return;
	endif

	// verifica menor vício
	var v_str := AP_GetVital(targ, "Viciostr");
	var v_dex := AP_GetVital(targ, "Viciodex");
	var v_int := AP_GetVital(targ, "Vicioint");

	var menor := v_str;
	if (v_dex < menor) menor := v_dex; endif
	if (v_int < menor) menor := v_int; endif

	var skill_needed := 50;
	var leech_cost := 1;

	// ABSTINÊNCIA
	if (menor < 40)

		var confirm := YesNo(
			who,
			targ.name + " apresenta sinais de abstinência.\n\n" +
			"Será necessário um tratamento intensivo.\n" +
			"Isto consumirá 5 sanguessugas.\n\n" +
			"Deseja continuar?",
			"Continuar",
			"Cancelar"
		);

		if (!confirm)
			SendSysMessage(who, "Tratamento cancelado.");
			return;
		endif

		skill_needed := 60;
		leech_cost := 5;

	endif

	// TRAVA
	var leeching := GetObjProperty(targ, "leeching");
	if (leeching != error && ReadGameClock() < leeching)
		SendSysMessage(who, targ.name + " já está sob efeito de uma sanguessuga.");
		return;
	endif

	if (leech.amount < leech_cost)
		SendSysMessage(who, "Voce não possui sanguessugas suficientes.");
		return;
	endif

	var bleedDuration := 0;

	if (SkillCheck(who, MEDICINE, skill_needed) > 0)

		SendSysMessage(who, "Você aplicou a sangria em " + targ.name);

		bleedDuration := 3; // sucesso

		var heal_skill := AP_GetSkill(who, MEDICINE);
		var heal_amt := GetHealingAmt(heal_skill);

		if (temHabilidade(who, "Curandeiro Experiente"))
			heal_amt := heal_amt * 2;
		endif

		var i;
		var q := 20 - Floor(heal_skill / 10);
		var resto := heal_amt / q - CInt(heal_amt / q);
		var r := 0;

		SetObjProperty(targ, "leeching", ReadGameClock() + q);

		for (i := 0; i < q; i := i + 1)

			Sleep(1);

			if (Distance(who, targ) > 2)
				SendSysMessage(who, "Tratamento interrompido.");
				EraseObjProperty(targ, "leeching");
				return;
			endif

			HealVicio(targ, "Viciostr", CInt(heal_amt / q));
			HealVicio(targ, "Viciodex", CInt(heal_amt / q));
			HealVicio(targ, "Vicioint", CInt(heal_amt / q));

			r := r + resto;
			if (r > 1)
				HealVicio(targ, "Viciostr", 1);
				HealVicio(targ, "Viciodex", 1);
				HealVicio(targ, "Vicioint", 1);
				r := r - 1;
			endif

			RecalcVitals(targ);

		endfor

		EraseObjProperty(targ, "leeching");

		SendSysMessageEx(targ, "A sangria terminou com sucesso.", SSM_INFO);

	else
		SendSysMessageEx(who, "Você falhou ao aplicar a sanguessuga.", SSM_FAIL);

		var dif := (menor < 40 ? 15 : 10);
		var resist := CheckResist(targ, WILL, dif);

		if (resist == -1)

			bleedDuration := 10; // falha crítica

			SendSysMessageEx(targ, "Seu corpo reage violentamente ao tratamento mal executado, agravando seu vício!", SSM_FAIL);

			var v_str2 := AP_GetVital(targ, "Viciostr");
			var v_dex2 := AP_GetVital(targ, "Viciodex");
			var v_int2 := AP_GetVital(targ, "Vicioint");

			var vital_pior := "Viciostr";
			var menor2 := v_str2;

			if (v_dex2 < menor2)
				menor2 := v_dex2;
				vital_pior := "Viciodex";
			endif

			if (v_int2 < menor2)
				menor2 := v_int2;
				vital_pior := "Vicioint";
			endif

			// 🔥 AGORA CORRETO: piora o vício
			HealVicio(targ, vital_pior, -5);

		else

			bleedDuration := 6; // falha normal

			if (resist == 0)
				SendSysMessage(targ, "Seu corpo resiste com dificuldade à má aplicação da sangria.");
			else
				SendSysMessage(targ, "Você resistiu aos efeitos negativos da sangria mal sucedida.");
			endif

		endif
	endif

	TS_StartTimer(targ, "bleed", bleedDuration);

	SendSysMessage(who, "A sanguessuga morreu");
	SubtractAmount(leech, leech_cost);

endprogram

function GetHealingAmt(heal_skill)
	var amt := Ceil(heal_skill);
	return amt;
endfunction