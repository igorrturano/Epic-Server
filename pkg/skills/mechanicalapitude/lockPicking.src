use uo;
use os;
use cfgfile;
use util;

include "include/objtype";
include ":itemutils:canAccess";
include ":attributes:attributeConstants";
include ":attributes:skills";
include ":attributes:attributes";
include "include/say";
include ":charactercreation:habilidades";
include ":mechanicalapitude:lockpick_minigame";
include ":keys:key";
include ":traps:include/traps";
include "include/string";
include "include/noiseAlert";
include ":merchants:citizen/include/citizenWitness";
include ":wrappers:Objects/Model/MobileWrapper";
include ":chestspawn:include/trancaEspecial";

program skill_lockpicking(me, lockpick)
	EraseObjProperty(me, "IsMeditating");
	EraseObjProperty(me, "HealTimer");
	var sucesso := 0;
	var mobWrapper := MobileWrapper(me);

	// Primeira verificação de mãos livres
	if (mobWrapper.IsMounted())
		SendSysMessageEx(me, "Voce nao pode fazer isto montado.", SSM_FAIL);
		return 0;
	endif

	if (!mobWrapper.HasBothHandsFree())
		SendSysMessageEx(me, "Voce precisa ter as duas maos livres para manusear a gazua.", SSM_FAIL);
		return 0;
	endif

	if (!can_access(me, lockpick))
		return 0;
	endif

	if (lockpick.movable == 0)
		SendSysMessageEx(me, "Voce nao pode usar isto.", SSM_FAIL);
		return 0;
	endif

	if (!ReserveItem(lockpick))
		return 0;
	endif

	if (GetObjProperty(me, "escondido"))
		me.hidden := 1;
		SetObjProperty(me, "escondido", 0);
	endif

	SendSysMessageEx(me, "O que voce deseja fazer com isto?", SSM_REQUEST);
	var chest := Target(me);
	if (!chest)
		SendSysMessageEx(me, "Cancelado.", SSM_FAIL);
		return 0;
	endif

	if ((!Accessible(me, chest)) || (!Accessible(me, lockpick)))
		SendSysMessageEx(me, "Voce nao alcanca o alvo!", SSM_FAIL);
		return 0;
	endif

	if (Distance(me, chest) > 2)
		SendSysMessageEx(me, "Voce esta muito distante.", SSM_FAIL);
		return 0;
	endif

	if (GetObjProperty(chest, "level") || GetObjProperty(chest, "levelPlayerLock"))
		if (mobWrapper.IsMounted())
			SendSysMessageEx(me, "Voce nao pode fazer isto montado.", SSM_FAIL);
			return 0;
		endif

		if (!mobWrapper.HasBothHandsFree())
			SendSysMessageEx(me, "Voce precisa estar com as maos livres.", SSM_FAIL);
			return 0;
		endif

		if (valorInicial(me, AWARENESS) >= 40)
			if (me.hidden)
				SendSysMessageEx(me, "Tenta arrombar a fechadura. [silencioso]", SSM_INFO);
			else
				PrintTextAbove(me, "*Tenta arrombar a fechadura [silencioso]*");
			endif
		else
			PrintTextAbove(me, "*Tenta arrombar a fechadura [barulhento]*");
			me.hidden := 0;
			PlaySoundEffect(chest, 0x242);
			EmitNoise(me);
		endif

		// Verifica mãos livres durante o processo
		for i := 1 to 5
			if (!mobWrapper.HasBothHandsFree())
				SendSysMessageEx(me, "Voce nao pode usar sua gazua com as maos ocupadas.", SSM_FAIL);
				return 0;
			endif
			Sleep(1);
		endfor

		sucesso := PickTreasureChest(me, lockpick, chest);
	else
		SendSysMessageEx(me, "Esse nao e um alvo valido.", SSM_FAIL);
	endif

	ReleaseItem(lockpick);
	return sucesso;
endprogram

function PickTreasureChest(me, lockpick, chest)
	var lvl := CInt(GetObjProperty(chest, "level"));

	if (GetObjProperty(chest, "isMimic"))
		UseItem(chest, me);
		SendSysMessageEx(me, "Esse baú é um mímico!", SSM_FAIL);
		return 0;
	endif

	if (!chest.locked)
		SendSysMessageEx(me, "O alvo nao parece estar tracado.", SSM_INFO);
		return 0;
	endif

	if (GetObjProperty(chest, "fechadura_quebrada") == 1)
		SendSysMessageEx(me, "A fechadura está quebrada!", SSM_FAIL);
		return 0;
	endif

	var learned := GetObjProperty(chest, "lockLearnedBy");
	var grantsSkill := !(me.serial in learned);
	if (!grantsSkill)
		SendSysMessageEx(me, "Você já aprendeu como destrancar essa fechadura.", SSM_INFO);
	endif

	if (valorInicial(me, AWARENESS) >= 40)
		if (me.hidden)
			SendSysMessageEx(me, "*Arrombando a fechadura. [silencioso]*", SSM_INFO);
		else
			PrintTextAbove(me, "*Arrombando a fechadura. [silencioso]*");
		endif
	else
		PrintTextAbove(me, "*Arrombando a fechadura. [barulhento]*");
		me.hidden := 0;
		PlaySoundEffect(chest, 0x0242);
		EmitNoise(me);
	endif

	Sleep(1);

	var playerLock := Cint(GetObjProperty(chest, "levelPlayerLock"));
	var diff;

	if (!playerLock)
		case (lvl)
			1: diff := 15;
			2: diff := 40;
			3: diff := 60;
			4: diff := 86;
			5: diff := 90;
			6: diff := 110;
			default: diff := 40;
		endcase
	else
		diff := playerLock;
	endif

	var diffmod := Cint(GetObjProperty(me, "conhecimentosobrefechaduras")) * 5;
	diff := diff - diffmod;
	if (diff <= 0)
		diff := 5;
	endif

	// Minigame sorteado no momento de criação do baú
	if (GetObjProperty(chest, "minigame_lock"))
		if (IsTrancaEspecial(chest))
			TrancaDebug("=== LOCKPICKING DETECTOU minigame_lock ===");
			TrancaDebug("Player: " + me.name + " | Chest: " + Hex(chest.objtype) + " serial=" + chest.serial);
			TrancaDebug("Skill MECHANICS efetiva: " + AP_GetSkill(me, MECHANICS) + " | True: " + AP_GetTrueSkill(me, "MECHANICS"));
			TrancaDebug("Diff: " + diff + " | Level chest: " + GetObjProperty(chest, "level") + " | Conhecimento mod: " + diffmod, me);
		endif
		SendSysMessageEx(me, "Esta fechadura é diferente... Algo a torna mais difícil de abrir.", SSM_INFO);
		if (mini_game(me, diff, AP_GetSkill(me, MECHANICS), chest))
			if (IsTrancaEspecial(chest))
				TrancaDebug("=== SUCESSO! Chest destrancado ===");
			endif
			EraseObjProperty(chest, "minigame_lock");
			_UnlockChest(me, chest, grantsSkill);
			return 1;
		else
			if (IsTrancaEspecial(chest))
				TrancaDebug("=== FALHA! Chest não foi destrancado ===");
			endif
			_MarkChestFailed(me, chest);
			return 0;
		endif
	endif

	var check := SkillCheck(me, MECHANICS, diff, 0, grantsSkill ? ADV_SKILL : ADV_DISABLE);
	var mec_skill := AP_GetSkill(me, MECHANICS);
	var magic_chest := (GetObjProperty(chest, "level") == 6);
	var mobWrapper := MobileWrapper(me);
	var hab1_mchest := mobWrapper.HasAbility(ABILITY_ID::SENSIBILIDADE_ARCANA);
	var hab2_mchest := mobWrapper.HasAbility(ABILITY_ID::DESBRAVADOR_NATO);

	if (hab1_mchest || hab2_mchest)
		if (magic_chest || (diff > mec_skill + 15 && diff < mec_skill + 40))
			if (mini_game(me, diff, mec_skill, chest))
				if (chest.isDoor())
					_UnlockChest(me, chest, grantsSkill);
				else
					set_critical(1);
					SetObjProperty(chest, "arrombado", "" + me.name);
					SetObjProperty(chest, "locktime", ReadGameClock());
					chest.locked := 0;
					set_critical(0);
					PrintTextAbove(me, "*" + me.name + " disparou a armadilha*");
					SendSysMessageEx(me, "Você forçou a abertura disparando a armadilha!", SSM_FAIL);
					RunTraps(chest, me);
					SendViewContainer(me, chest);
					NotifyCitizenWitnesses(me, "lockpick", struct);
					if (grantsSkill)
						var skill := AP_GetTrueSkill(me, "MECHANICS");
						AP_SetTrueSkill(me, "MECHANICS", skill + 0.1);
						_RecordLockLearned(me, chest);
					endif
				endif
				return 1;
			else
				SendSysMessageEx(me, "Voce falhou!", SSM_FAIL);
				_MarkChestFailed(me, chest);
				return;
			endif
		endif
	endif

	if (magic_chest && !hab1_mchest && !hab2_mchest)
		SendSysMessageEx(me, "Você não sabe lidar com fechaduras mágicas!", SSM_FAIL);
	endif

	if (check > 0)
		if (valorInicial(me, AWARENESS) >= 40)
			SendSysMessageEx(me, "*Destrancou [silencioso]*", SSM_INFO);
			PrintTextPrivate(chest, "*$*", me);
		else
			PrintTextAbove(me, "*Destrancou [barulhento]*");
			me.hidden := 0;
			PlaySoundEffect(chest, 0x200);
			SendSysMessageEx(me, "*Destrancou [barulhento]*", SSM_INFO);
			EmitNoise(me);
		endif

		set_critical(1);
		SetObjProperty(chest, "arrombado", "" + me.name);
		// Check if it's a dungeon door with relock time
		if (chest.isDoor())
			KP_SetDungeonDoorRelockTimer(chest);
		else
			SetObjProperty(chest, "locktime", ReadGameClock());
		endif
		chest.locked := 0;
		set_critical(0);
		NotifyCitizenWitnesses(me, "lockpick", struct);
		if (grantsSkill)
			_RecordLockLearned(me, chest);
		endif
		return 1;
	else
		if (me.hidden)
			me.hidden := 0;
		endif

		PlaySoundEffect(chest, 0x122);
		PrintTextAbove(me, "*Falhou em arrombar*");
		Sleepms(500);

		if (!temHabilidade(me, "Especialista em Invasoes") && check < -20)
			PlaySoundEffect(chest, 0x040);
			SendSysMessageEx(me, "Sua gazua quebrou!", SSM_FAIL);
			SubtractAmount(lockpick, 1);
		endif
		return 0;
	endif

endfunction

function _UnlockChest(me, chest, grantsSkill)
	set_critical(1);
	SetObjProperty(chest, "arrombado", "" + me.name);
	if (chest.isDoor())
		PrintTextAbove(me, "*Destrancou " + chest.desc + "*");
		KP_SetDungeonDoorRelockTimer(chest);
		PlaySoundEffect(chest, 0x0200);
		PlayObjectCenteredEffect(chest, 0x3763, 1, 16);
	else
		SetObjProperty(chest, "locktime", ReadGameClock());
		SendViewContainer(me, chest);
	endif
	chest.locked := 0;
	set_critical(0);
	NotifyCitizenWitnesses(me, "lockpick", struct);
	if (grantsSkill)
		var skill := AP_GetTrueSkill(me, "MECHANICS");
		AP_SetTrueSkill(me, "MECHANICS", skill + 0.1);
		_RecordLockLearned(me, chest);
	endif
endfunction

function _MarkChestFailed(me, chest)
	SetObjProperty(chest, "arrombado", "" + me.name);
	if (chest.isDoor())
		KP_SetDungeonDoorRelockTimer(chest);
	else
		SetObjProperty(chest, "locktime", ReadGameClock());
	endif
endfunction

function _RecordLockLearned(me, chest)
	var learned := GetObjProperty(chest, "lockLearnedBy");
	if (learned == error)
		learned := array;
	endif
	if (!(me.serial in learned))
		learned.append(me.serial);
		SetObjProperty(chest, "lockLearnedBy", learned);
	endif
endfunction
