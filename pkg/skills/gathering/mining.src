
use uo;
use cfgfile;
include ":gathering:mining";
include ":gathering:mineralcorpse";
include ":attributes:attributes";
include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":charactercreation:habilidades";
include ":wrappers:Objects/Model/MobileWrapper";
include ":abilities:models/Ability";
include "include/say";

program mining(who)

	SendSysMessageEx(who, "Aponte para um golem (vivo ou cadáver) para analisar, ou cancele para selecionar o minério da região.", SSM_REQUEST);
	var entity := Target(who);

	if (entity)
		var golem_tmpl := GetGolemTemplateFromMob(entity);
		if (golem_tmpl != error)
			return ShowGolemInfoGump(who, golem_tmpl, 0);
		endif
		if (IsMineableCorpse(entity))
			return ShowGolemInfoGump(who, GetCorpseMineavelTemplate(entity), entity);
		endif
	endif

	ShowRegionOreGump(who);

endprogram

function ShowGolemInfoGump(who, template, corpse)
	var info := GetMineavelInfo(template);
	if (info == error)
		return;
	endif

	var ore_name := info.ore_nome;
	var qty_str := CStr(CInt(info.qty_min)) + "–" + CStr(CInt(info.qty_max));

	var status_str;
	if (corpse)
		status_str := "Swings restantes: " + CStr(GetCorpseMineavelSwings(corpse)) + "/" + CStr(MINERAL_CORPSE_MAX_SWINGS);
	else
		status_str := "Ao morrer: " + CStr(MINERAL_CORPSE_MAX_SWINGS) + " swings disponíveis";
	endif

	var gump := GFCreateGump();
	GFDisposable(gump, 0);
	GFResizePic(gump, 0, 25, 3600, 280, 220);
	GFResizePic(gump, 15, 40, 0x13BE, 250, 165);
	GFTextMid(gump, 20, 50, 270, 1153, "Análise do Golem");

	GFTextLine(gump, 35, 80,  1153, info.nome);
	GFTextLine(gump, 35, 100, 1153, "Minério: " + ore_name);
	GFTextLine(gump, 35, 120, 1153, "Dificuldade: " + CStr(CInt(info.dif)));
	GFTextLine(gump, 35, 140, 1153, "Quantidade por swing: " + qty_str);
	GFTextLine(gump, 35, 160, 1153, status_str);

	GFSendGump(who, gump);
endfunction

function ShowRegionOreGump(who)
	var where := GetMiningRegion(who.x, who.y, who.realm);

	var df := opendatafile(":gathering:miningspots");
	if (df == error)
		df := createdatafile(":gathering:miningspots");
	endif

	var elem := df.FindElement(where);
	var ores := elem.GetProp("Ores");
	var raridades := SplitWords(elem.GetProp("Rarity"));

	var possiveis := {};
	var raridade := {};
	ores := SplitWords(ores);
	var i := 1;
	var k := 1;

	var skill := EffectiveSkill(who, "Mining");

	foreach thing in ores
		var dif := DetermineMiningDifficulty(GetResourceId(thing));
		if (MobileWrapper(who).HasAbility(ABILITY_ID::PROSPECTOR))
			dif := dif - 5;
		endif
		if ((skill + 10) >= dif)
			possiveis[i] := thing;
			raridade[i] := raridades[k];
			i := i + 1;
		endif
		k := k + 1;
	endforeach

	var gump := GFCreateGump();
	GFDisposable(gump, 0);
	GFResizePic(gump, 0, 25, 3600, 250, 330);
	GFResizePic(gump, 15, 40, 0x13BE, 220, 300);
	GFTextMid(gump, 20, 50, 250, 1153, "Minerios Disponiveis");

	var y := 80;
	i := 1;
	foreach x in possiveis
		GFTextLine(gump, 35, y, 1153, GetOreNameById(x));
		GFTextLine(gump, 120, y, 1153, GetOreRarityDesc(cint(raridade[i])));
		GFAddButton(gump, 20, y + 2, 2117, 2118, 1, 400 + i);
		i := i + 1;
		y := y + 20;
	endforeach

	var input := GFSendGump(who, gump);
	input := input[0];

	if (input > 400)
		SendsysMessage(who, "Voce vai procurar por " + GetOreNameById(possiveis[input - 400]));
		SetObjProperty(who, "searchore", possiveis[input - 400]);
	endif
endfunction
