use uo;
use os;
use cfgfile;

include "include/say";
include ":alchemy:alchemy";

program explosion_timer(parms)
	var potion := parms[1];
	var who := parms[2];
	Set_Priority(5);

	var mods := GetObjProperty(who, "ExplosivoConfig");
	var seconds := 3;
	if (mods != ERROR)
		case (mods.gatilho)
			GATILHO_PAVIO_CURTO:  seconds := 2;
			GATILHO_PAVIO_NORMAL: seconds := 3;
			GATILHO_PAVIO_LONGO:  seconds := 5;
			default:              seconds := 3;
		endcase
	endif

	while (seconds > 0)
		if (potion.container)
			PrintTextAbove(who, CStr(seconds));
		else
			PrintTextAbove(potion, CStr(seconds));
		endif
		sleep(1);
		seconds := seconds - 1;
	endwhile

	if (potion in EnumerateItemsInContainer(who.backpack))
		MoveObjectToLocation(potion, who.x, who.y, who.z, who.realm, MOVEOBJECT_FORCELOCATION);
	endif
	start_script("potions/exploder", { potion, who });
endprogram
