use uo;
use os;
use cfgfile;

include "include/say";

program explosion_timer(parms)
	var potion := parms[1];
	var who := parms[2];
	Set_Priority(5);
	if (potion.container)
		PrintText(who, "3");
	else
		PrintText(potion, "3");
	endif
	sleep(1);
	if (potion.container)
		PrintText(who, "2");
	else
		PrintText(potion, "2");
	endif
	sleep(1);
	if (potion.container)
		PrintText(who, "1");
	else
		PrintText(potion, "1");
	endif
	sleep(1);
	if (potion in EnumerateItemsInContainer(who.backpack))
		MoveObjectToLocation(potion, who.x, who.y, who.z, who.realm, MOVEOBJECT_FORCELOCATION);
	endif
	start_script("potions/exploder", { potion, who });
endprogram
