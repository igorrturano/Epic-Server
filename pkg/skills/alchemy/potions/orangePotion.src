use os;
use uo;
use util;
use cfgfile;
include ":alchemy:alchemy";
include ":timedScripts:timedScripts";
include ":timedScripts:poisonUtil";

program drink_orange(who, potion)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");
	if (!Accessible(who, potion))
		return;
	endif
	if (potion.movable == 0)
		SendSysMessage(who, "Voce nao pode beber isto.");
		return;
	endif
	if (!checkifcandrink(who, "orange"))
		return;
	endif
	var tier := peganivelpocao(who, potion);
	var potion_strength := 1;
	var time := 120;
	case (tier)
		1: potion_strength := 2; time := 120;
		2: potion_strength := 3; time := 240;
		3: potion_strength := 4; time := 480;
		4: potion_strength := 5; time := 960;
	endcase
	

	var bonus := cint(getobjproperty(potion, "bonus") / 5);
	TS_CurePoison(who, time + bonus, "P", potion_strength);
	empty_bottle(who, potion); 

endprogram
