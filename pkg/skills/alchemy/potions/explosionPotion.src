use uo;
use os;
use util;
use cfgfile;

include "include/say";
include ":timedScripts:timedScripts";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":attributes:attributes";
include ":mounts:mounts";
include ":alchemy:alchemy";

program use_explosion(who, potion)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");
	var mods := GetObjProperty(who, "ExplosivoConfig");
	if (!Accessible(who, potion))
		return;
	endif
	if (potion.movable == 0)
		SendSysMessage(who, "Voce nao pode usar isto.");
		return;
	endif
	if (!Accessible(who, potion))
		SendSysMessage(who, "Voce nao pode pegar isto!");
		return;
	endif
	who.hidden := 0;
	SendSysMessage(who, "Escolha o alvo ");
	if (potion.amount > 1)
		var objtype := GetObjType(potion);
		var props := getobjpropertynames(potion);
		var pot := CreateItemInBackpack(who, objtype, 1);
		foreach key in props
			var prop_value := getobjproperty(potion, key);
			SetObjProperty(pot, key, prop_value);
		endforeach
		subtractamount(potion, 1);
		potion := pot;
	endif

	if(mods.gatilho == GATILHO_PAVIO || mods.gatilho == GATILHO_PAVIO_CURTO || mods.gatilho == GATILHO_PAVIO_NORMAL || mods.gatilho == GATILHO_PAVIO_LONGO || mods == ERROR)
		if (!Cint(GetObjProperty(potion, "#bomb")))
			var parms := {};
			parms[1] := potion;
			parms[2] := who;
			var t := start_script("potions/explosionTimer", parms);
			SetObjProperty(potion, "#bomb", 1);
		endif
	endif

	if (GetEquipmentByLayer(who, LAYER_MOUNT))
		var chance := GetAttribute(who, "Dexterity");

		if (chance <= 20)
			chance := 20;
		endif

		if (RandomInt(100) > chance)
			SendSysMessageEx(who, "Voce falhou em um teste de reflexos e caiu do cavalo", SSM_FAIL);
			PrintTextAbove(who, "*Perde o equilibrio e cai vergonhosamente*");
			DealDamage(who, RandomDiceRoll("4d10"), DAMAGE_TYPE::BLUNT, who);
			TS_StartTimer(who, "paralysis", 8);
			TS_StartTimer(who, "desmontar", 10);
			MoveObjectToLocation(potion, who.x, who.y, who.z, who.realm, MOVEOBJECT_FORCELOCATION);
			return 1;
		endif
	endif
	var cast_on := 0;
	if(mods.gatilho == GATILHO_MINA)
		detach();
		PrintTextAbove(who, "*Plantando mina*");
		Sleep(2);
		MoveObjectToLocation(potion, who.x, who.y, who.z, who.realm, MOVEOBJECT_FORCELOCATION);
		Minaterrestre(who, potion);
	else
		repeat
			cast_on := TargetCoordinates(who);
			if (who.npctemplate)
				cast_on := GetRandomNearbyHostile(who);
			endif

			if (!cast_on)
				return;
			endif


			if (!potion)
				return;
			endif

			if (!CheckLosAt(who, cast_on.x, cast_on.y, cast_on.z))
				SendSysMessage(who, "Voce nao consegue ver o alvo!");
				cast_on := 0;
			endif

		until(cast_on != 0 || !potion);

		if (!potion)
			return;
		endif
	
		PrintTextAbove(who, "*joga um frasco*");
		Detach();
		PlayMovingEffectXYZ(who.x, who.y, who.z + 15, cast_on.x, cast_on.y, cast_on.z, 0x0f09, 8, 0, 0);

		if (!potion)
			return;
		endif
		MoveObjectToLocation(potion, cast_on.x, cast_on.y, cast_on.z, cast_on.realm, MOVEOBJECT_FORCELOCATION);
	endif
		
	if(mods.gatilho == GATILHO_IMPACTO)
		Sleepms(400);
		start_script("potions/exploder", { potion, who });
	endif

endprogram

function Minaterrestre(who, potion)
	var df := OpenDataFile(":tn:traps");
	if (!df)
		df := CreateDataFile(":tn:traps", DF_KEYTYPE_INTEGER);
	endif

	var elem := df.FindElement(potion.serial);
	if (!elem)
		elem := df.CreateElement(potion.serial);
	endif

	var lvl := CInt(AP_GetSkill(who, SCIENCE) / 10);
	lvl := lvl / 2;
	var mods := GetObjProperty(who, "ExplosivoConfig");
	var habs := GetObjProperty(who, "myhabs");

	SetObjProperty(potion, "level", lvl);
	SetObjProperty(potion, "pottrap", 1);
	SetObjProperty(potion, "ExplosivoConfig", mods);
	SetObjProperty(potion, "myhabs", habs);

	potion.invisible := 1;
	potion.movable := 0;

	while (1)
		sleep(3600);

		if (!potion.invisible)
			potion.invisible := 1;
		endif

		if (GetObjProperty(potion, "trap_inativa"))
			EraseObjProperty(potion, "trap_inativa");
			DestroyITem(potion);
		endif

	endwhile

endfunction