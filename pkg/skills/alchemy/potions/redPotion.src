use os;
use uo;
use util;
use cfgfile;
include ":alchemy:alchemy";
include ":attributes:attributes";
include ":timedScripts:timedScripts";
include "include/say";

program drink_blue(who, potion)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");
	if (!Accessible(who, potion))
		return;
	endif
	if (potion.movable == 0)
		SendSysMessageEx(who, "Voce nao pode beber isto.", SSM_FAIL);
		return;
	endif
	if (!hasFreeHandToDrink(who))
		return;
	endif
	if (cint(GetObjProperty(who, "#staminapotion")))
		SendSysMessageEx(who, "Voce ja esta sob efeito de uma pocao igual.", SSM_FAIL);
		return;
	endif

	if (TS_GetCooldown(who, "staminapot") != error)
		SendSysMessageEx(who, "Voce nao pode usar essa pocao agora.", SSM_FAIL);
		return 1;
	endif

	var vicio := (AP_getvital(who, "Viciodex"));
	if (vicio < 30)
		vicio := 30;
	endif
	vicio := vicio / 100;
	var healed := 0;
	var delay := 1000;
	var cd := 10;
	healed := AP_GetVitalMaximumValue(who, STAMINA);
	var tier := peganivelpocao(who, potion);
	var skill := cint(GetObjProperty(potion, "bonus"));
	case (tier)
		1:	healed := cint(healed * 0.3 * vicio); delay := 600; cd := cint(healed * 0.6 * 3); skill := Cint(skill/3);
		2:	healed := cint(healed * 0.5 * vicio); delay := 450; cd := cint(healed * 0.45 * 3); skill := Cint(skill/2);
		3:  healed := cint(healed * 0.7 * vicio); delay := 300; cd := cint(healed * 0.3 * 3);
		4:  healed := cint(healed * 1 * vicio); delay := 150; cd := cint(healed * 0.15 * 3); skill := Cint(skill*1.5);
	endcase
	Aplicavicio(who, potion, DEXTERITY);
	empty_bottle(who, potion); 
	TS_StartCooldown(who, "staminapot", cd + 1);
	HealStamina(who, skill);

	Detach();
	var i := 0;
	SetObjProperty(who, "#staminapotion", 1);
	while (i < healed)
		HealStamina(who, 1);
		i := i + 1;
		sleepms(delay);
	endwhile
	EraseObjProperty(who, "#staminapotion");
	SendSysMessageEx(who, "Terminou o efeito da pocao.", SSM_INFO);
	
endprogram
