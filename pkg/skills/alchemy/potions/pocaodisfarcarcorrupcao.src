use os;
use uo;
use util;
use cfgfile;
include ":alchemy:alchemy";
include "include/say";
include ":timedScripts:timedScripts";
include ":message:include/model/Message";
include "include/tileEffects";

program drink_potion (who, potion)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");

	if(!Accessible(who, potion))
		return;
	endif

	if(potion.movable == 0)
		Message("Voce nao pode beber isto.")
			.SetColor(SYSTEM_COLOR::FAIL)
			.SendSys(who);
		return;
	endif

	if (!hasFreeHandToDrink(who))
		return;
	endif

	// Check if already has the effect active
	if (GetCooldown(who, "necrotic"))
		Message("Você já está disfarçando sua corrupção.")
			.SetColor(SYSTEM_COLOR::FAIL)
			.SendSys(who);
		return 0;
	endif

	var tier := peganivelpocao(who, potion);
	if (!tier)
		tier := 1;
	endif

	var duration := 300 * tier * 6;

	// Apply the necrotic disguise cooldown (same as checked in detect corruption spell)
	SetCooldown(who, "necrotic", duration);

	Message("Sombras envolvem sua alma, obscurecendo sua verdadeira natureza...")
		.SetColor(SYSTEM_COLOR::SUCCESS)
		.SendSys(who);
	Message("Sua corrupção está disfarçada por {} minutos!".format(CInt(duration/60)))
		.SetColor(SYSTEM_COLOR::SUCCESS)
		.SendSys(who);

	// Visual and sound effects
	PlayObjectCenteredEffect(who, FX_POISON_DEATH, 0, 10);
	PlaySoundEffect(who, 0x483);

	empty_bottle(who, potion);

	return 1;
endprogram
