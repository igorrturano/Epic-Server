use os;
use uo;
use util;
use cfgfile;

include ":alchemy:alchemy";
include ":spells:spell_logic/swordmage/include/encantarObjeto";
include ":wrappers:Objects/Model/MobileWrapper";

program drink_blue(who, potion)
	who := MobileWrapper(who);
	who.GetObjRef().EraseProp("IsMeditating");
	who.GetObjRef().EraseProp("HealTimer");

	if (!Accessible(who.GetObjRef(), potion))
		return;
	endif

	if (!potion.movable)
		Message("Você não pode usar isto.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return;
	endif

	Message("Qual item deseja encantar?", Color(SYSTEM_COLOR::INFO)).SendSys(who.GetObjRef());
	var use_on := Target(who.GetObjRef());

	if (!use_on)
		Message("Cancelado", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return 0;
	endif

	if (!use_on.isA(POLCLASS_WEAPON) && !use_on.isA(POLCLASS_ARMOR))
		Message("Isto não pode ser banhado por essa poção.", Color(SYSTEM_COLOR::FAIL)).SendSys(who.GetObjRef());
		return;
	endif

	var bonus := Cint(GetObjProperty(potion, "crafterskill"));
	bonus := bonus * 0.05;

	empty_bottle(who.GetObjRef(), potion, 0);

	Message("Você encantou o objeto.", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who.GetObjRef());
	setBonus(who, use_on, bonus);
endprogram
