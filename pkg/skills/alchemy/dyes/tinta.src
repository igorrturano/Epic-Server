use uo;
use util;
use cfgfile;
include ":alchemy:alchemy";

program drink_blue(who, potion)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");
	if (!Accessible(who, potion))
		return;
	endif
	if (potion.movable == 0)
		SendSysMessage(who, "Voce nao pode usar isto.");
		return;
	endif
	SendSysMessage(who, "Escolha o balde de tintas");
	var what := Target(who, TGTOPT_CHECK_LOS);
	var cfg := ReadConfigFile(":*:itemdesc");
	var cor := (cfg[potion.objtype].Color);
	if (!what)
		SendSysMessage(who, "Cancelado");
		return;
	endif
	if (what.objtype == 0x0FAB)
		what.color := cor;
		Empty_bottle(who, potion, 0);
		SetObjProperty(what, "fullness", 50);
		what.name := "Balde de tinta cheio";
	else
		SendSysMessage(who, "Voce precisa usar no balde de tintas");
	endif
endprogram
