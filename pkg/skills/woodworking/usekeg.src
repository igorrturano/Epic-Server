use uo;

include "include/say";
include ":tn:tngumps";
include ":nature:nature";
include ":attributes:attributes";

CONST VINAGRE := 0xc76;

program usekeg(who, item)

var bebida := GetObjProperty(item, "bebida");

if (bebida != error)

    // LICOR INCOMPLETO
    if (bebida.type == "licor incompleto")

        if (bebida.levedura == error)
            SendSysMessageEx(who, "Escolha a levedura.", SSM_INFO);
            var levedura := target(who);

            if (levedura.objtype != 49561)
                SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
                return 1;
            endif

            SubtractAmount(levedura, 1);
            bebida.+levedura := 1;
            SetObjProperty(item, "bebida", bebida);
            return 1;

        elseif (bebida.liquido == error)

            SendSysMessageEx(who, "Escolha o liquido (agua ou fruta).", SSM_INFO);
            var liquido := target(who);

            if (liquido.objtype == 0x1f9e) // agua
                bebida.tipo := "hidromel";

            elseif (liquido.objtype == 0x172c) // pessego
                bebida.tipo := "licor_pessego";

            elseif (liquido.objtype == 0x0c5c) // melancia
                bebida.tipo := "licor_melancia";

            elseif (liquido.objtype == 0x09d0) // maca
                bebida.tipo := "cidra";

            else
                SendSysMessageEx(who, "Liquido invalido.", SSM_FAIL);
                return 1;
            endif

            bebida.liquido := 1;
            DestroyItem(liquido);

            bebida.type := "licor fermentando";
            bebida.+endtime := polcore().systime + 7200;

            SetObjProperty(item, "bebida", bebida);
            SendSysMessageEx(who, "A fermentacao comecou.", SSM_INFO);
            return 1;

        endif

    // CERVEJA INCOMPLETA
    elseif (bebida.type == "cerveja incompleta")

        if (bebida.levedura == error)

            SendSysMessageEx(who, "Escolha a levedura.", SSM_INFO);
            var levedura := target(who);

            if (levedura.objtype != 49561)
                SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
                return 1;
            endif

            SubtractAmount(levedura, 1);
            bebida.+levedura := 1;
            SetObjProperty(item, "bebida", bebida);
            return 1;

        elseif (bebida.agua == error || bebida.agua < 10)

            SendSysMessageEx(who, "Voce precisa adicionar agua.", SSM_INFO);
            var agua := target(who);

            if (agua.objtype != 0x1f9e)
                SendSysMessageEx(who, "Alvo invalido.", SSM_FAIL);
                return 1;
            endif

            if (bebida.agua == error)
                bebida.agua := 0;
            endif

            bebida.agua := bebida.agua + 1;
            DestroyItem(agua);

            SetObjProperty(item, "bebida", bebida);
            return 1;

        endif

        if (bebida.agua == 10 && bebida.levedura)
            bebida.type := "cerveja fermentando";
            bebida.+endtime := polcore().systime + 7200;
            SetObjProperty(item, "bebida", bebida);
            SendSysMessageEx(who, "A cerveja comecou a fermentar.", SSM_INFO);
        endif

    //  VINHO INCOMPLETO
    elseif (bebida.type == "vinho incompleto")

        if (bebida.levedura == error)

            SendSysMessageEx(who, "Escolha a levedura.", SSM_INFO);
            var levedura := target(who);

            if (levedura.objtype != 49561)
                SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
                return 1;
            endif

            SubtractAmount(levedura, 1);
            bebida.+levedura := 1;
            SetObjProperty(item, "bebida", bebida);
            return 1;
        endif

        bebida.type := "vinho fermentando";
        bebida.+endtime := polcore().systime + 7200;

        SetObjProperty(item, "bebida", bebida);
        SendSysMessageEx(who, "O vinho esta fermentando.", SSM_INFO);
        return 1;

    // RESULTADO LICOR
    elseif (bebida.type == "licor fermentando")

        var agora := polcore().systime;

        if (agora < bebida.endtime)
            SendSysMessageEx(who, "O liquido esta fermentando...", SSM_INFO);
            return 1;
        endif

        var tempo_extra := agora - bebida.endtime;

        if (bebida.tipo == "hidromel")

            if (tempo_extra < 600)
                bebida.+objtype := 0xC964; // hidromel
            else
                bebida.+objtype := 0x0C87; // rum
            endif

        elseif (bebida.tipo == "licor_pessego")
            bebida.+objtype := 0xC961;

        elseif (bebida.tipo == "licor_melancia")
            bebida.+objtype := 0xC960;

        elseif (bebida.tipo == "cidra")
            bebida.+objtype := 0xC879;

        endif

        bebida.+doses := 40;
        bebida.type := "";

        SetObjProperty(item, "bebida", bebida);
        SendSysMessageEx(who, "A bebida esta pronta.", SSM_INFO);
        return 1;

    //  RESULTADO VINHO
    elseif (bebida.type == "vinho fermentando")

        if (polcore().systime > bebida.endtime)

            var skill := AP_GetSkill(who, "COOKING");
            var season := GetSeason();
			var score;
			if (season == 1) // verao
    			score := score + 15;
			elseif (season == 0) // primavera
    			score := score + 10;
			elseif (season == 2) // outono
    			score := score + 5;
			else // inverno
    			score := score - 10;
			endif
            score := skill + RandomInt(50) + (season * 10);
            var qualidade;

            if (score > 120)
                qualidade := "Excelente";
            elseif (score > 100)
                qualidade := "Muito boa";
            elseif (score > 80)
                qualidade := "Boa";
            elseif (score > 60)
                qualidade := "Discreta";
            else
                qualidade := "Mediocre";
            endif

            bebida.+objtype := 0xC878;
            bebida.+doses := 80;
            bebida.type := "";

            SetObjProperty(item, "bebida", bebida);

            var name := item.desc;
            SetObjProperty(item, "description", "Safra: " + qualidade);
            SetName(item, name);

            return 1;
        endif

        SendSysMessageEx(who, "O vinho ainda esta fermentando.", SSM_INFO);
        return 1;

    //  RESULTADO CERVEJA
    elseif (bebida.type == "cerveja fermentando")

        var agora := polcore().systime;

        if (agora < bebida.endtime)
            SendSysMessageEx(who, "A cerveja esta fermentando.", SSM_INFO);
            return 1;
        endif

        var tempo_extra := agora - bebida.endtime;

        if (tempo_extra < 600)
            bebida.+objtype := 0xC877;

        elseif (tempo_extra < 1800)
            bebida.+objtype := 0xC87D;

        elseif (tempo_extra < 3600)
            bebida.+objtype := 0xC87E;

        else
            bebida.+objtype := VINAGRE;
        endif

        bebida.+doses := 40;
        bebida.type := "";

        SetObjProperty(item, "bebida", bebida);
        return 1;

    else

        var opt := RadioGump(who, 200, 180, "Barril", { "Remover", "Adicionar" });

        if (opt == "Adicionar")
            addDrink(who, item);
        else
            subDrink(who, item);
        endif

    endif

else

    SendSysMessageEx(who, "O barril esta vazio.", SSM_INFO);
    addDrink(who, item);

endif

endprogram

function addDrink(who, item)

	var targ := Target(who);
	if (!targ)
		SendSysMEssageEx(who, "Cancelado.", SSM_FAIL);
		return 1;
	endif

	// so pode por garrafas ou potions no keg
	if ((targ.graphic == 0xC878) || (targ.graphic == 0xC876) ||
	 (targ.graphic == 0xC877) || (targ.graphic == 0xC879) || (targ.graphic == 0xC960) ||
	 (targ.graphic == 0xC961) || (targ.graphic == 0xC962) || (targ.graphic == 0xC964) ||
	 (targ.graphic == 0x1f9e))
		if (getobjproperty(targ, "fullness") != error)
			SendSysMEssageEx(who, "Voce so pode armazenar garrafas cheias.", SSM_FAIL);
			return 1;
		elseif (getobjproperty(targ, "doses") != error &&
		  (getobjproperty(targ, "doses") != getobjproperty(targ, "crafterskill") / 20))
			SendSysMEssageEx(who, "Voce so pode armazenar garrafas cheias.", SSM_FAIL);
			return 1;
		endif
	elseif (targ.objtype == 0x0C7F) // Mosto de cerveja
        var bebida := struct;
        bebida.+type := "cerveja incompleta";
        bebida.+lupulo := 0;

        SetObjProperty(item, "bebida", bebida);
        SubtractAmount(targ, 1);

        SendSysMessageEx(who, "Adicione levedura e agua para iniciar a fermentacao.", SSM_INFO);
        return 1;
	elseif (targ.objtype == 0x0C80) // Mosto adocicado
    	var bebida := struct;
    	bebida.+type := "licor incompleto";
    	SetObjProperty(item, "bebida", bebida);
    	SubtractAmount(targ, 1);
	    SendSysMessageEx(who, "Adicione levedura e o liquido desejado (agua ou frutas).", SSM_INFO);
    	return 1;
	elseif (targ.objtype == 0x0C83) // Mosto de vinho
	    var bebida := struct;
		bebida.+type := "vinho incompleto";
    	SetObjProperty(item, "bebida", bebida);
    	SubtractAmount(targ, 1);
	    SendSysMessageEx(who, "Adicione levedura para iniciar a fermentacao.", SSM_INFO);
    	return 1;
	else
		SendSysMEssageEx(who, "Alvo invalido.", SSM_FAIL);
		return;

	endif

	var bebida := GetObjProperty(item, "bebida");

	var cfg := ReadConfigFile("::itemdesc");
	var elem := FindConfigElem(cfg, targ.objtype);
	var dosesMod := cint(GetConfigInt(elem, "doses"));
	var pot := getobjproperty(item, "pocao"); // verifica se o conteúdo do barril é uma poção
	// if (!dosesMod)
	dosesMod := 1; // deixa sempre 1
	// endif

	if (targ.objtype == 0xcfff) // não aceita extratos
		SendSysMessageEx(who, "Voce nao pode por extratos no barril.");
		return;
	endif

	if (bebida.doses == 50)
		SendSysMessageEx(who, "este barril ja esta cheio.");
		return;
	elseif (bebida == error || bebida.doses <= 0)
		bebida := struct;
		bebida.+objtype := targ.objtype;
		bebida.+doses := targ.amount * dosesMod;
		if (targ.graphic == 3849 && targ.objtype != 0xcfff) // não aceita extratos
			if (pot == error) // coleta as props da poção
				var pot := dictionary{ "bonus" -> 0, "crafterskill" -> 0, "tier" -> 0, "science" -> "x" };
				var props := pot.keys();
				foreach key in props
					var prop_value := getobjproperty(targ, key);
					pot[key] := prop_value;
					setobjproperty(item, "pocao", pot);
				endforeach
			endif
		endif
	else
		if (bebida.objtype != targ.objtype && pot == error)
			SendSysMessageEx(who, "Voce nao pode misturar essas bebidas.", SSM_FAIL);
			return;
		elseif (bebida.objtype != targ.objtype && pot != error && targ.objtype != 0x1f9e)
			SendSysMessageEx(who, "Voce nao pode misturar essas bebidas.", SSM_FAIL);
			return;
		else
			if (pot != error) // faz a média da força das poções no barril com as novas
				var bonus := pot["bonus"];
				var skill := pot["crafterskill"] / 10;
				var bonuspot := getobjproperty(targ, "bonus");
				var skillpot := getobjproperty(targ, "crafterskill") / 10;
				bonus := cint((bonus * bebida.doses + bonuspot * targ.amount) / (bebida.doses + targ.amount));
				skill := cint((skill * bebida.doses + skillpot * targ.amount) / (bebida.doses + targ.amount));
				pot.insert("bonus", bonus);
				pot.insert("crafterskill", skill * 10);
				setobjproperty(item, "pocao", pot);
			endif

			if (bebida.doses + targ.amount * dosesMod > 50)
				SendSysMessageEx(who, "o barril so comporta 50 doses.");
				return;
			else
				bebida.doses := bebida.doses + targ.amount * dosesMod;
			endif
		endif
	endif

	SetObjProperty(item, "bebida", bebida);

	if (elem)
		var leftover := GetConfigInt(elem, "return_type");
		if (leftover)
			CreateItemInBackpack(who, leftover, targ.amount);
		else
			CreateItemInBackpack(who, 0xF0E, targ.amount);
		endif
	else
		CreateItemInBackpack(who, 0xF0E, targ.amount);
	endif
	DestroyItem(targ);
	PlaySoundEffect(who, 0x241);
	var name := item.desc;
	SetObjProperty(item, "description", bebida.doses + " doses");
	SetName(item, name);

	if (bebida != error)
		item.weight_multiplier_mod := 1 + (bebida.doses * 0.05);
	endif

endfunction

function subDrink(who, item)

	var bebida := GetObjPRoperty(item, "bebida");

	if (bebida.doses > 0)
		SendSysMessageEx(who, "Este barril tem ainda " + bebida.doses + " doses.  Escolha uma garrafa vazia para enche-la.",
				   SSM_REQUEST);
		var bottle := Target(who);

		if (bottle.objtype != 0xF0E)
			SendSysMessageEx(who, "Isso nao parece uma garrafa vazia.", SSM_FAIL);
			return;
		endif

		var cfg := ReadConfigFile("::itemdesc");
		var elem := FindConfigElem(cfg, item.objtype);
		var dosesMod := cint(GetConfigInt(elem, "doses"));
		dosesMod := 1;

		// if ( isPotion(bebida.objtype))
		// 	if (bottle.objtype != 3854)
		// 		SendSysMessageEx(who, "Voce so pode armazenar esse liquido  em garrafas.", SSM_FAIL);
		// 		endif
		// 	endif
		// 	dosesMod := 1; //pocao semrpe sai 1
		// else
		// 	if (!dosesMod) //se nao for pot e nao achou dosesmod tira 3
		// 		dosesMod := 3;
		// 	endif
		// endif

		if (bebida.doses < dosesMod)
			SendSysMessageEx(who, "O barril nao tem liquido suficiente para encher este recipiente.",
							  SSM_FAIL);
			return 1;
		endif
		SubtractAmount(bottle, 1);
		PlaySoundEffect(who, 0x241);
		var drink := CreateItemInBackpack(who, bebida.objtype, 1);
		var pot := getobjproperty(item, "pocao");

		if (pot != error)
			var props := pot.keys();
			foreach key in props
				SetObjProperty(drink, key, pot[key]);
			endforeach
		endif

		bebida.doses := bebida.doses - dosesMod;
		if (bebida.doses == 0)
			SendSysMessageEx(who, "O barril secou.", SSM_FAIL);
			EraseObjProperty(item, "bebida");
			EraseObjProperty(item, "pocao");
			item.weight_multiplier_mod := 1;
		else
			SetObjProperty(item, "bebida", bebida);
			item.weight_multiplier_mod := 1 + (bebida.doses * 0.05);
		endif
		var name := item.desc;
		SetObjProperty(item, "description", bebida.doses + " doses");
		SetName(item, name);
		return 1;
	else
		SendSysMessageEx(who, "O barril secou.", SSM_FAIL);
		EraseObjProperty(item, "bebida");
		return 1;
	endif

endfunction