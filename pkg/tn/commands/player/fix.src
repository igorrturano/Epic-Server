use uo;
use os;
use basic;

include "include/say";
include ":destroyable:include/destroyItem";
include ":faccao:include/shared_functions";
include ":faccao:include/faccao_constants";

program fix(who, param)
	if (param == "help")
		SendSysMessage(who, "Opcoes de uso do .fix:");
		SendSysMessage(who, "\".fix\" Personagem fixa ou desfixa itens.");
		SendSysMessage(who, "\".fix transferir\" Personagem passa controle do item para outro.");
		SendSysMessage(who, "");
		SendSysMessage(who, "Itens territoriais (Baú, Mesa, Mural, Estandarte, Mesa de Inscrição):");
		SendSysMessage(who, "- Apenas o líder da facção proprietária pode fixar/desfixar");
		SendSysMessage(who, "- Não podem ser transferidos");
		if(who.cmdlevel)
			SendSysMessage(who, "\".fix travar\" GM fixa ou desfixa itens (Player NAO PODE mais usar .fix).");
			SendSysMessage(who, "\".fix liberar\" GM fixa ou desfixa itens (Qualquer Player pode tomar controle do item com .fix).");
		endif
		return 0;
	endif

	SendSysMessageEx(who, "Em qual item deseja aplicar o comando?", SSM_REQUEST);
	var alvo := Target(who, TGTOPT_CHECK_LOS);
	if (!alvo)
		SendSysMessage(who, "Cancelado", SSM_FAIL);
		return 0;
	elseif (!Accessible(who, alvo,2))
		SendSysMessageEx(who, "Voce nao alcanca o alvo.", SSM_FAIL);
		return 0;
	elseif (TypeOf(alvo.container) == "ItemRef")
		SendSysMessageEx(who, "Voce nao pode fixar itens dentro de containers.", SSM_FAIL);
		return 0;
	endif
	
	var fixer := GetObjProperty(alvo, "fixer");
		if(!param)
		if(who.cmdlevel)
			if (alvo.movable == 0)
				Fixar(alvo,false);
				SendSysMEssage(who, "O item esta solto.");
			else
				Fixar(alvo,true);
				SendSysMessage(who, "O item esta imovel.");
			endif
			return 1;
		elseif (IsTerritoralItem(alvo))
			// Verificar se pode fixar item territorial
			if (CanPlayerFixTerritorialItem(who, alvo))
				// Lógica especial para itens territoriais - líder da facção proprietária do território
				if (alvo.movable == 1)
					Fixar(alvo,true);
					PrintTextAbove(alvo, who.name +" fixou "+alvo.name+".");
					SendSysMessageEx(who, "O item territorial esta protegido contra decay.", SSM_INFO);
				else
					if (who.hidden)
						PrintTextAbove(who, who.name +" tenta desfixar "+alvo.name+" e saiu do esconderijo.");
						who.hidden := 1;
					else
						PrintTextAbove(who, who.name +" tenta desfixar "+alvo.name+".");
					endif
					Sleep(2);
					Fixar(alvo,false);
					PrintTextAbove(alvo, who.name +" soltou "+alvo.name+".");
				endif
				return 1;
			else
				// Item territorial mas jogador não tem permissão - a mensagem já foi enviada em CanPlayerFixTerritorialItem
				return 0;
			endif
		elseif (GetObjProperty(alvo, "crafterserial") == error)
			SendSysMessageEx(who, "Esse item so pode ser fixado ou desfixado pela Staff.", SSM_FAIL);
			return 0;
		else
			if (!fixer)
				SetObjProperty(alvo, "fixer", who.serial);
			elseif (who.serial != fixer)
				SendSysMessageEx(who, "Esse item precisa ser transferido para voce antes de usar esse comando.", SSM_FAIL);
				return 0;
			endif
			if (alvo.movable == 1)
				Fixar(alvo,true);
				PrintTextAbove(alvo, who.name +" fixou "+alvo.name+".");
				SendSysMessageEx(who, "O item esta protegido contra decay.", SSM_INFO);
			else
				if (who.hidden)
					PrintTextAbove(who, who.name +" tenta desfixar "+alvo.name+" e saiu do esconderijo.");
					who.hidden := 1;
				else
					PrintTextAbove(who, who.name +" tenta desfixar "+alvo.name+".");
				endif
				Sleep(2);
				Fixar(alvo,false);
				PrintTextAbove(alvo, who.name +" soltou "+alvo.name+".");
			endif
			return 1;
		endif
	elseif (param == "transferir")
		// Verificar se é item territorial - não pode ser transferido
		if (IsTerritoralItem(alvo))
			SendSysMessageEx(who, "Itens territoriais não podem ser transferidos. Apenas o líder da facção proprietária pode fixá-los.", SSM_FAIL);
			return 0;
		endif
		
		if (who.serial != fixer)
			SendSysMessageEx(who, "Esse item precisa ser transferido para voce antes de usar esse comando.", SSM_FAIL);
			return 0;
		endif

		var crafterserial := GetObjProperty(alvo, "crafterserial");
		if (crafterserial)
			SendSysMessageEx(who, "Para quem voce quer transferir o controle do item?", SSM_REQUEST);
			var novoDono := Target(who);
			if (!novoDono.acctname)
				SendSysMessage(who, "Cancelado", SSM_FAIL);
				return 0;
			endif
			if (!fixer)
				SetObjProperty(alvo, "fixer", novoDono.serial);
				PrintTextAbove(alvo, who.name +" passou o controle de "+alvo.name+" para "+novoDono.name+".");
				return 1;
			else
				SetObjProperty(alvo, "fixer", novoDono.serial);
				PrintTextAbove(alvo, who.name +" passou o controle de "+alvo.name+" para "+novoDono.name+".");
				return 1;
			endif
		else
			SendSysMessageEx(who, "Esse item so pode ser fixado ou desfixado por comando exclusivo da Staff.", SSM_FAIL);
			return 0;
		endif

	elseif (Cint(param) == "travar")
		if(who.cmdlevel)
			if (alvo.movable == 0)
				EraseObjProperty(alvo, "crafterserial");
				Fixar(alvo,false);
				SendSysMEssage(who, "O item esta solto e so pode ser fixado pela staff.");
			else
				EraseObjProperty(alvo, "crafterserial");
				Fixar(alvo,true);
				SendSysMessage(who, "O item esta imovel e so pode ser solto pela staff.");
			endif
		else
			return 0;
	  	endif
	   	return 1;
	elseif (Cint(param) == "liberar")
		if(who.cmdlevel)
			SetObjProperty(alvo, "crafterserial",who.serial);
			EraseObjProperty(alvo, "fixer");
			if (alvo.movable == 0)
				Fixar(alvo,false);
				SendSysMEssage(who, "O item esta solto e agora pode ser fixado por qualquer um.");
			else
				Fixar(alvo,true);
				SendSysMessage(who, "O item esta imovel e agora pode se solto por qualquer um.");
			endif
		else
			return 0;
		endif
		return 1;
	else
		SendSysMessage(who, "Opcao invalida. Para listar opcoes use o comando .fix help");
		return 0;
	endif
	return 0;
endprogram

function GetDeed(who, deed)
	if (!GetObjProperty(deed, "FromDeed"))
		return 1;
	endif

	Var NewDeed := CreateItemInBackpack(who, GetObjProperty(deed, "FromDeed"), 1);
	NewDeed.color := deed.color;
	NewDeed.movable := 1;
	SetObjProperty(NewDeed, "crafterserial", GetObjProperty(deed, "crafterserial"));
	SetObjProperty(NewDeed, "fixer", GetObjProperty(deed, "fixer"));

	foreach part in GetObjProperty(deed, "ItemsCreatedSerials")
		DestroyItem( SystemFindObjectBySerial( part ) );
	endforeach

	if (deed)
		destroyitem( deed );
	endif

endfunction

function Fixar(byref item,devefixar)
	item.movable := !devefixar;

	if(item.isA(POLCLASS_CONTAINER))
		if(VerificaRegiaoSegura(item))
			if(devefixar)
				SetObjProperty(item,PROPNAME_INDESTRUTIVEL,1);
			else
				EraseObjProperty(item,PROPNAME_INDESTRUTIVEL);
			endif
		endif
	endif
	
	return item.movable;
endfunction

// Função para verificar se um item é territorial
function IsTerritoralItem(item)
	if (!item)
		return 0;
	endif
	
	// Verificar pelos objtypes dos 5 itens territoriais especificados
	// Usando as constantes definidas em faccao_constants.inc
	if (item.objtype == TERRITORIO_MURAL ||       // 0x46AE - muralrecrutamento
		item.objtype == TERRITORIO_MESA_INSCRICAO || // 0xF8A8 - MesaDeInscricao  
		item.objtype == TERRITORIO_MESA ||        // 0xFE5C - mesadegestaodereino
		item.objtype == TERRITORIO_BAU ||         // 0xFF11 - BaudeDoacoes
		item.objtype == TERRITORIO_ESTANDARTE)    // 0xFDDF - EstandarteReino
		return 1;
	endif
	
	return 0;
endfunction

// Função para verificar se um jogador pode fixar/desfixar um item territorial
function CanPlayerFixTerritorialItem(who, item)
	if (!who || !item)
		return 0;
	endif
	
	// Verificar se o item é territorial
	if (!IsTerritoralItem(item))
		return 0;
	endif
	
	// Staff sempre pode fixar itens territoriais
	if (who.cmdlevel)
		return 1;
	endif
	
	// USAR EXATAMENTE A MESMA VERIFICAÇÃO DOS OUTROS ITENS
	// Método 1: Verificar se tem uma guilda e se é o líder
	var player_guild := who.guild;
	if (player_guild)
		if (player_guild.leader == who.serial)
			return 1;
		endif
	endif

	// Método 2: Verificar por cargo armazenado em propriedade
	var player_rank := GetObjProperty(who, "guild_rank");
	if (player_rank in {"Lider", "Leader"})
		return 1;
	endif
	
	SendSysMessage(who, "Apenas o líder da facção pode fixar/desfixar itens territoriais.");
	return 0;
endfunction

// Função para verificar se um jogador é líder de uma facção
function IsPlayerFactionLeader(who, faction_name)
	if (!who || !faction_name)
		return 0;
	endif
	
	// Obter a guilda do jogador
	if (!who.guild)
		return 0;
	endif
	
	// Verificar se o nome da guilda corresponde à facção
	var guild_faction := who.guild.GetProp(FACTION_PROP_NAME);
	if (!guild_faction)
		guild_faction := who.guild.guildname;
	endif
	
	if (guild_faction != faction_name)
		return 0;
	endif
	
	// USAR A MESMA VERIFICAÇÃO DA MESA DE INSCRIÇÃO
	// Verificar se o jogador é o líder da guilda (mesmo método do permissions.inc)
	if (who.guild.leader != who.serial)
		return 0;
	endif
	
	return 1;
endfunction