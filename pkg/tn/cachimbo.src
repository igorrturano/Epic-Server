use uo;
use os;
use util;
use cfgfile;

include "include/say";
include "include/client";

program cachimbo(player, cachimbo)
	var preenchido := GetObjProperty(cachimbo, "preenchido");
	if (!preenchido)
		SendSysMessage(player, "Selecione o fumo:");
		var targ := target(player);
		if (!targ || targ.errortext)
			return;
		endif
		if (PodeFumar(targ))
			SetObjProperty(cachimbo, "preenchido", 1);
			SendSysMessage(player, "Voce colocou o fumo no cachimbo");
			DestroyItem(targ);
		else
			SendSysMessage(player, "Isso nao pode ser colocado no cachimbo.");
		endif
		return;
	endif
	if (GetObjProperty(player, "#fumando"))
		SendSysMessage(player, "Voce ja esta fumando.");
		return;
	endif
	Fumar(player, cachimbo);
endprogram

function Fumar(player, cachimbo)
	SetObjProperty(player, "#fumando", 1);
	PrintTextAbove(player, "*Acendendo um cachimbo*");
	Fumaca(player);
	detach();
	Sleep(4);
	var loop := 0;
	while (loop < 4)
		if (!player || !cachimbo)
			break;
		endif
		PrintTextAbove(player, "*Dando tragadas em um cachimbo*");
		Fumaca(player);
		Sleep(4);
		Fumaca(player);
		Sleep(4);
		Fumaca(player);
		Sleep(4);
		loop := loop + 1;
	endwhile
	EraseObjProperty(player, "#fumando");
	if (cachimbo)
		SendSysMessage(player, "O fumo do cachimbo acabou");
		EraseObjProperty(cachimbo, "preenchido");
	endif
endfunction

function Fumaca(player)
	var x, y, z;
	case (player.facing)
		0: x := 0;  y := -1; z := 6;   // Norte
		1: x := 1;  y := -1; z := 10;  // Nordeste
		2: x := 1;  y := 0;  z := 10;  // Leste
		3: x := 1;  y := 1;  z := 15;  // Sudeste
		4: x := 0;  y := 1;  z := 10;  // Sul
		5: x := -1; y := 1;  z := 6;   // Sudoeste
		6: x := -1; y := 0;  z := 6;   // Oeste
		7: x := -1; y := -1; z := 2;   // Noroeste
	endcase
	PlayStationaryEffect(player.x + x, player.y + y, player.z + z, FX_FIZZLE, 5, 50, 0, player.realm);
endfunction

function PodeFumar(item)
	var config := ReadConfigFile(":*:itemdesc");
	var elem := config[item.objtype];
	if (elem.PodeFumar)
		return 1;
	endif
	return 0;
endfunction
