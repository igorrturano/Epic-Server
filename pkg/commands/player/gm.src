/*
 * {$Id}
 *
 * Purpose
 * Allows us to drop our command level to player and then turn it back on.
 * May want to remove it after distro development is completed.
 *
*/
use uo;
use os;
use file;

program textcmd_CmdToggle(who)
	LogToFile(":fls_core:cmdtoggle.log", who.name + " (" + who.acctname + ") usou cmdtoggle ",
		   LOG_DATETIME);
	if (who.cmdlevel)
		SetObjProperty(who, "cmdlevel", who.cmdlevel);
		who.cmdlevel := 0;
		SendSysMessage(who, "Gm: Off");
	else
		if (!GetObjProperty(who, "cmdlevel"))
			SendSysMessage(who, "Achou que ia virar gm ne? :p");
			return 0;
		endif

		who.cmdlevel := CInt(GetObjProperty(who, "cmdlevel"));
		EraseObjProperty(who, "cmdlevel");
		SendSysMessage(who, "Gm: On");
	endif

	return 1;
endprogram
