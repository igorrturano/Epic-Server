use uo;
use os;
use util;
use cfgfile;

include "include/client";
include ":itemutils:canAccess";
include ":attributes:attributeConstants";
include ":attributes:attributes";
include ":timedscripts:timedScripts";
include ":fls_core:fls_characters";
include "include/say";
include ":charactercreation:habilidades";
include ":spells:include/swordmage";

program do_empty(who)
	EraseObjProperty(who, "IsMeditating");
	EraseObjProperty(who, "HealTimer");
	SendSysMessageEx(who, "Escolha a pocao que deseja esvaziar.", SSM_REQUEST);
	var the_potion := Target(who);

	if (!the_potion)
		SendSysMessageEx(who, "Cancelado.", SSM_FAIL);
		return;
	elseif (!can_access(who, the_potion))
		SendSysMessageEx(who, " Voce nao pode usar isto!", SSM_FAIL);
		return;
	elseif (Distance(who, the_potion) > 1)
		SendSysMessageEx(who, " Voce esta muito distante!", SSM_FAIL);
		return;
	elseif (the_potion.graphic != 0x0f09)
		SendSysMessageEx(who, "Isso nao parece ser uma pocao!", SSM_FAIL);
		return;

	else
		var flaskObjtype := 0x0F0E;
		var flaskMaterial := 7139;
		var flaskColor := 1328;
		var flaskTier := 1;
		var fabricado := GetObjProperty(the_potion, "fabricado");
		if (fabricado)
			var comp := 0;
			if (fabricado.componentes)
				comp := fabricado.componentes["doses"];
				if (!comp)
					comp := fabricado.componentes["vazio"];
				endif
			elseif (fabricado.esquema && fabricado.esquema.componentesEscolhidos)
				foreach c in (fabricado.esquema.componentesEscolhidos)
					Sleepms(2);
					var car := c.componenteNecessario.caracteristica;
					if (Lower(car) == "doses" || Lower(car) == "vazio")
						comp := c;
						break;
					endif
				endforeach
			endif
			if (comp)
				if (comp.item && comp.item.objtype)
					flaskObjtype := CInt(comp.item.objtype);
				endif
				if (comp.material && comp.material.chave)
					flaskMaterial := CInt(comp.material.chave);
					var configRecursos := ReadConfigFile(":crafting:config/resourceList");
					var resourceElem := FindConfigElem(configRecursos, comp.material.chave);
					if (resourceElem)
						var corCfg := CInt(resourceElem.Color);
						if (corCfg > 0)
							flaskColor := corCfg;
						endif
					endif
				endif
				if (comp.tier)
					var tierId := comp.tier.id;
					if (!tierId)
						tierId := cint(comp.tier);
					endif
					if (tierId > 0)
						flaskTier := tierId;
					endif
				endif
			endif
		endif
		SendSysMessageEx(who, "Voce esvaziou a pocao.", SSM_REQUEST);
		PlaySoundEffect(who, 0x241);
		var pot := CreateItemInBackpack(who, flaskObjtype, the_potion.amount);
		setobjproperty(pot, "encaixeComponente", "frasco");
		setobjproperty(pot, "material", flaskMaterial);
		setobjproperty(pot, "tierComponente", flaskTier);
		pot.color := flaskColor;
		DestroyItem(the_potion);
		return;
	endif

endprogram
