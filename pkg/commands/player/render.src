use uo;
use os;

include ":wrappers:Objects/Model/MobileWrapper";
include "include/client";

program txt_render(character, wake_up)

	AnimateRender(MobileWrapper(character), wake_up);

	return 1;

endprogram

function AnimateRender(mobile, wake_up := 1)

	Detach();

	if (mobile.GetObjRef() is @Exception)
		return mobile.GetObjRef();
	endif

	var ref := mobile.GetObjRef();

	if (GetProcess(CInt(GetObjProperty(ref, "#RenderPid"))))
		return 0;
	else
		SetObjProperty(ref, "#RenderPid", GetPid());
	endif

	if (wake_up)
		mobile.PlayAnimation(HUMAN_ANIM::CAST_AREA);
		return 1;
	endif

	var x := ref.x;
	var y := ref.y;

	while (ref.connected)
		PlayRenderFrame(ref);

		if (ref.x != x || ref.y != y)
			break;
		endif
		SleepMS(100);
	endwhile

	return 1;

endfunction

function PlayRenderFrame(who)

	var dir        := 1;
	var speed      := 5;
	var doesrepeat := 0;
	var framecount := 3;
	var numrepeats := 1;

	var packetString := "6E";
	packetString := packetString + fixPacketLength(hex(who.serial), 4);
	packetString := packetString + fixPacketLength(hex(17), 2);         // AREA_SPELLCAST animation
	packetString := packetString + fixPacketLength(hex(framecount), 2);
	packetString := packetString + fixPacketLength(hex(numrepeats), 2);
	packetString := packetString + fixPacketLength(hex(dir), 1);
	packetString := packetString + fixPacketLength(hex(doesrepeat), 1);
	packetString := packetString + fixPacketLength(hex(speed), 1);

	foreach chr in ListMobilesNearLocation(who.x, who.y, who.z, 16, who.realm)
		SendPacket(chr, packetString);
		SleepMS(10);
	endforeach

	return 1;

endfunction
