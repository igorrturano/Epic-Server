use os;
use uo;

include ":attributes:attributes";
include ":gumps:requestGump";
include ":message:model/Message";

program powerup(who, level)
	if (who.cmdlevel == 0)
		var acct := who.acct.name;
		if (acct != "hermann21" && acct != "epicplayer")
			Message("Voce nao tem permissao para usar este comando.", Color(SYSTEM_COLOR::FAIL)).SendSys(who);
			return 0;
		endif
	endif

	if (!level)
		level := CDbl(RequestGump(who, "Power up level", "", 100));
	else
		level := CDbl(level);
	endif

	foreach attrib_name in AP_ListAttributesByType()
		AP_SetTrueSkill(who, attrib_name, level);
		sleepms(10);
	endforeach

	AP_RefreshVitals(who);

	Message("Done.", Color(SYSTEM_COLOR::SUCCESS)).SendSys(who);
	return 1;
endprogram