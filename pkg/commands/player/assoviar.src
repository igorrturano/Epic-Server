use uo;
use os;
use npc;
use util;
use math;

include "include/say";
include ":taming:taming";
include ":stables:include/stable";

const COOLDOWN_SECONDS := 20;
const HIDE_MAX_DIST := 28;
const MAX_PET_SCAN_RANGE := 18;

program textcmd_Assoviar(character)
	var current_time := ReadGameClock();
	var last_use := GetObjProperty(character, "AssoviarCooldown");

	// Adiciona emote de assovio
	PrintTextAbove(character, "*assovia*");

	// Cooldown mais rigoroso
	if (last_use && current_time < CInt(last_use) + COOLDOWN_SECONDS)
		var tempo_restante := CInt(last_use) + COOLDOWN_SECONDS - current_time;
		SendSysMessage(character, "Aguarde " + tempo_restante + " segundos.");
		return 0;
	endif

	var pet_in_limbo_serial := GetObjProperty(character, "PlayerPetInLimboSerial");
	var success := 0;

	if (pet_in_limbo_serial)
		success := CallPetBack(character, CInt(pet_in_limbo_serial));
	else
		// Verifica se o jogador tem algum pet registrado em estábulo
		var has_stabled_pet := 0;
		var pets := ListMobilesNearLocation(character.x, character.y, character.z, MAX_PET_SCAN_RANGE,
											 character.realm);

		foreach mob in pets
			if (mob.IsA(POLCLASS_NPC) && mob.master == character && GetObjProperty(mob, "StablePostSerial") &&
				!IsStableExpired(mob))
				has_stabled_pet := 1;
				break;
			endif
		endforeach

		if (!has_stabled_pet)
			SendSysMessage(character, "Voce precisa ter um pet com contrato de estabulo ativo para usar este comando.");
			return 0;
		endif

		success := SendPetAway(character);
	endif

	// Só aplica cooldown se realmente teve sucesso
	if (success)
		SetObjProperty(character, "AssoviarCooldown", current_time);
	endif

	return success;
endprogram

function CallPetBack(character, pet_serial)
	var pet := SystemFindObjectBySerial(pet_serial);

	if (!pet)
		SendSysMessage(character, "Seu pet nao foi encontrado.");
		EraseObjProperty(character, "PlayerPetInLimboSerial");
		EraseObjProperty(character, "CurrentStablePostSerial");
		return 0;
	endif

	if (pet.master != character)
		// Pet foi transferido ou libertado enquanto estava em limbo.
		// Libera o pet do estado de limbo e limpa a ref do player.
		ClearPetStableAndLimboState(pet);
		ClearMasterLimboRef(character, pet_serial);
		EraseObjProperty(character, "CurrentStablePostSerial");
		SendSysMessage(character, "Seu pet nao esta mais com voce.");
		return 0;
	endif

	if (!GetObjProperty(pet, "EstaNoLimbo"))
		SendSysMessage(character, "Nao foi possivel chamar o pet.");
		EraseObjProperty(character, "PlayerPetInLimboSerial");
		return 0;
	endif

	// Contrato expirado ou perdido: traz o pet de volta de graca, encerra contrato.
	// Nao frustra o jogador — ele so perde o direito ao .assoviar.
	var contrato_expirou := (!GetObjProperty(pet, "StablePostSerial") || IsStableExpired(pet));

	// Verifica se o jogador tem slots livres para o pet retornar
	if ( (GetNumPets(character) + GetPetCost(pet)) > GetMaxPets(character) )
		SendSysMessage(character, "Voce nao tem slots suficientes para resgatar seu animal.");
		return 0;
	endif

	// Remove estados especiais que impedem o movimento
	pet.hidden := 0;
	pet.frozen := 0;
	pet.invul := 0;

	PlaySoundEffect(character, 0x448);

	// Acha um tile caminhavel proximo ao dono (evita cair em casa/montanha/agua)
	var appear_loc := FindSpawnLocationNearby(character);

	// Teletransporta o pet para o local de aparecimento
	MoveObjectToLocation(pet, appear_loc.x, appear_loc.y, appear_loc.z, character.realm,
					  MOVEOBJECT_FORCELOCATION);

	// Faz o pet andar naturalmente ate o dono (se apareceu a distancia > 0)
	PrintTextAbove(pet, "*voltando para " + character.name + "*");

	if (appear_loc.x != character.x || appear_loc.y != character.y)
		var walk_event := struct{ "type" := 0xA008, // GO_LOC_CMD
								"source" := character,
								"targ" := struct{ "x" := character.x, "y" := character.y,
								"type" := "walk" } };
		SendEvent(pet, walk_event);
	endif

	// Limpa propriedades
	EraseObjProperty(character, "PlayerPetInLimboSerial");
	EraseObjProperty(pet, "EstaNoLimbo");
	EraseObjProperty(pet, "OriginalLocation");

	if (contrato_expirou)
		var post_serial := GetObjProperty(pet, "StablePostSerial");
		if (post_serial)
			var post := SystemFindObjectBySerial(CInt(post_serial));
			if (post && CInt(GetObjProperty(post, "StoredAnimal")) == pet.serial)
				EraseObjProperty(post, "StoredAnimal");
			endif
		endif
		EraseObjProperty(pet, "StablePostSerial");
		EraseObjProperty(pet, "DataExpiracao");
		EraseObjProperty(pet, "DataEntrada");
		EraseObjProperty(pet, "PrecoPorDia");
		EraseObjProperty(character, "CurrentStablePostSerial");
		SendSysMessage(character, "Seu contrato de estabulo expirou, mas " + pet.name + " voltou.");
	else
		SendSysMessage(character, pet.name + " voltou!");
	endif

	GetNumPets(character);

	return 1;
endfunction

function SendPetAway(character)
	var pets := ListMobilesNearLocation(character.x, character.y, character.z, MAX_PET_SCAN_RANGE,
										 character.realm);

	var controllable_pets := array{};
	foreach mob in pets
		if (mob.IsA(POLCLASS_NPC) && mob.master == character && !GetObjProperty(mob, "EstaNoLimbo") &&
			!GetObjProperty(mob, "EstaNoEstabulo") && GetObjProperty(mob, "StablePostSerial") &&
			!IsStableExpired(mob))
			controllable_pets.Append(mob);
		endif
	endforeach

	if (controllable_pets.Size() == 0)
		SendSysMessage(character, "Nenhum pet com contrato de estabulo ativo encontrado.");
		return 0;
	endif

	SendSysMessage(character, "Selecione o pet para enviar.");
	var target_pet := Target(character);

	if (!target_pet || !target_pet.IsA(POLCLASS_NPC) || target_pet.master != character || target_pet.dead)
		SendSysMessage(character, "Pet inválido.");
		return 0;
	endif

	// Verifica se o pet já foi enviado
	if (GetObjProperty(target_pet, "EstaNoLimbo"))
		SendSysMessage(character, "Este pet já está em um local seguro.");
		return 0;
	endif

	// Pet no estábulo não pode ser enviado diretamente
	if (GetObjProperty(target_pet, "EstaNoEstabulo"))
		SendSysMessage(character, "Retire o pet do estábulo antes de enviá-lo para um local seguro.");
		return 0;
	endif

	// Verifica se o pet está registrado em um estábulo
	if (!GetObjProperty(target_pet, "StablePostSerial"))
		SendSysMessage(character, "Este pet precisa estar registrado em um estabulo para ser protegido.");
		return 0;
	endif

	// Contrato de estabulo precisa estar ativo
	if (IsStableExpired(target_pet))
		SendSysMessage(character, "O contrato de estabulo deste pet expirou. Visite o estabulo.");
		return 0;
	endif

	// Prepara envio
	SetObjProperty(character, "PlayerPetInLimboSerial", target_pet.serial);
	SetObjProperty(target_pet, "EstaNoLimbo", 1);
	SetObjProperty(target_pet, "OriginalLocation", struct{ x := target_pet.x, y := target_pet.y,
													   	z := target_pet.z, realm := target_pet.realm });

	PlaySoundEffect(character, 0x336);

	// Adiciona emote antes de enviar
	PrintTextAbove(target_pet, "*correndo pro horizonte*");
	sleepms(300);

	var params := struct{ pet_serial := target_pet.serial,
					  	dest_x := 0,
					  	dest_y := 0,
					  	dest_z := 0,
					  	owner_serial := character.serial, run_away := 1 // Indica que o pet deve correr para longe antes de desaparecer
					  	
					  	};

	if (!start_script("ai/sendpetlimbo", params))
		SendSysMessage(character, "Erro ao enviar pet.");
		EraseObjProperty(character, "PlayerPetInLimboSerial");
		EraseObjProperty(target_pet, "EstaNoLimbo");
		EraseObjProperty(target_pet, "OriginalLocation");
		return 0;
	endif

	GetNumPets(character);

	SendSysMessage(character, target_pet.name + " foi para um local seguro.");
	return 1;
endfunction
