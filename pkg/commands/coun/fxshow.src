program fxshow_textcmd(mobile, args)

	if (args == "?")
		GetCmdHelp(mobile, ":commands:coun/fxshow.txt");
		return 1;
	endif

	var start_idx := 1;
	var arg := "";
	if (args)
		arg := Trim(args, TRIM_BOTH);
	endif

	if (arg.Length())
		var hex_target := CInt(arg);
		if (!hex_target)
			SendSysMessage(mobile, "Invalid hex/int: " + arg, 0x3, 0x21);
			return 0;
		endif

		var found := 0;
		var i := 1;
		while (i <= fx_list.Size())
			if (fx_list[i][2] == hex_target)
				start_idx := i;
				found := 1;
				break;
			endif
			i := i + 1;
		endwhile

		if (!found)
			SendSysMessage(mobile, "Hex 0x" + Hex(hex_target) + " not found in EFFECTS list.", 0x3, 0x21);
			return 0;
		endif
	endif

	SendSysMessage(mobile, "FX show: " + (fx_list.Size() - start_idx + 1) + " effect(s) left. Cancel target to stop.", 0x3, 0x42);

	var idx := start_idx;
	while (idx <= fx_list.Size() && mobile.connected)
		var entry := fx_list[idx];
		var fx_name := entry[1];
		var graphic := entry[2];
		var label := fx_name + " 0x" + Hex(graphic);

		SendSysMessage(mobile, "[" + idx + "/" + fx_list.Size() + "] " + label + " — target tile.", 0x3, 0x42);
		PrintTextAbove(mobile, label);

		var loc := TargetCoordinates(mobile);
		if (!loc)
			SendSysMessage(mobile, "Stopped. Resume with: .fxshow 0x" + Hex(graphic), 0x3, 0x42);
			return 1;
		endif

		var item := CreateItemAtLocation(loc.x, loc.y, loc.z, graphic, 1, loc.realm);
		if (item.errortext)
			SendSysMessage(mobile, "Failed to create " + label + " at " + loc.x + "," + loc.y + ": " + item.errortext, 0x3, 0x21);
		else
			item.name := label;
			item.decayat := 0;
			item.movable := 0;
		endif

		idx := idx + 1;
	endwhile

	SendSysMessage(mobile, "Done. All " + fx_list.Size() + " effects placed.", 0x3, 0x42);
	return 1;
endprogram
