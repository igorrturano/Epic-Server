// Local: Ex: scripts/textcmd/gm/test_classifier.src (ou testeECl.src)

use uo;
include ":faccao:include/shared_functions"; // Inclui suas funções de shared_functions
include ":faccao:include/faccao_constants"; // Para RESOURCE_TYPE_*
include ":faccao:include/logging";           // Para as funções de Log*

program TestClassifier(who) // O parâmetro é 'who'
    // O parâmetro 'who' é padrão para textcmds.

    EnableLogging(1); // Garante que o logging está ativo para este teste
    SetLogLevel(5);   // Define o nível para DEBUG para ver todos os logs

    // Use 'who' consistentemente
    LogInfo("TestClassifier", who.name + " iniciou o teste de classificação...");

    // Teste 1: Classificar por Objtype diretamente
    var objtype_to_test1 := 0xED20; // Couro Draconiano
    var category1 := ClassificarPorObjtype(objtype_to_test1);
    LogInfo("TestClassifier", "ClassificarPorObjtype(0x" + Hex(objtype_to_test1) + ") [courodraconiano] retornou: '" + category1 + "'");
    SendSysMessage(who, "Teste ClassificarPorObjtype(0x" + Hex(objtype_to_test1) + "): " + category1);

    var objtype_to_test2 := 0x6460; // Frigutium Ingot
    var category2 := ClassificarPorObjtype(objtype_to_test2);
    LogInfo("TestClassifier", "ClassificarPorObjtype(0x" + Hex(objtype_to_test2) + ") [frigutiumingot] retornou: '" + category2 + "'");
    SendSysMessage(who, "Teste ClassificarPorObjtype(0x" + Hex(objtype_to_test2) + "): " + category2);

    var objtype_to_test3 := 0x1BE3; // Glass
    var category3 := ClassificarPorObjtype(objtype_to_test3);
    LogInfo("TestClassifier", "ClassificarPorObjtype(0x" + Hex(objtype_to_test3) + ") [glass] retornou: '" + category3 + "'");
    SendSysMessage(who, "Teste ClassificarPorObjtype(0x" + Hex(objtype_to_test3) + "): " + category3);

    // Teste 2: Mapear nome para Objtype e depois Classificar
    var name_to_test1 := "courodraconiano";
    var mapped_objtype1 := MapearRecurso(name_to_test1);
    LogInfo("TestClassifier", "MapearRecurso('" + name_to_test1 + "') retornou: 0x" + Hex(mapped_objtype1));
    SendSysMessage(who, "Teste MapearRecurso('" + name_to_test1 + "'): 0x" + Hex(mapped_objtype1));
    if (mapped_objtype1)
        var category_mapped1 := ClassificarRecurso(mapped_objtype1); // Passa o objtype
        LogInfo("TestClassifier", "ClassificarRecurso(0x" + Hex(mapped_objtype1) + ") para '" + name_to_test1 + "' retornou: '" + category_mapped1 + "'");
        SendSysMessage(who, "Teste ClassificarRecurso(0x" + Hex(mapped_objtype1) + ") para '" + name_to_test1 + "': " + category_mapped1);
    endif

    var name_to_test2 := "frigutiumingot";
    var mapped_objtype2 := MapearRecurso(name_to_test2);
    LogInfo("TestClassifier", "MapearRecurso('" + name_to_test2 + "') retornou: 0x" + Hex(mapped_objtype2));
    SendSysMessage(who, "Teste MapearRecurso('" + name_to_test2 + "'): 0x" + Hex(mapped_objtype2));
    if (mapped_objtype2)
        var category_mapped2 := ClassificarRecurso(mapped_objtype2);
        LogInfo("TestClassifier", "ClassificarRecurso(0x" + Hex(mapped_objtype2) + ") para '" + name_to_test2 + "' retornou: '" + category_mapped2 + "'");
        SendSysMessage(who, "Teste ClassificarRecurso(0x" + Hex(mapped_objtype2) + ") para '" + name_to_test2 + "': " + category_mapped2);
    endif

    // Teste 3: Classificar uma string de nome diretamente
    var name_to_classify := "carvao";
    var category_name := ClassificarRecurso(name_to_classify);
    LogInfo("TestClassifier", "ClassificarRecurso('" + name_to_classify + "') retornou: '" + category_name + "'");
    SendSysMessage(who, "Teste ClassificarRecurso('" + name_to_classify + "'): " + category_name);

    LogInfo("TestClassifier", who.name + " concluiu o teste de classificação.");
    SendSysMessage(who, "Teste de classificação concluído. Verifique os logs do servidor.");
endprogram