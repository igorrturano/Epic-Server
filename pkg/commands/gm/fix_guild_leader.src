// Comando GM para corrigir problemas com guild.leader
// Uso: .fix_guild_leader [nome_da_faccao]
// Autor: Assistant
// Data: 2025-01-19

use uo;
use os;
use guilds;

include ":faccao:include/shared_functions";

program fix_guild_leader(who, text)
    if (!who || who.cmdlevel < 5)
        SendSysMessage(who, "Apenas administradores podem executar este comando.");
        return 0;
    endif
    
    text := SplitWords(text);
    var faction_name := "";
    if (text && text.size() > 0)
        faction_name := text[1];
    endif
    
    if (faction_name == "")
        SendSysMessage(who, "Uso: .fix_guild_leader <nome_da_faccao>");
        SendSysMessage(who, "Para corrigir todas as facções, use: .fix_guild_leader all");
        return 0;
    endif
    
    if (Lower(faction_name) == "all")
        FixAllGuildLeaders(who);
    else
        FixSingleGuildLeader(who, faction_name);
    endif
    
    return 1;
endprogram

/*
 * FixAllGuildLeaders(who)
 * 
 * Purpose: Corrigir todas as facções com problemas de guild.leader
 */
function FixAllGuildLeaders(who)
    SendSysMessage(who, "Iniciando correção de TODAS as facções...");
    
    var guilds_verificadas := 0;
    var guilds_corrigidas := 0;
    var erros := 0;
    
    var guild_list := ListGuilds();
    if (!guild_list)
        SendSysMessage(who, "ERRO: Não foi possível obter lista de guildas.");
        return 0;
    endif
    
    foreach guild_id in guild_list
        guilds_verificadas += 1;
        
        var guild := FindGuild(guild_id);
        if (!guild)
            erros += 1;
            continue;
        endif
        
        // Verificar se é uma facção
        var faction_name := guild.GetProp("name");
        if (!faction_name || faction_name == error)
            continue; // Não é uma facção
        endif
          var result := FixGuildLeaderProperties(guild, faction_name);
        if (result["fixed"])
            guilds_corrigidas += 1;
            SendSysMessage(who, "✅ " + faction_name + ": " + result["message"]);
        elseif (result["error"])
            erros += 1;
            SendSysMessage(who, "❌ " + faction_name + ": " + result["message"]);
        endif
        
        sleepms(50);
    endforeach
    
    SendSysMessage(who, "=== RESULTADO ===");
    SendSysMessage(who, "Facções verificadas: " + guilds_verificadas);
    SendSysMessage(who, "Facções corrigidas: " + guilds_corrigidas);
    SendSysMessage(who, "Erros: " + erros);
endfunction

/*
 * FixSingleGuildLeader(who, faction_name)
 * 
 * Purpose: Corrigir uma facção específica
 */
function FixSingleGuildLeader(who, faction_name)
    SendSysMessage(who, "Procurando facção: " + faction_name);
    
    var guild_id := FindGuildByName(faction_name);
    if (!guild_id)
        SendSysMessage(who, "ERRO: Facção '" + faction_name + "' não encontrada.");
        return 0;
    endif
    
    var guild := FindGuild(guild_id);
    if (!guild)
        SendSysMessage(who, "ERRO: Não foi possível acessar a facção.");
        return 0;
    endif
    
    SendSysMessage(who, "Facção encontrada (ID: " + guild_id + ")");
      var result := FixGuildLeaderProperties(guild, faction_name);
    if (result["fixed"])
        SendSysMessage(who, "✅ CORRIGIDO: " + result["message"]);
    elseif (result["error"])
        SendSysMessage(who, "❌ ERRO: " + result["message"]);
    else
        SendSysMessage(who, "ℹ️ OK: " + result["message"]);
    endif
endfunction

/*
 * FixGuildLeaderProperties(guild, faction_name)
 * 
 * Purpose: Verificar e corrigir propriedades de liderança de uma guilda
 * Returns: struct com resultado da operação
 */
function FixGuildLeaderProperties(guild, faction_name)
    var result := struct{
        "fixed" := 0,
        "error" := 0,
        "message" := ""
    };
    
    var current_leader := guild.leader;
    var guildmaster := guild.guildmaster;
    var custom_leader := guild.GetProp("leader");
    
    // Diagnóstico detalhado
    var diag := "leader=" + CStr(current_leader) + ", guildmaster=" + CStr(guildmaster) + ", custom=" + CStr(custom_leader);
    
    var needs_fix := 0;
    var fix_reason := "";
    
    // Verificar se guild.leader está bugado
    if (!current_leader || current_leader == error || 
        CStr(current_leader) == "<uninitialized object>")
        needs_fix := 1;
        fix_reason := "guild.leader está <uninitialized object>";
    // Verificar inconsistência entre guild.leader e guildmaster
    elseif (guildmaster && guildmaster != error && 
            current_leader != guildmaster)
        needs_fix := 1;
        fix_reason := "guild.leader != guildmaster";
    // Verificar inconsistência entre guild.leader e custom leader
    elseif (custom_leader && custom_leader != error && 
            custom_leader != current_leader)
        needs_fix := 1;
        fix_reason := "guild.leader != custom leader";
    endif
      if (!needs_fix)
        result["message"] := "Propriedades já estão corretas (" + diag + ")";
        return result;
    endif
    
    // Determinar o líder correto (prioridade: guildmaster > custom_leader)
    var correct_leader := guildmaster;
    if (!correct_leader && custom_leader && custom_leader != error)
        correct_leader := custom_leader;
    endif
    
    if (correct_leader)
        // Corrigir definindo ambas as propriedades
        guild.SetProp("leader", correct_leader);
        guild.leader := correct_leader;
        
        // Atualizar guild_rank do jogador se estiver online
        var player := SystemFindObjectBySerial(correct_leader);
        if (player)
            player.SetProp("guild_rank", "Lider");
        endif
        
        result["fixed"] := 1;
        result["message"] := "Corrigido: " + fix_reason + " (novo leader: " + correct_leader + ")";
    else
        // Limpar liderança se não há líder válido
        guild.SetProp("leader", 0x0);
        guild.leader := 0x0;
        
        result["fixed"] := 1;
        result["message"] := "Limpado: Nenhum líder válido encontrado (" + fix_reason + ")";
    endif
    
    return result;
endfunction
