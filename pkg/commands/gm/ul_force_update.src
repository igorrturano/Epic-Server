// Comando temporário sub-fase 1.D.2.b — remover quando sub-fase 1.F encerrar.

use uo;
use basic;

include ":ultimalive:include/packets";

program ul_force_update(who, text)
    var args := SplitWords(text);
    if (Len(args) < 2)
        SendSysMessage(who, "Uso: .ul_force_update <blockX> <blockY>");
        return 0;
    endif

    var blockX := CInt(args[1]);
    var blockY := CInt(args[2]);

    if (blockX < 0 || blockY < 0)
        SendSysMessage(who, "blockX e blockY devem ser >= 0.");
        return 0;
    endif

    var result := UL_SendBlockUpdate(who, who.realm, blockX, blockY);
    if (result == error)
        SendSysMessage(who, "Erro ao enviar 0x40: " + result.errortext);
        return 0;
    endif

    SendSysMessage(who, "Packet 0x40 enviado: realm=" + who.realm + " blockX=" + blockX + " blockY=" + blockY + ". Veja log do POL.");
    return 1;
endprogram
