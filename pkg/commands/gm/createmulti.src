use uo;
use os;


include ":attributes:attributes";
include "include/sounds";
include ":fls_core:packets";
program textcmd_CreateHouse(who, text)

    var opt := CInt(text);
    if (!opt)
        SendSysMessage(who, "Uso: .CreateHouse [objtype_da_casa]");
        SendSysMessage(who, "Exemplo: .CreateHouse 0xc962");
        return 0;
    endif

    SendSysMessage(who, "Escolha onde quer colocar a casa.");
    var where := Target(who);
    if (!where)
        SendSysMessage(who, "Cancelado.");
        return 0;
    endif
	
    // Pega a altura Z do chão do reino ALT para garantir a posição correta
	var mi_alt := GetMapInfo(where.x, where.y, "britannia_alt");
	if (!mi_alt)
		SendSysMessage(who, "Não foi possível obter informações do mapa para o reino 'britannia_alt'.", SSM_FAIL);
		return 0;
	endif
	
	var x := where.x;
	var y := where.y;
	var z := mi_alt.z;
	
    // Flags para ignorar todas as regras de posicionamento
    const CIMULTI_IGNORE_ALL := 0x100; 

    SendSysMessage(who, "Tentando criar a casa " + Hex(opt) + " em " + x + "," + y + "," + z + " no reino 'britannia_alt'");
    
    // Cria o multi FORÇADAMENTE no reino ALT
    var house := CreateMultiAtLocation(x, y, z, opt, CIMULTI_IGNORE_ALL, "britannia_alt");
    
    if (house.errortext)
        SendSysMessage(who, "FALHA ao criar a casa. Erro do Core: " + house.errortext, SSM_FAIL);
        return 0;
    endif
    
    SendSysMessage(who, "Casa criada com sucesso! Serial: " + house.serial, SSM_INFO);
    SendSysMessage(who, "Use '.go " + x + " " + y + " " + z + " britannia_alt' para visitar.");

    // Configurações básicas para a casa
    SetObjProperty(house, "ownerserial", who.serial);
    SetObjProperty(house, "owneracct", who.acctname);
    house.decayat := 0;

    return 1;
endprogram