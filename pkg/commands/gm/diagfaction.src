use uo;
use os;
use datafile;
use guilds;

include ":faccao:include/shared_functions";
include ":faccao:include/logging";
include ":faccao:include/datafile_helpers";
include ":faccao:include/territory_management";
include ":faccao:include/faccao_resources";
include ":gumps:yesNo";

/*
 * Comando: .diagfaction
 * 
 * Diagnostica problemas no sistema de facções
 * Uso: .diagfaction [nome_da_faccao]
 */

program diagfaction(who, params)
    if (who.cmdlevel < 2)
        return SendSysMessage(who, "Este comando é exclusivo para GMs.");
    endif
    
    SendSysMessage(who, "=== DIAGNÓSTICO DO SISTEMA DE FACÇÕES ===");
    
    var specific_faction := "";
    if (params && params != "")
        specific_faction := params;
        SendSysMessage(who, "Analisando facção específica: " + specific_faction);
    else
        SendSysMessage(who, "Analisando TODAS as facções do sistema");
    endif
    
    // Estrutura do relatório
    var report := struct{
        "guilds_total" := 0,
        "guilds_duplicadas" := 0,
        "territorios_total" := 0,
        "territorios_inconsistentes" := 0,
        "capitais_multiplas" := 0,
        "objetos_orfaos" := 0,
        "problemas_criticos" := array{},
        "avisos" := array{}
    };
    
    // 1. Análise de Guildas
    AnalisarGuildas(who, report, specific_faction);
    
    // 2. Análise de Territórios
    AnalisarTerritorios(who, report, specific_faction);
    
    // 3. Análise de Capitais
    AnalisarCapitais(who, report, specific_faction);
    
    // 4. Análise de Objetos
    AnalisarObjetos(who, report, specific_faction);
    
    // 5. Mostrar Relatório Final
    ExibirRelatorioFinal(who, report, specific_faction);
    
    return 1;
endprogram

function AnalisarGuildas(who, byref report, specific_faction)
    SendSysMessage(who, ">> Analisando guildas...");
    
    var guilds := ListGuilds();
    var guild_names := dictionary{};
    var problemas_guild := array{};
    
    foreach guild_id in guilds
        var guild := FindGuild(guild_id);
        if (!guild) continue; endif
        
        var name := guild.GetProp("name");
        if (!name) name := guild.guildname; endif
        
        report.guilds_total += 1;
        
        // Se está analisando facção específica, pular outras
        if (specific_faction != "" && Lower(name) != Lower(specific_faction))
            continue;
        endif
        
        // Verificar duplicações
        if (guild_names.exists(name))
            report.guilds_duplicadas += 1;
            problemas_guild.append("Guilda DUPLICADA: " + name);
        else
            guild_names[name] := guild_id;
        endif
        
        // Verificar estrutura da guilda
        var leader := guild.GetProp("leader");
        var territories := guild.GetProp("territories");
        var members_count := guild.members.size();
        
        SendSysMessage(who, "   • " + name + " (ID: " + guild_id + ", Membros: " + members_count + ")");
        
        if (!leader)
            problemas_guild.append(name + ": Sem líder definido");
        endif
        
        if (!territories || TypeOf(territories) != "Array")
            problemas_guild.append(name + ": Lista de territórios inválida");
        else
            SendSysMessage(who, "     Territórios: " + territories.size());
        endif
        
        sleepms(2);
    endforeach
    
    // Adicionar problemas ao relatório
    foreach problema in problemas_guild
        report.problemas_criticos.append(problema);
        sleepms(2);
    endforeach
    
    SendSysMessage(who, "   ✓ Total de guildas: " + report.guilds_total);
    if (report.guilds_duplicadas > 0)
        SendSysMessage(who, "   ⚠ Guildas duplicadas: " + report.guilds_duplicadas);
    endif
endfunction

function AnalisarTerritorios(who, byref report, specific_faction)
    SendSysMessage(who, ">> Analisando territórios...");
    
    var territories_df := SafeOpenDataFile(":architect:areas");
    if (!territories_df)
        report.problemas_criticos.append("CRÍTICO: Datafile de territórios inacessível");
        return;
    endif
    
    var problemas_territorio := array{};
    
    foreach territory_name in (territories_df.keys())
        var elem := SafeFindElement(territories_df, territory_name);
        if (!elem) continue; endif
        
        report.territorios_total += 1;
        
        var faction := GetElementProp(elem, "faction", "");
        if (!faction) faction := GetElementProp(elem, "Faction", ""); endif
        
        // Se está analisando facção específica
        if (specific_faction != "" && Lower(faction) != Lower(specific_faction))
            continue;
        endif
        
        var territory_id := GetElementProp(elem, "territory_id", "");
        var resources := GetElementProp(elem, "Resources", "");
        var rect := GetElementProp(elem, "Rect", "");
        var realm := GetElementProp(elem, "Realm", "");
        
        SendSysMessage(who, "   • " + territory_name + " (Facção: " + faction + ")");
        
        // Verificar problemas
        var problemas_locais := array{};
        
        if (!territory_id)
            problemas_locais.append("Sem ID único");
        endif
        
        if (!rect)
            problemas_locais.append("Sem coordenadas");
        endif
        
        if (!realm)
            problemas_locais.append("Sem realm definido");
        endif
        
        if (faction && faction != "Selvagem" && !resources)
            problemas_locais.append("Território controlado sem recursos");
        endif
        
        if (!faction && resources)
            problemas_locais.append("Território selvagem com recursos");
        endif
        
        if (problemas_locais.size() > 0)
            report.territorios_inconsistentes += 1;
            problemas_territorio.append(territory_name + ": " + ", ".join(problemas_locais));
            SendSysMessage(who, "     ⚠ " + ", ".join(problemas_locais));
        endif
        
        sleepms(2);
    endforeach
    
    // Adicionar problemas ao relatório
    foreach problema in problemas_territorio
        report.avisos.append(problema);
        sleepms(2);
    endforeach
    
    SendSysMessage(who, "   ✓ Total de territórios: " + report.territorios_total);
    if (report.territorios_inconsistentes > 0)
        SendSysMessage(who, "   ⚠ Territórios inconsistentes: " + report.territorios_inconsistentes);
    endif
endfunction

function AnalisarCapitais(who, byref report, specific_faction)
    SendSysMessage(who, ">> Analisando capitais...");
    
    var territories_df := SafeOpenDataFile(":architect:areas");
    if (!territories_df) return; endif
    
    var capitals_by_faction := dictionary{};
    
    foreach territory_name in (territories_df.keys())
        var elem := SafeFindElement(territories_df, territory_name);
        if (!elem) continue; endif
        
        var faction := GetElementProp(elem, "faction", "");
        if (!faction) faction := GetElementProp(elem, "Faction", ""); endif
        
        var is_capital := GetElementProp(elem, "is_capital", 0);
        
        if (is_capital && faction && faction != "Selvagem")
            // Se está analisando facção específica
            if (specific_faction != "" && Lower(faction) != Lower(specific_faction))
                continue;
            endif
            
            if (!capitals_by_faction.exists(faction))
                capitals_by_faction[faction] := array{};
            endif
            capitals_by_faction[faction].append(territory_name);
        endif
        
        sleepms(2);
    endforeach
    
    foreach faction in (capitals_by_faction.keys())
        var capitals := capitals_by_faction[faction];
        SendSysMessage(who, "   • " + faction + ": " + capitals.size() + " capital(is)");
        
        if (capitals.size() > 1)
            report.capitais_multiplas += 1;
            report.problemas_criticos.append(faction + " tem " + capitals.size() + " capitais");
            foreach capital in capitals
                SendSysMessage(who, "     - " + capital);
                sleepms(2);
            endforeach
        else
            SendSysMessage(who, "     - " + capitals[1]);
        endif
        
        sleepms(2);
    endforeach
endfunction

function AnalisarObjetos(who, byref report, specific_faction)
    SendSysMessage(who, ">> Analisando objetos de território...");
    
    var tipos_territorio := array{0xFF11, 0xFE5C, 0x46AE}; // Baú, Mesa, Mural
    var objetos_por_faccao := dictionary{};
    var objetos_orfaos := array{};
    
    foreach item in EnumerateItemsInContainer(0)
        if (item.objtype in tipos_territorio)
            var faction := GetObjProperty(item, "faction");
            var territory_id := GetObjProperty(item, "territory_id");
            
            if (faction)
                // Se está analisando facção específica
                if (specific_faction != "" && Lower(faction) != Lower(specific_faction))
                    continue;
                endif
                
                if (!objetos_por_faccao.exists(faction))
                    objetos_por_faccao[faction] := struct{
                        "baus" := 0,
                        "mesas" := 0,
                        "murais" := 0,
                        "orfaos" := 0
                    };
                endif
                
                case (item.objtype)
                    0xFF11: objetos_por_faccao[faction].baus += 1;
                    0xFE5C: objetos_por_faccao[faction].mesas += 1;
                    0x46AE: objetos_por_faccao[faction].murais += 1;
                endcase
                
                // Verificar se é órfão
                if (territory_id)
                    var territory_exists := TM_FindTerritory(territory_id) ? 1 : 0;
                    if (!territory_exists)
                        objetos_por_faccao[faction].orfaos += 1;
                        report.objetos_orfaos += 1;
                        objetos_orfaos.append(item.name + " (Serial: " + item.serial + ")");
                    endif
                endif
            endif
        endif
        sleepms(1);
    endforeach
    
    foreach faction in (objetos_por_faccao.keys())
        var obj := objetos_por_faccao[faction];
        SendSysMessage(who, "   • " + faction + ":");
        SendSysMessage(who, "     Baús: " + obj.baus + ", Mesas: " + obj.mesas + ", Murais: " + obj.murais);
        if (obj.orfaos > 0)
            SendSysMessage(who, "     ⚠ Objetos órfãos: " + obj.orfaos);
        endif
        sleepms(2);
    endforeach
    
    if (objetos_orfaos.size() > 0)
        foreach orfao in objetos_orfaos
            report.avisos.append("Objeto órfão: " + orfao);
            sleepms(2);
        endforeach
    endif
endfunction

function ExibirRelatorioFinal(who, report, specific_faction)
    SendSysMessage(who, "");
    SendSysMessage(who, "=== RELATÓRIO FINAL ===");
    
    if (specific_faction != "")
        SendSysMessage(who, "Facção analisada: " + specific_faction);
    else
        SendSysMessage(who, "Análise completa do sistema");
    endif
    
    SendSysMessage(who, "");
    SendSysMessage(who, "📊 ESTATÍSTICAS:");
    SendSysMessage(who, "  • Total de guildas: " + report.guilds_total);
    SendSysMessage(who, "  • Total de territórios: " + report.territorios_total);
    
    SendSysMessage(who, "");
    SendSysMessage(who, "🔍 PROBLEMAS ENCONTRADOS:");
    SendSysMessage(who, "  • Guildas duplicadas: " + report.guilds_duplicadas);
    SendSysMessage(who, "  • Territórios inconsistentes: " + report.territorios_inconsistentes);
    SendSysMessage(who, "  • Facções com múltiplas capitais: " + report.capitais_multiplas);
    SendSysMessage(who, "  • Objetos órfãos: " + report.objetos_orfaos);
    
    var total_problemas := report.guilds_duplicadas + report.territorios_inconsistentes + 
                          report.capitais_multiplas + report.objetos_orfaos;
    
    if (total_problemas == 0)
        SendSysMessage(who, "");
        SendSysMessage(who, "✅ SISTEMA SAUDÁVEL!");
        SendSysMessage(who, "Nenhum problema crítico encontrado.");
        return;
    endif
    
    SendSysMessage(who, "");
    SendSysMessage(who, "⚠ PROBLEMAS CRÍTICOS:");
    foreach problema in (report.problemas_criticos)
        SendSysMessage(who, "  • " + problema);
        sleepms(2);
    endforeach
    
    if (report.avisos.size() > 0)
        SendSysMessage(who, "");
        SendSysMessage(who, "⚡ AVISOS:");
        foreach aviso in (report.avisos)
            SendSysMessage(who, "  • " + aviso);
            sleepms(2);
        endforeach
    endif
    
    SendSysMessage(who, "");
    SendSysMessage(who, "💡 Para corrigir automaticamente: .repairfaction");
    if (specific_faction != "")
        SendSysMessage(who, "💡 Para reparar só esta facção: .repairfaction " + specific_faction);
    endif
endfunction