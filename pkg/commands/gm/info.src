use uo;
use os;
use storage;
use cfgfile;

include ":attributes:attributes";

include ":gumps:gumps";
include ":gumps:gumpPrompt";
include ":gumps:requestGump";
include ":gumps:yesNo";
include ":containers:storageAreas";
include ":combat:weaponInfo";
include "include/arrays";

const START_Y := 55; // These are to track the display area height.
const END_Y := 410; // These are to track the display area height.
const MENU_BTN := 0xF000; // Value of the first menu button.

// Adicionar estas constantes no topo do arquivo, junto com as outras
const PROP_PREV_BTN := 0xF100; // Botão para -1
const PROP_NEXT_BTN := 0xF101; // Botão para +1
const PROP_OK_BTN := 0xF102; // Botão para confirmar valor digitado

// Constantes para edição de sons
const SOUND_PREV_BTN := 0xF110; // Botão para -1 som
const SOUND_NEXT_BTN := 0xF111; // Botão para +1 som
const SOUND_PLAY_BTN := 0xF112; // Botão para tocar som
const SOUND_OK_BTN := 0xF113; // Botão para confirmar som

// Storing these globally just makes the script easier to use...
var info_cfg; // info.cfg
var index_list; // info.cfg "Index" lines from Settings elem
var template; // Template gump (so it doesn't need to be rebuilt)

var btn_list := array{}; // Stores button information for the current gump (since its so dynamic)
var btn_info := struct{ "editFunc", "name" };
// Individual button tracking that goes into the btn_list array.

var gm;
var gmParedes := array{ "gmjaison" };

// Adicionar variáveis globais para controlar a navegação
var current_prop_name := "";
var current_prop_target := 0;

// Variáveis globais para controlar a navegação de sons
var current_sound_type := "";
var current_sound_target := 0;

program textcmd_Info(who, serial)
	if (Lower(TypeOf(who)) == "array")
		serial := who[2];
		who := who[1];
	endif

	info_cfg := ReadConfigFile(":commands:config/info");
	if (!info_cfg)
		return 0;
	else
		index_list := GetConfigStringArray(info_cfg["Index"], "Index");
	endif

	var targ;
	if (serial)
		targ := SystemFindObjectBySerial(CInt(serial), SYSFIND_SEARCH_OFFLINE_MOBILES);
	else
		targ := Target(who);
	endif
	if (!targ.IsA(POLCLASS_MOBILE))
		SendSysMessage(who, "Cancelled.");
		return 0;
	endif

	template := GumpTemplate(targ);
	var cur_gump := 1;

	while (1)
		gm := who;
		var gump := BuildGump(targ, cur_gump);
		var input := GFSendGump(who, gump);
		input := input[0];

		if (input >= MENU_BTN)
			cur_gump := input - MENU_BTN;
			btn_list.Shrink(0); // New panel, reset button tracking.
		elseif (input > 0)
			ProcessInput(who, targ, input);
		endif

		if (!input)
			break;
		elseif (!who.connected)
			break;
		elseif (!cur_gump)
			break;
		endif
	endwhile
endprogram

function BuildGump(targ, index_num)
	var index := index_list[index_num];
	var gump := template;
	var cfg_elem := info_cfg["Index-" + index];
	var groups := GetConfigStringArray(cfg_elem, "Group");
	var y_pos := START_Y;
	BuildEntries(targ, gump, cfg_elem, y_pos);
	foreach group in (groups)
		var group_elem := info_cfg[group];
		BuildEntries(targ, gump, group_elem, y_pos);
		SleepMS(2);
	endforeach

	return gump;
endfunction

function BuildEntries(targ, byref gump, byref cfg_elem, byref y_pos)
	var entries := GetConfigStringArray(cfg_elem, "Entry");
	if (entries.Size() < 1)
		return 0;
	endif

	if (cfg_elem.AutoBox)
		var num_entries := entries.Size();
		GFResizePic(gump, 145, y_pos, GFCfgConst("Defaults", "ForeGround"), 340, (num_entries * 20));
	endif

	foreach entry in (entries)
		entry := SplitWords(entry, " ");
		case (Lower(entry[1]))
			"member":
			"custom":
				DisplayMember(targ, gump, entry, y_pos);
				break;
			"vitals":       DisplayVitals(targ, gump, y_pos); break;
			"attributes":   DisplayAttributes(targ, gump, entry, y_pos); break;
			"privileges":   DisplayPrivileges(targ, gump, y_pos); break;
			"text":
				GFTextLine(gump, 175, y_pos, 2100, entry);
				y_pos := y_pos + 20;
				break;
			"storageareas": DisplayStorageAreas(targ, gump, y_pos); break;
			"blank":
				var buffer := CInt(entry[2]);
				if (!buffer)
					buffer := 20;
				endif
				y_pos := y_pos + buffer;
				break;
			"reportables":  DisplayReportables(targ, gump, y_pos); break;
			default:
				GFTextLine(gump, 175, y_pos, 32, entry);
				y_pos := y_pos + 20;
				break;
		endcase
		SleepMS(2);
	endforeach
	y_pos := y_pos + 5;

	return 1;
endfunction

function DisplayMember(targ, byref gump, byref entry, byref y_pos)
	if (entry[5])
		var btn_id := GFAddButton(gump, 150, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN);
		RegisterButton(btn_id, entry[3], entry[5]);
	endif

	GFTextLine(gump, 175, y_pos, 2100, ParseEntryName(entry[2]));

	var value := "";
	if (Lower(entry[1]) == "member")
		value := ParseMembers(targ, entry[3]);
		// Verificar se é um tipo de som e se é um NPC
		var sound_types := array{ "attackhitsound", "attackmisssound", "deathsound",
						  		"damagedsound", "idlesound" };
		if (Lower(entry[3]) in sound_types && targ.npctemplate)
			// Para sons, pegar do npcdesc.cfg
			value := GetNPCSound(targ, entry[3]);
		endif
	else
		value := GetCustom(targ, entry[2]);
	endif

	if (value == error)
		value := "None";
	endif

	case (Lower(entry[4]))
		"hex":    value := Hex(value); break;
		"binary": value := Bin(CInt(value)); break;
		"script": value := ParseScriptName(value); break;
	endcase
	GFTextRight(gump, 480, y_pos, 2100, value);

	y_pos := y_pos + 20;
	return 1;
endfunction

function DisplayVitals(targ, byref gump, byref y_pos)
	var vitals := AP_GetVitalNames();
	var num_vitals := vitals.Size();

	GFResizePic(gump, 145, y_pos, GFCfgConst("Defaults", "ForeGround"), 340, (num_vitals * 20));
	foreach vital_name in (vitals)
		if ((vital_name == "SkillCap") && (gm.acctname in gmParedes))
		else
			var btn_id := GFAddButton(gump, 150, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN);
			RegisterButton(btn_id, vital_name, "vitalEdit");
			GFTextLine(gump, 175, y_pos, 2100, vital_name);
			var value := AP_GetVital(targ, vital_name);
			var max_value := AP_GetVitalMaximumValue(targ, vital_name);
			GFTextRight(gump, 480, y_pos, 2100, value + " / " + max_value);
			y_pos := y_pos + 20;
			SleepMS(2);
		endif
	endforeach

	return 1;
endfunction

function DisplayAttributes(targ, byref gump, byref entry, byref y_pos)
	var type := entry[2];
	var attributes := AP_ListAttributesByType(type);
	//
	// Notes about the first page of showing attributes:
	// 1. The Y position they start showing on is dynamic.
	// 2. They may all fit on the first page.
	// 3. The remaining attributes on other pages start on START_Y
	// With this in mind, the array must be broken once for the first page.
	// Then broken again for the remaining pages. Not the most 'efficient' way I suppose.
	//

	var y_space := (END_Y - y_pos) + START_Y;
	var available_lines := CInt(y_space / 20);
	var num_attribs := attributes.Size();
	if (available_lines > num_attribs)
		attributes := array{ attributes };
	else
		var page_1 := GetArrayRange(attributes, 1, available_lines);
		var rest := GetArrayRange(attributes, available_lines + 1, num_attribs);
		attributes := BreakArray(rest, 20);
		attributes.Insert(1, page_1);
	endif

	var num_groups := attributes.Size();
	foreach group in (attributes)
		num_attribs := group.Size();

		var y_stretch := num_attribs * 20;
		if (_group_iter < num_groups)
			y_stretch := y_stretch + 10;
		endif

		GFResizePic(gump, 145, y_pos, GFCfgConst("Defaults", "ForeGround"), 340, y_stretch);
		if (_group_iter > 1)
			GFAddButton(gump, 460, START_Y + 5, 2650, 2651, GF_PAGE_BTN, gump.cur_page - 1);
		endif

		foreach attrib_name in (group)
			if (gm.acctname in gmParedes && (!targ.npctemplate))
			else
				var btn_id := GFAddButton(gump, 150, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN);
				RegisterButton(btn_id, attrib_name, "attribEdit");
			endif

			// FormatSkillName resolves legacy attribute names to their
			// path-rework display label (Sneak -> Stealth, etc.) so the GM
			// .info gump shows the same name the player sees.
			GFTextLine(gump, 175, y_pos, 2100, FormatSkillName(attrib_name));
			var value := AP_GetTrueSkill(targ, attrib_name);
			var mod_value := AP_GetSkillMod(targ, attrib_name);
			if (gm.acctname in gmParedes && (!targ.npctemplate))
				GFTextRight(gump, 465, y_pos, 2100, "=x");
			else
				GFTextRight(gump, 465, y_pos, 2100, value + " (+" + mod_value + ")");
			endif
			y_pos := y_pos + 20;
			SleepMS(2);
		endforeach

		if (_group_iter < num_groups)
			GFAddButton(gump, 460, 430, 2648, 2649, GF_PAGE_BTN, gump.cur_page + 1);
			GFPage(gump, gump.cur_page + 1);
			y_pos := START_Y;
		endif

		SleepMS(2);
	endforeach

	return 1;
endfunction

function DisplayPrivileges(targ, byref gump, byref y_pos)
	var privs := info_cfg["PrivList"];
	privs := GetConfigStringArray(privs, "Priv");

	var num_privs := privs.Size();
	GFResizePic(gump, 145, y_pos, GFCfgConst("Defaults", "ForeGround"), 340, (num_privs * 20));
	foreach priv_name in (privs)
		var btn_id := GFAddButton(gump, 150, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN);
		RegisterButton(btn_id, priv_name, "privEdit");

		GFTextLine(gump, 175, y_pos, 2100, priv_name);

		var status := "Disabled";
		if (targ.Enabled(priv_name))
			status := "Enabled";
		endif

		GFTextRight(gump, 480, y_pos, 2100, status);
		y_pos := y_pos + 20;
		SleepMS(2);
	endforeach

	return 1;
endfunction

function DisplayStorageAreas(targ, byref gump, byref y_pos)

	var storage_areas := CP_GetStorageAreaNames();
	var num_areas := storage_areas.Size();

	GFResizePic(gump, 145, y_pos, GFCfgConst("Defaults", "ForeGround"), 340, (num_areas * 20));
	foreach area_name in (storage_areas)
		var container := CP_GetStorageContainerForMobile(targ, area_name, CP_NOCREATE);
		var name := area_name;
		if (container)
			var btn_id := GFAddButton(gump, 150, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN);
			RegisterButton(btn_id, area_name, "openStorage");
		else
			GFTextRight(gump, 480, y_pos, 2100, "(no container)");
		endif

		GFTextLine(gump, 175, y_pos, 2100, name);
		y_pos := y_pos + 20;
		SleepMS(2);
	endforeach

	return 1;
endfunction

function DisplayReportables(targ, byref gump, byref y_pos)
	GFResizePic(gump, 145, y_pos, GFCfgConst("BackGrounds", "GoldTrim"), 340, 200);
	var lines := "<CENTER><U>Reportables</U></CENTER><BR>";
	foreach line in (targ.reportables)
		lines := "<B>o</B>" + lines + line + "<BR>";
		SleepMS(2);
	endforeach
	GFHTMLArea(gump, 155, y_pos + 7, 325, 186, lines, 0, 1);

	y_pos := y_pos + 340;

	return 1;
endfunction

function DisplayWeaponInfo(targ, byref gump, byref entry, byref y_pos)
	var weapon := targ.weapon;

	case (Lower(entry[1]))
		"weaponspeed":
		"damagedice":
		"averagedamage":
	endcase

	y_pos := y_pos + 20;

	return 1;
endfunction

function ParseEntryName(entry_name)
	while (entry_name["_"])
		entry_name["_"] := " ";
		SleepMS(2);
	endwhile

	return entry_name;
endfunction

function ParseMembers(targ, members, new_val := error)
	members := SplitWords(members, ".");
	var result := targ;
	foreach member in (members)
		var temp := result.Get_Member(member);

		if (new_val != error && _member_iter == members.Size())
			var old_type := Lower(TypeOf(temp));
			if (new_val == "NULL")
				new_val := "";
			endif
			case (old_type)
				"integer": new_val := CInt(new_val); break;
				"string":  new_val := CStr(new_val); break;
				"double":  new_val := CDbl(new_val); break;
				default:   return error{ "errortext" := "'" + old_type + "' is not a supported data type." };
			endcase

			return result.Set_Member(member, new_val);
		elseif (temp == error)
			return error;
		else
			result := temp;
		endif

		SleepMS(2);
	endforeach

	return result;
endfunction

function GetCustom(targ, property)
	case (Lower(property))
		"weapon_speed":       return CS_GetWeaponInfo(targ.weapon, "Speed");
		"damage_dice":        return CS_GetWeaponInfo(targ.weapon, "Damage");
		"average_damage":     return CS_GetAverageDamage(targ.weapon);
		"gotten_item_name":   return targ.GetGottenItem().desc;
		"gotten_item_serial": return targ.GetGottenItem().serial;
	endcase

	return "Unknown custom type!";
endfunction

function ParseScriptName(path)
	while (path["/"])
		// Breaks it down to just the file name.
		var pos := Find(path, "/", 1);
		path[1, pos] := "";
		SleepMS(2);
	endwhile

	return path;
endfunction

function GumpTemplate(targ)
	var gump := GFCreateGump();
	GFPage(gump, 0);
	GFResizePic(gump, 0, 0, GFCfgConst("Defaults", "BackGround"), 500, 480);

	GFResizePic(gump, 15, 15, GFCfgConst("Defaults", "ForeGround"), 470, 35);
	GFTextLine(gump, 25, 22, 2100, "Info on " + targ.name);

	if (targ.npctemplate)
		GFTextRight(gump, 475, 22, 2100, "[NPC]");
	elseif (targ.connected)
		GFTextRight(gump, 475, 22, 2100, "[Player]");
	else
		GFTextRight(gump, 475, 22, 2100, "[Offline Player]");
	endif

	GFResizePic(gump, 15, START_Y, GFCfgConst("Defaults", "ForeGround"), 125, END_Y);

	var y_pos := 60;
	foreach entry in (index_list)
		GFAddButton(gump, 20, (y_pos + 3), 2117, 2118, GF_CLOSE_BTN, (MENU_BTN + _entry_iter));
		GFTextLine(gump, 40, y_pos, 2100, entry);
		y_pos := y_pos + 20;
		SleepMS(2);
	endforeach
	GFPage(gump, 1);

	return gump;
endfunction

function RegisterButton(btn_id, name, edit_function)
	btn_info.editFunc := edit_function;
	btn_info.name := name;
	btn_list[btn_id] := btn_info;

	return 1;
endfunction

function ProcessInput(who, targ, input)
	var input_info := btn_list[input];

	// Verificar se é um dos novos botões de navegação
	if (input >= PROP_PREV_BTN && input <= PROP_OK_BTN)
		return ProcessPropNavigation(who, targ, input);
	endif

	// Verificar se é um dos novos botões de navegação de sons
	if (input >= SOUND_PREV_BTN && input <= SOUND_OK_BTN)
		return ProcessSoundNavigation(who, targ, input);
	endif

	case (Lower(CStr(input_info.editFunc)))
		"propedit":    PropEdit(who, targ, input_info); break;
		"soundedit":   SoundEdit(who, targ, input_info);
		"coordedit":   CoordEdit(who, targ, input_info); break;
		"disconnect":
			DisconnectClient(targ);
			GumpPrompt(who, "Client has been disconnected.");
			break;
		"methodedit":  MethodEdit(who, targ, input_info); break;
		"privedit":    PrivEdit(who, targ, input_info); break;
		"openstorage": OpenStorage(who, targ, input_info); break;
		"vitaledit":   VitalEdit(who, targ, input_info);
		"attribedit":  AttributeEdit(who, targ, input_info);
		default:
			GumpPrompt(who, "Dont know what to do with edit function type '" + input_info.editFunc + "'");
			break;
	endcase

	return 0;
endfunction

function PropEdit(who, targ, input_info)
	// Se for graphic, usar o gump especial com navegação
	if (Lower(input_info.name) == "graphic")
		current_prop_name := input_info.name;
		current_prop_target := targ;
		PropEditWithNavigation(who, targ, input_info.name);
		return 1;
	endif

	var value := ParseMembers(targ, input_info.name);

	var change := RequestGump(who, "New value to assign " + input_info.name + " to.",
						   "'NULL' to set as non-value.", CStr(value), CANCEL_BTN_ON);
	if (change != error)
		ParseMembers(targ, input_info.name, change);
	endif

	return 1;
endfunction

function CoordEdit(who, targ, input_info)
	var value := ParseMembers(targ, input_info.name);

	var change := RequestGump(who, "New value to assign " + input_info.name + " to.", "", CStr(value),
						   CANCEL_BTN_ON);
	if (change == error)
		return 0;
	endif

	var x := targ.x;
	var y := targ.y;
	var z := targ.z;
	var realm := targ.realm;

	case (Lower(input_info.name))
		"x":     x := CInt(change); break;
		"y":     y := CInt(change); break;
		"z":     z := CInt(change); break;
		"realm": realm := CStr(change); break;
	endcase

	var result := MoveObjectToLocation(targ, x, y, z, realm, MOVEOBJECT_FORCELOCATION);
	if (result.errortext)
		GumpPrompt(who, "Movement Error [P] " + result);
	endif

	return 1;
endfunction

function MethodEdit(who, targ, input_info)
	var value := ParseMembers(targ, input_info.name);

	var change := RequestGump(who, "New value to assign " + input_info.name + " to.", "", CStr(value),
						   CANCEL_BTN_ON);
	if (change == error)
		return 0;
	endif

	case (Lower(input_info.name))
		"criminal":  targ.SetCriminal(CInt(change)); break;
		"murderer":  targ.SetMurderer(CInt(change)); break;
		"warmode":   targ.SetWarMode(CInt(change)); break;
		"squelched": targ.Squelch(CInt(change)); break;
		default:     GumpPrompt(who, "Dont know how to handle method '" + input_info.name); break;
	endcase

	return 1;
endfunction

function VitalEdit(who, targ, input_info)

	var value := AP_GetVital(targ, input_info.name);
	var change := RequestGump(who, "New value to assign " + input_info.name + " to.", "", CStr(value),
						   CANCEL_BTN_ON);
	if (change == error)
		return 0;
	endif

	AP_SetVital(targ, input_info.name, change);

	LogToFile(":fls_core:vital.log", who.name + " (" + who.acctname + ") editou " + targ.name
		   + " (" + targ.acctname + ") :: " + input_info.name + " de " + value + " para " + change,
		   LOG_DATETIME);

	return 1;
endfunction

function AttributeEdit(who, targ, input_info)

	var real_value := AP_GetTrueSkill(targ, input_info.name);
	var mod_value := AP_GetSkillMod(targ, input_info.name);
	var value := real_value + " " + mod_value;
	var change := RequestGump(who, "New value to assign " + input_info.name + " to.",
						   "real_value(" + real_value + ") modifier(" + mod_value + ")", CStr(value), CANCEL_BTN_ON);
	if (change == error)
		return 0;
	endif

	change := SplitWords(change, " ");
	if (!targ.cmdlevel && !targ.npctemplate)
		LogToFile("log/edits.log", who.name + " (" + who.acctname + ") editou " + targ.name
				   + " (" + targ.acctname + ") :: " + input_info.name + " de " + real_value + " (" + mod_value + ") para "
				   + change[1] + " (" + CInt(change[2]) + ")<br>", LOG_DATETIME);
	endif
	// LogToFile(":fls_core:edits.log", who.name+" ("+who.acctname+") editou "+targ.name+" ("+targ.acctname+") :: "+input_info.name+" de "+real_value+" ("+mod_value+") para "+change[1]+" ("+CInt(change[2])+")<br>", LOG_DATETIME);
	AP_SetTrueSkill(targ, input_info.name, change[1]);
	AP_SetSkillMod(targ, input_info.name, change[2]);

	return 1;
endfunction

function PrivEdit(who, targ, input_info)
	who := who; // Stops compiler warning.
	var priv_name := input_info.name;

	if (targ.enabled(priv_name))
		targ.disable(priv_name);
		RevokePrivilege(targ, priv_name);
	else
		GrantPrivilege(targ, priv_name);
		targ.enable(priv_name);
	endif

	return 1;
endfunction

function OpenStorage(who, targ, input_info)
	var storage_area := input_info.name;

	// Kind of a kludge, but oh well, deal with it!
	if (storage_area == "backpack")
		SendOpenSpecialContainer(who, targ.backpack);
		return 1;
	else
		var container := CP_GetStorageContainerForMobile(targ, storage_area, CP_NOCREATE);
		return SendOpenSpecialContainer(who, container);
	endif
endfunction

// Nova função para criar o gump de navegação (usa loop em vez de recursão)
function PropEditWithNavigation(who, targ, prop_name)
	current_prop_name := prop_name;
	current_prop_target := targ;

	while (1)
		var value := ParseMembers(targ, prop_name);

		var gump := GFCreateGump();
		GFPage(gump, 0);
		GFResizePic(gump, 0, 0, GFCfgConst("Defaults", "BackGround"), 400, 200);

		// Título
		GFResizePic(gump, 15, 15, GFCfgConst("Defaults", "ForeGround"), 370, 35);
		GFTextLine(gump, 25, 22, 2100, "Editando: " + prop_name + " de " + targ.name);

		// Área principal
		GFResizePic(gump, 15, 60, GFCfgConst("Defaults", "ForeGround"), 370, 100);

		// Valor atual
		GFTextLine(gump, 25, 80, 2100, "Valor atual:");
		GFTextLine(gump, 120, 80, 2100, CStr(value));

		// Botões de navegação
		GFAddButton(gump, 25, 110, 4014, 4015, GF_CLOSE_BTN, PROP_PREV_BTN); // Seta esquerda
		GFTextLine(gump, 50, 113, 2100, "-1");

		GFAddButton(gump, 120, 110, 4005, 4006, GF_CLOSE_BTN, PROP_NEXT_BTN); // Seta direita
		GFTextLine(gump, 145, 113, 2100, "+1");

		// Campo de entrada manual
		GFTextLine(gump, 200, 80, 2100, "Ou digite valor:");
		var campo_gra := GFTextEntry(gump, 200, 100, 100, 20, 2100, CStr(value), 0, 1);

		// Botões de ação
		GFAddButton(gump, 25, 170, 4023, 4024, GF_CLOSE_BTN, PROP_OK_BTN); // OK
		GFTextLine(gump, 50, 173, 2100, "Fechar");

		GFAddButton(gump, 120, 170, 4020, 4021, GF_CLOSE_BTN, 0); // Cancelar
		GFTextLine(gump, 145, 173, 2100, "Cancelar");

		// Botão para aplicar valor digitado
		GFAddButton(gump, 320, 100, 4023, 4024, GF_CLOSE_BTN, 999); // Aplicar
		GFTextLine(gump, 345, 103, 2100, "Aplicar");

		var input := GFSendGump(who, gump);
		var button := input[0];
		var novocampogra := GFExtractData(input, campo_gra);

		if (button == 999 && novocampogra) // Aplicar valor digitado
			ParseMembers(targ, prop_name, novocampogra);
			// Continua o loop para mostrar novo valor
		elseif (button == PROP_PREV_BTN)
			var new_val := CInt(value) - 1;
			if (new_val >= 0)
				ParseMembers(targ, prop_name, new_val);
			endif
			// Continua o loop
		elseif (button == PROP_NEXT_BTN)
			ParseMembers(targ, prop_name, CInt(value) + 1);
			// Continua o loop
		else
			// Qualquer outro botão (OK, Cancelar, ou fechar) sai do loop
			break;
		endif
	endwhile

	current_prop_name := "";
	current_prop_target := 0;
	return 1;
endfunction

// Função auxiliar para processar navegação de propriedades (chamada do loop principal)
function ProcessPropNavigation(who, targ, input)
	targ := targ; // Evita warning de variável não usada
	input := input; // Evita warning de variável não usada

	// Esta função não é mais necessária para o gump de navegação
	// Mantida para compatibilidade caso seja chamada de outro lugar
	if (!current_prop_target || !current_prop_name)
		return 0;
	endif

	// Redireciona para o gump de navegação
	PropEditWithNavigation(who, current_prop_target, current_prop_name);
	return 1;
endfunction

// Nova função para editar sons do NPC
function SoundEdit(who, targ, input_info)
	// Verificar se é um NPC

	// Configurar variáveis globais para navegação
	current_sound_type := input_info.name;
	current_sound_target := targ;
	SoundEditWithNavigation(who, targ, input_info.name);

	return 1;
endfunction

// Nova função para criar o gump de navegação de sons (usa loop em vez de recursão)
function SoundEditWithNavigation(who, targ, sound_type)
	current_sound_type := sound_type;
	current_sound_target := targ;

	while (1)
		var value := GetNPCSound(targ, sound_type);

		var gump := GFCreateGump();
		GFPage(gump, 0);
		GFResizePic(gump, 0, 0, GFCfgConst("Defaults", "BackGround"), 450, 250);

		// Título
		GFResizePic(gump, 15, 15, GFCfgConst("Defaults", "ForeGround"), 420, 35);
		GFTextLine(gump, 25, 22, 2100, "Editando Som: " + sound_type + " de " + targ.name);

		// Área principal
		GFResizePic(gump, 15, 60, GFCfgConst("Defaults", "ForeGround"), 420, 150);

		// Valor atual
		GFTextLine(gump, 25, 80, 2100, "Som atual:");
		GFTextLine(gump, 120, 80, 2100, CStr(value));

		// Botões de navegação
		GFAddButton(gump, 25, 110, 4014, 4015, GF_CLOSE_BTN, SOUND_PREV_BTN); // Seta esquerda
		GFTextLine(gump, 50, 113, 2100, "-1");

		GFAddButton(gump, 120, 110, 4005, 4006, GF_CLOSE_BTN, SOUND_NEXT_BTN); // Seta direita
		GFTextLine(gump, 145, 113, 2100, "+1");

		// Botão para tocar som
		GFAddButton(gump, 220, 110, 4029, 4030, GF_CLOSE_BTN, SOUND_PLAY_BTN); // Play
		GFTextLine(gump, 245, 113, 2100, "Tocar Som");

		// Campo de entrada manual
		GFTextLine(gump, 25, 140, 2100, "Ou digite valor:");
		var campo_sound := GFTextEntry(gump, 25, 160, 100, 20, 2100, CStr(value), 0, 5);

		// Botão para aplicar valor digitado
		GFAddButton(gump, 140, 160, 4023, 4024, GF_CLOSE_BTN, 998); // Aplicar
		GFTextLine(gump, 165, 163, 2100, "Aplicar");

		// Informação sobre o tipo de som
		var sound_desc := GetSoundDescription(sound_type);
		GFTextLine(gump, 250, 140, 2100, sound_desc);

		// Botões de ação
		GFAddButton(gump, 25, 220, 4023, 4024, GF_CLOSE_BTN, SOUND_OK_BTN); // OK
		GFTextLine(gump, 50, 223, 2100, "Fechar");

		GFAddButton(gump, 120, 220, 4020, 4021, GF_CLOSE_BTN, 0); // Cancelar
		GFTextLine(gump, 145, 223, 2100, "Cancelar");

		var input := GFSendGump(who, gump);
		var button := input[0];
		var novocampo := GFExtractData(input, campo_sound);

		if (button == 998 && novocampo) // Aplicar valor digitado
			SetNPCSound(targ, sound_type, novocampo);
			// Continua o loop para mostrar novo valor
		elseif (button == SOUND_PREV_BTN)
			var new_val := CInt(value) - 1;
			if (new_val >= 0)
				SetNPCSound(targ, sound_type, new_val);
			endif
			// Continua o loop
		elseif (button == SOUND_NEXT_BTN)
			SetNPCSound(targ, sound_type, CInt(value) + 1);
			// Continua o loop
		elseif (button == SOUND_PLAY_BTN)
			// Tocar o som atual
			PlaySoundEffect(targ, value);
			// Continua o loop
		else
			// Qualquer outro botão (OK, Cancelar, ou fechar) sai do loop
			break;
		endif
	endwhile

	current_sound_type := "";
	current_sound_target := 0;
	return 1;
endfunction

// Função para obter som do NPC do arquivo npcdesc.cfg
function GetNPCSound(targ, sound_type)
	if (!targ.npctemplate)
		return 0;
	endif

	var prop_name := "CustomSound_" + sound_type;
	var custom_sound := GetObjProperty(targ, prop_name);
	if (custom_sound != error)
		return custom_sound;
	endif

	// Se não há propriedade customizada, ler do arquivo npcdesc.cfg
	var npcdesc_cfg := ReadConfigFile(":*:npcdesc");
	if (!npcdesc_cfg)
		return 0;
	endif

	var template_name := Lower(NPC_ParseTemplateName(targ.npctemplate).template);

	var npc_elem := npcdesc_cfg[template_name];
	if (!npc_elem)
		return 0;
	endif

	var sound_value := GetConfigInt(npc_elem, sound_type);
	return sound_value;
endfunction

// Função para obter descrição do tipo de som
function GetSoundDescription(sound_type)
	case (Lower(sound_type))
		"attackhitsound":  return "Som de ataque bem-sucedido";
		"attackmisssound": return "Som de ataque perdido";
		"deathsound":      return "Som de morte";
		"damagedsound":    return "Som quando ferido";
		"idlesound":       return "Som quando parado";
		default:           return "Som desconhecido";
	endcase
endfunction

// Função auxiliar para processar navegação de sons (chamada do loop principal)
function ProcessSoundNavigation(who, targ, input)
	targ := targ; // Evita warning de variável não usada
	input := input; // Evita warning de variável não usada

	// Esta função não é mais necessária para o gump de navegação
	// Mantida para compatibilidade caso seja chamada de outro lugar
	if (!current_sound_target || !current_sound_type)
		return 0;
	endif

	// Redireciona para o gump de navegação
	SoundEditWithNavigation(who, current_sound_target, current_sound_type);
	return 1;
endfunction

// Função para definir som do NPC no arquivo npcdesc.cfg
function SetNPCSound(targ, sound_type, sound_value)
	if (!targ.npctemplate)
		return 0;
	endif

	// Esta função requereria escrita direta no arquivo de configuração
	// Por simplicidade, vamos armazenar em uma propriedade customizada temporária
	// Em uma implementação real, você precisaria reescrever o arquivo npcdesc.cfg

	var prop_name := "CustomSound_" + sound_type;
	SetObjProperty(targ, prop_name, sound_value);

	// Log da alteração
	// LogToFile("log/sound_edits.log", gm.name+" ("+gm.acctname+") alterou som "+sound_type+" de "+targ.name+" para "+sound_value, LOG_DATETIME);

	return 1;
endfunction
