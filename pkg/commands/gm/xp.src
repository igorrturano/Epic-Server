use uo;

include ":expbar:expbar";
include "include/say";

program start_xpbar(who, xp_amt)
	if (who.cmdlevel > 2)
		SendSysMessageEx(who, "Escolha quem receberá XP: ", SSM_REQUEST);
		var targ := Target(who);
		if (!targ)
			return 0;
		endif

		AddXP(targ, CInt(xp_amt));
		SendSysMessage(who, "Dado " + xp_amt + " XP para " + targ.name);
		PrintTextAbovePrivate(targ, "Você recebeu " + xp_amt + " XP pela qualidade do seu RP, parabens!!", targ);
		return 1;
	endif

	// For regular players, just show their current XP info
	var lvl := GetPlayerLevel(who);
	var xp := GetPlayerXP(who);
	var next := GetXPToNextLevel(who);
	SendSysMessage(who, "Level: " + lvl + " | XP: " + xp + "/" + next);
endprogram
