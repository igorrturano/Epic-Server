program rectangle_creator(who, params)
    // Suprimir warning sobre params não usado
    params := params;
    
    if (!who.cmdlevel)
        SendSysMessage(who, "Você não tem permissão para usar este comando.");
        return;
    endif
    
    // Abrir o datafile
    var rect_df := SafeOpenDataFile(":architect:areas", 1);
    if (!rect_df)
        SendSysMessage(who, "Erro ao abrir ou criar o arquivo de dados de áreas!");
        return;
    endif

    // Sempre abre o gump (params não é usado intencionalmente)
    ShowRectangles(who, rect_df);
endprogram


function SetupResourcesForTerritory(who, elem)
    // Lista de recursos disponíveis (sem repetições)
    var resource_sets := array{
        "ironore",
        "couroespesso",
        "cogumelo",
        "madeirapinheiro",
        "carvao",
        "pelebranca",
        "madeirateixo",
        "prataingot",
        "escamasazuis",
        "couropolar",
        "ossogigante",
        "ossodemoniaco",
        "courodraconiano",
        "frigutiumingot",
        "glass",
        "ossocinza",
        "couroescamoso"
    };
    
    // Remover duplicatas da lista de recursos
    var unique_resources := array{};
    var resource_dict := dictionary{};
    
    foreach resource in resource_sets
        // Converter para lowercase para comparação insensível a caso
        var lower_res := Lower(resource);
        if (!resource_dict.exists(lower_res))
            resource_dict[lower_res] := 1;
            unique_resources.append(resource);
        endif
    endforeach
    
    // Usar os recursos únicos daqui em diante
    resource_sets := unique_resources;
    
    // Recuperar valores atuais se existirem, usando os helpers para simplificar
    var current_interval := GetElementProp(elem, "ResourceInterval", 1);
    var current_amount := GetElementProp(elem, "ResourceAmount", 5);
    var territory_id := GetElementProp(elem, TERRITORY_ID_PROP, "");
    
    // Processar recursos atuais, garantindo que não haja entradas vazias e limitando a 3
    var current_resources := array{};
    var resource_string := GetElementProp(elem, "Resources", "");

    if (resource_string)
        var raw_resources := SplitWords(resource_string, ",");
        
        var count := 0;
        foreach res in raw_resources
            // Limpar espaços extras
            res := TrimString(res);
            
            // Adicionar apenas recursos não vazios
            if (res != "" && count < 3)
                current_resources.append(res);
                count += 1;
            endif
            
            if (count >= 3)
                break;
            endif
        endforeach
    endif
    
    // Início do processo de seleção interativa
    var selected_resources := array{};
    
    // Inicializar com recursos atuais, se houver
    foreach res in current_resources
        selected_resources.append(res);
    endforeach
    
    var done := 0;
    while (!done)
        // Criar gump com as opções atuais
        var gump_data := CreateResourceGumpForTerritory(elem, resource_sets, selected_resources, current_interval, current_amount);
        var gump := gump_data.gump;
        var checkboxes := gump_data.checkboxes;
        
        var input := GFSendGump(who, gump);
        var button := input[0];
        
        // Se cancelou, encerrar sem salvar
        if (button == 0)
            return 0;
        endif
        
        if (button == 100)
            // Recuperar valores dos campos
            var interval := CInt(GFExtractData(input, 10));
            var amount := CInt(GFExtractData(input, 20));
            
            // Validar entradas
            if (interval < 1)
                interval := 1;
            endif
            
            if (amount < 1)
                amount := 1;
            endif
            
            // Processar recursos selecionados e atualizar interface se necessário
            var new_selections := array{};
            
            foreach checkbox in checkboxes
                if (input[checkbox.id])
                    new_selections.append(checkbox.resource);
                endif
            endforeach
            
            // Se mais de 3 seleções, mostrar mensagem e reabrir
            if (new_selections.size() > 3)
                SendSysMessage(who, "Você só pode selecionar até 3 recursos! Por favor, selecione novamente.");
                // Manter as 3 primeiras seleções
                selected_resources := array{};
                for i := 1 to 3
                    if (i <= new_selections.size())
                        selected_resources.append(new_selections[i]);
                    endif
                endfor
            else
                // Se 3 ou menos, salvar e encerrar
                // Converter lista de recursos em string
                var resources_str := "";
                for i := 1 to new_selections.size()
                    if (i > 1)
                        resources_str += ", ";
                    endif
                    resources_str += new_selections[i];
                endfor
                
                // Salvar no elemento
                SetElementProp(elem, "ResourceInterval", interval);
                SetElementProp(elem, "ResourceAmount", amount);
                SetElementProp(elem, "Resources", resources_str);

                // Configurar próxima geração
                var next_time := polcore().systime + (interval * 60); // Converter minutos para segundos
                SetElementProp(elem, "NextResourceTime", next_time);

                // MÁQUINA DE ESTADOS: Verificar se é território com Champion Spawn
                var has_champion := GetElementProp(elem, "HasChampionSpawn", 0);
                SendSysMessage(who, "DEBUG: Verificando HasChampionSpawn = " + has_champion);
                
                if (has_champion)
                    SendSysMessage(who, "Recursos configurados. Finalizando criação do Champion Spawn...");
                    SendSysMessage(who, "DEBUG: Iniciando delegação para continuar_criacao...");
                    
                    // INICIAR SCRIPT CONTINUADOR EM VEZ DE CONTINUAR AQUI
                    var script_result := start_script(":faccao:spawndecampeao/commands/gm/continuar_criacao", who);
                    SendSysMessage(who, "DEBUG: Resultado start_script = " + script_result);
                    
                    if (script_result.errortext)
                        SendSysMessage(who, "ERRO ao iniciar continuar_criacao: " + script_result.errortext);
                    else
                        SendSysMessage(who, "DEBUG: Script continuar_criacao iniciado com sucesso!");
                        SendSysMessage(who, "Delegação para criação do Champion Spawn iniciada!");
                    endif
                    
                    // Encerrar este script AQUI - o continuador fará o resto
                    return 1;
                endif

                // Notificar o ResourceController sobre a atualização (apenas para territórios normais)
                var territory_id := GetElementProp(elem, TERRITORY_ID_PROP, "");
                var territory_name := GetElementProp(elem, "Name", "");

// Log ANTES de tentar obter o PID
LogDebug("EventoTerritorio", "Tentando obter PID para notificar sobre atualização de recursos do território " + territory_name + " (" + territory_id + ")");
var controller_pid_prop := GetGlobalProperty("ResourceControllerPID");

if (controller_pid_prop)
    LogDebug("EventoTerritorio", "PID encontrado na GlobalProperty: " + controller_pid_prop + " (Tipo: " + TypeOf(controller_pid_prop) + ")");
    var controller_pid := CInt(controller_pid_prop);

    // Log ANTES de GetProcess
    LogDebug("EventoTerritorio", "Tentando GetProcess(" + controller_pid + ")...");
    var process := GetProcess(controller_pid);

    if (process)
        LogInfo("EventoTerritorio", "Processo encontrado! Enviando TerritoryChange (resources_updated) para PID " + controller_pid);
        var ev := struct{
            "type" := "TerritoryChange",
            "territory_id" := territory_id ? territory_id : territory_name, // Usar ID ou nome
            "change_type" := "resources_updated",
            "change_data" := struct{
                "resources" := resources_str,
                "interval" := interval,
                "amount" := amount,
                "next_time" := next_time
            },
            "timestamp" := polcore().systime
        };
        var send_result := process.SendEvent(ev);
        if (send_result == error)
            LogError("EventoTerritorio", "Falha ao ENVIAR evento para PID " + controller_pid + ": " + send_result.errortext);
        else
            LogInfo("EventoTerritorio", "Evento enviado com sucesso para PID " + controller_pid + ".");
        endif
    else
        LogError("EventoTerritorio", "FALHA CRÍTICA: GetProcess(" + controller_pid + ") falhou ao encontrar o processo do ResourceController.");
        // Opcional: Listar processos ativos para diagnóstico
        LogError("EventoTerritorio", "Tentando listar alguns processos ativos para diagnóstico...");
        var found_processes := 0;
        foreach process_id in (GetGlobalProperty("ActiveProcesses"))
            if (found_processes < 5) // Limitar a 5 processos para não sobrecarregar
                var proc := GetProcess(process_id);
                if (proc)
                    LogError("EventoTerritorio", "Processo ativo: PID=" + process_id + ", Nome=" + proc.name);
                    found_processes += 1;
                endif
            endif
            sleepms(1);
        endforeach
    endif
else
    LogWarning("EventoTerritorio", "PID do ResourceController NÃO encontrado na GlobalProperty 'ResourceControllerPID'");
endif

// Usar TM_UpdateTerritoryResources DEPOIS de ter o territory_id e new_selections definidos
if (territory_id)
    TM_UpdateTerritoryResources(territory_id, new_selections, interval, amount);
endif

SendSysMessage(who, "Recursos configurados: " + resources_str);
SendSysMessage(who, "Intervalo: " + interval + " minutos, Quantidade: " + amount + " unidades");

done := 1;
            endif
        endif
    endwhile
    
    return 1;
endfunction

// Função separada para criar o gump de recursos
function CreateResourceGumpForTerritory(elem, resource_sets, selected_checkboxes, current_interval, current_amount)
    // Dimensões e configurações do gump
    var width := 500;
    var height := 470;
    var title := "Configurar Recursos para: " + GetElementProp(elem, "Name", "");

    
    // Criar gump usando o estilo padronizado
    var gump := GFECreateGump(title, width, height, array{BORDER_GOLDEN});
    
    // Definir posição inicial
    var y := 70;
    var x := 30;
    
    // Intervalo de geração
    GFTextLine(gump, x, y, 2100, "Intervalo de Geração (minutos):");
    GFResizePic(gump, x + 230, y-5, 9350, 60, 30);
    GFTextEntry(gump, x + 235, y-3, 50, 25, 1153, current_interval, 10);
    y += 35;
    
    // Quantidade por geração
    GFTextLine(gump, x, y, 2100, "Quantidade por Geração:");
    GFResizePic(gump, x + 230, y-5, 9350, 60, 30);
    GFTextEntry(gump, x + 235, y-3, 50, 25, 1153, current_amount, 20);
    y += 35;
    
    // Título da seção de recursos - destaque para limite de 3
    GFTextLine(gump, x, y, 38, "Selecione até 3 recursos para o território:");
    y += 25;
    
    // Array para armazenar IDs dos checkboxes
    var checkboxes := array{};
    
    // Contador de recursos por coluna
    var items_per_column := 12;
    var current_column := 0;
    var current_item := 0;
    var base_y := y;
    
    // Adicionar recursos com checkboxes
    foreach resource in resource_sets
        // Verificar se o recurso está entre os selecionados
        var is_selected := 0;
        foreach selection in selected_checkboxes
            if (Lower(selection) == Lower(resource))
                is_selected := 1;
                break;
            endif
        endforeach
        
        // Calcular posição y baseada no item atual
        var pos_y := base_y + (current_item % items_per_column) * 20;
        
        // Calcular posição x baseada na coluna atual
        var pos_x := x + (current_column * 200);
        
        // ID do checkbox (300 + índice)
        var checkbox_id := 300 + checkboxes.size() + 1;
        
        // Adicionar checkbox
        GFCheckBox(gump, pos_x, pos_y, 9792, 9793, is_selected, checkbox_id);
        
        // Destacar os recursos selecionados com uma cor diferente
        var text_color := 1153; // Padrão
        if (is_selected)
            text_color := 63; // Verde para recursos selecionados
        endif
        GFTextLine(gump, pos_x + 20, pos_y, text_color, resource);
        
        // Armazenar informações sobre o checkbox
        checkboxes.append(struct{
            "id" := checkbox_id,
            "resource" := resource
        });
        
        // Incrementar contadores
        current_item += 1;
        if (current_item % items_per_column == 0)
            current_column += 1;
        endif
    endforeach
    
    // Posição y para os botões (abaixo de todas as colunas)
    y := base_y + ((items_per_column - 1) * 20) + 40;
    
    // Adicionar texto indicando quantos recursos selecionados
    var selection_count := selected_checkboxes.size();
    var selection_text := selection_count + "/3 recursos selecionados";
    GFTextLine(gump, width/2 - 80, y - 20, selection_count == 3 ? 63 : 38, selection_text);
    
    // Botões
    GFAddButton(gump, width/2 - 100, y, 2130, 2129, GF_CLOSE_BTN, 100);
    GFAddButton(gump, width/2 + 20, y, 0xF1, 0xF3, GF_CLOSE_BTN, 0);
    
    return struct{
        "gump" := gump,
        "checkboxes" := checkboxes
    };
endfunction

function ShowRectangles(who, rect_df)
    var width := 350;
    var height := 480;
    
    // Cria um gump padronizado usando a função GFECreateGump
    var gump := GFECreateGump("Gerenciador de Territórios", width, height, array{BORDER_GOLDEN});
    
    // Ajusta ponto inicial baseado na estrutura padrão do GFECreateGump
    var y := 70; // Posição abaixo do título
    var x := 30; // Margem interna
    
    // MODIFICAÇÃO: Posições fixas para "Territórios Registrados" e "Guilda"
    // Texto "Territórios Registrados" na posição x = 30
    GFTextLine(gump, 30, y, 53, "Territórios Registrados");
    
    // Texto "Guilda" na posição x = 280
    GFTextLine(gump, 280, y, 53, "Guilda");
    
    y += 25;
    
    var i := 1;
    
    // Cria uma tabela simples de territórios
    foreach rect_name in (rect_df.keys())
        var elem := SafeFindElement(rect_df, rect_name);
        
        // Tratamento seguro para obter a facção
        var faction := "";
        var faction_property := GetElementProp(elem, TERRITORY_FACTION_PROP, "");
        
        if (faction_property && faction_property != error)
            // Verificar se não é um array ou struct
            if (TypeOf(faction_property) == "String")
                faction := faction_property;
            else
                // Tentar usar a propriedade legada
                faction := GetElementProp(elem, "Faction", "");
                if (!faction || faction == error)
                    faction := DEFAULT_FACTION;
                else
                    // Atualizar para o formato padronizado
                    SetElementProp(elem, TERRITORY_FACTION_PROP, faction);
                endif
            endif
        else
            // Tentar usar a propriedade legada
            faction := GetElementProp(elem, "Faction", "");
            if (!faction || faction == error)
                faction := DEFAULT_FACTION;
            else
                // Atualizar para o formato padronizado
                SetElementProp(elem, TERRITORY_FACTION_PROP, faction);
            endif
        endif
        
        // Define a cor baseada na facção - territórios selvagens em vermelho
        var color := 1153; // Padrão - azul claro
        if (faction == DEFAULT_FACTION)
            color := 38; // Vermelho
        endif
        
        // Botão e nome do território
        GFAddButton(gump, x, y+2, 2117, 2118, GF_CLOSE_BTN, 400+i);
        GFTextLine(gump, x+25, y, color, rect_name);
        
        // Exibe a facção controladora à direita, alinhada com "Guilda"
        GFTextLine(gump, 280, y, color, faction);
        
        y += 20;
        i += 1;
        
        // Evita que o gump fique muito grande - limita a 18 entradas por página
        if (i > 18)
            GFAddButton(gump, width/2, height-40, 2706, 2707, GF_CLOSE_BTN, 999);
            GFTextLine(gump, width/2+20, height-40, 1153, "Mais...");
            break;
        endif
    endforeach
    
    // MUDANÇA: Botão de criação agora leva para seleção de tipo
   if (who.cmdlevel >= 1)
        GFAddButton(gump, width/2-70, height-40, 2361, 2361, GF_CLOSE_BTN, 300);
        GFTextLine(gump, width/2-50, height-44, 63, "Criar Novo Território");
    endif
    
    var input := GFSendGump(who, gump);
    var button := input[0];
    
    if (button >= 400 && button < 999)
        var index := button - 400;
        var rect_name := rect_df.keys()[index];
        var elem := SafeFindElement(rect_df, rect_name);
        
        DisplayRectangleDetails(who, elem);
    elseif (button == 999)
        ShowRectanglesPage2(who, rect_df, 19);
    elseif (button == 300)
        // ==========================================================
        // CORREÇÃO: Chamando o gump de seleção de tipo diretamente.
        // ==========================================================
        ShowTerritoryTypeSelection(who);
    endif
endfunction

// Função adicional para mostrar mais territórios (também com posições fixas)
function ShowRectanglesPage2(who, rect_df, start_index)
    var width := 350;
    var height := 480;
    
    var gump := GFECreateGump("Gerenciador de Territórios - Página 2", width, height, array{BORDER_GOLDEN});
    
    var y := 70;
    var x := 30;
    
    // Títulos com posições fixas
    GFTextLine(gump, 30, y, 53, "Territórios Registrados");
    GFTextLine(gump, 280, y, 53, "Guilda");
    y += 25;
    
    var keys := rect_df.keys();
    var total := keys.size();
    var i := start_index;
    var displayed := 1;
    
    while (i <= total && displayed <= 18)
        var rect_name := keys[i];
        var elem := SafeFindElement(rect_df, rect_name);

        // CORREÇÃO: Tratamento seguro para obter a facção (igual à página 1)
        var faction := "";
        var faction_property := GetElementProp(elem, TERRITORY_FACTION_PROP, "");

        if (faction_property && faction_property != error)
            if (TypeOf(faction_property) == "String")
                faction := faction_property;
            else
                faction := GetElementProp(elem, "Faction", "");
                if (!faction || faction == error)
                    faction := DEFAULT_FACTION;
                else
                    SetElementProp(elem, TERRITORY_FACTION_PROP, faction);
                endif
            endif
        else
            faction := GetElementProp(elem, "Faction", "");
            if (!faction || faction == error)
                faction := DEFAULT_FACTION;
            else
                SetElementProp(elem, TERRITORY_FACTION_PROP, faction);
            endif
        endif
        
        var color := 1153;
        if (faction == DEFAULT_FACTION)
            color := 38;
        endif
        
        // CORREÇÃO: Posições limpas e consistentes (igual à página 1)
        GFAddButton(gump, x, y+2, 2117, 2118, GF_CLOSE_BTN, 400+i);
        GFTextLine(gump, x+25, y, color, rect_name);
        GFTextLine(gump, 280, y, color, faction);
        
        y += 20;
        i += 1;
        displayed += 1;
    endwhile
    
    // Botão para voltar à primeira página
    GFAddButton(gump, width/2-70, height-40, 2704, 2705, GF_CLOSE_BTN, 998);
    GFTextLine(gump, width/2-50, height-40, 1153, "Página Anterior");
    
    var input := GFSendGump(who, gump);
    var button := input[0];
    
    if (button >= 400)
        var index := button - 400;
        var rect_name := keys[index];
        var elem := SafeFindElement(rect_df, rect_name);
        
        DisplayRectangleDetails(who, elem);
    elseif (button == 998)
        ShowRectangles(who, rect_df);
    endif
endfunction

// Função para verificar se um retângulo se sobrepõe a outro
function CheckRectangleOverlap(rect_df, x1, y1, x2, y2, realm, exclude_name := "")
    foreach rect_name in (rect_df.keys())
        // Pular a verificação se for o próprio retângulo que estamos editando
        if (rect_name == exclude_name)
            continue;
        endif
        
        // Usar TM_GetTerritoryInfo para obter informações do território
        var territory_info := TM_GetTerritoryInfo(rect_name);
        if (!territory_info)
            continue;
        endif
        
        var rect_realm := territory_info.realm;
        
        // Se não estiver no mesmo realm, não há sobreposição
        if (rect_realm != realm)
            continue; 
        endif
        
        var rect_str := territory_info.rect;
        if (!rect_str)
            continue;
        endif
        
        // Usar TM_CheckRectangleOverlap para verificar sobreposição
        var rect1 := array{x1, y1, x2, y2};
        var rect2 := SplitWords(rect_str);
        
        if (TM_DoRectanglesOverlap(rect1, rect2, realm, rect_realm))
            return 1; // Há sobreposição
        endif
    endforeach
    
    return 0; // Não há sobreposição
endfunction

function DestruirObjetosTerritorio(territorio_id, faction)
    LogDebug("territorio", $"Deletando objetos do território: {territorio_id} da facção: {faction}");
    
    // SOLUÇÃO KISS: Usar apenas a função centralizada TM_DeleteTerritoryObjects
    // que já tem toda a lógica de destruição implementada e testada
    var objetos_destruidos := TM_DeleteTerritoryObjects(territorio_id, faction);
    
    LogDebug("territorio", $"Total de objetos destruídos: {objetos_destruidos}");
    return objetos_destruidos;
endfunction

function DisplayRectangleDetails(who, elem)
if (!elem) return; endif
    var width := 400;
    var height := 380;
    var name := GetElementProp(elem, "Name", "");
var rect := GetElementProp(elem, "Rect", "");
var realm := GetElementProp(elem, "Realm", "");
var faction := GetElementProp(elem, TERRITORY_FACTION_PROP, DEFAULT_FACTION);
var resources := GetElementProp(elem, "Resources", "Não definidos");
var interval := GetElementProp(elem, "ResourceInterval", 0);
var amount := GetElementProp(elem, "ResourceAmount", 0);
var territory_id := GetElementProp(elem, TERRITORY_ID_PROP, "");
var is_capital := TM_IsTerritoryCapital(territory_id);

    // Define a cor do título baseada na facção controladora
    var title_color := 53; // Dourado padrão
    if (faction == DEFAULT_FACTION)
        title_color := 38; // Vermelho para territórios selvagens
    endif
    
    // Título customizado com o nome do território
    var titulo := "Território: " + name;
    var gump := GFECreateGump(titulo, width, height, array{BORDER_GOLDEN});
    
    var y := 70;
    var x := 30;
    
    // Coordenadas do território
    GFTextLine(gump, x, y, 2100, "Coordenadas:");
    
    // Extrai e formata as coordenadas
    var coords := SplitWords(rect);
    var coords_text := "";
    if (coords.size() >= 4)
        coords_text := "(" + coords[1] + "," + coords[2] + ") a (" + coords[3] + "," + coords[4] + ")";
    else
        coords_text := rect;
    endif
    
    GFTextLine(gump, x+110, y, 63, coords_text);
    y += 25;
    
    // Informações do realm
    GFTextLine(gump, x, y, 2100, "Realm:");
    GFTextLine(gump, x+110, y, 63, realm);
    y += 25;
    
    // Facção controladora
    GFTextLine(gump, x, y, 2100, "Controlado por:");
    // Cor diferente dependendo se é default ou controlado
    var control_color := 63; // Verde normal
    if (faction == DEFAULT_FACTION)
        control_color := 38; // Vermelho para default
    endif
    GFTextLine(gump, x+110, y, control_color, faction);
    y += 25;
    
    // NOVO: Informações sobre Champion Spawn
    var has_champion := GetElementProp(elem, "HasChampionSpawn", 0);
    if (has_champion)
        var champion_type := GetElementProp(elem, "ChampionType", "");
        GFTextLine(gump, x, y, 2100, "Champion Spawn:");
        var champion_color := 1153;
        var champion_name := "";
        
        if (champion_type == "CavernaDosGoblins")
            champion_name := "Caverna dos Goblins";
            champion_color := 63; // Verde
        elseif (champion_type == "CovilDasAranhas")
            champion_name := "Covil das Aranhas";
            champion_color := 38; // Vermelho
        else
            champion_name := champion_type;
        endif
        
        GFTextLine(gump, x+110, y, champion_color, champion_name);
        y += 25;
    endif
    
    // Linha de separação
    GFGumpPicTiled(gump, x, y, width-60, 2, 9101);
    y += 10;
    
    // Recursos do território
    GFTextLine(gump, x, y, 2100, "Recursos:");
    y += 20;
    
    if (resources != "Não definidos")
        // Limpar e processar a lista de recursos
        var resource_list := SplitWords(resources, ",");
        var clean_resources := array{};
        
        // Filtrar recursos vazios e limpar espaços extras
        foreach resource in resource_list
            // Remover espaços no início e fim
            resource := RectTrimString(resource);
            
            // Adicionar apenas recursos não vazios
            if (resource != "")
                clean_resources.append(resource);
            endif
        endforeach
        
        // Exibir os recursos limpos
        foreach resource in clean_resources
            GFTextLine(gump, x+20, y, 63, "• " + resource);
            y += 20;
        endforeach
        
        // Se não houver recursos válidos após a limpeza
        if (clean_resources.size() == 0)
            GFTextLine(gump, x+20, y, 38, "Nenhum recurso configurado");
            y += 25;
        else
            // Informações de geração
            y += 5;
            GFTextLine(gump, x, y, 2100, "Geração:");
            GFTextLine(gump, x+110, y, 63, amount + " a cada " + interval + " minutos");
            y += 20;
            
            // Verifica se tem informação de próxima geração
            var next_time := GetElementProp(elem, "NextResourceTime", 0);
            if (next_time)
                var time_left := next_time - polcore().systime;
                var minutes_left := CInt(time_left/60);
                
                if (minutes_left > 0)
                    GFTextLine(gump, x, y, 2100, "Próxima geração em:");
                    GFTextLine(gump, x+150, y, 63, minutes_left + " minutos");
                else
                    GFTextLine(gump, x, y, 2100, "Próxima geração:");
                    GFTextLine(gump, x+150, y, 38, "PENDENTE");
                endif
                y += 25;
            endif
        endif
    else
        GFTextLine(gump, x+20, y, 38, "Nenhum recurso configurado");
        y += 25;
    endif
    
    // Linha de separação
    GFGumpPicTiled(gump, x, y, width-60, 2, 9101);
    y += 15;
    
    // Botões de ações
    // Criar grid de 2x2 para os botões
    var btn_x := x + 20;
    var btn_y := y;
    var btn_spacing := 150;
    
    // Botão Ir para Território
    GFAddButton(gump, btn_x, btn_y, 2361, 2361, GF_CLOSE_BTN, 300);
    GFTextLine(gump, btn_x+20, btn_y-4, 1153, "Ir para Território");
    
    // Botão Configurar Recursos (somente para GMs)
    if (who.cmdlevel >= 1)
        GFAddButton(gump, btn_x+btn_spacing, btn_y, 2361, 2361, GF_CLOSE_BTN, 500);
        GFTextLine(gump, btn_x+btn_spacing+20, btn_y-4, 1153, "Configurar Recursos");
        
        btn_y += 25;
        
        // Botão Editar Território
        GFAddButton(gump, btn_x, btn_y, 2361, 2361, GF_CLOSE_BTN, 200);
        GFTextLine(gump, btn_x+20, btn_y-4, 1153, "Editar Território");
        
        // Botão Criar Totem
        GFAddButton(gump, btn_x+btn_spacing, btn_y, 2361, 2361, GF_CLOSE_BTN, 400);
        GFTextLine(gump, btn_x+btn_spacing+20, btn_y-4, 1153, "Criar Totem");
        
        btn_y += 25;
        
        // Botão Deletar (separado visualmente)
        GFAddButton(gump, btn_x, btn_y, 2361, 2361, GF_CLOSE_BTN, 100);
        GFTextLine(gump, btn_x+20, btn_y-4, 38, "Deletar Território");
        

    endif
    

    
var input := GFSendGump(who, gump);
    var button := input[0];
    
    if (button == 100) // Deletar
        if (YesNo(who, "Tem certeza que deseja deletar o território '" + name + "'? Esta ação é irreversível."))
            // **AQUI ESTÁ A CORREÇÃO**
            // Notificamos o sistema ANTES de apagar qualquer coisa.
            TM_NotifyTerritoryChange(territory_id, "deleted", struct{ "name" := name });
            
            // Agora chamamos a função centralizada que faz todo o trabalho sujo.
            // Ela apaga objetos, remove referências da guilda e o registro do datafile.
            var resultado_delecao := TM_DeleteTerritory(territory_id); 
            
            if (resultado_delecao)
                SendSysMessage(who, "Território '" + name + "' e todos os seus dados foram deletados com sucesso!");
            else
                SendSysMessage(who, "Erro ao deletar o território '" + name + "'. Verifique os logs do servidor.");
            endif
        endif
    elseif (button == 200) // Editar
        SendSysMessage(who, "Selecione novos pontos para o território");
        
        var first_point := TargetCoordinates(who);
        if (!first_point)
            SendSysMessage(who, "Edição cancelada.");
            return;
        endif
        
        var second_point := TargetCoordinates(who);
        if (!second_point)
            SendSysMessage(who, "Edição cancelada.");
            return;
        endif
        
        var x1 := first_point.x;
        var y1 := first_point.y;
        var x2 := second_point.x;
        var y2 := second_point.y;
        
        if (x1 > x2)
            var temp := x1;
            x1 := x2;
            x2 := temp;
        endif
        
        if (y1 > y2)
            var temp := y1;
            y1 := y2;
            y2 := temp;
        endif
        
        var rect_str := $"{x1} {y1} {x2} {y2}";
        
        var areas_df := SafeOpenDataFile(":architect:areas");
        if (CheckRectangleOverlap(areas_df, x1, y1, x2, y2, first_point.realm, name))
            SendSysMessage(who, "Este território se sobrepõe a outro já existente.");
            SendSysMessage(who, "Edição cancelada.");
            return;
        endif
        
        SetElementProp(elem, "Rect", rect_str);
        SetElementProp(elem, "Realm", first_point.realm);
        
        SendSysMessage(who, $"Território '{name}' atualizado!");

    elseif (button == 300) // Ir para território
        var coords := SplitWords(rect);
        if (coords.size() >= 4)
            var x1 := CInt(coords[1]);
            var y1 := CInt(coords[2]);
            var x2 := CInt(coords[3]);
            var y2 := CInt(coords[4]);
            
            var center_x := CInt((x1 + x2) / 2);
            var center_y := CInt((y1 + y2) / 2);
            var center_z := GetWorldHeight(center_x, center_y, realm);
            
            MoveObjectToLocation(who, center_x, center_y, center_z, realm, MOVEOBJECT_FORCELOCATION);
            SendSysMessage(who, "Teleportado para o centro do território!");
        else
            SendSysMessage(who, "Erro ao analisar as coordenadas do território!");
        endif

    elseif (button == 400) // Criar Totem
        CreateTerritoryTotem(who, elem);
        
    elseif (button == 500) // Configurar Recursos
        SetupResourcesForTerritory(who, elem);
   
    endif
endfunction

function CreateTerritoryTotem(who, elem)
    // Validação inicial do elemento
    if (!elem)
        SendSysMessage(who, "Erro interno: Referência de território inválida.");
        return 0;
    endif

    var totem := CreateItemInBackpack(who, 0xA102, 1); // TotemDeAquisicao
    if (!totem)
        SendSysMessage(who, "Falha ao criar o totem. Verifique o espaço na sua mochila.");
        return 0;
    endif
    
    // Obter ID e Nome do elemento de forma segura
    var territory_id := GetElementProp(elem, TERRITORY_ID_PROP);
    var territory_name := GetElementProp(elem, "Name", "Território Sem Nome");

    // Se o território não tiver um ID, é um erro de dados que precisa ser corrigido.
    if (!territory_id)
        LogError("rectangles_DEBUG", $"Território '{territory_name}' não possui um ID único. Não é possível criar um totem válido.");
        SendSysMessage(who, "Erro: O território '" + territory_name + "' não possui um ID válido. Ação cancelada.");
        DestroyItem(totem);
        return 0;
    endif
    
    LogDebug("rectangles_DEBUG", $"Preparando para configurar totem para Território '{territory_name}' com ID '{territory_id}'");
    
    // Configurar propriedades do totem usando os dados já obtidos.
    // Não é necessário buscar novamente as informações com TM_GetTerritoryInfo.
    SetObjProperty(totem, TERRITORY_ID_PROP, territory_id);
    SetObjProperty(totem, TERRITORY_NAME_PROP, territory_name);
    
    // Adicionar outras propriedades úteis que já estão no elemento
    SetObjProperty(totem, TERRITORY_RECT_PROP, GetElementProp(elem, "Rect", ""));
    SetObjProperty(totem, TERRITORY_REALM_PROP, GetElementProp(elem, "Realm", ""));
    
    // Informações de auditoria
    SetObjProperty(totem, "CreatedBy", who.serial);
    SetObjProperty(totem, "CreationDate", polcore().systime);
    
    LogDebug("rectangles_DEBUG", $"Propriedades definidas no totem {totem.serial}: ID='{GetObjProperty(totem, TERRITORY_ID_PROP)}', Name='{GetObjProperty(totem, TERRITORY_NAME_PROP)}'");
    
    SendSysMessage(who, "Um totem para o território '" + territory_name + "' (ID: " + territory_id + ") foi criado em sua mochila.");
    return 1;
endfunction

// Função TrimString consolidada (use apenas esta versão)
function RectTrimString(str)
    // Verificar se a string é vazia ou nula
    if (!str || str == "")
        return "";
    endif
    
    // Remove espaços no início
    while (str.length() > 0 && str[1] == " ")
        str := str[2, str.length()];
    endwhile
    
    // Remove espaços no fim
    while (str.length() > 0 && str[str.length()] == " ")
        str := str[1, str.length()-1];
    endwhile
    
    return str;
endfunction

// Função para gerar um ID único para o território
function CreateTerritoryID()
    // Combinar o timestamp com um número aleatório para garantir unicidade
    return "TER_" + polcore().systime + "_" + RandomInt(10000);
endfunction

function IsTerritoryCapital(territory_id)
    return TM_IsTerritoryCapital(territory_id);
endfunction



// Função para mostrar gump de escolha do tipo de território
function ShowTerritoryTypeSelection(who)
    var gump := GFECreateGump("Escolha o tipo de território", 450, 280, array{BORDER_GOLDEN});
    
    var x := 30;
    var y := 70;
    
    GFTextLine(gump, x, y, 53, "Selecione como criar o novo território:");
    y += 35;
    
    // Opção 1: Território com tamanho customizado (não expansível)
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 100);
    GFTextLine(gump, x + 40, y - 4, 1153, "Território Customizado");
    GFTooltipText(gump, "Selecione manualmente as coordenadas do território. Este tipo NÃO expande.");
    y += 40;
    
    // Opção 2: Território com tamanho padrão (expansível)
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 200);
    GFTextLine(gump, x + 40, y - 4, 1153, "Território Padrão (Expansível)");
    GFTooltipText(gump, "Selecione o ponto central. O território começará no Nível 1 e expandirá automaticamente.");
    y += 40;
    
    // NOVO: Opção 3: Território com Champion Spawn
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 300);
    GFTextLine(gump, x + 40, y - 4, 1153, "Território com Champion Spawn");
    GFTooltipText(gump, "Território com arena de ondas e boss final épico. Boss final dropará totem territorial.");
    
    var input := GFSendGump(who, gump);
    var button := input[0];
    
    if (button == 100)
        CreateCustomTerritory(who);
    elseif (button == 200)
        CreateStandardTerritory(who);
    elseif (button == 300)
        CreateChampionTerritory(who);
    endif
endfunction



// Função para criar território customizado (processo atual)
function CreateCustomTerritory(who)
	var rect_df := SafeOpenDataFile(":architect:areas", 1);

    SendSysMessage(who, "Selecione o primeiro ponto (canto superior esquerdo)");
    var first_point := TargetCoordinates(who);
    if (!first_point)
        SendSysMessage(who, "Cancelado.");
        return;
    endif
    
    SendSysMessage(who, "Selecione o segundo ponto (canto inferior direito)");
    var second_point := TargetCoordinates(who);
    if (!second_point)
        SendSysMessage(who, "Cancelado.");
        return;
    endif
    
    var x1 := first_point.x;
    var y1 := first_point.y;
    var x2 := second_point.x;
    var y2 := second_point.y;
    
    if (x1 > x2) var temp := x1; x1 := x2; x2 := temp; endif
    if (y1 > y2) var temp := y1; y1 := y2; y2 := temp; endif
    
    var rect_str := $"{x1} {y1} {x2} {y2}";
    var realm := first_point.realm;
    
    SendSysMessage(who, $"Retângulo definido: {rect_str} no realm {realm}");
    
    var rect_name := RequestGump(who, "Digite um nome para este território customizado:");
    if (!rect_name) return; endif
    
    if (TM_CheckRectangleOverlap(rect_df, x1, y1, x2, y2, realm, ""))
        SendSysMessage(who, "Este retângulo se sobrepõe a outro já existente. Operação cancelada.");
        return;
    endif
    
    var elem := SafeFindElement(rect_df, rect_name, 1);
    
    // Salvar as informações
    var territory_id := CreateTerritoryID();
    SetElementProp(elem, TERRITORY_ID_PROP, territory_id);
    SetElementProp(elem, "Name", rect_name);
    SetElementProp(elem, "Rect", rect_str);
    SetElementProp(elem, "Realm", realm);
    SetElementProp(elem, TERRITORY_FACTION_PROP, DEFAULT_FACTION);
    
    // AÇÃO 1: Marcar como NÃO expansível
    SetElementProp(elem, "IsExpandable", 0); 
    
    SetupResourcesForTerritory(who, elem);
    SendSysMessage(who, $"Território customizado '{rect_name}' salvo com sucesso!");
endfunction



// Função para criar território padrão
function CreateStandardTerritory(who)
    var rect_df := SafeOpenDataFile(":architect:areas", 1);

    SendSysMessage(who, "Selecione o centro do novo território padrão expansível.");
    var center_point := TargetCoordinates(who);
    if (!center_point)
        SendSysMessage(who, "Cancelado.");
        return;
    endif

    // AÇÃO 2: Calcular CurrentRect (Nível 1) e MaxRect (Nível 5)
    var center_x := center_point.x;
    var center_y := center_point.y;
    
    // Dimensões de Nível 1
    var dims_lvl1 := TERRITORY_DIMS_LEVEL_1;
    var width_lvl1 := dims_lvl1[1];
    var height_lvl1 := dims_lvl1[2];
    var x1_lvl1 := center_x - CInt(width_lvl1 / 2);
    var y1_lvl1 := center_y - CInt(height_lvl1 / 2);
    var x2_lvl1 := x1_lvl1 + width_lvl1;
    var y2_lvl1 := y1_lvl1 + height_lvl1;
    var current_rect_str := $"{x1_lvl1} {y1_lvl1} {x2_lvl1} {y2_lvl1}";
    
    // Dimensões de Nível 5 (para o buffer)
    var dims_lvl5 := TERRITORY_DIMS_LEVEL_5;
    var width_lvl5 := dims_lvl5[1];
    var height_lvl5 := dims_lvl5[2];
    var x1_lvl5 := center_x - CInt(width_lvl5 / 2);
    var y1_lvl5 := center_y - CInt(height_lvl5 / 2);
    var x2_lvl5 := x1_lvl5 + width_lvl5;
    var y2_lvl5 := y1_lvl5 + height_lvl5;
    var max_rect_str := $"{x1_lvl5} {y1_lvl5} {x2_lvl5} {y2_lvl5}";
    var realm := center_point.realm;

    // AÇÃO 2: Verificar sobreposição usando MaxRect
    if (TM_CheckRectangleOverlap(rect_df, x1_lvl5, y1_lvl5, x2_lvl5, y2_lvl5, realm, ""))
        SendSysMessage(who, "A área máxima de expansão deste território (Nível 5) se sobrepõe a outro já existente.");
        SendSysMessage(who, "Operação cancelada. Tente em um local mais afastado.");
        return;
    endif
    
    var rect_name := RequestGump(who, "Digite um nome para este território padrão:");
    if (!rect_name) return; endif

    var elem := SafeFindElement(rect_df, rect_name, 1);
    
    // Salvar as informações
    var territory_id := CreateTerritoryID();
    SetElementProp(elem, TERRITORY_ID_PROP, territory_id);
    SetElementProp(elem, "Name", rect_name);
    
    // AÇÃO 2: Salvar AMBOS os retângulos
    SetElementProp(elem, "Rect", current_rect_str);
    SetElementProp(elem, "MaxRect", max_rect_str);
    
    SetElementProp(elem, "Realm", realm);
    SetElementProp(elem, TERRITORY_FACTION_PROP, DEFAULT_FACTION);
    
    // AÇÃO 1: Marcar como EXPANSÍVEL
    SetElementProp(elem, "IsExpandable", 1);
    
    SetupResourcesForTerritory(who, elem);
    SendSysMessage(who, $"Território padrão '{rect_name}' criado com sucesso!");
endfunction



function CreateChampionTerritory(who)
    // Primeiro, perguntar qual tipo de champion
    var champion_type := AskChampionType(who);
    if (!champion_type)
        SendSysMessage(who, "Criação de território cancelada.");
        return;
    endif
    
    SendSysMessage(who, "Champion selecionado: " + champion_type);
    SendSysMessage(who, "Selecione o CENTRO da arena do Champion Spawn.");
    
    var center_point := TargetCoordinates(who);
    if (!center_point)
        SendSysMessage(who, "Cancelado.");
        return;
    endif

    var rect_name := RequestGump(who, "Digite um nome para este território com Champion:");
    if (!rect_name) 
        SendSysMessage(who, "Nome é obrigatório. Operação cancelada.");
        return; 
    endif

    var creation_data := struct;
    creation_data.+champion_type := champion_type;
    creation_data.+territory_name := rect_name;
    creation_data.+target_location := center_point;
    
    SetObjProperty(who, "#temp_champion_creation", creation_data);
    SendSysMessage(who, "DEBUG: Dados temporários para '" + rect_name + "' salvos no personagem.");

    // Criar território no datafile primeiro
    var rect_df := SafeOpenDataFile(":architect:areas", 1);
    var elem := SafeFindElement(rect_df, rect_name, 1);
    
    var center_x := center_point.x;
    var center_y := center_point.y;
    var realm := center_point.realm;
    
    var territory_size := 50;
    var x1 := center_x - CInt(territory_size / 2);
    var y1 := center_y - CInt(territory_size / 2);
    var x2 := x1 + territory_size;
    var y2 := y1 + territory_size;
    var rect_str := $"{x1} {y1} {x2} {y2}";
    
    if (TM_CheckRectangleOverlap(rect_df, x1, y1, x2, y2, realm, ""))
        SendSysMessage(who, "A área do território se sobrepõe a outro já existente. Operação cancelada.");
        EraseObjProperty(who, "#temp_champion_creation");
        return;
    endif
    
    // Salvar território
    var territory_id := CreateTerritoryID();
    SetElementProp(elem, TERRITORY_ID_PROP, territory_id);
    SetElementProp(elem, "Name", rect_name);
    SetElementProp(elem, "Rect", rect_str);
    SetElementProp(elem, "Realm", realm);
    SetElementProp(elem, TERRITORY_FACTION_PROP, DEFAULT_FACTION);
    SetElementProp(elem, "IsExpandable", 0);
    SetElementProp(elem, "HasChampionSpawn", 1);
    SetElementProp(elem, "ChampionType", champion_type);
    
    SendSysMessage(who, $"Território '{rect_name}' criado! Configurando recursos...");
    SetupResourcesForTerritory(who, elem);
endfunction

// NOVO: Gump para escolher tipo de champion
function AskChampionType(who)
    var gump := GFECreateGump("Escolher Champion Spawn", 500, 300, array{BORDER_GOLDEN});
    
    var x := 30;
    var y := 70;
    
    GFTextMid(gump, 15, y, 470, 53, "Qual Champion Spawn deseja para este território?");
    y += 45;
    
    // Opção 1: Caverna dos Goblins
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 1);
    GFTextLine(gump, x + 40, y - 4, 1153, "Caverna dos Goblins");
    GFTextLine(gump, x + 40, y + 16, 1109, "16 ondas • Boss: Goblin King");
    y += 60;
    
    // Opção 2: Covil das Aranhas  
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 2);
    GFTextLine(gump, x + 40, y - 4, 1153, "Covil das Aranhas");
    GFTextLine(gump, x + 40, y + 16, 1109, "16 ondas • Boss: Mega Spider");
    y += 60;
    
    // Opção Cancelar
    GFAddButton(gump, x + 20, y, 2361, 2361, GF_CLOSE_BTN, 0);
    GFTextLine(gump, x + 40, y - 4, 38, "Cancelar");
    
    var input := GFSendGump(who, gump);
    var button := CInt(input[0]);
    
    case (button)
        1: return "CavernaDosGoblins";
        2: return "CovilDasAranhas";
        default: return "";
    endcase
endfunction