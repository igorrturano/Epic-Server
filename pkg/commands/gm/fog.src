    var vmin     := GetCurrentVMin(who);
    var vmax     := GetCurrentVMax(who);
    var noise    := GetCurrentNoiseStrength(who);
    var scale    := GetCurrentNoiseScale(who);
    var speed    := GetCurrentNoiseSpeed(who);
