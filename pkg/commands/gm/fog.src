    var speed    := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark     := GetCurrentDarkening(who);        // FOG-FASE3
    var cr       := GetCurrentColorR(who);           // FOG-FASE3
    var cg       := GetCurrentColorG(who);           // FOG-FASE3
    var cb       := GetCurrentColorB(who);           // FOG-FASE3
    var desat    := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_vmax", vmax_int);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, falloff, vmin, vmax_int, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog vmax=" + val + " (altitude).");
endfunction

