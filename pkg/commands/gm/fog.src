    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, falloff, vmin, vmax, noise, scale, speed, dark_int, cr, cg, cb, desat);
    SendSysMessage(who, "Fog dark=" + val + " (silhuetas).");
endfunction

function HandleColor(who, args)    // FOG-FASE3
    if (args.size() < 4)
        SendSysMessage(who, "Uso: .fog color R G B  (0.0 a 1.0 cada)");
        return;
    endif
    var r_val := CDbl(args[2]);
    var g_val := CDbl(args[3]);
    var b_val := CDbl(args[4]);
    if (r_val < 0.0 || r_val > 1.0 || g_val < 0.0 || g_val > 1.0 || b_val < 0.0 || b_val > 1.0)
        SendSysMessage(who, "Color fora do range. Use valores entre 0.0 e 1.0 para R, G e B.");
        return;
    endif
    var cr      := CInt(r_val * 255);
    var cg      := CInt(g_val * 255);
    var cb      := CInt(b_val * 255);
    var density := GetCurrentDensity(who);
    var radius  := GetCurrentRadius(who);
    var falloff := GetCurrentFalloff(who);
    var vmin    := GetCurrentVMin(who);
    var vmax    := GetCurrentVMax(who);
    var noise   := GetCurrentNoiseStrength(who);
    var scale   := GetCurrentNoiseScale(who);
    var speed   := GetCurrentNoiseSpeed(who);
    var dark    := GetCurrentDarkening(who);
    var desat   := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_color_r", cr);
    SetObjProperty(who, "fog_color_g", cg);
    SetObjProperty(who, "fog_color_b", cb);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog color=(" + r_val + ", " + g_val + ", " + b_val + ").");
endfunction

function HandleDesaturation(who, args)    // FOG-FASE3.2
    if (args.size() < 2)
        SendSysMessage(who, "Uso: .fog desat X  (0.0 a 1.0)");
        return;
    endif
    var val := CDbl(args[2]);
    if (val < 0.0 || val > 1.0)
        SendSysMessage(who, "Desaturation fora do range. Use um valor entre 0.0 e 1.0.");
        return;
    endif
    var desat_int := CInt(val * 1000);
    var density   := GetCurrentDensity(who);
    var radius    := GetCurrentRadius(who);
    var falloff   := GetCurrentFalloff(who);
    var vmin      := GetCurrentVMin(who);
    var vmax      := GetCurrentVMax(who);
    var noise     := GetCurrentNoiseStrength(who);
    var scale     := GetCurrentNoiseScale(who);
    var speed     := GetCurrentNoiseSpeed(who);
    var dark      := GetCurrentDarkening(who);
    var cr        := GetCurrentColorR(who);
    var cg        := GetCurrentColorG(who);
    var cb        := GetCurrentColorB(who);
    SetObjProperty(who, "fog_desaturation", desat_int);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat_int);
    SendSysMessage(who, "Fog desat=" + val + " (dessaturação por distância).");
endfunction
