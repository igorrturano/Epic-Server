// .fog on               — ativa fog com valores atuais (ou defaults)
// .fog off              — desativa fog mantendo valores atuais
// .fog density X        — ajusta densidade (0.0001 a 0.1), liga fog
// .fog radius X         — ajusta raio de clearing (50 a 2000), liga fog
// .fog falloff X        — ajusta falloff do clearing (10 a 500), liga fog
// .fog vmin X           — fator vertical no chão (0.0 a 3.0)          // FOG-FASE2
// .fog vmax X           — fator vertical no topo (0.0 a 3.0)          // FOG-FASE2
// .fog noise X          — força do noise volumétrico (0.0 a 1.0)      // FOG-FASE3
// .fog scale X          — escala UV do noise (0.1 a 5.0)              // FOG-FASE3
// .fog speed X          — velocidade de drift do noise (0.0 a 1.0)    // FOG-FASE3
// .fog dark X           — escurecimento de silhuetas (0.0 a 1.0)      // FOG-FASE3
// .fog color R G B      — cor da névoa (0.0 a 1.0 cada)              // FOG-FASE3
// .fog desat X          — dessaturação por distância (0.0 a 1.0)      // FOG-FASE3.2

use uo;
use os;

include ":hotbar:include/shared_constants";
include ":hotbar:include/hotbar_write";

const FOG_SUBCOMMAND    := 0x0070;
const FOG_PACKET_SIZE   := 29;                  // FOG-FASE3.2: era 27 (v3)

const FOG_DEFAULT_DENSITY := 80;    // 0.0008 * 100000
const FOG_DEFAULT_RADIUS  := 200;
const FOG_DEFAULT_FALLOFF := 100;
const FOG_DEFAULT_VMIN    := 300;   // FOG-FASE2: 0.3 * 1000
const FOG_DEFAULT_VMAX    := 1200;  // FOG-FASE2: 1.2 * 1000
const FOG_DEFAULT_NOISE_STRENGTH := 500;   // FOG-FASE3: 0.5 * 1000
const FOG_DEFAULT_NOISE_SCALE    := 1000;  // FOG-FASE3: 1.0 * 1000
const FOG_DEFAULT_NOISE_SPEED    := 500;   // FOG-FASE3: 0.05 * 10000
const FOG_DEFAULT_DARKENING      := 300;   // FOG-FASE3: 0.3 * 1000
const FOG_DEFAULT_COLOR_R        := 128;   // FOG-FASE3: 0.50 * 255
const FOG_DEFAULT_COLOR_G        := 133;   // FOG-FASE3: 0.52 * 255
const FOG_DEFAULT_COLOR_B        := 148;   // FOG-FASE3: 0.58 * 255
const FOG_DEFAULT_DESATURATION   := 0;     // FOG-FASE3.2: 0.0 * 1000

program fog(who, text)
    if (who.cmdlevel < 3)
        SendSysMessage(who, "Apenas GMs podem usar este comando.");
        return 0;
    endif

    var args := SplitWords(text);

    if (args.size() < 1)
        SendSysMessage(who, "Uso: .fog on|off|density|radius|falloff|vmin|vmax|noise|scale|speed|dark|color|desat");
        return 0;
    endif

    var sub := Lower(CStr(args[1]));

    if (sub == "on")
        HandleOn(who);
    elseif (sub == "off")
        HandleOff(who);
    elseif (sub == "density")
        HandleDensity(who, args);
    elseif (sub == "radius")
        HandleRadius(who, args);
    elseif (sub == "falloff")
        HandleFalloff(who, args);
    elseif (sub == "vmin")
        HandleVMin(who, args);
    elseif (sub == "vmax")
        HandleVMax(who, args);
    elseif (sub == "noise")          // FOG-FASE3
        HandleNoise(who, args);
    elseif (sub == "scale")          // FOG-FASE3
        HandleScale(who, args);
    elseif (sub == "speed")          // FOG-FASE3
        HandleSpeed(who, args);
    elseif (sub == "dark")           // FOG-FASE3
        HandleDarkening(who, args);
    elseif (sub == "color")          // FOG-FASE3
        HandleColor(who, args);
    elseif (sub == "desat")          // FOG-FASE3.2
        HandleDesaturation(who, args);
    else
        SendSysMessage(who, "Uso: .fog on|off|density|radius|falloff|vmin|vmax|noise|scale|speed|dark|color|desat");
    endif
endprogram

// ── State helpers ──────────────────────────────────────────────────────────

function GetCurrentDensity(who)
    var val := CInt(GetObjProperty(who, "fog_density"));
    if (val <= 0)
        return FOG_DEFAULT_DENSITY;
    endif
    return val;
endfunction

function GetCurrentRadius(who)
    var val := CInt(GetObjProperty(who, "fog_radius"));
    if (val <= 0)
        return FOG_DEFAULT_RADIUS;
    endif
    return val;
endfunction

function GetCurrentFalloff(who)
    var val := CInt(GetObjProperty(who, "fog_falloff"));
    if (val <= 0)
        return FOG_DEFAULT_FALLOFF;
    endif
    return val;
endfunction

function GetCurrentVMin(who)
    var val := CInt(GetObjProperty(who, "fog_vmin"));
    if (val <= 0)
        return FOG_DEFAULT_VMIN;
    endif
    return val;
endfunction

function GetCurrentVMax(who)
    var val := CInt(GetObjProperty(who, "fog_vmax"));
    if (val <= 0)
        return FOG_DEFAULT_VMAX;
    endif
    return val;
endfunction

function GetCurrentNoiseStrength(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_noise_strength"));
    if (val <= 0)
        return FOG_DEFAULT_NOISE_STRENGTH;
    endif
    return val;
endfunction

function GetCurrentNoiseScale(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_noise_scale"));
    if (val <= 0)
        return FOG_DEFAULT_NOISE_SCALE;
    endif
    return val;
endfunction

function GetCurrentNoiseSpeed(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_noise_speed"));
    if (val <= 0)
        return FOG_DEFAULT_NOISE_SPEED;
    endif
    return val;
endfunction

function GetCurrentDarkening(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_darkening"));
    if (val <= 0)
        return FOG_DEFAULT_DARKENING;
    endif
    return val;
endfunction

function GetCurrentColorR(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_color_r"));
    if (val <= 0)
        return FOG_DEFAULT_COLOR_R;
    endif
    return val;
endfunction

function GetCurrentColorG(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_color_g"));
    if (val <= 0)
        return FOG_DEFAULT_COLOR_G;
    endif
    return val;
endfunction

function GetCurrentColorB(who)    // FOG-FASE3
    var val := CInt(GetObjProperty(who, "fog_color_b"));
    if (val <= 0)
        return FOG_DEFAULT_COLOR_B;
    endif
    return val;
endfunction

function GetCurrentDesaturation(who)    // FOG-FASE3.2
    var val := CInt(GetObjProperty(who, "fog_desaturation"));
    if (val <= 0)
        return FOG_DEFAULT_DESATURATION;
    endif
    return val;
endfunction

// ── Packet builder ─────────────────────────────────────────────────────────

function SendFogPacket(who, enabled, density_int, radius, falloff, vmin_int, vmax_int, noise_int, scale_int, speed_int, dark_int, color_r, color_g, color_b, desaturation_int)  // FOG-FASE3.2
    var pkt := CreatePacket(PACKET_EXTENDED, FOG_PACKET_SIZE);
    pkt.SetInt8(0, PACKET_EXTENDED);             // offset 0:    opcode 0xD7
    SetInt16BE(pkt, 1, FOG_PACKET_SIZE);         // offset 1-2:  length = 29
    SetInt16BE(pkt, 3, FOG_SUBCOMMAND);          // offset 3-4:  subcommand 0x0070
    pkt.SetInt8(5, enabled);                     // offset 5:    fogEnabled
    SetInt16BE(pkt, 6, density_int);             // offset 6-7:  density * 100000
    SetInt16BE(pkt, 8, radius);                  // offset 8-9:  clearing radius
    SetInt16BE(pkt, 10, falloff);                // offset 10-11: clearing falloff
    SetInt16BE(pkt, 12, vmin_int);               // offset 12-13: vmin * 1000
    SetInt16BE(pkt, 14, vmax_int);               // offset 14-15: vmax * 1000
    SetInt16BE(pkt, 16, noise_int);              // offset 16-17: noiseStrength * 1000  // FOG-FASE3
    SetInt16BE(pkt, 18, scale_int);              // offset 18-19: noiseScale * 1000     // FOG-FASE3
    SetInt16BE(pkt, 20, speed_int);              // offset 20-21: noiseSpeed * 10000    // FOG-FASE3
    SetInt16BE(pkt, 22, dark_int);               // offset 22-23: darkening * 1000      // FOG-FASE3
    pkt.SetInt8(24, color_r);                    // offset 24:   fogR (0-255)           // FOG-FASE3
    pkt.SetInt8(25, color_g);                    // offset 25:   fogG (0-255)           // FOG-FASE3
    pkt.SetInt8(26, color_b);                    // offset 26:   fogB (0-255)           // FOG-FASE3
    SetInt16BE(pkt, 27, desaturation_int);       // offset 27-28: desaturation * 1000   // FOG-FASE3.2
    pkt.SendPacket(who);
endfunction

// ── Sub-command handlers ───────────────────────────────────────────────────

function HandleOn(who)
    var density := GetCurrentDensity(who);
    var radius  := GetCurrentRadius(who);
    var falloff := GetCurrentFalloff(who);
    var vmin    := GetCurrentVMin(who);
    var vmax    := GetCurrentVMax(who);
    var noise   := GetCurrentNoiseStrength(who);    // FOG-FASE3
    var scale   := GetCurrentNoiseScale(who);       // FOG-FASE3
    var speed   := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark    := GetCurrentDarkening(who);        // FOG-FASE3
    var cr      := GetCurrentColorR(who);           // FOG-FASE3
    var cg      := GetCurrentColorG(who);           // FOG-FASE3
    var cb      := GetCurrentColorB(who);           // FOG-FASE3
    var desat   := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog ativado (density=" + (CDbl(density) / 100000) + " radius=" + radius + " falloff=" + falloff + ").");
endfunction

function HandleOff(who)
    var density := GetCurrentDensity(who);
    var radius  := GetCurrentRadius(who);
    var falloff := GetCurrentFalloff(who);
    var vmin    := GetCurrentVMin(who);
    var vmax    := GetCurrentVMax(who);
    var noise   := GetCurrentNoiseStrength(who);    // FOG-FASE3
    var scale   := GetCurrentNoiseScale(who);       // FOG-FASE3
    var speed   := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark    := GetCurrentDarkening(who);        // FOG-FASE3
    var cr      := GetCurrentColorR(who);           // FOG-FASE3
    var cg      := GetCurrentColorG(who);           // FOG-FASE3
    var cb      := GetCurrentColorB(who);           // FOG-FASE3
    var desat   := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_enabled", 0);
    SendFogPacket(who, 0, density, radius, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog desativado.");
endfunction

function HandleDensity(who, args)
    if (args.size() < 2)
        SendSysMessage(who, "Uso: .fog density X  (0.0001 a 0.1)");
        return;
    endif
    var val := CDbl(args[2]);
    if (val < 0.0001 || val > 0.1)
        SendSysMessage(who, "Density fora do range. Use um valor entre 0.0001 e 0.1.");
        return;
    endif
    var density_int := CInt(val * 100000);
    var radius      := GetCurrentRadius(who);
    var falloff     := GetCurrentFalloff(who);
    var vmin        := GetCurrentVMin(who);
    var vmax        := GetCurrentVMax(who);
    var noise       := GetCurrentNoiseStrength(who);    // FOG-FASE3
    var scale       := GetCurrentNoiseScale(who);       // FOG-FASE3
    var speed       := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark        := GetCurrentDarkening(who);        // FOG-FASE3
    var cr          := GetCurrentColorR(who);           // FOG-FASE3
    var cg          := GetCurrentColorG(who);           // FOG-FASE3
    var cb          := GetCurrentColorB(who);           // FOG-FASE3
    var desat       := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_density", density_int);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density_int, radius, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog density=" + val + " (radius=" + radius + " falloff=" + falloff + ").");
endfunction

function HandleRadius(who, args)
    if (args.size() < 2)
        SendSysMessage(who, "Uso: .fog radius X  (50 a 2000)");
        return;
    endif
    var val := CInt(args[2]);
    if (val < 50 || val > 2000)
        SendSysMessage(who, "Radius fora do range. Use um valor entre 50 e 2000.");
        return;
    endif
    var density := GetCurrentDensity(who);
    var falloff := GetCurrentFalloff(who);
    var vmin    := GetCurrentVMin(who);
    var vmax    := GetCurrentVMax(who);
    var noise   := GetCurrentNoiseStrength(who);    // FOG-FASE3
    var scale   := GetCurrentNoiseScale(who);       // FOG-FASE3
    var speed   := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark    := GetCurrentDarkening(who);        // FOG-FASE3
    var cr      := GetCurrentColorR(who);           // FOG-FASE3
    var cg      := GetCurrentColorG(who);           // FOG-FASE3
    var cb      := GetCurrentColorB(who);           // FOG-FASE3
    var desat   := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_radius", val);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, val, falloff, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog radius=" + val + " (density=" + (CDbl(density) / 100000) + " falloff=" + falloff + ").");
endfunction

function HandleFalloff(who, args)
    if (args.size() < 2)
        SendSysMessage(who, "Uso: .fog falloff X  (10 a 500)");
        return;
    endif
    var val := CInt(args[2]);
    if (val < 10 || val > 500)
        SendSysMessage(who, "Falloff fora do range. Use um valor entre 10 e 500.");
        return;
    endif
    var density := GetCurrentDensity(who);
    var radius  := GetCurrentRadius(who);
    var vmin    := GetCurrentVMin(who);
    var vmax    := GetCurrentVMax(who);
    var noise   := GetCurrentNoiseStrength(who);    // FOG-FASE3
    var scale   := GetCurrentNoiseScale(who);       // FOG-FASE3
    var speed   := GetCurrentNoiseSpeed(who);       // FOG-FASE3
    var dark    := GetCurrentDarkening(who);        // FOG-FASE3
    var cr      := GetCurrentColorR(who);           // FOG-FASE3
    var cg      := GetCurrentColorG(who);           // FOG-FASE3
    var cb      := GetCurrentColorB(who);           // FOG-FASE3
    var desat   := GetCurrentDesaturation(who);     // FOG-FASE3.2
    SetObjProperty(who, "fog_falloff", val);
    SetObjProperty(who, "fog_enabled", 1);
    SendFogPacket(who, 1, density, radius, val, vmin, vmax, noise, scale, speed, dark, cr, cg, cb, desat);
    SendSysMessage(who, "Fog falloff=" + val + " (density=" + (CDbl(density) / 100000) + " radius=" + radius + ").");
endfunction

