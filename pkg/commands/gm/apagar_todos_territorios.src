use os;
use uo;
use guilds;
include ":gumps:yesNo";
include ":faccao:include/shared_functions";

program apagar_todos_territorios(who)
    // 1. VERIFICAÇÃO DE PERMISSÃO
    if (!who || who.cmdlevel < 3)
        SendSysMessage(who, "Apenas administradores podem usar este comando.");
        return 0;
    endif

    // 2. CONFIRMAÇÃO DUPLA E EXPLÍCITA
    if (!YesNo(who, "ATENÇÃO: Esta ação é DESTRUTIVA e IRREVERSÍVEL. Você tem certeza que deseja APAGAR TODOS os territórios, objetos e referências do sistema?"))
        SendSysMessage(who, "Ação cancelada.");
        return 0;
    endif
    if (!YesNo(who, "CONFIRMAÇÃO FINAL: Continuar com a remoção completa de TODOS os territórios?"))
        SendSysMessage(who, "Ação cancelada.");
        return 0;
    endif

    SendSysMessage(who, "INICIANDO LIMPEZA COMPLETA DE TERRITÓRIOS. O servidor pode apresentar lentidão...");
    LogInfo("territorio", "[[LIMPEZA GERAL INICIADA]] por GM " + who.name);

    var areas_apagadas := 0;
    var obj_destruidos := 0;
    var guilds_limpas := 0;

    // 3. OBTER A LISTA DE TODOS OS TERRITÓRIOS A SEREM REMOVIDOS PRIMEIRO
    var rect_df := SafeOpenDataFile(":architect:areas");
    if (!rect_df)
        SendSysMessage(who, "Erro: Não foi possível abrir o datafile de territórios. Ação abortada.");
        return 0;
    endif
    var territorios_para_apagar := rect_df.keys();

    // 4. ITERAR SOBRE A LISTA COPIADA E DELETAR UM POR UM
    foreach nome_territorio in (territorios_para_apagar)
        var elem := SafeFindElement(rect_df, nome_territorio);
        if (!elem) continue; endif
        
        var territory_id := GetElementProp(elem, TERRITORY_ID_PROP, "");
        if (!territory_id) territory_id := nome_territorio; endif

        var faction := GetTerritoryFaction(elem);
        if (!faction) faction := DEFAULT_FACTION; endif
        
        SendSysMessage(who, "Apagando " + nome_territorio + " (Facção: " + faction + ")...");
        
        // A. Destruir objetos associados
        obj_destruidos += TM_DeleteTerritoryObjects(territory_id, faction);
        
        // B. Remover referências em guildas
        guilds_limpas += RemoveTerritoryFromGuilds(nome_territorio, territory_id);
        
        // C. Apagar o elemento do datafile de áreas
        if (DeleteDatafileEntry(":architect:areas", nome_territorio))
            areas_apagadas += 1;
        else
            LogWarning("apagar_territorios", "Falha ao apagar o elemento '" + nome_territorio + "' do datafile de áreas.");
        endif
        
        sleepms(10);
    endforeach;
     SendSysMessage(who, "FASE 2: Validando estado final de todas as facções...");
    LogInfo("territorio", "Iniciando varredura final para resetar reinos sem território.");

    var reinos_resetados := 0;
    var all_guilds := ListGuilds();

    foreach guild in all_guilds
        var guild_name := SafeGetGuildName(guild);
        if (guild_name && guild_name != "Unknown Guild")
            // Usamos GetFactionTerritoryCount que lê DIRETAMENTE de :architect:areas.
            // Como o datafile está vazio, o resultado será 0 para todas as facções.
            var territory_count := GetFactionTerritoryCount(guild_name);
            
            if (territory_count == 0)
                // FORÇAMOS o reset do reino.
                ResetKingdomLevelAndXP(guild);
                reinos_resetados += 1;
                LogWarning("territorio", "VALIDAÇÃO FINAL: Facção '" + guild_name + "' encontrada sem territórios. Nível e XP resetados.");
            endif
        endif
        sleepms(20); // Pausa para não sobrecarregar
    endforeach;
    // 5. LIMPEZA FINAL DOS DATAFILES DE SERIAIS E TRANSAÇÕES (VERSÃO CORRIGIDA)
    LogInfo("territorio", "Iniciando limpeza dos datafiles :faccao:seriais e :faccao:transacoes...");

    // Limpar :faccao:seriais
    var seriais_df := SafeOpenDataFile(":faccao:seriais");
    var seriais_apagados := 0;
    if (seriais_df)
        var serial_keys := seriais_df.keys();
        foreach key in serial_keys
            seriais_df.DeleteElement(key);
            seriais_apagados += 1;
            sleepms(1);
        endforeach;
        UnloadDataFile(":faccao:seriais");
        LogInfo("territorio", "Datafile :faccao:seriais limpo. " + seriais_apagados + " elementos removidos.");
    endif

    // Limpar :faccao:transacoes
    var transacoes_df := SafeOpenDataFile(":faccao:transacoes");
    var trans_apagadas := 0;
    if (transacoes_df)
        var trans_keys := transacoes_df.keys();
        foreach key in trans_keys
            transacoes_df.DeleteElement(key);
            trans_apagadas += 1;
            sleepms(1);
        endforeach;
        UnloadDataFile(":faccao:transacoes");
        LogInfo("territorio", "Datafile :faccao:transacoes limpo. " + trans_apagadas + " elementos removidos.");
    endif
    
    // 6. MENSAGEM FINAL
     SendSysMessage(who, "==================================================");
    SendSysMessage(who, "LIMPEZA COMPLETA DE TERRITÓRIOS CONCLUÍDA!");
    SendSysMessage(who, "Territórios apagados: " + areas_apagadas);
    SendSysMessage(who, "Objetos de território destruídos: " + obj_destruidos);
    SendSysMessage(who, "Validação final resetou " + reinos_resetados + " reinos."); // <-- NOVA LINHA DE FEEDBACK
    SendSysMessage(who, "Datafiles de seriais e transações limpos.");
    SendSysMessage(who, "==================================================");
    
    LogInfo("territorio", "[[LIMPEZA GERAL FINALIZADA]] por GM " + who.name + ". Áreas: " + areas_apagadas + ", Reinos Resetados: " + reinos_resetados);
    
    return 1;
endprogram