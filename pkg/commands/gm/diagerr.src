// .diagerr - sonda empírica de retorno de erros em POL/wrappers/getobjproperty.
//
// Uso: .diagerr (sem alvo — usa você mesmo como cobaia).
// Tudo cai no print() do console POL — sem UI in-game.
//
// O que está sendo respondido:
//   - error builtin: como ele se compara, qual TypeOf, é falsy ou truthy?
//   - GetObjProperty(prop inexistente): retorna error builtin ou struct?
//   - PegaPropObjItemOrTemplate idem
//   - WrapperX em path inválido: GetObjRef() retorna error builtin ou
//     InvalidTemplateException class? `is @Exception` realmente funciona?
//   - .connected / .npctemplate: tipo de retorno

use uo;
use os;
use util;

include ":wrappers:Objects/Model/UObjectWrapper";
include ":wrappers:Objects/Model/ItemWrapper";
include ":wrappers:Objects/Model/ContainerWrapper";
include ":wrappers:Objects/Model/EquipWrapper";
include ":wrappers:Objects/Model/ArmorWrapper";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":wrappers:Objects/Model/MobileWrapper";
include ":megacliloc:include/toolTipUtils";

program diagerr(who)
	print("");
	print("===================== DIAGERR =====================");
	print($"alvo: serial=0x{Hex(who.serial)} name='{who.name}'");

	print("");
	print("--- POL builtin error keyword ---");
	DumpValue("error", error);

	print("");
	print("--- POL builtin uninit (0 var) ---");
	var nada;
	DumpValue("nada", nada);

	print("");
	print("--- who (executor) ---");
	DumpValue("who", who);
	print($"  IsA(POLCLASS_MOBILE) = {who.IsA(POLCLASS_MOBILE)}");

	print("");
	print("--- .connected / .npctemplate ---");
	DumpValue("who.connected", who.connected);
	DumpValue("who.npctemplate", who.npctemplate);

	print("");
	print("--- GetObjProperty (prop inexistente) ---");
	var miss := GetObjProperty(who, "_diagprobe_nonexistent_xyz_");
	DumpValue("missing prop", miss);

	print("");
	print("--- PegaPropObjItemOrTemplate em mobile (prop inexistente) ---");
	var pmiss := PegaPropObjItemOrTemplate(who, "_diagprobe_nonexistent_xyz_");
	DumpValue("missing prop on mobile", pmiss);

	print("");
	print("--- struct field access em error ---");
	var x := error;
	DumpValue("error.foo", x.foo);
	DumpValue("error.errortext", x.errortext);

	print("");
	print("--- Wrapper em who (player) ---");
	ProbeWrapper("UObjectWrapper(who)", UObjectWrapper(who));
	ProbeMobileWrapperOn(who);
	// Items que o player não é: probe wrappers "errados" e vê o que retornam
	ProbeWrapper("ItemWrapper(who)", ItemWrapper(who));
	ProbeWrapper("ContainerWrapper(who)", ContainerWrapper(who));
	ProbeWrapper("EquipWrapper(who)", EquipWrapper(who));
	ProbeWrapper("ArmorWrapper(who)", ArmorWrapper(who));
	ProbeWrapper("WeaponWrapper(who)", WeaponWrapper(who));

	print("");
	print("--- Wrapper em arma equipada (se tiver) ---");
	var wpn := who.weapon;
	if (wpn)
		DumpValue("who.weapon", wpn);
		ProbeWrapper("WeaponWrapper(weapon)", WeaponWrapper(wpn));
		ProbeWrapper("ArmorWrapper(weapon)", ArmorWrapper(wpn)); // path errado: arma não é armadura
		ProbeWrapper("ContainerWrapper(weapon)", ContainerWrapper(wpn));
		var wprop := PegaPropObjItemOrTemplate(wpn, "_diagprobe_nonexistent_xyz_");
		DumpValue("PegaProp miss on weapon", wprop);
	else
		print("  sem arma equipada — pula");
	endif

	print("");
	print("--- Wrapper em backpack ---");
	var bp := who.backpack;
	if (bp)
		DumpValue("who.backpack", bp);
		ProbeWrapper("ContainerWrapper(backpack)", ContainerWrapper(bp));
		ProbeWrapper("WeaponWrapper(backpack)", WeaponWrapper(bp)); // path errado
	else
		print("  sem backpack — pula");
	endif

	print("");
	print("--- Wrapper em template name (string) ---");
	ProbeWrapper("MobileWrapper('orc')", MobileWrapper("orc"));
	ProbeWrapper("MobileWrapper('_diag_nonexistent_')", MobileWrapper("_diag_nonexistent_"));

	print("===================================================");
	print("");

	SendSysMessage(who, "Dump no console POL.");
	return 1;
endprogram

// Imprime as 6 facetas mais úteis pra discriminar tipo de retorno.
function DumpValue(label, v)
	print($"  [{label}]");
	print($"    TypeOf          = {TypeOf(v)}");
	print($"    TypeOfInt       = {TypeOfInt(v)}");
	print($"    !v              = {!v}");
	print($"    v == error      = {v == error}");
	print($"    v is @Exception = {v is @Exception}");
	print($"    CStr(v)         = {CStr(v)}");
	return 1;
endfunction

function ProbeWrapper(name, w)
	print("");
	print($"[{name}]");
	DumpValue("wrapper", w);
	var ref := w.GetObjRef();
	DumpValue("GetObjRef()", ref);
	return 1;
endfunction

function ProbeMobileWrapperOn(targ)
	var mw := MobileWrapper(targ);
	print("");
	print("[MobileWrapper(who)]");
	DumpValue("wrapper", mw);
	DumpValue("GetObjRef()", mw.GetObjRef());
	DumpValue("Race", mw.Race);
	DumpValue("Culture", mw.Culture);
	DumpValue("Religion", mw.Religion);
	DumpValue("Subclasse", mw.Subclasse);
	DumpValue("Template (NPC-only)", mw.Template);
	DumpValue("ObjType (player-only)", mw.ObjType);
	return 1;
endfunction
