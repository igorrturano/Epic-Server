// .diagerr - sonda empírica de retorno de erros em POL/wrappers/getobjproperty.
//
// Uso: .diagerr → seleciona um alvo (player conectado, NPC, item arma,
// item armadura, item container, item genérico, template ref).
// Tudo cai no print() do console POL — sem UI in-game. Roda quantas vezes
// quiser, em alvos diferentes, e cola o output pra construir a matriz de
// "quando POL retorna error vs Exception vs 0 vs uninit".
//
// O que está sendo respondido:
//   - error builtin: como ele se compara, qual TypeOf, é falsy ou truthy?
//   - GetObjProperty(prop inexistente): retorna error builtin ou struct?
//   - PegaPropObjItemOrTemplate idem
//   - WrapperX(alvo) em path inválido: GetObjRef() retorna error builtin
//     ou InvalidTemplateException class? `is @Exception` realmente funciona?
//   - .connected em ref recém-deletada/desconectada: retorna 0 ou error?

use uo;
use os;
use util;

include ":wrappers:Objects/Model/UObjectWrapper";
include ":wrappers:Objects/Model/ItemWrapper";
include ":wrappers:Objects/Model/ContainerWrapper";
include ":wrappers:Objects/Model/EquipWrapper";
include ":wrappers:Objects/Model/ArmorWrapper";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":wrappers:Objects/Model/MobileWrapper";
include ":megacliloc:include/toolTipUtils";

program diagerr(who)
	SendSysMessage(who, "Selecione o alvo (Ctrl+Esc cancela).");
	var target := Target(who);
	if (!target)
		SendSysMessage(who, "Cancelado.");
		return 0;
	endif

	print("");
	print("===================== DIAGERR =====================");
	print($"alvo: serial=0x{Hex(target.serial)} name='{target.name}'");
	DumpValue("target", target);

	print("");
	print("--- POL builtin error keyword ---");
	DumpValue("error", error);

	print("");
	print("--- POL builtin uninit (0 var) ---");
	var nada;
	DumpValue("nada", nada);

	print("");
	print("--- IsA checks no alvo ---");
	print($"  IsA(POLCLASS_MOBILE) = {target.IsA(POLCLASS_MOBILE)}");
	print($"  IsA(POLCLASS_ITEM)   = {target.IsA(POLCLASS_ITEM)}");

	if (target.IsA(POLCLASS_MOBILE))
		print("");
		print("--- .connected / .npctemplate ---");
		DumpValue("target.connected", target.connected);
		DumpValue("target.npctemplate", target.npctemplate);
	endif

	print("");
	print("--- GetObjProperty (prop inexistente) ---");
	var miss := GetObjProperty(target, "_diagprobe_nonexistent_xyz_");
	DumpValue("missing prop", miss);

	print("");
	print("--- PegaPropObjItemOrTemplate (prop inexistente) ---");
	var pmiss := PegaPropObjItemOrTemplate(target, "_diagprobe_nonexistent_xyz_");
	DumpValue("missing prop", pmiss);

	print("");
	print("--- struct field access em error ---");
	var x := error;
	DumpValue("error.foo", x.foo);
	DumpValue("error.errortext", x.errortext);

	print("");
	print("--- Wrapper constructions ---");
	ProbeWrapper("UObjectWrapper", UObjectWrapper(target));

	if (target.IsA(POLCLASS_MOBILE))
		ProbeMobileWrapper(target);
	endif

	if (target.IsA(POLCLASS_ITEM))
		ProbeWrapper("ItemWrapper", ItemWrapper(target));
		ProbeWrapper("ContainerWrapper", ContainerWrapper(target));
		ProbeWrapper("EquipWrapper", EquipWrapper(target));
		ProbeWrapper("ArmorWrapper", ArmorWrapper(target));
		ProbeWrapper("WeaponWrapper", WeaponWrapper(target));
	endif

	print("");
	print("--- Wrapper em template name (string) ---");
	ProbeWrapper("MobileWrapper('orc')", MobileWrapper("orc"));
	ProbeWrapper("MobileWrapper('_diag_nonexistent_')", MobileWrapper("_diag_nonexistent_"));

	print("===================================================");
	print("");

	SendSysMessage(who, "Dump no console POL.");
	return 1;
endprogram

// Imprime as 6 facetas mais úteis pra discriminar tipo de retorno.
function DumpValue(label, v)
	print($"  [{label}]");
	print($"    TypeOf       = {TypeOf(v)}");
	print($"    TypeOfInt    = {TypeOfInt(v)}");
	print($"    !v           = {!v}");
	print($"    v == error   = {v == error}");
	print($"    v is @Exception = {v is @Exception}");
	print($"    CStr(v)      = {CStr(v)}");
	return 1;
endfunction

function ProbeWrapper(name, w)
	print("");
	print($"[{name}]");
	DumpValue("wrapper", w);
	var ref := w.GetObjRef();
	DumpValue("GetObjRef()", ref);
	return 1;
endfunction

function ProbeMobileWrapper(target)
	var mw := MobileWrapper(target);
	print("");
	print("[MobileWrapper]");
	DumpValue("wrapper", mw);
	DumpValue("GetObjRef()", mw.GetObjRef());
	DumpValue("Race", mw.Race);
	DumpValue("Culture", mw.Culture);
	DumpValue("Religion", mw.Religion);
	DumpValue("Subclasse", mw.Subclasse);
	DumpValue("Template (NPC-only)", mw.Template);
	DumpValue("ObjType (player-only)", mw.ObjType);
	return 1;
endfunction
