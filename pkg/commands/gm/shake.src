use uo;
use os;

include "include/packets";
include ":message:include/model/Message";

/*
 * GM Command: .shake
 *
 * Triggers a screen shake effect for testing.
 *
 * Usage:
 *   .shake                    - Moderate earthquake (0.5s, 10px)
 *   .shake <preset>           - Use preset: instant, light, moderate, strong, catastrophic, extreme
 *   .shake <duration> <mag>   - Custom duration (seconds) and magnitude (pixels)
 *
 * Duration: 0.1s to 25.5s (0.1 second precision)
 * Magnitude: 0-255 pixels (>25px may cause visual artifacts)
 *
 * Presets:
 *   instant      - Very quick impact (0.1s, 3px)
 *   light        - Quick tremor (0.3s, 5px)
 *   moderate     - Standard earthquake (0.5s, 10px)
 *   strong       - Strong earthquake (0.8s, 15px)
 *   catastrophic - Devastating earthquake (1.0s, 20px)
 *   extreme      - Very long shake (5.0s, 50px)
 *   max          - Maximum duration test (25.5s, 25px)
 */

program ShakeCommand(who, text)
    var params := SplitWords(text);
    var duration := 0.5;
    var magnitude := 10;

    if (params.size() == 0)
        // Default: moderate earthquake
        duration := 0.5;
        magnitude := 10;
    elseif (params.size() == 1)
        // Check for preset
        var preset := Lower(params[1]);
        case (preset)
            "instant":
                duration := 0.1;
                magnitude := 3;
            "light":
                duration := 0.3;
                magnitude := 5;
            "moderate":
                duration := 0.5;
                magnitude := 10;
            "strong":
                duration := 0.8;
                magnitude := 15;
            "catastrophic":
                duration := 1.0;
                magnitude := 20;
            "extreme":
                duration := 5.0;
                magnitude := 50;
            "max":
                duration := 25.5;
                magnitude := 25;
            default:
                Message("Unknown preset. Valid presets: instant, light, moderate, strong, catastrophic, extreme, max").SendSys(who);
                return;
        endcase
    elseif (params.size() == 2)
        // Custom parameters
        duration := CDbl(params[1]);
        magnitude := CInt(params[2]);

        if (duration < 0.1)
            Message("Error: Duration must be at least 0.1 seconds (minimum)").SendSys(who);
            return;
        elseif (duration > 25.5)
            Message("Error: Duration cannot exceed 25.5 seconds (maximum)").SendSys(who);
            return;
        endif

        if (magnitude <= 0)
            Message("Error: Magnitude must be a positive value").SendSys(who);
            return;
        endif

        if (magnitude > 25)
            Message("Warning: Magnitude > 25 may cause visual artifacts (black edges)").SendSys(who);
        endif
    else
        Message("Usage: .shake [preset|duration magnitude]").SendSys(who);
        Message("Presets: instant, light, moderate, strong, catastrophic, extreme, max").SendSys(who);
        Message("Duration: 0.1-25.5s | Magnitude: 1-255px").SendSys(who);
        return;
    endif

    Message("Screen shake: " + duration + "s, " + magnitude + "px").SendSys(who);
    ScreenShake(who, duration, magnitude);
endprogram
