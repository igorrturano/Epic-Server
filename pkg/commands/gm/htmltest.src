        "  <div class='objetivo'><div class='check-open'></div><div>Recuperar o Amuleto de Vesper (0/1)</div></div>" +
        "  <div class='objetivo'><div class='check-open'></div><div>Derrotar o Cultista Lider (0/1)</div></div>" +
        "  <div class='objetivo'><div class='check-open'></div><div>Retornar ao Templo</div></div>" +
