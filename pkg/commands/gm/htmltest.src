        ".btn-accept { flex: 1; height: 34px; background-color: #166534; border-radius: 5px;" +
        "  border: 1px solid #22c55e; display: flex; align-items: center; font-size: 12px; color: #d1fae5; }" +
        ".btn-decline { flex: 1; height: 34px; background-color: #7f1d1d; border-radius: 5px;" +
