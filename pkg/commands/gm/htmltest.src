        "  <div class='cell' style='background-color:#1abc9c'>1fr</div>" +
        "</div>" +
        "<div class='lbl'>grid-template-columns: 1fr 3fr 1fr (coluna central tripla)</div>" +
        "<div class='grid' style='grid-template-columns:1fr 3fr 1fr'>" +
        "  <div class='cell' style='background-color:#e74c3c'>1fr</div>" +
        "  <div class='cell' style='background-color:#f1c40f'>3fr — centro</div>" +
        "  <div class='cell' style='background-color:#e74c3c'>1fr</div>" +
        "  <div class='cell' style='background-color:#9b59b6'>1fr</div>" +
        "  <div class='cell' style='background-color:#f1c40f'>3fr — centro</div>" +
        "  <div class='cell' style='background-color:#9b59b6'>1fr</div>" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_GRID, html, 460, 380, 100, 60);
    SendSysMessage(quem, "[HtmlGump] Demo CSS Grid aberto.");
endfunction

