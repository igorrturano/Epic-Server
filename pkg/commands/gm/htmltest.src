// ── Demo 12: Hotbar — barra de habilidades ──────────────────────────────────

function OpenHotbarDemo(quem)
    var nome  := quem.name;
    var hp    := CInt(quem.hits);
    var hpmax := CInt(quem.hits_maximum);
    var mp    := CInt(quem.mana);
    var mpmax := CInt(quem.mana_maximum);
    var sp    := CInt(quem.stamina);
    var spmax := CInt(quem.stamina_maximum);

    var track := 320;
    var hp_f := track; if (hpmax > 0) hp_f := CInt(hp * track / hpmax); endif
    var mp_f := track; if (mpmax > 0) mp_f := CInt(mp * track / mpmax); endif
    var sp_f := track; if (spmax > 0) sp_f := CInt(sp * track / spmax); endif
    if (hp_f < 0) hp_f := 0; endif
    if (mp_f < 0) mp_f := 0; endif
    if (sp_f < 0) sp_f := 0; endif
    if (hp_f > track) hp_f := track; endif
    if (mp_f > track) mp_f := track; endif
    if (sp_f > track) sp_f := track; endif

    var hp_col := "#22c55e";
    if (hp_f < CInt(track / 2)) hp_col := "#f59e0b"; endif
    if (hp_f < CInt(track / 4)) hp_col := "#ef4444"; endif

    var html := "<html><head><style>" +
        "body { background-color: #0d1117; color: #c9d1d9; width: 540px; height: 280px; padding: 10px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".header { display: flex; flex-direction: row; align-items: center; gap: 10px;" +
        "  background-color: #161b22; padding: 6px 10px; border-radius: 5px;" +
        "  border-bottom: 2px solid #21262d; }" +
        ".avatar { width: 36px; height: 36px; background-color: #1e40af; border-radius: 4px;" +
        "  border: 2px solid #3b82f6; }" +
        ".pname { font-size: 14px; color: #60a5fa; }" +
        ".ptitle { font-size: 9px; color: #6b7280; }" +
        ".bars-col { display: flex; flex-direction: column; gap: 3px; flex: 1; }" +
        ".bar-row { display: flex; flex-direction: row; align-items: center; gap: 6px; }" +
        ".bar-key { font-size: 9px; color: #6b7280; width: 18px; }" +
        ".bar-val { font-size: 9px; color: #9ca3af; width: 50px; }" +
        ".track { background-color: #21262d; border-radius: 4px; height: 8px; width: " + CStr(track) + "px; }" +
        ".fill  { height: 8px; border-radius: 4px; }" +
        ".slots { display: flex; flex-direction: row; gap: 5px; }" +
        ".slot { width: 54px; height: 54px; background-color: #161b22; border-radius: 6px;" +
        "  border: 1px solid #30363d; display: flex; flex-direction: column; align-items: center; gap: 2px; padding-top: 6px; }" +
        ".slot-active { border: 2px solid #f59e0b; background-color: #1c1a08; }" +
        ".slot-icon { width: 28px; height: 28px; border-radius: 4px; }" +
        ".slot-num { font-size: 8px; color: #6b7280; }" +
        ".lbl-row { display: flex; flex-direction: row; gap: 5px; }" +
        ".slot-lbl { width: 54px; font-size: 8px; color: #6b7280; text-align: center; }" +
        "</style></head><body>" +
        "<div class='header'>" +
        "  <div class='avatar'></div>" +
        "  <div style='display:flex;flex-direction:column;gap:2px'>" +
        "    <div class='pname'>" + nome + "</div>" +
        "    <div class='ptitle'>Guerreiro — Nivel 42</div>" +
        "  </div>" +
        "  <div class='bars-col'>" +
        "    <div class='bar-row'><div class='bar-key'>HP</div>" +
        "      <div class='track'><div class='fill' style='width:" + CStr(hp_f) + "px;background-color:" + hp_col + "'></div></div>" +
        "      <div class='bar-val'>" + CStr(hp) + "/" + CStr(hpmax) + "</div>" +
        "    </div>" +
        "    <div class='bar-row'><div class='bar-key'>MP</div>" +
        "      <div class='track'><div class='fill' style='width:" + CStr(mp_f) + "px;background-color:#3b82f6'></div></div>" +
        "      <div class='bar-val'>" + CStr(mp) + "/" + CStr(mpmax) + "</div>" +
        "    </div>" +
        "    <div class='bar-row'><div class='bar-key'>ST</div>" +
        "      <div class='track'><div class='fill' style='width:" + CStr(sp_f) + "px;background-color:#f97316'></div></div>" +
        "      <div class='bar-val'>" + CStr(sp) + "/" + CStr(spmax) + "</div>" +
        "    </div>" +
        "  </div>" +
        "</div>" +
        "<div class='slots'>" +
        "  <div class='slot slot-active'>" +
        "    <div class='slot-icon' style='background-color:#dc2626'></div>" +
        "    <div class='slot-num'>1</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#2563eb'></div>" +
        "    <div class='slot-num'>2</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#16a34a'></div>" +
        "    <div class='slot-num'>3</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#ca8a04'></div>" +
        "    <div class='slot-num'>4</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#7c3aed'></div>" +
        "    <div class='slot-num'>5</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#0891b2'></div>" +
        "    <div class='slot-num'>6</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#be185d'></div>" +
        "    <div class='slot-num'>7</div>" +
        "  </div>" +
        "  <div class='slot'>" +
        "    <div class='slot-icon' style='background-color:#374151'></div>" +
        "    <div class='slot-num'>8</div>" +
        "  </div>" +
        "</div>" +
        "<div class='lbl-row'>" +
        "  <div class='slot-lbl'>Golpe</div>" +
        "  <div class='slot-lbl'>Magia</div>" +
        "  <div class='slot-lbl'>Cura</div>" +
        "  <div class='slot-lbl'>Escudo</div>" +
        "  <div class='slot-lbl'>Rajada</div>" +
        "  <div class='slot-lbl'>Gelo</div>" +
        "  <div class='slot-lbl'>Veneno</div>" +
        "  <div class='slot-lbl'>[vazio]</div>" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_HOTBAR, html, 540, 280, 60, 500);
    SendSysMessage(quem, "[HtmlGump] Demo hotbar aberto.");
endfunction

// ── Demo 9: Backdrop Filter ─────────────────────────────────────────────────

function OpenBackdropDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0a0a1a; color: #ecf0f1; width: 500px; height: 380px; padding: 12px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".titulo { background-color: #161b22; padding: 7px 12px; text-align: center;" +
        "  font-size: 13px; border-radius: 5px; border: 1px solid #30363d; }" +
        ".lbl { font-size: 9px; padding: 2px 6px; background-color: #1a1a2e; border-radius: 3px; color: #8b949e; }" +
        ".stripes { display: flex; flex-direction: row; height: 56px; border-radius: 6px; gap: 2px; }" +
        ".stripe { flex: 1; border-radius: 4px; }" +
        ".panels { display: flex; flex-direction: row; gap: 8px; }" +
        ".glass { flex: 1; height: 160px; border-radius: 10px;" +
        "  background-color: rgba(255,255,255,0.07);" +
        "  border: 1px solid rgba(255,255,255,0.18);" +
        "  display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 6px; }" +
        ".val { font-size: 18px; color: #ffffff; }" +
        ".sub { font-size: 9px; color: rgba(255,255,255,0.5); }" +
        ".dot { width: 28px; height: 28px; border-radius: 14px;" +
        "  background-color: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); }" +
        "</style></head><body>" +
        "<div class='titulo'>backdrop-filter: blur() — vidro fosco</div>" +
        "<div class='lbl'>cena colorida por tras dos paineis (o blur incide sobre o que esta atras)</div>" +
        "<div class='stripes'>" +
        "  <div class='stripe' style='background-color:#c0392b'></div>" +
        "  <div class='stripe' style='background-color:#d35400'></div>" +
        "  <div class='stripe' style='background-color:#f39c12'></div>" +
        "  <div class='stripe' style='background-color:#27ae60'></div>" +
        "  <div class='stripe' style='background-color:#2980b9'></div>" +
        "  <div class='stripe' style='background-color:#8e44ad'></div>" +
        "  <div class='stripe' style='background-color:#16a085'></div>" +
        "</div>" +
        "<div class='lbl'>paineis de vidro com diferentes intensidades de blur</div>" +
        "<div class='panels'>" +
        "  <div class='glass' style='backdrop-filter:blur(0px)'>" +
        "    <div class='val'>0px</div>" +
        "    <div class='dot'></div>" +
        "    <div class='sub'>sem blur</div>" +
        "  </div>" +
        "  <div class='glass' style='backdrop-filter:blur(4px)'>" +
        "    <div class='val'>4px</div>" +
        "    <div class='dot'></div>" +
        "    <div class='sub'>suave</div>" +
        "  </div>" +
        "  <div class='glass' style='backdrop-filter:blur(12px)'>" +
        "    <div class='val'>12px</div>" +
        "    <div class='dot'></div>" +
        "    <div class='sub'>medio</div>" +
        "  </div>" +
        "  <div class='glass' style='backdrop-filter:blur(24px)'>" +
        "    <div class='val'>24px</div>" +
        "    <div class='dot'></div>" +
        "    <div class='sub'>forte</div>" +
        "  </div>" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_BACKDROP, html, 500, 380, 80, 60);
    SendSysMessage(quem, "[HtmlGump] Demo backdrop-filter aberto.");
endfunction

// ── Demo: Tipografia — font-weight, font-style, line-height, text-shadow, text-decoration ─────

function OpenTypoDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0f1117; color: #e2e8f0; width: 480px; height: 560px;" +
        "  padding: 18px; display: flex; flex-direction: column; gap: 12px; }" +
        ".secao { background-color: #1a1d27; border-radius: 8px; padding: 12px 14px;" +
        "  border: 1px solid #2d3148; display: flex; flex-direction: column; gap: 6px; }" +
        ".tit { font-size: 9px; color: #6366f1; }" +
        "</style></head><body>" +

        "<div style='font-size:18px; color:#818cf8; text-shadow: 2px 2px 4px #000'>Demo Tipografia CSS</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>font-weight: normal / bold</div>" +
        "  <div style='font-size:14px;'>Este texto e normal</div>" +
        "  <div style='font-size:14px; font-weight:bold;'>Este texto e bold</div>" +
        "  <div style='font-size:16px; font-weight:bold; color:#f59e0b;'>Bold + cor dourada</div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>font-style: italic</div>" +
        "  <div style='font-size:14px; font-style:italic;'>Este texto e italic</div>" +
        "  <div style='font-size:14px; font-weight:bold; font-style:italic; color:#34d399;'>Bold + italic + verde</div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>line-height</div>" +
        "  <div style='font-size:12px; line-height:24px;'>Linha com line-height 24px — bastante espaco entre as linhas quando o texto quebra ou empilha</div>" +
        "  <div style='font-size:12px; line-height:10px; color:#94a3b8;'>Linha com line-height 10px — bem compacto</div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>text-decoration</div>" +
        "  <div style='font-size:14px; text-decoration:underline;'>Texto sublinhado</div>" +
        "  <div style='font-size:14px; text-decoration:line-through; color:#f87171;'>Texto riscado</div>" +
        "  <div style='font-size:14px; text-decoration:overline; color:#60a5fa;'>Texto com linha acima</div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>text-shadow</div>" +
        "  <div style='font-size:18px; text-shadow: 2px 2px 0px #000;'>Sombra solida preta</div>" +
        "  <div style='font-size:18px; color:#fbbf24; text-shadow: 0px 0px 6px #f59e0b;'>Glow dourado</div>" +
        "  <div style='font-size:18px; color:#fff; text-shadow: 3px 3px 2px #7c3aed;'>Sombra roxa</div>" +
        "</div>" +

        "</body></html>";

    SendHtmlGump(quem, DEMO_TYPO, html, 480, 560, 50, 30);
    SendSysMessage(quem, "[HtmlGump] Demo tipografia CSS aberto.");
endfunction

// ── Demo: Gradientes — linear-gradient com angulos e stops multiplos ────────────────────────

function OpenGradientDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0a0a0f; color: #e2e8f0; width: 460px; height: 540px;" +
        "  padding: 16px; display: flex; flex-direction: column; gap: 10px; }" +
        ".titulo { font-size:16px; color:#a78bfa; text-shadow: 0px 2px 4px #000; }" +
        ".tit { font-size:9px; color:#6b7280; }" +
        ".grad { border-radius: 6px; height: 44px; padding: 0px 12px;" +
        "  display: flex; flex-direction: column; gap: 0px; }" +
        ".label { font-size:11px; color:#fff; text-shadow: 1px 1px 2px #000; }" +
        "</style></head><body>" +

        "<div class='titulo'>linear-gradient</div>" +

        "<div class='tit'>to right (esquerda → direita)</div>" +
        "<div class='grad' style='background-image: linear-gradient(to right, #1e3a8a, #3b82f6, #93c5fd);'>" +
        "  <div class='label'>Azul — to right</div>" +
        "</div>" +

        "<div class='tit'>to bottom (cima → baixo, padrao)</div>" +
        "<div class='grad' style='background-image: linear-gradient(to bottom, #14532d, #22c55e);'>" +
        "  <div class='label'>Verde — to bottom</div>" +
        "</div>" +

        "<div class='tit'>to bottom right (diagonal)</div>" +
        "<div class='grad' style='background-image: linear-gradient(to bottom right, #7c3aed, #ec4899);'>" +
        "  <div class='label'>Roxo → Rosa</div>" +
        "</div>" +

        "<div class='tit'>45deg (angulo customizado)</div>" +
        "<div class='grad' style='background-image: linear-gradient(45deg, #f59e0b, #ef4444, #a855f7);'>" +
        "  <div class='label'>Ouro → Vermelho → Roxo</div>" +
        "</div>" +

        "<div class='tit'>stops com posicoes explicitas</div>" +
        "<div class='grad' style='background-image: linear-gradient(to right, #ef4444 0%, #ef4444 30%, #22c55e 70%, #22c55e 100%);'>" +
        "  <div class='label'>Vermelho | Verde (sem transicao)</div>" +
        "</div>" +

        "<div class='tit'>gradiente escuro para transparente</div>" +
        "<div class='grad' style='background-image: linear-gradient(to right, #0f172a, #1e293b, #334155); border: 1px solid #475569;'>" +
        "  <div class='label'>Slate — dark theme</div>" +
        "</div>" +

        "<div class='tit'>arco-iris</div>" +
        "<div class='grad' style='height:50px; border-radius:6px; background-image: linear-gradient(to right, #ef4444, #f97316, #eab308, #22c55e, #3b82f6, #a855f7);'>" +
        "  <div class='label'>Arco-iris</div>" +
        "</div>" +

        "<div class='tit'>gradiente como fundo de card com texto</div>" +
        "<div style='background-image: linear-gradient(135deg, #1e1b4b, #312e81); border-radius:8px; padding:12px; border: 1px solid #4338ca;'>" +
        "  <div style='font-size:15px; font-weight:bold; color:#c7d2fe;'>Card com gradiente</div>" +
        "  <div style='font-size:11px; color:#a5b4fc;'>background-image: linear-gradient(135deg, ...)</div>" +
        "</div>" +

        "</body></html>";

    SendHtmlGump(quem, DEMO_GRADIENT, html, 460, 540, 100, 30);
    SendSysMessage(quem, "[HtmlGump] Demo gradientes aberto.");
endfunction

// ── Demo: Layout avancado — overflow, min/max, position:absolute, z-index, visibility ────────

function OpenLayout2Demo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0f1117; color: #e2e8f0; width: 500px; height: 600px;" +
        "  padding: 16px; display: flex; flex-direction: column; gap: 12px; }" +
        ".secao { background-color: #1a1d27; border-radius: 8px; padding: 10px 12px;" +
        "  border: 1px solid #2d3148; }" +
        ".tit { font-size:9px; color:#6366f1; }" +
        ".lbl { font-size:11px; color:#94a3b8; }" +
        "</style></head><body>" +

        "<div style='font-size:16px; color:#818cf8;'>Layout Avancado CSS</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>overflow: hidden</div>" +
        "  <div style='width:300px; height:40px; overflow:hidden; background-color:#1e293b; border-radius:4px; border:1px solid #334155;'>" +
        "    <div style='font-size:14px; color:#94a3b8;'>Este texto e muito longo e deveria ser cortado pela borda do container pai que tem overflow hidden</div>" +
        "  </div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>min-width / max-width</div>" +
        "  <div style='display:flex; flex-direction:row; gap:6px;'>" +
        "    <div style='min-width:80px; background-color:#1e3a8a; border-radius:4px; padding:4px 8px; font-size:11px;'>min 80px</div>" +
        "    <div style='max-width:60px; background-color:#166534; border-radius:4px; padding:4px 8px; font-size:11px;'>max 60px — cortado</div>" +
        "    <div style='min-width:100px; max-width:120px; background-color:#7c2d12; border-radius:4px; padding:4px 8px; font-size:11px;'>min 100 max 120</div>" +
        "  </div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>min-height / max-height</div>" +
        "  <div style='display:flex; flex-direction:row; gap:6px; align-items:flex-start;'>" +
        "    <div style='min-height:60px; width:100px; background-color:#1e3a8a; border-radius:4px; padding:4px 8px; font-size:11px;'>min-height 60px</div>" +
        "    <div style='max-height:30px; overflow:hidden; width:120px; background-color:#4a1d96; border-radius:4px; padding:4px 8px; font-size:11px;'>max-height 30px — texto cortado aqui</div>" +
        "  </div>" +
        "</div>" +

        "<div class='secao' style='height:90px; position:relative;'>" +
        "  <div class='tit'>position: absolute + top/left</div>" +
        "  <div style='position:absolute; top:24px; left:10px; background-color:#4338ca; border-radius:4px; padding:3px 10px; font-size:11px;'>top:24 left:10</div>" +
        "  <div style='position:absolute; top:24px; left:140px; background-color:#0f766e; border-radius:4px; padding:3px 10px; font-size:11px;'>top:24 left:140</div>" +
        "  <div style='position:absolute; top:52px; left:10px; background-color:#9d174d; border-radius:4px; padding:3px 10px; font-size:11px;'>top:52 left:10</div>" +
        "</div>" +

        "<div class='secao' style='height:70px; position:relative;'>" +
        "  <div class='tit'>z-index — sobreposicao</div>" +
        "  <div style='position:absolute; top:22px; left:10px; width:120px; height:36px; background-color:#1e40af; border-radius:4px; z-index:1; font-size:11px; padding:4px;'>z-index: 1</div>" +
        "  <div style='position:absolute; top:30px; left:60px; width:120px; height:36px; background-color:#7c3aed; border-radius:4px; z-index:2; font-size:11px; padding:4px;'>z-index: 2 (sobre)</div>" +
        "  <div style='position:absolute; top:38px; left:30px; width:120px; height:36px; background-color:#0f766e; border-radius:4px; z-index:3; font-size:11px; padding:4px;'>z-index: 3 (topo)</div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>visibility: hidden vs display: none</div>" +
        "  <div style='display:flex; flex-direction:row; gap:8px; align-items:center;'>" +
        "    <div style='background-color:#1e3a8a; border-radius:4px; padding:4px 8px; font-size:11px;'>Visivel</div>" +
        "    <div style='visibility:hidden; background-color:#7c2d12; border-radius:4px; padding:4px 8px; font-size:11px; width:80px;'>Oculto</div>" +
        "    <div style='background-color:#166534; border-radius:4px; padding:4px 8px; font-size:11px;'>Visivel (espaco mantido)</div>" +
        "  </div>" +
        "</div>" +

        "<div class='secao'>" +
        "  <div class='tit'>border-radius por canto</div>" +
        "  <div style='display:flex; flex-direction:row; gap:8px;'>" +
        "    <div style='width:70px; height:40px; background-color:#1e40af; border-top-left-radius:18px; font-size:10px; padding:4px;'>TL 18px</div>" +
        "    <div style='width:70px; height:40px; background-color:#0f766e; border-top-right-radius:18px; font-size:10px; padding:4px;'>TR 18px</div>" +
        "    <div style='width:70px; height:40px; background-color:#7c3aed; border-bottom-left-radius:18px; font-size:10px; padding:4px;'>BL 18px</div>" +
        "    <div style='width:70px; height:40px; background-color:#9d174d; border-bottom-right-radius:18px; font-size:10px; padding:4px;'>BR 18px</div>" +
        "    <div style='width:70px; height:40px; background-color:#92400e; border-top-left-radius:18px; border-bottom-right-radius:18px; font-size:10px; padding:4px;'>TL+BR</div>" +
        "  </div>" +
        "</div>" +

        "</body></html>";

    SendHtmlGump(quem, DEMO_LAYOUT2, html, 500, 600, 120, 20);
    SendSysMessage(quem, "[HtmlGump] Demo layout avancado aberto.");
endfunction
