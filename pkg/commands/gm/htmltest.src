// ============================================================================
//  Comando GM: htmltest
//  Abre demos do HTML Gump no cliente via pacote 0xF8.
//
//  Uso:
//    htmltest                — abre demo básico de cores e layout
//    htmltest layout         — demo de flexbox
//    htmltest player         — demo com dados do personagem
//    htmltest vars           — demo de CSS Variables
//    htmltest anim           — demo de @keyframes animations
//    htmltest wrap           — demo de flex-wrap
//    htmltest grid           — demo de CSS Grid
//    htmltest shadow         — demo de box-shadow
//    htmltest backdrop       — demo de backdrop-filter blur
//    htmltest text           — demo de tamanhos de fonte
//    htmltest typo           — font-weight, italic, line-height, text-shadow, text-decoration
//    htmltest gradient       — linear-gradient com ângulos e stops
//    htmltest layout2        — overflow:hidden, min/max, position:absolute, z-index, visibility
//    htmltest close          — fecha todas as janelas de demo
//
// ============================================================================

use uo;
include ":htmlgump:htmlgump";

// IDs únicos para cada demo
const DEMO_BASICS   := 0xF8D001;
const DEMO_LAYOUT   := 0xF8D002;
const DEMO_PLAYER   := 0xF8D003;
const DEMO_VARS     := 0xF8D004;
const DEMO_ANIM     := 0xF8D005;
const DEMO_WRAP     := 0xF8D006;
const DEMO_GRID     := 0xF8D007;
const DEMO_SHADOW   := 0xF8D008;
const DEMO_BACKDROP := 0xF8D009;
const DEMO_TEXT     := 0x411248;   // hex 0x41 1248 conforme solicitado
const DEMO_QUEST    := 0xF8D00A;
const DEMO_HOTBAR   := 0xF8D00B;
const DEMO_TYPO     := 0xF8D00C;
const DEMO_GRADIENT := 0xF8D00D;
const DEMO_LAYOUT2  := 0xF8D00E;

program htmltest(quem, param)
    var sub := Lower(Trim(CStr(param)));

    if (sub == "layout")
        OpenLayoutDemo(quem);
    elseif (sub == "player")
        OpenPlayerDemo(quem);
    elseif (sub == "vars")
        OpenVarsDemo(quem);
    elseif (sub == "anim")
        OpenAnimDemo(quem);
    elseif (sub == "wrap")
        OpenWrapDemo(quem);
    elseif (sub == "grid")
        OpenGridDemo(quem);
    elseif (sub == "shadow")
        OpenShadowDemo(quem);
    elseif (sub == "backdrop")
        OpenBackdropDemo(quem);
    elseif (sub == "text")
        OpenTextDemo(quem);
    elseif (sub == "quest")
        OpenQuestDemo(quem);
    elseif (sub == "hotbar")
        OpenHotbarDemo(quem);
    elseif (sub == "typo")
        OpenTypoDemo(quem);
    elseif (sub == "gradient")
        OpenGradientDemo(quem);
    elseif (sub == "layout2")
        OpenLayout2Demo(quem);
    elseif (sub == "close")
        CloseHtmlGump(quem, DEMO_BASICS);
        CloseHtmlGump(quem, DEMO_LAYOUT);
        CloseHtmlGump(quem, DEMO_PLAYER);
        CloseHtmlGump(quem, DEMO_VARS);
        CloseHtmlGump(quem, DEMO_ANIM);
        CloseHtmlGump(quem, DEMO_WRAP);
        CloseHtmlGump(quem, DEMO_GRID);
        CloseHtmlGump(quem, DEMO_SHADOW);
        CloseHtmlGump(quem, DEMO_BACKDROP);
        CloseHtmlGump(quem, DEMO_TEXT);
        CloseHtmlGump(quem, DEMO_QUEST);
        CloseHtmlGump(quem, DEMO_HOTBAR);
        CloseHtmlGump(quem, DEMO_TYPO);
        CloseHtmlGump(quem, DEMO_GRADIENT);
        CloseHtmlGump(quem, DEMO_LAYOUT2);
        SendSysMessage(quem, "[HtmlGump] Todos os demos fechados.");
    else
        OpenBasicsDemo(quem);
    endif

    return 1;
endprogram

// ── Demo 1: Cores, Bordas, Flexbox básico ───────────────────────────────────

function OpenBasicsDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #12131a; width: 480px; height: 380px; padding: 14px;" +
        "  display: flex; flex-direction: column; gap: 10px; }" +
        ".titulo { background-color: #1e2030; padding: 8px 14px; border-radius: 5px;" +
        "  border: 2px solid #3d4066; text-align: center; font-size: 14px; }" +
        ".label { font-size: 11px; padding: 2px 6px; background-color: #1a1b26;" +
        "  border-radius: 3px; border: 1px solid #2a2c3e; }" +
        ".row { display: flex; flex-direction: row; gap: 8px; align-items: center; }" +
        ".box { width: 56px; height: 56px; border-radius: 3px; }" +
        ".rad { width: 56px; height: 56px; background-color: #e67e22; }" +
        ".r0  { border-radius: 0px; } .r8  { border-radius: 8px; }" +
        ".r16 { border-radius: 16px; } .r28 { border-radius: 28px; }" +
        ".brd { background-color: #1a2535; width: 56px; height: 56px; }" +
        ".op1 { background-color: rgba(52,152,219,1.0); width: 56px; height: 56px; border-radius: 3px; }" +
        ".op5 { background-color: rgba(52,152,219,0.5); width: 56px; height: 56px; border-radius: 3px; }" +
        ".op2 { background-color: rgba(52,152,219,0.2); width: 56px; height: 56px; border-radius: 3px; }" +
        "</style></head><body>" +
        "<div class='titulo'>EpicUO HTML Gump — Demo Servidor (0xF8)</div>" +
        "<div class='label'>Cores solidas</div>" +
        "<div class='row'>" +
        "  <div class='box' style='background-color:#e74c3c'></div>" +
        "  <div class='box' style='background-color:#2ecc71'></div>" +
        "  <div class='box' style='background-color:#3498db'></div>" +
        "  <div class='box' style='background-color:#f1c40f'></div>" +
        "  <div class='box' style='background-color:#9b59b6'></div>" +
        "</div>" +
        "<div class='label'>Border-radius: 0 / 8 / 16 / 28px</div>" +
        "<div class='row'>" +
        "  <div class='rad r0'></div><div class='rad r8'></div>" +
        "  <div class='rad r16'></div><div class='rad r28'></div>" +
        "</div>" +
        "<div class='label'>Border + cor</div>" +
        "<div class='row'>" +
        "  <div class='brd' style='border:2px solid #e74c3c'></div>" +
        "  <div class='brd' style='border:2px solid #2ecc71; border-radius:8px'></div>" +
        "  <div class='brd' style='border:3px solid #3498db; border-radius:28px'></div>" +
        "</div>" +
        "<div class='label'>rgba() — 100% / 50% / 20%</div>" +
        "<div class='row'><div class='op1'></div><div class='op5'></div><div class='op2'></div></div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_BASICS, html, 480, 380, 80, 80);
    SendSysMessage(quem, "[HtmlGump] Demo basico aberto via pacote 0xF8.");
endfunction

// ── Demo 2: Flexbox layout ──────────────────────────────────────────────────

function OpenLayoutDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0d1117; width: 500px; height: 460px; padding: 12px;" +
        "  display: flex; flex-direction: column; gap: 7px; }" +
        ".titulo { background-color: #161b22; padding: 7px 12px; text-align: center;" +
        "  font-size: 14px; border-radius: 5px; border: 1px solid #30363d; }" +
        ".lbl { font-size: 10px; padding: 2px 6px; background-color: #21262d; border-radius: 3px; }" +
        ".track { background-color: #161b22; height: 42px; padding: 6px; border-radius: 4px;" +
        "  border: 1px solid #30363d; display: flex; align-items: center; }" +
        ".i1 { background-color: #58a6ff; width: 28px; height: 28px; border-radius: 3px; }" +
        ".i2 { background-color: #56d364; width: 28px; height: 28px; border-radius: 3px; }" +
        ".i3 { background-color: #ff7b72; width: 28px; height: 28px; border-radius: 3px; }" +
        ".g1 { background-color: #ff7b72; height: 28px; border-radius: 3px; flex-grow: 1; }" +
        ".g2 { background-color: #58a6ff; height: 28px; border-radius: 3px; flex-grow: 2; }" +
        ".g3 { background-color: #56d364; height: 28px; border-radius: 3px; flex-grow: 1; }" +
        ".gt { background-color: #161b22; height: 36px; padding: 4px; border-radius: 4px;" +
        "  border: 1px solid #30363d; display: flex; align-items: center; gap: 4px; }" +
        "</style></head><body>" +
        "<div class='titulo'>EpicUO HTML Gump — Flexbox (0xF8)</div>" +
        "<div class='lbl'>justify-content: flex-start</div>" +
        "<div class='track' style='justify-content:flex-start'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>justify-content: center</div>" +
        "<div class='track' style='justify-content:center'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>justify-content: flex-end</div>" +
        "<div class='track' style='justify-content:flex-end'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>justify-content: space-between</div>" +
        "<div class='track' style='justify-content:space-between'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>justify-content: space-around</div>" +
        "<div class='track' style='justify-content:space-around'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>justify-content: space-evenly</div>" +
        "<div class='track' style='justify-content:space-evenly'>" +
        "  <div class='i1'></div><div class='i2'></div><div class='i3'></div></div>" +
        "<div class='lbl'>flex-grow: 1 / 2 / 1</div>" +
        "<div class='gt'><div class='g1'></div><div class='g2'></div><div class='g3'></div></div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_LAYOUT, html, 500, 460, 120, 60);
    SendSysMessage(quem, "[HtmlGump] Demo flexbox aberto.");
endfunction

// ── Demo 3: Dados do personagem (data binding manual) ──────────────────────

function OpenPlayerDemo(quem)
    var nome   := quem.name;
    var hp     := CInt(quem.hits);
    var hp_max := CInt(quem.hits_maximum);
    var mp     := CInt(quem.mana);
    var mp_max := CInt(quem.mana_maximum);
    var sp     := CInt(quem.stamina);
    var sp_max := CInt(quem.stamina_maximum);
    var str    := CStr(quem.strength);
    var dex    := CStr(quem.dexterity);
    var intel  := CStr(quem.intelligence);
    var px     := CStr(quem.x);
    var py     := CStr(quem.y);
    var mapa   := CStr(quem.realm.name);

    // Barras de HP/MP/SP em pixels (pista = 240px)
    var track := 240;

    var hp_fill := track;
    if (hp_max > 0) hp_fill := CInt(hp * track / hp_max); endif
    if (hp_fill < 0) hp_fill := 0; endif
    if (hp_fill > track) hp_fill := track; endif

    var mp_fill := track;
    if (mp_max > 0) mp_fill := CInt(mp * track / mp_max); endif
    if (mp_fill < 0) mp_fill := 0; endif
    if (mp_fill > track) mp_fill := track; endif

    var sp_fill := track;
    if (sp_max > 0) sp_fill := CInt(sp * track / sp_max); endif
    if (sp_fill < 0) sp_fill := 0; endif
    if (sp_fill > track) sp_fill := track; endif

    var hp_col := "#2ecc71";
    if (hp_fill < CInt(track / 2))
        hp_col := "#f39c12";
    endif
    if (hp_fill < CInt(track / 4))
        hp_col := "#e74c3c";
    endif

    var html := "<html><head><style>" +
        "body { background-color: #0a0e1a; color: #c9d1d9; width: 460px; height: 360px; padding: 14px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".titulo { background-color: #161b22; padding: 8px 14px; text-align: center;" +
        "  font-size: 14px; border-radius: 5px; border: 2px solid #3d8bcd; color: #58a6ff; }" +
        ".secao { background-color: #161b22; border-radius: 5px; padding: 8px 12px;" +
        "  border: 1px solid #21262d; display: flex; flex-direction: column; gap: 6px; }" +
        ".row { display: flex; flex-direction: row; align-items: center; gap: 8px; }" +
        ".chave { font-size: 10px; color: #8b949e; width: 72px; }" +
        ".valor { font-size: 12px; color: #c9d1d9; }" +
        ".track { background-color: #21262d; border-radius: 5px; height: 10px; width: " + CStr(track) + "px; }" +
        ".fill  { height: 10px; border-radius: 5px; }" +
        ".stat  { background-color: #0d1117; border-radius: 4px; padding: 4px 10px;" +
        "  font-size: 12px; color: #c9d1d9; border: 1px solid #21262d; }" +
        "</style></head><body>" +
        "<div class='titulo'>Personagem: " + nome + "</div>" +
        "<div class='secao'>" +
        "  <div class='row'><div class='chave'>Vida</div>" +
        "    <div class='track'><div class='fill' style='width:" + CStr(hp_fill) + "px;background-color:" + hp_col + "'></div></div>" +
        "    <div class='valor'>" + CStr(hp) + "/" + CStr(hp_max) + "</div>" +
        "  </div>" +
        "  <div class='row'><div class='chave'>Mana</div>" +
        "    <div class='track'><div class='fill' style='width:" + CStr(mp_fill) + "px;background-color:#3498db'></div></div>" +
        "    <div class='valor'>" + CStr(mp) + "/" + CStr(mp_max) + "</div>" +
        "  </div>" +
        "  <div class='row'><div class='chave'>Stamina</div>" +
        "    <div class='track'><div class='fill' style='width:" + CStr(sp_fill) + "px;background-color:#e67e22'></div></div>" +
        "    <div class='valor'>" + CStr(sp) + "/" + CStr(sp_max) + "</div>" +
        "  </div>" +
        "</div>" +
        "<div class='secao'>" +
        "  <div class='row'>" +
        "    <div class='stat'>STR: " + str + "</div>" +
        "    <div class='stat'>DEX: " + dex + "</div>" +
        "    <div class='stat'>INT: " + intel + "</div>" +
        "  </div>" +
        "</div>" +
        "<div class='secao'>" +
        "  <div class='row'><div class='chave'>Posicao</div>" +
        "    <div class='valor'>" + px + ", " + py + " — " + mapa + "</div>" +
        "  </div>" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_PLAYER, html, 460, 360, 100, 60);
    SendSysMessage(quem, "[HtmlGump] Demo personagem aberto.");
endfunction

// ── Demo 4: CSS Variables ───────────────────────────────────────────────────

function OpenVarsDemo(quem)
    var html := "<html><head><style>" +
        ":root { --primary: #e74c3c; --secondary: #3498db; --accent: #2ecc71;" +
        "  --text: #ecf0f1; --bg: #0d1117; --card: #161b22; --border: #30363d; }" +
        "body { background-color: var(--bg); color: var(--text); width: 440px; height: 380px; padding: 14px;" +
        "  display: flex; flex-direction: column; gap: 10px; }" +
        ".titulo { background-color: var(--card); padding: 8px 14px; text-align: center;" +
        "  font-size: 14px; border-radius: 5px; border: 2px solid var(--primary); color: var(--primary); }" +
        ".lbl { font-size: 9px; padding: 2px 6px; background-color: #21262d; border-radius: 3px; color: #8b949e; }" +
        ".row { display: flex; flex-direction: row; gap: 8px; }" +
        ".card { flex: 1; background-color: var(--card); border-radius: 6px; padding: 10px 8px;" +
        "  display: flex; flex-direction: column; gap: 6px; }" +
        ".dot { width: 36px; height: 36px; border-radius: 18px; }" +
        ".bar { height: 8px; border-radius: 4px; }" +
        ".name { font-size: 10px; text-align: center; }" +
        ".fallback { border-radius: 5px; padding: 10px 12px;" +
        "  display: flex; align-items: center; font-size: 12px; color: #fff; }" +
        "</style></head><body>" +
        "<div class='titulo'>CSS Variables — var(--nome)</div>" +
        "<div class='lbl'>--primary, --secondary, --accent definidas em :root e reutilizadas abaixo</div>" +
        "<div class='row'>" +
        "  <div class='card' style='border:2px solid var(--primary)'>" +
        "    <div class='name' style='color:var(--primary)'>--primary</div>" +
        "    <div class='dot' style='background-color:var(--primary)'></div>" +
        "    <div class='bar' style='background-color:var(--primary)'></div>" +
        "  </div>" +
        "  <div class='card' style='border:2px solid var(--secondary)'>" +
        "    <div class='name' style='color:var(--secondary)'>--secondary</div>" +
        "    <div class='dot' style='background-color:var(--secondary)'></div>" +
        "    <div class='bar' style='background-color:var(--secondary)'></div>" +
        "  </div>" +
        "  <div class='card' style='border:2px solid var(--accent)'>" +
        "    <div class='name' style='color:var(--accent)'>--accent</div>" +
        "    <div class='dot' style='background-color:var(--accent)'></div>" +
        "    <div class='bar' style='background-color:var(--accent)'></div>" +
        "  </div>" +
        "</div>" +
        "<div class='lbl'>fallback: var(--undefined, #9b59b6) — variavel inexistente usa valor padrao</div>" +
        "<div class='fallback' style='background-color:var(--undefined,#9b59b6)'>" +
        "  var(--undefined, #9b59b6) — fallback ativo" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_VARS, html, 440, 380, 100, 60);
    SendSysMessage(quem, "[HtmlGump] Demo CSS Variables aberto.");
endfunction

// ── Demo 5: @keyframes Animations ──────────────────────────────────────────

function OpenAnimDemo(quem)
    var html := "<html><head><style>" +
        "@keyframes pulse { 0% { background-color: #e74c3c; } 50% { background-color: #c0392b; } 100% { background-color: #e74c3c; } }" +
        "@keyframes spin-color { 0% { background-color: #3498db; } 33% { background-color: #2ecc71; } 66% { background-color: #9b59b6; } 100% { background-color: #3498db; } }" +
        "@keyframes fade { 0% { opacity: 1; } 50% { opacity: 0.2; } 100% { opacity: 1; } }" +
        "@keyframes glow-border { 0% { border-color: #e74c3c; } 50% { border-color: #f1c40f; } 100% { border-color: #e74c3c; } }" +
        "body { background-color: #0d0d1a; width: 420px; height: 320px; padding: 14px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".titulo { background-color: #1a1a2e; padding: 8px 14px; text-align: center;" +
        "  font-size: 14px; border-radius: 5px; border: 1px solid #2a2a4e; }" +
        ".box { height: 54px; border-radius: 6px; display: flex; align-items: center;" +
        "  padding: 0 12px; font-size: 12px; border: 2px solid transparent; }" +
        ".lbl { font-size: 9px; padding: 2px 6px; background-color: #21262d; border-radius: 3px; }" +
        "</style></head><body>" +
        "<div class='titulo'>@keyframes Animations</div>" +
        "<div class='lbl'>animation: pulse 2s ease infinite</div>" +
        "<div class='box' style='animation: pulse 2s ease infinite'>pulse — background-color</div>" +
        "<div class='lbl'>animation: spin-color 3s linear infinite</div>" +
        "<div class='box' style='animation: spin-color 3s linear infinite'>spin-color — 3 cores</div>" +
        "<div class='lbl'>animation: fade 2s ease infinite alternate</div>" +
        "<div class='box' style='background-color: #16213e; animation: fade 2s ease infinite alternate'>fade — opacity</div>" +
        "<div class='lbl'>animation: glow-border 2s ease infinite</div>" +
        "<div class='box' style='background-color: #16213e; animation: glow-border 2s ease infinite'>glow-border — border-color</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_ANIM, html, 420, 320, 100, 80);
    SendSysMessage(quem, "[HtmlGump] Demo @keyframes aberto.");
endfunction

// ── Demo 6: flex-wrap ───────────────────────────────────────────────────────

function OpenWrapDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0d1117; color: #c9d1d9; width: 500px; height: 300px; padding: 12px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".titulo { background-color: #161b22; padding: 7px 12px; text-align: center;" +
        "  font-size: 13px; border-radius: 5px; border: 1px solid #30363d; }" +
        ".lbl { font-size: 9px; padding: 2px 6px; background-color: #21262d; border-radius: 3px; color: #8b949e; }" +
        ".cols { display: flex; flex-direction: row; gap: 8px; }" +
        ".col  { display: flex; flex-direction: column; gap: 4px; flex: 1; }" +
        ".box  { background-color: #161b22; border-radius: 5px; padding: 5px;" +
        "  border: 1px solid #21262d; display: flex; flex-direction: row; gap: 4px; height: 96px; }" +
        ".item { width: 50px; height: 44px; border-radius: 4px; }" +
        "</style></head><body>" +
        "<div class='titulo'>flex-wrap — controle de quebra de linha</div>" +
        "<div class='cols'>" +
        "  <div class='col'>" +
        "    <div class='lbl'>nowrap — itens encolhem</div>" +
        "    <div class='box' style='flex-wrap:nowrap; align-items:center'>" +
        "      <div class='item' style='background-color:#e74c3c'></div>" +
        "      <div class='item' style='background-color:#3498db'></div>" +
        "      <div class='item' style='background-color:#2ecc71'></div>" +
        "      <div class='item' style='background-color:#f1c40f'></div>" +
        "      <div class='item' style='background-color:#9b59b6'></div>" +
        "    </div>" +
        "  </div>" +
        "  <div class='col'>" +
        "    <div class='lbl'>wrap — quebra normal</div>" +
        "    <div class='box' style='flex-wrap:wrap; align-content:flex-start'>" +
        "      <div class='item' style='background-color:#e74c3c'></div>" +
        "      <div class='item' style='background-color:#3498db'></div>" +
        "      <div class='item' style='background-color:#2ecc71'></div>" +
        "      <div class='item' style='background-color:#f1c40f'></div>" +
        "      <div class='item' style='background-color:#9b59b6'></div>" +
        "    </div>" +
        "  </div>" +
        "  <div class='col'>" +
        "    <div class='lbl'>wrap-reverse — ultima linha em cima</div>" +
        "    <div class='box' style='flex-wrap:wrap-reverse; align-content:flex-end'>" +
        "      <div class='item' style='background-color:#e74c3c'></div>" +
        "      <div class='item' style='background-color:#3498db'></div>" +
        "      <div class='item' style='background-color:#2ecc71'></div>" +
        "      <div class='item' style='background-color:#f1c40f'></div>" +
        "      <div class='item' style='background-color:#9b59b6'></div>" +
        "    </div>" +
        "  </div>" +
        "</div>" +
        "</body></html>";

    SendHtmlGump(quem, DEMO_WRAP, html, 500, 300, 80, 80);
    SendSysMessage(quem, "[HtmlGump] Demo flex-wrap aberto.");
endfunction

// ── Demo 7: CSS Grid ────────────────────────────────────────────────────────

function OpenGridDemo(quem)
    var html := "<html><head><style>" +
        "body { background-color: #0d1117; color: #c9d1d9; width: 460px; height: 380px; padding: 12px;" +
        "  display: flex; flex-direction: column; gap: 8px; }" +
        ".titulo { background-color: #161b22; padding: 7px 12px; text-align: center;" +
