// Comando temporário sub-fase 1.B — remover quando sub-fase 1.F encerrar.

use uo;
use basic;

include ":ultimalive:include/crc";

program ul_test_hash(who, text)
    var args := SplitWords(text);
    if (Len(args) < 2)
        SendSysMessage(who, "Uso: ul_test_hash <blockX> <blockY>");
        return 0;
    endif
    var blockX := CInt(args[1]);
    var blockY := CInt(args[2]);
    if (blockX < 0 || blockY < 0)
        SendSysMessage(who, "blockX e blockY devem ser >= 0.");
        return 0;
    endif
    var block_crc := UL_ComputeBlockHash(who.realm, blockX, blockY);
    SendSysMessage(who, "Bloco (" + blockX + ", " + blockY + ") " + who.realm + ": hash = " + block_crc + " (" + Hex(block_crc) + ")");
    return 1;
endprogram
