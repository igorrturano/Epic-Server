/*
 * .smokeloot
 *
 * Bateria de testes do sistema de loot pós-fix dos 7 bugs.
 * Resultado vai pro console POL (print/SysLog) e pro chat do GM
 * (SendSysMessage). Cada teste cria/limpa seu próprio container.
 *
 * Bugs cobertos:
 *   #1  LOOT_EXCLUDED_METALS bane Cobre tier 1
 *   #2  if (!item) não pega error → loot evapora
 *   #3  Item ClothesWild typo
 *   #4  Stack <nome_de_grupo> não resolve
 *   #5  summoned=1 em combat-event waves apaga loot
 *   #6  Boss gump default on_death=0 (manual — testar via .epicboss)
 *   #7  PersonalLoot_Arm sem early-exit
 */
use uo;
use os;
use util;
use cfgfile;
use basic;

include ":loot:include/lootParser";
include ":crafting:include/fabricacaoComplexos";
include ":crafting:include/util/fabricacaoConstants";
include ":containers:personalLoot";

const COR_HEADER := 90;   // azul
const COR_PASS   := 66;   // verde
const COR_FAIL   := 33;   // vermelho
const COR_INFO   := 0;    // cinza

var g_passed := 0;
var g_failed := 0;

program smoke_loot(who)
    g_passed := 0;
    g_failed := 0;

    SmokeLog(who, "==================================================", COR_HEADER);
    SmokeLog(who, "       SMOKE TEST — Sistema de Loot Epic", COR_HEADER);
    SmokeLog(who, "==================================================", COR_HEADER);

    Test_Bug2_NaoCraftaveis(who);
    Test_Bug1_CobreTier1(who);
    Test_Bug3_ClothesWild(who);
    Test_Bug4_MoedasGroup(who);
    Test_Bug5_CombatWave(who);
    Test_Bug7_PersonalLootEarlyExit(who);
    Test_Bug8_PickerFallback(who);
    Manual_Bug6_GumpDefault(who);

    SmokeLog(who, "==================================================", COR_HEADER);
    SmokeLog(who, "Total: " + g_passed + " PASS, " + g_failed + " FAIL", COR_HEADER);
    SmokeLog(who, "==================================================", COR_HEADER);
endprogram


// ============================================================
// Helpers
// ============================================================

function SmokeLog(who, msg, color := COR_INFO)
    SendSysMessage(who, msg, color);
    print("[SMOKELOOT] " + msg);
endfunction

function SmokePass(who, name, detail := "")
    g_passed := g_passed + 1;
    SmokeLog(who, "[PASS] " + name + (detail != "" ? " - " + detail : ""), COR_PASS);
endfunction

function SmokeFail(who, name, detail := "")
    g_failed := g_failed + 1;
    SmokeLog(who, "[FAIL] " + name + (detail != "" ? " - " + detail : ""), COR_FAIL);
endfunction

function CriaBagTeste(who, label)
    var bag := CreateItemInBackpack(who, 0x0E76, 1);
    if (!bag || bag.errortext)
        SmokeLog(who, "ERRO criando bag de teste: " + (bag ? bag.errortext : "null"), COR_FAIL);
        return 0;
    endif
    SetName(bag, "[SmokeTest] " + label);
    return bag;
endfunction

function ContaItensPorPropriedade(bag, nome_substring)
    var count := 0;
    foreach item in (EnumerateItemsInContainer(bag))
        var d := Lower(CStr(item.desc));
        if (Find(d, Lower(nome_substring), 1) >= 1)
            count := count + 1;
        endif
    endforeach
    return count;
endfunction


// ============================================================
// TESTE BUG #2 — fallback pega itens não-craftáveis
// ============================================================
// Antes do fix: LootIndex "human" tinha Random Reagents (Group com
// Batwing/Garlic/etc. que não têm receita de crafting). Bug #2 (if(!item)
// não pega error) → backpack vazia. Depois do fix: 1d2 reagents
// aparecem com 100% chance, mais clothes 10%, moedas etc.
function Test_Bug2_NaoCraftaveis(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #2] Loot não-craftável (fallback error)", COR_HEADER);

    var bag := CriaBagTeste(who, "bug2");
    if (!bag) return; endif

    // LootIndex human tem: Random Clothes, Random Seeds, Random Food,
    // Random LoreItems, Random PedacosPergaminhos, Random MoedasPobre
    // Praticamente tudo NÃO-craftável. Antes do fix, tudo vazia.
    var result := Loot_Generate(bag, "human", who);
    if (result.errortext)
        SmokeFail(who, "Bug #2", "Loot_Generate retornou erro: " + result.errortext);
        DestroyItem(bag);
        return;
    endif

    var total := 0;
    foreach item in (EnumerateItemsInContainer(bag))
        total := total + 1;
        SmokeLog(who, "  drop: " + item.desc + " (objtype " + Hex(item.objtype) + ")", COR_INFO);
    endforeach

    if (total == 0)
        SmokeFail(who, "Bug #2", "bag VAZIA — fix de !item || .errortext NÃO funcionou");
    elseif (total >= 1)
        SmokePass(who, "Bug #2", "bag com " + total + " items (esperado: 3-8)");
    endif

    DestroyItem(bag);
endfunction


// ============================================================
// TESTE BUG #1 — LOOT_EXCLUDED_METALS esvaziado + pipeline tier range
// ============================================================
// Bug #1 sozinho não cura tier 1 weapons porque o picker do crafting
// tem outra falha (bug #8 latente): para tier 1, o picker rola
// "valor" 1-2 mas Cobre só tem `dano t-1` (valor=0). Bucket vazio.
// O fallback do bug #2 também não ajuda porque nomes de receita como
// "LongSword" não existem em itemdesc.cfg, só em fabricacaoDesc.cfg.
//
// O que TESTAMOS aqui:
//   (a) LOOT_EXCLUDED_METALS está esvaziado (estado do código)
//   (b) Pipeline com tier range (1>3) dropa weapons fabricadas
//       porque tier 2/3 tem Bronze/Ferro disponíveis no picker.
//
// Tier 1 weapons puro continua bare — bug #8 latente, fora de escopo.
function Test_Bug1_CobreTier1(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #1] LOOT_EXCLUDED_METALS esvaziado + tier range fabricado", COR_HEADER);

    // Check (a): estado do código
    var bag_meta := CriaBagTeste(who, "bug1-meta");
    if (!bag_meta) return; endif
    var probe := GeraItemComplexo(
        bag_meta, 0xF5E, 1, 3, 1,
        LOOT_EXCLUDED_METALS,  // referência direta — tem que ser array vazio
        FABRICACAO_MODO_MATERIAL::MESMO_TIER
    );
    var blocklist_size := LOOT_EXCLUDED_METALS.size();
    SmokeLog(who, "  LOOT_EXCLUDED_METALS.size() = " + blocklist_size + " (esperado: 0)", COR_INFO);
    if (blocklist_size == 0)
        SmokePass(who, "Bug #1 (cfg)", "blocklist esvaziada");
    else
        SmokeFail(who, "Bug #1 (cfg)", "blocklist ainda tem " + blocklist_size + " entradas");
    endif
    DestroyItem(bag_meta);

    var bag := CriaBagTeste(who, "bug1");
    if (!bag) return; endif

    // Check (b): pipeline com tier range. greatgiants tem
    // "Random WeaponsGood 1d2 70 1>3" — tier vai de 1 a 3 por componente.
    // Quando picker rola tier 3, Ferro disponível → arma fabricada.
    // 20 tentativas — esperado ~14 com arma.
    var tentativas := 20;
    var rolls_com_arma := 0;
    var armas_fabricadas := 0;
    var i := 0;

    while (i < tentativas)
        foreach old in (EnumerateItemsInContainer(bag))
            DestroyItem(old);
            sleepms(2);
        endforeach

        Loot_Generate(bag, "greatgiants", who);

        var achou := 0;
        foreach created in (EnumerateItemsInContainer(bag))
            // Marca de arma craftada = prop fabricado é struct
            var fab := GetObjProperty(created, "fabricado");
            if (TypeOfInt(fab) == OT_STRUCT)
                achou := 1;
                armas_fabricadas := armas_fabricadas + 1;
                break;
            endif
        endforeach
        if (achou)
            rolls_com_arma := rolls_com_arma + 1;
        endif

        i := i + 1;
    endwhile

    SmokeLog(who, "  " + rolls_com_arma + "/" + tentativas + " greatgiants tiveram arma fabricada (esperado ~10/20)", COR_INFO);
    SmokeLog(who, "  total armas fabricadas: " + armas_fabricadas, COR_INFO);

    if (rolls_com_arma == 0)
        SmokeFail(who, "Bug #1 (pipe)", "ZERO armas fabricadas — picker quebrado em todos tiers");
    elseif (rolls_com_arma < 3)
        SmokeFail(who, "Bug #1 (pipe)", "armas muito raras (" + rolls_com_arma + "/20)");
    else
        SmokePass(who, "Bug #1 (pipe)", rolls_com_arma + "/20 com arma fabricada (tier range funcionou)");
    endif

    DestroyItem(bag);
endfunction


// ============================================================
// TESTE BUG #3 — Group ClothesWild
// ============================================================
// Pré-fix: "Item ClothesWild" registrado como tipo errado → invisível
// pro loot parser → Random ClothesWild não retornava nada.
// Pós-fix: "Group ClothesWild" registrado certo → Bearmask, Deermask,
// TribalMask, Tanga, LeatherSkirt aparecem.
function Test_Bug3_ClothesWild(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #3] Group ClothesWild (typo Item→Group)", COR_HEADER);

    var groups_cfg := ReadConfigFile(":loot:config/loot-groups");
    if (!groups_cfg || groups_cfg.errortext)
        SmokeFail(who, "Bug #3", "loot-groups.cfg não carregou");
        return;
    endif

    var elem := groups_cfg["ClothesWild"];
    if (!elem || elem.errortext)
        SmokeFail(who, "Bug #3", "groups_cfg[ClothesWild] vazio — ainda como Item type?");
        return;
    endif

    var items := GetConfigStringArray(elem, "Item");
    if (!items || items.size() == 0)
        SmokeFail(who, "Bug #3", "Group ClothesWild sem entradas Item");
        return;
    endif

    SmokeLog(who, "  Group ClothesWild tem " + items.size() + " entradas: ", COR_INFO);
    foreach line in items
        SmokeLog(who, "    - " + line, COR_INFO);
    endforeach

    // Esperado: 5 items (Bearmask, Deermask, TribalMask, Tanga, LeatherSkirt)
    if (items.size() >= 5)
        SmokePass(who, "Bug #3", items.size() + " entradas resolvidas");
    else
        SmokeFail(who, "Bug #3", "esperava 5 entradas, achou " + items.size());
    endif
endfunction


// ============================================================
// TESTE BUG #4 — Stack <grupo> trocado por Random
// ============================================================
// Pré-fix: LootIndex tinha "Stack MoedasPobre 1 50" mas MoedasPobre é
// um Group, não item → GetObjtypeByName("MoedasPobre") falha → no coin.
// Pós-fix: trocado por "Random MoedasPobre 1 50" → resolve o Group.
function Test_Bug4_MoedasGroup(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #4] Stack/Random Moedas* group resolve", COR_HEADER);

    // Confirma no cfg que não sobrou Stack apontando pra Moedas*
    var idx_cfg := ReadConfigFile(":loot:config/loot-index");
    if (!idx_cfg || idx_cfg.errortext)
        SmokeFail(who, "Bug #4", "loot-index.cfg não carregou");
        return;
    endif

    var human := idx_cfg["human"];
    if (!human || human.errortext)
        SmokeFail(who, "Bug #4", "LootIndex human ausente");
        return;
    endif

    var randoms := GetConfigStringArray(human, "Random");
    var found_moeda := 0;
    foreach line in randoms
        if (Find(Lower(line), "moedas", 1) >= 1)
            found_moeda := 1;
            SmokeLog(who, "  encontrei: Random " + line, COR_INFO);
        endif
    endforeach

    var stacks := GetConfigStringArray(human, "Stack");
    var bad_stack := 0;
    foreach line in stacks
        if (Find(Lower(line), "moedas", 1) >= 1)
            bad_stack := 1;
            SmokeLog(who, "  REMANESCENTE: Stack " + line, COR_FAIL);
        endif
    endforeach

    if (bad_stack)
        SmokeFail(who, "Bug #4", "ainda tem Stack Moedas* em LootIndex human");
    elseif (!found_moeda)
        SmokeFail(who, "Bug #4", "Random Moedas* não encontrado em LootIndex human");
    else
        SmokePass(who, "Bug #4", "human usa Random Moedas*, sem Stack");
    endif

    // Geração prática: gera loot, conta moedas
    var bag := CriaBagTeste(who, "bug4");
    if (!bag) return; endif

    var tentativas := 20;
    var com_moeda := 0;
    var i := 0;
    while (i < tentativas)
        // Esvazia
        foreach item in (EnumerateItemsInContainer(bag))
            DestroyItem(item);
            sleepms(2);
        endforeach
        Loot_Generate(bag, "human", who);
        foreach item in (EnumerateItemsInContainer(bag))
            if (item.objtype == 0xBA63) // moedacobre
                com_moeda := com_moeda + 1;
                break;
            endif
        endforeach
        i := i + 1;
    endwhile

    SmokeLog(who, "  " + com_moeda + "/" + tentativas + " gerações tiveram moedacobre (chance ~50%)", COR_INFO);
    if (com_moeda >= 5)
        SmokePass(who, "Bug #4 (prático)", com_moeda + "/" + tentativas + " com moedas");
    else
        SmokeFail(who, "Bug #4 (prático)", "esperava >= 5/20, achou " + com_moeda);
    endif

    DestroyItem(bag);
endfunction


// ============================================================
// TESTE BUG #5 — combat_wave preserva loot
// ============================================================
// Pré-fix: combat-event waves recebiam summoned=1 → NoLootCheck destrói
// cadáver inteiro. Pós-fix: combat_wave=1 → NoLootCheck NÃO dispara
// branch summoned → loot preservado.
function Test_Bug5_CombatWave(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #5] combat_wave preserva loot na morte", COR_HEADER);

    // Simulação direta: cria um item, marca com summoned vs combat_wave,
    // e verifica se NoLootCheck (em npcdeath.src) dispararia.
    // Como NoLootCheck não é exportado, inline a lógica equivalente.

    var fake_corpse_summoned := CreateItemInBackpack(who, 0x0E76, 1);
    if (!fake_corpse_summoned) return; endif
    SetName(fake_corpse_summoned, "[fake summoned corpse]");
    SetObjProperty(fake_corpse_summoned, "summoned", 1);

    var fake_corpse_wave := CreateItemInBackpack(who, 0x0E76, 1);
    if (!fake_corpse_wave) return; endif
    SetName(fake_corpse_wave, "[fake combat_wave corpse]");
    SetObjProperty(fake_corpse_wave, "combat_wave", 1);

    // Inline NoLootCheck branch para summoned
    var summoned_destroi := SimulaNoLootCheck(fake_corpse_summoned);
    var wave_destroi := SimulaNoLootCheck(fake_corpse_wave);

    SmokeLog(who, "  corpse com summoned=1 → NoLootCheck destrói? " + (summoned_destroi ? "SIM" : "NÃO"), COR_INFO);
    SmokeLog(who, "  corpse com combat_wave=1 → NoLootCheck destrói? " + (wave_destroi ? "SIM" : "NÃO"), COR_INFO);

    if (summoned_destroi && !wave_destroi)
        SmokePass(who, "Bug #5", "summoned dispara, combat_wave NÃO");
    elseif (!summoned_destroi)
        SmokeFail(who, "Bug #5", "summoned NÃO dispara — branch summoned removido?");
    elseif (wave_destroi)
        SmokeFail(who, "Bug #5", "combat_wave dispara — NoLootCheck adicionou branch novo?");
    endif

    DestroyItem(fake_corpse_summoned);
    DestroyItem(fake_corpse_wave);
endfunction

// Réplica da lógica NoLootCheck em pkg/mobiles/death/npcdeath.src:439-469
// (sem o npc_cfg arg porque é fake corpse).
function SimulaNoLootCheck(corpse)
    if (GetObjProperty(corpse, "GuardKill"))    return 1; endif
    if (GetObjProperty(corpse, "guardkill"))    return 1; endif
    if (GetObjProperty(corpse, "NoCorpse"))     return 1; endif
    if (GetObjProperty(corpse, "nocorpse"))     return 1; endif
    if (GetObjProperty(corpse, "summoned"))     return 1; endif
    return 0;
endfunction


// ============================================================
// TESTE BUG #7 — PersonalLoot_Arm early-exit
// ============================================================
// Pré-fix: PersonalLoot_Arm sempre armava lockout em true_boss, mesmo
// sem itens taggeados from_boss_loot=1 → players esperam 15s por nada.
// Pós-fix: early-exit se nenhum item taggeado.
function Test_Bug7_PersonalLootEarlyExit(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #7] PersonalLoot_Arm early-exit", COR_HEADER);

    var corpse_vazio := CreateItemInBackpack(who, 0x0E76, 1);
    if (!corpse_vazio) return; endif
    SetName(corpse_vazio, "[corpse sem from_boss_loot]");

    var ret_vazio := PersonalLoot_Arm(corpse_vazio);
    var unlock_vazio := GetObjProperty(corpse_vazio, "loot_unlock_at");

    SmokeLog(who, "  PersonalLoot_Arm sem from_boss_loot: ret=" + ret_vazio +
              " loot_unlock_at=" + (unlock_vazio == error ? "(nao armou)" : CStr(unlock_vazio)), COR_INFO);

    var corpse_com := CreateItemInBackpack(who, 0x0E76, 1);
    if (!corpse_com) return; endif
    SetName(corpse_com, "[corpse com from_boss_loot]");
    var marker := CreateItemInContainer(corpse_com, 0xEED, 1);  // qualquer item
    SetObjProperty(marker, "from_boss_loot", 1);

    var ret_com := PersonalLoot_Arm(corpse_com);
    var unlock_com := GetObjProperty(corpse_com, "loot_unlock_at");

    SmokeLog(who, "  PersonalLoot_Arm com from_boss_loot: ret=" + ret_com +
              " loot_unlock_at=" + (unlock_com == error ? "(nao armou)" : CStr(unlock_com)), COR_INFO);

    // Critério: sem from_boss_loot → ret=0, unlock não armado
    //          com from_boss_loot + GM próximo → ret pode ser 0 se GM cmdlevel>0
    //                                           ou 1 se há player cmdlevel==0 perto

    if (ret_vazio == 0 && unlock_vazio == error)
        SmokePass(who, "Bug #7 (vazio)", "sem from_boss_loot não arma lockout");
    else
        SmokeFail(who, "Bug #7 (vazio)", "armou mesmo sem from_boss_loot — early-exit falhou");
    endif

    // Para o corpse com from_boss_loot, o resultado depende de ter player
    // cmdlevel==0 em LOS. Apenas reporta, não falha.
    if (ret_com == 1)
        SmokePass(who, "Bug #7 (com)", "armou (tem player cmdlevel==0 em LOS)");
    else
        SmokeLog(who, "  Bug #7 (com): não armou — provavelmente só GM por perto (cmdlevel>0)", COR_INFO);
        SmokePass(who, "Bug #7 (com)", "comportamento esperado (sem player real)");
    endif

    DestroyItem(corpse_vazio);
    DestroyItem(corpse_com);
endfunction


// ============================================================
// TESTE BUG #8 — picker com fallback de bucket vizinho
// ============================================================
// Pré-fix: tier 1 puro (LootIndex mercenary com Random WeaponsCommon
// 1 40) falhava 100% porque buckets de componente valor 1+ ficavam
// vazios pra alguns characterísticas. Pós-fix: PicarMaterialPorVizinho
// snap pro bucket disponível mais próximo. Esperado >= 40% das geracões
// com WeaponsCommon roladas entregam arma fabricada.
function Test_Bug8_PickerFallback(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #8] Picker com fallback de bucket vizinho", COR_HEADER);

    var bag := CriaBagTeste(who, "bug8");
    if (!bag) return; endif

    var tentativas := 30;
    var rolls_com_arma := 0;
    var armas_fabricadas := 0;
    var armas_bare := 0;
    var i := 0;

    while (i < tentativas)
        foreach old in (EnumerateItemsInContainer(bag))
            DestroyItem(old);
            sleepms(2);
        endforeach

        // mercenary: Random WeaponsCommon 1 40 — TIER 1 PURO
        Loot_Generate(bag, "mercenary", who);

        var achou := 0;
        foreach created in (EnumerateItemsInContainer(bag))
            var fab := GetObjProperty(created, "fabricado");
            if (TypeOfInt(fab) == OT_STRUCT)
                achou := 1;
                armas_fabricadas := armas_fabricadas + 1;
                break;
            endif
        endforeach
        if (achou)
            rolls_com_arma := rolls_com_arma + 1;
        endif

        i := i + 1;
    endwhile

    SmokeLog(who, "  " + rolls_com_arma + "/" + tentativas + " mercenary com arma fabricada (esperado >= 4/30)", COR_INFO);
    SmokeLog(who, "  total armas fabricadas: " + armas_fabricadas, COR_INFO);

    if (rolls_com_arma == 0)
        SmokeFail(who, "Bug #8", "ZERO armas fabricadas — fallback do picker não funcionou");
    elseif (rolls_com_arma < 4)
        SmokeFail(who, "Bug #8", "fabricadas raras demais (" + rolls_com_arma + "/30)");
    else
        SmokePass(who, "Bug #8", rolls_com_arma + "/30 mercenary tier 1 com arma fabricada");
    endif

    DestroyItem(bag);
endfunction


// ============================================================
// MANUAL — BUG #6
// ============================================================
function Manual_Bug6_GumpDefault(who)
    SmokeLog(who, "", COR_HEADER);
    SmokeLog(who, "[BUG #6] Gump default checkbox — TESTE MANUAL", COR_HEADER);
    SmokeLog(who, "Rode .epicboss → Add Loot Item → arraste um item.", COR_INFO);
    SmokeLog(who, "  No sub-gump, checkbox 'Dropar na morte' deve vir MARCADO.", COR_INFO);
    SmokeLog(who, "  Label esperada: 'Dropar na morte (distribuir entre participantes)'.", COR_INFO);
endfunction
