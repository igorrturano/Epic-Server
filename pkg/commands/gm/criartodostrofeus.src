	var bolsa := CreateItemInBackpack(who, "backpack", 1);
	bolsa.color := 1175;
	bolsa.name := "Todos os Trofeus";

	foreach coisa in trofeus
		CreateItemInContainer(bolsa, coisa, 1);
	endforeach

	SendSysMessage(who, "Bolsa criada com " + trofeus.size() + " trofeus.");
endprogram
