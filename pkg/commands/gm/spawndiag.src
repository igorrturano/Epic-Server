use uo;
use os;
use cfgfile;

include ":spawnsystem:regions";
include ":spawnsystem:groups";
include ":spawnsystem:realms";

program textcmd_spawndiag( who, text )
  if ( who.cmdlevel < 4 )
	SendSysMessage( who, "You don't have permission to use this command." );
	return;
  endif

  var cmd := SplitWords( text );
  var action := cmd[1];

  if ( !action )
	SendSysMessage( who, "Usage: .spawndiag <list|check|remove|info> [region_name]" );
	return;
  endif

  case ( action )
	"list":  ListAllSpawnRegions( who );
	"check": CheckInvalidRegions( who );
	"remove":
	  if ( cmd[2] )
		RemoveSpawnRegion( who, cmd[2] );
	  else
		SendSysMessage( who, "Usage: .spawndiag remove <region_name>" );
	  endif
	"info":
	  if ( cmd[2] )
		ShowRegionInfo( who, cmd[2] );
	  else
		SendSysMessage( who, "Usage: .spawndiag info <region_name>" );
	  endif
	default: SendSysMessage( who, "Usage: .spawndiag <list|check|remove|info> [region_name]" );
  endcase
endprogram

function ListAllSpawnRegions( who )
  SendSysMessage( who, "=== SPAWN SYSTEM REGIONS ===" );

  var region_names := SS_GetRegionNames();
  SendSysMessage( who, "Total regions in spawn system: " + region_names.size() );

  foreach region_name in region_names
	var realm := SS_GetRegionRealm( region_name );
	var coords := SS_GetRegionCoordinates( region_name );
	var groups := SS_GetGroupsInRegion( region_name );

	SendSysMessage( who, "- " + region_name + " (realm: " + realm + ", groups: " + groups.size() + ")" );
	if ( coords )
	  SendSysMessage( who, "  Coords: " + coords.x1 + "," + coords.y1 + " to "
				   + coords.x2 + "," + coords.y2 );
	else
	  SendSysMessage( who, "  WARNING: No coordinates set!" );
	endif
	sleepms( 10 );
  endforeach
endfunction

function CheckInvalidRegions( who )
  SendSysMessage( who, "=== CHECKING FOR INVALID REGIONS ===" );

  // Read the actual regions.cfg file
  var regions_cfg := ReadConfigFile( ":*:regions" );
  var valid_regions := array{};
  foreach region_name in GetConfigStringKeys( regions_cfg )
	valid_regions.append( Lower( region_name ) );
  endforeach

  var spawn_regions := SS_GetRegionNames();
  var invalid_count := 0;

  foreach region_name in spawn_regions
	var coords := SS_GetRegionCoordinates( region_name );
	var is_valid := 1;
	var issues := "";

	// Check if region exists in regions.cfg
	if ( !( Lower( region_name ) in valid_regions ) )
	  is_valid := 0;
	  issues += "NOT_IN_REGIONS_CFG ";
	endif

	// Check if coordinates are set
	if ( !coords )
	  is_valid := 0;
	  issues += "NO_COORDINATES ";
	endif

	// Check if coordinates are reasonable
	if ( coords && ( coords.x1 < 0 || coords.y1 < 0 || coords.x2 < coords.x1 || coords.y2 < coords.y1 ) )
	  is_valid := 0;
	  issues += "INVALID_COORDINATES ";
	endif

	if ( !is_valid )
	  invalid_count += 1;
	  SendSysMessage( who, "INVALID: " + region_name + " - " + issues );

	  var groups := SS_GetGroupsInRegion( region_name );
	  if ( groups.size() > 0 )
		SendSysMessage( who, "  Has " + groups.size() + " spawn groups" );
	  endif
	endif
	sleepms( 10 );
  endforeach

  if ( invalid_count == 0 )
	SendSysMessage( who, "All spawn regions are valid!" );
  else
	SendSysMessage( who, "Found " + invalid_count + " invalid regions." );
  endif
endfunction

function RemoveSpawnRegion( who, region_name )
  SendSysMessage( who, "Removing spawn region: " + region_name );

  // Show what will be removed
  var groups := SS_GetGroupsInRegion( region_name );
  SendSysMessage( who, "Region has " + groups.size() + " spawn groups" );

  foreach group_name in ( groups.Keys() )
	var spawns := SS_GetSpawnsInRegionGroup( region_name, group_name );
	SendSysMessage( who, "- Group '" + group_name + "' has " + spawns.size() + " active spawns" );
  endforeach

  // Remove the region
  var realm_name := SS_GetRegionRealm( region_name );
  SS_RemoveRegionFromRealm( realm_name, region_name );
  SS_RemoveRegion( region_name );

  SendSysMessage( who, "Successfully removed region: " + region_name );
endfunction

function ShowRegionInfo( who, region_name )
  SendSysMessage( who, "=== REGION INFO: " + region_name + " ===" );

  var coords := SS_GetRegionCoordinates( region_name );
  var realm := SS_GetRegionRealm( region_name );
  var groups := SS_GetGroupsInRegion( region_name );

  SendSysMessage( who, "Realm: " + realm );
  if ( coords )
	SendSysMessage( who, "Coordinates: " + coords.x1 + "," + coords.y1 + " to "
				 + coords.x2 + "," + coords.y2 );
  else
	SendSysMessage( who, "Coordinates: NONE SET" );
  endif

  SendSysMessage( who, "Groups (" + groups.size() + "):" );
  foreach group_name in ( groups.Keys() )
	var group_settings := groups[group_name];
	var spawns := SS_GetSpawnsInRegionGroup( region_name, group_name );
	SendSysMessage( who, "- " + group_name + " (max: " + group_settings.max_amt
												 + ", enabled: " + group_settings.enabled + ", active: " + spawns.size() + ")" );
  endforeach
endfunction
