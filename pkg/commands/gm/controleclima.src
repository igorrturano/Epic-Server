use uo;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":tn:tngumps";
include ":nature:nature";
include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":fls_core:packets";
include "include/say";
include "include/client";
include ":timedScripts:timedScripts";

program controleclima(who)

	var options := CheckBoxGump(who, 240, 300, "Controle do Clima", { "Chuva", "Neve", "Vento", "Vento Forte",
																	  "Tempestade", "Tempestade de Raios", "Terremoto" });

	if (!options || options.size() == 0)
		SendSysMessageEx(who, "Nenhuma condicao climatica selecionada.", SSM_FAIL);
		return;
	endif

	var type := 0xFF;
	var som := 0;
	var bolt := 0;
	var ventoForte := 0;

	if ("Terremoto" in options)
		type := 10;
	elseif ("Tempestade de Raios" in options)
		type := 1;
		som := 1;
		bolt := 1;
	elseif ("Tempestade" in options)
		type := 1;
	elseif ("Neve" in options)
		type := 2;
	elseif ("Chuva" in options)
		type := 0;
	endif

	if ("Vento Forte" in options)
		som := 2;
		ventoForte := 1;
	elseif ("Vento" in options)
		som := 2;
	endif

	if (type == 0xFF && !som)
		SendSysMessageEx(who, "Nenhum efeito valido foi selecionado.", SSM_FAIL);
		return;
	endif

	var origx := who.x;
	var origy := who.y;
	var affectedMobs := array;
	var seenSerials := dictionary;

	SendSysMessageEx(who, "Voce deve permanecer parado enquanto quiser controlar o clima.", SSM_INFO);

	while (1)

		PerformAction(who, HUMAN_ANIM::CAST_AREA);
		if ((origx != who.x) || (origy != who.y))
			SendSysMessage(who, "Voce parou de controlar o clima.", SSM_FAIL);
			break;
		endif

		if (som)
			windsound(who);
		endif

		SetWeatherForPlayer(who, type, 50);

		var bolts := RandomInt(5);
		var mobs := ListMobilesNearLocation(who.x, who.y, who.z, 20, who.realm);

		foreach mob in mobs
			if (mob.serial == who.serial)
				continue;
			endif
			if (mob.master == who)
				continue;
			endif
			if (mob in who.party.members)
				continue;
			endif

			if (!seenSerials.exists(mob.serial))
				seenSerials[mob.serial] := 1;
				affectedMobs.append(mob);
			endif

			if (!mob.isUnderRoof())
				SetWeatherForPlayer(mob, type, 50);
				wetPowder(mob);
			endif

			if (bolt)
				if (RandomInt(100) < 5)
					PlayLightningBoltEffect(mob);
					DealDamage(mob, RandomDiceRoll("1d40") + 10, DAMAGE_TYPE::ENERGY);
					SendSysMessageEx(mob, "Voce foi atingido por um raio!", SSM_INFO);
				endif
			endif

			if (ventoForte)
				if (RandomInt(100) < 5)
					SendSysMessageEx(mob, "O vento forte impede seus movimentos!", SSM_INFO);
					TS_StartTimer(mob, "paralysis", 5);
				endif
			endif
		endforeach

		if (bolt)
			var k := 0;
			while (k < bolts)
				if (RandomInt(100) < 15)
					DoBolt(who);
				endif
				k := k + 1;
			endwhile
		endif

		sleep(5);
	endwhile

	foreach mob in affectedMobs
		EraseObjProperty(mob, "molhado");
		SetWeatherForPlayer(mob, 0xFF, 1);
		moveobjecttolocation(mob, mob.x, mob.y, mob.z, mob.realm);
	endforeach

	SetWeatherForPlayer(who, 0xFF, 1);

endprogram

function windsound(person)
	var wind := { 21, 22, 23 };
	if (randomdiceroll("1d4") == 2)
		playsoundeffect(person, wind[randomint(3) + 1]);
	endif
endfunction
