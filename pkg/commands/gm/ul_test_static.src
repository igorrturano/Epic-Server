// Comando GM sub-fase 2.A — testa statics update UltimaLive em tempo real.

use uo;
use basic;

include ":ultimalive:include/packets";

program ul_test_static(who, text)
    var args := SplitWords(text);
    if (Len(args) < 1)
        SendSysMessage(who, "Uso: .ul_test_static <get|set <hex> [hue]|delete|revert>");
        return 0;
    endif

    var subcmd := Lower(args[1]);

    if (subcmd == "get")
        return _Cmd_Get(who);
    elseif (subcmd == "set")
        return _Cmd_Set(who, args);
    elseif (subcmd == "delete")
        return _Cmd_Delete(who);
    elseif (subcmd == "revert")
        return _Cmd_Revert(who);
    else
        SendSysMessage(who, "Subcomando invalido. Use: get, set, delete, revert");
        return 0;
    endif
endprogram

function _GetTarget(who)
    SendSysMessage(who, "Selecione um tile/static...");
    var targ := TargetCoordinates(who);
    if (!targ)
        SendSysMessage(who, "Cancelado.");
        return error{"errortext" := "cancelado"};
    endif
    return targ;
endfunction

function _SendUpdate(who, x, y)
    var bx     := CInt(x) / 8;
    var by     := CInt(y) / 8;
    var result := UL_SendStaticsUpdate(who, who.realm, bx, by);
    if (result == error)
        SendSysMessage(who, "Erro ao enviar packet: " + result.errortext);
        return 0;
    endif
    SendSysMessage(who, "Packet 0x3F statics enviado para bloco (" + bx + ", " + by + "). Veja log do POL.");
    return 1;
endfunction

function _Cmd_Get(who)
    var targ := _GetTarget(who);
    if (targ == error) return 0; endif

    var x := CInt(targ.x);
    var y := CInt(targ.y);
    SendSysMessage(who, "Statics em (" + x + ", " + y + ") realm=" + who.realm + ":");

    var natives := ListStaticsAtLocation(x, y, LIST_IGNORE_Z, 0, who.realm);
    if (Len(natives) == 0)
        SendSysMessage(who, "  (nenhum static nativo)");
        return 1;
    endif
    foreach st in natives
        var sz       := CInt(st.z);
        var mutation := UL_GetMutation(who.realm, x, y, sz);
        var mut_str  := "";
        if (mutation != error)
            mut_str := " | mutation=" + mutation.MutationType + " g=" + Hex(mutation.Graphic) + " hue=" + mutation.Hue;
        endif
        SendSysMessage(who, "  graphic=" + Hex(CInt(st.objtype)) + " z=" + sz + mut_str);
    endforeach
    return 1;
endfunction

function _Cmd_Set(who, args)
    if (Len(args) < 2)
        SendSysMessage(who, "Uso: .ul_test_static set <hex> [hue]");
        return 0;
    endif
    var graphic := CInt(args[2]);
    var hue     := 0;
    if (Len(args) >= 3)
        hue := CInt(args[3]);
    endif

    var targ := _GetTarget(who);
    if (targ == error) return 0; endif

    var x := CInt(targ.x);
    var y := CInt(targ.y);
    var z := CInt(targ.z);

    var result := UL_SetStatic(who.realm, x, y, z, graphic, hue, "gm");
    if (result == error)
        SendSysMessage(who, "Erro ao setar static: " + result.errortext);
        return 0;
    endif
    SendSysMessage(who, "Mutacao registrada: graphic=" + Hex(graphic) + " hue=" + hue + " em (" + x + ", " + y + ", " + z + ").");
    return _SendUpdate(who, x, y);
endfunction

function _Cmd_Delete(who)
    var targ := _GetTarget(who);
    if (targ == error) return 0; endif

    var x := CInt(targ.x);
    var y := CInt(targ.y);
    var z := CInt(targ.z);

    var result := UL_DeleteStatic(who.realm, x, y, z, "gm");
    if (result == error)
        SendSysMessage(who, "Erro ao deletar static: " + result.errortext);
        return 0;
    endif
    SendSysMessage(who, "static_delete registrado em (" + x + ", " + y + ", " + z + ").");
    return _SendUpdate(who, x, y);
endfunction

function _Cmd_Revert(who)
    var targ := _GetTarget(who);
    if (targ == error) return 0; endif

    var x := CInt(targ.x);
    var y := CInt(targ.y);
    var z := CInt(targ.z);

    var result := UL_RevertMutation(who.realm, x, y, z);
    if (result == error)
        if (result.errortext == "no mutation to revert")
            SendSysMessage(who, "Nada pra reverter em (" + x + ", " + y + ", " + z + ").");
        else
            SendSysMessage(who, "Erro ao reverter: " + result.errortext);
        endif
        return 0;
    endif
    SendSysMessage(who, "Mutacao revertida em (" + x + ", " + y + ", " + z + ").");
    return _SendUpdate(who, x, y);
endfunction
