use uo;
use cfgfile;
use os;
use basic;
use polsys;
use util;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:/include/epicGumps";
include ":census:include/CensusController";
include ":accounts:accounts";

const GUMP_WIDTH  := 500;
const GUMP_HEIGHT := 500;

// Old categories are kept (legacy data is preserved, not erased). The new
// path-rework pages are appended after them so fresh data accumulates
// alongside the historical numbers.
var page_titles := array{
	"Habilidades Mais Compradas",
	"Culturas Escolhidas",
	"Classes Escolhidas",
	"Racas Escolhidas",
	"Backgrounds Escolhidos",
	"Religioes Escolhidas",
	"Caminhos de Sabedoria (legado)",
	"Caracteristicas (Traits)",
	"Vocacao (Path)",
	"Subclasses Escolhidas",
	"Modo de Jogo",
	"Tipo de Magia",
	"Skills - Todas",
	"Skills - Primarias",
	"Skills - Secundarias"
};

var page_categories := array{
	"abilities",
	"creation_culture",
	"creation_classe",
	"creation_race",
	"creation_background",
	"creation_religion",
	"creation_path",
	"creation_trait",
	"creation_vocacao",
	"creation_subclasse",
	"creation_game_mode",
	"creation_magia",
	"skills_all",
	"skills_primary",
	"skills_secondary"
};

// .censo atual snapshots the live population (every cmdlevel-0 char in an
// enabled, non-banned account) instead of cumulative creation history.
var atual_titles := array{
	"Atual - Habilidades",
	"Atual - Niveis",
	"Atual - Culturas",
	"Atual - Classes",
	"Atual - Racas",
	"Atual - Backgrounds",
	"Atual - Religioes",
	"Atual - Caminho (legado)",
	"Atual - Traits",
	"Atual - Vocacao",
	"Atual - Subclasses",
	"Atual - Modo de Jogo",
	"Atual - Tipo de Magia",
	"Atual - Skills Todas",
	"Atual - Skills Primarias",
	"Atual - Skills Secundarias"
};

var atual_categories := array{
	"current_abilities",
	"current_level",
	"cur_creation_culture",
	"cur_creation_classe",
	"cur_creation_race",
	"cur_creation_background",
	"cur_creation_religion",
	"cur_creation_path",
	"cur_creation_trait",
	"cur_creation_vocacao",
	"cur_creation_subclasse",
	"cur_creation_game_mode",
	"cur_creation_magia",
	"cur_skills_all",
	"cur_skills_primary",
	"cur_skills_secondary"
};

program censo(who, param)
	var titles := page_titles;
	var categories := page_categories;

	var args := SplitWords(param);
	if (args && args != error && args.size() >= 1 && Lower(args[1]) == "atual")
		if (who.cmdlevel < 3)
			SendSysMessage(who, "Apenas admin pode rodar o censo atual.");
			return;
		endif
		SendSysMessage(who, "Coletando censo da populacao atual, aguarde...");
		RunCurrentSnapshot(who);
		titles := atual_titles;
		categories := atual_categories;
	endif

	var current_page := 1;
	var total_pages := titles.size();

	while (1)
		var gump := BuildCensusGump(current_page, total_pages, titles, categories);
		var input := GFSendGump(who, gump);

		if (!input || input[0] == 0)
			break;
		endif

		if (input[0] == 100)
			current_page := current_page + 1;
			if (current_page > total_pages)
				current_page := 1;
			endif
		elseif (input[0] == 101)
			current_page := current_page - 1;
			if (current_page < 1)
				current_page := total_pages;
			endif
		else
			break;
		endif
	endwhile
endprogram

function BuildCensusGump(page, total_pages, titles, categories)
	var title := "Censo - " + titles[page];
	var gump := GFECreateGump(title, GUMP_WIDTH, GUMP_HEIGHT);

	var category := categories[page];
	var y := 75;

	if (category == "abilities" || category == "current_abilities")
		RenderAbilitiesList(gump, y, category);
	elseif (category == "current_level")
		RenderLevelList(gump, y);
	else
		RenderGenericList(gump, y, category);
	endif

	// Navigation bar
	var nav_y := GUMP_HEIGHT - 35;
	GFAddButton(gump, 30, nav_y, 0x15E3, 0x15E7, GF_CLOSE_BTN, 101);
	GFTextMid(gump, 30, nav_y + 3, GUMP_WIDTH - 60, 53, "Pagina " + page + " de " + total_pages);
	GFAddButton(gump, GUMP_WIDTH - 50, nav_y, 0x15E1, 0x15E5, GF_CLOSE_BTN, 100);

	return gump;
endfunction

function RenderAbilitiesList(byref gump, byref y, category)
	var counters := CensusGetCounters(category);
	var hab_cfg := ReadConfigFile(":abilities:configs/habilidades");

	var entries := array;
	foreach ability_id in (counters.keys())
		var entry := struct;
		entry.+name := "Habilidade #" + ability_id;
		entry.+count := counters[ability_id];

		if (hab_cfg)
			var elem := FindConfigElem(hab_cfg, ability_id);
			if (elem && elem != error)
				var nome := GetConfigString(elem, "nome");
				if (nome && nome != error)
					entry.name := nome;
				endif
			endif
		endif

		entries.append(entry);
	endforeach

	SortByCount(entries);
	RenderEntries(gump, y, entries);
endfunction

function RenderGenericList(byref gump, byref y, category)
	var counters := CensusGetCounters(category);

	var entries := array;
	foreach key in (counters.keys())
		var entry := struct;
		entry.+name := StrReplace(key, "_", " ");
		entry.+count := counters[key];
		entries.append(entry);
	endforeach

	SortByCount(entries);
	RenderEntries(gump, y, entries);
endfunction

function RenderEntries(byref gump, byref y, byref entries)
	if (entries.size() == 0)
		GFTextMid(gump, 30, y + 40, GUMP_WIDTH - 60, 946, "Sem dados registrados");
		return;
	endif

	// Total
	var total := 0;
	foreach entry in (entries)
		total := total + entry.count;
	endforeach

	// Build HTML content
	var html := "<BASEFONT Color=#FFFFFF Size=5>";
	html := html + "<b>Total: " + total + "</b><BR>";
	html := html + "<BR>";

	var i := 1;
	foreach entry in (entries)
		var pct := CInt((entry.count * 100) / total);
		var color := "#333333";

		if (i == 1)
			color := "#B8860B";
		elseif (i == 2)
			color := "#4A4A8A";
		elseif (i == 3)
			color := "#8B4513";
		endif

		html := html + "<BASEFONT Color=" + color + ">";
		html := html + CStr(i) + ". " + entry.name;
		html := html + " - " + CStr(entry.count) + " (" + CStr(pct) + "%)";
		html := html + "<BR>";
		i := i + 1;
	endforeach

	var scroll_height := GUMP_HEIGHT - y - 45;
	GFHTMLArea(gump, 25, y, GUMP_WIDTH - 45, scroll_height, html, 1, 1);
endfunction

function SortByCount(byref arr)
	var n := arr.size();
	var i := 1;
	while (i <= n)
		var j := i + 1;
		while (j <= n)
			if (arr[j].count > arr[i].count)
				var temp := arr[i];
				arr[i] := arr[j];
				arr[j] := temp;
			endif
			j := j + 1;
		endwhile
		i := i + 1;
	endwhile
endfunction

function SortByLevelAsc(byref arr)
	var n := arr.size();
	var i := 1;
	while (i <= n)
		var j := i + 1;
		while (j <= n)
			if (arr[j].lvl < arr[i].lvl)
				var temp := arr[i];
				arr[i] := arr[j];
				arr[j] := temp;
			endif
			j := j + 1;
		endwhile
		i := i + 1;
	endwhile
endfunction

// Unpacks "acct:xp;acct:xp" into "{acct, xp}, {acct, xp}" for the gump.
function FormatLevelDetail(packed)
	var pieces := SplitWords(packed, ";");
	if (!pieces || pieces == error || pieces.size() == 0)
		return "";
	endif
	var joined := "";
	var idx := 1;
	while (idx <= pieces.size())
		var pair := SplitWords(pieces[idx], ":");
		if (pair && pair != error && pair.size() >= 2)
			if (joined != "")
				joined := joined + ", ";
			endif
			joined := joined + "{" + pair[1] + ", " + pair[2] + "}";
		endif
		idx := idx + 1;
	endwhile
	return joined;
endfunction

function RenderLevelList(byref gump, byref y)
	var counts := CensusGetCounters("current_level");
	var hi := CensusGetRaw("current_level_hi");
	var meta := CensusGetRaw("current_meta");

	var entries := array;
	foreach lvl_key in (counts.keys())
		var entry := struct;
		entry.+lvl := CInt(lvl_key);
		entry.+count := counts[lvl_key];
		entry.+detail := "";
		if (entry.lvl > 15 && hi.Exists(lvl_key))
			entry.detail := FormatLevelDetail(hi[lvl_key]);
		endif
		entries.append(entry);
	endforeach

	if (entries.size() == 0)
		GFTextMid(gump, 30, y + 40, GUMP_WIDTH - 60, 946, "Sem dados registrados");
		return;
	endif

	SortByLevelAsc(entries);

	var total := 0;
	foreach ent in (entries)
		total := total + ent.count;
	endforeach

	var html := "<BASEFONT Color=#FFFFFF Size=5>";
	if (meta.Exists("generated_at"))
		html := html + "<BASEFONT Color=#AAAAAA>Atualizado: " + meta["generated_at"] + "<BR>";
	endif
	html := html + "<BASEFONT Color=#FFFFFF><b>Total de personagens: " + total + "</b><BR><BR>";

	foreach ent in (entries)
		var color := "#FFFFFF";
		if (ent.lvl > 15)
			color := "#B8860B";
		endif
		html := html + "<BASEFONT Color=" + color + ">";
		html := html + "Nivel " + CStr(ent.lvl) + " - " + CStr(ent.count);
		if (ent.detail != "")
			html := html + " (" + ent.detail + ")";
		endif
		html := html + "<BR>";
	endforeach

	var scroll_height := GUMP_HEIGHT - y - 45;
	GFHTMLArea(gump, 25, y, GUMP_WIDTH - 45, scroll_height, html, 1, 1);
endfunction

// Walks every account: skip banned, skip disabled ("jail"), and per
// character slot skip non-cmdlevel-0. Aggregates purchased abilities
// (myhabs) and a Level distribution, with per-account XP detail for
// the high-level (>15) tail. Snapshots replace the prior run.
function RunCurrentSnapshot(who)
	var ability_counts := dictionary;
	var level_counts := dictionary;
	var level_hi := dictionary;
	var creation_counters := dictionary;	// category -> (dict key->count)
	var total_chars := 0;

	var accts := ListAccounts();
	foreach acct_name in (accts)
		var acct := FindAccount(acct_name);
		if (!acct || acct == error)
			continue;
		endif
		if (acct.banned)
			continue;
		elseif (!acct.enabled)
			continue;
		endif

		var slot := 1;
		while (slot <= 6)
			var p := acct.GetCharacter(slot);
			slot := slot + 1;
			if (!p || p == error)
				continue;
			endif
			if (p.cmdlevel != 0)
				continue;
			endif

			total_chars := total_chars + 1;

			var raw_lvl := GetObjProperty(p, "Level");
			if (raw_lvl == error || !raw_lvl)
				raw_lvl := 0;
			endif
			var lvl := CInt(raw_lvl);
			if (lvl < 1)
				lvl := 1;
			endif
			var raw_xp := GetObjProperty(p, "Experience");
			if (raw_xp == error || !raw_xp)
				raw_xp := 0;
			endif
			var xp := CInt(raw_xp);
			var lkey := CStr(lvl);
			var lc := level_counts.Exists(lkey) ? level_counts[lkey] : 0;
			level_counts[lkey] := lc + 1;

			if (lvl > 15)
				var prefix := level_hi.Exists(lkey) ? (level_hi[lkey] + ";") : "";
				level_hi[lkey] := prefix + CStr(acct_name) + ":" + CStr(xp);
			endif

			var myhabs := GetObjProperty(p, "myhabs");
			if (myhabs != error && myhabs)
				foreach hk in (myhabs.keys())
					var aid := CStr(myhabs[hk]);
					if (aid != "" && aid != "0")
						var ac := ability_counts.Exists(aid) ? ability_counts[aid] : 0;
						ability_counts[aid] := ac + 1;
					endif
				endforeach
			endif

			// Replay this living character's chardata through the same
			// mapping the creation tracker uses, so the "Atual" pages mirror
			// the historical pages but for the current population only.
			var cd := GetObjProperty(p, "chardata");
			var pairs := CensusCreationPairs(cd);
			foreach pr in (pairs)
				if (!creation_counters.Exists(pr.cat))
					creation_counters[pr.cat] := dictionary;
				endif
				var bucket := creation_counters[pr.cat];
				var ckey := CensusNormalizeKey(pr.key);
				var bc := bucket.Exists(ckey) ? bucket[ckey] : 0;
				bucket[ckey] := bc + 1;
				creation_counters[pr.cat] := bucket;
			endforeach
			sleepms(2);
		endwhile
		sleepms(1);
	endforeach

	CensusSnapshot("current_abilities", ability_counts);
	CensusSnapshot("current_level", level_counts);
	CensusSnapshot("current_level_hi", level_hi);

	// Snapshot every dimension explicitly (not just the ones seen this run)
	// so a category that dropped to zero clears instead of showing stale
	// data from a previous run.
	var cur_dims := array{
		"creation_culture", "creation_classe", "creation_race",
		"creation_background", "creation_religion", "creation_path",
		"creation_trait", "creation_vocacao", "creation_subclasse",
		"creation_game_mode", "creation_magia",
		"skills_all", "skills_primary", "skills_secondary"
	};
	foreach cat in (cur_dims)
		var bucket := creation_counters.Exists(cat) ? creation_counters[cat] : dictionary;
		CensusSnapshot("cur_" + cat, bucket);
	endforeach

	var meta := dictionary;
	meta["generated_at"] := StrFormatTime("%d/%m/%Y %H:%M", POLCore().systime);
	meta["total_chars"] := CStr(total_chars);
	CensusSnapshot("current_meta", meta);

	SendSysMessage(who, "Censo atual: " + CStr(total_chars) + " personagens processados.");
endfunction
