/* 
 * Hotbar Execute Packet Handler
 * 
 * Handles 0xBF Extended Packet with subcommand 0x0099
 * Receives hotbar action execution requests from client
 * 
 * Packet Structure:
 *   Byte 0:    0xBF (Packet ID)
 *   Bytes 1-2: Packet Length (10 bytes)
 *   Bytes 3-4: Subcommand 0x0099
 *   Bytes 5-8: Action ID (uint, Big Endian)
 *   Byte 9:    Action Type (byte)
 * 
 * Action Types:
 *   0x01 = Postura
 *   0x02 = Habilidade
 *   0x03 = Special Ability
 *   0x04 = Spell
 *   0x05 = Command
 *   0x06 = Skill
 */

use uo;
use os;

include ":gumps:gumps";
include ":gumps:gumps_ex";

// Action type constants
const ACTION_TYPE_POSTURA := 0x01;
const ACTION_TYPE_HABILIDADE := 0x02;
const ACTION_TYPE_SPECIAL := 0x03;
const ACTION_TYPE_SPELL := 0x04;
const ACTION_TYPE_COMMAND := 0x05;
const ACTION_TYPE_SKILL := 0x06;

program hotbarExecute()
    Print("INSTALLING: Hotbar Execute PH (0xBF/0x0099)...");
    return 1;
endprogram

exported function HandleHotbarExecute(who, byref packet)
    // Parse packet (offsets assume SubCommandLength 2)
    var actionId := packet.GetInt32(5);   // Offset 5: 4-byte Action ID
    var actionType := packet.GetInt8(9);  // Offset 9: 1-byte Action Type
    
    // Debug logging
    Print($"[HOTBAR] Execute from {who.name}: ActionID={actionId}, Type={actionType}");
    
    // Dispatch based on action type
    case (actionType)
        ACTION_TYPE_POSTURA:
            return ExecutePostura(who, actionId);
        ACTION_TYPE_HABILIDADE:
            return ExecuteHabilidade(who, actionId);
        ACTION_TYPE_SPECIAL:
            return ExecuteSpecial(who, actionId);
        ACTION_TYPE_SPELL:
            return ExecuteSpell(who, actionId);
        ACTION_TYPE_COMMAND:
            return ExecuteCommand(who, actionId);
        ACTION_TYPE_SKILL:
            return ExecuteSkill(who, actionId);
        default:
            Print($"[HOTBAR] ERROR: Unknown action type {actionType}");
            SendSysMessage(who, "Erro: Tipo de ação desconhecido.");
            return 1;
    endcase
    
    return 1; // Consume packet
endfunction

// ============================================================================
// Action Handlers
// ============================================================================

function ExecutePostura(who, actionId)
    Print($"[HOTBAR] ExecutePostura: {who.name}, ID={actionId}");
    
    // Map actionId to postura type
    // 0 = Slash, 1 = Piercing, 2 = Blunt
    var posturaName;
    case (actionId)
        0: posturaName := "slash";
        1: posturaName := "piercing";
        2: posturaName := "blunt";
        default:
            SendSysMessage(who, "Erro: Postura inválida.");
            return 1;
    endcase
    
    // Execute postura change via existing system
    var script := Start_Script(":equipsys:golpe", {who, posturaName});
    if (!script)
        SendSysMessage(who, "Erro ao executar postura.");
        Print($"[HOTBAR] ERROR: Failed to start golpe script for {who.name}");
    endif
    
    return 1;
endfunction

function ExecuteHabilidade(who, actionId)
    Print($"[HOTBAR] ExecuteHabilidade: {who.name}, ID={actionId}");
    
    // TODO: Implement habilidade execution
    // This will integrate with existing habilidades system
    SendSysMessage(who, $"Executando habilidade {actionId}...");
    
    return 1;
endfunction

function ExecuteSpecial(who, actionId)
    Print($"[HOTBAR] ExecuteSpecial: {who.name}, ID={actionId}");
    
    // TODO: Implement special ability execution
    // This will integrate with existing special abilities system
    SendSysMessage(who, $"Executando especial {actionId}...");
    
    return 1;
endfunction

function ExecuteSpell(who, actionId)
    Print($"[HOTBAR] ExecuteSpell: {who.name}, ID={actionId}");
    
    // TODO: Implement spell execution
    // This will integrate with existing spell system
    SendSysMessage(who, $"Conjurando magia {actionId}...");
    
    return 1;
endfunction

function ExecuteCommand(who, actionId)
    Print($"[HOTBAR] ExecuteCommand: {who.name}, ID={actionId}");
    
    // TODO: Implement command execution
    // This will map actionId to specific commands (.voltar, .morrer, etc)
    SendSysMessage(who, $"Executando comando {actionId}...");
    
    return 1;
endfunction

function ExecuteSkill(who, actionId)
    Print($"[HOTBAR] ExecuteSkill: {who.name}, ID={actionId}");
    
    // Execute skill via existing system
    // actionId is the skill index
    var script := Start_Script(":skills:useSkill", {who, actionId});
    if (!script)
        SendSysMessage(who, "Erro ao usar skill.");
        Print($"[HOTBAR] ERROR: Failed to start useSkill script for {who.name}");
    endif
    
    return 1;
endfunction
