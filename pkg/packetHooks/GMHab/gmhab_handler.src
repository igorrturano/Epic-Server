// GMHab PacketHook Handler
// Handles incoming packet 0xD7 subcommand 0x50 (GMHab Request)

use uo;
use os;

include "gmhab_packets";

// Export GMHab Request handler (0xD7)
exported function HandleGMHabRequest(who, byref packet)
    return HandleGMHabPacket(who, packet);
endfunction

// Export Hotbar Execute handler (0xBF/0x0099)
exported function HandleHotbarExecute(who, byref packet)
    return HandleGMHabPacket(who, packet);
endfunction
