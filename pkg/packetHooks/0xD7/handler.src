use uo;

// Handler for 0xD7 packets from client
// These packets are sent when dragging GMHab abilities to the hotbar
// They are informational only and can be safely ignored
exported function Handle0xD7(who, byref packet)
    // Silently ignore 0xD7 packets from client
    // These are informational packets about GMHab abilities being added to hotbar
    return 1;
endfunction
