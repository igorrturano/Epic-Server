// ============================================================================
// Send Combat Hotkeys Packet (0x54) - Standalone sender script
// ============================================================================
// Spawned via Start_Script() to isolate data segment from main handler.
// Builds class-specific combat hotkeys (special ability + .golpe + .combate).
// ============================================================================

use uo;
use os;
use cfgfile;
use math;

include ":hotbar:include/shared_constants";
include ":hotbar:include/hotbar_write";
include ":hotbar:include/icon_manager";
include ":timedScripts:timedScripts";

program SendCombatHotkeys(who)
    var chardata := GetObjProperty(who, "chardata");
    if (!chardata)
        return 0;
    endif

    var combat_hotkeys := array{};
    var special_name := "";
    var special_class := "";
    var special_index := 0;

    case (chardata.classe)
        "Guerreiro":
            special_name := "Ataque Extra";
            special_class := "Guerreiro";
            special_index := 1;
        "Ladino":
            special_name := "Evasao";
            special_class := "Ladino";
            special_index := 2;
        "Sabio":
            if (chardata.wisdom_path == "Engenheiro")
                special_name := "Recarga Rapida";
                special_class := "Engenheiro";
                special_index := 3;
            elseif (chardata.magia == "arcane_archer")
                special_name := "Velocidade Arcana";
                special_class := "arcane_archer";
                special_index := 5;
            else
                special_name := "Conjuracao Rapida";
                special_class := "Conjurador";
                special_index := 4;
            endif
    endcase

    var level := CInt(GetObjProperty(who, "Level"));
    if (!level) level := 1; endif
    var final_cooldown := 180 - (Floor(level / 4) * 30);
    if (final_cooldown < 30) final_cooldown := 30; endif

    var remaining_cooldown := CInt(TS_GetCooldown(who, "special_ability"));
    if (!remaining_cooldown || remaining_cooldown < 0) remaining_cooldown := 0; endif

    if (special_name != "")
        var special_desc := "";
        case (special_index)
            1: special_desc := "Executa um ataque instantâneo adicional";
            2: special_desc := "Fica invisível por 0.5s e recua 4 tiles";
            3: special_desc := "Adiciona 1 bala instantaneamente na arma de fogo";
            4: special_desc := "Permite conjurar a próxima magia instantaneamente";
            5: special_desc := "Aumenta a velocidade de movimento por 4 segundos";
            default: special_desc := "Habilidade especial de " + special_class;
        endcase

        var icon_data := GetSpecialIcon(special_name);

        combat_hotkeys.append(struct{
            "name" := special_name,
            "classe" := special_class,
            "desc" := special_desc,
            "iconid" := icon_data.iconid,
            "hue" := icon_data.hue,
            "index" := special_index,
            "delay" := final_cooldown,
            "remaining" := remaining_cooldown
        });
    endif

    var golpe_icon := GetCommandIcon("golpe");
    if (!golpe_icon.errortext)
        combat_hotkeys.append(struct{
            "name" := ".golpe",
            "classe" := special_class,
            "desc" := "Golpe especial de arma",
            "iconid" := golpe_icon.iconid,
            "hue" := golpe_icon.hue,
            "index" := 10,
            "delay" := 0,
            "remaining" := 0
        });
    endif

    var combate_icon := GetCommandIcon("combate");
    if (!combate_icon.errortext)
        combat_hotkeys.append(struct{
            "name" := ".combate",
            "classe" := special_class,
            "desc" := "Mudar postura de combate",
            "iconid" := combate_icon.iconid,
            "hue" := combate_icon.hue,
            "index" := 11,
            "delay" := 0,
            "remaining" := 0
        });
    endif

    // Build packet
    var data_size := 0;
    foreach item in combat_hotkeys
        data_size := data_size + 2 + len(item.name);
        data_size := data_size + 2 + len(item.classe);
        data_size := data_size + 2 + len(item.desc);
        data_size := data_size + 2; // iconid
        data_size := data_size + 2; // hue
        data_size := data_size + 1; // index
        data_size := data_size + 2; // delay
        data_size := data_size + 2; // remaining
    endforeach

    // Header: PacketID(1) + Length(2) + Subcommand(2) + DataType(1) + Count(2)
    var packet_size := 8 + data_size;
    var packet := CreatePacket(PACKET_EXTENDED, packet_size);

    packet.SetInt8(0, PACKET_EXTENDED);
    packet.SetInt16(1, packet_size);
    packet.SetInt16(3, SUBCOMMAND_SPECIALS_RESPONSE);
    packet.SetInt8(5, ACTION_TYPE_SPECIAL);
    var offset := 6;

    offset := SetInt16BE(packet, offset, combat_hotkeys.size());

    foreach item in combat_hotkeys
        offset := WriteStringBE(packet, offset, item.name);
        offset := WriteStringBE(packet, offset, item.classe);
        offset := WriteStringBE(packet, offset, item.desc);
        offset := SetInt16BE(packet, offset, item.iconid);
        offset := SetInt16BE(packet, offset, item.hue);
        packet.SetInt8(offset, item.index); offset += 1;
        offset := SetInt16BE(packet, offset, CInt(item.delay));
        offset := SetInt16BE(packet, offset, CInt(item.remaining));
    endforeach

    packet.SendPacket(who);
    return 1;
endprogram
