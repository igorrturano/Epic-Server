////////////////////////////////////////////////////////////////////////////////////////////////////
//
//  name:    Send Stats Packet Hook
//  version: 1.1a
//  author:  MuadDib
//
//  Purpose:  This hooks the core 0x11 stats packet, and rewrites it for sending the char all the
//            extended stats for Age of Shadows like Pet Count, Min/Max Damage, statcap, etc. 2
//            Flags used per a CONST in order to decide which of the type to send.
//
//  Notes:    This is done only for example functionality. Pet Count, Damage Reports, etc is NOT
//            implemented into anything nor is the resists and luck. You can also change the global
//            var STATCAP to be a variable if required for special rising stat cap systems.
//
// CONST settings:
// BIT_MASK  = 0x00000003 DO NOT CHANGE!
//
// Global Variables:
// STATCAP = Set this to your shard's Stat Cap. If based on age, race, etc, just add a function
//           at the beginning of the exported function to check and set the statcap variable.
//
///////////////////////////////////////////////////////////////////////////////////////////////
use polsys;

include ":taming:taming";
include ":attributes:attributeConstants";
include ":attributes:attributes";
include "include/client";
include ":combat:Controller/DamageController_legacy";
include ":charactercreation:resists";
include ":xpbar_v2:xpbar";

program sendStats()
	Print("INSTALLING: Outgoing Status PH...");
	return 1;
endprogram

const BIT_MASK := 0x00000003;

var STATCAP := 225;
var MODE := 0;
var STATLOCK := 0;

const PLAYER_ID := 3;
const NAME_ID := 7;

exported function HandleSendStats(character, byref packet)
	var serial := packet.GetInt32(PLAYER_ID);
	var source := SystemFindObjectBySerial(serial);
	var Object_Name;
	var url;

	url := GetObjProperty(source, "url");
	if (!url || url.errortext)
		url := ""; // Set to empty string if property doesn't exist or has an error
	endif

	if (source.IsA(POLCLASS_MOBILE))
		// PREENCHE NOME DO MOBILE
		Object_Name := source.name;

		// Cor do nome dos NPC conforme skill de combate
		if (!source.npctemplate)
			// Caso em que tá desconhecido
			if (GetObjProperty(source, "realname"))
				Object_Name := "Incognito";
			else
				// Verifica se o char já foi reconhecido por who
				var conhecidos := dictionary;
				if (GetObjProperty(character, "conhecidos"))
					var ID := Cstr(source.serial); // Salva o serial do personagem
					if (GetObjProperty(source, "disfarce"))
						ID := Cstr(GetObjProperty(source, "FakeID")); // Substitui o serial pelo falso quando o personagem observado está disfarçado
					endif

					conhecidos := GetObjProperty(character, "conhecidos"); // Lista de pessoas conhecidadas
					if (conhecidos.Exists(ID))
						Object_Name := conhecidos[ID];
					else
						Object_Name := source.name;
					endif
				else
					Object_Name := source.name;
				endif
			endif
			if (character.cmdlevel > 1) // Staff consegue ver mais
				var nome_inicial := GetObjProperty(source, "nome_inicial");
				if (nome_inicial && !nome_inicial.errortext)
					Object_Name := Object_Name + " [" + nome_inicial + "]";
				endif
			endif
			packet.SetString(NAME_ID, Object_Name, 1);
		endif

		// Envia a url do portrait junto com o status
		packet.SetString(121, url, 1);

		// XP System V2 - Apenas envia XP via TithingPoints se o packet tiver tamanho suficiente
		// O POL core envia o packet com type=4 ou superior para players, 
		// então TithingPoints já existe no offset 87
		if (!source.npctemplate && packet.GetSize() >= 91)
			var packed_xp := PackXPForClient(source);
			packet.SetInt32(87, packed_xp);
		endif
	endif

	return 0;
endfunction

function HandleExtended(character, byref packet)
	// Increase packet size for the extended info
	packet.SetSize(packet.GetSize() + 66); // Increase size to accommodate all stats

	// Set packet mode to 6 (UOKR Extended Info) for most complete data
	packet.SetInt8(42, 6);

	// ============================================================
	// PACKET 0x11 STRUCTURE FOR TYPE=6 (UOKR Extended)
	// Based on ClassicUO sequential reading order:
	// ============================================================
	// Offset 0:   PacketID (1 byte)
	// Offset 1:   Length (2 bytes)
	// Offset 3:   Serial (4 bytes)
	// Offset 7:   Name (30 bytes)
	// Offset 37:  Hits (2 bytes)
	// Offset 39:  HitsMax (2 bytes)
	// Offset 41:  IsRenamable (1 byte)
	// Offset 42:  Type (1 byte) = 6
	// Offset 43:  IsFemale (1 byte)
	// Offset 44:  Str (2 bytes)
	// Offset 46:  Dex (2 bytes)
	// Offset 48:  Int (2 bytes)
	// Offset 50:  Stamina (2 bytes)
	// Offset 52:  StaminaMax (2 bytes)
	// Offset 54:  Mana (2 bytes)
	// Offset 56:  ManaMax (2 bytes)
	// Offset 58:  Gold (4 bytes)
	// Offset 62:  PhysicalResist (2 bytes)
	// Offset 64:  Weight (2 bytes)
	// --- type >= 5 (ML) ---
	// Offset 66:  WeightMax (2 bytes)
	// Offset 68:  Race (1 byte)
	// --- type >= 3 (Renaissance) ---
	// Offset 69:  StatsCap (2 bytes)
	// Offset 71:  Followers (1 byte)
	// Offset 72:  FollowersMax (1 byte)
	// --- type >= 4 (AOS) ---
	// Offset 73:  FireResist (2 bytes)
	// Offset 75:  ColdResist (2 bytes)
	// Offset 77:  PoisonResist (2 bytes)
	// Offset 79:  EnergyResist (2 bytes)
	// Offset 81:  Luck (2 bytes)
	// Offset 83:  DamageMin (2 bytes)
	// Offset 85:  DamageMax (2 bytes)
	// Offset 87:  TithingPoints (4 bytes) <-- XP goes here!
	// --- type >= 6 ---
	// Offset 91+: Extended stats...
	// ============================================================

	// Get pet data
	var petcnt := GetNumPets(character);
	if (!petcnt)
		petcnt := 0;
	endif

	var petmax := GetMaxPets(character);
	if (!petmax)
		petmax := 1;
	endif

	// --- Type >= 5 (ML) ---
	// WeightMax is at offset 66, but POL core may set it, so skip
	// Race is at offset 68 - POL core sets this
	
	// --- Type >= 3 (Renaissance) ---
	// StatsCap at offset 69
	packet.SetInt16(69, STATCAP);
	// Followers at offset 71
	packet.SetInt8(71, petcnt);
	// FollowersMax at offset 72
	packet.SetInt8(72, petmax);

	// --- Type >= 4 (AOS) ---
	// Get defense/resistances
	var defense := character.getMobileDefenses();
	
	// FireResist at offset 73
	packet.SetInt16(73, CInt(character.resist_fire));
	// ColdResist at offset 75
	packet.SetInt16(75, CInt(character.resist_cold));
	// PoisonResist at offset 77
	packet.SetInt16(77, CInt(character.resist_poison));
	// EnergyResist at offset 79
	packet.SetInt16(79, CInt(character.resist_energy));
	// Luck at offset 81
	packet.SetInt16(81, 0);

	// DamageMin/Max
	var min_dmg := 0, max_dmg := 0;
	if (character.weapon)
		var atrib := GetObjProperty(character.weapon, "atributos");
		if (atrib)
			min_dmg := CInt(atrib.SlashMainDamage + atrib.PiercingMainDamage + atrib.BluntMainDamage);
			max_dmg := min_dmg + 5;
		endif
	endif
	
	// DamageMin at offset 83
	packet.SetInt16(83, min_dmg);
	// DamageMax at offset 85
	packet.SetInt16(85, max_dmg);

	// XP System V2 - TithingPoints at offset 87
	var packed_xp := PackXPForClient(character);
	packet.SetInt32(87, packed_xp);

	// --- Type >= 6 (Extended stats start at offset 91) ---
	// Get custom properties
	var fortitude := GetResist(character, FORTITUDE);
	if (!fortitude) fortitude := 0; endif

	var reflexos := GetResist(character, REFLEXOS);
	if (!reflexos) reflexos := 0; endif

	var vontade := GetResist(character, VONTADE);
	if (!vontade) vontade := 0; endif

	var dps_max := AP_GetVitalMaximumValue(character, "DP");
	var hunger := GetObjProperty(character, "hunger");
	if (!hunger) hunger := 0; endif
	var vicio := GetObjProperty(character, "vicio");
	if (!vicio) vicio := 0; endif

	var resist_slash := GetObjProperty(character, "resist_slash");
	if (!resist_slash) resist_slash := 0; endif
	var resist_pierce := GetObjProperty(character, "resist_pierce");
	if (!resist_pierce) resist_pierce := 0; endif
	var resist_blunt := GetObjProperty(character, "resist_blunt");
	if (!resist_blunt) resist_blunt := 0; endif

	// Extended stats at offset 91+
	// MaxPhysicRes at offset 91
	packet.SetInt16(91, CInt(defense));
	// MaxFireRes at offset 93
	packet.SetInt16(93, fortitude);
	// MaxColdRes at offset 95
	packet.SetInt16(95, reflexos);
	// MaxPoisonRes at offset 97
	packet.SetInt16(97, vontade);
	// MaxEnergyRes at offset 99
	packet.SetInt16(99, hunger);
	// DefenseChanceIncrease at offset 101
	packet.SetInt16(101, vicio);
	// MaxDefenseChanceIncrease at offset 103
	packet.SetInt16(103, dps_max);
	// HitChanceIncrease at offset 105
	packet.SetInt16(105, resist_slash);
	// SwingSpeedIncrease at offset 107
	packet.SetInt16(107, resist_pierce);
	// DamageIncrease at offset 109
	packet.SetInt16(109, resist_blunt);

	return 1;
endfunction
