////////////////////////////////////////////////////////////////////////////////////////////////////
//
//  name:    Send Stats Packet Hook
//  version: 1.1a
//  author:  MuadDib
//
//  Purpose:  This hooks the core 0x11 stats packet, and rewrites it for sending the char all the
//            extended stats for Age of Shadows like Pet Count, Min/Max Damage, statcap, etc. 2
//            Flags used per a CONST in order to decide which of the type to send.
//
//  Notes:    This is done only for example functionality. Pet Count, Damage Reports, etc is NOT
//            implemented into anything nor is the resists and luck. You can also change the global
//            var STATCAP to be a variable if required for special rising stat cap systems.
//
// CONST settings:
// BIT_MASK  = 0x00000003 DO NOT CHANGE!
//
// Global Variables:
// STATCAP = Set this to your shard's Stat Cap. If based on age, race, etc, just add a function
//           at the beginning of the exported function to check and set the statcap variable.
//
///////////////////////////////////////////////////////////////////////////////////////////////
use polsys;


include "include/client";
include ":wrappers:Objects/Model/MobileWrapper";
include ":wrappers:Objects/Model/ArmorWrapper";
include ":wrappers:Objects/Model/WeaponWrapper";
include ":combat:Controller/DamageController";
include ":combat:Model/AttackInfo";
include "include/math";
include ":expbar:expbar";

program sendStats()
	Print("INSTALLING: Outgoing Status PH...");
	return 1;
endprogram

const BIT_MASK := 0x00000003;

var STATCAP := 225;
var MODE := 0;
var STATLOCK := 0;
var ARMOR_RESISTENCE_PACKET_ARRAY := array{LAYER_SHOES,LAYER_HELM,LAYER_GLOVES,LAYER_NECK,LAYER_CHEST,LAYER_ARMS,LAYER_PANTS};

const QTD_RESISTENCIAS := 7;
const CHARACTER_STATUS_PACKET_ID := 0x11;
const OLD_INDEX_IS_RENAMABLE := 41;

enum class OLD_STATUS_OFFSETS
	SOURCE_SERIAL := 3,
	NAME := 7,
	HITS := 37,
	HITS_MAX := 39,
	IS_RENAMABLE := 41,
	IS_FEMALE := 43,
	STRENGTH := 44,
	DEXTERITY := 46,
	INTELLIGENCE := 48,
	STAMINA := 50,
	STAMINA_MAX := 52,
	MANA := 54,
	MANA_MAX := 56,
	WEIGHT := 64,
	WEIGHT_MAX := 66,
	RACE := 68,
	FOLLOWERS := 71,
	FOLLOWERS_MAX := 72,
	MIN_DAMAGE :=  83,
	MAX_DAMAGE :=  85
endenum

enum class NEW_STATUS_OFFSETS
	SOURCE_SERIAL := 3,
	NAME := 7,
	HITS := 37,
	HITS_MAX := 39,
	IS_RENAMABLE := 41,
	//IS_FEMALE := 42,
	STRENGTH := 42,
	DEXTERITY := 44,
	INTELLIGENCE := 46,
	STAMINA := 48,
	STAMINA_MAX := 50,
	MANA := 52,
	MANA_MAX := 54,
	WEIGHT := 56,
	WEIGHT_MAX := 58,
	//RACE := 61,
	FOLLOWERS := 60,
	FOLLOWERS_MAX := 61,
	MIN_DAMAGE :=  62,
	MAX_DAMAGE :=  64,
	MIN_DAMAGE_OFFH := 66,
	MAX_DAMAGE_OFFH := 68,
	FORTITUDE := 70,
	REFLEXES := 71,
	WILL := 72,
	DEATH_POINTS := 73,
	DEATH_POINTS_MAX := 75,
	ADDICTION := 77,
	HUNGER := 79,
	XP_CURRENT := 80,
	XP_NEXT := 84,
	LEVEL := 80,
	GOLD := 81,
	AMOR_RESISTANCES_START := 85,
	MOBILE_LAST_INDEX := 42,
	//PICTURE_URL := 121,
endenum


exported function HandleSendStats(character, byref packet)
	var pacoteFinal := CreatePacket(CHARACTER_STATUS_PACKET_ID, MSGLEN_VARIABLE);
	var serial :=  packet.GetInt32(OLD_STATUS_OFFSETS::SOURCE_SERIAL);
	
	var source := SystemFindObjectBySerial(serial);
	var mobileEnvelopado := MobileWrapper(source);
	
	var url;
	
	url := GetObjProperty(source, "url");
	if (!url || url.errortext)
		url := ""; // Set to empty string if property doesn't exist or has an error
	endif

	pacoteFinal.SetInt32(NEW_STATUS_OFFSETS::SOURCE_SERIAL, serial);

	if (source.IsA(POLCLASS_MOBILE))
		pacoteFinal.SetString(NEW_STATUS_OFFSETS::NAME, TrataNomeMobile(character, source), 1);
		pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::HITS, packet.GetInt16(OLD_STATUS_OFFSETS::HITS));
		pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::HITS_MAX, packet.GetInt16(OLD_STATUS_OFFSETS::HITS_MAX));
		pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::IS_RENAMABLE, packet.GetInt8(OLD_STATUS_OFFSETS::IS_RENAMABLE));

		if(character.serial == serial)
			var weapon := GetEquipmentByLayer(character,LAYER_HAND2);
			var envelopeArma := WeaponWrapper(weapon);
			var attackInfo := AttackInfo(mobileEnvelopado, 0);
			var dps_current := Trunc(mobileEnvelopado.GetCurrentDp(),2);
			var levelAtual := CInt(GetObjProperty(character, "Level")) ? CInt(GetObjProperty(character, "Level")) : 0;
			var xpAtual := CalculateNextLevelXP(levelAtual - 1);
			var xpProximoLevel := CalculateNextLevelXP(levelAtual);
			var damageStruct := CalculateEstimatedMinMaxDamage(attackInfo);
			

			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::STRENGTH, packet.GetInt16(OLD_STATUS_OFFSETS::STRENGTH));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::DEXTERITY, packet.GetInt16(OLD_STATUS_OFFSETS::DEXTERITY));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::INTELLIGENCE, packet.GetInt16(OLD_STATUS_OFFSETS::INTELLIGENCE));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::STAMINA, packet.GetInt16(OLD_STATUS_OFFSETS::STAMINA));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::STAMINA_MAX, packet.GetInt16(OLD_STATUS_OFFSETS::STAMINA_MAX));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MANA, packet.GetInt16(OLD_STATUS_OFFSETS::MANA));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MANA_MAX, packet.GetInt16(OLD_STATUS_OFFSETS::MANA_MAX));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::WEIGHT, packet.GetInt16(OLD_STATUS_OFFSETS::WEIGHT));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::WEIGHT_MAX, packet.GetInt16(OLD_STATUS_OFFSETS::WEIGHT_MAX));
			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::FOLLOWERS, packet.GetInt8(OLD_STATUS_OFFSETS::FOLLOWERS));
			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::FOLLOWERS_MAX, packet.GetInt8(OLD_STATUS_OFFSETS::FOLLOWERS_MAX));

	
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MIN_DAMAGE, cint(damageStruct.minMain));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MAX_DAMAGE, cint(damageStruct.maxMain));

			//TODO Inserir dano da offhand uma vez que o combat esteja terminado.
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MIN_DAMAGE_OFFH, cint(damageStruct.minOff));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::MAX_DAMAGE_OFFH,  cint(damageStruct.maxOff));

			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::FORTITUDE, cint(mobileEnvelopado.GetFortitude()));
			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::REFLEXES,  cint(mobileEnvelopado.GetReflexes()));
			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::WILL,  cint(mobileEnvelopado.GetWill()));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::DEATH_POINTS,  cint(mobileEnvelopado.GetCurrentDp()));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::DEATH_POINTS_MAX,  cint(mobileEnvelopado.GetMaxDp()));
			pacoteFinal.SetInt16(NEW_STATUS_OFFSETS::ADDICTION,  cint(GetObjProperty(character, "vicio")));
			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::HUNGER,  CInt( mobileEnvelopado.GetCurrentHunger() / 60));

			pacoteFinal.SetInt8(NEW_STATUS_OFFSETS::LEVEL,  levelAtual);
			pacoteFinal.SetInt32(NEW_STATUS_OFFSETS::GOLD, mobileEnvelopado.GetGold());

			foreach camadaArmadura in ARMOR_RESISTENCE_PACKET_ARRAY
				Sleepms(2);
				var itemEquipado := GetEquipmentByLayer(character,camadaArmadura);
				var envelopeArmadura := ArmorWrapper(itemEquipado); 
				var resistencias := envelopeArmadura.GetResists();
				var indiceLote := (_camadaArmadura_iter - 1) * QTD_RESISTENCIAS;
				var indiceInicial := NEW_STATUS_OFFSETS::AMOR_RESISTANCES_START;
				
				pacoteFinal.SetInt8(indiceInicial + indiceLote,resistencias.GetSlashResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 1,resistencias.GetPiercingResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 2,resistencias.GetBluntResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 3,resistencias.GetFireResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 4,resistencias.GetColdResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 5,resistencias.GetPoisonResist());
				pacoteFinal.SetInt8(indiceInicial + indiceLote + 6,resistencias.GetEnergyResist());
			endforeach

			pacoteFinal.SetString(
						NEW_STATUS_OFFSETS::AMOR_RESISTANCES_START + ARMOR_RESISTENCE_PACKET_ARRAY.size() * QTD_RESISTENCIAS, 
						url, 
						1);
		else
			pacoteFinal.SetString(
							NEW_STATUS_OFFSETS::MOBILE_LAST_INDEX, 
							url, 
							1);
		endif

	endif

	packet.SetSize(pacoteFinal.GetSize());
	packet.Assign(pacoteFinal);
	return 0;
endfunction

function TrataNomeMobile(character, source)
	if(!source.npctemplate)
		var nomeJogador;

		if (GetObjProperty(source, "realname"))
					nomeJogador := "Incognito";
		else
			// Verifica se o char já foi reconhecido por who
			var conhecidos := dictionary;
			if (GetObjProperty(character, "conhecidos"))
				var ID := Cstr(source.serial); // Salva o serial do personagem
				if (GetObjProperty(source, "disfarce"))
					ID := Cstr(GetObjProperty(source, "FakeID")); // Substitui o serial pelo falso quando o personagem observado está disfarçado
				endif

				conhecidos := GetObjProperty(character, "conhecidos"); // Lista de pessoas conhecidadas
				if (conhecidos.Exists(ID))
					nomeJogador := conhecidos[ID];
				else
					nomeJogador := source.name;
				endif
			else
				nomeJogador := source.name;
			endif
		endif

		if (character.cmdlevel > 1) // Staff consegue ver mais
			var nome_inicial := GetObjProperty(source, "nome_inicial");
			if (nome_inicial && !nome_inicial.errortext)
				nomeJogador := nomeJogador + " [" + nome_inicial + "]";
			endif
		endif

		return nomeJogador;
	else
		return source.name;
	endif
endfunction
