program speech_hooks()
	Print("Hooking Unicode Outgoing...");
	return 1;
endprogram

enum class PACKET_POSITION
	SERIAL := 3, // Quem enviou a mensagem
	MODEL := 7, // Não sei para o que serve
	TYPE := 9, // Tipo da mensagem
	COLOR := 10, // Cor da mensagem
	FONT := 12, // Fonte da mensagem
	LANGUAGE := 14, // Lingua da mensagem
	NAME_ID := 18, // Nome de quem fala
	MESSAGE := 48 // Mensagem
endenum

enum class MESSAGE_DISTANCE
	WHISPER := 2,
	NORMAL := 8,
	YELL := 12
endenum

exported function handleUCOutgoing(character, byref packet)
	var messageData := GetPacketData(packet);
	messageData.+target := MobileWrapper(character);

	LogPlayerSpeech(messageData.source.GetObjRef(), messageData.message);

	// TODO: Remover o block depois de implementar cada um dos tipos
		// Bloqueei pra a gente pode entender a necessidade de cada
	var blockPorEnquanto := array{
		MESSAGE_TYPE::ALLIANCE,
		MESSAGE_TYPE::GUILD,
		MESSAGE_TYPE::COMMAND_PROMPTS
	};

	if (messageData.type in blockPorEnquanto)
		return 1;
	endif

	if (!CanSpeak(messageData))
		return 1;
	endif

	if (!CanHear(messageData))
		return 1;
	endif

	if (!CanUnderstand(messageData))
		PrintTextAbovePrivate(messageData.source, "*Incompreensível*", messageData.target);
		return 1;
	endif

	CheckSourceName(messageData);
	CheckLanguagePrefix(messageData);
	ReassemblePacket(packet, messageData);
	
	return 0;
endfunction

function CanSpeak(byRef messageData)
	if (messageData.source.GetProperty("metamorfose") && !messageData.source.HasAbility("Elo Natural"))
		if (messageData.type == MESSAGE_TYPE::NORMAL)
			return false;
		endif
	endif

	if (messageData.source.GetProperty("mudo"))
		return false;
	endif

	if (messageData.source.GetProperty("#sleep"))
		return false;
	endif

	return true;
endfunction

function CanHear(byRef messageData)
	var rangeMod := CheckLineOfSight(messageData.source, messageData.target) ? 1 : 2;
	
	if (messageData.type == MESSAGE_TYPE::WHISPER)
		if (Distance(messageData.source, messageData.target) > MESSAGE_DISTANCE::WHISPER / rangeMod)
			return false;
		endif
	elseif (messageData.type == MESSAGE_TYPE::YELL)
		if (messageData.source.HasAbility("Mestre Espiao"))
			if (Distance(messageData.source, messageData.target) > (MESSAGE_DISTANCE::YELL + 4) / rangeMod)
				return false;				
			elseif (Abs(messageData.source.z - messageData.target.z) >= (MESSAGE_DISTANCE::YELL + 4) / rangeMod)
				return false;
			endif
		else
			if (Distance(messageData.source, messageData.target) > MESSAGE_DISTANCE::YELL / rangeMod)
				return false;
			elseif (Abs(messageData.source.z - messageData.target.z) >= MESSAGE_DISTANCE::YELL / rangeMod)
				return false;
			endif
		endif
	elseif (messageData.type == MESSAGE_TYPE::NORMAL)
		if (Distance(messageData.source, messageData.target) > MESSAGE_DISTANCE::NORMAL / rangeMod)
			return false;
		endif
	endif

	return true;
endfunction

function CheckSourceName(byRef messageData)
	var sourceSerial := CStr(messageData.source.GetSerial());
	var targetKnownNames := messageData.target.GetProperty("conhecidos");

	var name := targetKnownNames[sourceSerial];
	if (name)
		messageData.sourceName := name;
	endif
endfunction

function _debugMe(byRef packet)
	var data := GetPacketData(packet);

	if (data.type == MESSAGE_TYPE::NORMAL)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um say: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::BROADCAST)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um broadcast: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::EMOTE)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um emote: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::SYSTEM)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um system: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::MESSAGE_CORNER)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um message corner: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::WHISPER)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um whisper: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::YELL)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um yell: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::SPELL)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um spell: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::GUILD)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um guild: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::ALLIANCE)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um alliance: " + data.message, 1);
	elseif (data.type == MESSAGE_TYPE::COMMAND_PROMPTS)
		packet.SetUnicodeString(PACKET_POSITION::MESSAGE, "Sou um command prompts: " + data.message, 1);
	endif
endfunction

function GetPacketData(packet)
	var serial := packet.GetInt32(PACKET_POSITION::SERIAL);
	var model := packet.GetInt16(PACKET_POSITION::MODEL);
	var source := CreateObjectWrapper(SystemFindObjectBySerial(serial));
	var type := packet.GetInt8(PACKET_POSITION::TYPE);
	var color := packet.GetInt16(PACKET_POSITION::COLOR);
	var font := packet.GetInt16(PACKET_POSITION::FONT);
	var language := packet.GetString(PACKET_POSITION::LANGUAGE, 4);
	var sourceName := packet.GetString(PACKET_POSITION::NAME_ID, 30);
	var message_length := (packet.GetInt16(1) - 49) / 2;
	var message := packet.GetUnicodeString(PACKET_POSITION::MESSAGE, message_length);

	return struct{
		source := source,
		model := model,
		type := type,
		color := color,
		font := font,
		language := language,
		sourceName := sourceName,
		message := message
	};
endfunction

function CreateObjectWrapper(obj)
	if (obj.IsA(POLCLASS_MOBILE))
		return MobileWrapper(obj);
	elseif (obj.IsA(POLCLASS_CONTAINER))
		return ContainerWrapper(obj);
	elseif (obj.IsA(POLCLASS_ARMOR))
		return ArmorWrapper(obj);
	elseif (obj.IsA(POLCLASS_WEAPON))
		return WeaponWrapper(obj);
	elseif (obj.IsA(POLCLASS_ITEM))
		return ItemWrapper(obj);
	endif
endfunction

function ReassemblePacket(byRef packet, byRef messageData);
	packet.SetInt32(PACKET_POSITION::SERIAL, messageData.source.serial);
	packet.SetInt16(PACKET_POSITION::MODEL, messageData.model);
	packet.SetInt8(PACKET_POSITION::TYPE, messageData.type);
	packet.SetInt16(PACKET_POSITION::COLOR, messageData.color);
	packet.SetInt16(PACKET_POSITION::FONT, messageData.font);
	packet.SetString(PACKET_POSITION::LANGUAGE, messageData.language, 0);
	packet.SetString(PACKET_POSITION::NAME_ID, messageData.source.name, 0);
	packet.SetUnicodeString(PACKET_POSITION::MESSAGE, messageData.message, 1);
	
	_debugMe(packet);
	return 0;
endfunction

function MustContinue(data)
	var typesToIgnore := array{
		MESSAGE_TYPE::BROADCAST
	};
	
	if (data.type in typesToIgnore)
		return false; // Mensagens que não precisam de tratamento, apenas de tradução (se o receptor quiser)
	endif

	return true;
endfunction

function CheckLanguagePrefix(byRef messageData)
	var typesToPrefix := array{MESSAGE_TYPE::NORMAL, MESSAGE_TYPE::WHISPER, MESSAGE_TYPE::YELL};

	if (messageData.type in typesToPrefix)
		var chosen_language := messageData.target.GetProperty("lingua_escolhida");
		if (chosen_language && chosen_language != "Comum")
			messageData.message := $"[{chosen_language}] " + messageData.message;
		endif
	endif
endfunction

function CanUnderstand(byRef messageData)
	if (messageData.target.GetProperty("cmdlevel") >= 1)
		return true;
	endif

	if (messageData.source == messageData.target)
		return true;
	endif

	if (messageData.source.GetProperty("ghostvoice"))
		return handleGhostVoice(messageData.source, messageData.message, messageData.packet);
	endif

	if (!messageData.source.IsNPC())
		var sourceLanguage := messageData.source.GetProperty("lingua_escolhida");
		var targetKnownLanguages := messageData.target.GetProperty("linguas_conhecidas");

		if (sourceLanguage in targetKnownLanguages)
			return true;
		endif
	endif

	return false;
endfunction

