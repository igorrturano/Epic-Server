////////////////////////////////////////////////////////////////////////////////////////////////////
//
//  name:    Request Attack Packet Hook
//  version: 1.0
//  author:  MuadDib
//
//  Purpose: This hook will allow you to check LOS, Distance, or whatever you wish, when someone
// 		DoubleClicks another mob while in war mode.
//
// Const settings:
// BYTE_DEFENDER = 1  Position in the packet for the Defender's Serial.
//
////////////////////////////////////////////////////////////////////////////////////////////////////
use uo;
use polsys;

include "include/say";
include "include/epicLoggerUtils";
include ":mastery:Abilities";
include ":mastery:controllers/AbilityController";
include ":wrappers:Objects/Model/MobileWrapper";
include ":combat:Model/AttackInfo";
include ":message:model/Message";
include ":faccao:imperium";
include ":merchants:citizen/include/citizenWitness";

const BYTE_DEFENDER := 1;

program requestAttack()
	Print("INSTALLING: Request Attack PH...");
	return 1;
endprogram

exported function HandleAttackRequest(who, byref packet)
	var defender := SystemFindObjectBySerial(packet.GetInt32(BYTE_DEFENDER));

	if (GetObjProperty(defender, "#sanctuary"))
		Message("Esse alvo esta sob um santuario divino.", Color(SYSTEM_COLOR::BAD)).SendSys(who);
		return 1;
	endif

	// if (InValtheris(who) && HasPraetors())
	// 	Start_Script(":faccao:praetorAlert", array{ who });
	// endif

	if (defender.npctemplate && !who.npctemplate) // se o target for npc e quem clicou for player (sempre eh)
		if (who.weapon.attribute == "Ranged")
			if (Distance(who, defender) > 18)
				Message("Você está muito distante.", Color(SYSTEM_COLOR::BAD)).SendSys(who);
				return 1;
			endif
		else
			if (Distance(who, defender) > 6)
				Message("Você está muito distante.", Color(SYSTEM_COLOR::BAD)).SendSys(who);
				return 1;
			endif

		endif
	endif

	if (!CheckLineOfSight(who, defender))
		Message("Você não enxerga esse inimigo para ameaçá-lo.", Color(SYSTEM_COLOR::BAD)).SendSys(who);
		return 1;
	endif

	LogAttackRequest(who, defender);

	if (_IsAttackACitizenCrime(who, defender))
		NotifyCitizenWitnesses(who, "attack", struct{
			"defenderSerial" := defender.serial,
			"defenderName" := defender.name
		});
	endif

	ExecuteMasteryAbility(AttackInfo(MobileWrapper(who), MobileWrapper(defender), ATTACK_MOMENT::ENGAGING));

	return 0;
endfunction

function _IsAttackACitizenCrime(attacker, defender)
	var attacker_is_player := !attacker.npctemplate;
	var defender_is_player := !defender.npctemplate;

	// Player vs Player
	if (attacker_is_player && defender_is_player)
		return 1;
	endif

	// Anything attacking a citizen NPC
	if (defender.npctemplate == ":merchants:citizen")
		return 1;
	endif

	// Player attacking a non-red NPC, or any pet
	if (attacker_is_player && defender.npctemplate)
		if (defender.alignment != 1)
			return 1;
		endif
		if (defender.ownerserial)
			return 1;
		endif
	endif

	return 0;
endfunction
