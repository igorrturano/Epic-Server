
use uo;
use os;
use util;
include "include/facings";
include ":mobileRescale:include/packetUtils";
include ":charactercreation:include/packetUtils";

program Install()

	return 1;

endprogram

exported function UpdateObject(who, byref packet)
	var object := SystemFindObjectBySerial(packet.GetInt32(3));

	AppendScaleProp2Packet(object, packet);
	AppendRacialTraits2Packet(object, packet);
	
	return 0;

endfunction
