// Hotbar PacketHook Handler
// Handles incoming packet 0xD7 subcommand 0x50 (Hotbar Request)

use uo;
use os;

include "hotbar_packets";

// Export Hotbar Request handler (0xD7)
exported function HandleHotbarRequest(who, byref packet)
    return HandleHotbarPacket(who, packet);
endfunction

// Export Hotbar Execute handler (0xBF/0x0099)
exported function HandleHotbarExecute(who, byref packet)
    return HandleHotbarPacket(who, packet);
endfunction
