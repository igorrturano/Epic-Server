use uo;
use os;
use polsys;
use util;
use unicode;
include "include/say";

program partymessage()
	Print("INSTALLING: partymessage...");
	return 1;
endprogram

exported function PartyMessageSpy(who, byref packet)

	var partyAction := packet.GetInt8(5);
	var messageOffset;

	if (partyAction == 0x04)         // Tell Whole Party
		messageOffset := 6;
	elseif (partyAction == 0x03)     // Tell Party Member (private)
		messageOffset := 10;          // skip 4-byte target serial
	else
		return 0;                     // not a chat sub-action
	endif

	var message_txt := packet.GetUnicodeString(messageOffset, (packet.GetInt16(1) - messageOffset - 2) / 2);

	if (!message_txt)
		return 0;
	endif

	foreach player in GetGlobalProperty("GmsOnlines")

		player := SystemFindObjectBySerial(Cint(player));
		if (GetObjProperty(player, "PartySpyOn") && player.cmdlevel >= 3 && player != who)
			var acct := who.acctname;
			var truename := GetObjProperty(who, "nome_inicial");
			var leader := who.party.leader.name;

			if (GetObjProperty(player, "PartySpyOn") == "on")
				leader := splitwords(leader);
				leader := leader[1];
				SendSysMessage(player, "[Party-" + leader + "][" + acct + "] " + truename + ": " + message_txt, _DEFAULT_TEXT_FONT,
								0x003e);
			elseif (GetObjProperty(player, "PartySpyOn") == leader)
				SendSysMessage(player, "[PT-SPY][" + acct + "] " + truename + ": " + message_txt, _DEFAULT_TEXT_FONT, 0x003e);
			endif

		endif
		Sleepms(2);
	endforeach

	return 0;
endfunction
