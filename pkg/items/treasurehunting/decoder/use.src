function CreateTreasureMap(who, oldmap, maplevel)
	var map := CreateItemInBackpack(who, GetObjtypeByName("map_nonedit"), 1);

	/* if (TemHabilidade(who, "Tesouro Escondido"))
		SetObjProperty(map, "tesouroescondido", 1);
	endif
*/
	SetObjProperty(map, "level", maplevel);
	SetObjProperty(map, "decoder", who.serial);
	// map.name := "Mapa do tesouro [Coordenadas: " + coordenada + "] [desvendado por " + who.name + "]";
	SetTreasureCoords(map, maplevel);
	SendSysMessage(who, "Voce desvendou o mapa!");
	DestroyItem(oldmap);
endfunction

function SetTreasureCoords(map, maplevel)
	// Read zones from treasure.cfg
	var cfgfile := ReadConfigFile("treasure");

	// Build list of zones matching the map level
	var valid_zones := array{};
	foreach zonekey in GetConfigStringKeys(cfgfile)
		var elem := FindConfigElem(cfgfile, zonekey);
		var zone_level := GetConfigInt(elem, "Level");
		if (zone_level == maplevel)
			valid_zones.append(elem);
		endif
	endforeach

	if (!valid_zones.size())
		// Fallback: no zones for this level, use default coordinates
		var x := 1200;
		var y := 1000;
		var z := 0;
		var realm := "britannia_alt";
		SetObjProperty(map, "chestx", x);
		SetObjProperty(map, "chesty", y);
		SetObjProperty(map, "chestz", z);
		map.realm := realm;
		return;
	endif

	// Pick a random zone from the list
	var zone := valid_zones[RandomInt(valid_zones.size()) + 1];

	// Read zone bounds
	var minX := GetConfigInt(zone, "MinX");
	var maxX := GetConfigInt(zone, "MaxX");
	var minY := GetConfigInt(zone, "MinY");
	var maxY := GetConfigInt(zone, "MaxY");

	var realm := GetConfigString(zone, "Realm");
	if (!realm)
		realm := "britannia";
	endif

	// Generate random coordinates within zone bounds
	var x := RandomInt(maxX - minX + 1) + minX;
	var y := RandomInt(maxY - minY + 1) + minY;

	// Get valid Z coordinate for the location
	var z := GetMapInfo(x, y, realm).z;
	if (!z)
		z := 0; // Fallback to ground level
	endif

	SetObjProperty(map, "chestx", x);
	SetObjProperty(map, "chesty", y);
	SetObjProperty(map, "chestz", z);
	map.realm := realm;
	// SetName( map, "a treasure map" );
	var chstx := GetObjProperty(map, "chestx");
	var chsty := GetObjProperty(map, "chesty");
	var coordenada := ToSextant(chstx, chsty);
	SetName(map, "Mapa do tesouro [Coordenadas: " + coordenada + "]");

	if( x < 75 )
		map.xwest := 0;
	else
		map.xwest := x-75;
	endif
	if( y < 75 )
		map.ynorth := 0;
	else
		map.ynorth := y-75;
	endif
	map.xeast := x+75;
	map.ysouth := y+75;
	map.gumpwidth := 200;
	map.gumpheight := 200;
	map.AppendPin(x,y);

endfunction

