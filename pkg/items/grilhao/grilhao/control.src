// Grilhão control script — runs once per grilhão while attached to a carrier.
// Tick = 250ms. Each tick: re-anchors item to carrier's tile and re-applies
// movement slow. Sleeps longer when carrier is offline or unresolved.

use uo;
use os;

program grilhao_control(item)
	while (item)
		var carrierSerial := GetObjProperty(item, "carrier");
		if (carrierSerial == error || !carrierSerial)
			sleepms(5000);
			continue;
		endif

		var carrier := SystemFindObjectBySerial(carrierSerial);
		if (carrier == error || !carrier)
			sleepms(5000);
			continue;
		endif

		if (!carrier.connected)
			sleepms(10000);
			continue;
		endif

		if (item.x != carrier.x || item.y != carrier.y || item.realm != carrier.realm)
			MoveObjectToLocation(item, carrier.x, carrier.y, carrier.z,
			                     carrier.realm, MOVEOBJECT_FORCELOCATION);
		endif

		PlayerSpeedSlower(carrier, 1);
		sleepms(250);
	endwhile

	return 1;
endprogram
