// grilhao/use.src — double-click flow, troncoalgema-style.
//
// First use auto-generates a LockId and stamps a matching iron key into the
// user's pack. From then on:
//   * Any double-click requires a matching key in the user's pack.
//   * If unattached → target a fallen body or get YesNo consent from an
//     awake player → attach (move grilhão to target's pack, freeze, set
//     "corda" CProp). Item stays around so it can be unlocked later.
//   * If already attached → YesNo "soltar?" → release (clear corda + frozen,
//     return grilhão to the releaser's pack as Movable again).
//
// Jailor-issued grilhões are created via :grilhao:include/grilhao with the
// LockId + key stamped at jail time; their lifecycle bypasses this script.

use uo;
use os;
use util;

include ":gumps:yesNo";
include ":keys:key";
include ":fls_core:packets";
include "include/say";

const GRILHAO_DEFAULT_DIFF	:= 100;
const GRILHAO_DEFAULT_DR		:= 60;

program grilhao_use(who, item)
	var lockid := Cint(GetObjProperty(item, "LockId"));
	if (!lockid)
		lockid := EnsureLockAndKey(who, item);
		if (!lockid)
			return 0;
		endif
	endif

	if (!KP_HasKeyForLock(who, lockid))
		SendSysMessage(who, "Voce nao possui a chave deste grilhao.");
		return 0;
	endif

	var carrierSerial := Cint(GetObjProperty(item, "carrier"));
	if (carrierSerial)
		var carrier := SystemFindObjectBySerial(carrierSerial);
		if (!carrier || carrier == error)
			EraseObjProperty(item, "carrier");
			item.movable := 1;
			return 0;
		endif
		var ok := YesNo(who, "Soltar " + carrier.name + "?", "Sim.", "Nao.");
		if (!ok)
			return 0;
		endif
		return ReleaseGrilhao(item, carrier, who);
	endif

	SendSysMessageEx(who, "Em quem voce deseja usar o grilhao?", SSM_REQUEST);
	var alvo := Target(who, TGTOPT_CHECK_LOS);
	if (!alvo)
		SendSysMessage(who, "Cancelado.");
		return 0;
	endif
	if (Distance(who, alvo) > 2)
		SendSysMessage(who, "Voce esta muito longe.");
		return 0;
	endif
	if (GetObjProperty(alvo, "corda"))
		SendSysMessage(who, "Esse alvo ja esta amarrado.");
		return 0;
	endif

	var diff := Cint(GetObjProperty(item, "diff"));
	if (!diff)
		diff := GRILHAO_DEFAULT_DIFF;
	endif

	if (alvo.corpsetype == 400 || alvo.corpsetype == 401 || alvo.corpsetype == 1828 ||
	 alvo.corpsetype == 1829 || alvo.corpsetype == 1830 || alvo.corpsetype == 1831 ||
	 alvo.corpsetype == 1832 || alvo.corpsetype == 1833 || alvo.corpsetype == 1834 ||
	 alvo.corpsetype == 1835)
		var char := SystemFindObjectBySerial(alvo.ownerserial);
		if (!char)
			SendSysMessage(who, "Voce nao pode usar grilhao nesse corpo.");
			return 0;
		endif
		SetObjProperty(alvo, "corda", 1);
		AttachGrilhaoToTarget(item, char, diff, who);
		return 1;
	endif

	if (alvo.ip)
		if (!alvo.connected)
			SendSysMessage(who, "Nao pode prender um jogador deslogado.");
			return 0;
		endif
		var ok := YesNo(alvo, "Voce permite ser preso por " + who.name + " com um grilhao?", "Sim, permito.", "Nao.");
		if (!ok)
			SendSysMessage(who, alvo.name + " nao permitiu.");
			return 0;
		endif
		AttachGrilhaoToTarget(item, alvo, diff, who);
		alvo.frozen := 1;
		return 1;
	endif

	SendSysMessage(who, "Voce nao pode prender isso.");
	return 0;
endprogram

function EnsureLockAndKey(who, item)
	var lockid := AllocLockId();
	SetObjProperty(item, "LockId", lockid);
	SetObjProperty(item, "lockDR", GRILHAO_DEFAULT_DR);

	var key := CreateItemInBackpack(who, "ironkey", 1);
	if (key && key != error)
		SetObjProperty(key, "LockId", lockid);
		key.name := "Chave do Grilhao";
		SendSysMessage(who, "Voce ativa o grilhao e recebe sua chave.");
	endif
	return lockid;
endfunction

function AttachGrilhaoToTarget(item, alvo, diff, who)
	SetObjProperty(alvo, "corda", diff);
	SetObjProperty(item, "carrier", alvo.serial);
	SetObjProperty(alvo, "#grilhao_serial", item.serial);
	if (alvo.backpack)
		MoveItemToContainer(item, alvo.backpack);
	endif
	item.movable := 0;
	PrintTextAbove(who, "*algema " + alvo.name + "*");
	PlaySoundEffect(alvo, 0x04B);
endfunction

function ReleaseGrilhao(item, carrier, who)
	EraseObjProperty(carrier, "corda");
	EraseObjProperty(carrier, "#grilhao_serial");
	EraseObjProperty(item, "carrier");
	carrier.frozen := 0;
	PlayerSpeedSlower(carrier, 0);
	item.movable := 1;
	if (who.backpack)
		MoveItemToContainer(item, who.backpack);
	endif
	PrintTextAbove(who, "*destranca o grilhao*");
	PlaySoundEffect(carrier, 0x4D4);
	return 1;
endfunction
