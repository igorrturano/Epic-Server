// grilhao/use.src — double-click flow.
//
// Mirrors :fls_core:algemas: target a fallen body or get YesNo consent from
// an awake player, then freeze them via the "corda" CProp pattern. The
// grilhão item is consumed (SubtractAmount). Release uses the existing
// freeze ecosystem: .soltar command, bladed weapon, etc.
//
// Jailor-issued grilhões are created directly via :grilhao:include/grilhao
// with a carrier CProp pre-set; their lifecycle is managed by the Jailor
// quota flow, not by this script.

use uo;
use os;
use util;

include ":gumps:yesNo";
include "include/say";

program grilhao_use(who, item)
	if (GetObjProperty(item, "carrier"))
		SendSysMessage(who, "Esse grilhao ja esta em uso.");
		return 0;
	endif

	SendSysMessageEx(who, "Em quem voce deseja usar o grilhao?", SSM_REQUEST);
	var alvo := Target(who, TGTOPT_CHECK_LOS);

	if (!alvo)
		SendSysMessage(who, "Cancelado.");
		return 0;
	endif
	if (Distance(who, alvo) > 2)
		SendSysMessage(who, "Voce esta muito longe.");
		return 0;
	endif
	if (GetObjProperty(alvo, "corda"))
		SendSysMessage(who, "Esse alvo ja esta amarrado.");
		return 0;
	endif

	var diff := Cint(GetObjProperty(item, "diff"));
	if (!diff)
		diff := 100;
	endif

	if (alvo.corpsetype == 400 || alvo.corpsetype == 401 || alvo.corpsetype == 1828 ||
	 alvo.corpsetype == 1829 || alvo.corpsetype == 1830 || alvo.corpsetype == 1831 ||
	 alvo.corpsetype == 1832 || alvo.corpsetype == 1833 || alvo.corpsetype == 1834 ||
	 alvo.corpsetype == 1835)
		var char := SystemFindObjectBySerial(alvo.ownerserial);
		if (!char)
			SendSysMessage(who, "Voce nao pode usar grilhao nesse corpo.");
			return 0;
		endif
		PrintTextAbove(who, "*algema " + char.name + "*");
		SubtractAmount(item, 1);
		SetObjProperty(alvo, "corda", 1);
		SetObjProperty(char, "corda", diff);
		return 1;
	endif

	if (alvo.ip)
		if (!alvo.connected)
			SendSysMessage(who, "Nao pode prender um jogador deslogado.");
			return 0;
		endif
		var ok := YesNo(alvo, "Voce permite ser preso por " + who.name + " com um grilhao?", "Sim, permito.", "Nao.");
		if (!ok)
			SendSysMessage(who, alvo.name + " nao permitiu.");
			return 0;
		endif
		PrintTextAbove(who, "*algema " + alvo.name + "*");
		SubtractAmount(item, 1);
		SetObjProperty(alvo, "corda", diff);
		alvo.frozen := 1;
		return 1;
	endif

	SendSysMessage(who, "Voce nao pode prender isso.");
	return 0;
endprogram
