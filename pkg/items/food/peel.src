use uo;

program peel(who, fruit)
	var peeled;

	if (fruit.objtype == 0x171f)
		peeled := 0x171d;
	elseif (fruit.objtype == 0x1720)
		peeled := 0x171e;
	endif
	SendSysMessage(who, "Voce descasca a banana.");
	playsoundeffect(who, 0x5a);
	var peeledItem := CreateItemInBackpack(who, peeled, 1);
	if (peeledItem == error)
		SendSysMessage(who, "Sua mochila esta cheia.");
		return 0;
	endif
	subtractamount(fruit, 1);
endprogram
