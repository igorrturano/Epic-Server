use uo;
use os;

program bananabunch(who, bunch)
	var fruit;

	if (bunch.objtype == 0x1721)
		fruit := 0x1720;
	elseif (bunch.objtype == 0x1722)
		fruit := 0x171f;
	endif
	SendSysMessage(who, "Voce arrancou as bananas.");
	playsoundeffect(who, 0x5a);
	Sleep(1);
	playsoundeffect(who, 0x5a);
	Sleep(1);
	playsoundeffect(who, 0x5a);
	Sleep(1);
	playsoundeffect(who, 0x5a);
	Sleep(1);
	var harvested := CreateItemInBackpack(who, fruit, 6);
	if (harvested == error)
		SendSysMessage(who, "Sua mochila esta cheia.");
		return 0;
	endif
	destroyitem(bunch);
endprogram
