use uo;
use polsys;

include "include/epicEconomyAudit";

program makegold(mobile, amount)

	if (!amount)
		SendSysMessage(mobile, "Useage: .makegold [amount]");
		return;
	endif

	amount := CInt(amount);

	SendSysMessage(mobile, "Target the container to hold the gold");
	var cont := Target(mobile);

	if (!cont)
		SendSysMessage(mobile, "Cancelled");
		return;
	endif

	if (!cont.IsContainer())
		SendSysMessage(mobile, "That is not a container");
		return;
	endif

	var orgamount := amount;
	var created := 0;
	var stacks := 0;
	var gm_label := "GM:" + mobile.acctname;
	while (amount > 60000)
		var g := CreateItemInContainer(cont, EA_COIN_OURO, 60000);
		if (g)
			EA_Record(EA_MINT_GM, g, 60000, gm_label, cont, "");
			amount := amount - 60000;
			created := created + 60000;
			stacks := stacks + 1;
		else
			SendSysMessage(mobile, "The container is full!");
			SendSysMessage(mobile, "Created " + CStr(created) + ", remaining: " + CStr(orgamount - created));
			return;
		endif
	endwhile

	if (amount > 0)
		var g := CreateItemInContainer(cont, EA_COIN_OURO, amount);
		if (g)
			EA_Record(EA_MINT_GM, g, amount, gm_label, cont, "");
			created := created + amount;
		else
			SendSysMessage(mobile, "The container is full!");
			SendSysMessage(mobile, "Created " + CStr(created) + ", remaining: " + CStr(orgamount - created));
		endif
	endif

	SendSysMessage(mobile, "Done. Made " + CStr(stacks) + " stacks");

endprogram
