// .mintstate — diagnóstico do sistema de seignorage (Phase 4).
// Mostra: supply atual, target, ratio, mintRate efetiva (probe de 100 units),
// pool por moeda, estado de refuse.

use uo;
use os;
use util;

include "include/epicConstants";
include ":currency:include/seignorage";

program mintstate(mobile)
	var supply := GetCurrentSupply();
	var supply_target := GetSupplyTarget();
	var ratio := (supply_target > 0) ? (CDbl(supply) / CDbl(supply_target)) : 0.0;
	var refuse_ratio := GetRefuseRatio();
	var refused := IsMintRefused();

	SendSysMessage(mobile, "=== Mint State ===");
	SendSysMessage(mobile, "Supply: " + supply + " cobre-eq");
	SendSysMessage(mobile, "Target: " + supply_target);
	SendSysMessage(mobile, "Ratio: " + ratio + " (refuse @ " + refuse_ratio + ")");
	if (refused)
		SendSysMessage(mobile, "ESTADO: RECUSANDO depósitos");
	endif

	// Probe de mintRate por moeda (qty=100)
	var rate_cobre := GetMintRate(SESTERTIUS, 100);
	var rate_prata := GetMintRate(DENARIUS, 100);
	var rate_ouro  := GetMintRate(AUREUS, 100);
	SendSysMessage(mobile, "");
	SendSysMessage(mobile, "mintRate (probe @ qty=100):");
	SendSysMessage(mobile, "  Cobre: " + rate_cobre);
	SendSysMessage(mobile, "  Prata: " + rate_prata);
	SendSysMessage(mobile, "  Ouro:  " + rate_ouro);

	SendSysMessage(mobile, "");
	SendSysMessage(mobile, "Pool acumulado:");
	SendSysMessage(mobile, "  Cobre: " + GetPoolAmount(SESTERTIUS));
	SendSysMessage(mobile, "  Prata: " + GetPoolAmount(DENARIUS));
	SendSysMessage(mobile, "  Ouro:  " + GetPoolAmount(AUREUS));

	return 1;
endprogram
