// $Id: canRemove.src 386 2005-10-03 00:22:39Z muaddiblsd $

use uo;
include ":attributes:attributes";
include "include/say";
include ":containers:personalLoot";
include ":wrappers:Objects/Model/MobileWrapper";

program canRemove(character, container, item, move_type)
	if (container.ownerserial == character.serial)
		return 1;
	endif

	if (character.warmode)
		SendSysMessageEx(character, "Você não pode pegar itens em modo de guerra.", SSM_FAIL);
		return 0;
	endif

	var mobWrapper := MobileWrapper(character);
	if (mobWrapper.IsMounted())
		SendSysMessage(character, "Voce nao pode fazer isto montado.");
		return 0;
	endif

	if (character.frozen || character.paralyzed)
		SendSysMessage(character, "Voce esta paralizado.");
		return 0;
	endif

	if (GetObjProperty(item, "OnlyKit"))
		if (GetObjProperty(item, "OnlyKit") != GetObjProperty(character, "kit"))
			return 0;
		endif
	endif

	if (PersonalLoot_IsActive(container) && character.cmdlevel == 0)
		var unlock_at := CInt(GetObjProperty(container, "loot_unlock_at"));
		if (ReadGameClock() < unlock_at)
			SendSysMessageEx(character, "O corpo ainda fumega — aguarde alguns segundos.",
							 SSM_INFO);
			return 0;
		endif
		var owner := GetObjProperty(item, "loot_owner");
		if (owner != error && owner != character.serial)
			SendSysMessageEx(character, "Este item pertence a outro participante do combate.",
							 SSM_INFO);
			return 0;
		endif
	endif

	var is_cursed := GetObjProperty(item, "equip").cursed;
	if (is_cursed && GetObjProperty(item, "#EquippedOn") == container.ownerserial)
		SendSysMessage(character, "Este item parece estar preso ao usuario");
		return 0;
	endif

	var cannotPickItems := GetObjProperty(character, "pilotando") ||
									   GetObjProperty(character, "metamorfose") != error;
	if (container.objtype == 0xEFFF && !cannotPickItems) // Se for remains
		PrintTextAbove(character, "*Pegou " + item.desc + " do " + container.desc + "*", 41); // Imprime a mensagem de removendo item
	endif

	return 1;
endprogram
