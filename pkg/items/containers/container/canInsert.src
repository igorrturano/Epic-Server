// $Id: canInsert.src 87 2006-05-23 19:04:43Z sroyalty $

use uo;
use os;
use cfgfile;
include ":attributes:attributes";
include ":containers:checks";
include ":wrappers:Objects/Model/MobileWrapper";

program canInsert(mobile, container, movetype, insert_type, item, existing_stack, amount_to_add)

	if (container.locked || CP_RootContainerLocked(container))
		SendSysMessage(mobile, "voce nao pode por isto em um container trancado.");
		return 0;
	endif

	// Pilotando/metamorfose travam qualquer insercao, manual ou via core.
	// possess.inc depende disso para bloquear MoveItemToContainer.
	var owner := container.character_owner;
	if (GetObjProperty(owner, "pilotando") || GetObjProperty(owner, "metamorfose") != error)
		SendSysMessageEx(mobile, "Heh, nope.", SSM_INFO);
		return 0;
	endif

	if (movetype == MOVETYPE_COREMOVE)
		return 1;
	endif
	if (mobile)
		if (!mobile.npctemplate)
			var aux := container;
			while (aux.container)
				aux := aux.container;
			endwhile
			var mobWrapper := MobileWrapper(mobile);
			if (aux == mobile)
				if (mobWrapper.IsMounted() && !IsMountSwappableEquip(item))
					SendSysMessage(mobile, "Voce nao pode fazer isto montado.");
					return 0;
				endif
				if (mobile.frozen || mobile.paralyzed)
					SendSysMessage(mobile, "Voce esta paralizado.");
					return 0;
				endif
				return 1;
			endif

			if (mobWrapper.IsMounted() && !IsMountSwappableEquip(item))
				SendSysMessage(mobile, "Voce nao pode fazer isto montado.");
				return 0;
			endif

			if (mobile.frozen || mobile.paralyzed)
				SendSysMessage(mobile, "Voce esta paralizado.");
				return 0;
			endif
		endif
	endif

	// To-do
	// Play sound effect now that item is being added.
	return 1;
endprogram
