// ovo_lacrado.src - double-click no Ovo Lacrado: exibe frase do dia atual (1-30).

use uo;
use os;

include ":message:include/model/Message";

program OvoLacrado(who, item)
 var criado_em := CInt(GetObjProperty(item, "ovo_criado_em"));
    if (!criado_em)
 SendSysMessageEX(who, "Voce sente algo se mover.", SSM_INFO);
        return;
    endif

    var dia := CInt((ReadGameClock() - criado_em) / 86400) + 1;
    if (dia < 1)  dia := 1;  endif
    if (dia > 30) dia := 30; endif

    var frases := array{
 "Esta frio ao toque. Mas diferente de uma pedra fria.",
 "Voce jura que sentiu algo respirar. Uma vez. So uma.",
 "Uma vibracao leve, como se algo ajustasse a posicao la dentro.",
 "O ovo pesa diferente dependendo de como voce o segura.",
 "Voce o ouviu. So voce. Nao havia som. Mas voce ouviu.",
 "A casca esta mais quente hoje do que ontem.",
 "Algo empurrou. Suavemente. Uma vez.",
 "Voce acordou com o ovo na mao sem lembrar de te-lo pego.",
 "Ha uma mancha nova na casca. Nao estava la antes.",
 "Ele respondeu quando voce bateu levemente. Nao com som. Com calor.",
 "Algo dentro se virou. Voce sentiu o peso mudar.",
 "A casca ficou mais translucida em um ponto. Nao da para ver o que ha.",
 "Ele reagiu ao seu nome. Voce nao disse em voz alta.",
 "A mancha cresceu. Tem textura agora.",
 "Pela primeira vez, ele esta mais quente que a sua mao.",
 "Voce sonhou com ele. Nao sonho, ele ja estava aberto.",
 "Ele nao gosta de barulho alto. Voce percebeu.",
 "Algo pressionou de dentro com forca suficiente para mover sua mao.",
 "A casca tem pequenas fissuras. Sao novas. Aparecem e somem.",
 "Voce teve certeza de que ele olhou para voce. Mesmo fechado.",
 "Ele esta inquieto. Mais do que antes.",
 "As fissuras estao ficando. Algumas ja sao permanentes.",
 "Algo dentro fez um som. Nao e bem um som. E mais uma intencao de som.",
 "Ele esta resistindo ao frio. Antes nao resistia.",
 "Voce sente que ele sabe onde voce esta. Mesmo quando nao o carrega.",
 "As fissuras cobrem metade da casca agora.",
 "Ele ficou parado por horas. Completamente parado. Entao moveu tudo de uma vez.",
 "A casca esta separando. Lentamente. Por vontade dele.",
 "Quase. Voce sente que e quase.",
 "Hoje e o dia. Voce sabe. Ele tambem sabe."
    };

    SendSysMessageEX(who, frases[dia], SSM_INFO);
endprogram
