// exec_dispatcher.src  - executor unico para todas as naturezas.
// Substitui os 6 scripts exec individuais.
// params: {who, book, nivel, afinidade, lugar, natureza}

use uo;
use os;
use util;
use vitals;
use datafile;

include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":attributes:attributes";
include ":livros_lacrados:include/livrosLacrados";
include ":livros_lacrados:scripts/naturezas/cifrado";
include ":livros_lacrados:scripts/naturezas/inerte";
include ":livros_lacrados:scripts/naturezas/profetico";
include ":livros_lacrados:scripts/naturezas/manchado";
include ":livros_lacrados:scripts/naturezas/despertador";

program ExecNatureza(params)
    var who       := params[1];
    var book      := params[2];
    var nivel     := CInt(params[3]);
    var afinidade := params[4];
    var lugar     := params[5];
    var natureza  := params[6];
    if (!who || who.errortext) return; endif

 var invocacao := "";
    case (natureza)
        NAT_INERTE:      ExecutarInerte(who, book, nivel, afinidade, lugar);      break;
        NAT_CIFRADO:     ExecutarCifrado(who, book, nivel, afinidade, lugar);     break;
        NAT_MANCHADO:    ExecutarManchado(who, book, nivel, afinidade, lugar);    break;
        NAT_DESPERTADOR: ExecutarDespertador(who, book, nivel, afinidade, lugar); break;
        NAT_PROFETICO:   ExecutarProfetico(who, book, nivel, afinidade, lugar);   break;
        NAT_CONVOCADOR:
 invocacao := GetObjProperty(book, "invocacao");
 if (!invocacao || invocacao == "" || invocacao.errortext)
                invocacao := SortearInvocacao(nivel);
 SetObjProperty(book, "invocacao", invocacao);
            endif
 start_script(":livros_lacrados:scripts/invocacoes/invocar",
                array{who, book, invocacao, nivel, afinidade, lugar});
            break;
        default:
            break;
    endcase
endprogram
