use uo;
use os;
use datafile;

include ":livros_lacrados:scripts/setup_helper";

program SetupCifradoChunk1(who, cmdline)
 var df := OpenDataFile(":livros_lacrados:cifrado_textos");
    if (df.errortext)
 df := CreateDataFile(":livros_lacrados:cifrado_textos", DF_KEYTYPE_STRING);
    else
    endif
    if (df.errortext)
 if (who) SendSysMessage(who, "Erro df: " + df.errortext); endif
        return;
    endif

    //   -- -- -- aglabita_antigo   -- -- --

 _Setup(df, "c_aglabita_antigo_lingua", array{
 "[Despacho Interceptado — Tradução do Aglâb Arcaico]<br><br>O emissário não chegou. A rota foi comprometida na travessia de Khalem.<br>Não enviem mais ninguém pelo caminho do sal — eles já sabem o sinal.<br>O carregamento continua. O destinatário não precisa saber que houve perda.<br>Queimem este papel ao ler. Se está lendo e não o queimou, o erro é seu.<br><br>— Sem assinatura. Carimbo de cera azul com três pontos.",
 "[Contrato Privado — Porto de Bassavar, Ano Indeterminado]<br><br>Fica acordado entre as partes: nenhuma das duas existiu nesta cidade.<br>O débito será honrado quando a Rota das Marés abrir pela terceira vez no ciclo.<br>Caso uma das partes morra antes, o débito não passa — cancela.<br>Caso ambas morram, o papel ainda vale. A quem vale, não está escrito.<br><br>— Assinaturas de duas mãos distintas, ambas apagadas com tinta grossa.",
 "[Relatório ao Conselho — Circulação Restrita]<br><br>A quinta delegação retornou. Três membros não voltaram.<br>Afirmam que os que ficaram escolheram ficar. Não investiguem.<br>A região além do promontório não deve ser mencionada em ata.<br>O Regente foi informado. Disse que já sabia. Disse que sempre soube.<br>Não há ação recomendada. Há apenas registro. Este é o registro.<br><br>— Documento sem timbre. Páginas costuradas ao contrário."
    });

 _Setup(df, "c_aglabita_antigo_magia", array{
 "[Intenção Impressa — Despacho]<br><br>Medo de ser lido pela pessoa errada.<br>Urgência — não a de negócios, a de quem sabe que algo errou atrás dele.<br>Uma decisão tomada que ele já arrependeu ao escrever a primeira linha.<br>Alívio falso na última frase. Quem escreveu sabia que não adiantaria.<br><br>O papel ainda carrega a pressa da mão que o dobrou.",
 "[Intenção Impressa — Contrato]<br><br>Duas pessoas que se odeiam e precisam uma da outra.<br>Desejo de que a outra parte morra antes do prazo — ambas sentiram o mesmo.<br>O papel foi assinado duas vezes porque a primeira vez a mão tremeu.<br>Há algo que nenhuma das duas escreveu mas ambas pensaram ao assinar.<br><br>A intenção não dita deixa mais marca que as palavras.",
 "[Intenção Impressa — Relatório ao Conselho]<br><br>O escriba que copiou isto não queria copiar.<br>Cada linha carrega a resistência de alguém que precisava de emprego.<br>Havia algo nos três membros que ficaram — o escriba sentiu, não escreveu.<br>O Regente que disse que sabia estava mentindo. A mentira ficou no papel.<br><br>Documentos oficiais guardam o que os autores não ousaram dizer em voz alta."
    });

 _Setup(df, "c_aglabita_antigo_arq", array{
 "[Transcrição Acadêmica — Despacho Interceptado, Rede Comercial Bassavar]<br><br>Documento datado da quarta era da Liga dos Regentes.<br>'Caminho do sal': rota costeira entre Khalem e o porto sul, usada<br>por contrabandistas para evitar a taxa do promontório controlado.<br>O carimbo de três pontos identifica a célula 'Olho Duplo',<br>associada a doze interceptações de carregamento registradas no período.<br>A instrução de queimar é padrão desta rede. Nenhum exemplar deveria existir.<br><br>— Arquivo do Desbravador. Ref.: Dossiê Khalem-Sul, vol. 3.",
 "[Transcrição Acadêmica — Contrato de Duplo Anonimato, Porto de Bassavar]<br><br>'Rota das Marés' aparece como marcador temporal, não geográfico.<br>O ciclo de três aberturas correspondia ao calendário de maré de lua morta —<br>usado pela Liga para datar obrigações sem registrar ano nominal.<br>A cláusula de cancelamento por morte era padrão em contratos de alto risco;<br>a cláusula que sobrevive a ambas as mortes é anomalia. Sem precedente no corpus.<br>Não foi encontrado registro de quem seria o beneficiário pós-mortem.<br><br>— Arquivo do Desbravador. Nota: verificar cópia no cartório de Bassavar.",
 "[Transcrição Acadêmica — Relatório Interno, Liga dos Regentes, Período Tardio]<br><br>Os três membros não retornados aparecem em outros documentos:<br>dois foram declarados mortos por enfermidade seis meses depois, em lugares distintos.<br>O terceiro não tem registro de morte nem de vida após a viagem.<br>O promontório proibido corresponde ao que hoje se chama Litoral Mudo —<br>área de concentração documentada da Rota das Marés, onde almas são capturadas.<br>O Regente que 'sempre soube': provavelmente Harun ibn-Yassir, quinto da série.<br>Morreu dois anos depois. Causa oficial: febre. Causa provável: soube demais.<br><br>— Arquivo do Desbravador. Classificação: sensível."
    });

    //   -- -- -- khar_runico   -- -- --

 _Setup(df, "c_khar_runico_lingua", array{
 "[Registro de Turno — Mina de Kor-Dhath, Seção Sete]<br><br>Turno de alvorecer. Seis extratores. Dois desceram, quatro ficaram no acesso.<br>A pedra no setor leste está com temperatura errada. Reportado ao supervisor.<br>Supervisor disse: registrar e continuar. Registramos. Continuamos.<br>Um dos que desceu não relatou nada ao voltar. Não por recusa — por hábito.<br>O som está lá. Rítmico. Muda de cadência quando alguém para para ouvir.<br><br>— Marca de clã Kor. Rodapé: 'Aguardando instrução formal.'",
 "[Comunicado de Inspeção — Anomalia Sete, Acesso Norte]<br><br>A pedra tem luz própria. Não é mineral. Não é magia conhecida.<br>Foi testada com instrumento de calor: o instrumento não respondeu.<br>A temperatura inverte a três metros de profundidade — quente em cima, frio embaixo.<br>Isso contradiz a geologia de qualquer formação conhecida no registro.<br>Recomendação do inspetor: selar o acesso norte até que um Mestre de Pedra examine.<br>Observação do supervisor: 'Nenhum Mestre de Pedra pediu para vir.'<br><br>— Carimbo duplo: inspetor e supervisor. Datas diferentes por três semanas.",
 "[Carta Interna — Clã Kor-Dhath ao Conselho dos Vinte]<br><br>Escrevemos porque o protocolo exige. Não porque esperamos resposta.<br>A Seção Sete foi lacrada por decisão interna. Os homens que pediram para continuar<br>foram relocados para a mina norte. Não por punição. Por precaução.<br>O que cresce na rocha não é veio. Não é cristal. Cresce como cresce um ser vivo.<br>O clã está bem. A mina está produzindo. A Seção Sete está lacrada.<br>Não há necessidade de visita do Conselho. Esta carta é apenas protocolo.<br><br>— Assinatura do Portador de Clã Kor-Dhath. Sem data."
    });

 _Setup(df, "c_khar_runico_magia", array{
 "[Intenção Impressa — Registro de Turno, Anomalia Sete]<br><br>Medo contido. Khar não escreve medo — escreve 'temperatura errada'.<br>O que desceu e não relatou: não esqueceu. Não quis.<br>O ritmo do som entrou nele e ele não sabe como explicar isso.<br>Quem escreveu 'aguardando instrução formal' sabia que nenhuma instrução viria.<br><br>Este papel carrega a disciplina de quem aprendeu a não demonstrar o que sente.",
 "[Intenção Impressa — Comunicado de Inspeção]<br><br>O inspetor estava com medo quando escreveu 'não é magia conhecida'.<br>Mas mais que medo: fascinação. Quis descer de novo. Não escreveu isso.<br>'Nenhum Mestre de Pedra pediu para vir' — o supervisor tinha alívio ao escrever.<br>Alívio de não ter que explicar. De poder fingir que não era responsabilidade dele.<br><br>Três semanas entre as duas datas: tempo de evitar a conversa necessária.",
 "[Intenção Impressa — Carta ao Conselho dos Vinte]<br><br>Cada linha desta carta foi escrita para dizer menos do que sabe.<br>'Não há necessidade de visita' — havia. O clã não queria testemunhas.<br>Os homens relocados: o Portador de Clã não sabia se protegia a mina ou os homens.<br>O que cresce na rocha — ele já sabe o que é. Não escreveu porque nomear obriga.<br><br>O papel carrega a solidão de uma decisão tomada sem poder pedir conselho."
    });

 _Setup(df, "c_khar_runico_arq", array{
 "[Transcrição Acadêmica — Registro de Turno, Mina Kor-Dhath, Seção Sete]<br><br>'Som rítmico que muda de cadência quando alguém para para ouvir' corresponde<br>ao fenômeno documentado em três sítios próximos à Anomalia Sete: o som responde<br>à atenção deliberada. Observadores relatam que parar de respirar fundo<br>altera o ritmo de modo mensurável.<br>O extrator que 'não relatou por hábito': transferência forçada seis meses depois.<br>Motivo declarado: 'inadequação ao trabalho em turno fechado.'<br><br>— Arquivo do Desbravador. Ref.: Anomalia Sete, seção sonora, doc. 11.",
 "[Transcrição Acadêmica — Inspeção, Acesso Norte da Anomalia Sete]<br><br>O instrumento de calor que 'não respondeu' era termômetro de mercúrio-mineral,<br>padrão khar do período. Falha consistente com inversão térmica é o que chamamos<br>de 'bolsão frio', mas nenhum bolsão frio natural inverte completamente como descrito.<br>A pedra com luz própria foi confirmada por quatro relatos independentes —<br>nenhum dos quatro descreveu a cor da luz de modo consistente entre si.<br><br>— Arquivo do Desbravador. Nota: luz sem cor definida é marcador de origem extrafísica.",
 "[Transcrição Acadêmica — Carta Interna Kor-Dhath, Período da Grande Lacração]<br><br>'O que cresce na rocha como ser vivo': único registro escrito desta observação<br>vindo de dentro do clã. Extratores falam em 'raízes sem planta' e 'nervos de pedra'<br>— linguagem metafórica consistente entre homens que nunca se consultaram.<br>Sugestivo de fenômeno real que a língua khar não tem palavra para nomear.<br>'Esta carta é apenas protocolo': o Conselho recebeu, registrou, não enviou ninguém.<br>O lacre do acesso norte permanece intacto até hoje.<br><br>— Arquivo do Desbravador. Classificação: restrito. Não circular entre novatos."
    });

    //   -- -- -- bjorske_cursivo   -- -- --

 _Setup(df, "c_bjorske_cursivo_lingua", array{
 "[Diário de Xamã — Inverno Sem Nome]<br><br>A Árvore Grande fez sombra para o lado errado esta manhã.<br>Não é metáfora. A sombra caiu a leste com o sol a leste.<br>Consultei os ossos. Os ossos disseram: não é pergunta para os ossos.<br>Vorar não respondeu quando chamei. Isso também é resposta.<br>Estou esperando. O inverno não acabou. A neve desta semana não derrete.<br><br>— Marcação em carvão. Borda inferior: uma runa que significa 'vigília'.",
 "[Mensagem entre Vilas — Corredor Norte]<br><br>Não sigam os rastros que encontrarem além da crista.<br>Rastros que convidam não podem ser recusados — por isso: não os encontrem.<br>Se já encontraram, não falem o nome para os outros.<br>Se já falaram, vim tarde demais e esta carta não importa.<br>Se ainda não foram: fiquem. O que está lá não espera com pressa.<br><br>— Sem assinatura. Entregue por corvos. Três cópias, três vilas.",
 "[Relato de Caça — Primavera Anômala]<br><br>Saímos cinco. Voltamos quatro. O quinto ficou — por escolha, disse ele.<br>Havia neve no chão que não havia ontem. Neve de granizo antigo, não de nevasca.<br>O quarto viu pegadas que não eram animais nem homens. Não as seguiu.<br>Louvado seja o quarto pela sabedoria. A€s vezes o espírito premia a recusa.<br>O que ficou: não era o mais fraco. Era o mais curioso. Curiosidade é convite.<br><br>— Assinado com a marca do caçador mais velho. Traço firme."
    });

 _Setup(df, "c_bjorske_cursivo_magia", array{
 "[Intenção Impressa — Diário de Xamã]<br><br>Disciplina sobre o medo. O xamã treinou não nomear o que perturba.<br>'Os ossos disseram: não é pergunta para os ossos' — ele sabe a resposta.<br>Não quer dizê-la porque dizer fixa no mundo.<br>Vorar não respondeu: o espírito recusou envolvimento. Isso o assustou mais<br>do que qualquer resposta teria. A espera é real. A neve o confirma.<br><br>Este papel cheira a fumaça de madeira verde — queimada para manter calor, não ritual.",
 "[Intenção Impressa — Mensagem entre Vilas]<br><br>Quem escreveu já foi além da crista. Voltou.<br>Sabe o que são os rastros porque os encontrou e recusou — não sem custo.<br>A repetição 'se já... se ainda não' é o pensamento de alguém que chegou tarde<br>a lugares assim antes. Aprendeu que avisos têm janela.<br>Há culpa aqui: não conseguiu chegar a tempo para uma das três vilas.<br><br>O papel carrega pressa e resignação em igual medida.",
 "[Intenção Impressa — Relato de Caça]<br><br>O caçador mais velho escreveu isto com a mão do quarto ainda em sua memória.<br>Orgulho genuíno — 'louvado seja o quarto' não é fórmula, é sentimento.<br>Sobre o quinto: luto que não nomeia o que perdeu, porque nomear seria aceitar<br>que havia escolha onde talvez não houvesse.<br>'Curiosidade é convite' — ele próprio foi curioso uma vez. Sobreviveu por sorte.<br><br>Sabe disso. O traço firme é esforço deliberado para não demonstrar o tremor."
    });

 _Setup(df, "c_bjorske_cursivo_arq", array{
 "[Transcrição Acadêmica — Diário de Xamã Bjorske, Inverno Sem Nome]<br><br>'Inverno Sem Nome': designação ritual para anos em que os espíritos<br>se recusavam a confirmar a saída do frio — sem esse sinal, o inverno<br>não recebia nome no calendário bjorske. Três Invernos Sem Nome antes;<br>nenhum com relato de sombra invertida pela Árvore Grande.<br>Sombra a leste com sol a leste é fisicamente impossível — salvo interferência<br>de entidade com capacidade de dobrar luz. Vorar recusar o chamado é,<br>no corpus bjorske, marcador de situação que excede a jurisdição espiritual.<br><br>— Arquivo do Desbravador. Ref.: registros de Vorar, vol. 2.",
 "[Transcrição Acadêmica — Mensagem Circulada, Corredor Norte]<br><br>'Rastros que convidam' é conceito documentado em cinco fontes bjorske distintas.<br>Em todos os casos: rastros na neve apontando para região proibida, sem volta,<br>que geram compulsão de seguir em quem os vê.<br>Três casos de recusa bem-sucedida: dois por ignorância, um por amarramento ritual.<br>Casos de quem seguiu: sem relato de retorno.<br>O Corredor Norte foi mapeado como zona de alta captura de almas pelo sistema costeiro.<br><br>— Arquivo do Desbravador. Nota: área do Corredor Norte permanece interditada.",
 "[Transcrição Acadêmica — Relato de Caça, Clã Bjorske do Vale Branco]<br><br>'O quinto ficou por escolha': fórmula para não dizer 'o quinto foi levado'.<br>Na tradição bjorske, dizer que alguém foi levado sem testemunha presume falha<br>de quem conta em intervir — acusação implícita. 'Ficou por escolha' exonera.<br>'Neve de granizo antigo': neve que não corresponde ao clima atual, encontrada<br>em pontos onde a Rota das Marés foi documentada — temperatura que sugere<br>presença recente de captura de alma no local.<br><br>— Arquivo do Desbravador. Classificação: lore de campo, nível dois."
    });

 if (who) SendSysMessage(who, "[Cifrado DS] Chunk1 ok."); endif
endprogram
