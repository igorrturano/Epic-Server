use uo;
use os;
use datafile;

include ":livros_lacrados:scripts/setup_helper";

program SetupInerteChunk2(who, cmdline)
 var df := OpenDataFile(":livros_lacrados:inerte_textos");
    if (df.errortext)
 df := CreateDataFile(":livros_lacrados:inerte_textos", DF_KEYTYPE_STRING);
    else
    endif
    if (df.errortext)
 if (who) SendSysMessage(who, "Erro df: " + df.errortext); endif
        return;
    endif

    //   -- -- -- tomo_leste   -- -- --

 _Setup(df, "t_tomo_leste", array{
 "Doutrina dos Cinco Espelhos — Fragmento",
 "Ensinamentos do Alem-Montanhas",
 "Texto de Exilio — Escola do Dragao Cinza",
 "Carta a Um Filho Que Nunca Conheci",
 "Relato do Refugiado Eiji — Ciclo Quatorze"
    });

 _Setup(df, "c_tomo_leste_3", array{
 "DA DOUTRINA DOS CINCO ESPELHOS — TERCEIRO ENSINAMENTO<br><br>'O que voce ve no outro e o que existe em voce, seja virtude ou falha. O espelho nao mente. O espelho nao lisonjeia.<br><br>O discipulo perguntou: e se o espelho estiver quebrado?<br><br>O mestre disse: entao voce vera muitos pedacos de uma verdade. Nenhum sozinho e a verdade inteira. Mas cada um e verdadeiro. Isso e diferente de ser falso.'",
 "ENSINAMENTO DA ESCOLA DO ALEM-MONTANHAS<br><br>'A raiva que nao encontra saida vira pedra por dentro. Ha partes de um homem raivoso que ficam duras onde deveriam dobrar.<br><br>O caminho nao e nao ter raiva. O caminho e deixar a raiva passar como agua pela pedra — lentamente, pacientemente, sem se perder no canal.<br><br>O rio que resiste a pedra termina represado. O rio que aprende a forma da pedra chega ao mar.'",
 "MEDITACAO DO EXILIO<br><br>'Quando o Imperador me exilou pensei que perdia tudo. Descobri que nao perdia nada que fosse meu de verdade. O cargo era emprestado. O titulo era emprestado. O palacio era emprestado.<br><br>O que nao era emprestado: o jeito como penso, o que aprendi, as pessoas que amei com honestidade.<br><br>O exilio me devolveu o que era meu ao separar do que eu apenas segurava.'",
 "SABEDORIA ORIENTAL — TRADUZIDA PARA O IDIOMA DE VALTHERIS<br><br>'Nao temas o dragao que ataca. Teme o dragao que espera.<br><br>O que ataca tem objetivo. O que espera tem plano.<br><br>A Furia do Dragao nao e raiva — e acumulo. Cada injustica pequena, cada promessa quebrada, cada silencio engolido. Somam em silencio por anos. O que explode no fim nao e a ultima provocacao. E tudo que veio antes.'",
 "CARTA A UM FILHO QUE NUNCA CONHECI<br><br>'Voce vai ouvir que seu pai foi corajoso. Isso e verdade e nao e toda a verdade.<br><br>A verdade inteira: seu pai tinha muito medo. E o medo, as vezes, produz coragem como subproduto da incapacidade de fugir.<br><br>Nao fui corajoso porque era forte. Fui porque quando chegou o momento de fugir, meus pes nao souberam para onde ir.'<br><br>— Ishikawa Ren, Ciclo do Dragao Cinza"
    });

 _Setup(df, "c_tomo_leste_4", array{
 "DOUTRINA DOS CINCO ESPELHOS — QUINTO ENSINAMENTO — RESTRITO<br><br>'O quinto espelho nao tem reflexo. E o que voce e quando ninguem esta olhando — incluindo voce mesmo.<br><br>Poucos chegam aqui porque exige honestidade sobre coisas que nenhuma testemunha pode confirmar ou negar.<br><br>O mestre que me ensinou disse que levou cinquenta anos para conseguir olhar para o quinto espelho sem desviar. Eu entendo. Ainda estou tentando.'",
 "TRATADO SOBRE A FURIA DO DRAGAO — ESCOLA ORIENTAL<br><br>'Ha uma distincao que o Oeste raramente faz: entre o dragao que esqueceu que e dragao e o dragao que escolheu parecer homem.<br><br>O primeiro e perigoso porque reage por instinto que nao compreende mais.<br><br>O segundo escolheu. Cada dia escolhe de novo. Conhece seus proprios dentes melhor que qualquer cacador. Se encontrado, merece respeito genuino — ou nao deve ser abordado.'",
 "RELATO DO REFUGIADO EIJI<br><br>Viemos quinze academicos quando o Imperador fechou os portoes. O que nao esperavamos: o conhecimento que trouxemos nao se encaixava da mesma forma aqui. Nao era questao de lingua — eram as categorias. O modo como organizamos a realidade era ligeiramente diferente do modo de Valtheris.<br><br>Passamos anos traduzindo — nao palavras, mas mapas de mundo para mapas de mundo.<br><br>Ainda estou traduzindo. Mas aprendi que o caminho mais longo as vezes e o unico que chega.",
 "CARTA DO MESTRE SHIN-DO AO CONSELHO DE VALTHERIS<br><br>Voces me perguntam sobre a Furia do Dragao como se fosse arma. Nao e arma. E condicao. Como a chuva nao e arma para a nuvem — a nuvem chegou ao ponto em que nao pode mais conter.<br><br>A pergunta certa nao e 'como usar a Furia'. E: 'o que acumulamos que ainda nao explodiu, e o que fazemos antes que exploda?'<br><br>Estou disponivel para conversar sobre essa segunda pergunta. A primeira nao me interessa responder.",
 "FRAGMENTO DE DIARIO — EXILADO ORIENTAL, SEM IDENTIFICACAO<br><br>Quinze anos em Valtheris. Esqueco palavras na lingua natal. Lembro outras que nunca devia ter esquecido.<br><br>A lingua que mais lembro e a que aprendi para sobreviver — no mercado, nas beiras de estrada, nas tavernas onde ninguem sabia de onde eu vinha.<br><br>O Imperador quis que eu esquecesse a mim mesmo. O exilio me ensinou que a lingua que voce usa para sobreviver tambem se torna parte de quem voce e. Identidade nao e so o que voce traz de casa."
    });

 _Setup(df, "c_tomo_leste_5", array{
 "TEXTO PROIBIDO — ESCOLA DOS CINCO ESPELHOS — COPIA CONTRABANDEADA<br><br>'Ha um sexto espelho que a escola nao ensina.<br><br>E o espelho que mostra nao quem voce e, mas quem voce seria se as circunstancias fossem outras. Se voce tivesse nascido em outro lugar, em outro tempo, com outras escolhas disponiveis.<br><br>Este e o mais perigoso porque o reflexo e sempre mais simples, mais puro. E voce passa a vida tentando ser aquela versao em vez de ser quem e de verdade.<br><br>O mestre que me mostrou pediu que eu quebrasse depois. Nao consegui. Ainda carrego o fragmento.'",
 "CARTA FINAL DO EXILADO REN — TRES DIAS ANTES<br><br>Meu filho —<br><br>Encontrei algo aqui que nao esperava: a confirmacao de que o que sempre acreditei era verdade.<br><br>O Imperador disse que o dragao era mito. Que a Furia era metafora. Que nada de sobrenatural existia em lugar nenhum, que tudo era politica e quimica.<br><br>Estava errado sobre quase tudo.<br><br>Existe o dragao. Existe a Furia. E existe algo que o Leste nunca soube nomear porque nunca o encontrou em forma pura: a escolha de um ser antigo de se tornar menor por amor a algo menor do que ele.<br><br>Vi isso aqui. Nao vou conseguir contar. Mas voce vai ver tambem, se viver o suficiente e olhar para o lado certo."
    });

    //   -- -- -- confissao_drow   -- -- --

 _Setup(df, "t_confissao_drow", array{
 "Palavras Para Nenhum Ouvido",
 "Registro Pessoal — Sem Destinatario",
 "Confissao ao Espelho — Para Destruir",
 "Nota a Uma Irma que Nao Vai Ler Isto",
 "Carta que Nao Pode Ser Enviada de Volta"
    });

 _Setup(df, "c_confissao_drow_3", array{
 "Para quem encontrar isto —<br><br>Sou Drow. Sei que isso pode mudar o valor que voce atribui a estas palavras. Peco apenas que leia antes de decidir.<br><br>Sai das Galerias ha tres ciclos. Nao fui expulsa — sai por escolha. Para os de la, e pior. Expulso pode voltar. Quem sai por escolha admite que havia algo melhor la fora. Isso as Galerias nao perdoam.",
 "A primeira vez que vi o sol foi um desastre. Chorei — nao de beleza, de dor. Olhos que nunca viram luz direta nao estao preparados.<br><br>Mas quando a dor passou havia uma certeza: o que eu deixara para tras era mais escuro do que eu precisava ser.<br><br>De dentro das Galerias isso nao era obvio. A escuridao parecia natural, necessaria, o jeito certo de existir. De fora, parece outra coisa.",
 "Shae'ri —<br><br>Sei que me consideras morta. Para os propositos das Galerias estou morta. Esta bem.<br><br>O que quero que saibas: nao sai por ti. Sai por mim. Isso nao e acusacao — e so a verdade. E a verdade e que a maioria das fugas comeca com alguem que finalmente coloca a propria vida acima do que e esperado dela.<br><br>Espero que encontres isso um dia. Mesmo que seja tarde."
    });

 _Setup(df, "c_confissao_drow_4", array{
 "REGISTRO IDRITH'HAR — EXPEDICAO AO LIMIAR — USO INTERNO<br><br>Somos doze. Viemos porque fomos enviadas e porque queriamos vir. Essas duas coisas raramente coincidem entre nos. Desta vez coincidiam.<br><br>O Limiar e diferente do que os textos descrevem. Dizem que e um lugar de transicao. Isso e verdade e e insuficiente. E um lugar que lembra cada transicao que ja aconteceu nele.<br><br>Andamos horas sobre o eco de escolhas que nao foram nossas. O Limiar sabe quem passou por ele. Sabe que estamos la. Nao sei como sei isso. Sei.",
 "Ha coisas que fiz nas Galerias que nao faria agora. Isso e obvio — somos moldadas pelo que nos rodeia desde o comeco.<br><br>O que nao e obvio e quanto de mim ficou la mesmo depois que sai. Nao sao memorias. Sao reflexos. Quando alguem me ameaca, o primeiro movimento que meu corpo pensa e um que so faz sentido no contexto das Galerias.<br><br>Aprender novos reflexos e mais lento do que esperava. Mais dificil do que parecia la de fora.",
 "CARTA QUE NAO PODE CHEGAR EM CASA<br><br>Matriarca —<br><br>Escrevo sabendo que nunca chegara e que se chegasse seria destruida imediatamente.<br><br>Voces me enviaram para estudar o Limiar e o que opera ali. Fiz isso. Aprendi o que queriam que eu aprendesse. E aprendi mais do que queriam.<br><br>O que aprendi alem: o sistema que age na costa de Valtheris foi construido por alguem que pensava como as Galerias pensam. A logica e a mesma — contencao, preservacao, controle de acesso.<br><br>A diferenca e que quem construiu nao tinha intencao maliciosa. Apenas nao pensou nas consequencias de prazo longo. Nos pensariamos. Isso diz algo sobre o que somos."
    });

 _Setup(df, "c_confissao_drow_5", array{
 "REGISTRO FINAL — EXPEDICAO IDRITH'HAR — SO EU VOLTEI<br><br>Eramos doze quando entramos. Onze ficaram.<br><br>Nao morreram. Preciso deixar isso claro. O Limiar as absorveu de uma forma que nao consigo descrever completamente — minha lingua nao tem as palavras. Elas foram expandidas? Distribuidas? Continuam existindo, mas de uma forma que nao interage com o que existe aqui da mesma maneira que antes.<br><br>Voltar foi a decisao mais dificil e mais covarde que tomei. Talvez tambem a mais inteligente.<br><br>O que vi la dentro precisa ser reportado: o sistema que captura as almas na costa nao esta separado do Limiar. Eles se comunicam. Coordenam. Nao sei para que. Mas coordenam.",
 "CARTA PARA NENHUM OUVIDO — ULTIMA ENTRADA<br><br>Aprendi o suficiente para entender o que esta gravado nas paredes mais profundas. Nao vou transcrever aqui — nao porque seja proibido, mas porque quem lesse sem o contexto correto nao entenderia o suficiente para ser perigoso, mas entenderia o suficiente para ter medo das razoes erradas.<br><br>O que posso dizer: ha uma estrutura. Nao de nenhuma entidade individual — uma estrutura que opera como se tivesse intencao, mas que foi construida ha tanto tempo que os construtores ja nao existem para confirmar qual era essa intencao.<br><br>Estruturas com intencao embutida e sem supervisao viva sao as mais perigosas. Continuam fazendo o que foram feitas para fazer muito alem do ponto em que deveriam parar."
    });

    //   -- -- -- herbario_pequilho   -- -- --

 _Setup(df, "t_herbario_pequilho", array{
 "Ervas do Pantano Norte — Notas de Campo",
 "Guia das Raizes Amargas — Revisado",
 "Compendio Pequilho — Capitulo Quatorze",
 "Anotacoes da Curandeira Mira Voss",
 "Diario da Aprendiz Lena — Primeiro Ciclo"
    });

 _Setup(df, "c_herbario_pequilho_3", array{
 "ERVAS DO PANTANO NORTE — MIRA VOSS, CURANDEIRA<br><br>Raiz de Breijag: cresce onde a lama tem cheiro de ferro. Ferve em agua por meia hora. Para febre que nao cede e sonhos que nao param. Cuidado com a dose — demais, e os sonhos param junto com o resto.<br><br>Flor de Nevoa: azul-cinza, abre de madrugada, fecha ao sol. Colher antes do raio. Depois do raio e veneno.<br><br>Fungo do Tronco Podre: so da madeira de arvore que morreu em pe. A que caiu antes de morrer nao serve. Esmagar direto na ferida. Tira infeccao e fecha rapido.",
 "GUIA DAS RAIZES AMARGAS — REVISADO PELA MESTRA HALSKA<br><br>Das quatro raizes chamadas Amargas, tres tem uso medicinal e uma nao deve ser tocada sem luvas.<br><br>Amarela com estrias verdes: dor, sangramento, cansaco profundo. Mastigar — nao engolir.<br>Vermelha escura: febre e infeccao de pele. Cozinhar sempre, nao usar crua.<br>Preta e mole: para o cansaco que nao e do corpo. Para quem parou de querer acordar. Dose minima. Supervisao obrigatoria.<br><br>A quarta, branca com cheiro de mel podre: nao tocar. Nao ha uso medicinal conhecido. Ha apenas efeitos conhecidos, e sao todos ruins.",
 "NOTAS DE CAMPO — VIAGEM AO NORTE — DIAS 7 A 12<br><br>Dia 7: Erva do Esquecimento pela primeira vez fora dos livros. Cresce onde ha sangue velho no chao — nao necessariamente visivel. A erva encontra o sangue que a terra absorveu ha anos.<br><br>Dia 9: Coletei uma amostra. Meus dedos formigaram por horas. Nao e veneno de contato — o efeito foi mais parecido com memoria do que com dor. Como se a planta lembrasse algo, e meus dedos lembrassem junto.<br><br>Dia 12: Levando a amostra para a Mestra Halska. Eu sei o que a planta faz. Nao sei o que fazer com isso.",
 "COMPENDIO PEQUILHO — CAPITULO QUATORZE — PLANTAS DE CONFLITO<br><br>O campo de batalha e o solo mais rico para certas ervas. Nao por poesia — por quimica. Sangue fertiliza. Ossos calcificam o solo diferente da pedra.<br><br>Essas ervas sao mais potentes que as cultivadas, mais imprevisiveis. Os efeitos variam com o que foi derramado no solo onde cresceram.<br><br>Regra da escola Pequilho: nunca colher de campo de batalha sem descobrir antes quem morreu ali e de que. A planta absorve mais do que nutrientes.",
 "DIARIO DA APRENDIZ LENA<br><br>Hoje a Mestra Halska me mostrou a ultima erva do catalogo. A que nao tem nome no catalogo oficial — listada apenas como Planta X nos arquivos internos.<br><br>E bonita. Branca, quase translucida, raizes que parecem capilares.<br><br>A Mestra disse que apareceu pela primeira vez nos arredores do Limiar. Que nao cresce em nenhum outro lugar. Que toda tentativa de cultivar fora dali resulta numa planta que vai murchando em silencio ate morrer.<br><br>Perguntei por que entao cultivamos. Ela disse: porque as vezes precisamos entender algo dificil, mesmo que nao consigamos replicar."
    });

 _Setup(df, "c_herbario_pequilho_4", array{
 "TRATADO SOBRE PLANTAS DE USO ESPIRITUAL — PROIBIDO FORA DA GUILDA<br><br>A escola Pequilho reconhece tres categorias de planta que atuam sobre o que nao e fisico:<br><br>Categoria I — Plantas de Memoria: alteram o acesso a lembrancas, nao as lembrancas em si. O vivido permanece — muda como voce chega ate ele.<br><br>Categoria II — Plantas de Presenca: tornam o usuario perceptivel ou imperceptivel para entidades que habitam o espaco entre o visivel e o invisivel.<br><br>Categoria III — Plantas de Limiar: aproximam o usuario do estado entre vivo e nao-vivo. Perigosas. Uso supervisionado obrigatorio.<br><br>Ha uma Categoria Quatro. O Conselho da Guilda decidiu que seu registro existe apenas no arquivo mestre. Nao discutiremos aqui.",
 "CORRESPONDENCIA ENTRE CURANDEIRAS — RESTRITO<br><br>Halska —<br><br>A amostra que enviaste nao esta morta. Esta latente. Ha diferenca fundamental que a maioria nao aprendeu a reconhecer: planta morta se decompoe. Planta latente espera.<br><br>O que ela espera? Nao sei ao certo. Mas o padrao de latencia corresponde a especies que aguardam um gatilho ambiental especifico. Quando o gatilho ocorrer, ela vai despertar.<br><br>Recomendo local seco e escuro. Nao usar para nada ate entender o que ela aguarda.",
 "NOTAS DE MIRA VOSS — ULTIMAS ENTRADAS<br><br>Foi acidente. Nao ha outra palavra.<br><br>Preparava tintura comum quando adicionei, por distracao, a erva errada. O resultado nao foi o esperado — mas foi interessante de um jeito que me incomodou.<br><br>A tintura passou a reagir diferente dependendo de quem a tocava. Brilhava levemente para quem havia sofrido perda profunda. Ficava completamente inerte para quem nunca havia.<br><br>Plantas nao tem mecanismo sensorio para isso. E no entanto."
    });

 _Setup(df, "c_herbario_pequilho_5", array{
 "ARQUIVO RESTRITO — GUILDA PEQUILHO — PESQUISA SOBRE A PLANTA X<br><br>Noventa anos de observacao acumulada.<br><br>Origem confirmada: arredores do Limiar, raio de aproximadamente dois quilometros. Nenhum especime cultivado fora deste ambiente sobreviveu mais de noventa dias.<br><br>Propriedade principal identificada: a Planta X responde ao estado espiritual de quem a usa. Em quem tem ligacao forte com o material, produz efeito sedativo leve. Em quem tem ligacao com o espiritual, produz algo que nossos registros descrevem de forma inconsistente — cada curandeira que a usou descreveu experiencia diferente, mas todas descreveram como 'o momento mais claro da minha vida.'<br><br>Hipotese: a planta nao tem propriedade fixa. Ela amplifica o que o usuario ja e.<br><br>Se essa hipotese esta certa, a Planta X e simultaneamente a substancia mais util e mais perigosa no nosso catalogo."
    });

    //   -- -- -- cronica_orc   -- -- --

 _Setup(df, "t_cronica_orc", array{
 "Palavras do Velho Grak — Transcritas",
 "Cronica das Planicies Cinzas — Versao Orc",
 "O que Nossas Cicatrizes Dizem",
 "Memorias de Um Chefe sem Cla",
 "Os Mortos Pedem para Ser Lembrados"
    });

 _Setup(df, "c_cronica_orc_3", array{
 "PALAVRAS DO VELHO GRAK — TRANSCRITAS PELO CLERIGO HUMANO THOMAS<br><br>'Voces humanos escrevem tudo porque tem medo de esquecer. Nos nao escrevemos porque nao esquecemos o que importa.<br><br>O que importa nao e data. Nao e nome de rei. E: quem lutou com honra, quem traiu, quem caiu de pe e quem caiu de joelhos.<br><br>Isso fica no corpo. Passa de pai para filho nao em palavras — em como voce fica de pe quando esta com medo.<br><br>Se eu te ensinar a ficar de pe assim, ensinei mais do que qualquer livro.'",
 "Perdi meu cla em batalha. Nao porque perdemos — ganhamos. Mas depois nao havia nada para voltar.<br><br>O que e um Orc sem cla? Humano nao entende a pergunta. Para eles, um homem sem familia ainda e um homem. Para nos, um Orc sem cla e uma palavra sem frase.<br><br>Andei dois anos antes de entender que podia escolher o que seria. A escolha ainda me envergonha um pouco. Mas estou vivo e faco algo com o que tenho. Isso tem que ser suficiente.",
 "CRONICA DAS PLANICIES CINZAS — VERSAO ORC<br><br>Os livros humanos dirao que foi vitoria humana. Os livros humanos mentem por omissao.<br><br>Havia trezentos Orcs entre as forcas que lutaram ali. Trezentos contratados, sim — mas que lutaram como sempre lutamos.<br><br>Os livros nao mencionam os trezentos. Mencionam o general humano, o numero de mortos inimigos.<br><br>Nos lembramos cada um dos nossos. Por nome. Pelo jeito que lutavam. Pelo que disseram antes de cair. Isso tambem e historia — so gravada em lugares que voces nao procuram.",
 "O QUE NOSSAS CICATRIZES DIZEM — TEXTO RITUAL<br><br>Esta cicatriz: primeira batalha. Aprendi que medo e coragem nao sao opostos — sao companheiros.<br><br>Esta: o dia que protegi alguem fora do cla. Aprendi que lealdade pode crescer alem do sangue.<br><br>Esta: o dia em que errei e outro pagou pelo meu erro. Aprendi que responsabilidade e o peso que nao se tira mais.<br><br>Quando perguntam quem sou, aponto para as cicatrizes. Elas dizem a verdade sem palavras.",
 "ENSINAMENTO DO MESTRE DROKA<br><br>'A espada nao e a arma. Voce e a arma. A espada e extensao do que voce e.<br><br>Covarde com espada boa ainda e covarde. Guerreiro honrado com espada quebrada ainda e guerreiro honrado.<br><br>Treina o homem. A espada se treina sozinha quando o homem esta pronto.'"
    });

 _Setup(df, "c_cronica_orc_4", array{
 "MEMORIAS DO CHEFE GROVAK — GUERRA DO NORTE<br><br>Lutei com humanos de Aiglano por doze anos. No comeco me olhavam como qualquer Orc — mais arma que pessoa.<br><br>No decimo segundo ano me chamavam pelo nome. Para quem nunca foi chamado so pela raca, isso nao parece nada. Para mim era tudo — prova de que o que eu sabia sobre mim mesmo podia ser visto por outros, se olhassem tempo suficiente.<br><br>Nunca voltei ao cla depois. Nao porque os abandonei. Porque me tornei algo que nao cabia completamente em nenhum lugar. Esse e o preco de crescer alem de onde voce veio.",
 "OS MORTOS QUE PEDEM PARA SER LEMBRADOS — CRONICA ORAL<br><br>Ha uma coisa que os vivos devem aos mortos que nenhum codigo escreve: lembra-los de forma que faca sentido para quem eles eram.<br><br>Nao e elogio. Nao e santificacao. Lembrar direito e contar tambem os erros, as contradicoes, os momentos em que foram menos do que poderiam.<br><br>Morto perfeito e mentira. Mentira nao alimenta ninguem.<br><br>Os mortos que pedem para ser lembrados pedem memoria honesta. Nao gloria. Memoria.",
 "CARTA DE GRAK FILHO DE GRAK AO CONSELHO DOS CLAS<br><br>Fui chamado a responder por servir as forcas de Aiglano. Aceito ser julgado.<br><br>Mas peco que o julgamento considere: o que aprendi naquele servico me fez guerreiro mais capaz e pensador mais preciso. O que trouxe de volta nao foi submissao humana — foi perspectiva.<br><br>Voce nao conhece seus proprios limites sem ver onde os outros colocam os deles.<br><br>Julguem o ato. Nao julguem o homem que voltou com mais do que foi.",
 "LAMENTO DO ULTIMO XAMA DO CLA CINZA<br><br>Quando o cla morreu, o que mais me preocupou nao foi minha vida. Foi: quem vai lembrar?<br><br>Os espiritos dos nossos mortos precisam de memoria para ficarem ancorados. Quando ninguem lembra, ficam a deriva. Nao por escolha. Desorientados. Como qualquer um fica quando perde o fio de onde pertence.<br><br>Comecei a escrever para que pelo menos um texto sobrevivesse. Nao sei se e suficiente. Mas e o que tenho."
    });

 _Setup(df, "c_cronica_orc_5", array{
 "CRONICA DOS CLAS — O CAPITULO DO ESQUECIMENTO<br><br>Ha clas que pararam de existir sem batalha, sem derrota, sem traicao. Foram diluidos.<br><br>Os filhos foram para as cidades humanas. Os filhos dos filhos falavam idioma humano melhor que o proprio. Em tres geracoes, o nome do cla existia so em documentos que ninguem mais sabia ler.<br><br>E perda. Diferente de perda em batalha — mais lenta, mais silenciosa, dificil de resistir porque nao parece perda enquanto acontece. Parece escolha. Parece progresso.<br><br>So parece perda quando voce olha para tras e nao reconhece mais o caminho por onde veio.",
 "FRAGMENTO RITUAL — MESTRE DROKA — ULTIMAS PALAVRAS<br><br>Ha um momento na batalha em que voce para de pensar e comeca a ser. Nao inconsciencia — clareza. Tudo fica lento. Cada inimigo e uma equacao que o corpo resolve sem a mente atrapalhar.<br><br>Humanos chamam de frenesi. Nos chamamos de Clareza Vermelha.<br><br>Nao e raiva. E o oposto — e o momento de maior silencio interno que existe.<br><br>Esse mesmo estado existe fora da batalha. Em negociacoes. Em luto. Em qualquer pressao maxima.<br><br>O guerreiro que aprende a Clareza Vermelha fora da batalha e mais perigoso que qualquer forca fisica. Porque ele esta completamente presente enquanto os outros ainda estao no passado ou no futuro."
    });

    //   -- -- -- diario_catedral   -- -- --

 _Setup(df, "t_diario_catedral", array{
 "Anotacoes do Noviciado — Catedral dos Mortos",
 "Diario do Iniciado Marcus",
 "Reflexoes do Ciclo da Luz Velada",
 "Perguntas que Nao Devo Fazer — Irmao Corvin",
 "Nota de Partida — Para o Arquivo"
    });

 _Setup(df, "c_diario_catedral_3", array{
 "ANOTACOES DO NOVICIADO — CICLO 14<br><br>Terceiro mes. O Bispo diz que estou progredindo. Nao sei se ele esta certo — para mim progredir significa ter menos duvidas. Minhas duvidas crescem em vez de diminuir.<br><br>Perguntei ao irmao mais velho se isso era normal. Ele riu. Disse: 'Quando as duvidas param de crescer, parou de crescer tambem quem as tinha.'<br><br>Nao sei se isso me conforta ou me preocupa mais.",
 "DIARIO DO INICIADO MARCUS<br><br>Hoje a mestra falou sobre a Luz Velada. Disse que Alora nao e de revelacao constante — e de presenca constante que as vezes escolhe ser mais visivel.<br><br>A Luz Velada e quando a presenca esta la mas nao esta visivel. O ensinamento: como voce age quando ninguem esta olhando? Incluindo Alora?<br><br>Fiquei pensando nisso nas oracoes da tarde. Acho que me comporto diferente quando acho que ninguem ve. Isso e provavelmente o ponto.",
 "Dara —<br><br>Voce perguntou se acredito de verdade nAlora ou se estou aqui so para aprender medicina, usando o resto como cobertura.<br><br>Entrei com segunda intencao. Fiquei porque algo aqui e genuino de forma que nao esperava.<br><br>Nao sei se e Alora. Nao sei se e o ensinamento. Sei que quando estou na camara de meditacao as tres da madrugada sem ninguem me pedir para estar la, sinto algo que nao consigo nomear — e que me faz querer voltar.",
 "REFLEXOES — CICLO DA LUZ VELADA<br><br>Ha uma contradicao no coracao do ensinamento que ninguem quer discutir diretamente.<br><br>Se Alora e onipresente mas escolhe quando ser visivel, entao tambem escolhe quando nao ser visivel. O que significa que oracoes nao respondidas nao sao silencio — sao escolha.<br><br>O que significa que o sofrimento que poderia ser evitado por intervencao nao e negligencia. E intencao.<br><br>Perguntei ao Bispo. Disse que era uma pergunta bonita e me mandou ao jardim meditar.<br><br>Ainda estou meditando.",
 "Peco desculpas por partir sem aviso adequado.<br><br>Dois anos no Noviciado. Aprendi muito. Sou grato.<br><br>Mas aprendi o que o ensinamento oficial nao cobre: ha diferenca entre servir a um ideal e servir a uma instituicao. O ideal da Catedral e a Catedral dos Mortos sao relacionados — mas nao sao a mesma coisa.<br><br>Vou servir ao ideal onde ele me levar. Espero que a Catedral entenda. Suspeito que algumas pessoas dentro dela vao entender melhor que outras."
    });

 _Setup(df, "c_diario_catedral_4", array{
 "PERGUNTAS QUE NAO DEVO FAZER — IRMAO CORVIN<br><br>Primeira pergunta: se Alora cria e sustenta, o que criou a corrupcao que Alora combate? Nao uma forca externa — de onde vem o que precisa ser combatido?<br><br>Segunda pergunta: os que retornam sozinhos dos mortos — retornam por escolha ou sao trazidos? E se sao trazidos, por quem e por que?<br><br>Terceira pergunta: o sistema costeiro que os magistas mais velhos evitam discutir — foi construido por devotos da Catedral, por oponentes, ou por algo que nenhuma categoria cobre?<br><br>O Bispo disse que a terceira pergunta nao deveria ser feita dentro destas paredes. Isso foi ontem. Hoje a escrevo mesmo assim.",
 "DIARIO DO IRMAO MARCUS — ANO TRINTA E DOIS NA CATEDRAL<br><br>Quarenta anos atras eu diria que a fe era simples. Hoje sei que e simples do mesmo jeito que o oceano e simples — toda a complexidade esta abaixo do que se ve.<br><br>O que mantenho: a conviccao de que existe algo maior do que nos. Que Alora — seja la o que for em sua natureza completa — tem relacao com a luz, com a presenca gentil nos momentos dificeis.<br><br>O que larguei: a certeza de que entendo os mecanismos. A certeza de que a instituicao e o mesmo que o ideal.",
 "CARTA DO BISPO ALDRIC AO CONSELHO DOS PRELADOS — CONFIDENCIAL<br><br>Ha um novico neste ciclo que me preocupa — nao por mau carater. Pelo contrario. Preocupa porque faz perguntas que nao posso responder e que nao posso mandar calar.<br><br>Perguntou sobre os Retornados. Sobre o sistema costeiro. Sobre a corrupcao que Alora combate e de onde ela vem realmente.<br><br>Essas perguntas nao sao hereticas. Sao legitimas. E e exatamente por isso que sao problematicas — as respostas que tenho sao insuficientes. E novicos que descobrem isso tornam-se os melhores clerigos ou os que partem.<br><br>Peco orientacao do Conselho sobre como proceder.",
 "REFLEXOES TARDIAS — IRMA MARA — SEM DESTINATARIO<br><br>Trinta anos servindo Alora. Vinte dentro destas paredes, dez em campo.<br><br>A fe que tenho hoje nao e a fe que trouxe ao Noviciado. E mais forte em algumas formas. Muito mais humilde em outras.<br><br>O que vi em campo: sofrimento que a doutrina explica de formas insatisfatorias. Milagres que a doutrina explica de formas que soam como conveniencia retroativa.<br><br>O que mantenho: a conviccao de que a presenca que sinto nas camaras de meditacao e real. Que e maior do que eu. O resto e interpretacao humana de algo maior que qualquer interpretacao."
    });

 _Setup(df, "c_diario_catedral_5", array{
 "ARQUIVO RESTRITO — CATEDRAL DOS MORTOS — ACESSO: BISPO OU SUPERIOR<br><br>Depoimento do Irmao Corvin, tres dias antes de sua partida.<br><br>'Encontrei a documentacao que o Arquivo negava existir. Nao por burla — quem guardava genuinamente nao sabia o que guardava.<br><br>O sistema costeiro de transicao de almas foi construido em parte por devotos da Catedral. Nao por intencao malefica — por intencao de preservacao. Acreditavam que criavam espera segura para almas que precisavam de tempo.<br><br>O problema: o tempo que esperaram e muito mais longo do que previram. E o mecanismo de liberacao, que deveria existir, nao foi implementado.<br><br>Nao sei se foi descuido ou se algo aconteceu aos construtores antes de terminar o trabalho.<br><br>Mas se Alora sabe disso — e as oracoes chegam a algo que sabe e escolhe nao corrigir — isso e uma pergunta que a Catedral precisa responder antes que alguem de fora responda por ela.'",
 "DIARIO DO IRMAO CORVIN — ULTIMA ENTRADA<br><br>Saio nao por falta de fe. Saio porque a instituicao e a fe divergiram num ponto que nao consigo mais ignorar.<br><br>O que Alora representa — presenca, luz, acolhimento das almas em transito — acredito nisto completamente ainda.<br><br>O que a Catedral faz com esse ensinamento: as vezes serve. As vezes usa como cobertura para nao responder perguntas que precisam de resposta.<br><br>Ha almas em transito que aguardam ha tempo demais. A Catedral sabe que o sistema existe. Tem documentacao dos criadores.<br><br>E permanece em silencio.<br><br>Esse silencio e o que me faz sair."
    });

 if (who) SendSysMessage(who, "[Inerte DS] Chunk2 ok."); endif
endprogram
