use uo;
use os;
use datafile;

include ":livros_lacrados:scripts/setup_helper";

program SetupCifradoChunk3(who, cmdline)
 var df := OpenDataFile(":livros_lacrados:cifrado_textos");
    if (df.errortext)
 df := CreateDataFile(":livros_lacrados:cifrado_textos", DF_KEYTYPE_STRING);
    else
    endif
    if (df.errortext)
 if (who) SendSysMessage(who, "Erro df: " + df.errortext); endif
        return;
    endif

    //   -- -- -- tsu_ngathar   -- -- --

 _Setup(df, "c_tsu_ngathar_lingua", array{
 "Oitavo dia. Clã Ger-Voth recusou rendição.<br>Queimamos o celeiro. Eles queimaram o nosso.<br>Contagem: quarenta e três nossos. Sessenta e um deles.<br>Não se rende quem não tem onde voltar.<br>Amanhã atacamos pela água. A lama é nossa aliada.<br>Assinado por Vruk, Língua de Sangue do Clã Dorth.",
 "Acordo entre Clã Dorth e Clã Makra.<br>Um: compartilhamos as passagens do desfiladeiro até a próxima colheita.<br>Dois: nenhum filho de Dorth mata filho de Makra sem testemunha.<br>Três: se Makra falhar, Dorth retoma tudo. Sem palavras. Só a ação.<br>Selado em sangue de ambos os Chefes.<br>Violação deste acordo autoriza guerra total.",
 "Aqui jaz Urgas, filho de Vruk, filho de Dorth.<br>Morreu em combate. Não fugiu.<br>Matou seis antes de cair. O sétimo era maior que ele.<br>Não há vergonha nisto.<br>O clã lembrou seu nome por três gerações.<br>Após a terceira geração, o nome volta ao silêncio.<br>Esse é o destino dos guerreiros: lembrado, depois esquecido.<br>Que o silêncio seja honrado."
    });

 _Setup(df, "c_tsu_ngathar_magia", array{
 "O papel carrega raiva velha.<br>Quem escreveu segurou a pena com força demais —<br>cada traço é um punho fechado.<br>Há orgulho aqui. E sob o orgulho, algo menor:<br>medo de que o número de mortos já não justifique a guerra.<br>Esse medo nunca foi escrito. Ficou na pressão da mão.",
 "Dois homens assinaram este papel.<br>Um acreditava no acordo. O outro já planejava quebrar o terceiro ponto.<br>Ambas as intenções estão aqui, sobrepostas.<br>O papel não sabe distinguir — guardou as duas com igual fidelidade.<br>A contradição não resolvida ficou impressa.<br>Lê-se como tensão: o texto diz paz, o papel diz outra coisa.",
 "Quem escreveu a lápide estava exausto.<br>Não de trabalho — de luto que não sabia nomear.<br>Os Gumnak não choravam. Esse sabia disso.<br>Mas a intenção de chorar ficou nos traços:<br>a letra vacila no ponto onde deveria dizer que o nome seria esquecido.<br>Três gerações. Era mais do que o autor esperava para si mesmo."
    });

 _Setup(df, "c_tsu_ngathar_arq", array{
 "Transcrição acadêmica — Coleção Dorth, fragmento 7.<br>Este registro data do período das Guerras de Celeiro,<br>anterior à fragmentação dos grandes clãs Gumnak.<br>Vruk, Língua de Sangue, aparece em outros três fragmentos —<br>papel de negociador e registrador, incomum para a época.<br>A derrota do Clã Ger-Voth corresponde<br>ao que explica sua ausência completa nos registros posteriores.",
 "Nota de campo — Desbravador, expedição ao Pico Cinza.<br>Encontrado junto a ossos. Dois conjuntos distintos, diferentes idades.<br>O texto é acordo formal, raro para o período oral Gumnak.<br>O 'sangue de ambos os Chefes' é literal — mancha marrom-escura<br>ainda visível no canto inferior esquerdo.<br>Os Clãs Dorth e Makra desapareceram simultaneamente dos registros,<br>o que sugere guerra total ou colapso externo comum.",
 "Coleção Funerária Gumnak — Peça 14. Origem: tumba coletiva, serra norte.<br>As lápides Gumnak escritas são raríssimas — escrita reservada a contratos.<br>A estrutura 'lembrado por três gerações, depois silêncio'<br>aparece aqui pela primeira vez e depois em seis outros fragmentos.<br>Urgas, filho de Vruk: o patronímico conecta ao registrador de batalha.<br>Se a identificação for correta, Vruk enterrou o próprio filho<br>dois anos após registrar a guerra que o matou."
    });

    //   -- -- -- primeiro_lacre   -- -- --

 _Setup(df, "c_primeiro_lacre_lingua", array{
 "Que fique registrado para quem vier depois:<br>o Acordo das Cinco Mãos não foi feito por fé.<br>Foi feito por necessidade.<br>Cada um de nós cedeu algo que não queria ceder.<br>Chamamos isso de fundação. Era rendição.<br>Que os que vierem depois nos honrem pelo resultado,<br>não pelas intenções — porque as intenções eram menores<br>do que o peso que carregamos aquela noite.<br>Selado no décimo quinto dia do mês do Gelo Tardio.",
 "Por decreto do Conselho de Lacramento, em nome do Pacto:<br>O Arquivo de Lir-Aneth é selado.<br>Nenhum documento interno pode ser consultado sem aprovação das Três Vozes.<br>O lacramento é permanente até revogação formal.<br>Não haverá revogação formal.<br>Que quem encontrar este decreto entenda:<br>o que está dentro de Lir-Aneth deveria ter sido queimado.<br>Não foi queimado porque alguns de nós não tiveram coragem.<br>Este decreto é a nossa covardia com verniz de solenidade.",
 "Juramento de Fundação, vigésima cópia — uso interno:<br>Prometemos servir ao Pacto acima de cada fação individual.<br>Prometemos não usar os poderes que o Pacto nos conferiu<br>para benefício das nossas linhagens particulares.<br>Prometemos registrar os mortos que o Pacto exigir.<br>Prometemos silêncio sobre o custo real da fundação.<br>Este último juramento foi adicionado por pedido unânime.<br>Nenhum de nós conseguiu olhar para os outros quando o adicionamos."
    });

 _Setup(df, "c_primeiro_lacre_magia", array{
 "O papel carrega alívio e vergonha na mesma camada.<br>Quem escreveu estava cansado de carregar algo sozinho.<br>O Pacto foi a descarga desse peso — mas a descarga teve preço.<br>A intenção aqui não é grandeza: é sobrevivência disfarçada de grandeza.<br>Embaixo do verniz solene, um pensamento que nunca foi escrito:<br>que pelo menos isso funcione, porque não tenho mais nada a dar.",
 "Quem escreveu este decreto sabia que estava mentindo.<br>A palavra 'permanente' foi escolhida para soar mais do que era.<br>A última linha — sobre covardia com verniz de solenidade —<br>foi escrita de impulso, depois quase apagada.<br>Não foi apagada. Ficou.<br>Quem escreveu sabia que quem encontrasse precisaria saber.<br>A confissão embutida no decreto que proíbe confissões.",
 "Cinco pessoas assinaram este juramento.<br>Uma acreditava em cada palavra.<br>Três assinaram por dever.<br>Uma assinou por medo de ser a única a não assinar.<br>O papel guarda as cinco intenções sem distingui-las.<br>Mas quem lê com atenção sente a diferença de pressão:<br>uma assinatura mais firme que as outras quatro.<br>A que acreditava. Ou a que mais temia."
    });

 _Setup(df, "c_primeiro_lacre_arq", array{
 "Arquivo Central do Pacto — Fragmento Fundacional 1-C.<br>Classificação: restrito. Acesso: Desbravadores Natos, grau 3.<br>'Acordo das Cinco Mãos' é termo que não aparece em nenhum documento público.<br>A referência à necessidade como fundamento contradiz<br>a narrativa oficial do Pacto como 'ato de visão compartilhada'.<br>O 'mês do Gelo Tardio' situa este texto na geração anterior às facções atuais.<br>Os fundadores conheciam os custos. Optaram por não transmiti-los.",
 "Nota de análise — Instituto de Pesquisa Histórica.<br>O Arquivo de Lir-Aneth: terceira menção encontrada até hoje.<br>As duas anteriores eram referências indiretas. Esta é explícita.<br>A afirmação de que o conteúdo 'deveria ter sido queimado'<br>e não foi por falta de coragem é clinicamente importante.<br>Implica que o Conselho de Lacramento sabia o que estava lacrado<br>e escolheu preservar em vez de destruir.<br>A localização de Lir-Aneth permanece desconhecida.",
 "Coleção Interna — vigésima cópia do Juramento de Fundação.<br>O quarto juramento — silêncio sobre o 'custo real da fundação' —<br>é a linha mais carregada deste documento.<br>Nenhum registro histórico quantifica esse custo.<br>A nota final ('nenhum de nós conseguiu olhar') foi escrita<br>pelo mesmo amanuense das outras linhas, mas com caligrafia alterada.<br>O amanuense tremeu. O que quer que tenha testemunhado, ficou nele."
    });

    //   -- -- -- vael_glifo   -- -- --

 _Setup(df, "c_vael_glifo_lingua", array{
 "A maré vem da mesma direção desde que meu pai era criança.<br>Meu pai dizia que as marés ensinam paciência.<br>Eu dizia que as marés ensinam chegada e partida.<br>Agora sei que as marés ensinam a diferença entre os dois.<br>Chegada é visível. Partida é o que fica depois que a água vai.<br>Nós partimos. O que fica somos nós mesmos,<br>depositados na areia como conchas que a água não quis levar.",
 "Canto da Vigília do Litoral — entoado pela última Mãe Cantante:<br><br>Aqueles que passam pela costa sabem que há algo aqui.<br>Não o vento. Não a vaga.<br>Algo que espera sob a linha onde o mar encontra o céu.<br>Cantamos para que saibam que vimos.<br>Cantamos para que lembrem que cantamos.<br>Após nós, o silêncio não vai ser o mesmo.<br>Vai ser um silêncio que esteve cheio.",
 "Este não é um mapa. A‰ um aviso disfarçado de mapa.<br>A Rota das Marés não segue correntes naturais.<br>Segue fome.<br>Onde os barcos somem sem tempestade,<br>onde os pescadores voltam sem memória da viagem,<br>onde o mar cheira a algo que não é água — ali está a boca.<br>Não navegue de noite. Não navegue só.<br>Não cante perto da costa norte entre lua nova e lua cheia.<br>O canto atrai. Sempre atraiu. Agora sabemos o quê."
    });

 _Setup(df, "c_vael_glifo_magia", array{
 "O papel foi molhado uma vez e secou com cuidado.<br>Quem escreveu não queria que parecesse que havia chorado.<br>A intenção aqui é despedida disfarçada de filosofia.<br>O pai mencionado estava morto quando estas linhas foram escritas.<br>A conversa sobre marés nunca aconteceu — foi inventada<br>para dar peso a uma partida que não podia ser nomeada diretamente.<br>A saudade impressa aqui é de futuro, não de passado.",
 "A Mãe Cantante que escreveu este canto sabia que era a última.<br>A frase 'após nós' foi escrita primeiro como 'após mim'<br>e corrigida — a emenda está nos traços fantasmas sob a tinta.<br>Ela escolheu o plural para não ser a única a carregar o peso do fim.<br>A intenção de registrar para quem vem depois é real.<br>Mas também há raiva aqui, fina como agulha:<br>raiva de que quem viesse depois não fosse dela.",
 "Este documento foi escrito com medo.<br>Não medo de ser encontrado — medo de não ser encontrado.<br>Quem escreveu queria que alguém soubesse.<br>A intenção de aviso é urgente, quase desesperada:<br>cada detalhe prático — lua nova, canto, costa norte —<br>foi escrito como se a vida de quem lesse dependesse disso.<br>Porque dependia. O autor já havia perdido alguém para a Rota.<br>O espaço onde esse nome deveria estar<br>está em cada linha que o circunda."
    });

 _Setup(df, "c_vael_glifo_arq", array{
 "Coleção Haiei — Fragmento Costeiro 3. Fonte: Litoral Mudo, sítio submerso.<br>A metáfora da concha como resto humano pós-partida<br>é recorrente na poesia Haiei tardia — sinal de período de declínio.<br>O texto usa forma de meditação pessoal,<br>mas a linguagem é formal demais para ser privada.<br>Os Haiei documentavam o fim como ritual, não como tragédia.<br>Esta distinção é fundamental para entender por que<br>não fugiram quando ainda havia tempo.",
 "Nota de campo — Arqueólogo Senna Vrael, Litoral Mudo.<br>Terceiro canto de vigília Haiei encontrado nesta expedição.<br>A 'Mãe Cantante' aparece em todos os três como figura ritual específica.<br>A frase 'silêncio que esteve cheio' é tecnicamente impossível em linguística.<br>Os Haiei não usavam impossibilidade como erro — usavam como precisão.<br>O silêncio do Litoral Mudo hoje corresponde exatamente ao que este canto descreve.<br>Recomendo lacramento desta coleção — por respeito a quem cantou.",
 "Coleção Rota das Marés — Documento Técnico Haiei 1.<br>O mais antigo documento não-poético Haiei encontrado até hoje.<br>Os Haiei sabiam da natureza predatória da Rota desde o início do declínio.<br>O aviso contra canto noturno na costa norte é consistente<br>com registros posteriores de desaparecimentos.<br>Nenhum pescador da costa norte atual canta de noite.<br>Perguntados sobre o motivo, dizem que sempre foi assim.<br>Não sabem de onde veio o costume. Agora sabemos."
    });

 if (who) SendSysMessage(who, "[Cifrado DS] Chunk3 ok."); endif
endprogram
