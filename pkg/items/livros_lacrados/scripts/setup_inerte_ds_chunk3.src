use uo;
use os;
use datafile;

include ":livros_lacrados:scripts/setup_helper";

program SetupInerteChunk3(who, cmdline)
 var df := OpenDataFile(":livros_lacrados:inerte_textos");
    if (df.errortext)
 df := CreateDataFile(":livros_lacrados:inerte_textos", DF_KEYTYPE_STRING);
    else
    endif
    if (df.errortext)
 if (who) SendSysMessage(who, "Erro df: " + df.errortext); endif
        return;
    endif

    //   -- -- -- relato_mercador   -- -- --

 _Setup(df, "t_relato_mercador", array{
 "Diario de Rota — Ciclo Sete",
 "Caderno de Precos e Segredos",
 "Notas de Viagem — Fronteira Norte",
 "Registro de Trocas — Colheita Tardia",
 "Nota sobre Um Cliente Incomum"
    });

 _Setup(df, "c_relato_mercador_3", array{
 "DIARIO DE ROTA — CICLO 7<br><br>Terceiro dia apos o ultimo posto de Aiglano. A estrada ficou mais estreita aqui — nao pelo mato, que foi cortado recentemente, mas por marcas laterais que nao reconheco. Como se a propria estrada tivesse encolhido por escolha propria.<br><br>Vendi as especiarias mais rapido do que esperava. A mulher que comprou pagou em moeda Khar — pesada, quadrada, com divida gravada nas bordas. Disse que o mercado de Aiglano estava fechado por razoes que ela nao queria detalhar.<br><br>Nao perguntei. Ha perguntas que mercador que quer continuar vivo aprende a nao fazer.",
 "CADERNO DE PRECOS E SEGREDOS — USO PESSOAL<br><br>O que ninguem ensina sobre mercado: o preco de uma coisa raramente tem a ver com a coisa. Tem a ver com quem precisa, quanto, e o quao desesperadamente.<br><br>Mercador experiente nao vende produto. Vende a solucao pro problema que o produto resolve.<br><br>Aprendi isso em Valtheris. Em outros lugares aprendi a trocar. Aqui aprendi o que esta sendo realmente trocado.<br><br>Na semana passada negociei especiarias, sim. Mas o que estava sendo negociado de verdade era diferente em cada caso: seguranca, informacao, acesso, um favor a ser cobrado depois.",
 "NOTAS DE VIAGEM — FRONTEIRA NORTE<br><br>O posto de troca mudou de lugar desde a ultima vez. Nao muito — uns duzentos metros para leste. Mas mudou, e nenhum dos outros mercadores pareceu notar.<br><br>Perguntei ao guardiao. Ele disse que sempre esteve ali. Mostrei o meu mapa. Ele olhou com expressao que nao era confusao — era desconforto.<br><br>Guardei o mapa. Vendi o que tinha. Fui embora sem fazer mais perguntas.<br><br>Mercador que sobrevive aprende quando parar.",
 "REGISTRO DE TROCAS — CICLO DA COLHEITA TARDIA<br><br>Khar: 40 unidades de minerio processado, qualidade boa. Paguei em tecido de la dupla e dois licores de Brumajord. O anao que negociou era novo — maos limpas demais para galeria. Anotei.<br><br>Bjorske: peles de inverno acima do esperado para a epoca. Pagaram em moeda de Aiglano recente. Alguem esta intermediando mais do que eu sabia.<br><br>Nota: quando culturas diferentes usam moeda da mesma origem sem explicacao, ou ha paz que ninguem me contou, ou alguem esta comprando paz a meu redor.",
 "NOTA SOBRE UM CLIENTE INCOMUM<br><br>O homem que comprou toda a minha carga de pergaminho pagou sem negociar. Isso nao e normal. Mercado tem rito — negocia-se. Ele nao negociou. Pagou, pegou, foi.<br><br>Tres coisas: o valor era exatamente o que eu precisava para quitar minhas dividas do ciclo. Nem um centavo a mais. Ele nao podia saber isso.<br><br>As vestes nao tinham marca de cla, cidade, legiao ou guilda. Em Valtheris, todo mundo tem marca de alguma coisa.<br><br>Quando foi embora, caminhou para o norte — onde nao ha mercado por pelo menos cinco dias de rota.<br><br>Nao sei o que fazer com isso. So sei que aconteceu."
    });

 _Setup(df, "c_relato_mercador_4", array{
 "NOTA DE ROTA — PARA USO PROPRIO<br><br>A Liga usa mercadores como eu para mover informacao. Eu sabia disso. O que nao sabia e que eles usam a propria informacao como moeda de segunda camada.<br><br>Funciona assim: voce carrega mercadoria real como cobertura. Mas a informacao que voce carrega — sobre rotas, sobre quem esta onde, sobre o que esta escasso — essa informacao chega ao destino por outro caminho, antes de voce.<br><br>Quando voce chega, o comprador ja sabe o que voce sabe e negocia de posicao de forca.<br><br>Dois anos para entender o mecanismo. Agora que entendi, me pergunto se sempre fui agente da Liga sem saber.",
 "DIARIO — CICLO LONGO — COSTA<br><br>Tres meses no mesmo trecho. Posso dizer com certeza: o comercio costeiro funciona de forma diferente do interior. Nao diferente de mercado para mercado — diferente em natureza.<br><br>Os pescadores da costa nao vendem so peixe. Vendem informacao sobre o que vem do mar. E o que vem do mar nao e so peixe.<br><br>Se voce e mercador e esta lendo isso: quando o pescador hesitar antes de dar o preco, nao esta calculando o produto. Esta calculando outra coisa.<br><br>Pergunte o que foi bom na pescaria. O que voce ouvir nao vai ser sobre peixe.",
 "CARTA PARA MERICK — NAO ENVIADA<br><br>O que descobri nao cabe em carta normal. Por isso nunca enviei esta.<br><br>O mercado do norte nao esta lento por causa da Legiao. Esta lento porque ha um terceiro comprador que nao aparece nos registros mas move volume suficiente para alterar precos sem ser visto.<br><br>Rastreei tres transacoes. O dinheiro vai para um intermediario, que vai para outro, que desaparece.<br><br>O que esse terceiro compra: nao e categoria de produto. E informacao. Tudo que passa pelas maos dele tem so uma coisa em comum — saber coisas.<br><br>Nao sei quem e. Sei que tem muita paciencia e muito ouro.",
 "CADERNO DE CAMPO — VIAGEM AO LESTE<br><br>Aprendi a distinguir tres tipos de fronteira:<br><br>A fronteira dos mapas: uma linha, um marco, um posto. Sem surpresa.<br><br>A fronteira que os locais sabem: uma curva especifica na estrada, a aldeia onde voce para de ser estrangeiro, o rio cujo nome muda de margem para margem. So se aprende vivendo.<br><br>A fronteira das mercadorias: o ponto alem do qual certos produtos mudam de valor sem aviso. Nenhum mapa mostra. So se aprende perdendo dinheiro ou ganhando dinheiro sem entender por que, varias vezes.<br><br>Sou bom no segundo. Razoavel no terceiro. No primeiro qualquer um serve.",
 "NOTA SOBRE UM PADRAO — USO PESSOAL<br><br>Vinte e dois anos de estrada: o comercio segue necessidade, a necessidade segue medo.<br><br>O que vejo agora e diferente. O comercio costeiro responde a algo que nao e necessidade humana normal. Nao e falta de produto, nao e excesso de demanda.<br><br>E como se algo comprasse em padroes que fazem sentido para um objetivo que nao consigo ver inteiro. Cada transacao parece razoavel isolada. O padrao, quando ploto no mapa e no tempo, nao faz sentido para nenhum objetivo comercial que conheco.<br><br>Mostrei para um analista da Liga. Ficou em silencio. Disse: 'Continue mapeando. Nao compartilhe com ninguem. E se alguem perguntar sobre suas rotas costeiras, minta.'<br><br>Estou mapeando. Estou mentindo quando perguntam."
    });

 _Setup(df, "c_relato_mercador_5", array{
 "CADERNO RESERVADO — NAO ABRIR<br><br>Entendi o padrao.<br><br>O que esta sendo comprado nao e mercadoria. E presenca. A presenca de pessoas especificas em lugares especificos em momentos especificos.<br><br>O terceiro comprador nao compra produto. Compra rotas. Compra para que certos mercadores passem por certos pontos em certos momentos.<br><br>Para que? Sei que todos os pontos ficam na costa. Sei que a costa tem algo que os textos mais velhos chamam de caminho das aguas. Sei que esse caminho funciona melhor quando ha fluxo de pessoas acima dele.<br><br>Estamos alimentando algo. Sem saber.<br><br>Nao escrevo para onde vou. Quem encontrar este caderno vai entender por que.",
 "MEMORANDO — SE EU NAO VOLTAR<br><br>O que descobri sobre a Liga nao e o que a Liga quer que se descubra.<br><br>A Liga acredita que gerencia o fluxo de informacao em Valtheris. Gerencia. Mas ha uma camada acima que a Liga nao sabe que existe.<br><br>Quem opera essa camada nao tem nome nos registros que encontrei. Tem padroes — decisoes que beneficiam algo diferente de qualquer interesse economico identificavel.<br><br>A Liga e eficiente e bem-intencionada em sua maior parte. Mas esta sendo usada como instrumento por algo que pensou mais adiante do que os fundadores conseguiram pensar.<br><br>Deixo este caderno com instrucoes de entrega-lo ao Conselho do Norte se eu nao aparecer em quarenta dias.<br><br>Vou aparecer. Espero aparecer.",
 "NOTA FINAL — PARA QUEM ENCONTRAR<br><br>Vinte e tres anos de rota. Conheco o comercio de Valtheris melhor do que a maioria dos que ficam na cidade.<br><br>O que aprendi nao se aprende em livro: o que circula por esta ilha nao e so produto e moeda. Circula informacao, medo, divida, promessa, segredo. E circula algo mais que eu ainda nao soube nomear completamente.<br><br>Ha algo na costa que nao e so agua. Ha algo nas rotas que nao e so caminho. E ha algo no que os mercadores carregam sem saber que carregam que serve a um proposito que nenhum de nos escolheu servir.<br><br>Escrevo isso porque e verdade e porque verdade que ninguem escreve eventualmente desaparece.<br><br>Quem ler e mercador: preste atencao para onde te mandam e quando. Pergunte por que esse lugar, por que esse momento. A resposta que receberem nao va ser a unica resposta que existe."
    });

    //   -- -- -- nota_espiao_liga   -- -- --

 _Setup(df, "t_nota_espiao_liga", array{
 "Nota de Campo — Agente R.",
 "Instrucoes para Descarte — Uso Unico",
 "Bilhete de Recrutamento — Primeira Abordagem",
 "Despacho Interceptado — Cera da Liga",
 "Correspondencia Operacional — Codigo Verde"
    });

 _Setup(df, "c_nota_espiao_liga_3", array{
 "NOTA DE CAMPO — AGENTE R. — USO UNICO<br><br>Alvo observado por seis dias. Rotina consistente. Vulnerabilidade identificada: terca-feira, entardecer, quarenta minutos sem cobertura entre o mercado e a residencia.<br><br>Nao recomendo abordagem direta neste ciclo. O alvo demonstrou, em pelo menos duas ocasioes, capacidade de detectar vigilancia. Como detecta: desconhecido.<br><br>Recomendo rotacao de observador a cada tres dias para nao estabelecer padrao.<br><br>R.",
 "INSTRUCOES PARA DESCARTE — LEIA E DESTRUA<br><br>Esta nota nao pode ser encontrada na sua posse. Se foi encontrada, voce falhou em algo que nao deveria ter falhado.<br><br>Ponto de contato muda a cada tres reunioes. O proximo sera comunicado pela forma usual. Se nao sabe qual e a forma usual, nao deveria estar lendo este documento.<br><br>Trabalho desta semana: observacao apenas. Sem interacao, sem contato, sem registro que possa ligar voce ao alvo.<br><br>A Liga nao reconhece agentes que falham no silencio.",
 "BILHETE DE RECRUTAMENTO — PRIMEIRA ABORDAGEM<br><br>Voce foi observado por quarenta e dois dias. Habilidades adequadas. Discricao adequada. Motivacao ainda em avaliacao, mas sinais iniciais sao positivos.<br><br>Este bilhete e seu unico convite. Se nao agir nos proximos seis dias, consideramos a resposta como nao.<br><br>Para responder: va ao mercado de peixe pela manha. Compre peixe defumado — do segundo vendedor da esquerda, estande coberto por tecido azul. Pague em exato. Nao espere troco.<br><br>Voce sera contatado.",
 "DESPACHO INTERCEPTADO — ANALISE INTERNA<br><br>Este despacho nao chegou ao destino original. Isso e intencional — interceptar e analisar antes de reencaminhar e procedimento padrao para comunicacoes fora dos canais aprovados.<br><br>Conteudo: genuino, valor operacional real.<br><br>O agente que enviou esta se comunicando fora dos canais. Por que? Medo de comprometimento interno? Lealdade dividida? Iniciativa bem-intencionada nao-autorizada?<br><br>Cada opcao exige resposta diferente. Aguardando instrucao do Conselho Interno.",
 "CORRESPONDENCIA OPERACIONAL — CODIGO VERDE<br><br>Operacao no setor norte dentro dos parametros. Contato secundario estabelecido sem incidentes. Cobertura funcionando — alvo nao demonstra suspeita.<br><br>Problema menor: o informante local esta pedindo mais do que o acordado. Nao em ouro — em informacao. Quer saber para quem trabalhamos.<br><br>Recomendacao: dar informacao parcial e verdadeira que satisfaca sem comprometer. Nunca mentir para informante de longo prazo — eles testam sempre.<br><br>Aguardando confirmacao para continuar."
    });

 _Setup(df, "c_nota_espiao_liga_4", array{
 "ANALISE OPERACIONAL — CLASSIFICADO — NIVEL DOIS<br><br>A Liga opera em Valtheris ha pelo menos setenta anos. Mais do que a maioria dos governos que tentou nos monitorar.<br><br>O que nos mantem: nao somos faccao politica. Nao temos territorio. Nao temos ideologia alem da estabilidade — definicao ampla o suficiente para nos alinhar com qualquer forca que prefira Valtheris existindo.<br><br>O que nos ameaca: nao sao inimigos externos. E a fragmentacao interna. Cada celula que descobre que outras celulas existem comeca a questionar. Cada agente que fica ativo demais desenvolve agenda propria.<br><br>Por isso as operacoes sao compartimentadas. Por isso agentes nao sabem mais do que precisam.<br><br>Nao por crueldade. Por sobrevivencia.",
 "DIARIO DE OPERATIVO — SELADO PARA O NIVEL TRES<br><br>Doze anos na Liga. Posso finalmente dizer algumas coisas com certeza.<br><br>A Liga nao e o que diz ser para os recrutados. Isso e verdade de toda organizacao.<br><br>No nivel tres: a Liga e uma estrutura de gerenciamento de informacao que serve, em ultima analise, a objetivos que nem os membros do Conselho Interno entendem completamente. Alguem a fundou com proposito especifico. Esse proposito esta embutido nos procedimentos e continua operando mesmo que ninguem mais saiba qual era.<br><br>Estou tentando descobrir o proposito original. Nao para mudar nada — para saber para o que trabalho.",
 "NOTA PARA NOVO RECRUTADO — ORIENTACAO INFORMAL<br><br>O que ninguem diz na orientacao formal:<br><br>Um — A Liga sabe mais sobre voce do que voce pensa. Antes de ser abordado, foi analisado por meses. Honestidade dentro dos canais e a unica politica. Mentira interna e o unico pecado que resulta em expulsao imediata.<br><br>Dois — O anonimato e real mas limitado. Dentro da Liga voce tem identidade completa. Fora, sua cobertura e robusta. Nas transicoes entre um estado e outro, voce e vulneravel. Aprenda a gerenciar as transicoes.<br><br>Tres — A Liga serve a algo. Nao sabemos completamente a que. Quando souber, vai entender por que vale. Ate la, confie no processo.",
 "CORRESPONDENCIA NIVEL QUATRO — OPERACAO SEM NOME<br><br>Esta operacao nao tem nome. Nomes criam memoria, e o que estamos fazendo nao deve ser lembrado da forma usual.<br><br>O que estamos fazendo: mapeando uma rede de coleta de informacao paralela ao mercado costeiro. Alguem coleta inteligencia em volumes que superam qualquer operacao que documentamos, usando mercadores que nao sabem que sao canais.<br><br>Os mercadores nao sao agentes — sao inadvertentes. O que sao deliberados e outra questao.<br><br>Se a rede e operada por humanos, queremos saber quem. Se nao e humana — e ha indicacoes que nao e — queremos saber o que.<br><br>Ambas as respostas mudam como operamos.",
 "RELATORIO DE INCIDENTE — FRONTEIRA NORTE<br><br>O agente Vennir foi comprometida durante o mapeamento. Nao por falha — por algo que nao esta em nenhum manual.<br><br>Protocolo padrao. Cobertura intacta. O alvo nao a detectou.<br><br>O que a comprometeu foi uma terceira presenca que ninguem havia mapeado. Nao completamente humana. Estava no local antes de Vennir. Sabia que ela viria antes de ela chegar.<br><br>Vennir saiu intacta. Disse que a presenca nao era hostil. Disse que parecia curiosa — da forma que alguem fica curioso ao observar outra operacao de inteligencia.<br><br>Aguardando classificacao do Conselho."
    });

 _Setup(df, "c_nota_espiao_liga_5", array{
 "ARQUIVO NIVEL MAXIMO — HISTORIA DA LIGA<br><br>O fundador da Liga nao era humano. Descoberto tres geracoes apos a fundacao, por acidente, durante revisao de arquivo.<br><br>As descricoes fisicas no documento de fundacao nao correspondem a nenhum humano dos registros historicos. As decisoes de estrutura da Liga — compartimentalismo extremo, prioridade pela sobrevivencia de longo prazo sobre objetivos imediatos, mandato de 'preservar a capacidade de Valtheris de existir' — fazem mais sentido para algo que pensa em seculos.<br><br>O que isso significa para quem trabalhamos: incerto.<br><br>O Conselho nao divulgara isso abaixo do nivel quatro. Registro aqui por integridade historica e porque quem vier depois tem direito de saber de onde vem o que serve.",
 "NOTA FINAL — OPERATIVO DEZOITO — ANTES DA EXTRACAO<br><br>Quinze anos. Nunca vacilei.<br><br>Vacilo agora.<br><br>O que descobri na operacao costeira nao pode ser trazido de volta para a Liga sem consequencias — nao para mim, para a Liga inteira.<br><br>O proposito original embutido nos procedimentos que ninguem mais lembra tem conexao com o sistema costeiro de transicao de almas.<br><br>A Liga foi fundada para que Valtheris continue existindo. O sistema costeiro garante que certas almas nao sigam adiante. Essas duas coisas nao sao coincidencia.<br><br>Alguem criou uma rede de inteligencia para proteger o sistema. Ou criou o sistema e depois criou a rede como protecao.<br><br>Nenhuma das opcoes me agrada. A Liga precisa saber.",
 "MEMORANDO DE DISSOLUCAO — OPERACAO SEM NOME<br><br>A operacao esta encerrada. Nao por falha — por sucesso de tipo que nao esperavamos.<br><br>Encontramos o que procuravamos. O que procuravamos era maior do que o que a operacao foi desenhada para encontrar.<br><br>Registros movidos ao arquivo de nivel cinco. Sem acesso abaixo do Conselho Supremo.<br><br>Para os agentes desta operacao: o que sabem e real. O que sentiram na costa era correto — havia algo observando nossa operacao da mesma forma que observavamos nosso alvo.<br><br>Esse algo e paciente. Seus objetivos se alinham com os da Liga em alguns pontos. Divergem em outros que ainda nao conseguimos mapear.<br><br>Por enquanto: manter vigilancia. Nao iniciar contato. Se contato vier do outro lado — reportar imediatamente ao Conselho Supremo."
    });

    //   -- -- -- testemunho_retornado   -- -- --

 _Setup(df, "t_testemunho_retornado", array{
 "Depoimento: Apos o Retorno — Sem Nome",
 "Notas Pessoais de Quem Voltou Diferente",
 "Carta Para Minha Familia — Nunca Enviada",
 "O que E Ser Dois ao Mesmo Tempo",
 "Depoimento — Seis Meses Depois"
    });

 _Setup(df, "c_testemunho_retornado_3", array{
 "DEPOIMENTO COLETADO PELO IRMAO CORVIN — SEM NOME<br><br>'Nao me pergunte o que e estar la. Nao tenho palavras certas. As que tenho sao erradas.<br><br>O que posso dizer: quando voltei, sabia que tinha voltado. Isso parece obvio — nao e. Ha casos em que a pessoa voltou mas nao sabe. Continua existindo no espaco entre um estado e outro sem perceber que esta no errado.<br><br>Eu sabia. Isso foi bom e ruim ao mesmo tempo. Bom porque significava que eu era ainda eu. Ruim porque significava que estava consciente do que estava faltando.'",
 "Dizem que sou o mesmo. Digo que sou o mesmo. Os dois dizemos isso porque e mais facil.<br><br>A alternativa e: sou parcialmente o mesmo. As partes que sobreviveram ao retorno sao genuinamente minhas. O espaco onde as outras partes estavam tambem e meu — mas esta vazio.<br><br>Nao e dor. E como a ausencia de um dente. Voce sente onde devia estar alguma coisa. A lingua continua indo ate aquele lugar.<br><br>Ainda nao acostumei ao espaco vazio.",
 "Sei que voces estao aliviados. Nao quero tirar isso de voces, entao nao vou dizer tudo.<br><br>Digo apenas: sejam pacientes. Sou eu — mas ainda me reorganizando. Ha coisas que lembro e nao sei se sao minhas ou de alguem que estava no mesmo espaco enquanto eu estava la.<br><br>Ha coisas que devia lembrar e nao lembro. Ha coisas que lembro e nao sei se aconteceram.<br><br>Sou eu. Estou aqui. Preciso de tempo para saber o que isso significa.",
 "Nao e dramatico. Nao ha segunda voz, nao ha conflito constante.<br><br>E mais sutil: as vezes reajo a uma situacao e percebo que tenho tambem uma segunda reacao que nao e completamente minha — mas esta la de qualquer jeito.<br><br>O necromante disse que isso e normal. Que o espaco vazio as vezes e preenchido por ecos — impressoes de outros que passaram pelo mesmo estado.<br><br>Disse que com o tempo enfraquecem. Estou trabalhando nisso. E um trabalho estranho.",
 "A pergunta que todos querem fazer mas poucos fazem: como e estar morto?<br><br>Nao sei. Nao estava morto, exatamente. Estava num estado que nao e isso nem o outro. O Irmao Corvin chamou de estado liminar. Parece certo.<br><br>La: nao havia pensamento linear. Havia algo que funciona como pensamento mas que nao precisa de sequencia. Mais e menos do que pensar ao mesmo tempo.<br><br>Voltando: o pensamento linear voltou. Com ele, todas as vantagens e todas as limitacoes. Tenho saudade do outro jeito de pensar. Mas nao tenho certeza de que saudade e a palavra certa."
    });

 _Setup(df, "c_testemunho_retornado_4", array{
 "ANALISE DE CASO — USO INTERNO<br><br>O sujeito voltou ha dois meses. Avaliacao inicial indicava retorno completo. A de dois meses revela o que avaliacoes iniciais raramente identificam.<br><br>O que falta nao e memoria. Nao e personalidade. Nao e capacidade cognitiva.<br><br>O que falta e o que os textos mais antigos chamam de 'camada de profundidade'. Dificil de descrever porque e uma qualidade que existe nos vivos e so e percebida quando ausente.<br><br>A melhor descricao: ao lado desse sujeito, voce tem a sensacao estranha de estar conversando com um retrato muito bom de uma pessoa — e nao com a pessoa.",
 "MEMORIAS DO RETORNO — FASE AVANCADA<br><br>Faz um ano. Os ecos que o necromante mencionou enfraqueceram. Nao desapareceram — enfraqueceram. As vezes ainda reajo com a segunda reacao que nao e completamente minha. Mas ja consigo distinguir. Isso e progresso.<br><br>O espaco vazio onde a camada de profundidade estaria — aprendi a trabalhar ao redor. Como alguem que perdeu uma mao aprende a fazer o que precisa fazer sem ela.<br><br>Nao estou bem como estava antes. Estou bem no sentido do que sobrou. Isso tem que ser suficiente.",
 "Perguntas que nao fiz na epoca porque nao sabia formula-las. Agora sei:<br><br>Um — o que foi levado nao volta, voce disse. Para onde foi? Ficou no estado liminar? Foi adiante? Poderia ser acessado?<br><br>Dois — os outros que voce tratou antes de mim relataram as mesmas coisas que eu relato? Ou cada retorno e diferente?<br><br>Tres — ha algo que eu possa fazer para ajudar outros que vao passar por isso? Sinto que o que aprendi deveria servir para mais do que entender minha propria situacao.",
 "CARTA AO CONSELHO DO NOVICIADO<br><br>Escrevo como alguem que passou pelo processo. Nao como especialista — como testemunha.<br><br>O que a doutrina diz sobre os Retornados esta incompleto de formas que tem consequencias praticas.<br><br>Diz que o retorno e sempre incompleto. Verdade. Nao diz que o grau varia e que essa variacao tem causas identificaveis que poderiam ser trabalhadas.<br><br>Diz que o Retornado e a mesma pessoa. Verdade e nao-verdade ao mesmo tempo — de forma que a doutrina atual nao equaciona.<br><br>Nao peco que a doutrina mude. Peco que seja expandida com testemunho de quem viveu. Ou semi-viveu. A linguagem tambem e inadequada.",
 "DEPOIMENTO — CINCO ANOS DEPOIS<br><br>Cinco anos. Posso dizer o que nao conseguia dizer no comeco.<br><br>No primeiro ano achei que ficaria sempre assim — parcialmente presente. No segundo ano aprendi a diferenca entre o que faltava por causa do retorno e o que faltava por causa de como eu respondia ao retorno.<br><br>A segunda parte eu podia trabalhar. Trabalhei.<br><br>O que ficou: sou eu, com uma lacuna que nao vai se fechar. Fiz as pazes com ela. A lacuna nao e quem sou — e onde estive e de onde voltei de um jeito que deixou marca.<br><br>Isso e diferente de estar quebrado. Isso e estar marcado. Marcado e algo que posso viver sendo."
    });

 _Setup(df, "c_testemunho_retornado_5", array{
 "TESTEMUNHO COMPLETO — ARQUIVO RESTRITO<br><br>O que relatei antes foi parcial — porque nao entendia completamente, porque havia partes que nao conseguia articular, porque havia partes que nao queria articular.<br><br>Aqui esta o resto.<br><br>No estado liminar, havia estrutura. Nao de individuos — de sistema. Como estar dentro de uma edificacao muito grande, arquitetura que nao foi feita para humanos mas que humanos podem habitar, com desconforto.<br><br>A edificacao tinha proposito. Nao era conter — era preservar. O que estava sendo preservado: nos. Para que: nao estava claro.<br><br>Quando fui trazido de volta, ficou algo da minha compreensao da edificacao. Sei em parte como ela funciona. Sei que e maior do que qualquer angulo individual pode ver. Sei que quem a construiu nao esta mais presente para supervisionar. E ela continua funcionando muito alem do que foi intencionado.",
 "CARTA FINAL — PARA O NECROMANTE<br><br>Voce me fez um favor que nao sei se era para me fazer. Digo isso com gratidao complicada, nao com rancor.<br><br>O que aprendi por ter estado la e voltado e mais do que teria aprendido em cem anos de estudo. E conhecimento que custa, mas e conhecimento real.<br><br>O que preciso que voce saiba: o sistema que habitei nao e inofensivo por ser bem-intencionado. A maioria das estruturas que causam dano profundo sao bem-intencionadas — so nao foram pensadas completamente ate o fim.<br><br>Ha almas la que estao ha mais tempo do que qualquer retornado que conheco ficou. Ha almas que chegaram ao estado de nao querer mais ser liberadas — estiveram la por tanto tempo que aquilo se tornou o unico estado que conhecem.<br><br>Isso nao foi intencao de quem construiu. E o resultado.<br><br>Se ainda puder mudar algo no processo que usa para trazer retornados — mude para que o que eles sabem chegue intacto. O que eles carregam precisa ser ouvido por alguem que possa fazer algo a respeito."
    });

    //   -- -- -- diario_necromante   -- -- --

 _Setup(df, "t_diario_necromante", array{
 "Caderno de Pesquisa — Caso Quarenta e Dois",
 "Notas sobre a Incompletude do Retorno",
 "Observacoes: O que a Morte Reten",
 "Diario de Campo — Comunhao com o Retornado",
 "Analise Comparativa de Retornos — Ciclo Atual"
    });

 _Setup(df, "c_diario_necromante_3", array{
 "CADERNO DE PESQUISA — CASO QUARENTA E DOIS<br><br>Sujeito: masculino, trinta e dois anos, retorno ha tres semanas.<br><br>Estado fisico: excelente. Todas as funcoes vitais dentro do esperado. Nenhuma degeneracao aparente.<br><br>Estado cognitivo: dentro do esperado para retorno de curta duracao. Memoria intacta, raciocinio intacto, afeto presente mas de amplitude reduzida em cerca de trinta por cento — estimativa subjetiva baseada em entrevistas.<br><br>Estado que nao tenho categoria para descrever: o sujeito parece completo mas nao o e. Nao ha deficit identificavel. Ha uma qualidade de presenca que e diferente de antes. Ele mesmo nao nomeia isso, mas sente.",
 "NOTAS SOBRE A INCOMPLETUDE DO RETORNO<br><br>Apos dezoito anos de pratica e vinte e sete casos documentados, posso afirmar o seguinte:<br><br>O retorno nunca e completo. Isso nao e fracasso de tecnica — e resultado da natureza do processo. O que vai, vai inteiro. O que volta, volta com o estado liminar como filtro.<br><br>O filtro reten algo. Nao sei o que e. Nao ha metodo atual que identifique com precisao o que e retido e o que passa.<br><br>O que posso dizer: o que e retido nao e aleatorio. Ha um padrao. Casos similares retem coisas similares. Estou tentando mapear o padrao ha seis anos. O mapa esta comecando a tomar forma.",
 "OBSERVACOES: O QUE A MORTE RETEN<br><br>Terminologia imprecisa que uso por falta de melhor: 'a morte' nao e um estado. E uma transicao. O que chamamos de morte e a borda, nao o interior.<br><br>O que o estado alem da borda reten varia. O que e consistente: algo relacionado a profundidade da experiencia. Nao a profundidade de conhecimento — a profundidade de presenca. O que os filosofos as vezes chamam de 'peso existencial'.<br><br>Em termos praticos: um Retornado pode lembrar de tudo que sabia, pode agir como sempre agiu, pode sentir o que sempre sentiu. Mas o peso que havia por tras de tudo isso — a sensacao de que sua existencia tem substancia real — isso enfraquece.",
 "DIARIO DE CAMPO — COMUNHAO COM O RETORNADO<br><br>Pela primeira vez na minha pratica tentei algo diferente: em vez de observar o Retornado a distancia, passei uma semana em contato proximo e constante.<br><br>O que aprendi que nao aprendi em entrevistas:<br><br>O Retornado nao esta performando normalidade. Ele e normal, de uma forma especifica. A forma especifica inclui uma lentidao de presenca — como se processasse o mundo atraves de uma camada adicional que os nao-Retornados nao tem.<br><br>Essa camada nao e barreira. E filtro. Ele percebe mais coisas do que eu percebo sobre o que esta ao redor. Mas percebe de uma distancia que eu nao percebo.",
 "ANALISE COMPARATIVA — RETORNO RAPIDO VERSUS RETORNO LONGO<br><br>Dois casos desta semana permitem comparacao direta.<br><br>Caso A: retorno apos seis horas no estado liminar. Incompletude minima — precisaria de instrumentos de alta precisao para detectar. Sujeito funciona normalmente em todos os aspectos.<br><br>Caso B: retorno apos dezessete dias no estado liminar. Incompletude significativa — perceptivel em interacao social, ausente em capacidade tecnica. Sujeito funciona normalmente em tarefas mas nao em relacionamentos.<br><br>Hipotese atualizada: o que e retido esta correlacionado com tempo no estado liminar. O sistema de la funciona como sedimento — quanto mais tempo, mais deposita."
    });

 _Setup(df, "c_diario_necromante_4", array{
 "CORRESPONDENCIA COM PESQUISADOR EXTERNO — SELADO<br><br>Colega —<br><br>Sua hipotese sobre a natureza do que e retido esta proxima mas nao esta certa.<br><br>Voce afirma que o estado liminar reten a 'essencia' do individuo. Prefiro a palavra Fea, que os textos do norte usam, embora poucos a compreendam corretamente.<br><br>A Fea nao e a essencia no sentido de nucleo — e a conexao entre o que a pessoa e e o que a pessoa poderia ser. E o vetor, nao o ponto.<br><br>Quando o Retornado volta incompleto, nao falta parte do que ele e. Falta a conexao entre o que ele e e o que ele poderia ter se tornado.<br><br>Isso e muito mais dificil de recuperar. Talvez impossivel. E isso explica por que Retornados antigos relatam a sensacao de estar 'parado' de formas que Retornados recentes nao relatam ainda.",
 "NOTAS DO PESQUISADOR — ACESSO NIVEL DOIS<br><br>Ha uma questao que evito discutir em documentos de acesso padrao por razoes que vao alem de discricao academica.<br><br>A questao: o que acontece com a Fea que nao retorna?<br><br>Dois cenarios possiveis:<br><br>Um — ela permanece no estado liminar, associada ao sistema que habita aquele espaco. Isso e o que os textos mais antigos sugerem.<br><br>Dois — ela segue adiante, para onde vao as coisas que completam a transicao. Isso e o que os Retornados mais completos relatam ter percebido enquanto estavam la.<br><br>O problema: os dois cenarios tem implicacoes completamente diferentes. Se o primeiro, ha fragmentos de pessoas acumulados no estado liminar indefinidamente. Se o segundo, a incompletude do Retornado e permanente de uma forma que nao pode ser corrigida.<br><br>Nao sei qual esta certo. Suspeito que ambos sejam verdade para casos diferentes.",
 "DIARIO — CASO MAIS DIFICIL DA CARREIRA<br><br>O sujeito voltou ha oito meses. A incompletude e severa — severa o suficiente para que eu questionasse se o retorno foi bem-sucedido ou se o que voltou e suficientemente a mesma pessoa para ser chamado de retorno.<br><br>Decidi que sim. Que e a mesma pessoa, com uma lacuna grande onde antes havia substancia.<br><br>O que o torna dificil: o sujeito esta ciente. Completamente ciente da lacuna. Pode descrever com precisao o que sente que esta faltando. Pode comparar o presente com memorias do que era antes.<br><br>Isso e mais dificil do que se ele nao soubesse. Ignorancia da lacuna parece, paradoxalmente, mais funcional do que conhecimento preciso dela.",
 "ANALISE: O CASO DA DUPLA MORTE<br><br>Pela primeira vez na literatura: um sujeito que morreu, retornou, viveu dois anos, e morreu novamente.<br><br>A segunda morte nao foi violenta — foi natural, progressiva, sem causa identificavel.<br><br>O que observei: o segundo processo foi mais rapido do que o esperado. Como se o corpo tivesse percorrido o caminho antes e soubesse como ir mais rapido.<br><br>O que o sujeito relatou no periodo final: que sentia que havia uma parte de si que havia 'ficado la' da primeira vez, e que agora estava indo reencontrar essa parte. Que isso parecia certo. Que o segundo processo parecia menos como morrer e mais como chegar.",
 "NOTAS FINAIS SOBRE A NATUREZA DA INCOMPLETUDE<br><br>Apos trinta anos de pratica e quarenta e tres casos completos:<br><br>A incompletude do retorno nao e dano. E custo. Ha uma diferenca.<br><br>Dano e resultado de processo que falhou. Custo e resultado de processo que funcionou — mas que necessariamente paga alguma coisa para funcionar.<br><br>A necromancia paga com Fea. Cada retorno reten parte do que conecta o individuo ao seu potencial futuro. O individuo volta, mas volta sem parte do que o teria tornado o que poderia ter sido.<br><br>Isso e um custo. E um custo que o individuo nao escolheu pagar porque nao foi informado.<br><br>Este e o problema etico central da nossa pratica que ninguem esta discutindo abertamente."
    });

 _Setup(df, "c_diario_necromante_5", array{
 "ARQUIVO RESTRITO — CORRESPONDENCIA COM OS CONCLAVES DO NORTE<br><br>Aos pesquisadores do Conclave —<br><br>Minha pesquisa sobre a incompletude do retorno chegou a uma conclusao que nao estava no escopo original do trabalho.<br><br>O que reten o estado liminar nao e aleatorio e nao e proporcional apenas ao tempo. Ha um componente adicional: o quanto o individuo havia desenvolvido sua Fea em vida.<br><br>Em termos praticos: um individuo que viveu com profundidade — que questionou, que amou com presenca, que desenvolveu o que e em relacao ao que poderia ser — esse individuo perde mais no retorno. Proporcionalmente mais.<br><br>O individuo que viveu com menos profundidade retorna mais completo, percentualmente falando, porque havia menos para ser retido.<br><br>A implicacao: a necromancia penaliza os que mais desenvolveram o que e mais humano neles. Isso nao pode ser intencional. Mas e o que e.<br><br>Peco que o Conclave considere estas informacoes ao rever suas diretrizes sobre o uso da pratica.",
 "DIARIO — ULTIMA ENTRADA ANTES DE PARAR DE PRATICAR<br><br>Paro nao por falta de capacidade. Paro porque entendi o que estou fazendo de forma completa demais para continuar fazendo sem mudanca radical no processo.<br><br>Quarenta anos de pratica. Quarenta e tres casos. Cada caso melhor tecnicamente do que o anterior. Cada caso retirando de alguem algo que eu nao tinha direito de retirar, mesmo sem saber.<br><br>Nao ha como devolver o que foi retido. Tentei. Ha maneiras de compensar — de ajudar o Retornado a construir ao redor da lacuna, de fortalecer o que sobrou. Mas devolver, nao.<br><br>O que posso fazer: documentar completamente, para que quem vier depois saiba o custo antes de cobrar.<br><br>E tentar, enquanto tenho tempo, entender se ha forma de modificar o processo para reduzir o que e retido.<br><br>Tenho hipoteses. Elas envolvem o sistema de captura na Rota das Mares de formas que vao exigir investigacao que nao consigo fazer sozinho.<br><br>Deixo os arquivos completos para quem tiver coragem de continuar."
    });

    //   -- -- -- fragmento_limiar   -- -- --

 _Setup(df, "t_fragmento_limiar", array{
 "Notas de Borda — Expedicao ao Limiar",
 "O que Existe Entre os Estados",
 "Diario: Quando o Limiar Percebeu que Estava Sendo Estudado",
 "Fragmentos de Uma Pesquisa Que Nao Terminou",
 "Ultima Anotacao Antes da Transicao"
    });

 _Setup(df, "c_fragmento_limiar_3", array{
 "NOTAS DE BORDA — PRIMEIRO DIA<br><br>O Limiar nao e um lugar. Isso e a primeira coisa que aprendi ao chegar.<br><br>E um estado. Um estado que tem localizacao fisica — voce chega la caminhando — mas que e fundamentalmente uma condicao de existencia, nao um ponto no mapa.<br><br>Quando estou no Limiar estou entre o que sou e o que posso ser. Entre este momento e o proximo. Entre este mundo e o que quer que fique alem.<br><br>Meu mestre me disse que pessoas que tentam entender o Limiar atraves de mapas falham. Entendendo isso agora.",
 "O QUE EXISTE ENTRE OS ESTADOS<br><br>No Limiar existe o que nao pode existir em nenhum outro lugar: a possibilidade pura. Nao possibilidade de algo especifico — possibilidade como estado fundamental.<br><br>Isso e dificil de traduzir em experiencia pratica. A tentativa mais proxima que tenho: na vida normal, cada momento e o que e. No Limiar, cada momento e o que e e tambem e tudo que poderia ser, simultaneamente, sem colapsar em nenhuma das opcoes.<br><br>Isso e exaustivo e e a coisa mais proxima de liberdade que ja senti.<br><br>Entendo por que e dificil sair voluntariamente.",
 "DIARIO DE EXPEDICAO — PRIMEIRA SEMANA<br><br>Somos cinco pesquisadores. Acordamos um protocolo: nao ficamos mais de seis horas por vez. Saimos, descansamos, voltamos. Nunca entramos sozinhos.<br><br>O protocolo esta sendo seguido. O que nao prevíamos: o Limiar parece aprender com cada entrada. A segunda visita foi diferente da primeira de formas que nao conseguimos medir mas todos percebemos.<br><br>O Limiar nos reconheceu. Essa e a melhor descricao que tenho. Nao de forma ameacadora — da mesma forma que um animal selvagem reconhece alguem que voltou ao mesmo lugar. Avaliando. Decidindo o que fazer com essa informacao.",
 "FRAGMENTOS DE OBSERVACAO — ARQUIVO DO PESQUISADOR<br><br>O que o Limiar faz com o tempo: nao o ignora, nao o nega. Relaciona-se com ele de forma diferente.<br><br>Ha momentos no Limiar que duram o que parece uma hora e que correspondem, no exterior, a menos de um minuto. Ha momentos que parecem um minuto e que correspondem a varias horas.<br><br>A correlacao nao e aleatoria. Parece relacionada com o grau de presenca do observador. Quando estou completamente presente no Limiar, o tempo exterior passa mais devagar. Quando estou com parte da atencao fora, o tempo normaliza.<br><br>Hipotese: o Limiar faz do tempo aquilo que o observador faz do Limiar.",
 "ULTIMA ANOTACAO ANTES DE SAIR<br><br>Estou aqui ha mais tempo do que planejei. Nao por acidente — porque nao consegui sair quando devia.<br><br>Nao e armadilha. Nao e a estrutura que me reten. Sou eu que fico.<br><br>O Limiar nao tem bordas coercitivas. Tem bordas sedutoras. Cada vez que me aproximo da saida percebo mais uma camada que nao explorei, mais uma questao que ficaria sem resposta, mais um aspecto que o exterior nao tem equivalente.<br><br>Vou sair. Mas entendo agora os que nao sairam."
    });

 _Setup(df, "c_fragmento_limiar_4", array{
 "RELATORIO DE PESQUISA — FASE DOIS — SELADO<br><br>Apos tres semanas de entrada e saida controladas, posso relatar o seguinte com razoavel confianca:<br><br>O Limiar tem estrutura. Nao a estrutura de um lugar fisico — a estrutura de um sistema. Ha regioes dentro dele com caracteristicas diferentes. Ha o que parece ser hierarquia — nao de entidades, mas de estados. Alguns estados no Limiar sao mais profundos do que outros no mesmo sentido que voce pode ser mais ou menos presente mesmo estando no mesmo lugar fisico.<br><br>A regiao mais profunda que alcancei: o que so posso descrever como o ponto de comunicacao. Onde o Limiar se conecta com o que existe alem dele.<br><br>Nao entrei. A comunicacao que percebi de fora era suficiente para me dizer que entrar exigia mais do que estava preparado para dar.",
 "CORRESPONDENCIA ENTRE PESQUISADORES — EXPEDICAO IDRITH'HAR<br><br>A expedicao Drow chegou ao Limiar antes de nos, portanto. Os registros que encontramos confirmam presenca Idrith'har em datas que precedem nossa propria expedicao em dois ciclos.<br><br>O que elas encontraram e relatado de forma parcial — parcial porque parte dos registros foi deliberadamente reduzida antes de ser deixada. Elas deixaram o que queriam que fosse encontrado.<br><br>O que queriam que fosse encontrado: confirmacao de que o Limiar se comunica com a Rota das Mares. Confirmacao especifica, com localizacao aproximada do ponto de comunicacao.<br><br>Por que queriam que isso fosse encontrado? Isso e o que nao consigo determinar pela analise dos registros. As motivacoes Idrith'har nao sao transparentes para pesquisadores externos.",
 "DIARIO — QUANDO O LIMIAR PERCEBEU QUE ESTAVA SENDO ESTUDADO<br><br>Nao houve momento dramatico. Foi gradual.<br><br>Na primeira semana: o Limiar era passivo. Estava la, nos o estudavamos, ele nao respondia de forma perceptivel.<br><br>Na segunda semana: pequenas mudancas. Regioes que haviamos mapeado ligeiramente deslocadas. Nao o suficiente para ser perigo — o suficiente para indicar que algo havia se ajustado.<br><br>Na terceira semana: o Limiar nos mostrou algo. Nao sei se foi intencional no sentido de intencao consciente. Foi como um sistema que se reorganiza para otimizar a interacao com um novo elemento — nos eramos o novo elemento.<br><br>O que nos mostrou: a conexao com a Rota das Mares, mais clara do que qualquer outra coisa que haviamos observado. Como se soubesse que essa era a informacao que procuravamos.",
 "ANALISE: O LIMIAR COMO SISTEMA DE COMUNICACAO<br><br>Hipotese em revisao:<br><br>O Limiar nao e um lugar de transito. E um lugar de comunicacao.<br><br>O que transita por ele transita em direcao a algo. O que comunica por ele se comunica com algo. Sao funcoes distintas que o Limiar serve simultaneamente para categorias diferentes de existencia.<br><br>Para humanos (vivos): o Limiar e estado de profundidade acessivel. Para almas em transicao: o Limiar e etapa necessaria. Para o que existe alem: o Limiar e ponto de contato com o que existe aquem.<br><br>A Rota das Mares usa o Limiar como ponto de contato para o seu sistema de captura. A comunicacao vai nos dois sentidos — nao apenas alma para Rota, mas Rota para alma.<br><br>Isso muda a analise do sistema costeiro de forma significativa.",
 "EXPEDICAO AO PONTO DE COMUNICACAO — RELATORIO UNICO<br><br>Entrei. Sei que havia dito que nao entraria. Entrei porque a alternativa era voltar sem a resposta central.<br><br>O ponto de comunicacao entre o Limiar e a Rota das Mares nao e um mecanismo. E uma relacao. Uma relacao que foi estabelecida deliberadamente, em algum momento, por alguem que sabia o que estava fazendo.<br><br>A relacao funciona assim: o Limiar permite que a Rota das Mares detecte almas em transicao antes que completem a transicao. A Rota das Mares usa essa deteccao para capturar antes do ponto de impossivel retorno.<br><br>Isso e tecnicamente elegante. E tambem o motivo pelo qual o sistema nao tem botao de parar — parar a relacao com o Limiar quebraria mecanismos que o Limiar usa para funcoes que tem nada a ver com a Rota das Mares.<br><br>Para parar, seria necessario reconfigurar o Limiar inteiro. E o Limiar e velho demais, e grande demais, para que qualquer um saiba como fazer isso."
    });

 _Setup(df, "c_fragmento_limiar_5", array{
 "ULTIMA ANOTACAO ANTES DA TRANSICAO — FRAGMENTO ENCONTRADO NA BORDA<br><br>Fui longe demais. Nao sei se foi erro ou inevitabilidade.<br><br>O que encontrei alem do ponto de comunicacao: entendimento. Nao informacao — entendimento. A diferenca e que informacao voce pode carregar de volta. Entendimento as vezes so existe no contexto em que foi encontrado.<br><br>O que entendi: o Limiar foi criado. Nao surgiu naturalmente — foi construido, por algo que precisava de um espaco de transicao controlada para um proposito especifico. O proposito era bom. Era cuidar das almas que precisavam de tempo antes de seguir adiante.<br><br>A Rota das Mares foi construida depois, aproveitando a infraestrutura do Limiar. Por humanos que entenderam parte do sistema mas nao o todo. Eles construiram a captura mas nao construiram a liberacao porque nao entenderam que a liberacao precisava ser construida — achavam que aconteceria naturalmente.<br><br>Nao acontece naturalmente. Nunca aconteceu.<br><br>Alora sabe disso. Por isso observa. Por isso nao tenta libertar almas individualmente — libertar individualmente seria retirar almas de uma prisao para coloca-las no nada, porque o destino que deveriam ter segue bloqueado pelo sistema que o Limiar agora serve involuntariamente.<br><br>O problema inteiro precisa ser resolvido de dentro. De dentro do Limiar, de dentro do sistema.<br><br>Estou dentro. Nao sei se vou conseguir sair da forma que entrei.",
 "DIARIO: O QUE O LIMIAR ESPERA<br><br>Passei tempo suficiente aqui para que o Limiar me tratasse como conhecido em vez de como intruso. Isso tem custo e tem beneficio.<br><br>O custo: partes de mim estao ficando. Nao sendo roubadas — ficando porque o Limiar e um lugar onde e mais facil ficar do que ir.<br><br>O beneficio: o Limiar me mostrou o que espera.<br><br>Ele espera alguem que entenda o problema inteiro. Nao parcialmente — inteiro. A Rota das Mares, a estrutura de captura, a relacao com o Limiar, o que o Limiar originalmente era e o que se tornou, e o que precisaria ser feito para devolver o sistema ao proposito que foi construido para servir.<br><br>Alguem com esse entendimento poderia fazer algo. O Limiar nao sabe o que — ele e estrutura, nao agencia. Mas saberia cooperar.<br><br>Alora espera a mesma coisa, a distancia segura.<br><br>Eu tenho parte do entendimento. Nao o todo. Mas estou mais perto do que qualquer humano registrado que ja esteve aqui.<br><br>A questao e se vou conseguir sair com o que sei."
    });

 if (who) SendSysMessage(who, "[Inerte DS] Chunk3 ok."); endif
endprogram
