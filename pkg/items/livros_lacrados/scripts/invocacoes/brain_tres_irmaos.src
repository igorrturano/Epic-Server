// brain_tres_irmaos.src - controla os tres irmaos com dialogo coordenado.
// params: {npc1 (Mais Velho), npc2 (do Meio), npc3 (Mais Novo), expira_systime}

use uo;
use os;
use util;

program BrainTresIrmaos(params)
    var npc1   := params[1];
    var npc2   := params[2];
    var npc3   := params[3];
    var expira := CInt(params[4]);

    var linhas := array{
 array{1, "Onde estamos?"},
 array{2, "*olha ao redor*"},
 array{3, "*tenta falar, nao consegue*"},
 array{1, "Voces lembram o que aconteceu?"},
 array{2, "...lembro apenas o frio."},
 array{3, "*abana a cabeca lentamente*"},
 array{2, "Ainda estamos juntos."},
 array{1, "*olha para os dois em silencio*"},
 array{3, "*acena*"},
 array{3, "*aponta para algo distante*"},
 array{1, "Nao ha nada ali."},
 array{2, "*olha na mesma direcao mesmo assim*"},
 array{1, "Acho que nao vamos voltar."},
 array{2, "Nunca fomos."},
 array{3, "*senta no chao*"}
    };
    var n := linhas.size();
    var idx := 1;

    while (ReadGameClock() < expira)
        if ((!npc1 || npc1.errortext) &&
            (!npc2 || npc2.errortext) &&
            (!npc3 || npc3.errortext))
            return;
        endif

        if (npc1 && !npc1.errortext && RandomInt(2) == 0)
            MoveObjectToLocation(npc1, npc1.x + RandomInt(5)-2, npc1.y + RandomInt(5)-2, npc1.z, npc1.realm, MOVEOBJECT_NORMAL);
        endif
        if (npc2 && !npc2.errortext && RandomInt(2) == 0)
            MoveObjectToLocation(npc2, npc2.x + RandomInt(5)-2, npc2.y + RandomInt(5)-2, npc2.z, npc2.realm, MOVEOBJECT_NORMAL);
        endif
        if (npc3 && !npc3.errortext && RandomInt(2) == 0)
            MoveObjectToLocation(npc3, npc3.x + RandomInt(5)-2, npc3.y + RandomInt(5)-2, npc3.z, npc3.realm, MOVEOBJECT_NORMAL);
        endif

        sleep(15);

        var linha := linhas[idx];
        var quem  := CInt(linha[1]);
        var frase := linha[2];

        if (quem == 1 && npc1 && !npc1.errortext)
            PrintTextAbove(npc1, frase);
        elseif (quem == 2 && npc2 && !npc2.errortext)
            PrintTextAbove(npc2, frase);
        elseif (quem == 3 && npc3 && !npc3.errortext)
            PrintTextAbove(npc3, frase);
        endif

        idx := idx + 1;
        if (idx > n) idx := 1; endif

        sleep(30);
    endwhile

    if (npc1 && !npc1.errortext) npc1.kill(); endif
    sleepms(200);
    if (npc2 && !npc2.errortext) npc2.kill(); endif
    sleepms(200);
    if (npc3 && !npc3.errortext) npc3.kill(); endif
endprogram
