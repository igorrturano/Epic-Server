// brain_lirenne.src - Lirenne vaga procurando seu noivo; limpa flag ao sair.
// params: {npc, expira_systime, delay_ticks}

use uo;
use os;
use util;

program BrainLirenne(params)
    var npc    := params[1];
    var expira := CInt(params[2]);
    var delay  := CInt(params[3]);
    if (!delay || delay < 5) delay := 30; endif

    var frases := array{
 "*chama por um nome que o vento carrega*",
 "*para de repente e olha para tras*",
 "*murmura algo que ninguem consegue ouvir*",
 "*sorri brevemente, entao para*",
 "*olha ao redor como quem espera alguem*",
 "*ajeita o vestido como se fosse encontra-lo agora*"
    };

    while (npc && !npc.errortext)
        if (ReadGameClock() >= expira) break; endif

        if (RandomInt(3) == 0)
            MoveObjectToLocation(npc,
                npc.x + RandomInt(5) - 2,
                npc.y + RandomInt(5) - 2,
                npc.z, npc.realm, MOVEOBJECT_NORMAL);
        endif

        PrintTextAbove(npc, frases[RandomInt(frases.size()) + 1]);
        sleep(delay);
    endwhile

 EraseGlobalProperty("lirenne_expira");
    if (npc && !npc.errortext) npc.kill(); endif
endprogram
