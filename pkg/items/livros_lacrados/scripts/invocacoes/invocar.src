// invocacoes/invocar.src
// Dispatcher central de invocces.
// Recebe (who, book, invocacao_id, nivel, afinidade, lugar) e chama o script correto.

use uo;
use os;
use util;
use vitals;

include ":attributes:attributes";
include ":livros_lacrados:include/livrosLacrados";
include ":gumps:include/epicGumps";


// Categorias
include ":livros_lacrados:scripts/invocacoes/cat1_demonios";
include ":livros_lacrados:scripts/invocacoes/cat2_mortos";
include ":livros_lacrados:scripts/invocacoes/cat3_animais";
include ":livros_lacrados:scripts/invocacoes/cat4_falantes";
include ":livros_lacrados:scripts/invocacoes/cat5_cobradores";
include ":livros_lacrados:scripts/invocacoes/cat7_unicos";
include ":livros_lacrados:scripts/invocacoes/cat8_lore";

function _FalsoDesfaz(who, book)
 PrintTextAbove(who, "*o livro se desfaz em po e cinzas na sua mao*");
    PlaySoundEffect(who, 0x0057);
    sleepms(400);
    PlaySoundEffect(who, 0x029E);
    if (book && !book.errortext) DestroyItem(book); endif
endfunction

program InvocarEntidade(params)
    var who       := params[1];
    var book      := params[2];
    var inv_id    := params[3];
    var nivel     := CInt(params[4]);
    var afinidade := params[5];
    var lugar     := params[6];

    // Verificar se o leitor ainda    vlido
    if (!who || who.errortext) return; endif

    // Despachar por ID
    case (inv_id)
        // --- Categoria 1: Demnios ---
 "vexalim": InvocarVexalim(who, book, nivel, afinidade, lugar); break;
 "iskaryon": InvocarIskaryon(who, book, nivel, afinidade, lugar); break;
 "o_quieto": InvocarOQuieto(who, book, nivel, afinidade, lugar); break;
 "pacto_roto": InvocarPactoRoto(who, book, nivel, afinidade, lugar); break;

        // --- Categoria 2: Mortos ---
 "mae_procura": InvocarMaeProcura(who, book, nivel, afinidade, lugar); break;
 "soldado": InvocarSoldado(who, book, nivel, afinidade, lugar); break;
 "lirenne": InvocarLirenne(who, book, nivel, afinidade, lugar); break;
 "tres_irmaos": InvocarTresIrmaos(who, book, nivel, afinidade, lugar); break;
 "bibliotecario": InvocarBibliotecario(who, book, nivel, afinidade, lugar); break;

        // --- Categoria 3: Animais ---
 "coisa_quadrupede": InvocarCoisaQuadrupede(who, book, nivel, afinidade, lugar); break;
 "pequenos_limiar": InvocarPequenosLimiar(who, book, nivel, afinidade, lugar); break;
 "cantante": InvocarCantante(who, book, nivel, afinidade, lugar); break;
 "coisa_imita": InvocarCoisaImita(who, book, nivel, afinidade, lugar); break;
 "ovo": InvocarOvo(who, book, nivel, afinidade, lugar); break;

        // --- Categoria 4: Falantes ---
 "mensageiro": InvocarMensageiro(who, book, nivel, afinidade, lugar); break;
 "voz_velho": InvocarVozVelho(who, book, nivel, afinidade, lugar); break;
 "anuncio": InvocarAnuncio(who, book, nivel, afinidade, lugar); break;
 "confissor": InvocarConfissor(who, book, nivel, afinidade, lugar); break;
 "recita_nomes": InvocarRecitaNomes(who, book, nivel, afinidade, lugar); break;

        // --- Categoria 5: Cobradores ---
 "coletor_anos": InvocarColetorAnos(who, book, nivel, afinidade, lugar); break;
 "pede_sangue": InvocarPedeSangue(who, book, nivel, afinidade, lugar); break;
 "quer_nome": InvocarQuerNome(who, book, nivel, afinidade, lugar); break;
 "veio_memoria": InvocarVeioMemoria(who, book, nivel, afinidade, lugar); break;
 "cobrador": InvocarCobrador(who, book, nivel, afinidade, lugar); break;

        // --- Categoria 6: Falsos ---
 "sombra_iskaryon":
 "demonio_papel":
 "coro_vazio":
 "eles":
 "propria_morte": _FalsoDesfaz(who, book); break;

        // --- Categoria 7: AAnicos ---
 "primeiro_lacrador": InvocarPrimeiroLacrador(who, book, nivel); break;
 "antessenhora": InvocarAntessenhora(who, book, nivel); break;
 "sem_nome": InvocarSemNome(who, book, nivel); break;
 "filho_servidor": InvocarFilhoServidor(who, book, nivel); break;
 "coisa_errada": InvocarCoisaErrada(who, book, nivel); break;

        // --- Categoria 8: Lore Especfico ---
 "o_primeiro_puxado": InvocarOPrimeiroPuxado(who, book, nivel, afinidade, lugar); break;
 "voz_do_plano_oco": InvocarVozDoPlanOco(who, book, nivel, afinidade, lugar); break;
 "herdeiro_senhor_guerra": InvocarHerdeiroSenhorGuerra(who, book, nivel, afinidade, lugar); break;
 "espirito_origem_lobo": InvocarEspiritoOrigemLobo(who, book, nivel, afinidade, lugar); break;
 "mensageiro_ora": InvocarMensageiroAlora(who, book, nivel, afinidade, lugar); break;
 "eco_do_andarilho": InvocarEcoDoAndarilho(who, book, nivel, afinidade, lugar); break;
 "fragmento_retornado": InvocarFragmentoRetornado(who, book, nivel, afinidade, lugar); break;
 "sombra_vaelshorath": InvocarSombraVaelShorath(who, book, nivel, afinidade, lugar); break;
 "conhecidas_da_liga": InvocarConhecidasDaLiga(who, book, nivel, afinidade, lugar); break;
 "essencia_fea": InvocarEssenciaFea(who, book, nivel, afinidade, lugar); break;

        default:
            _FalsoDesfaz(who, book);
            break;
    endcase

endprogram
