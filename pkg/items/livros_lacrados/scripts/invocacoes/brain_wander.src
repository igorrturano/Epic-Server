// brain_wander.src
// NPC generico: vaga aleatoriamente, fala frases ocasionalmente, se mata ao expirar.
// params: {npc, expira_systime, frases_array, delay_ticks}

use uo;
use os;
use util;

program BrainWander(params)
    var npc    := params[1];
    var expira := CInt(params[2]);
    var frases := params[3];
    var delay  := CInt(params[4]);
    if (!delay || delay < 5) delay := 30; endif

    var tick := 0;
    while (npc && !npc.errortext)
        if (ReadGameClock() >= expira)
            if (npc && !npc.errortext) npc.kill(); endif
            return;
        endif

        if (RandomInt(3) == 0)
            MoveObjectToLocation(npc,
                npc.x + RandomInt(5) - 2,
                npc.y + RandomInt(5) - 2,
                npc.z, npc.realm, MOVEOBJECT_NORMAL);
        endif

        var resto := tick - (CInt(tick / 3) * 3);
        if (frases.size() > 0 && resto == 0)
            PrintTextAbove(npc, frases[RandomInt(frases.size()) + 1]);
        endif

        tick += 1;
        sleep(delay);
    endwhile
endprogram
