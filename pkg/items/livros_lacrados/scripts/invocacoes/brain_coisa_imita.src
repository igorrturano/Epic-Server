// brain_coisa_imita.src - imita os movimentos do jogador com 5s de delay real.
// params: {npc, who, expira_systime}

use uo;
use os;
use util;

program BrainCoisaImita(params)
    var npc    := params[1];
    var who    := params[2];
    var expira := CInt(params[3]);

    var frases := array{
 "*vira a cabeca exatamente como voce*",
 "*repete seu ultimo gesto*",
 "*pausa quando voce para*",
 "*olha para onde voce olhou*"
    };
    var tick := 0;

    while (npc && !npc.errortext && ReadGameClock() < expira)
        if (!who || who.errortext) break; endif

        var px := who.x;
        var py := who.y;
        var pz := who.z;

        sleep(5);

        if (npc && !npc.errortext)
            MoveObjectToLocation(npc, px, py, pz, npc.realm, MOVEOBJECT_NORMAL);
        endif

        tick := tick + 1;
        var resto := tick - (CInt(tick / 4) * 4);
        if (resto == 0 && npc && !npc.errortext)
            PrintTextAbove(npc, frases[RandomInt(frases.size()) + 1]);
        endif
    endwhile

    if (npc && !npc.errortext)
        MoveObjectToLocation(npc, 0, 0, 0, npc.realm, MOVEOBJECT_FORCELOCATION);
        sleepms(500);
        npc.kill();
    endif
endprogram
