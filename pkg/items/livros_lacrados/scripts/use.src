// use.src
// Script principal de interacao com o LivroLacrado.
// Acionado quando o jogador clica/usa o item (double-click).

use uo;
use os;
use util;
use vitals;
use datafile;
use file;

include "include/say";
include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":attributes:attributes";
include ":livros_lacrados:include/livrosLacrados";

include ":gumpDesigner:Gump/Gump";
include ":gumpDesigner:Control/Text";
include ":gumpDesigner:Control/Button";
include ":gumpDesigner:Control/ImageGump";
include ":gumpDesigner:Control/ImageGumpTiled";
include ":livros_lacrados:include/livrosLacresGumpIds";

include ":DiscordWebhook:outbound";

// Logica de abertura (AbrirLivroLacrado, GerarItemSecundario)
include ":livros_lacrados:scripts/abertura";

// Gump de leitura compartilhado (LerLivroLacrado, _MostrarGumpLivro)
include ":livros_lacrados:scripts/ler";

function LimparExpirados(who)
    var agora := ReadGameClock();
    var npcs := ListMobilesNearLocation(who.x, who.y, who.z, 30, who.realm);
    foreach npc in npcs
        if (npc && !npc.errortext)
 var exp := GetObjProperty(npc, "expira_em");
            if (!exp.errortext && CInt(exp) > 0 && agora >= CInt(exp))
                npc.kill();
            endif
        endif
    endforeach
endfunction

program UseLivroLacrado(who, book)
    LimparExpirados(who);

    // O livro precisa estar na mochila direta (nao em sub-bolsas)
    var mochila := who.backpack;
    if (!mochila)
 SendSysMessageEX(who, "Voce nao tem mochila.", SSM_FAIL);
        return;
    endif

    if (book.container && book.container.serial != mochila.serial)
 SendSysMessageEX(who, "O livro precisa estar diretamente em sua mochila.", SSM_FAIL);
        return;
    endif

    // Se ja foi aberto, mostrar conteudo (releitura)
 if (CInt(GetObjProperty(book, "aberto")))
 var nat := CStr(GetObjProperty(book, "natureza"));
        if (nat == NAT_MANCHADO)
            // Manchado: fragmento varia por leitor - recalcula a cada leitura
 var nivel_re := CInt(GetObjProperty(book, "nivel_bau"));
 var afi_re := CStr(GetObjProperty(book, "afinidade"));
 start_script(":livros_lacrados:scripts/naturezas/exec_dispatcher",
                         array{who, book, nivel_re, afi_re, GetLugar(who), NAT_MANCHADO});
        elseif (nat == NAT_DESPERTADOR)
 var ghost_serial := CInt(GetObjProperty(book, "despertador_npc_serial"));
            var ghost := SystemFindObjectBySerial(ghost_serial);
            if (ghost && !ghost.errortext)
 SendSysMessageEX(who, "O espirito ainda esta presente. Ele ja respondeu ao chamado.", SSM_INFO);
            else
                LerLivroLacrado(who, book);
            endif
        else
            LerLivroLacrado(who, book);
        endif
        return;
    endif

    // Verificar inteligencia minima
 if (GetAttributeBaseValue(who, "Intelligence") < 10)
 SendSysMessageEX(who, "Voce nao tem intelecto suficiente para interagir com este livro.", SSM_FAIL);
        return;
    endif

    AbrirLivroLacrado(who, book);

endprogram
