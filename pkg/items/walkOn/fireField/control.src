/*
 * $Id: control.src 935 2005-11-07 00:34:53Z austin $
 *
 * Reformado para usar ApplyFieldDamage (caminho de dano enxuto) em vez de
 * DealDamage. Dano em itens próximos ticka a cada 4 ciclos (~1s) em vez de
 * todo tick (250ms) — granularidade de combate não é necessária pra durabilidade.
*/
use uo;
use os;
use util;

include ":combat:Controller/DamageController";
include ":combat:Model/Damage";
include ":destroyable:include/destroyItem";

const FIELD_TICK_MS := 250;
const PERMANENT_TICK_MS := 2500; // fields with no Duration are decorative/permanent
const ITEM_DAMAGE_EVERY_N_TICKS := 4; // ~1s

program controlScript(field)
	SetObjProperty(field, "#PID", GetPid());
	SetObjProperty(field, PROPNAME_INDESTRUTIVEL, 1);

	var creator := field.GetOwner();
	if (creator)
		SetScriptController(creator);
	endif

	var summoned := GetObjProperty(field, "SummonedField");
	var sumDesc := (summoned != error && summoned) ? "[Invoc]" : "";
	var dmg_dice := GetObjProperty(field, "DamageDice");
	if (dmg_dice == error || !dmg_dice)
		dmg_dice := "1d5";
	endif

	var tickCount := 0;
	while (field)
		// A field with no Duration never expires (permanent fire is intentional).
		// Such fields tick far slower and skip the durability scan so they cost
		// almost nothing — they still burn mobiles standing in them.
		var dur := GetObjProperty(field, "Duration");
		var isPermanent := (dur == error || !dur);
		var tickMs := isPermanent ? PERMANENT_TICK_MS : FIELD_TICK_MS;

		BurnNearbyMobiles(field, dmg_dice);

		if (!isPermanent && tickCount % ITEM_DAMAGE_EVERY_N_TICKS == 0)
			DanificaObjetosProximos(creator, field.x, field.y, field.z, field.realm,
				struct{ dano := RandomDiceRoll(dmg_dice), desc := "Campo Flamejante." + sumDesc },
				0, 0, field.serial);
		endif

		if (ReadGameClock() % 3 == 0)
			// Play once every 3 seconds.
			PlaySoundEffect(field, 0x1DE);
		endif

		var event := Wait_For_Event(0);
		if (event)
			// Someone just walked onto the tile.
			BurnMobile(event, dmg_dice, creator);
		endif

		if (field.IsExpired())
			DestroyItem(field);
			return 1;
		endif
		sleepms(tickMs);
		tickCount := tickCount + 1;
	endwhile
endprogram

function BurnNearbyMobiles(field, dmg_dice)
	var nearby := ListMobilesNearLocationEX(field.x, field.y, field.z, 0,
											 LISTEX_FLAG_NORMAL + LISTEX_FLAG_HIDDEN, field.realm);
	foreach mobile in (nearby)
		BurnMobile(mobile, dmg_dice, field.GetOwner());

		sleepms(2);
	endforeach

	return (nearby.size());
endfunction

function BurnMobile(mobile, dmg_dice, field_owner)
	var dmg := RandomDiceRoll(dmg_dice);
	// ApplyFieldDamage: resist chain completo, sem hooks/logger/abilities.
	// Source 0 (sourceless) reaproveita o wrapper do defender como attacker.
	ApplyFieldDamage(mobile, dmg, DAMAGE_TYPE::FIRE);
	SetObjProperty(mobile, "affected_by_spell", field_owner.serial);
	return 1;
endfunction
