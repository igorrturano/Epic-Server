use os;
use uo;

include ":propagacao:include/propagacao";
include ":propagacao:include/efeitosIncendiarios";

program onArremessado(params)
	var quem := params[1];
	var item := params[2];

	while (item)
		if (item.graphic == 0x0a12 && !item.container)
			sleep(4);

			var marcador := CriaFagulhaIncendiaria(quem, item);
			break;
		else
			break;
		endif
	endwhile

endprogram
