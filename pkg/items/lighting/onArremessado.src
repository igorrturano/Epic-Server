use os;
use uo;

include ":propagacao:include/propagacao";

program onArremessado(params)
	var quem := params[1];
	var item := params[2];

	while(item)
		if(item.graphic == 0x0a12 && !item.container)
			sleep(2);
			
			var propPropagacao := NovaPropPropagacao(0,quem.serial,-1,PROPAGACAO_TIPO_INCENDIO, ESTADO_PROPAGACAO_PRINCIPIO);
			CriarMarcadorPropagacao(item.x,item.y,item.z,item.realm,propPropagacao);
			break;
		else
			break;
		endif
	endwhile

endprogram