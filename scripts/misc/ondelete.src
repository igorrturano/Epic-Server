/* $Id: ondelete.src 1371 2006-05-12 23:55:57Z austin $
 *
 * Purpose
 * This script allows the scripter to run code when a character is deleted.
 *
*/
use uo;
use os;
use storage;

include ":timeutils:time";
include ":attributes:attributes";
include ":stables:include/stable";
include ":taming:taming";

program core_onDelete(who)
	var create_time := who.createdat;
	var age := polcore().systime - create_time;

	if (who.cmdlevel)
		KillOwnedPets(who, 0);
		return 1;
	elseif (age >= SECONDS_IN_WEEK)
		SysLog("Account [" + who.acctname + "] deleting character " + who.name + " (" + who.serial + ")");
		KillOwnedPets(who, 1);
		return 1;
	else
		return 0;
	endif
endprogram

function KillOwnedPets(who, raw)
	// Pets stabled/limbo tem invul concedido via GrantPrivilege — ApplyDamage
	// (raw=0) e' ignorado. Limpa estado antes de matar para nao sobrarem
	// refs orfas (StoredAnimal no post, StableData no pet).
	var tamed := Getobjproperty(who, "TamedPets");
	if (tamed && tamed != error)
		foreach serial in tamed
			var pet := SystemFindObjectBySerial(serial);
			if (PetIsValid(pet))
				ClearPetStableAndLimboState(pet);
			endif
			KillPetBySerial(serial, raw);
		endforeach
	endif

	var data := GetOwnerStable(who);
	if (data == error)
		return;
	endif
	var stabled := data["stabled_pets"];
	foreach stabled_serial in stabled
		var pet := SystemFindObjectBySerial(stabled_serial);
		if (PetIsValid(pet))
			ClearPetStableAndLimboState(pet);
		endif
		KillPetBySerial(stabled_serial, raw);
	endforeach
endfunction

function KillPetBySerial(serial, raw)
	var pet := SystemFindObjectBySerial(serial);
	if (!pet)
		return;
	endif
	SetObjProperty(pet, "GuardKill", 1);
	if (raw)
		ApplyRawDamage(pet, 9999);
	else
		ApplyDamage(pet, 9999);
	endif
endfunction
